# Deny by default: ignore everything, then un-ignore only what we track.
*

# Descend into directories so the un-ignore rules below can reach nested files.
!*/

# Root files we track.
!/.gitignore
!/.python-version
!/CONTRIBUTING.md
!/GLOSSARY.md
!/README.md
!/pyproject.toml
!/uv.lock

# Source and tests.
!/src/**
!/tests/**

# Docs, including evaluation records: what a real run measured is evidence
# the next change is judged against, so it outlives one working copy (#171).
!/docs/**

# CI. Deny-by-default means the workflow needs saying out loud or git never
# sees it, and a workflow git cannot see never runs (#171 hit this with
# CONTRIBUTING.md).
!/.github/**

# Re-ignore junk that the broad src/tests rules would otherwise pull back in.
__pycache__/
*.py[oc]

# Heavy or local-only directories: re-ignore fully so git never descends.
.venv/
.hrono/
.autodev/

# .e2e/ holds hand-run evaluations and their scratch homes, which stay local.
# The export evaluation's runner and question set are the exception (E004): a
# repeatable measurement that lived in one working copy would be repeatable on
# one machine (#171). Its runs go under .e2e/eval/runs/ and stay ignored.
.e2e/*
!/.e2e/eval/
!/.e2e/eval/run.py
!/.e2e/eval/questions.toml
!/.e2e/eval/README.md

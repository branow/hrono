# Deny by default: ignore everything, then un-ignore only what we track.
*

# Descend into directories so the un-ignore rules below can reach nested files.
!*/

# Root files we track.
!/.gitignore
!/.python-version
!/AGENTS.md
!/CLAUDE.md
!/CONTRIBUTING.md
!/GLOSSARY.md
!/README.md
!/REQUIREMENTS.md
!/pyproject.toml
!/uv.lock

# Source and tests.
!/src/**
!/tests/**

# Docs: the design record, and every evaluation's log and metrics. What a real
# run measured is evidence the next change is judged against, so it outlives
# one working copy (#171).
!/docs/**

# Development tooling: the autodev loop (roles, board, archive) and the export
# evaluation. The workflow that drives autodev must sit where Claude Code finds
# workflows.
!/dev/**
!/.claude/workflows/**

# CI. Deny-by-default means the workflow needs saying out loud or git never
# sees it, and a workflow git cannot see never runs (#171 hit this with
# CONTRIBUTING.md).
!/.github/**

# Re-ignore junk the broad rules above would otherwise pull back in.
__pycache__/
*.py[oc]
.DS_Store

# Local-only inside tracked trees: board screenshots (20 MB of PNG evidence
# kept on the machine that took them) and export-eval run output.
/dev/autodev/board/**/*.png
/dev/eval/runs/

# Heavy or local-only directories: re-ignore fully so git never descends.
.venv/
.hrono/
.claude/worktrees/
.playwright-mcp/

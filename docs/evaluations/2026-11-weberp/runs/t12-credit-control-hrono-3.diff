diff --git a/CreditWriteOff.php b/CreditWriteOff.php
new file mode 100644
index 0000000..ec644db
--- /dev/null
+++ b/CreditWriteOff.php
@@ -0,0 +1,270 @@
+<?php
+
+/* Bad debt write-off of all or part of a customer's unpaid balance.
+
+A write-off up to WriteOffApprovalLimit (home currency) is posted straight away. A bigger one is only requested and does
+nothing until someone with the write-off approval token (21 - the Finance Director) approves it here. Posting a write-off
+credits the customer account (allocating the credit to the oldest unpaid items), credits debtors control and debits the
+bad debt account. The credit is posted at the rate the items were originally booked at, so debtors control falls by exactly
+what those items added to it and the sales ledger and the GL stay in agreement. The customer is put on stop unless credit control
+unticks the box. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Bad Debt Write-offs');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditWriteOff';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_delete.png" title="' . $Title . '" alt="" />
+		' . $Title . '
+	</p>';
+
+$FormAction = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$IsApprover = UserIsCreditApprover();
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+} elseif (isset($_SESSION['CustomerID'])) {
+	$DebtorNo = $_SESSION['CustomerID'];
+} else {
+	$DebtorNo = '';
+}
+
+/* Splits $Amount (customer currency) over the oldest unpaid debits. Returns array('parts' => ..., 'home' => ..., 'left' => ...) */
+function PlanWriteOff($DebtorNo, $Amount, $CurrencyRate) {
+	$Result = DB_query("SELECT id, balance, rate FROM debtortrans
+						WHERE debtorno = '" . $DebtorNo . "' AND balance > 0.005
+						ORDER BY trandate, id");
+	$Parts = array();
+	$Home = 0;
+	$Left = $Amount;
+	while ($Left > 0.005 and $MyRow = DB_fetch_array($Result)) {
+		$Take = min($MyRow['balance'], $Left);
+		$Parts[] = array('id' => $MyRow['id'], 'amount' => $Take);
+		$Home += $Take / ($MyRow['rate'] > 0 ? $MyRow['rate'] : $CurrencyRate);
+		$Left -= $Take;
+	}
+	return array('parts' => $Parts, 'home' => $Home, 'left' => $Left);
+}
+
+/* Posts an approved write-off. Returns '' on success or the reason it could not be posted */
+function PostWriteOff($WriteOff) {
+	$Result = DB_query("SELECT currencies.rate FROM currencies WHERE currabrev = '" . $WriteOff['currcode'] . "'");
+	$CurrencyRow = DB_fetch_row($Result);
+	$CurrencyRate = ($CurrencyRow[0] > 0) ? $CurrencyRow[0] : 1;
+
+	if ($_SESSION['BadDebtGLAccount'] == '') {
+		return __('The bad debt GL account must be set on the Credit Control Setup page');
+	}
+	if ($WriteOff['amount'] > GetCustomerBalance($WriteOff['debtorno']) + 0.005) {
+		return __('The write-off is more than the balance now owed by the customer');
+	}
+	$Plan = PlanWriteOff($WriteOff['debtorno'], $WriteOff['amount'], $CurrencyRate);
+	if ($Plan['left'] > 0.005) {
+		return __('The unpaid items are less than the amount to write off. Allocate the unallocated receipts and credit notes first');
+	}
+	$WriteOffRate = $WriteOff['amount'] / $Plan['home'];
+
+	DB_Txn_Begin();
+	$Posting = PostCreditControlTrans($WriteOff['debtorno'], 83, $WriteOff['amount'], $WriteOffRate, ConvertSQLDate(date('Y-m-d')), __('Write-off') . ' ' . $WriteOff['writeoffid'],
+		__('Bad debt write-off') . ' ' . $WriteOff['writeoffid'] . ' - ' . $WriteOff['reason'],
+		array(array('account' => $_SESSION['BadDebtGLAccount'], 'amount' => $Plan['home'])));
+	foreach ($Plan['parts'] as $Part) {
+		CreditControlAllocate($Posting['id'], $Part['id'], $Part['amount'], date('Y-m-d'));
+	}
+	DB_query("UPDATE creditwriteoffs SET status = 1,
+										transno = '" . $Posting['transno'] . "',
+										homeamount = '" . $Plan['home'] . "',
+										approvedby = '" . (UserIsCreditApprover() ? $_SESSION['UserID'] : '') . "',
+										approvedate = '" . date('Y-m-d') . "'
+				WHERE writeoffid = '" . $WriteOff['writeoffid'] . "'", __('The write-off could not be updated because'), '', true);
+	CreditControlLog($WriteOff['debtorno'], 'WRITEOFF', __('Written off') . ' - ' . $WriteOff['reason'], $WriteOff['amount'], $WriteOff['currcode'], 83, $Posting['transno']);
+	if ($WriteOff['stopcustomer']) {
+		if (!CustomerOnStop($WriteOff['debtorno'])) {
+			SetCreditStatus($WriteOff['debtorno'], CREDIT_STOP, __('Put on stop automatically - debt written off'));
+		}
+	}
+	DB_Txn_Commit();
+	return '';
+}
+
+if (isset($_POST['Request']) and UserIsCreditControl()) {
+	$Amount = filter_number_format($_POST['Amount']);
+	$Result = DB_query("SELECT debtorsmaster.currcode, currencies.rate, currencies.decimalplaces
+						FROM debtorsmaster INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+						WHERE debtorsmaster.debtorno = '" . $DebtorNo . "'");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('The customer does not exist'), 'error');
+	} elseif (!is_numeric($Amount) or $Amount <= 0) {
+		prnMsg(__('The amount to write off must be a number above zero'), 'error');
+	} elseif (trim($_POST['Reason']) == '') {
+		prnMsg(__('A reason must be given for the write-off'), 'error');
+	} else {
+		$Customer = DB_fetch_array($Result);
+		$CurrencyRate = ($Customer['rate'] > 0) ? $Customer['rate'] : 1;
+		$Amount = round($Amount, $Customer['decimalplaces']);
+		$Plan = PlanWriteOff($DebtorNo, $Amount, $CurrencyRate);
+		if ($Amount > GetCustomerBalance($DebtorNo) + 0.005 or $Plan['left'] > 0.005) {
+			prnMsg(__('The amount is more than the customer owes in unpaid invoices and charges. Allocate any unallocated receipts first'), 'error');
+		} else {
+			DB_query("INSERT INTO creditwriteoffs (debtorno, requestdate, requestedby, amount, currcode, homeamount, reason, stopcustomer, status)
+						VALUES ('" . $DebtorNo . "', '" . date('Y-m-d') . "', '" . $_SESSION['UserID'] . "', '" . $Amount . "', '" . $Customer['currcode'] . "',
+								'" . $Plan['home'] . "', '" . $_POST['Reason'] . "', '" . (isset($_POST['StopCustomer']) ? 1 : 0) . "', 0)",
+				__('The write-off could not be recorded because'));
+			$WriteOffID = DB_Last_Insert_ID('creditwriteoffs', 'writeoffid');
+			$NeedsApproval = ($Plan['home'] > (float)$_SESSION['WriteOffApprovalLimit'] and !$IsApprover);
+			CreditControlLog($DebtorNo, 'WRITEOFF_REQ', ($NeedsApproval ? __('Requested, waiting for approval') : __('Requested')) . ' - ' . $_POST['Reason'], $Amount, $Customer['currcode']);
+			if ($NeedsApproval) {
+				prnMsg(__('The write-off is above the approval limit. It has been recorded and takes no effect until it is approved'), 'info');
+			} else {
+				$Result = DB_query("SELECT * FROM creditwriteoffs WHERE writeoffid = '" . $WriteOffID . "'");
+				$Error = PostWriteOff(DB_fetch_array($Result));
+				if ($Error == '') {
+					prnMsg(__('The write-off has been posted'), 'success');
+				} else {
+					DB_query("DELETE FROM creditwriteoffs WHERE writeoffid = '" . $WriteOffID . "' AND status = 0");
+					prnMsg($Error, 'error');
+				}
+			}
+		}
+	}
+}
+
+if (isset($_POST['Decide']) and $IsApprover) {
+	$Result = DB_query("SELECT * FROM creditwriteoffs WHERE writeoffid = '" . (int)$_POST['WriteOffID'] . "' AND status = 0");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('The write-off is not waiting for approval'), 'error');
+	} else {
+		$WriteOff = DB_fetch_array($Result);
+		if ($_POST['Decide'] == 'Approve') {
+			$Error = PostWriteOff($WriteOff);
+			if ($Error == '') {
+				prnMsg(__('The write-off has been approved and posted'), 'success');
+			} else {
+				prnMsg($Error, 'error');
+			}
+		} else {
+			DB_query("UPDATE creditwriteoffs SET status = 2, approvedby = '" . $_SESSION['UserID'] . "', approvedate = '" . date('Y-m-d') . "'
+						WHERE writeoffid = '" . $WriteOff['writeoffid'] . "'");
+			CreditControlLog($WriteOff['debtorno'], 'WRITEOFF_REJ', __('Write-off request') . ' ' . $WriteOff['writeoffid'] . ' ' . __('rejected'), $WriteOff['amount'], $WriteOff['currcode']);
+			prnMsg(__('The write-off has been rejected'), 'success');
+		}
+	}
+}
+
+if (UserIsCreditControl()) {
+	if ($DebtorNo == '') {
+		prnMsg(__('Select a customer to write off a debt'), 'info');
+		echo '<div class="centre"><a href="' . $RootPath . '/SelectCustomer.php">' . __('Select a Customer') . '</a></div>';
+	} else {
+		$Result = DB_query("SELECT debtorsmaster.name, debtorsmaster.currcode, currencies.decimalplaces
+							FROM debtorsmaster INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+							WHERE debtorno = '" . $DebtorNo . "'");
+		if (DB_num_rows($Result) > 0) {
+			$Customer = DB_fetch_array($Result);
+			$Balance = GetCustomerBalance($DebtorNo);
+			echo '<form method="post" action="' . $FormAction . '">
+					<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+					<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+					<fieldset>
+						<legend>' . $DebtorNo . ' - ' . $Customer['name'] . '</legend>
+						<field>
+							<label>' . __('Balance owed') . ':</label>
+							<fieldtext>' . locale_number_format($Balance, $Customer['decimalplaces']) . ' ' . $Customer['currcode'] . '</fieldtext>
+						</field>
+						<field>
+							<label for="Amount">' . __('Amount to write off') . ':</label>
+							<input type="text" class="number" name="Amount" id="Amount" required="required" size="14" maxlength="14" value="' . round($Balance > 0 ? $Balance : 0, $Customer['decimalplaces']) . '" />
+						</field>
+						<field>
+							<label for="Reason">' . __('Reason') . ':</label>
+							<input type="text" name="Reason" id="Reason" required="required" size="60" maxlength="200" />
+						</field>
+						<field>
+							<label for="StopCustomer">' . __('Put the customer on stop') . ':</label>
+							<input type="checkbox" name="StopCustomer" id="StopCustomer" checked="checked" />
+						</field>
+					</fieldset>
+					<div class="centre"><input type="submit" name="Request" value="' . __('Write Off') . '" onclick="return confirm(\'' . __('Write this debt off?') . '\');" /></div>
+				</form>';
+		}
+	}
+}
+
+/* Waiting for approval */
+$Result = DB_query("SELECT creditwriteoffs.*, debtorsmaster.name
+					FROM creditwriteoffs INNER JOIN debtorsmaster ON creditwriteoffs.debtorno = debtorsmaster.debtorno
+					WHERE status = 0 ORDER BY writeoffid");
+if (DB_num_rows($Result) > 0) {
+	echo '<table class="selection">
+			<caption>' . __('Write-offs Waiting for Approval') . '</caption>
+			<tr><th>' . __('Requested') . '</th><th>' . __('By') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . __('Reason') . '</th><th></th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . ConvertSQLDate($MyRow['requestdate']) . '</td>
+				<td>' . $MyRow['requestedby'] . '</td>
+				<td>' . $MyRow['debtorno'] . ' - ' . $MyRow['name'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['amount'], 2) . ' ' . $MyRow['currcode'] . '</td>
+				<td>' . $MyRow['reason'] . '</td>
+				<td>';
+		if ($IsApprover) {
+			echo '<form method="post" action="' . $FormAction . '">
+					<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+					<input type="hidden" name="WriteOffID" value="' . $MyRow['writeoffid'] . '" />
+					<input type="submit" name="Decide" value="Approve" />
+					<input type="submit" name="Decide" value="Reject" />
+				</form>';
+		}
+		echo '</td></tr>';
+	}
+	echo '</table>';
+}
+
+/* Report of write-offs over a period */
+$From = (isset($_POST['FromDate']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['FromDate'])) ? $_POST['FromDate'] : date('Y-m-d', strtotime('-12 months'));
+$To = (isset($_POST['ToDate']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['ToDate'])) ? $_POST['ToDate'] : date('Y-m-d');
+echo '<form method="post" action="' . $FormAction . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Write-offs Report') . '</legend>
+			<field><label for="FromDate">' . __('From') . ':</label><input type="date" name="FromDate" id="FromDate" value="' . $From . '" /></field>
+			<field><label for="ToDate">' . __('To') . ':</label><input type="date" name="ToDate" id="ToDate" value="' . $To . '" /></field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Report" value="' . __('Show') . '" /></div>
+	</form>';
+
+$Result = DB_query("SELECT creditwriteoffs.*, debtorsmaster.name
+					FROM creditwriteoffs INNER JOIN debtorsmaster ON creditwriteoffs.debtorno = debtorsmaster.debtorno
+					WHERE requestdate >= '" . $From . "' AND requestdate <= '" . $To . "'
+					ORDER BY writeoffid DESC");
+$Statuses = array(0 => __('Waiting for approval'), 1 => __('Posted'), 2 => __('Rejected'));
+$HomeTotal = 0;
+echo '<table class="selection">
+		<caption>' . __('Write-offs') . ' ' . ConvertSQLDate($From) . ' - ' . ConvertSQLDate($To) . '</caption>
+		<tr><th>' . __('Date') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . __('Home Currency') . '</th><th>' . __('Reason') . '</th><th>' . __('Requested By') . '</th><th>' . __('Approved By') . '</th><th>' . __('Status') . '</th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	if ($MyRow['status'] == 1) {
+		$HomeTotal += $MyRow['homeamount'];
+	}
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate($MyRow['requestdate']) . '</td>
+			<td>' . $MyRow['debtorno'] . ' - ' . $MyRow['name'] . '</td>
+			<td class="number">' . locale_number_format($MyRow['amount'], 2) . ' ' . $MyRow['currcode'] . '</td>

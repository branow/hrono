+foreach ($ReasonLabels as $Name => $Label) {
+	echo '<field>
+			<label for="' . $Name . '">' . $Label . ':</label>
+			<select name="' . $Name . '" id="' . $Name . '">';
+	$Result = DB_query("SELECT reasoncode, reasondescription, dissallowinvoices FROM holdreasons ORDER BY reasoncode");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Setting = ($MyRow['dissallowinvoices'] == 1) ? __('no invoicing') : (($MyRow['dissallowinvoices'] == 2) ? __('warning only') : __('invoicing allowed'));
+		echo '<option value="' . $MyRow['reasoncode'] . '"' . ($_SESSION[$Name] == $MyRow['reasoncode'] ? ' selected="selected"' : '') . '>' . $MyRow['reasoncode'] . ' - ' . $MyRow['reasondescription'] . ' (' . $Setting . ')</option>';
+	}
+	echo '</select>
+		</field>';
+}
+
+echo '</fieldset>
+		<div class="centre"><input type="submit" name="SaveSettings" value="' . __('Save Settings') . '" /></div>
+	</form>';
+
+echo '<table class="selection">
+		<caption>' . __('Reminder Letter Stages') . '</caption>
+		<tr><th>' . __('Stage') . '</th><th>' . __('Days Overdue') . '</th><th>' . __('Subject') . '</th><th>' . __('Wording - use {name} {invoices} {amount} {currency} {company}') . '</th><th colspan="2"></th></tr>';
+$Result = DB_query("SELECT level, daysoverdue, subject, body FROM dunninglevels ORDER BY level");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row"><form method="post" action="' . $FormAction . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<input type="hidden" name="Level" value="' . $MyRow['level'] . '" />
+			<td>' . $MyRow['level'] . '</td>
+			<td><input type="text" class="integer" name="DaysOverdue" size="4" maxlength="3" value="' . $MyRow['daysoverdue'] . '" /></td>
+			<td><input type="text" name="Subject" size="35" maxlength="100" value="' . $MyRow['subject'] . '" /></td>
+			<td><textarea name="Body" rows="6" cols="60">' . $MyRow['body'] . '</textarea></td>

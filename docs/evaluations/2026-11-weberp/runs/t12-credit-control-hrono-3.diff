+			<td>' . $MyRow['approvedby'] . '</td>
+			<td>' . $Statuses[$MyRow['status']] . '</td>
+		</tr>';
+}
+echo '<tr><td colspan="3"><b>' . __('Total posted') . ' (' . $_SESSION['CompanyRecord']['currencydefault'] . ')</b></td><td class="number"><b>' . locale_number_format($HomeTotal, 2) . '</b></td><td colspan="4"></td></tr>';
+echo '</table>';
+
+include('includes/footer.php');

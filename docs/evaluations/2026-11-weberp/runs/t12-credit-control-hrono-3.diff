+INSERT INTO `dunninglevels` (`level`, `daysoverdue`, `subject`, `body`) VALUES (1,30,'Reminder: overdue invoices','Dear {name},\n\nOur records show that the following invoices are overdue for payment:\n\n{invoices}\n\nTotal overdue: {amount} {currency}\n\nIf you have already paid please ignore this reminder, otherwise please arrange payment as soon as possible.\n\nKind regards,\n{company}'),(2,45,'Second reminder: overdue invoices','Dear {name},\n\nWe wrote to you recently about overdue invoices and have not yet received payment:\n\n{invoices}\n\nTotal overdue: {amount} {currency}\n\nPlease pay immediately or contact us to discuss the account.\n\nKind regards,\n{company}'),(3,60,'FINAL NOTICE: overdue invoices','Dear {name},\n\nThis is our final notice. The following invoices remain unpaid:\n\n{invoices}\n\nTotal overdue: {amount} {currency}\n\nUnless payment is received your account will be put on stop and late payment interest and fees will be charged.\n\nKind regards,\n{company}');

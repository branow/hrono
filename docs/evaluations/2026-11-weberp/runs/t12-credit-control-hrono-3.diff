+INSERT INTO `menuitems` (`secroleid`, `modulelink`, `menusection`, `caption`, `url`, `sequence`) SELECT roles.secroleid, items.modulelink, items.menusection, items.caption, items.url, items.sequence FROM (SELECT 1 AS secroleid UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9) AS roles CROSS JOIN (SELECT 'AR' AS modulelink, 'Transactions' AS menusection, 'Credit Reviews and Credit History' AS caption, '/CreditReview.php' AS url, 20 AS sequence UNION ALL SELECT 'AR', 'Transactions', 'Overdue Reminder Run', '/DunningRun.php', 21 UNION ALL SELECT 'AR', 'Transactions', 'Month End Interest and Late Fees', '/CreditCharges.php', 22 UNION ALL SELECT 'AR', 'Transactions', 'Bad Debt Write-offs', '/CreditWriteOff.php', 23 UNION ALL SELECT 'AR', 'Reports', 'Credit Control Report', '/CreditControlReport.php', 20 UNION ALL SELECT 'AR', 'Maintenance', 'Credit Control Setup', '/CreditControlSetup.php', 20) AS items;

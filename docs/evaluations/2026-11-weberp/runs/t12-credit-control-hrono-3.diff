+		}
+		prnMsg(__('The reminder stage has been saved'), 'success');
+	}
+}
+
+if (isset($_GET['DeleteLevel'])) {
+	/* the letters already sent keep the stage number they were sent at */
+	DB_query("DELETE FROM dunninglevels WHERE level = '" . (int)$_GET['DeleteLevel'] . "'");

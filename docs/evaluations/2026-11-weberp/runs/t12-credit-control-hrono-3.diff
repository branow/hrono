diff --git a/CreditCharges.php b/CreditCharges.php
new file mode 100644
index 0000000..9bf8bcc
--- /dev/null
+++ b/CreditCharges.php
@@ -0,0 +1,245 @@
+<?php
+
+/* Month end interest and late fees on overdue invoices, and their waiver.
+
+Interest is the annual rate / 12 on each overdue, undisputed INVOICE (never on earlier interest or fees) that is
+more than ChargeAfterDays overdue at the run date. The late fee is a flat amount per customer per month, set in the home
+currency and converted to the customer's currency. Charges are posted in the customer's own currency as separate
+interest and fee transactions (types 80 and 81) so they show on the statement as separate items, and to the GL
+income accounts chosen on the Credit Control Setup page. A customer can be charged only once for a month. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Month End Interest and Late Fees');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditCharges';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_add.png" title="' . $Title . '" alt="" />
+		' . $Title . '
+	</p>';
+
+$Rate = (float)$_SESSION['InterestRate'];
+$Fee = (float)$_SESSION['LateFee'];
+$AfterDays = (int)$_SESSION['ChargeAfterDays'];
+$FormAction = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+
+$RunDate = (isset($_POST['RunDate']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['RunDate'])) ? $_POST['RunDate'] : date('Y-m-d');
+$ChargeMonth = mb_substr($RunDate, 0, 7);
+
+/* Who would be charged what at $RunDate. Returns an array indexed by debtor number */
+function GetChargeCandidates($RunDate, $ChargeMonth, $Rate, $Fee, $AfterDays) {
+	$Result = GetOverdueInvoices($RunDate, $AfterDays,
+		" AND debtorsmaster.debtorno NOT IN (SELECT debtorno FROM creditcharges WHERE chargemonth = '" . $ChargeMonth . "')");
+	$Candidates = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Debtor = $MyRow['debtorno'];
+		if (!isset($Candidates[$Debtor])) {
+			$CustResult = DB_query("SELECT debtorsmaster.name, debtorsmaster.currcode, debtorsmaster.exemptinterest, debtorsmaster.exemptfees,
+											currencies.decimalplaces, currencies.rate
+									FROM debtorsmaster
+									INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+									WHERE debtorsmaster.debtorno = '" . $Debtor . "'");
+			$Candidates[$Debtor] = DB_fetch_array($CustResult);
+			$Candidates[$Debtor]['interest'] = 0;
+			$Candidates[$Debtor]['invoices'] = array();
+		}
+		$Candidates[$Debtor]['invoices'][] = $MyRow['transno'];
+		if (!$Candidates[$Debtor]['exemptinterest']) {
+			$Candidates[$Debtor]['interest'] += $MyRow['balance'] * $Rate / 100 / 12;
+		}
+	}
+	foreach ($Candidates as $Debtor => $Candidate) {
+		$Candidates[$Debtor]['interest'] = round($Candidate['interest'], $Candidate['decimalplaces']);
+		$Candidates[$Debtor]['fee'] = $Candidate['exemptfees'] ? 0 : round($Fee * $Candidate['rate'], $Candidate['decimalplaces']);
+		if ($Candidates[$Debtor]['interest'] <= 0 and $Candidates[$Debtor]['fee'] <= 0) {
+			unset($Candidates[$Debtor]);
+		}
+	}
+	return $Candidates;
+}
+
+if (isset($_POST['Post']) and isset($_POST['Include'])) {
+	if (($Rate > 0 and $_SESSION['InterestGLAccount'] == '') or ($Fee > 0 and $_SESSION['FeeGLAccount'] == '')) {
+		prnMsg(__('The GL accounts for interest and late fees must be set on the Credit Control Setup page before charges can be posted'), 'error');
+	} else {
+		$Candidates = GetChargeCandidates($RunDate, $ChargeMonth, $Rate, $Fee, $AfterDays);
+		$Posted = 0;
+		foreach ($_POST['Include'] as $Debtor => $Checked) {
+			if (!isset($Candidates[$Debtor])) {
+				prnMsg($Debtor . ': ' . __('has no charges to post or has already been charged for') . ' ' . $ChargeMonth, 'info');
+				continue;
+			}
+			$Candidate = $Candidates[$Debtor];
+			$CurrencyRate = ($Candidate['rate'] > 0) ? $Candidate['rate'] : 1;
+			$Narrative = __('Interest at') . ' ' . $Rate . '% ' . __('p.a. on overdue invoices') . ' ' . implode(', ', $Candidate['invoices']) . ' (' . $ChargeMonth . ')';
+			$FeeNarrative = __('Late payment fee') . ' ' . $ChargeMonth;
+
+			DB_Txn_Begin();
+			$InterestTransNo = 0;
+			$FeeTransNo = 0;
+			if ($Candidate['interest'] > 0) {
+				$Posting = PostCreditControlTrans($Debtor, 80, $Candidate['interest'], $CurrencyRate, ConvertSQLDate($RunDate), __('Interest') . ' ' . $ChargeMonth, $Narrative,
+					array(array('account' => $_SESSION['InterestGLAccount'], 'amount' => -$Candidate['interest'] / $CurrencyRate)));
+				$InterestTransNo = $Posting['transno'];
+			}
+			if ($Candidate['fee'] > 0) {
+				$Posting = PostCreditControlTrans($Debtor, 81, $Candidate['fee'], $CurrencyRate, ConvertSQLDate($RunDate), __('Late fee') . ' ' . $ChargeMonth, $FeeNarrative,
+					array(array('account' => $_SESSION['FeeGLAccount'], 'amount' => -$Candidate['fee'] / $CurrencyRate)));
+				$FeeTransNo = $Posting['transno'];
+			}
+			DB_query("INSERT INTO creditcharges (debtorno, chargemonth, chargedate, currcode, interestamt, feeamt, interesttransno, feetransno)
+						VALUES ('" . $Debtor . "', '" . $ChargeMonth . "', '" . $RunDate . "', '" . $Candidate['currcode'] . "',
+								'" . $Candidate['interest'] . "', '" . $Candidate['fee'] . "', '" . $InterestTransNo . "', '" . $FeeTransNo . "')",
+				__('The charge could not be recorded because'), '', true);
+			CreditControlLog($Debtor, 'CHARGE', $ChargeMonth . ': ' . __('interest') . ' ' . $Candidate['interest'] . ', ' . __('late fee') . ' ' . $Candidate['fee'], $Candidate['interest'] + $Candidate['fee'], $Candidate['currcode'], 80, $InterestTransNo);
+			DB_Txn_Commit();
+			$Posted++;
+		}
+		prnMsg($Posted . ' ' . __('customers have been charged for') . ' ' . $ChargeMonth, 'success');
+	}
+}
+
+if (isset($_POST['Waive'])) {
+	$ChargeID = (int)$_POST['ChargeID'];
+	$Result = DB_query("SELECT creditcharges.*, currencies.rate
+						FROM creditcharges
+						INNER JOIN currencies ON creditcharges.currcode = currencies.currabrev
+						WHERE chargeid = '" . $ChargeID . "' AND waived = 0");
+	if (trim($_POST['Reason']) == '') {
+		prnMsg(__('A reason must be given for waiving a charge'), 'error');
+	} elseif (DB_num_rows($Result) == 0) {
+		prnMsg(__('The charge does not exist or has already been waived'), 'error');
+	} else {
+		$Charge = DB_fetch_array($Result);
+		$CurrencyRate = ($Charge['rate'] > 0) ? $Charge['rate'] : 1;
+		$Outstanding = array();
+		foreach (array(80 => $Charge['interesttransno'], 81 => $Charge['feetransno']) as $Type => $TransNo) {
+			if ($TransNo > 0) {
+				$TransResult = DB_query("SELECT id, balance, rate FROM debtortrans WHERE type = '" . $Type . "' AND transno = '" . $TransNo . "' AND debtorno = '" . $Charge['debtorno'] . "'");
+				$TransRow = DB_fetch_array($TransResult);
+				if ($TransRow and $TransRow['balance'] > 0.005) {
+					$Outstanding[$Type] = $TransRow;
+				}
+			}
+		}
+		if (count($Outstanding) == 0) {
+			prnMsg(__('The charge has already been paid so there is nothing left to waive'), 'warn');
+		} else {
+			$Total = 0;
+			$GLLines = array();
+			$GLAccounts = array(80 => $_SESSION['InterestGLAccount'], 81 => $_SESSION['FeeGLAccount']);
+			foreach ($Outstanding as $Type => $TransRow) {
+				$Total += $TransRow['balance'];
+				/* the waiver reverses the income at the rate the charge was posted at */
+				$GLLines[] = array('account' => $GLAccounts[$Type], 'amount' => $TransRow['balance'] / ($TransRow['rate'] > 0 ? $TransRow['rate'] : 1));
+			}
+			$HomeTotal = 0;
+			foreach ($GLLines as $GLLine) {
+				$HomeTotal += $GLLine['amount'];
+			}
+			$CurrencyRate = $Total / $HomeTotal;
+			DB_Txn_Begin();
+			$Posting = PostCreditControlTrans($Charge['debtorno'], 82, $Total, $CurrencyRate, ConvertSQLDate(date('Y-m-d')), __('Waiver') . ' ' . $Charge['chargemonth'],
+				__('Waiver of interest and fees for') . ' ' . $Charge['chargemonth'] . ' - ' . $_POST['Reason'], $GLLines);
+			foreach ($Outstanding as $Type => $TransRow) {
+				CreditControlAllocate($Posting['id'], $TransRow['id'], $TransRow['balance'], date('Y-m-d'));
+			}
+			DB_query("UPDATE creditcharges SET waived = 1, waivedby = '" . $_SESSION['UserID'] . "', waivedate = '" . date('Y-m-d') . "', waivereason = '" . $_POST['Reason'] . "'
+						WHERE chargeid = '" . $ChargeID . "'", __('The charge could not be marked as waived because'), '', true);
+			CreditControlLog($Charge['debtorno'], 'WAIVER', $Charge['chargemonth'] . ' - ' . $_POST['Reason'], $Total, $Charge['currcode'], 82, $Posting['transno']);
+			DB_Txn_Commit();
+			prnMsg(__('The charge has been waived'), 'success');
+		}
+	}
+}
+
+if ($Rate == 0 and $Fee == 0) {
+	prnMsg(__('Neither an interest rate nor a late fee has been set. Set them on the Credit Control Setup page'), 'warn');
+}
+
+echo '<form method="post" action="' . $FormAction . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Charge Run') . '</legend>
+			<field>
+				<label for="RunDate">' . __('Charge date (the month of this date is the month charged)') . ':</label>
+				<input type="date" name="RunDate" id="RunDate" value="' . $RunDate . '" />
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Preview" value="' . __('Show What Will Be Charged') . '" /></div>
+	</form>';
+
+if (isset($_POST['Preview']) or isset($_POST['Post'])) {
+	$Candidates = GetChargeCandidates($RunDate, $ChargeMonth, $Rate, $Fee, $AfterDays);
+	if (count($Candidates) == 0) {
+		prnMsg(__('Nobody is left to charge for') . ' ' . $ChargeMonth, 'info');
+	} else {
+		echo '<form method="post" action="' . $FormAction . '">
+				<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+				<input type="hidden" name="RunDate" value="' . $RunDate . '" />
+				<table class="selection">
+					<caption>' . __('Charges for') . ' ' . $ChargeMonth . '</caption>
+					<tr>
+						<th>' . __('Post') . '</th>
+						<th>' . __('Customer') . '</th>
+						<th>' . __('Overdue Invoices') . '</th>
+						<th>' . __('Interest') . '</th>
+						<th>' . __('Late Fee') . '</th>
+					</tr>';
+		foreach ($Candidates as $Debtor => $Candidate) {
+			echo '<tr class="striped_row">
+					<td><input type="checkbox" name="Include[' . $Debtor . ']" checked="checked" /></td>
+					<td>' . $Debtor . ' - ' . $Candidate['name'] . '</td>
+					<td>' . implode(', ', $Candidate['invoices']) . '</td>
+					<td class="number">' . locale_number_format($Candidate['interest'], $Candidate['decimalplaces']) . ' ' . $Candidate['currcode'] . '</td>
+					<td class="number">' . locale_number_format($Candidate['fee'], $Candidate['decimalplaces']) . ' ' . $Candidate['currcode'] . '</td>
+				</tr>';
+		}
+		echo '</table>
+				<div class="centre"><input type="submit" name="Post" value="' . __('Post the Charges Ticked') . '" onclick="return confirm(\'' . __('Post these charges to the customer accounts and the general ledger?') . '\');" /></div>
+			</form>';
+	}
+}
+
+/* Recent charges - with the waive option */
+$Result = DB_query("SELECT creditcharges.*, debtorsmaster.name
+					FROM creditcharges
+					INNER JOIN debtorsmaster ON creditcharges.debtorno = debtorsmaster.debtorno
+					ORDER BY chargeid DESC LIMIT 100");
+echo '<table class="selection">
+		<caption>' . __('Charges Posted (latest 100)') . '</caption>
+		<tr>
+			<th>' . __('Month') . '</th>
+			<th>' . __('Customer') . '</th>
+			<th>' . __('Interest') . '</th>
+			<th>' . __('Late Fee') . '</th>
+			<th>' . __('Status') . '</th>
+			<th></th>
+		</tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>' . $MyRow['chargemonth'] . '</td>
+			<td>' . $MyRow['debtorno'] . ' - ' . $MyRow['name'] . '</td>
+			<td class="number">' . $MyRow['interestamt'] . ' ' . $MyRow['currcode'] . '</td>
+			<td class="number">' . $MyRow['feeamt'] . ' ' . $MyRow['currcode'] . '</td>';
+	if ($MyRow['waived']) {
+		echo '<td>' . __('Waived by') . ' ' . $MyRow['waivedby'] . ' ' . ConvertSQLDate($MyRow['waivedate']) . ' - ' . $MyRow['waivereason'] . '</td><td></td>';
+	} else {
+		echo '<td>' . __('Charged') . '</td>
+			<td><form method="post" action="' . $FormAction . '">
+				<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+				<input type="hidden" name="ChargeID" value="' . $MyRow['chargeid'] . '" />
+				<input type="text" name="Reason" size="30" maxlength="100" placeholder="' . __('Reason') . '" required="required" />
+				<input type="submit" name="Waive" value="' . __('Waive') . '" />
+			</form></td>';
+	}
+	echo '</tr>';
+}
+echo '</table>';
+
+include('includes/footer.php');
diff --git a/CreditControlReport.php b/CreditControlReport.php
new file mode 100644
index 0000000..12aabd5
--- /dev/null
+++ b/CreditControlReport.php
@@ -0,0 +1,253 @@
+<?php
+
+/* Credit control report: customers due or overdue for a credit review, customers over their credit limit,
+customers on watch or on stop, and the open orders of customers on watch.
+A sales rep only ever sees his own customers. Totals are in the home currency. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Control Report');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlReport';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/reports.png" title="' . $Title . '" alt="" />
+		' . $Title . '
+	</p>';
+
+if (GetPortalCustomer() != '') {
+	prnMsg(__('This report is not available to customers'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$HomeDecimals = 2;
+$Result = DB_query("SELECT decimalplaces FROM currencies WHERE currabrev = '" . $HomeCurrency . "'");
+if (DB_num_rows($Result) > 0) {
+	$MyRow = DB_fetch_row($Result);
+	$HomeDecimals = $MyRow[0];
+}
+
+$IsRep = (isset($_SESSION['SalesmanLogin']) and $_SESSION['SalesmanLogin'] != '');
+$Salesman = $IsRep ? $_SESSION['SalesmanLogin'] : (isset($_POST['Salesman']) ? $_POST['Salesman'] : '');
+$Currency = isset($_POST['Currency']) ? $_POST['Currency'] : '';
+$ReviewDays = isset($_POST['ReviewDays']) ? (int)$_POST['ReviewDays'] : 14;
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Report Criteria') . '</legend>
+			<field>
+				<label for="Salesman">' . __('Sales Person') . ':</label>';
+if ($IsRep) {
+	echo '<fieldtext>' . $Salesman . '</fieldtext>';
+} else {
+	echo '<select name="Salesman" id="Salesman"><option value="">' . __('All') . '</option>';
+	$Result = DB_query("SELECT salesmancode, salesmanname FROM salesman ORDER BY salesmanname");
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<option value="' . $MyRow['salesmancode'] . '"' . ($Salesman == $MyRow['salesmancode'] ? ' selected="selected"' : '') . '>' . $MyRow['salesmanname'] . '</option>';
+	}
+	echo '</select>';
+}
+echo '</field>
+			<field>
+				<label for="Currency">' . __('Currency') . ':</label>
+				<select name="Currency" id="Currency"><option value="">' . __('All') . '</option>';
+$Result = DB_query("SELECT currabrev, currency FROM currencies ORDER BY currabrev");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option value="' . $MyRow['currabrev'] . '"' . ($Currency == $MyRow['currabrev'] ? ' selected="selected"' : '') . '>' . $MyRow['currabrev'] . ' - ' . $MyRow['currency'] . '</option>';
+}
+echo '</select>
+			</field>
+			<field>
+				<label for="ReviewDays">' . __('Include reviews due within (days)') . ':</label>
+				<input type="text" class="integer" name="ReviewDays" id="ReviewDays" size="4" maxlength="3" value="' . $ReviewDays . '" />
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Submit" value="' . __('Show Report') . '" /></div>
+	</form>';
+
+$Criteria = CreditSalesmanRestriction();
+if ($Salesman != '' and !$IsRep) {
+	$Criteria .= " AND debtorsmaster.debtorno IN (SELECT DISTINCT debtorno FROM custbranch WHERE salesman = '" . $Salesman . "') ";
+}
+if ($Currency != '') {
+	$Criteria .= " AND debtorsmaster.currcode = '" . $Currency . "' ";
+}
+
+/* One row per customer with a balance, a status and the review date */
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				debtorsmaster.creditlimit,
+				debtorsmaster.nextreviewdate,
+				holdreasons.dissallowinvoices,
+				holdreasons.reasondescription,
+				currencies.decimalplaces,
+				currencies.rate,
+				COALESCE((SELECT SUM(debtortrans.balance) FROM debtortrans WHERE debtortrans.debtorno = debtorsmaster.debtorno), 0) AS balance,
+				(SELECT MAX(dunninglog.level) FROM dunninglog WHERE dunninglog.debtorno = debtorsmaster.debtorno) AS lastlevel
+		FROM debtorsmaster
+		INNER JOIN holdreasons
+			ON debtorsmaster.holdreason = holdreasons.reasoncode
+		INNER JOIN currencies
+			ON debtorsmaster.currcode = currencies.currabrev
+		WHERE 1 = 1 " . $Criteria . "
+		ORDER BY debtorsmaster.debtorno";
+$Result = DB_query($SQL);
+
+$Due = $Over = $Flagged = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	$MyRow['status'] = CreditStatusFromDisallow($MyRow['dissallowinvoices']);
+	$Rate = ($MyRow['rate'] > 0) ? $MyRow['rate'] : 1;
+	$MyRow['homebalance'] = $MyRow['balance'] / $Rate;
+	$MyRow['overby'] = $MyRow['balance'] - $MyRow['creditlimit'];
+	$MyRow['homeoverby'] = $MyRow['overby'] / $Rate;
+	if ($MyRow['nextreviewdate'] === null or $MyRow['nextreviewdate'] <= date('Y-m-d', strtotime('+' . $ReviewDays . ' days'))) {
+		$Due[] = $MyRow;
+	}
+	if ($MyRow['overby'] > 0.005) {
+		$Over[] = $MyRow;
+	}
+	if ($MyRow['status'] != CREDIT_NORMAL) {
+		$Flagged[] = $MyRow;
+	}
+}
+
+function CreditReportTable($Caption, $Rows, $Columns) {
+	global $RootPath, $HomeCurrency, $HomeDecimals;
+	echo '<table class="selection">
+			<caption>' . $Caption . '</caption>
+			<tr>
+				<th>' . __('Customer') . '</th>
+				<th>' . __('Name') . '</th>
+				<th>' . __('Status') . '</th>
+				<th>' . __('Currency') . '</th>
+				<th>' . __('Credit Limit') . '</th>
+				<th>' . __('Balance') . '</th>
+				<th>' . __('Last Reminder Stage') . '</th>
+				<th>' . __('Next Review') . '</th>
+				<th>' . $Columns . ' (' . $HomeCurrency . ')</th>
+			</tr>';
+	$Total = 0;
+	foreach ($Rows as $Row) {
+		$HomeValue = ($Columns == __('Over Limit By')) ? $Row['homeoverby'] : $Row['homebalance'];
+		$Total += $HomeValue;
+		$Overdue = ($Row['nextreviewdate'] === null or $Row['nextreviewdate'] <= date('Y-m-d'));
+		echo '<tr class="striped_row">
+				<td><a href="' . $RootPath . '/CreditReview.php?DebtorNo=' . urlencode($Row['debtorno']) . '">' . $Row['debtorno'] . '</a></td>
+				<td>' . $Row['name'] . '</td>
+				<td>' . CreditStatusName($Row['status']) . '</td>
+				<td>' . $Row['currcode'] . '</td>
+				<td class="number">' . locale_number_format($Row['creditlimit'], $Row['decimalplaces']) . '</td>
+				<td class="number">' . locale_number_format($Row['balance'], $Row['decimalplaces']) . '</td>
+				<td class="number">' . ($Row['lastlevel'] ? $Row['lastlevel'] : '') . '</td>
+				<td>' . ($Row['nextreviewdate'] ? ConvertSQLDate($Row['nextreviewdate']) : __('Not set')) . ($Overdue ? ' <b>' . __('overdue') . '</b>' : '') . '</td>
+				<td class="number">' . locale_number_format($HomeValue, $HomeDecimals) . '</td>
+			</tr>';
+	}
+	echo '<tr>
+			<td colspan="8"><b>' . __('Total') . ' (' . count($Rows) . ' ' . __('customers') . ')</b></td>
+			<td class="number"><b>' . locale_number_format($Total, $HomeDecimals) . '</b></td>
+		</tr>
+		</table><br />';
+}
+
+CreditReportTable(__('Customers Due or Overdue for a Credit Review'), $Due, __('Balance'));
+CreditReportTable(__('Customers Over Their Credit Limit'), $Over, __('Over Limit By'));
+CreditReportTable(__('Customers on Watch or on Stop'), $Flagged, __('Balance'));
+
+/* Orders taken for customers on watch that are still to be supplied */
+$SQL = "SELECT salesorders.orderno,
+				salesorders.debtorno,
+				debtorsmaster.name,
+				salesorders.orddate,
+				salesorders.deliverydate,
+				debtorsmaster.currcode,
+				currencies.decimalplaces,
+				SUM(salesorderdetails.unitprice * (salesorderdetails.quantity - salesorderdetails.qtyinvoiced) * (1 - salesorderdetails.discountpercent)) AS ordervalue
+		FROM salesorders
+		INNER JOIN salesorderdetails
+			ON salesorders.orderno = salesorderdetails.orderno
+		INNER JOIN debtorsmaster
+			ON salesorders.debtorno = debtorsmaster.debtorno
+		INNER JOIN holdreasons
+			ON debtorsmaster.holdreason = holdreasons.reasoncode
+		INNER JOIN currencies
+			ON debtorsmaster.currcode = currencies.currabrev
+		WHERE holdreasons.dissallowinvoices = 2
+			AND salesorders.quotation = 0
+			AND salesorderdetails.completed = 0
+			" . $Criteria . "
+		GROUP BY salesorders.orderno, salesorders.debtorno, debtorsmaster.name, salesorders.orddate, salesorders.deliverydate, debtorsmaster.currcode, currencies.decimalplaces
+		ORDER BY salesorders.orddate DESC";
+$Result = DB_query($SQL);
+echo '<table class="selection">
+		<caption>' . __('Open Orders of Customers on Watch') . '</caption>
+		<tr>
+			<th>' . __('Order') . '</th>
+			<th>' . __('Customer') . '</th>
+			<th>' . __('Order Date') . '</th>
+			<th>' . __('Delivery Date') . '</th>
+			<th>' . __('Value to be Supplied') . '</th>
+		</tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td><a href="' . $RootPath . '/OrderDetails.php?OrderNumber=' . urlencode($MyRow['orderno']) . '">' . $MyRow['orderno'] . '</a></td>
+			<td>' . $MyRow['debtorno'] . ' - ' . $MyRow['name'] . '</td>
+			<td>' . ConvertSQLDate($MyRow['orddate']) . '</td>
+			<td>' . ConvertSQLDate($MyRow['deliverydate']) . '</td>
+			<td class="number">' . locale_number_format($MyRow['ordervalue'], $MyRow['decimalplaces']) . ' ' . $MyRow['currcode'] . '</td>
+		</tr>';
+}
+echo '</table>';
+
+/* Ledger agreement: customer balances against the trade debtors control account, by transaction type so a difference can be traced */
+if (UserIsCreditControl()) {
+	$SQL = "SELECT systypes.typeid,
+					systypes.typename,
+					COALESCE(sub.amount, 0) AS subledger,
+					COALESCE(gl.amount, 0) AS ledger
+			FROM systypes
+			LEFT JOIN (SELECT type, SUM((ovamount + ovgst + ovfreight + ovdiscount) / CASE WHEN rate > 0 THEN rate ELSE 1 END) AS amount
+						FROM debtortrans GROUP BY type) AS sub ON sub.type = systypes.typeid
+			LEFT JOIN (SELECT type, SUM(amount) AS amount
+						FROM gltrans WHERE account = '" . $_SESSION['CompanyRecord']['debtorsact'] . "' GROUP BY type) AS gl ON gl.type = systypes.typeid
+			WHERE sub.amount IS NOT NULL OR gl.amount IS NOT NULL
+			ORDER BY systypes.typeid";
+	$Result = DB_query($SQL);
+	echo '<br /><table class="selection">
+			<caption>' . __('Customer Balances Against Trade Debtors Control Account') . ' (' . $HomeCurrency . ')</caption>
+			<tr>
+				<th>' . __('Type') . '</th>
+				<th>' . __('Customer Accounts') . '</th>
+				<th>' . __('General Ledger') . '</th>
+				<th>' . __('Difference') . '</th>
+			</tr>';
+	$TotalSub = $TotalGL = 0;
+	while ($MyRow = DB_fetch_array($Result)) {
+		$TotalSub += $MyRow['subledger'];
+		$TotalGL += $MyRow['ledger'];
+		$Difference = $MyRow['subledger'] - $MyRow['ledger'];
+		echo '<tr class="striped_row">
+				<td>' . $MyRow['typeid'] . ' - ' . $MyRow['typename'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['subledger'], $HomeDecimals) . '</td>
+				<td class="number">' . locale_number_format($MyRow['ledger'], $HomeDecimals) . '</td>
+				<td class="number">' . (abs($Difference) > 0.005 ? '<b>' . locale_number_format($Difference, $HomeDecimals) . '</b>' : '') . '</td>
+			</tr>';
+	}
+	echo '<tr>
+			<td><b>' . __('Total') . '</b></td>
+			<td class="number"><b>' . locale_number_format($TotalSub, $HomeDecimals) . '</b></td>
+			<td class="number"><b>' . locale_number_format($TotalGL, $HomeDecimals) . '</b></td>
+			<td class="number"><b>' . locale_number_format($TotalSub - $TotalGL, $HomeDecimals) . '</b></td>
+		</tr>
+		</table>';
+}
+
+include('includes/footer.php');

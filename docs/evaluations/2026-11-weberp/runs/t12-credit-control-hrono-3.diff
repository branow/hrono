diff --git a/DunningRun.php b/DunningRun.php
new file mode 100644
index 0000000..10dbd81
--- /dev/null
+++ b/DunningRun.php
@@ -0,0 +1,196 @@
+<?php
+
+/* Overdue reminder letter run.
+
+Credit control starts a run, sees who would get which stage of letter, leaves out the customers it does not want to
+chase and then sends. The stage is recomputed from what is overdue at the moment of sending, so a customer who has
+paid in the meantime gets nothing, and a customer is never sent a stage they have already had. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Overdue Reminder Run');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'DunningRun';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_add.png" title="' . $Title . '" alt="" />
+		' . $Title . '
+	</p>';
+
+$Result = DB_query("SELECT level, daysoverdue, subject, body FROM dunninglevels ORDER BY level");
+$Levels = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	$Levels[$MyRow['level']] = $MyRow;
+}
+if (count($Levels) == 0) {
+	prnMsg(__('No reminder stages have been set up. Define them on the Credit Control Setup page'), 'warn');
+	include('includes/footer.php');
+	exit();
+}
+$FirstLevelDays = min(array_column($Levels, 'daysoverdue'));
+
+$AsOf = (isset($_POST['AsOf']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['AsOf'])) ? $_POST['AsOf'] : date('Y-m-d');
+
+/* Works out who should get which letter. Returns an array indexed by debtor number */
+function GetDunningCandidates($AsOf, $Levels, $FirstLevelDays) {
+	$MinDays = isset($_SESSION['DunningMinDays']) ? (int)$_SESSION['DunningMinDays'] : 7;
+	$Result = GetOverdueInvoices($AsOf, $FirstLevelDays, " AND debtorsmaster.dunninghold = 0");
+	$Candidates = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Debtor = $MyRow['debtorno'];
+		if (!isset($Candidates[$Debtor])) {
+			$Candidates[$Debtor] = array('maxdays' => 0, 'amount' => 0, 'invoices' => array());
+		}
+		$Candidates[$Debtor]['maxdays'] = max($Candidates[$Debtor]['maxdays'], $MyRow['daysoverdue']);
+		$Candidates[$Debtor]['amount'] += $MyRow['balance'];
+		$Candidates[$Debtor]['invoices'][] = $MyRow;
+	}
+	foreach ($Candidates as $Debtor => $Candidate) {
+		$Level = 0;
+		foreach ($Levels as $LevelNo => $LevelRow) {
+			if ($LevelRow['daysoverdue'] <= $Candidate['maxdays']) {
+				$Level = $LevelNo;
+			}
+		}
+		/* letters sent before the customer last paid belong to an earlier episode of non-payment */
+		$LastResult = DB_query("SELECT dunninglog.level, DATEDIFF('" . $AsOf . "', dunninglog.sentdate) AS dayssince
+								FROM dunninglog
+								INNER JOIN debtorsmaster ON dunninglog.debtorno = debtorsmaster.debtorno
+								WHERE dunninglog.debtorno = '" . $Debtor . "'
+									AND (debtorsmaster.lastpaiddate IS NULL OR dunninglog.sentdate > debtorsmaster.lastpaiddate)
+								ORDER BY dunninglog.id DESC LIMIT 1");
+		$Last = DB_fetch_array($LastResult);
+		if ($Level == 0 or ($Last and ($Level <= $Last['level'] or $Last['dayssince'] < $MinDays))) {
+			unset($Candidates[$Debtor]);
+			continue;
+		}
+		$Candidates[$Debtor]['level'] = $Level;
+		$Candidates[$Debtor]['lastlevel'] = $Last ? $Last['level'] : 0;
+	}
+	return $Candidates;
+}

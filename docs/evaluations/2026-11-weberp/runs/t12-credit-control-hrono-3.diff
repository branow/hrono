@@ -0,0 +1,434 @@
+<?php
+
+/* Credit review, credit status and the credit history of one customer.
+
+Everybody with access to the sales menus can look (a sales rep only at his own customers); only credit control
+(security token 3) can record a review, change the credit limit, stop, watch or release a customer, set exemptions
+or mark an invoice disputed. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Review and Credit History');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditReview';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . __('Credit Review') . '" alt="" />
+		' . $Title . '
+	</p>';
+
+if (GetPortalCustomer() != '') {
+	prnMsg(__('Customers can see their reminders and charges on the account page'), 'info');
+	echo '<div class="centre"><a href="' . $RootPath . '/CustomerCredit.php">' . __('My reminders and charges') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+} elseif (isset($_SESSION['CustomerID'])) {
+	$DebtorNo = $_SESSION['CustomerID'];
+} else {
+	$DebtorNo = '';
+}
+
+if ($DebtorNo == '') {
+	prnMsg(__('To review the credit of a customer a customer must first be selected from the customer selection screen'), 'info');
+	echo '<br /><div class="centre"><a href="' . $RootPath . '/SelectCustomer.php">' . __('Select a Customer') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* A sales rep sees the customers of his own branches only */
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				debtorsmaster.creditlimit,
+				debtorsmaster.nextreviewdate,
+				debtorsmaster.exemptinterest,
+				debtorsmaster.exemptfees,
+				debtorsmaster.dunninghold,
+				currencies.decimalplaces,
+				currencies.rate
+		FROM debtorsmaster
+		INNER JOIN currencies
+			ON debtorsmaster.currcode = currencies.currabrev
+		WHERE debtorsmaster.debtorno = '" . $DebtorNo . "'" . CreditSalesmanRestriction();
+$Result = DB_query($SQL);
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('The customer does not exist or is not one of your customers'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($Result);
+$_SESSION['CustomerID'] = $DebtorNo;
+$IsCreditControl = UserIsCreditControl();
+$DecimalPlaces = $Customer['decimalplaces'];
+
+if (isset($_POST['Action'])) {
+	if (!$IsCreditControl) {
+		prnMsg(__('Only credit control can change credit limits and credit status'), 'error');
+	} else {
+		$Status = GetCreditStatus($DebtorNo);
+
+		if ($_POST['Action'] == 'Review') {
+			$InputError = 0;
+			$NewLimit = isset($_POST['NewLimit']) && $_POST['NewLimit'] !== '' ? filter_number_format($_POST['NewLimit']) : $Customer['creditlimit'];
+			$Outcome = $_POST['Outcome'];
+			if (!in_array($Outcome, array('confirmed', 'raised', 'reduced', 'watch', 'stop', 'release'))) {
+				$InputError = 1;
+				prnMsg(__('The outcome of the review must be selected'), 'error');
+			}
+			if (!is_numeric($NewLimit) or $NewLimit < 0) {
+				$InputError = 1;
+				prnMsg(__('The new credit limit must be a number of zero or more'), 'error');
+			} elseif ($Outcome == 'raised' and $NewLimit <= $Customer['creditlimit']) {
+				$InputError = 1;
+				prnMsg(__('A review that raises the limit must have a new limit above the current limit'), 'error');
+			} elseif ($Outcome == 'reduced' and $NewLimit >= $Customer['creditlimit']) {
+				$InputError = 1;
+				prnMsg(__('A review that reduces the limit must have a new limit below the current limit'), 'error');
+			} elseif (in_array($Outcome, array('confirmed', 'watch', 'stop', 'release')) and $NewLimit != $Customer['creditlimit']) {
+				$InputError = 1;
+				prnMsg(__('The limit can only change in a review with the outcome raised or reduced'), 'error');
+			}
+			if (trim($_POST['Notes']) == '') {
+				$InputError = 1;
+				prnMsg(__('Notes on the review must be entered'), 'error');
+			}
+			if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['NextReviewDate']) or $_POST['NextReviewDate'] <= date('Y-m-d')) {
+				$InputError = 1;
+				prnMsg(__('The next review date must be a date in the future'), 'error');
+			}
+			if ($InputError == 0) {
+				DB_Txn_Begin();
+				DB_query("INSERT INTO creditreviews (debtorno, reviewdate, reviewedby, outcome, oldlimit, newlimit, notes, nextreviewdate)
+							VALUES ('" . $DebtorNo . "',
+									'" . date('Y-m-d') . "',
+									'" . $_SESSION['UserID'] . "',
+									'" . $Outcome . "',
+									'" . $Customer['creditlimit'] . "',
+									'" . $NewLimit . "',
+									'" . $_POST['Notes'] . "',
+									'" . $_POST['NextReviewDate'] . "')",
+					__('The credit review could not be recorded because'), '', true);
+				if ($NewLimit != $Customer['creditlimit']) {
+					/* the limit changes in the same transaction as the review that gave the reason for it */
+					DB_query("UPDATE debtorsmaster SET creditlimit = '" . $NewLimit . "' WHERE debtorno = '" . $DebtorNo . "'",
+						__('The credit limit could not be updated because'), '', true);
+					CreditControlLog($DebtorNo, 'LIMIT', __('Credit limit changed from') . ' ' . $Customer['creditlimit'] . ' ' . __('to') . ' ' . $NewLimit . ' - ' . $_POST['Notes'], $NewLimit, $Customer['currcode']);
+				}
+				DB_query("UPDATE debtorsmaster SET nextreviewdate = '" . $_POST['NextReviewDate'] . "' WHERE debtorno = '" . $DebtorNo . "'",
+					__('The next review date could not be updated because'), '', true);
+				CreditControlLog($DebtorNo, 'REVIEW', $Outcome . ' - ' . $_POST['Notes'] . ' (' . __('next review') . ' ' . $_POST['NextReviewDate'] . ')');
+				$NewStatus = array('watch' => CREDIT_WATCH, 'stop' => CREDIT_STOP, 'release' => CREDIT_NORMAL);
+				if (isset($NewStatus[$Outcome])) {
+					if (!SetCreditStatus($DebtorNo, $NewStatus[$Outcome], $_POST['Notes'])) {
+						DB_Txn_Rollback();
+						prnMsg(__('The hold reason for this status has not been set up. See Credit Control Setup'), 'error');
+						include('includes/footer.php');
+						exit();
+					}
+				}
+				DB_Txn_Commit();
+				prnMsg(__('The credit review has been recorded'), 'success');
+				$Customer['creditlimit'] = $NewLimit;
+				$Customer['nextreviewdate'] = $_POST['NextReviewDate'];
+			}
+
+		} elseif ($_POST['Action'] == 'Status') {
+			$NewStatus = array('watch' => CREDIT_WATCH, 'stop' => CREDIT_STOP, 'release' => CREDIT_NORMAL);
+			if (!isset($NewStatus[$_POST['NewStatus']])) {
+				prnMsg(__('The new credit status must be selected'), 'error');
+			} elseif (trim($_POST['Reason']) == '') {
+				prnMsg(__('A reason must be given for changing the credit status'), 'error');
+			} else {
+				DB_Txn_Begin();
+				if (SetCreditStatus($DebtorNo, $NewStatus[$_POST['NewStatus']], $_POST['Reason'])) {
+					DB_Txn_Commit();
+					prnMsg(__('The credit status has been changed'), 'success');
+				} else {
+					DB_Txn_Rollback();
+					prnMsg(__('The hold reason for this status has not been set up. See Credit Control Setup'), 'error');
+				}
+			}
+
+		} elseif ($_POST['Action'] == 'Flags') {
+			$ExemptInterest = isset($_POST['ExemptInterest']) ? 1 : 0;
+			$ExemptFees = isset($_POST['ExemptFees']) ? 1 : 0;
+			$DunningHold = isset($_POST['DunningHold']) ? 1 : 0;
+			DB_Txn_Begin();

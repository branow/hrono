+				<input type="text" class="number" name="InterestRate" id="InterestRate" size="6" maxlength="6" value="' . $_SESSION['InterestRate'] . '" />
+			</field>
+			<field>
+				<label for="LateFee">' . __('Late fee per customer per month, in home currency') . ':</label>
+				<input type="text" class="number" name="LateFee" id="LateFee" size="10" maxlength="12" value="' . $_SESSION['LateFee'] . '" />
+			</field>
+			<field>
+				<label for="ChargeAfterDays">' . __('Days overdue before an invoice attracts charges') . ':</label>
+				<input type="text" class="integer" name="ChargeAfterDays" id="ChargeAfterDays" size="4" maxlength="3" value="' . $_SESSION['ChargeAfterDays'] . '" />
+			</field>
+			<field>
+				<label for="WriteOffApprovalLimit">' . __('Write-offs above this amount (home currency) need Finance Director approval') . ':</label>
+				<input type="text" class="number" name="WriteOffApprovalLimit" id="WriteOffApprovalLimit" size="10" maxlength="12" value="' . $_SESSION['WriteOffApprovalLimit'] . '" />
+			</field>
+			<field>
+				<label for="DunningMinDays">' . __('Minimum days between two reminder letters to a customer') . ':</label>
+				<input type="text" class="integer" name="DunningMinDays" id="DunningMinDays" size="4" maxlength="3" value="' . $_SESSION['DunningMinDays'] . '" />
+			</field>';
+
+$AccountLabels = array('InterestGLAccount' => __('GL account for interest income'),
+						'FeeGLAccount' => __('GL account for late fee income'),
+						'BadDebtGLAccount' => __('GL account for bad debts'));
+foreach ($AccountLabels as $Name => $Label) {
+	echo '<field>
+			<label for="' . $Name . '">' . $Label . ':</label>
+			<select name="' . $Name . '" id="' . $Name . '"><option value="">' . __('Not set') . '</option>';
+	$Result = DB_query("SELECT accountcode, accountname FROM chartmaster ORDER BY accountcode");
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<option value="' . $MyRow['accountcode'] . '"' . ($_SESSION[$Name] == $MyRow['accountcode'] ? ' selected="selected"' : '') . '>' . $MyRow['accountcode'] . ' - ' . htmlspecialchars($MyRow['accountname'], ENT_QUOTES, 'UTF-8') . '</option>';
+	}
+	echo '</select>
+		</field>';
+}
+
+$ReasonLabels = array('CreditNormalReason' => __('Credit status code for a normal customer'),
+						'CreditWatchReason' => __('Credit status code for a customer on watch'),

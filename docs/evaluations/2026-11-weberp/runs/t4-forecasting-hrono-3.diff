@@ -0,0 +1,218 @@
+<?php
+
+// Generate statistical demand forecasts for one item or for every active item of a stock category
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Generate Forecasts');
+$ViewTopic = 'MRP';
+$BookMark = '';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Defaults = ForecastGetDefaults();
+$Methods = ForecastMethods();
+$Bounds = ForecastHistoryBounds();
+
+if ($Bounds === null) {
+	prnMsg(__('There is no sales history to forecast from. Extract the sales history first.'), 'error');
+	echo '<div class="centre"><a href="' . $RootPath . '/ForecastSalesHistory.php">' . __('Extract Sales History') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+if (isset($_POST['Generate'])) {
+	$Errors = array();
+	$Params = ForecastParamsFromPost($Errors);
+
+	$Scope = ($_POST['Scope'] ?? 'item') == 'category' ? 'category' : 'item';
+	$LocCode = $_POST['Location'] ?? '';
+	$MethodChoice = $_POST['Method'] ?? '0';
+	$Horizon = $_POST['Horizon'] ?? '';
+	$Holdout = $_POST['Holdout'] ?? '';
+
+	if (!ctype_digit((string) $Horizon) or $Horizon < 1 or $Horizon > 24) {
+		$Errors[] = __('The horizon must be between 1 and 24 monthly periods');
+	}
+	if (!ctype_digit((string) $Holdout) or $Holdout < 1 or $Holdout > 12) {
+		$Errors[] = __('The number of hold-out months must be between 1 and 12');
+	}
+	if ($MethodChoice != 'C' and !isset($Methods[$MethodChoice]) and $MethodChoice != '0') {
+		$Errors[] = __('Select a method');
+	}
+	if ($MethodChoice == 'C' and $Scope != 'category') {
+		$Errors[] = __('The best fit across the items of a category needs a category to be selected');
+	}
+	if ($LocCode != '') {
+		$Result = DB_query("SELECT loccode FROM locations WHERE loccode='" . $LocCode . "'");
+		if (DB_num_rows($Result) == 0) {
+			$Errors[] = __('The location does not exist');
+		}
+	}
+
+	$Items = array();
+	if ($Scope == 'item') {
+		$StockID = trim(mb_strtoupper($_POST['StockID'] ?? ''));
+		$Result = DB_query("SELECT stockid, description FROM stockmaster WHERE stockid='" . $StockID . "'");
+		if ($StockID == '' or DB_num_rows($Result) == 0) {
+			$Errors[] = __('Enter the code of an existing item');
+		} else {
+			$MyRow = DB_fetch_array($Result);
+			$Items[$MyRow['stockid']] = $MyRow['description'];
+		}
+	} else {
+		$Items = ForecastCategoryItems($_POST['CategoryID'] ?? '');
+		if (count($Items) == 0) {
+			$Errors[] = __('The category has no active items');
+		}
+	}
+
+	foreach ($Errors as $Error) {
+		prnMsg($Error, 'error');
+	}
+
+	if (count($Errors) == 0) {
+		@set_time_limit(0);
+		$Horizon = (int) $Horizon;
+		$Holdout = (int) $Holdout;
+		$MethodID = ($MethodChoice == 'C') ? 0 : (int) $MethodChoice;
+
+		if ($MethodChoice == 'C') {
+			$SeriesSet = array();
+			foreach ($Items as $StockID => $Description) {
+				$SeriesSet[] = ForecastItemSeries($StockID, $LocCode)['values'];
+			}
+			$Common = ForecastBestFitForSet($SeriesSet, $Params, $Holdout);
+			echo '<table class="selection">
+					<tr><th colspan="3">' . __('Best fit across the items of the category') . ' (' . $Common['items'] . ' ' . __('items tested') . ')</th></tr>
+					<tr><th>' . __('Method') . '</th><th>' . __('Items tested') . '</th><th>' . __('Relative MAD') . '</th></tr>';
+			uasort($Common['scores'], function ($A, $B) {
+				return $A['score'] <=> $B['score'];
+			});
+			foreach ($Common['scores'] as $ID => $Score) {
+				echo '<tr class="striped_row' . ($ID === $Common['method'] ? ' bold' : '') . '">
+						<td>' . $ID . ' - ' . $Methods[$ID]['name'] . ($ID === $Common['method'] ? ' (' . __('recommended') . ')' : '') . '</td>
+						<td class="number">' . $Score['items'] . '</td>
+						<td class="number">' . locale_number_format($Score['score'], 3) . '</td>
+					</tr>';
+			}
+			echo '</table>';
+			if ($Common['method'] === null) {
+				prnMsg(__('No method could be tested on enough of the items of the category, so nothing has been forecast'), 'error');
+				include('includes/footer.php');
+				exit();
+			}
+			$MethodID = $Common['method'];
+			prnMsg(__('Recommended method for the category') . ': ' . $MethodID . ' - ' . $Methods[$MethodID]['name'], 'info');
+		}
+
+		$Results = array();
+		$Done = 0;
+		$Total = count($Items);
+		foreach ($Items as $StockID => $Description) {
+			$Outcome = ForecastGenerateItem($StockID, $LocCode, $MethodID, $Horizon, $Params, $Holdout);
+			$Outcome['stockid'] = $StockID;
+			$Outcome['description'] = $Description;
+			$Results[] = $Outcome;
+			$Done++;
+			if ($Total > 1 and ($Done % 25 == 0 or $Done == $Total)) {
+				echo '<div class="info">' . __('Processed') . ' ' . $Done . ' ' . __('of') . ' ' . $Total . '</div>';
+				flush();
+			}
+		}
+
+		$Successful = 0;
+		foreach ($Results as $Outcome) {
+			if ($Outcome['ok']) {
+				$Successful++;
+			}
+		}
+		$Failed = $Total - $Successful;
+		prnMsg($Successful . ' ' . __('successful') . ', ' . $Failed . ' ' . __('failed'), $Failed == 0 ? 'success' : ($Successful == 0 ? 'error' : 'warn'));
+
+		echo '<table class="selection">
+				<tr>
+					<th>' . __('Item') . '</th>
+					<th>' . __('Description') . '</th>
+					<th>' . __('Location') . '</th>
+					<th>' . __('Result') . '</th>
+					<th>' . __('Method') . '</th>
+					<th>' . __('Reason') . '</th>
+				</tr>';
+		foreach ($Results as $Outcome) {
+			echo '<tr class="striped_row">
+					<td><a href="' . $RootPath . '/ForecastReview.php?StockID=' . urlencode($Outcome['stockid']) . '&amp;Location=' . urlencode($LocCode) . '">' . $Outcome['stockid'] . '</a></td>
+					<td>' . $Outcome['description'] . '</td>
+					<td>' . ForecastLocationName($LocCode) . '</td>
+					<td>' . ($Outcome['ok'] ? __('Successful') : __('Failed')) . '</td>
+					<td>' . ($Outcome['ok'] ? $Outcome['method'] . ' - ' . $Methods[$Outcome['method']]['name'] : '') . '</td>
+					<td>' . $Outcome['reason'] . '</td>
+				</tr>';
+		}
+		echo '</table>';
+	}
+}
+
+// the form
+$Params = ForecastBaseParams();
+$Scope = $_POST['Scope'] ?? 'item';
+echo '<div class="page_help_text">' . __('Sales history held') . ': ' . ForecastMonthLabel($Bounds['first']) . ' - ' . ForecastMonthLabel($Bounds['last']) . '. ' . __('Forecasts start the month after the last month of the history.') . '</div>';
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Forecast Scope') . '</legend>
+		<field>
+			<label for="Scope">' . __('Forecast') . ':</label>
+			<select name="Scope">
+				<option value="item"' . ($Scope == 'item' ? ' selected="selected"' : '') . '>' . __('A single item') . '</option>
+				<option value="category"' . ($Scope == 'category' ? ' selected="selected"' : '') . '>' . __('Every active item of a stock category') . '</option>
+			</select>
+		</field>
+		<field>
+			<label for="StockID">' . __('Item code (single item)') . ':</label>
+			<input type="text" name="StockID" size="21" maxlength="64" value="' . ($_POST['StockID'] ?? ($_GET['StockID'] ?? '')) . '" />
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category (category)') . ':</label>
+			<select name="CategoryID">' . ForecastCategoryOptions($_POST['CategoryID'] ?? '') . '</select>
+		</field>
+		<field>
+			<label for="Location">' . __('Location') . ':</label>
+			<select name="Location">' . ForecastLocationOptions($_POST['Location'] ?? '') . '</select>
+		</field>
+	</fieldset>
+	<fieldset>
+		<legend>' . __('Method') . '</legend>
+		<field>
+			<label for="Method">' . __('Method') . ':</label>
+			<select name="Method">' . ForecastMethodOptions($_POST['Method'] ?? '0', __('Best fit for each item')) .
+				'<option value="C"' . (($_POST['Method'] ?? '') == 'C' ? ' selected="selected"' : '') . '>' . __('Best fit across the category (one method for all its items)') . '</option>
+			</select>
+		</field>
+		<field>
+			<label for="Horizon">' . __('Number of monthly periods to forecast') . ':</label>
+			<input type="text" class="number" name="Horizon" size="4" value="' . ($_POST['Horizon'] ?? $Defaults['horizon']) . '" />
+		</field>
+		<field>
+			<label for="Holdout">' . __('Months held out to find the best fit') . ':</label>
+			<input type="text" class="number" name="Holdout" size="4" value="' . ($_POST['Holdout'] ?? $Defaults['holdout']) . '" />
+		</field>
+	</fieldset>
+	<fieldset>
+		<legend>' . __('Method parameters') . '</legend>' .
+		ForecastParameterFields($Params) . '
+	</fieldset>
+	<div class="page_help_text">' . __('Minimum history in months') . ': ';
+$MinimumList = array();
+foreach ($Methods as $MethodID => $Method) {
+	$MinimumList[] = $MethodID . ' - ' . $Method['min'];
+}
+echo implode(', ', $MinimumList) . '. ' . __('An item with less history than the method needs is reported and not forecast. A new forecast of an item and location replaces the active one, which is kept as a superseded forecast.') . '</div>
+	<div class="centre">
+		<input type="submit" name="Generate" value="' . __('Generate Forecasts') . '" />
+	</div>
+</form>';
+
+include('includes/footer.php');

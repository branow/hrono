@@ -0,0 +1,81 @@
+<?php
+
+// Extract the invoiced sales, net of credit notes, into monthly buckets per item and location for forecasting
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecasting Sales History');
+$ViewTopic = 'MRP';
+$BookMark = '';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$LastCompleteMonth = ForecastAddMonths(date('Y-m-01'), -1);
+
+if (isset($_POST['Extract'])) {
+	$InputError = 0;
+	if (!ForecastIsMonth($_POST['FromMonth'] ?? '') or !ForecastIsMonth($_POST['ToMonth'] ?? '')) {
+		prnMsg(__('The first and last month must both be entered as a month and year'), 'error');
+		$InputError = 1;
+	} else {
+		$FromMonth = $_POST['FromMonth'] . '-01';
+		$ToMonth = $_POST['ToMonth'] . '-01';
+		if ($FromMonth > $ToMonth) {
+			prnMsg(__('The first month must not be after the last month'), 'error');
+			$InputError = 1;
+		} elseif ($ToMonth > date('Y-m-01')) {
+			prnMsg(__('The sales history cannot extend into the future'), 'error');
+			$InputError = 1;
+		}
+	}
+	if ($InputError == 0) {
+		$Rows = ForecastExtractHistory($FromMonth, $ToMonth);
+		prnMsg(__('The sales history from') . ' ' . ForecastMonthLabel($FromMonth) . ' ' . __('to') . ' ' . ForecastMonthLabel($ToMonth) . ' ' . __('has been extracted') . ': ' . $Rows . ' ' . __('item, location, customer type, area and salesperson combinations per month'), 'success');
+		if ($ToMonth > $LastCompleteMonth) {
+			prnMsg(__('The last month extracted is the current month, which is not complete yet. Sales still to come this month will make the history look lower than it will be.'), 'warn');
+		}
+	}
+}
+
+$Bounds = ForecastHistoryBounds(true);
+echo '<table class="selection">
+		<tr><th colspan="2">' . __('Sales history held') . '</th></tr>';
+if ($Bounds === null) {
+	echo '<tr><td colspan="2">' . __('No sales history has been extracted yet') . '</td></tr>';
+} else {
+	echo '<tr><td>' . __('From') . '</td><td>' . ForecastMonthLabel($Bounds['first']) . '</td></tr>
+		<tr><td>' . __('To') . '</td><td>' . ForecastMonthLabel($Bounds['last']) . '</td></tr>
+		<tr><td>' . __('Months held') . '</td><td class="number">' . $Bounds['count'] . '</td></tr>
+		<tr><td>' . __('Items with sales') . '</td><td class="number">' . ForecastHistoryItemCount() . '</td></tr>';
+}
+echo '</table>';
+if ($Bounds !== null and $Bounds['count'] < $Bounds['span']) {
+	prnMsg(__('There are months missing between the first and the last month held. Forecasts only use the unbroken run of months that ends with the last month, which starts at') . ' ' . ForecastMonthLabel($Bounds['blockstart']), 'warn');
+}
+
+$ToDefault = $LastCompleteMonth;
+$FromDefault = ForecastAddMonths($ToDefault, -23);
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Extract Sales History') . '</legend>
+		<field>
+			<label for="FromMonth">' . __('First month') . ':</label>
+			<input type="month" name="FromMonth" required="required" value="' . substr($_POST['FromMonth'] ?? $FromDefault, 0, 7) . '" />
+		</field>
+		<field>
+			<label for="ToMonth">' . __('Last month') . ':</label>
+			<input type="month" name="ToMonth" required="required" value="' . substr($_POST['ToMonth'] ?? $ToDefault, 0, 7) . '" />
+		</field>
+	</fieldset>
+	<div class="page_help_text">' . __('Invoiced quantities less credit notes, as the inventory planning report and the sales inquiries have them, summed by calendar month of the invoice or credit note date. 24 months are recommended. Months extracted before are replaced, not added to.') . '</div>
+	<div class="centre">
+		<input type="submit" name="Extract" value="' . __('Extract Sales History') . '" />
+	</div>
+</form>';
+
+echo '<div class="centre"><a href="' . $RootPath . '/ForecastDashboard.php">' . __('Forecasting Dashboard') . '</a></div>';
+
+include('includes/footer.php');
diff --git a/ForecastSummary.php b/ForecastSummary.php
new file mode 100644
index 0000000..6e3c6a5

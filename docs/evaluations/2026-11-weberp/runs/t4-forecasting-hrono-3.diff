+++ b/ForecastParameters.php
@@ -0,0 +1,60 @@
+<?php
+
+// Company wide defaults of the forecasting methods, used when the user does not override them
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecasting Parameters');
+$ViewTopic = 'MRP';
+$BookMark = '';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+// field => array(config key, label, minimum, maximum, whole number)
+$Fields = array(
+	'Alpha' => array('ForecastAlpha', __('Smoothing constant alpha (level)'), 0.1, 0.9, false),
+	'Beta' => array('ForecastBeta', __('Smoothing constant beta (trend)'), 0.1, 0.9, false),
+	'Gamma' => array('ForecastGamma', __('Smoothing constant gamma (seasonality)'), 0.1, 0.9, false),
+	'Season' => array('ForecastSeasonLength', __('Season length in months'), 2, 12, true),
+	'MAPeriods' => array('ForecastMAPeriods', __('Moving average periods'), 2, 24, true),
+	'Holdout' => array('ForecastHoldoutMonths', __('Months held out when looking for the best fit'), 1, 12, true),
+	'Horizon' => array('ForecastHorizon', __('Default number of monthly periods to forecast'), 1, 24, true)
+);
+
+if (isset($_POST['submit'])) {
+	$InputError = 0;
+	foreach ($Fields as $Field => $Definition) {
+		$Value = $_POST[$Field] ?? '';
+		if (!is_numeric($Value) or $Value < $Definition[2] or $Value > $Definition[3] or ($Definition[4] and !ctype_digit((string) $Value))) {
+			prnMsg($Definition[1] . ': ' . __('enter a') . ' ' . ($Definition[4] ? __('whole number') : __('number')) . ' ' . __('between') . ' ' . $Definition[2] . ' ' . __('and') . ' ' . $Definition[3], 'error');
+			$InputError = 1;
+		}
+	}
+	if ($InputError == 0) {
+		foreach ($Fields as $Field => $Definition) {
+			DB_query("DELETE FROM config WHERE confname='" . $Definition[0] . "'");
+			DB_query("INSERT INTO config (confname, confvalue) VALUES ('" . $Definition[0] . "', '" . ($_POST[$Field] + 0) . "')");
+		}
+		prnMsg(__('The forecasting parameters have been saved'), 'success');
+	}
+}
+
+$Current = ForecastGetDefaults();
+$Keys = array('Alpha' => 'alpha', 'Beta' => 'beta', 'Gamma' => 'gamma', 'Season' => 'season', 'MAPeriods' => 'maperiods', 'Holdout' => 'holdout', 'Horizon' => 'horizon');
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Forecasting Defaults') . '</legend>';
+foreach ($Fields as $Field => $Definition) {
+	echo '<field>
+			<label for="' . $Field . '">' . $Definition[1] . ':</label>
+			<input type="text" class="number" name="' . $Field . '" size="6" required="required" value="' . ($_POST[$Field] ?? $Current[$Keys[$Field]]) . '" />
+		</field>';
+}
+echo '</fieldset>
+	<div class="centre"><input type="submit" name="submit" value="' . __('Save') . '" /></div>
+</form>';
+
+include('includes/footer.php');
diff --git a/ForecastReview.php b/ForecastReview.php
new file mode 100644
index 0000000..4a34fa9
--- /dev/null
+++ b/ForecastReview.php
@@ -0,0 +1,225 @@
+<?php
+
+// Search the active forecasts and review them period by period; the planner can enter a revised quantity per period
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Review and Revise Forecasts');
+$ViewTopic = 'MRP';
+$BookMark = '';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Methods = ForecastMethods();
+$Self = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+
+$ForecastID = (int) ($_POST['ForecastID'] ?? ($_GET['ForecastID'] ?? 0));
+
+// a link from the generating page names an item and a location: go to its active forecast
+if ($ForecastID == 0 and isset($_GET['StockID'])) {
+	$Result = DB_query("SELECT forecastid FROM forecasts WHERE stockid='" . $_GET['StockID'] . "' AND loccode='" . ($_GET['Location'] ?? '') . "' AND activeslot = 1");
+	if ($MyRow = DB_fetch_row($Result)) {
+		$ForecastID = (int) $MyRow[0];
+	}
+}
+
+if ($ForecastID > 0) {
+	$Result = DB_query("SELECT forecasts.*,
+							stockmaster.description,
+							stockmaster.categoryid
+						FROM forecasts
+						LEFT JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+						WHERE forecasts.forecastid = " . $ForecastID);
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('The forecast does not exist'), 'error');
+		$ForecastID = 0;
+	} else {
+		$Forecast = DB_fetch_array($Result);
+	}
+}
+
+if ($ForecastID > 0) {
+	$Active = ($Forecast['activeslot'] == 1);
+
+	if (isset($_POST['SaveRevisions']) and $Active) {
+		$InputError = 0;
+		$Revisions = array();
+		foreach (($_POST['Revised'] ?? array()) as $Month => $Value) {
+			if (!preg_match('/^\d{4}-\d{2}-01$/', $Month)) {
+				continue;
+			}
+			if (trim($Value) === '') {
+				$Revisions[$Month] = 'NULL'; // no revision: the calculated quantity applies again
+			} elseif (!is_numeric(filter_number_format($Value)) or filter_number_format($Value) < 0) {
+				prnMsg(__('The revised quantity for') . ' ' . ForecastMonthLabel($Month) . ' ' . __('must be a number that is not negative'), 'error');
+				$InputError = 1;
+			} else {
+				$Revisions[$Month] = filter_number_format($Value);
+			}
+		}
+		if ($InputError == 0) {
+			DB_Txn_Begin();
+			foreach ($Revisions as $Month => $Value) {
+				DB_query("UPDATE forecastdetails SET revisedqty = " . $Value . "
+						WHERE forecastid = " . $ForecastID . " AND periodmonth = '" . $Month . "'", '', '', true);
+			}
+			DB_Txn_Commit();
+			prnMsg(__('The revised quantities have been saved. They replace the calculated quantities wherever the forecast is used; run the conversion to MRP demands again to pass them on to MRP.'), 'success');
+		}
+	}
+
+	$Params = json_decode($Forecast['parameters'], true) ?: array();
+	echo '<table class="selection">
+			<tr><td>' . __('Item') . '</td><td>' . $Forecast['stockid'] . ' - ' . $Forecast['description'] . '</td></tr>
+			<tr><td>' . __('Location') . '</td><td>' . ForecastLocationName($Forecast['loccode']) . '</td></tr>
+			<tr><td>' . __('Method') . '</td><td>' . $Forecast['methodid'] . ' - ' . $Methods[$Forecast['methodid']]['name'] . (($Params['selection'] ?? '') == 'bestfit' ? ' (' . __('best fit') . ')' : '') . '</td></tr>
+			<tr><td>' . __('Parameters') . '</td><td>' . ForecastMethodDescriptionOfParams($Forecast['methodid'], $Params + ForecastBaseParams()) . '</td></tr>
+			<tr><td>' . __('Based on history') . '</td><td>' . ForecastMonthLabel($Forecast['historyfrom']) . ' - ' . ForecastMonthLabel($Forecast['historyto']) . '</td></tr>
+			<tr><td>' . __('Generated') . '</td><td>' . $Forecast['generatedon'] . ' ' . $Forecast['generatedby'] . '</td></tr>
+			<tr><td>' . __('Status') . '</td><td>' . ($Active ? __('Active') : __('Superseded')) . '</td></tr>
+		</table>';
+
+	$Details = array();
+	$Result = DB_query("SELECT periodmonth, calcqty, revisedqty FROM forecastdetails WHERE forecastid = " . $ForecastID . " ORDER BY periodmonth");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Details[] = $MyRow;
+	}
+
+	// last year's actual for the same months
+	$LastYear = array();
+	if (count($Details) > 0) {
+		$Where = "stockid='" . $Forecast['stockid'] . "'" . ($Forecast['loccode'] != '' ? " AND loccode='" . $Forecast['loccode'] . "'" : '');
+		$Result = DB_query("SELECT periodmonth, SUM(quantity) AS qty
+							FROM forecastsaleshistory
+							WHERE " . $Where . "
+								AND periodmonth BETWEEN '" . ForecastAddMonths($Details[0]['periodmonth'], -12) . "' AND '" . ForecastAddMonths($Details[count($Details) - 1]['periodmonth'], -12) . "'
+							GROUP BY periodmonth");
+		while ($MyRow = DB_fetch_array($Result)) {
+			$LastYear[$MyRow['periodmonth']] = max(0, $MyRow['qty']);
+		}
+	}
+	$Bounds = ForecastHistoryBounds();
+
+	echo '<form method="post" action="' . $Self . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="ForecastID" value="' . $ForecastID . '" />
+		<table class="selection">
+			<tr>
+				<th>' . __('Period') . '</th>
+				<th>' . __('Calculated') . '</th>
+				<th>' . __('Revised') . '</th>
+				<th>' . __('Forecast used') . '</th>
+				<th>' . __('Last year actual') . '</th>
+				<th>' . __('Variance') . '</th>
+				<th>' . __('Variance %') . '</th>
+			</tr>';
+	foreach ($Details as $Detail) {
+		$Effective = $Detail['revisedqty'] === null ? $Detail['calcqty'] : $Detail['revisedqty'];
+		$PriorMonth = ForecastAddMonths($Detail['periodmonth'], -12);
+		$PriorHeld = ($Bounds !== null and $PriorMonth >= $Bounds['blockstart'] and $PriorMonth <= $Bounds['last']);
+		$Actual = $PriorHeld ? ($LastYear[$PriorMonth] ?? 0) : null;
+		$VarianceText = $VariancePercentText = '';
+		$Style = '';
+		if ($Actual !== null) {
+			$VarianceText = locale_number_format($Effective - $Actual, 2);
+			if ($Actual > 0) {
+				$Percent = 100 * ($Effective - $Actual) / $Actual;
+				$VariancePercentText = locale_number_format($Percent, 1);
+				if (abs($Percent) >= FORECAST_VARIANCE_HIGHLIGHT) {
+					$Style = ' style="background-color:#fcc;font-weight:bold"';
+				}
+			}
+		}
+		echo '<tr class="striped_row">
+				<td>' . ForecastMonthLabel($Detail['periodmonth']) . '</td>
+				<td class="number">' . locale_number_format($Detail['calcqty'], 2) . '</td>
+				<td class="number">' . ($Active
+					? '<input type="text" class="number" name="Revised[' . $Detail['periodmonth'] . ']" size="9" value="' . ($Detail['revisedqty'] === null ? '' : locale_number_format($Detail['revisedqty'], 2)) . '" />'
+					: ($Detail['revisedqty'] === null ? '' : locale_number_format($Detail['revisedqty'], 2))) . '</td>
+				<td class="number">' . locale_number_format($Effective, 2) . '</td>
+				<td class="number">' . ($Actual === null ? '' : locale_number_format($Actual, 2)) . '</td>
+				<td class="number"' . $Style . '>' . $VarianceText . '</td>
+				<td class="number"' . $Style . '>' . $VariancePercentText . '</td>
+			</tr>';
+	}
+	echo '</table>';
+	if ($Active) {
+		echo '<div class="page_help_text">' . __('A revised quantity takes priority over the calculated quantity in reports, accuracy and MRP. Clear it to use the calculated quantity again. Variances of') . ' ' . FORECAST_VARIANCE_HIGHLIGHT . '% ' . __('or more against last year are highlighted.') . '</div>
+			<div class="centre"><input type="submit" name="SaveRevisions" value="' . __('Save Revised Quantities') . '" /></div>';
+	}
+	echo '</form>';
+	echo '<div class="centre"><a href="' . $Self . '">' . __('Search forecasts') . '</a></div>';
+} else {
+	// search
+	$StockCode = trim(mb_strtoupper($_POST['StockCode'] ?? ''));
+	$CategoryID = $_POST['CategoryID'] ?? '';
+	$Location = $_POST['Location'] ?? '*';
+	echo '<form method="post" action="' . $Self . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Search Active Forecasts') . '</legend>
+			<field>
+				<label for="StockCode">' . __('Part of the item code or description') . ':</label>
+				<input type="text" name="StockCode" size="21" value="' . $StockCode . '" />
+			</field>
+			<field>
+				<label for="CategoryID">' . __('Stock category') . ':</label>
+				<select name="CategoryID">' . ForecastCategoryOptions($CategoryID, __('Any category')) . '</select>
+			</field>
+			<field>
+				<label for="Location">' . __('Location') . ':</label>
+				<select name="Location"><option value="*"' . ($Location == '*' ? ' selected="selected"' : '') . '>' . __('Any location') . '</option>' . ForecastLocationOptions($Location == '*' ? 'none' : $Location) . '</select>
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Search" value="' . __('Search') . '" /></div>
+	</form>';
+
+	if (isset($_POST['Search'])) {
+		$SQL = "SELECT forecasts.forecastid,
+						forecasts.stockid,
+						forecasts.loccode,
+						forecasts.methodid,
+						forecasts.generatedon,
+						stockmaster.description
+				FROM forecasts
+				INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+				WHERE forecasts.activeslot = 1";
+		if ($StockCode != '') {
+			$SQL .= " AND (forecasts.stockid LIKE '%" . $StockCode . "%' OR stockmaster.description LIKE '%" . $StockCode . "%')";
+		}
+		if ($CategoryID != '') {
+			$SQL .= " AND stockmaster.categoryid='" . $CategoryID . "'";
+		}
+		if ($Location != '*') {
+			$SQL .= " AND forecasts.loccode='" . $Location . "'";
+		}
+		$SQL .= " ORDER BY forecasts.stockid, forecasts.loccode LIMIT 500";
+		$Result = DB_query($SQL);
+		if (DB_num_rows($Result) == 0) {
+			prnMsg(__('No active forecasts were found'), 'info');
+		} else {
+			echo '<table class="selection">
+					<tr>
+						<th>' . __('Item') . '</th>
+						<th>' . __('Description') . '</th>
+						<th>' . __('Location') . '</th>
+						<th>' . __('Method') . '</th>
+						<th>' . __('Generated') . '</th>
+					</tr>';
+			while ($MyRow = DB_fetch_array($Result)) {
+				echo '<tr class="striped_row">
+						<td><a href="' . $Self . '?ForecastID=' . $MyRow['forecastid'] . '">' . $MyRow['stockid'] . '</a></td>
+						<td>' . $MyRow['description'] . '</td>
+						<td>' . ForecastLocationName($MyRow['loccode']) . '</td>
+						<td>' . $MyRow['methodid'] . ' - ' . $Methods[$MyRow['methodid']]['name'] . '</td>
+						<td>' . $MyRow['generatedon'] . '</td>
+					</tr>';
+			}
+			echo '</table>';
+		}
+	}
+}
+
+include('includes/footer.php');
diff --git a/ForecastSalesHistory.php b/ForecastSalesHistory.php
new file mode 100644

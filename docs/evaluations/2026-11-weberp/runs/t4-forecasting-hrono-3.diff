diff --git a/includes/ForecastFunctions.php b/includes/ForecastFunctions.php
new file mode 100644
index 0000000..711662e
--- /dev/null
+++ b/includes/ForecastFunctions.php
@@ -0,0 +1,1073 @@
+<?php
+
+/* Demand forecasting: sales history, the twelve forecasting methods, best fit, accuracy measures and the
+ * conversion of forecasts to MRP demands. Used by the Forecast*.php pages.
+ *
+ * Months are held as the SQL date of their first day ('2025-03-01'). A location code of '' on a forecast means all
+ * locations combined.
+ */
+
+// the forecast the planner sees is the revised quantity when there is one, the calculated quantity otherwise
+define('FORECAST_EFFECTIVE_QTY', 'COALESCE(forecastdetails.revisedqty, forecastdetails.calcqty)');
+// a forecast is flagged when its percent of accuracy is further than this many points away from 100
+define('FORECAST_ACCURACY_TOLERANCE', 30);
+// a forecast period is highlighted when it is this many percent away from the same month last year
+define('FORECAST_VARIANCE_HIGHLIGHT', 25);
+define('FORECAST_MRP_DEMAND_TYPE', 'FCST');
+
+function ForecastMethods() {
+	return array(
+		1 => array('name' => __('Percent over last year'), 'min' => 12),
+		2 => array('name' => __('Calculated percent over last year'), 'min' => 24),
+		3 => array('name' => __('Last year to this year'), 'min' => 12),
+		4 => array('name' => __('Moving average'), 'min' => 4),
+		5 => array('name' => __('Linear approximation'), 'min' => 6),
+		6 => array('name' => __('Least squares regression'), 'min' => 12),
+		7 => array('name' => __('Second degree regression'), 'min' => 12),
+		8 => array('name' => __('Flexible method'), 'min' => 12),
+		9 => array('name' => __('Weighted moving average'), 'min' => 4),
+		10 => array('name' => __('Simple exponential smoothing'), 'min' => 12),
+		11 => array('name' => __('Holt double exponential smoothing'), 'min' => 12),
+		12 => array('name' => __('Holt-Winters'), 'min' => 24)
+	);
+}
+
+function ForecastDimensions() {
+	return array(
+		'category' => __('Stock category'),
+		'custtype' => __('Customer type'),
+		'area' => __('Sales area'),
+		'salesman' => __('Salesperson')
+	);
+}
+
+/* ------------------------------------------------------------------ parameters */
+
+/* The company wide defaults, from the config table (ForecastParameters.php) */
+function ForecastGetDefaults() {
+	$Defaults = array(
+		'alpha' => 0.3,
+		'beta' => 0.2,
+		'gamma' => 0.2,
+		'season' => 12,
+		'maperiods' => 4,
+		'holdout' => 3,
+		'horizon' => 6
+	);
+	$Keys = array(
+		'ForecastAlpha' => 'alpha',
+		'ForecastBeta' => 'beta',
+		'ForecastGamma' => 'gamma',
+		'ForecastSeasonLength' => 'season',
+		'ForecastMAPeriods' => 'maperiods',
+		'ForecastHoldoutMonths' => 'holdout',
+		'ForecastHorizon' => 'horizon'
+	);
+	$Result = DB_query("SELECT confname, confvalue FROM config WHERE confname IN ('" . implode("','", array_keys($Keys)) . "')");
+	while ($MyRow = DB_fetch_array($Result)) {
+		if (is_numeric($MyRow['confvalue'])) {
+			$Defaults[$Keys[$MyRow['confname']]] = $MyRow['confvalue'] + 0;
+		}
+	}
+	return $Defaults;
+}
+
+/* The parameters a method run starts from: the company defaults plus the settings that are only chosen per run */
+function ForecastBaseParams() {
+	$Defaults = ForecastGetDefaults();
+	return array(
+		'alpha' => $Defaults['alpha'],
+		'beta' => $Defaults['beta'],
+		'gamma' => $Defaults['gamma'],
+		'season' => (int) $Defaults['season'],
+		'maperiods' => (int) $Defaults['maperiods'],
+		'percent' => 10,
+		'lag' => 5,
+		'wma' => array(40, 30, 20, 10),
+		'weights' => array_fill(0, 12, round(1 / 12, 6))
+	);
+}
+
+/* '40,30,20,10' -> array(40.0, 30.0, 20.0, 10.0), or null when the text is not a list of non negative numbers */
+function ForecastParseWeights($Text, $MaxCount) {
+	$Weights = array();
+	foreach (explode(',', str_replace(array(';', ' ', '/'), ',', $Text)) as $Entry) {
+		if ($Entry === '') {
+			continue;
+		}
+		if (!is_numeric($Entry) or $Entry < 0) {
+			return null;
+		}
+		$Weights[] = (float) $Entry;
+	}
+	if (count($Weights) == 0 or count($Weights) > $MaxCount or array_sum($Weights) <= 0) {
+		return null;
+	}
+	return $Weights;
+}
+
+function ForecastMethodDescriptionOfParams($MethodID, $P) {
+	switch ($MethodID) {
+		case 1:
+			return __('Percent') . ' ' . $P['percent'];
+		case 4:
+			return __('Periods') . ' ' . $P['maperiods'];
+		case 5:
+			return __('Periods between the two points') . ' ' . $P['lag'];
+		case 8:
+			return __('Weights') . ' ' . implode('/', $P['weights']);
+		case 9:
+			return __('Weights') . ' ' . implode('/', $P['wma']);
+		case 10:
+			return __('Alpha') . ' ' . $P['alpha'];
+		case 11:
+			return __('Alpha') . ' ' . $P['alpha'] . ', ' . __('Beta') . ' ' . $P['beta'];
+		case 12:
+			return __('Alpha') . ' ' . $P['alpha'] . ', ' . __('Beta') . ' ' . $P['beta'] . ', ' . __('Gamma') . ' ' . $P['gamma'] . ', ' . __('Season length') . ' ' . $P['season'];
+	}
+	return '';
+}
+
+/* ------------------------------------------------------------------ months */
+
+function ForecastMonthStart($Date) {
+	return date('Y-m-01', strtotime($Date));
+}
+
+function ForecastAddMonths($Month, $Number) {
+	return date('Y-m-d', mktime(0, 0, 0, (int) substr($Month, 5, 2) + $Number, 1, (int) substr($Month, 0, 4)));
+}
+
+/* Number of months from $From to $To, both first of month */
+function ForecastMonthDiff($From, $To) {
+	return ((int) substr($To, 0, 4) - (int) substr($From, 0, 4)) * 12 + (int) substr($To, 5, 2) - (int) substr($From, 5, 2);
+}
+
+function ForecastMonthLabel($Month) {
+	return date('M Y', strtotime($Month));
+}
+
+function ForecastIsMonth($Text) {
+	return preg_match('/^\d{4}-(0[1-9]|1[0-2])$/', $Text) == 1;
+}
+
+/* ------------------------------------------------------------------ sales history */
+
+/* The months held in the history: first, last, how many, and where the unbroken run that ends at the last month
+ * starts. Null when nothing has been extracted. */
+function ForecastHistoryBounds($Refresh = false) {
+	static $Bounds = false;
+	if ($Refresh or $Bounds === false) {
+		$Result = DB_query("SELECT periodmonth FROM forecasthistorymonths ORDER BY periodmonth");
+		$Months = array();
+		while ($MyRow = DB_fetch_row($Result)) {
+			$Months[] = $MyRow[0];
+		}
+		if (count($Months) == 0) {
+			$Bounds = null;
+		} else {
+			$Last = end($Months);
+			$BlockStart = $Last;
+			for ($i = count($Months) - 2; $i >= 0; $i--) {
+				if (ForecastMonthDiff($Months[$i], $BlockStart) != 1) {
+					break;
+				}
+				$BlockStart = $Months[$i];
+			}
+			$Bounds = array(
+				'first' => $Months[0],
+				'last' => $Last,
+				'count' => count($Months),
+				'span' => ForecastMonthDiff($Months[0], $Last) + 1,
+				'blockstart' => $BlockStart
+			);
+		}
+	}
+	return $Bounds;
+}
+
+function ForecastHistoryItemCount() {
+	$Result = DB_query("SELECT COUNT(DISTINCT stockid) FROM forecastsaleshistory");
+	$MyRow = DB_fetch_row($Result);
+	return (int) $MyRow[0];
+}
+
+/* Extract the invoiced sales net of credit notes into monthly buckets for the months $FromMonth to $ToMonth
+ * (inclusive). The sales are the stock movements of sales invoices (type 10) and credit notes (type 11) that are not
+ * hidden, as in the inventory planning report and the sales inquiries, so credits are deducted and open orders do not
+ * count. The months extracted before are replaced, never added to. */
+function ForecastExtractHistory($FromMonth, $ToMonth) {
+	$FromDate = $FromMonth;
+	$ToDate = date('Y-m-t', strtotime($ToMonth));
+
+	DB_Txn_Begin();
+	DB_query("DELETE FROM forecastsaleshistory WHERE periodmonth BETWEEN '" . $FromDate . "' AND '" . $ToDate . "'", '', '', true);
+	DB_query("DELETE FROM forecasthistorymonths WHERE periodmonth BETWEEN '" . $FromDate . "' AND '" . $ToDate . "'", '', '', true);
+
+	$SQL = "INSERT INTO forecastsaleshistory (stockid,
+											loccode,
+											debtortype,
+											area,
+											salesman,
+											periodmonth,
+											quantity)
+			SELECT stockmoves.stockid,
+					stockmoves.loccode,
+					COALESCE(debtorsmaster.typeid, 0),
+					COALESCE(custbranch.area, ''),
+					COALESCE(custbranch.salesman, ''),
+					DATE_FORMAT(stockmoves.trandate, '%Y-%m-01'),
+					-SUM(stockmoves.qty)
+			FROM stockmoves
+			LEFT JOIN debtorsmaster
+				ON debtorsmaster.debtorno = stockmoves.debtorno
+			LEFT JOIN custbranch
+				ON custbranch.debtorno = stockmoves.debtorno
+				AND custbranch.branchcode = stockmoves.branchcode
+			WHERE stockmoves.type IN (10, 11)
+				AND stockmoves.hidemovt = 0
+				AND stockmoves.trandate BETWEEN '" . $FromDate . "' AND '" . $ToDate . "'
+			GROUP BY stockmoves.stockid,
+					stockmoves.loccode,
+					COALESCE(debtorsmaster.typeid, 0),
+					COALESCE(custbranch.area, ''),
+					COALESCE(custbranch.salesman, ''),
+					DATE_FORMAT(stockmoves.trandate, '%Y-%m-01')";
+	DB_query($SQL, __('The sales history could not be extracted because'), '', true);
+	$Result = DB_query("SELECT COUNT(*) FROM forecastsaleshistory WHERE periodmonth BETWEEN '" . $FromDate . "' AND '" . $ToDate . "'", '', '', true);
+	$MyRow = DB_fetch_row($Result);
+	$Rows = (int) $MyRow[0];
+
+	$Values = array();
+	for ($Month = $FromMonth; $Month <= $ToMonth; $Month = ForecastAddMonths($Month, 1)) {
+		$Values[] = "('" . $Month . "', '" . date('Y-m-d H:i:s') . "', '" . $_SESSION['UserID'] . "')";
+	}
+	DB_query("INSERT INTO forecasthistorymonths (periodmonth, extractedon, extractedby) VALUES " . implode(',', $Values), '', '', true);
+	DB_Txn_Commit();
+	ForecastHistoryBounds(true);
+
+	return $Rows;
+}
+
+/* The monthly sales of a set of history rows as a series ready for forecasting.
+ * $Join and $Where select the rows of forecastsaleshistory (aliased h). The series covers the unbroken part of the
+ * history that ends at the last month held and starts with the first month that has sales: months before the first
+ * sale are not history of the item. A month with net negative sales counts as no demand.
+ * Returns array('values' => array, 'first' => month, 'last' => month), values being empty when there are no sales. */
+function ForecastLoadSeries($Where, $Join = '') {
+	$Series = array('values' => array(), 'first' => '', 'last' => '');
+	$Bounds = ForecastHistoryBounds();
+	if ($Bounds === null) {
+		return $Series;
+	}
+	$SQL = "SELECT h.periodmonth, SUM(h.quantity) AS qty
+			FROM forecastsaleshistory h " . $Join . "
+			WHERE h.periodmonth >= '" . $Bounds['blockstart'] . "'
+				AND h.periodmonth <= '" . $Bounds['last'] . "'
+				AND " . $Where . "
+			GROUP BY h.periodmonth";
+	$Result = DB_query($SQL);
+	$Quantities = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Quantities[$MyRow['periodmonth']] = $MyRow['qty'];
+	}
+	$Started = false;
+	for ($Month = $Bounds['blockstart']; $Month <= $Bounds['last']; $Month = ForecastAddMonths($Month, 1)) {
+		$Quantity = isset($Quantities[$Month]) ? max(0, (float) $Quantities[$Month]) : 0;
+		if (!$Started and $Quantity > 0) {
+			$Started = true;
+			$Series['first'] = $Month;
+		}
+		if ($Started) {
+			$Series['values'][] = $Quantity;
+		}
+	}
+	$Series['last'] = $Bounds['last'];
+	return $Series;
+}
+
+function ForecastItemSeries($StockID, $LocCode) {
+	$Where = "h.stockid='" . $StockID . "'";
+	if ($LocCode != '') {
+		$Where .= " AND h.loccode='" . $LocCode . "'";
+	}
+	return ForecastLoadSeries($Where);
+}
+
+/* The history rows of one value of a summary dimension */
+function ForecastSummaryFilter($Dimension, $Value) {
+	switch ($Dimension) {
+		case 'category':
+			return array('where' => "stockmaster.categoryid='" . $Value . "'", 'join' => "INNER JOIN stockmaster ON stockmaster.stockid = h.stockid");
+		case 'custtype':
+			return array('where' => "h.debtortype=" . (int) $Value, 'join' => '');
+		case 'area':
+			return array('where' => "h.area='" . $Value . "'", 'join' => '');
+		case 'salesman':
+			return array('where' => "h.salesman='" . $Value . "'", 'join' => '');
+	}
+	return array('where' => '1=0', 'join' => '');
+}
+
+function ForecastSummarySeries($Dimension, $Value) {
+	$Filter = ForecastSummaryFilter($Dimension, $Value);
+	return ForecastLoadSeries($Filter['where'], $Filter['join']);
+}
+
+/* Values of a summary dimension that have history, as code => description */
+function ForecastSummaryValues($Dimension) {
+	switch ($Dimension) {
+		case 'category':
+			$SQL = "SELECT DISTINCT stockcategory.categoryid AS code, stockcategory.categorydescription AS descr
+					FROM forecastsaleshistory h
+					INNER JOIN stockmaster ON stockmaster.stockid = h.stockid
+					INNER JOIN stockcategory ON stockcategory.categoryid = stockmaster.categoryid
+					ORDER BY stockcategory.categoryid";
+			break;
+		case 'custtype':
+			$SQL = "SELECT DISTINCT h.debtortype AS code, COALESCE(debtortype.typename, '') AS descr
+					FROM forecastsaleshistory h
+					LEFT JOIN debtortype ON debtortype.typeid = h.debtortype
+					ORDER BY h.debtortype";
+			break;
+		case 'area':
+			$SQL = "SELECT DISTINCT h.area AS code, COALESCE(areas.areadescription, '') AS descr
+					FROM forecastsaleshistory h
+					LEFT JOIN areas ON areas.areacode = h.area
+					WHERE h.area <> ''
+					ORDER BY h.area";
+			break;
+		case 'salesman':
+			$SQL = "SELECT DISTINCT h.salesman AS code, COALESCE(salesman.salesmanname, '') AS descr
+					FROM forecastsaleshistory h
+					LEFT JOIN salesman ON salesman.salesmancode = h.salesman
+					WHERE h.salesman <> ''
+					ORDER BY h.salesman";
+			break;
+		default:
+			return array();
+	}
+	$Result = DB_query($SQL);
+	$Values = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Values[$MyRow['code']] = $MyRow['descr'];
+	}
+	return $Values;
+}
+
+/* ------------------------------------------------------------------ the methods */
+
+function ForecastSolve($A, $B) {
+	$n = count($B);
+	for ($i = 0; $i < $n; $i++) {
+		$Pivot = $i;
+		for ($r = $i + 1; $r < $n; $r++) {
+			if (abs($A[$r][$i]) > abs($A[$Pivot][$i])) {
+				$Pivot = $r;
+			}
+		}
+		if (abs($A[$Pivot][$i]) < 1e-12) {
+			return null;
+		}
+		list($A[$i], $A[$Pivot]) = array($A[$Pivot], $A[$i]);
+		list($B[$i], $B[$Pivot]) = array($B[$Pivot], $B[$i]);
+		for ($r = $i + 1; $r < $n; $r++) {
+			$Factor = $A[$r][$i] / $A[$i][$i];
+			for ($c = $i; $c < $n; $c++) {
+				$A[$r][$c] -= $Factor * $A[$i][$c];
+			}
+			$B[$r] -= $Factor * $B[$i];
+		}
+	}
+	$X = array_fill(0, $n, 0);
+	for ($i = $n - 1; $i >= 0; $i--) {
+		$Sum = $B[$i];
+		for ($c = $i + 1; $c < $n; $c++) {
+			$Sum -= $A[$i][$c] * $X[$c];
+		}
+		$X[$i] = $Sum / $A[$i][$i];
+	}
+	return $X;
+}
+
+function ForecastFinish($Values) {
+	foreach ($Values as $Key => $Value) {
+		$Values[$Key] = max(0, round($Value, 2)); // no negative forecast quantities
+	}
+	return $Values;
+}
+
+/* Forecast the next $h months of the series $y (oldest first) with method $MethodID.
+ * Returns array('values' => array of $h quantities) or array('error' => reason): a series that is too short for the
+ * method is reported, nothing is forecast from made up data. */
+function ForecastCompute($MethodID, $y, $h, $P) {
+	$Methods = ForecastMethods();
+	if (!isset($Methods[$MethodID])) {
+		return array('error' => __('Unknown forecasting method'));
+	}
+	$y = array_values($y);
+	$n = count($y);
+	$Min = $Methods[$MethodID]['min'];
+
+	// parameter checks, and the history the parameters need
+	if (in_array($MethodID, array(10, 11, 12)) and ($P['alpha'] < 0.1 or $P['alpha'] > 0.9)) {
+		return array('error' => __('Alpha must be between 0.1 and 0.9'));
+	}
+	if (in_array($MethodID, array(11, 12)) and ($P['beta'] < 0.1 or $P['beta'] > 0.9)) {
+		return array('error' => __('Beta must be between 0.1 and 0.9'));
+	}
+	if ($MethodID == 12 and ($P['gamma'] < 0.1 or $P['gamma'] > 0.9)) {
+		return array('error' => __('Gamma must be between 0.1 and 0.9'));
+	}
+	switch ($MethodID) {
+		case 1:
+			if (!is_numeric($P['percent']) or $P['percent'] <= -100) {
+				return array('error' => __('The percent must be a number above -100'));
+			}
+			break;
+		case 4:
+			if ($P['maperiods'] < 2 or $P['maperiods'] > 24) {
+				return array('error' => __('The moving average needs between 2 and 24 periods'));
+			}
+			$Min = max($Min, $P['maperiods']);
+			break;
+		case 5:
+			if ($P['lag'] < 1) {
+				return array('error' => __('The two points must be at least one period apart'));
+			}
+			$Min = max($Min, $P['lag'] + 1);
+			break;
+		case 8:
+			if (count($P['weights']) < 1 or count($P['weights']) > 12) {
+				return array('error' => __('The flexible method takes between 1 and 12 weights'));
+			}
+			break;
+		case 9:
+			if (count($P['wma']) < 2 or count($P['wma']) > 24 or array_sum($P['wma']) <= 0) {
+				return array('error' => __('The weighted moving average needs between 2 and 24 weights'));
+			}
+			$Min = max($Min, count($P['wma']));
+			break;
+		case 12:
+			if ($P['season'] < 2 or $P['season'] > 12) {
+				return array('error' => __('The season length must be between 2 and 12'));
+			}
+			$Min = 2 * $P['season'];
+			break;
+	}
+	if ($n < $Min) {
+		return array('error' => sprintf(__('%d months of history, the method needs at least %d'), $n, $Min));
+	}
+
+	$f = array();
+	switch ($MethodID) {
+		case 1:
+		case 2:
+		case 3:
+			if ($MethodID == 1) {
+				$Growth = $P['percent'] / 100;
+			} elseif ($MethodID == 2) {
+				$Last = array_sum(array_slice($y, $n - 12, 12));
+				$Prior = array_sum(array_slice($y, $n - 24, 12));
+				if ($Prior <= 0) {
+					return array('error' => __('There were no sales in the year before last, so the growth cannot be calculated'));
+				}
+				$Growth = $Last / $Prior - 1;
+			} else {
+				$Growth = 0;
+			}
+			$v = $y;
+			for ($k = 0; $k < $h; $k++) {
+				$v[$n + $k] = max(0, $v[$n + $k - 12] * (1 + $Growth));
+			}
+			$f = array_slice($v, $n);
+			break;
+
+		case 4:
+		case 9:
+			if ($MethodID == 4) {
+				$Weights = array_fill(0, $P['maperiods'], 1);
+			} else {
+				$Weights = array_values($P['wma']); // first weight is for the most recent period
+			}
+			$Count = count($Weights);
+			$WeightSum = array_sum($Weights);
+			$v = $y;
+			for ($k = 0; $k < $h; $k++) {
+				$Sum = 0;
+				for ($i = 0; $i < $Count; $i++) {
+					$Sum += $Weights[$i] * $v[$n + $k - 1 - $i];
+				}
+				$v[$n + $k] = $Sum / $WeightSum;
+			}
+			$f = array_slice($v, $n);
+			break;
+
+		case 5:
+			$Slope = ($y[$n - 1] - $y[$n - 1 - $P['lag']]) / $P['lag'];
+			for ($k = 1; $k <= $h; $k++) {
+				$f[] = $y[$n - 1] + $Slope * $k;
+			}
+			break;
+
+		case 6:
+			$SumX = $SumY = $SumXY = $SumXX = 0;
+			for ($i = 0; $i < $n; $i++) {
+				$SumX += $i;
+				$SumY += $y[$i];
+				$SumXY += $i * $y[$i];
+				$SumXX += $i * $i;
+			}
+			$Slope = ($n * $SumXY - $SumX * $SumY) / ($n * $SumXX - $SumX * $SumX);
+			$Intercept = ($SumY - $Slope * $SumX) / $n;
+			for ($k = 0; $k < $h; $k++) {
+				$f[] = $Intercept + $Slope * ($n + $k);
+			}
+			break;
+
+		case 7:
+			$Mean = ($n - 1) / 2; // centred x keeps the normal equations well conditioned
+			$S = array_fill(0, 5, 0);
+			$T = array_fill(0, 3, 0);
+			for ($i = 0; $i < $n; $i++) {
+				$x = $i - $Mean;
+				for ($j = 0; $j <= 4; $j++) {
+					$S[$j] += pow($x, $j);
+				}
+				for ($j = 0; $j <= 2; $j++) {
+					$T[$j] += pow($x, $j) * $y[$i];
+				}
+			}
+			$Coefficients = ForecastSolve(array(
+				array($S[0], $S[1], $S[2]),
+				array($S[1], $S[2], $S[3]),
+				array($S[2], $S[3], $S[4])
+			), $T);
+			if ($Coefficients === null) {
+				return array('error' => __('The regression could not be calculated'));
+			}
+			for ($k = 0; $k < $h; $k++) {
+				$x = $n + $k - $Mean;
+				$f[] = $Coefficients[0] + $Coefficients[1] * $x + $Coefficients[2] * $x * $x;
+			}
+			break;
+
+		case 8:
+			$Weights = array_values($P['weights']); // first weight is for the previous month, the second for the month before that...
+			$v = $y;
+			for ($k = 0; $k < $h; $k++) {
+				$Sum = 0;
+				foreach ($Weights as $i => $Weight) {
+					$Sum += $Weight * $v[$n + $k - 1 - $i];
+				}
+				$v[$n + $k] = max(0, $Sum);
+			}
+			$f = array_slice($v, $n);
+			break;
+
+		case 10:
+			$Level = $y[0];
+			for ($i = 1; $i < $n; $i++) {
+				$Level = $P['alpha'] * $y[$i] + (1 - $P['alpha']) * $Level;
+			}
+			$f = array_fill(0, $h, $Level);
+			break;
+
+		case 11:
+			$Level = $y[0];
+			$Trend = ($y[3] - $y[0]) / 3;
+			for ($i = 1; $i < $n; $i++) {
+				$PreviousLevel = $Level;
+				$Level = $P['alpha'] * $y[$i] + (1 - $P['alpha']) * ($Level + $Trend);
+				$Trend = $P['beta'] * ($Level - $PreviousLevel) + (1 - $P['beta']) * $Trend;
+			}
+			for ($k = 1; $k <= $h; $k++) {
+				$f[] = $Level + $k * $Trend;
+			}
+			break;
+
+		case 12:
+			$m = (int) $P['season'];
+			$FirstMean = array_sum(array_slice($y, 0, $m)) / $m;
+			$SecondMean = array_sum(array_slice($y, $m, $m)) / $m;
+			$Trend = ($SecondMean - $FirstMean) / $m;
+			$Level = $FirstMean + $Trend * ($m - 1) / 2;
+			$Season = array();
+			for ($i = 0; $i < $m; $i++) {
+				$Season[$i] = $y[$i] - $FirstMean;
+			}
+			for ($i = $m; $i < $n; $i++) {
+				$PreviousLevel = $Level;
+				$Level = $P['alpha'] * ($y[$i] - $Season[$i % $m]) + (1 - $P['alpha']) * ($Level + $Trend);
+				$Trend = $P['beta'] * ($Level - $PreviousLevel) + (1 - $P['beta']) * $Trend;
+				$Season[$i % $m] = $P['gamma'] * ($y[$i] - $Level) + (1 - $P['gamma']) * $Season[$i % $m];
+			}
+			for ($k = 1; $k <= $h; $k++) {
+				$f[] = $Level + $k * $Trend + $Season[($n - 1 + $k) % $m];
+			}
+			break;
+	}
+	return array('values' => ForecastFinish($f));
+}
+
+/* ------------------------------------------------------------------ accuracy */
+
+/* MAD, MSE, RMSE and POA of forecasts against the actual sales of the same periods.
+ * POA (percent of accuracy) is the forecast total as a percent of the actual total: 100 is a perfect total, above
+ * 100 over forecast, below 100 under forecast. Null when there were no actual sales. */
+function ForecastMetrics($Actual, $Forecast) {
+	$n = count($Actual);
+	$Metrics = array('n' => $n, 'mad' => 0, 'mse' => 0, 'rmse' => 0, 'poa' => null, 'actual' => 0, 'forecast' => 0);
+	if ($n == 0) {
+		return $Metrics;
+	}
+	$AbsError = $SquareError = 0;
+	for ($i = 0; $i < $n; $i++) {
+		$Error = $Actual[$i] - $Forecast[$i];
+		$AbsError += abs($Error);
+		$SquareError += $Error * $Error;
+	}
+	$Metrics['mad'] = $AbsError / $n;
+	$Metrics['mse'] = $SquareError / $n;
+	$Metrics['rmse'] = sqrt($Metrics['mse']);
+	$Metrics['actual'] = array_sum($Actual);
+	$Metrics['forecast'] = array_sum($Forecast);
+	if ($Metrics['actual'] > 0) {
+		$Metrics['poa'] = 100 * $Metrics['forecast'] / $Metrics['actual'];
+	}
+	return $Metrics;
+}
+
+function ForecastIsLowAccuracy($Poa) {
+	return $Poa === null or abs($Poa - 100) > FORECAST_ACCURACY_TOLERANCE;
+}
+
+/* Hold out the last $Holdout months of the series, forecast them with every method the remaining history allows and
+ * rank the methods by mean absolute deviation (root mean square error breaks ties).
+ * Returns array('ranking' => id => metrics, best first, 'actual' => held out months) or array('error' => reason). */
+function ForecastBestFit($Series, $Params, $Holdout) {
+	$n = count($Series);
+	$Methods = ForecastMethods();
+	$Minimum = min(array_column($Methods, 'min'));
+	if ($Holdout < 1 or $n - $Holdout < $Minimum) {
+		return array('error' => sprintf(__('%d months of history is not enough to hold out %d months and still have the %d months the shortest method needs'), $n, $Holdout, $Minimum));
+	}
+	$Train = array_slice($Series, 0, $n - $Holdout);
+	$Actual = array_slice($Series, $n - $Holdout);
+	$Ranking = array();
+	foreach ($Methods as $MethodID => $Method) {
+		$Forecast = ForecastCompute($MethodID, $Train, $Holdout, $Params);
+		if (isset($Forecast['error'])) {
+			continue; // not applicable to this history
+		}
+		$Ranking[$MethodID] = ForecastMetrics($Actual, $Forecast['values']);
+		$Ranking[$MethodID]['values'] = $Forecast['values'];
+	}
+	if (count($Ranking) == 0) {
+		return array('error' => __('No method can be tested with this history'));
+	}
+	uasort($Ranking, function ($A, $B) {
+		if (abs($A['mad'] - $B['mad']) > 1e-9) {
+			return $A['mad'] < $B['mad'] ? -1 : 1;
+		}
+		return $A['rmse'] < $B['rmse'] ? -1 : ($A['rmse'] > $B['rmse'] ? 1 : 0);
+	});
+	return array('ranking' => $Ranking, 'actual' => $Actual);
+}
+
+/* The method that does best across several series: every method is scored by its mean absolute deviation relative to
+ * the average held out sales of the item (so large items do not decide alone), averaged over the items it could be
+ * tested on. Only methods that could be tested on at least half of the items compete.
+ * Returns array('method' => id or null, 'scores' => id => array('score', 'items'), 'items' => items tested) */
+function ForecastBestFitForSet($SeriesSet, $Params, $Holdout) {
+	$Totals = array();
+	$Counts = array();
+	$Tested = 0;
+	foreach ($SeriesSet as $Series) {
+		$Fit = ForecastBestFit($Series, $Params, $Holdout);
+		if (isset($Fit['error'])) {
+			continue;
+		}
+		$Mean = array_sum($Fit['actual']) / count($Fit['actual']);
+		if ($Mean <= 0) {
+			continue;
+		}
+		$Tested++;
+		foreach ($Fit['ranking'] as $MethodID => $Metrics) {
+			$Totals[$MethodID] = ($Totals[$MethodID] ?? 0) + $Metrics['mad'] / $Mean;
+			$Counts[$MethodID] = ($Counts[$MethodID] ?? 0) + 1;
+		}
+	}
+	$Result = array('method' => null, 'scores' => array(), 'items' => $Tested);
+	foreach ($Totals as $MethodID => $Total) {
+		$Result['scores'][$MethodID] = array('score' => $Total / $Counts[$MethodID], 'items' => $Counts[$MethodID]);
+		if ($Counts[$MethodID] * 2 >= $Tested and ($Result['method'] === null or $Result['scores'][$MethodID]['score'] < $Result['scores'][$Result['method']]['score'])) {
+			$Result['method'] = $MethodID;
+		}
+	}
+	return $Result;
+}
+
+/* ------------------------------------------------------------------ generating forecasts */
+
+/* Forecast a series with the chosen method, or with the best fit when $MethodID is 0 (the methods are then tried
+ * best first until one can forecast the full history).
+ * Returns array('method' => id, 'values' => array, 'params' => stored parameters) or array('error' => reason) */
+function ForecastRunSeries($Series, $MethodID, $Horizon, $Params, $Holdout) {
+	$Values = $Series['values'];
+	if (count($Values) == 0) {
+		return array('error' => __('No sales history'));
+	}
+	$Selection = 'manual';
+	if ($MethodID == 0) {
+		$Fit = ForecastBestFit($Values, $Params, $Holdout);
+		if (isset($Fit['error'])) {
+			return array('error' => $Fit['error']);
+		}
+		$Selection = 'bestfit';
+		foreach ($Fit['ranking'] as $Candidate => $Metrics) {
+			$Forecast = ForecastCompute($Candidate, $Values, $Horizon, $Params);
+			if (!isset($Forecast['error'])) {
+				$MethodID = $Candidate;
+				$Accuracy = $Metrics;
+				break;
+			}
+		}
+		if ($MethodID == 0) {
+			return array('error' => __('No method can forecast this history'));
+		}
+	} else {
+		$Forecast = ForecastCompute($MethodID, $Values, $Horizon, $Params);
+		if (isset($Forecast['error'])) {
+			return array('error' => $Forecast['error']);
+		}
+	}
+	$Stored = $Params;
+	$Stored['selection'] = $Selection;
+	if (isset($Accuracy)) {
+		$Stored['holdout'] = $Holdout;
+		$Stored['holdoutmad'] = round($Accuracy['mad'], 4);
+	}
+	return array('method' => $MethodID, 'values' => $Forecast['values'], 'params' => $Stored);
+}
+
+/* Store a forecast of an item and location as the active one. The forecast it replaces stays as a superseded
+ * forecast with its method and parameters (and revisions). */
+function ForecastSaveItemForecast($StockID, $LocCode, $Series, $Run, $Horizon) {
+	$FirstMonth = ForecastAddMonths($Series['last'], 1);
+	DB_Txn_Begin();
+	DB_query("UPDATE forecasts SET activeslot = NULL WHERE stockid='" . $StockID . "' AND loccode='" . $LocCode . "' AND activeslot = 1", '', '', true);
+	DB_query("INSERT INTO forecasts (stockid, loccode, methodid, parameters, horizon, historyfrom, historyto, generatedon, generatedby, activeslot)
+			VALUES ('" . $StockID . "',
+					'" . $LocCode . "',
+					'" . $Run['method'] . "',
+					'" . DB_escape_string(json_encode($Run['params'])) . "',
+					'" . $Horizon . "',
+					'" . $Series['first'] . "',
+					'" . $Series['last'] . "',
+					'" . date('Y-m-d H:i:s') . "',
+					'" . $_SESSION['UserID'] . "',
+					1)", '', '', true);
+	$ForecastID = DB_Last_Insert_ID('forecasts', 'forecastid');
+	$Values = array();
+	foreach ($Run['values'] as $k => $Quantity) {
+		$Values[] = "(" . $ForecastID . ", '" . ForecastAddMonths($FirstMonth, $k) . "', " . $Quantity . ")";
+	}
+	DB_query("INSERT INTO forecastdetails (forecastid, periodmonth, calcqty) VALUES " . implode(',', $Values), '', '', true);
+	DB_Txn_Commit();
+	return $ForecastID;
+}
+
+/* Forecast one item (at one location, or all locations combined when $LocCode is '') and store it.
+ * Returns array('ok' => bool, 'method' => id, 'reason' => text) */
+function ForecastGenerateItem($StockID, $LocCode, $MethodID, $Horizon, $Params, $Holdout) {
+	$Series = ForecastItemSeries($StockID, $LocCode);
+	$Run = ForecastRunSeries($Series, $MethodID, $Horizon, $Params, $Holdout);
+	if (isset($Run['error'])) {
+		return array('ok' => false, 'method' => 0, 'reason' => $Run['error']);
+	}
+	ForecastSaveItemForecast($StockID, $LocCode, $Series, $Run, $Horizon);
+	return array('ok' => true, 'method' => $Run['method'], 'reason' => '');
+}
+
+/* Store a summary forecast of one value of a dimension as the active one */
+function ForecastGenerateSummary($Dimension, $Value, $MethodID, $Horizon, $Params, $Holdout) {
+	$Series = ForecastSummarySeries($Dimension, $Value);
+	$Run = ForecastRunSeries($Series, $MethodID, $Horizon, $Params, $Holdout);
+	if (isset($Run['error'])) {
+		return array('ok' => false, 'method' => 0, 'reason' => $Run['error']);
+	}
+	$FirstMonth = ForecastAddMonths($Series['last'], 1);
+	DB_Txn_Begin();
+	DB_query("UPDATE forecastsummaries SET activeslot = NULL WHERE dimension='" . $Dimension . "' AND dimensionvalue='" . $Value . "' AND activeslot = 1", '', '', true);
+	DB_query("INSERT INTO forecastsummaries (dimension, dimensionvalue, methodid, parameters, horizon, historyfrom, historyto, generatedon, generatedby, activeslot)
+			VALUES ('" . $Dimension . "',
+					'" . $Value . "',
+					'" . $Run['method'] . "',
+					'" . DB_escape_string(json_encode($Run['params'])) . "',
+					'" . $Horizon . "',
+					'" . $Series['first'] . "',
+					'" . $Series['last'] . "',
+					'" . date('Y-m-d H:i:s') . "',
+					'" . $_SESSION['UserID'] . "',
+					1)", '', '', true);
+	$SummaryID = DB_Last_Insert_ID('forecastsummaries', 'summaryid');
+	$Values = array();
+	foreach ($Run['values'] as $k => $Quantity) {
+		$Values[] = "(" . $SummaryID . ", '" . ForecastAddMonths($FirstMonth, $k) . "', " . $Quantity . ")";
+	}
+	DB_query("INSERT INTO forecastsummarydetails (summaryid, periodmonth, calcqty) VALUES " . implode(',', $Values), '', '', true);
+	DB_Txn_Commit();
+	return array('ok' => true, 'method' => $Run['method'], 'reason' => '');
+}
+
+/* The active items of a stock category: not discontinued, and not dummy (service) items, which never move stock */
+function ForecastCategoryItems($CategoryID) {
+	$Result = DB_query("SELECT stockid, description
+						FROM stockmaster
+						WHERE categoryid='" . $CategoryID . "'
+							AND discontinued = 0
+							AND mbflag <> 'D'
+						ORDER BY stockid");
+	$Items = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Items[$MyRow['stockid']] = $MyRow['description'];
+	}
+	return $Items;
+}
+
+/* ------------------------------------------------------------------ MRP */
+
+/* Convert the active forecasts into MRP demands of the forecast demand type.
+ * The demands written are listed in forecastmrplinks. Only linked demands are ever removed or counted as present,
+ * so demands entered by hand or from other sources are never touched, even if they use the same demand type.
+ *  - replace: the linked demands of the items converted that fall in the horizon are deleted first
+ *  - incremental: the periods that already have a linked demand are left alone
+ * Either way converting twice gives the same demands, never double.
+ * An item with an active forecast for all locations is converted from that forecast; an item that only has location
+ * forecasts is converted from the sum of them, so no sale is counted twice.
+ * $FromMonth and $ToMonth are first-of-month dates; the demand of a period is due on the first day of its month.
+ * Returns array('items' => converted, 'created' => demands written, 'removed' => demands deleted, 'skipped' => periods
+ * already there). */
+function ForecastConvertToMRP($FromMonth, $ToMonth, $Mode, $CategoryID = '', $StockID = '') {
+	$Summary = array('items' => 0, 'created' => 0, 'removed' => 0, 'skipped' => 0);
+	$ToDate = date('Y-m-t', strtotime($ToMonth));
+
+	$SQL = "SELECT forecasts.forecastid,
+					forecasts.stockid,
+					forecasts.loccode,
+					forecastdetails.periodmonth,
+					" . FORECAST_EFFECTIVE_QTY . " AS qty
+			FROM forecasts
+			INNER JOIN forecastdetails ON forecastdetails.forecastid = forecasts.forecastid
+			INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+			WHERE forecasts.activeslot = 1
+				AND stockmaster.discontinued = 0
+				AND forecastdetails.periodmonth BETWEEN '" . $FromMonth . "' AND '" . $ToMonth . "'";
+	if ($CategoryID != '') {
+		$SQL .= " AND stockmaster.categoryid='" . $CategoryID . "'";
+	}
+	if ($StockID != '') {
+		$SQL .= " AND forecasts.stockid='" . $StockID . "'";
+	}
+	$Result = DB_query($SQL);
+
+	// per item: the all locations forecast when there is one, else all the location forecasts
+	$Rows = array();
+	$HasAllLocations = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Rows[] = $MyRow;
+		if ($MyRow['loccode'] == '') {
+			$HasAllLocations[$MyRow['stockid']] = true;
+		}
+	}
+	$Demands = array(); // stockid => month => array(quantity, forecastid)
+	foreach ($Rows as $MyRow) {
+		if ($MyRow['loccode'] != '' and isset($HasAllLocations[$MyRow['stockid']])) {
+			continue;
+		}
+		if (!isset($Demands[$MyRow['stockid']][$MyRow['periodmonth']])) {
+			$Demands[$MyRow['stockid']][$MyRow['periodmonth']] = array(0, $MyRow['forecastid']);
+		}
+		$Demands[$MyRow['stockid']][$MyRow['periodmonth']][0] += max(0, $MyRow['qty']);
+	}
+	if (count($Demands) == 0) {
+		return $Summary;
+	}
+
+	$LinkedDemands = "SELECT demandid FROM forecastmrplinks";
+	DB_Txn_Begin();
+	foreach (array_chunk(array_keys($Demands), 200) as $Chunk) {
+		$ItemList = "'" . implode("','", $Chunk) . "'";
+		if ($Mode == 'replace') {
+			$Where = "mrpdemandtype='" . FORECAST_MRP_DEMAND_TYPE . "'
+						AND demandid IN (" . $LinkedDemands . ")
+						AND stockid IN (" . $ItemList . ")
+						AND duedate BETWEEN '" . $FromMonth . "' AND '" . $ToDate . "'";
+			$Result = DB_query("SELECT COUNT(*) FROM mrpdemands WHERE " . $Where, '', '', true);
+			$MyRow = DB_fetch_row($Result);
+			$Summary['removed'] += (int) $MyRow[0];
+			DB_query("DELETE FROM mrpdemands WHERE " . $Where, '', '', true);
+		}
+	}
+	$Present = array();
+	if ($Mode != 'replace') {
+		foreach (array_chunk(array_keys($Demands), 200) as $Chunk) {
+			$Result = DB_query("SELECT mrpdemands.stockid, mrpdemands.duedate
+								FROM mrpdemands
+								INNER JOIN forecastmrplinks ON forecastmrplinks.demandid = mrpdemands.demandid
+								WHERE mrpdemands.mrpdemandtype='" . FORECAST_MRP_DEMAND_TYPE . "'
+									AND mrpdemands.stockid IN ('" . implode("','", $Chunk) . "')
+									AND mrpdemands.duedate BETWEEN '" . $FromMonth . "' AND '" . $ToDate . "'", '', '', true);
+			while ($MyRow = DB_fetch_array($Result)) {
+				$Present[$MyRow['stockid']][ForecastMonthStart($MyRow['duedate'])] = true;
+			}
+		}
+	}
+	foreach ($Demands as $Item => $Periods) {
+		$ItemCreated = 0;
+		foreach ($Periods as $Month => $Demand) {
+			if ($Demand[0] <= 0) {
+				continue;
+			}
+			if (isset($Present[$Item][$Month])) {
+				$Summary['skipped']++;
+				continue;
+			}
+			DB_query("INSERT INTO mrpdemands (stockid, mrpdemandtype, quantity, duedate)
+					VALUES ('" . $Item . "', '" . FORECAST_MRP_DEMAND_TYPE . "', " . round($Demand[0], 4) . ", '" . $Month . "')", '', '', true);
+			$DemandID = DB_Last_Insert_ID('mrpdemands', 'demandid');
+			DB_query("INSERT INTO forecastmrplinks (demandid, forecastid, periodmonth)
+					VALUES (" . $DemandID . ", " . $Demand[1] . ", '" . $Month . "')", '', '', true);
+			$ItemCreated++;
+		}
+		$Summary['created'] += $ItemCreated;
+		$Summary['items']++;
+	}
+	DB_Txn_Commit();
+	return $Summary;
+}
+
+/* ------------------------------------------------------------------ page helpers */
+
+/* Select options of the stock locations; the first option is "all locations" with the value '' */
+function ForecastLocationOptions($Selected) {
+	$HTML = '<option value=""' . ($Selected == '' ? ' selected="selected"' : '') . '>' . __('All locations') . '</option>';
+	$Result = DB_query("SELECT loccode, locationname FROM locations ORDER BY locationname");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$HTML .= '<option value="' . $MyRow['loccode'] . '"' . ($Selected == $MyRow['loccode'] ? ' selected="selected"' : '') . '>' . $MyRow['locationname'] . '</option>';
+	}
+	return $HTML;
+}
+
+function ForecastCategoryOptions($Selected, $AnyLabel = '') {
+	$HTML = '';
+	if ($AnyLabel != '') {
+		$HTML .= '<option value=""' . ($Selected == '' ? ' selected="selected"' : '') . '>' . $AnyLabel . '</option>';
+	}
+	$Result = DB_query("SELECT categoryid, categorydescription FROM stockcategory ORDER BY categorydescription");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$HTML .= '<option value="' . $MyRow['categoryid'] . '"' . ($Selected == $MyRow['categoryid'] ? ' selected="selected"' : '') . '>' . $MyRow['categoryid'] . ' - ' . $MyRow['categorydescription'] . '</option>';
+	}
+	return $HTML;
+}
+
+function ForecastMethodOptions($Selected, $BestFitLabel = '') {
+	$HTML = '';
+	if ($BestFitLabel != '') {
+		$HTML .= '<option value="0"' . ((string) $Selected === '0' ? ' selected="selected"' : '') . '>' . $BestFitLabel . '</option>';
+	}
+	foreach (ForecastMethods() as $MethodID => $Method) {
+		$HTML .= '<option value="' . $MethodID . '"' . ((string) $Selected === (string) $MethodID ? ' selected="selected"' : '') . '>' . $MethodID . ' - ' . $Method['name'] . '</option>';
+	}
+	return $HTML;
+}
+
+function ForecastLocationName($LocCode) {
+	if ($LocCode == '') {
+		return __('All locations');
+	}
+	return $LocCode;
+}
+
+/* The method parameter fields of the generating and comparing pages */
+function ForecastParameterFields($Params) {
+	return '<field>
+			<label for="Percent">' . __('Percent over last year (method 1)') . ':</label>
+			<input type="text" class="number" name="Percent" size="6" value="' . $Params['percent'] . '" />
+		</field>
+		<field>
+			<label for="MAPeriods">' . __('Moving average periods (method 4)') . ':</label>
+			<input type="text" class="number" name="MAPeriods" size="4" value="' . $Params['maperiods'] . '" />
+		</field>
+		<field>
+			<label for="Lag">' . __('Periods between the two points (method 5)') . ':</label>
+			<input type="text" class="number" name="Lag" size="4" value="' . $Params['lag'] . '" />
+		</field>
+		<field>
+			<label for="Weights">' . __('Weights for the previous 12 months, latest first (method 8)') . ':</label>
+			<input type="text" name="Weights" size="40" value="' . implode(',', $Params['weights']) . '" />
+		</field>
+		<field>
+			<label for="WMA">' . __('Weights of the weighted moving average, latest first (method 9)') . ':</label>
+			<input type="text" name="WMA" size="20" value="' . implode(',', $Params['wma']) . '" />
+		</field>
+		<field>
+			<label for="Alpha">' . __('Alpha (methods 10, 11, 12)') . ':</label>
+			<input type="text" class="number" name="Alpha" size="4" value="' . $Params['alpha'] . '" />
+		</field>
+		<field>
+			<label for="Beta">' . __('Beta (methods 11, 12)') . ':</label>
+			<input type="text" class="number" name="Beta" size="4" value="' . $Params['beta'] . '" />
+		</field>
+		<field>
+			<label for="Gamma">' . __('Gamma (method 12)') . ':</label>
+			<input type="text" class="number" name="Gamma" size="4" value="' . $Params['gamma'] . '" />
+		</field>
+		<field>
+			<label for="Season">' . __('Season length (method 12)') . ':</label>
+			<input type="text" class="number" name="Season" size="4" value="' . $Params['season'] . '" />
+		</field>';
+}
+
+/* The method parameters posted by ForecastParameterFields(), on top of the defaults. Errors are added to $Errors. */
+function ForecastParamsFromPost(&$Errors) {
+	$Params = ForecastBaseParams();
+	$Numbers = array('Percent' => 'percent', 'Alpha' => 'alpha', 'Beta' => 'beta', 'Gamma' => 'gamma');
+	foreach ($Numbers as $Field => $Key) {
+		if (isset($_POST[$Field]) and $_POST[$Field] !== '') {
+			if (!is_numeric($_POST[$Field])) {
+				$Errors[] = __('The parameter') . ' ' . $Field . ' ' . __('must be a number');
+			} else {
+				$Params[$Key] = $_POST[$Field] + 0;
+			}
+		}
+	}
+	$Integers = array('MAPeriods' => 'maperiods', 'Lag' => 'lag', 'Season' => 'season');
+	foreach ($Integers as $Field => $Key) {
+		if (isset($_POST[$Field]) and $_POST[$Field] !== '') {
+			if (!ctype_digit((string) $_POST[$Field])) {
+				$Errors[] = __('The parameter') . ' ' . $Field . ' ' . __('must be a whole number');
+			} else {
+				$Params[$Key] = (int) $_POST[$Field];
+			}
+		}
+	}
+	if (isset($_POST['Weights']) and $_POST['Weights'] !== '') {
+		$Weights = ForecastParseWeights($_POST['Weights'], 12);
+		if ($Weights === null) {
+			$Errors[] = __('The flexible method weights must be up to 12 numbers separated by commas');
+		} else {
+			$Params['weights'] = $Weights;
+		}
+	}
+	if (isset($_POST['WMA']) and $_POST['WMA'] !== '') {
+		$Weights = ForecastParseWeights($_POST['WMA'], 24);
+		if ($Weights === null) {
+			$Errors[] = __('The weighted moving average weights must be numbers separated by commas');
+		} else {
+			$Params['wma'] = $Weights;
+		}
+	}
+	return $Params;
+}

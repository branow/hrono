diff --git a/ForecastAccuracy.php b/ForecastAccuracy.php
new file mode 100644
index 0000000..fe15445
--- /dev/null
+++ b/ForecastAccuracy.php
@@ -0,0 +1,147 @@
+<?php
+
+// Compare past forecasts with the actual sales that followed: MAD, POA, MSE and RMSE per item, category and method
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Accuracy');
+$ViewTopic = 'MRP';
+$BookMark = '';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Methods = ForecastMethods();
+$Bounds = ForecastHistoryBounds();
+$CategoryID = $_POST['CategoryID'] ?? '';
+$Location = $_POST['Location'] ?? '*';
+$FromMonth = $_POST['FromMonth'] ?? ($Bounds === null ? '' : substr(ForecastAddMonths($Bounds['last'], -11), 0, 7));
+$ToMonth = $_POST['ToMonth'] ?? ($Bounds === null ? '' : substr($Bounds['last'], 0, 7));
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Accuracy of Past Forecasts') . '</legend>
+		<field>
+			<label for="FromMonth">' . __('From period') . ':</label>
+			<input type="month" name="FromMonth" required="required" value="' . $FromMonth . '" />
+		</field>
+		<field>
+			<label for="ToMonth">' . __('To period') . ':</label>
+			<input type="month" name="ToMonth" required="required" value="' . $ToMonth . '" />
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category') . ':</label>
+			<select name="CategoryID">' . ForecastCategoryOptions($CategoryID, __('Any category')) . '</select>
+		</field>
+		<field>
+			<label for="Location">' . __('Location') . ':</label>
+			<select name="Location"><option value="*"' . ($Location == '*' ? ' selected="selected"' : '') . '>' . __('Any location') . '</option>' . ForecastLocationOptions($Location == '*' ? 'none' : $Location) . '</select>
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Show" value="' . __('Show Accuracy') . '" /></div>
+</form>';
+
+if (isset($_POST['Show'])) {
+	if (!ForecastIsMonth($FromMonth) or !ForecastIsMonth($ToMonth) or $FromMonth > $ToMonth) {
+		prnMsg(__('Enter the first and last period as months, the first not after the last'), 'error');
+	} else {
+		// every forecast period in the range for which the actual sales are held, with the quantity the planner
+		// had (the revised quantity first) and the actual sales of the same item, location and month
+		$SQL = "SELECT forecasts.forecastid,
+						forecasts.stockid,
+						forecasts.loccode,
+						forecasts.methodid,
+						stockmaster.categoryid,
+						forecastdetails.periodmonth,
+						" . FORECAST_EFFECTIVE_QTY . " AS forecastqty,
+						(SELECT COALESCE(SUM(h.quantity), 0)
+							FROM forecastsaleshistory h
+							WHERE h.stockid = forecasts.stockid
+								AND (forecasts.loccode = '' OR h.loccode = forecasts.loccode)
+								AND h.periodmonth = forecastdetails.periodmonth) AS actualqty
+				FROM forecasts
+				INNER JOIN forecastdetails ON forecastdetails.forecastid = forecasts.forecastid
+				INNER JOIN forecasthistorymonths ON forecasthistorymonths.periodmonth = forecastdetails.periodmonth
+				INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+				WHERE forecastdetails.periodmonth BETWEEN '" . $FromMonth . "-01' AND '" . $ToMonth . "-01'";
+		if ($CategoryID != '') {
+			$SQL .= " AND stockmaster.categoryid='" . $CategoryID . "'";
+		}
+		if ($Location != '*') {
+			$SQL .= " AND forecasts.loccode='" . $Location . "'";
+		}
+		$SQL .= " ORDER BY forecasts.forecastid";
+		$Result = DB_query($SQL);
+
+		// where several forecasts cover a period the latest one counts
+		$Points = array();
+		while ($MyRow = DB_fetch_array($Result)) {
+			$Points[$MyRow['stockid'] . '|' . $MyRow['loccode'] . '|' . $MyRow['periodmonth']] = $MyRow;
+		}
+		if (count($Points) == 0) {
+			prnMsg(__('There are no forecast periods in this range that the actual sales are known for'), 'info');
+		} else {
+			$Groups = array('item' => array(), 'category' => array(), 'method' => array());
+			foreach ($Points as $Point) {
+				$Actual = max(0, $Point['actualqty']);
+				$Keys = array(
+					'item' => $Point['stockid'] . '|' . $Point['loccode'],
+					'category' => $Point['categoryid'],
+					'method' => $Point['methodid']
+				);
+				foreach ($Keys as $Group => $Key) {
+					$Groups[$Group][$Key]['actual'][] = $Actual;
+					$Groups[$Group][$Key]['forecast'][] = $Point['forecastqty'];
+				}
+			}
+
+			$Headings = '<th>' . __('Periods') . '</th><th>' . __('Actual') . '</th><th>' . __('Forecast') . '</th><th>MAD</th><th>POA %</th><th>MSE</th><th>RMSE</th>';
+			$MetricCells = function ($Group) {
+				$Metrics = ForecastMetrics($Group['actual'], $Group['forecast']);
+				return array($Metrics, '<td class="number">' . $Metrics['n'] . '</td>
+					<td class="number">' . locale_number_format($Metrics['actual'], 2) . '</td>
+					<td class="number">' . locale_number_format($Metrics['forecast'], 2) . '</td>
+					<td class="number">' . locale_number_format($Metrics['mad'], 2) . '</td>
+					<td class="number">' . ($Metrics['poa'] === null ? '' : locale_number_format($Metrics['poa'], 1)) . '</td>
+					<td class="number">' . locale_number_format($Metrics['mse'], 2) . '</td>
+					<td class="number">' . locale_number_format($Metrics['rmse'], 2) . '</td>');
+			};
+
+			ksort($Groups['method']);
+			echo '<table class="selection"><tr><th colspan="8">' . __('By method') . '</th></tr><tr><th>' . __('Method') . '</th>' . $Headings . '</tr>';
+			foreach ($Groups['method'] as $Key => $Group) {
+				list($Metrics, $Cells) = $MetricCells($Group);
+				echo '<tr class="striped_row"><td>' . $Key . ' - ' . $Methods[$Key]['name'] . '</td>' . $Cells . '</tr>';
+			}
+			echo '</table>';
+
+			ksort($Groups['category']);
+			echo '<table class="selection"><tr><th colspan="8">' . __('By category') . '</th></tr><tr><th>' . __('Category') . '</th>' . $Headings . '</tr>';
+			foreach ($Groups['category'] as $Key => $Group) {
+				list($Metrics, $Cells) = $MetricCells($Group);
+				echo '<tr class="striped_row"><td>' . $Key . '</td>' . $Cells . '</tr>';
+			}
+			echo '</table>';
+
+			ksort($Groups['item']);
+			echo '<table class="selection"><tr><th colspan="9">' . __('By item and location') . '</th></tr>
+					<tr><th>' . __('Item') . '</th><th>' . __('Location') . '</th>' . $Headings . '<th>' . __('Accuracy') . '</th></tr>';
+			foreach ($Groups['item'] as $Key => $Group) {
+				list($StockID, $LocCode) = explode('|', $Key);
+				list($Metrics, $Cells) = $MetricCells($Group);
+				$Low = ForecastIsLowAccuracy($Metrics['poa']);
+				echo '<tr class="striped_row">
+						<td><a href="' . $RootPath . '/ForecastReview.php?StockID=' . urlencode($StockID) . '&amp;Location=' . urlencode($LocCode) . '">' . $StockID . '</a></td>
+						<td>' . ForecastLocationName($LocCode) . '</td>' . $Cells . '
+						<td' . ($Low ? ' style="background-color:#fcc;font-weight:bold"' : '') . '>' . ($Low ? __('Low') : __('OK')) . '</td>
+					</tr>';
+			}
+			echo '</table>';
+			echo '<div class="page_help_text">' . __('MAD is the mean absolute deviation of the forecast from the actual sales per period, MSE the mean square error and RMSE its square root. POA is the percent of accuracy: the forecast total as a percent of the actual total, 100 being a perfect total. An item is flagged as low when its POA is more than') . ' ' . FORECAST_ACCURACY_TOLERANCE . ' ' . __('points away from 100 or there were no sales. The forecast used is the revised quantity when there is one.') . '</div>';
+		}
+	}
+}
+
+include('includes/footer.php');

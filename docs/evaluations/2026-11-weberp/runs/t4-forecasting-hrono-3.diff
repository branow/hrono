+++ b/ForecastSummary.php
@@ -0,0 +1,239 @@
+<?php
+
+// Summary forecasts: aggregated forecasts by stock category, customer type, sales area or salesperson, built from the
+// same sales history as the item forecasts, with a review of the detail behind each summary
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Summary Forecasts');
+$ViewTopic = 'MRP';
+$BookMark = '';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Methods = ForecastMethods();
+$Dimensions = ForecastDimensions();
+$Defaults = ForecastGetDefaults();
+$Self = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$Bounds = ForecastHistoryBounds();
+
+if ($Bounds === null) {
+	prnMsg(__('There is no sales history to forecast from. Extract the sales history first.'), 'error');
+	echo '<div class="centre"><a href="' . $RootPath . '/ForecastSalesHistory.php">' . __('Extract Sales History') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+$SummaryID = (int) ($_GET['SummaryID'] ?? 0);
+
+if ($SummaryID > 0) {
+	// review of one summary forecast
+	$Result = DB_query("SELECT * FROM forecastsummaries WHERE summaryid = " . $SummaryID);
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('The summary forecast does not exist'), 'error');
+	} else {
+		$Summary = DB_fetch_array($Result);
+		$Values = ForecastSummaryValues($Summary['dimension']);
+		$Params = json_decode($Summary['parameters'], true) ?: array();
+		echo '<table class="selection">
+				<tr><td>' . $Dimensions[$Summary['dimension']] . '</td><td>' . $Summary['dimensionvalue'] . ' - ' . ($Values[$Summary['dimensionvalue']] ?? '') . '</td></tr>
+				<tr><td>' . __('Method') . '</td><td>' . $Summary['methodid'] . ' - ' . $Methods[$Summary['methodid']]['name'] . (($Params['selection'] ?? '') == 'bestfit' ? ' (' . __('best fit') . ')' : '') . '</td></tr>
+				<tr><td>' . __('Parameters') . '</td><td>' . ForecastMethodDescriptionOfParams($Summary['methodid'], $Params + ForecastBaseParams()) . '</td></tr>
+				<tr><td>' . __('Based on history') . '</td><td>' . ForecastMonthLabel($Summary['historyfrom']) . ' - ' . ForecastMonthLabel($Summary['historyto']) . '</td></tr>
+				<tr><td>' . __('Generated') . '</td><td>' . $Summary['generatedon'] . ' ' . $Summary['generatedby'] . '</td></tr>
+				<tr><td>' . __('Status') . '</td><td>' . ($Summary['activeslot'] == 1 ? __('Active') : __('Superseded')) . '</td></tr>
+			</table>';
+
+		$Filter = ForecastSummaryFilter($Summary['dimension'], $Summary['dimensionvalue']);
+
+		// the summary periods; for a category also what the active item forecasts add up to
+		$ItemTotals = array();
+		if ($Summary['dimension'] == 'category') {
+			$Result = DB_query("SELECT forecastdetails.periodmonth, SUM(" . FORECAST_EFFECTIVE_QTY . ") AS qty
+								FROM forecasts
+								INNER JOIN forecastdetails ON forecastdetails.forecastid = forecasts.forecastid
+								INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+								WHERE forecasts.activeslot = 1
+									AND forecasts.loccode = ''
+									AND stockmaster.categoryid = '" . $Summary['dimensionvalue'] . "'
+								GROUP BY forecastdetails.periodmonth");
+			while ($MyRow = DB_fetch_array($Result)) {
+				$ItemTotals[$MyRow['periodmonth']] = $MyRow['qty'];
+			}
+		}
+		echo '<table class="selection">
+				<tr>
+					<th>' . __('Period') . '</th>
+					<th>' . __('Summary forecast') . '</th>' .
+					($Summary['dimension'] == 'category' ? '<th>' . __('Active item forecasts added up') . '</th>' : '') . '
+				</tr>';
+		$Result = DB_query("SELECT periodmonth, calcqty FROM forecastsummarydetails WHERE summaryid = " . $SummaryID . " ORDER BY periodmonth");
+		while ($MyRow = DB_fetch_array($Result)) {
+			echo '<tr class="striped_row">
+					<td>' . ForecastMonthLabel($MyRow['periodmonth']) . '</td>
+					<td class="number">' . locale_number_format($MyRow['calcqty'], 2) . '</td>' .
+					($Summary['dimension'] == 'category' ? '<td class="number">' . (isset($ItemTotals[$MyRow['periodmonth']]) ? locale_number_format($ItemTotals[$MyRow['periodmonth']], 2) : '') . '</td>' : '') . '
+				</tr>';
+		}
+		echo '</table>';
+
+		// the history behind the summary: the last 24 months
+		$From = ForecastAddMonths($Summary['historyto'], -23);
+		if ($From < $Bounds['blockstart']) {
+			$From = $Bounds['blockstart'];
+		}
+		$Result = DB_query("SELECT h.periodmonth, SUM(h.quantity) AS qty
+							FROM forecastsaleshistory h " . $Filter['join'] . "
+							WHERE " . $Filter['where'] . "
+								AND h.periodmonth BETWEEN '" . $From . "' AND '" . $Summary['historyto'] . "'
+							GROUP BY h.periodmonth
+							ORDER BY h.periodmonth");
+		echo '<table class="selection">
+				<tr><th colspan="2">' . __('Sales history behind the summary') . '</th></tr>
+				<tr><th>' . __('Period') . '</th><th>' . __('Quantity') . '</th></tr>';
+		while ($MyRow = DB_fetch_array($Result)) {
+			echo '<tr class="striped_row"><td>' . ForecastMonthLabel($MyRow['periodmonth']) . '</td><td class="number">' . locale_number_format($MyRow['qty'], 2) . '</td></tr>';
+		}
+		echo '</table>';
+
+		// and the items it is made of: the last 12 months of the history
+		$Last12 = ForecastAddMonths($Summary['historyto'], -11);
+		$Result = DB_query("SELECT h.stockid,
+								stockmaster.description,
+								SUM(h.quantity) AS qty
+							FROM forecastsaleshistory h
+							INNER JOIN stockmaster ON stockmaster.stockid = h.stockid
+							WHERE " . $Filter['where'] . "
+								AND h.periodmonth BETWEEN '" . $Last12 . "' AND '" . $Summary['historyto'] . "'
+							GROUP BY h.stockid, stockmaster.description
+							ORDER BY qty DESC
+							LIMIT 50");
+		$Rows = array();
+		$Total = 0;
+		while ($MyRow = DB_fetch_array($Result)) {
+			$Rows[] = $MyRow;
+			$Total += $MyRow['qty'];
+		}
+		echo '<table class="selection">
+				<tr><th colspan="4">' . __('Items behind the summary, last 12 months of history (largest 50)') . '</th></tr>
+				<tr><th>' . __('Item') . '</th><th>' . __('Description') . '</th><th>' . __('Quantity') . '</th><th>%</th></tr>';
+		foreach ($Rows as $MyRow) {
+			echo '<tr class="striped_row">
+					<td>' . $MyRow['stockid'] . '</td>
+					<td>' . $MyRow['description'] . '</td>
+					<td class="number">' . locale_number_format($MyRow['qty'], 2) . '</td>
+					<td class="number">' . ($Total > 0 ? locale_number_format(100 * $MyRow['qty'] / $Total, 1) : '') . '</td>
+				</tr>';
+		}
+		echo '</table>';
+	}
+	echo '<div class="centre"><a href="' . $Self . '">' . __('Summary Forecasts') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+if (isset($_POST['Generate'])) {
+	$Errors = array();
+	$Params = ForecastParamsFromPost($Errors);
+	$Dimension = $_POST['Dimension'] ?? '';
+	$MethodChoice = $_POST['Method'] ?? '0';
+	$Horizon = $_POST['Horizon'] ?? '';
+	$Holdout = $_POST['Holdout'] ?? '';
+	if (!isset($Dimensions[$Dimension])) {
+		$Errors[] = __('Select what the summary forecasts are for');
+	}
+	if (!ctype_digit((string) $Horizon) or $Horizon < 1 or $Horizon > 24) {
+		$Errors[] = __('The horizon must be between 1 and 24 monthly periods');
+	}
+	if (!ctype_digit((string) $Holdout) or $Holdout < 1 or $Holdout > 12) {
+		$Errors[] = __('The number of hold-out months must be between 1 and 12');
+	}
+	if ($MethodChoice != '0' and !isset($Methods[$MethodChoice])) {
+		$Errors[] = __('Select a method');
+	}
+	foreach ($Errors as $Error) {
+		prnMsg($Error, 'error');
+	}
+	if (count($Errors) == 0) {
+		$Values = ForecastSummaryValues($Dimension);
+		if (($_POST['Value'] ?? '') != '') {
+			$Values = array_intersect_key($Values, array($_POST['Value'] => true));
+		}
+		$Successful = $Failed = 0;
+		$Rows = '';
+		foreach ($Values as $Value => $Description) {
+			$Outcome = ForecastGenerateSummary($Dimension, (string) $Value, (int) $MethodChoice, (int) $Horizon, $Params, (int) $Holdout);
+			if ($Outcome['ok']) {
+				$Successful++;
+			} else {
+				$Failed++;
+			}
+			$Rows .= '<tr class="striped_row">
+					<td>' . $Value . '</td>
+					<td>' . $Description . '</td>
+					<td>' . ($Outcome['ok'] ? __('Successful') : __('Failed')) . '</td>
+					<td>' . ($Outcome['ok'] ? $Outcome['method'] . ' - ' . $Methods[$Outcome['method']]['name'] : '') . '</td>
+					<td>' . $Outcome['reason'] . '</td>
+				</tr>';
+		}
+		prnMsg($Successful . ' ' . __('successful') . ', ' . $Failed . ' ' . __('failed'), $Failed == 0 ? 'success' : ($Successful == 0 ? 'error' : 'warn'));
+		echo '<table class="selection">
+				<tr><th>' . $Dimensions[$Dimension] . '</th><th>' . __('Description') . '</th><th>' . __('Result') . '</th><th>' . __('Method') . '</th><th>' . __('Reason') . '</th></tr>' . $Rows . '</table>';
+	}
+}
+
+// the active summary forecasts
+$Result = DB_query("SELECT summaryid, dimension, dimensionvalue, methodid, historyto, generatedon FROM forecastsummaries WHERE activeslot = 1 ORDER BY dimension, dimensionvalue");
+if (DB_num_rows($Result) > 0) {
+	echo '<table class="selection">
+			<tr><th colspan="5">' . __('Active summary forecasts') . '</th></tr>
+			<tr><th>' . __('Summary by') . '</th><th>' . __('Value') . '</th><th>' . __('Method') . '</th><th>' . __('History to') . '</th><th>' . __('Generated') . '</th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . ($Dimensions[$MyRow['dimension']] ?? $MyRow['dimension']) . '</td>
+				<td><a href="' . $Self . '?SummaryID=' . $MyRow['summaryid'] . '">' . $MyRow['dimensionvalue'] . '</a></td>
+				<td>' . $MyRow['methodid'] . ' - ' . $Methods[$MyRow['methodid']]['name'] . '</td>
+				<td>' . ForecastMonthLabel($MyRow['historyto']) . '</td>
+				<td>' . $MyRow['generatedon'] . '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+$Params = ForecastBaseParams();
+$DimensionOptions = '';
+foreach ($Dimensions as $Key => $Name) {
+	$DimensionOptions .= '<option value="' . $Key . '"' . (($_POST['Dimension'] ?? '') == $Key ? ' selected="selected"' : '') . '>' . $Name . '</option>';
+}
+echo '<form method="post" action="' . $Self . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Generate Summary Forecasts') . '</legend>
+		<field>
+			<label for="Dimension">' . __('Summarise by') . ':</label>
+			<select name="Dimension">' . $DimensionOptions . '</select>
+		</field>
+		<field>
+			<label for="Value">' . __('Only this code (leave empty for every one with sales)') . ':</label>
+			<input type="text" name="Value" size="10" maxlength="10" value="' . ($_POST['Value'] ?? '') . '" />
+		</field>
+		<field>
+			<label for="Method">' . __('Method') . ':</label>
+			<select name="Method">' . ForecastMethodOptions($_POST['Method'] ?? '0', __('Best fit')) . '</select>
+		</field>
+		<field>
+			<label for="Horizon">' . __('Number of monthly periods to forecast') . ':</label>
+			<input type="text" class="number" name="Horizon" size="4" value="' . ($_POST['Horizon'] ?? $Defaults['horizon']) . '" />
+		</field>
+		<field>
+			<label for="Holdout">' . __('Months held out to find the best fit') . ':</label>
+			<input type="text" class="number" name="Holdout" size="4" value="' . ($_POST['Holdout'] ?? $Defaults['holdout']) . '" />
+		</field>' .
+		ForecastParameterFields($Params) . '
+	</fieldset>
+	<div class="centre"><input type="submit" name="Generate" value="' . __('Generate Summary Forecasts') . '" /></div>
+</form>';
+
+include('includes/footer.php');
diff --git a/ForecastToMRP.php b/ForecastToMRP.php
new file mode 100644
index 0000000..d6fff8a
--- /dev/null
+++ b/ForecastToMRP.php
@@ -0,0 +1,100 @@
+<?php
+
+// Convert the active forecasts (revised quantity first) into MRP demands of the forecast demand type
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Convert Forecasts to MRP Demands');
+$ViewTopic = 'MRP';
+$BookMark = '';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Self = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+
+$Result = DB_query("SELECT mrpdemandtype FROM mrpdemandtypes WHERE mrpdemandtype='" . FORECAST_MRP_DEMAND_TYPE . "'");
+if (DB_num_rows($Result) == 0) {
+	// keep the demand type available if somebody deleted it
+	DB_query("INSERT INTO mrpdemandtypes (mrpdemandtype, description) VALUES ('" . FORECAST_MRP_DEMAND_TYPE . "', '" . __('Demand Forecast') . "')");
+}
+
+if (isset($_POST['Convert'])) {
+	$InputError = 0;
+	if (!ForecastIsMonth($_POST['FromMonth'] ?? '') or !ForecastIsMonth($_POST['ToMonth'] ?? '')) {
+		prnMsg(__('The first and last month of the horizon must both be entered as a month and year'), 'error');
+		$InputError = 1;
+	} else {
+		$FromMonth = $_POST['FromMonth'] . '-01';
+		$ToMonth = $_POST['ToMonth'] . '-01';
+		if ($FromMonth > $ToMonth) {
+			prnMsg(__('The first month must not be after the last month'), 'error');
+			$InputError = 1;
+		} elseif (ForecastMonthDiff($FromMonth, $ToMonth) > 35) {
+			prnMsg(__('The horizon cannot be longer than 36 months'), 'error');
+			$InputError = 1;
+		}
+	}
+	$Mode = ($_POST['Mode'] ?? '') == 'incremental' ? 'incremental' : 'replace';
+	$StockID = trim(mb_strtoupper($_POST['StockID'] ?? ''));
+	if ($StockID != '') {
+		$Result = DB_query("SELECT stockid FROM stockmaster WHERE stockid='" . $StockID . "'");
+		if (DB_num_rows($Result) == 0) {
+			prnMsg(__('The item does not exist'), 'error');
+			$InputError = 1;
+		}
+	}
+	if ($InputError == 0) {
+		$Summary = ForecastConvertToMRP($FromMonth, $ToMonth, $Mode, $_POST['CategoryID'] ?? '', $StockID);
+		if ($Summary['items'] == 0) {
+			prnMsg(__('There are no active forecasts with periods in the horizon, so no MRP demands have been written'), 'warn');
+		} else {
+			prnMsg(__('MRP demands have been written for') . ' ' . $Summary['items'] . ' ' . __('items') . ': ' . $Summary['created'] . ' ' . __('created') . ', ' . $Summary['removed'] . ' ' . __('replaced') . ', ' . $Summary['skipped'] . ' ' . __('periods already present'), 'success');
+			echo '<div class="centre"><a href="' . $RootPath . '/MRPDemands.php?listall=true">' . __('List all MRP demands') . '</a></div>';
+		}
+	}
+}
+
+$FromDefault = $_POST['FromMonth'] ?? date('Y-m');
+$ToDefault = $_POST['ToMonth'] ?? substr(ForecastAddMonths(date('Y-m-01'), 5), 0, 7);
+$Mode = $_POST['Mode'] ?? 'replace';
+echo '<form method="post" action="' . $Self . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Convert Active Forecasts') . '</legend>
+		<field>
+			<label for="FromMonth">' . __('First month of the horizon') . ':</label>
+			<input type="month" name="FromMonth" required="required" value="' . $FromDefault . '" />
+		</field>
+		<field>
+			<label for="ToMonth">' . __('Last month of the horizon') . ':</label>
+			<input type="month" name="ToMonth" required="required" value="' . $ToDefault . '" />
+		</field>
+		<field>
+			<label for="Mode">' . __('Mode') . ':</label>
+			<select name="Mode">
+				<option value="replace"' . ($Mode == 'replace' ? ' selected="selected"' : '') . '>' . __('Replace the forecast demands of the same items and horizon') . '</option>
+				<option value="incremental"' . ($Mode == 'incremental' ? ' selected="selected"' : '') . '>' . __('Incremental: add only the periods not yet present') . '</option>
+			</select>
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Only this stock category') . ':</label>
+			<select name="CategoryID">' . ForecastCategoryOptions($_POST['CategoryID'] ?? '', __('All categories')) . '</select>
+		</field>
+		<field>
+			<label for="StockID">' . __('Only this item') . ':</label>
+			<input type="text" name="StockID" size="21" maxlength="64" value="' . ($_POST['StockID'] ?? '') . '" />
+		</field>
+	</fieldset>
+	<div class="page_help_text">' . __('The revised quantity of a period is used when there is one, else the calculated quantity. Each period becomes one MRP demand of type') . ' ' . FORECAST_MRP_DEMAND_TYPE . ' ' . __('due on the first day of the month. Demands entered by hand or created by other functions are never changed, and converting the same horizon again does not double the demand. Run the MRP calculation with the master schedule demands included to plan purchases and work orders from them.') . '</div>
+	<div class="centre"><input type="submit" name="Convert" value="' . __('Convert to MRP Demands') . '" /></div>
+</form>';
+
+echo '<div class="centre">
+		<a href="' . $RootPath . '/MRPDemands.php">' . __('Master Schedule') . '</a> |
+		<a href="' . $RootPath . '/MRP.php">' . __('MRP Calculation') . '</a> |

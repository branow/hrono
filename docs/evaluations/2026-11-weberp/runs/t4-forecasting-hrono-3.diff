+<?php
+
+// Inquiry: view forecasts by item, category, location and period
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Inquiry');
+$ViewTopic = 'MRP';
+$BookMark = '';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Methods = ForecastMethods();
+$StockCode = trim(mb_strtoupper($_POST['StockCode'] ?? ''));
+$CategoryID = $_POST['CategoryID'] ?? '';
+$Location = $_POST['Location'] ?? '*';
+$FromMonth = $_POST['FromMonth'] ?? '';
+$ToMonth = $_POST['ToMonth'] ?? '';
+$Status = $_POST['Status'] ?? 'active';
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Select Forecasts') . '</legend>
+		<field>
+			<label for="StockCode">' . __('Part of the item code or description') . ':</label>
+			<input type="text" name="StockCode" size="21" value="' . $StockCode . '" />
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category') . ':</label>
+			<select name="CategoryID">' . ForecastCategoryOptions($CategoryID, __('Any category')) . '</select>
+		</field>
+		<field>
+			<label for="Location">' . __('Location') . ':</label>
+			<select name="Location"><option value="*"' . ($Location == '*' ? ' selected="selected"' : '') . '>' . __('Any location') . '</option>' . ForecastLocationOptions($Location == '*' ? 'none' : $Location) . '</select>
+		</field>
+		<field>
+			<label for="FromMonth">' . __('From period') . ':</label>
+			<input type="month" name="FromMonth" value="' . $FromMonth . '" />
+		</field>
+		<field>
+			<label for="ToMonth">' . __('To period') . ':</label>
+			<input type="month" name="ToMonth" value="' . $ToMonth . '" />
+		</field>
+		<field>
+			<label for="Status">' . __('Forecasts') . ':</label>
+			<select name="Status">
+				<option value="active"' . ($Status == 'active' ? ' selected="selected"' : '') . '>' . __('Active only') . '</option>
+				<option value="all"' . ($Status == 'all' ? ' selected="selected"' : '') . '>' . __('Active and superseded') . '</option>
+			</select>
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Search" value="' . __('Show Forecasts') . '" /></div>
+</form>';
+
+if (isset($_POST['Search'])) {
+	$SQL = "SELECT forecasts.forecastid,
+					forecasts.stockid,
+					forecasts.loccode,
+					forecasts.methodid,
+					forecasts.activeslot,
+					forecastdetails.periodmonth,
+					forecastdetails.calcqty,
+					forecastdetails.revisedqty,
+					stockmaster.description
+			FROM forecasts
+			INNER JOIN forecastdetails ON forecastdetails.forecastid = forecasts.forecastid
+			INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+			WHERE 1 = 1";
+	if ($Status == 'active') {
+		$SQL .= " AND forecasts.activeslot = 1";
+	}
+	if ($StockCode != '') {
+		$SQL .= " AND (forecasts.stockid LIKE '%" . $StockCode . "%' OR stockmaster.description LIKE '%" . $StockCode . "%')";
+	}
+	if ($CategoryID != '') {
+		$SQL .= " AND stockmaster.categoryid='" . $CategoryID . "'";
+	}
+	if ($Location != '*') {
+		$SQL .= " AND forecasts.loccode='" . $Location . "'";
+	}
+	if (ForecastIsMonth($FromMonth)) {
+		$SQL .= " AND forecastdetails.periodmonth >= '" . $FromMonth . "-01'";
+	}
+	if (ForecastIsMonth($ToMonth)) {
+		$SQL .= " AND forecastdetails.periodmonth <= '" . $ToMonth . "-01'";
+	}
+	$SQL .= " ORDER BY forecasts.stockid, forecasts.loccode, forecasts.forecastid DESC, forecastdetails.periodmonth LIMIT 1000";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('No forecasts were found'), 'info');
+	} else {
+		echo '<table class="selection">
+				<tr>
+					<th>' . __('Item') . '</th>
+					<th>' . __('Description') . '</th>
+					<th>' . __('Location') . '</th>
+					<th>' . __('Period') . '</th>
+					<th>' . __('Calculated') . '</th>
+					<th>' . __('Revised') . '</th>
+					<th>' . __('Forecast used') . '</th>
+					<th>' . __('Method') . '</th>
+					<th>' . __('Status') . '</th>
+				</tr>';
+		while ($MyRow = DB_fetch_array($Result)) {
+			echo '<tr class="striped_row">
+					<td><a href="' . $RootPath . '/ForecastReview.php?ForecastID=' . $MyRow['forecastid'] . '">' . $MyRow['stockid'] . '</a></td>
+					<td>' . $MyRow['description'] . '</td>
+					<td>' . ForecastLocationName($MyRow['loccode']) . '</td>
+					<td>' . ForecastMonthLabel($MyRow['periodmonth']) . '</td>
+					<td class="number">' . locale_number_format($MyRow['calcqty'], 2) . '</td>
+					<td class="number">' . ($MyRow['revisedqty'] === null ? '' : locale_number_format($MyRow['revisedqty'], 2)) . '</td>
+					<td class="number">' . locale_number_format($MyRow['revisedqty'] === null ? $MyRow['calcqty'] : $MyRow['revisedqty'], 2) . '</td>
+					<td>' . $MyRow['methodid'] . ' - ' . $Methods[$MyRow['methodid']]['name'] . '</td>
+					<td>' . ($MyRow['activeslot'] == 1 ? __('Active') : __('Superseded')) . '</td>
+				</tr>';
+		}
+		echo '</table>';
+	}
+}
+
+include('includes/footer.php');
diff --git a/ForecastMethodComparison.php b/ForecastMethodComparison.php
new file mode 100644
index 0000000..e6237c1
--- /dev/null
+++ b/ForecastMethodComparison.php
@@ -0,0 +1,125 @@
+<?php
+
+// Forecast the recent history of one item with several methods side by side with their accuracy
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Method Comparison');
+$ViewTopic = 'MRP';
+$BookMark = '';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Methods = ForecastMethods();
+$Defaults = ForecastGetDefaults();
+$Bounds = ForecastHistoryBounds();
+
+if (isset($_POST['Compare'])) {
+	$Errors = array();
+	$Params = ForecastParamsFromPost($Errors);
+	$StockID = trim(mb_strtoupper($_POST['StockID'] ?? ''));
+	$LocCode = $_POST['Location'] ?? '';
+	$Holdout = $_POST['Holdout'] ?? '';
+	$Result = DB_query("SELECT stockid, description FROM stockmaster WHERE stockid='" . $StockID . "'");
+	if ($StockID == '' or DB_num_rows($Result) == 0) {
+		$Errors[] = __('Enter the code of an existing item');
+	} else {
+		$Item = DB_fetch_array($Result);
+	}
+	if (!ctype_digit((string) $Holdout) or $Holdout < 1 or $Holdout > 12) {
+		$Errors[] = __('The number of hold-out months must be between 1 and 12');
+	}
+	if ($Bounds === null) {
+		$Errors[] = __('There is no sales history. Extract the sales history first.');
+	}
+	foreach ($Errors as $Error) {
+		prnMsg($Error, 'error');
+	}
+	if (count($Errors) == 0) {
+		$Series = ForecastItemSeries($StockID, $LocCode);
+		$Values = $Series['values'];
+		$n = count($Values);
+		$Holdout = (int) $Holdout;
+		if ($n <= $Holdout) {
+			prnMsg(__('The item has only') . ' ' . $n . ' ' . __('months of history, not enough to compare methods on the last') . ' ' . $Holdout . ' ' . __('months'), 'error');
+		} else {
+			$Train = array_slice($Values, 0, $n - $Holdout);
+			$Actual = array_slice($Values, $n - $Holdout);
+			$FirstHeld = ForecastAddMonths($Series['last'], -($Holdout - 1));
+
+			$Outcomes = array();
+			foreach ($Methods as $MethodID => $Method) {
+				$Forecast = ForecastCompute($MethodID, $Train, $Holdout, $Params);
+				if (isset($Forecast['error'])) {
+					$Outcomes[$MethodID] = array('error' => $Forecast['error']);
+				} else {
+					$Outcomes[$MethodID] = array('values' => $Forecast['values'], 'metrics' => ForecastMetrics($Actual, $Forecast['values']));
+				}
+			}
+			$Best = null;
+			foreach ($Outcomes as $MethodID => $Outcome) {
+				if (isset($Outcome['metrics']) and ($Best === null or $Outcome['metrics']['mad'] < $Outcomes[$Best]['metrics']['mad'])) {
+					$Best = $MethodID;
+				}
+			}
+
+			echo '<div class="page_help_text">' . $Item['stockid'] . ' - ' . $Item['description'] . ', ' . ForecastLocationName($LocCode) . '. ' . __('History') . ': ' . ForecastMonthLabel($Series['first']) . ' - ' . ForecastMonthLabel($Series['last']) . ' (' . $n . ' ' . __('months') . '). ' . __('Each method forecast the last') . ' ' . $Holdout . ' ' . __('months from the history before them.') . '</div>';
+			echo '<table class="selection">
+					<tr><th>' . __('Method') . '</th>';
+			echo '<th>' . __('Used') . '</th>';
+			for ($i = 0; $i < $Holdout; $i++) {
+				echo '<th>' . ForecastMonthLabel(ForecastAddMonths($FirstHeld, $i)) . '</th>';
+			}
+			echo '<th>MAD</th><th>POA %</th><th>MSE</th><th>RMSE</th></tr>';
+			echo '<tr class="bold"><td>' . __('Actual sales') . '</td><td></td>';
+			foreach ($Actual as $Quantity) {
+				echo '<td class="number">' . locale_number_format($Quantity, 2) . '</td>';
+			}
+			echo '<td colspan="4"></td></tr>';
+			foreach ($Outcomes as $MethodID => $Outcome) {
+				echo '<tr class="striped_row' . ($MethodID === $Best ? ' bold' : '') . '"><td>' . $MethodID . ' - ' . $Methods[$MethodID]['name'] . ($MethodID === $Best ? ' (' . __('best fit') . ')' : '') . '</td>';
+				echo '<td>' . ForecastMethodDescriptionOfParams($MethodID, $Params) . '</td>';
+				if (isset($Outcome['error'])) {
+					echo '<td colspan="' . ($Holdout + 4) . '">' . $Outcome['error'] . '</td></tr>';
+					continue;
+				}
+				foreach ($Outcome['values'] as $Quantity) {
+					echo '<td class="number">' . locale_number_format($Quantity, 2) . '</td>';
+				}
+				$Metrics = $Outcome['metrics'];
+				echo '<td class="number">' . locale_number_format($Metrics['mad'], 2) . '</td>
+					<td class="number">' . ($Metrics['poa'] === null ? '' : locale_number_format($Metrics['poa'], 1)) . '</td>
+					<td class="number">' . locale_number_format($Metrics['mse'], 2) . '</td>
+					<td class="number">' . locale_number_format($Metrics['rmse'], 2) . '</td>
+				</tr>';
+			}
+			echo '</table>';
+		}
+	}
+}
+
+$Params = ForecastBaseParams();
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Compare Methods') . '</legend>
+		<field>
+			<label for="StockID">' . __('Item code') . ':</label>
+			<input type="text" name="StockID" size="21" maxlength="64" required="required" value="' . ($_POST['StockID'] ?? '') . '" />
+		</field>
+		<field>
+			<label for="Location">' . __('Location') . ':</label>
+			<select name="Location">' . ForecastLocationOptions($_POST['Location'] ?? '') . '</select>
+		</field>
+		<field>
+			<label for="Holdout">' . __('Months held out') . ':</label>
+			<input type="text" class="number" name="Holdout" size="4" value="' . ($_POST['Holdout'] ?? $Defaults['holdout']) . '" />
+		</field>' .
+		ForecastParameterFields($Params) . '
+	</fieldset>
+	<div class="centre"><input type="submit" name="Compare" value="' . __('Compare Methods') . '" /></div>
+</form>';
+
+include('includes/footer.php');
diff --git a/ForecastParameters.php b/ForecastParameters.php
new file mode 100644
index 0000000..aa024cb

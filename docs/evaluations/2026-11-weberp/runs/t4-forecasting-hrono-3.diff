+<?php
+
+// DEMAND FORECASTING MODULE
+//
+// 1. tables
+CreateTable('forecastsaleshistory', "CREATE TABLE `forecastsaleshistory` (
+  `stockid` varchar(64) NOT NULL DEFAULT '',
+  `loccode` varchar(5) NOT NULL DEFAULT '',
+  `debtortype` smallint NOT NULL DEFAULT '0',
+  `area` char(3) NOT NULL DEFAULT '',
+  `salesman` varchar(4) NOT NULL DEFAULT '',
+  `periodmonth` date NOT NULL DEFAULT '1000-01-01',
+  `quantity` double NOT NULL DEFAULT '0',
+  PRIMARY KEY (`stockid`,`loccode`,`debtortype`,`area`,`salesman`,`periodmonth`),
+  KEY `periodmonth` (`periodmonth`),
+  KEY `loccode` (`loccode`),
+  KEY `debtortype` (`debtortype`),
+  KEY `area` (`area`),
+  KEY `salesman` (`salesman`)
+)");
+
+// one row per month that has been extracted, also for months without any sale, so that the end of the history
+// held is known
+CreateTable('forecasthistorymonths', "CREATE TABLE `forecasthistorymonths` (
+  `periodmonth` date NOT NULL DEFAULT '1000-01-01',
+  `extractedon` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  `extractedby` varchar(20) NOT NULL DEFAULT '',
+  PRIMARY KEY (`periodmonth`)
+)");
+
+CreateTable('forecasts',"CREATE TABLE `forecasts` (
+  `forecastid` int NOT NULL AUTO_INCREMENT,

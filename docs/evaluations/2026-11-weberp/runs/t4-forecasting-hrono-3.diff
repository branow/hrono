+
+// 4. the Forecasting module
+//
+// www_users.modulesallowed is a positional list: entry n is the user's access to the n-th module in the
+// `modules.sequence` order of the user's security role. Forecasting goes in right after Manufacturing, which
+// moves General Ledger, Asset Manager, Petty Cash, Setup and Utilities one place down. So that every existing user
+// keeps exactly the modules they have today, an entry denying Forecasting is inserted at the same position in
+// each user's list. Which users get the module is then the administrator's choice (WWW_Users.php).
+// This only runs while the module is not yet there, so that running the update again does not shift the lists twice.
+ChangeColumnSize('modulesallowed', 'www_users', 'VARCHAR(50)', ' NOT NULL ', '', '50');
+
+$Result = DB_query("SELECT modulelink FROM modules WHERE modulelink='forecast'");
+if (DB_num_rows($Result) == 0) {
+	$RoleModules = array();
+	$Result = DB_query("SELECT secroleid, sequence FROM modules ORDER BY secroleid, sequence");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$RoleModules[$MyRow['secroleid']][] = $MyRow['sequence'];
+	}
+
+	$ModuleSequence = 7;
+	$UsersResult = DB_query("SELECT userid, fullaccess, modulesallowed FROM www_users");
+	$UserErrors = 0;
+	DB_Txn_Begin();
+	while ($UserRow = DB_fetch_array($UsersResult)) {
+		if (!isset($RoleModules[$UserRow['fullaccess']])) {
+			continue;
+		}
+		$ModuleCount = count($RoleModules[$UserRow['fullaccess']]);
+		$InsertAt = 0;
+		foreach ($RoleModules[$UserRow['fullaccess']] as $Sequence) {
+			if ($Sequence < $ModuleSequence) {
+				$InsertAt++;
+			}
+		}
+		$Allowed = array();
+		if ($UserRow['modulesallowed'] != '') {
+			foreach (explode(',', rtrim($UserRow['modulesallowed'], ',')) as $Entry) {
+				$Allowed[] = (trim($Entry) == '1') ? '1' : '0';
+			}
+		}
+		$Allowed = array_slice(array_pad($Allowed, $ModuleCount, '0'), 0, $ModuleCount);
+		array_splice($Allowed, $InsertAt, 0, '0');
+		$SQL = "UPDATE www_users SET modulesallowed='" . implode(',', $Allowed) . ",'
+				WHERE userid='" . DB_escape_string($UserRow['userid']) . "'";
+		DB_query($SQL, '', '', false, false);
+		if (DB_error_no() != 0) {
+			$UserErrors++;
+		}
+	}
+	if ($UserErrors == 0) {
+		DB_Txn_Commit();
+		OutputResult(__('The module access of the existing users has been updated for the new Forecasting module'), 'success');
+		NewModule('forecast', 'fcst', __('Forecasting'), $ModuleSequence);
+	} else {
+		DB_Txn_Rollback();
+		OutputResult(__('The module access of the existing users could not be updated, the Forecasting module has not been created'), 'error');
+	}
+} else {
+	OutputResult(__('The module') . ' ' . __('Forecasting') . ' ' . __('already exists'), 'info');
+}

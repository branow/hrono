diff --git a/BadDebtWriteOff.php b/BadDebtWriteOff.php
new file mode 100644
index 0000000..df4331a
--- /dev/null
+++ b/BadDebtWriteOff.php
@@ -0,0 +1,192 @@
+<?php
+
+/* Writing off all or part of a customer's unpaid balance as a bad debt. A write-off up to the approval limit set by Finance is posted at once.
+A larger one waits as Pending until the Finance Director (token 22) approves it, and does nothing to the account until then. A posted
+write-off credits the customer account, debits the bad debt account and allocates itself to the oldest unpaid invoices. Unless credit control
+decides otherwise the customer is put on stop. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Bad Debt Write-off');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'BadDebtWriteOff';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$BadDebtAct = isset($_SESSION['BadDebtAct']) ? $_SESSION['BadDebtAct'] : '';
+$ApprovalLimit = isset($_SESSION['WriteOffApprovalLimit']) ? $_SESSION['WriteOffApprovalLimit'] : 1000;
+$IsApprover = CreditUserCan(CREDIT_APPROVAL_TOKEN);
+$HomeDecimals = $_SESSION['CompanyRecord']['decimalplaces'];
+
+/* Posts a write-off and puts the customer on stop if asked. Returns true if posted */
+function BadDebtPost($WriteOffID, $DebtorNo, $Amount, $Reason, $BadDebtAct, $StopCustomer, $DecidedBy) {
+	if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1 and $BadDebtAct == '') {
+		prnMsg(__('Choose the bad debt account in Credit Control Settings before writing off'), 'error');
+		return false;
+	}
+	if (CreditWriteOffableBalance($DebtorNo) + 0.00001 < $Amount) {
+		prnMsg(__('The unpaid balance of the customer is now less than the amount to write off'), 'error');
+		return false;
+	}
+	DB_Txn_Begin();
+	$Posted = CreditPostWriteOff($DebtorNo, $Amount, $Reason, $BadDebtAct);
+	DB_query("UPDATE writeoffs
+				SET status = 'Posted',
+					decidedby = '" . $DecidedBy . "',
+					decidedate = NOW(),
+					transno = '" . $Posted['transno'] . "'
+				WHERE id = '" . $WriteOffID . "'", '', '', true);
+	$Result = DB_query("SELECT currcode FROM debtorsmaster WHERE debtorno = '" . DB_escape_string($DebtorNo) . "'");
+	$MyRow = DB_fetch_row($Result);
+	CreditLogEvent($DebtorNo, 'writeoff', $Reason, '', __('Write-off number') . ' ' . $Posted['transno'], $Amount, $MyRow[0]);
+	if ($StopCustomer) {
+		$StopCode = CreditFirstReasonOfType(1);
+		if ($StopCode !== false) {
+			CreditSetStatus($DebtorNo, $StopCode, __('Put on stop after a bad debt write-off') . ': ' . $Reason);
+		}
+	}
+	EnsureGLEntriesBalance(CREDIT_TYPE_WRITEOFF, $Posted['transno']);
+	DB_Txn_Commit();
+	return true;
+}
+
+/* The Finance Director decides a pending write-off */
+if ($IsApprover and (isset($_POST['Approve']) or isset($_POST['Reject'])) and isset($_POST['WriteOffID'])) {
+	$WriteOffID = (int) $_POST['WriteOffID'];
+	$Result = DB_query("SELECT * FROM writeoffs WHERE id = '" . $WriteOffID . "' AND status = 'Pending'");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('This write-off is not waiting for approval'), 'warn');
+	} else {
+		$WriteOff = DB_fetch_array($Result);
+		if (isset($_POST['Reject'])) {
+			DB_query("UPDATE writeoffs SET status = 'Rejected', decidedby = '" . $_SESSION['UserID'] . "', decidedate = NOW() WHERE id = '" . $WriteOffID . "'");
+			CreditLogEvent($WriteOff['debtorno'], 'writeoff', __('Write-off rejected by the Finance Director') . ': ' . $WriteOff['reason'], '', __('Rejected'), $WriteOff['amount'], $WriteOff['currcode']);
+			prnMsg(__('The write-off has been rejected'), 'success');
+		} elseif (BadDebtPost($WriteOffID, $WriteOff['debtorno'], $WriteOff['amount'], $WriteOff['reason'], $BadDebtAct, $WriteOff['stoponwriteoff'], $_SESSION['UserID'])) {
+			prnMsg(__('The write-off has been approved and posted'), 'success');
+		}
+	}
+}
+
+/* A new write-off */
+if (isset($_POST['WriteOff'])) {
+	$InputError = 0;
+	$DebtorNo = $_POST['DebtorNo'];
+	$Amount = filter_number_format($_POST['Amount']);
+	$Result = DB_query("SELECT debtorsmaster.currcode, currencies.rate, currencies.decimalplaces
+						FROM debtorsmaster INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+						WHERE debtorsmaster.debtorno = '" . DB_escape_string($DebtorNo) . "'");
+	if (DB_num_rows($Result) == 0) {
+		$InputError = 1;
+		prnMsg(__('The customer could not be found'), 'error');
+	} else {
+		$Customer = DB_fetch_array($Result);
+		$Amount = round($Amount, $Customer['decimalplaces']);
+		if (!is_numeric($Amount) or $Amount <= 0) {
+			$InputError = 1;
+			prnMsg(__('The amount to write off must be more than zero'), 'error');
+		} elseif ($Amount > CreditWriteOffableBalance($DebtorNo) + 0.00001) {
+			$InputError = 1;
+			prnMsg(__('The amount to write off is more than the unpaid balance of the customer'), 'error');
+		}
+	}
+	if (trim($_POST['Reason']) == '') {
+		$InputError = 1;
+		prnMsg(__('The reason for the write-off must be entered'), 'error');
+	}
+	if ($InputError == 0) {
+		$AmountHome = $Amount / $Customer['rate'];
+		$StopCustomer = isset($_POST['StopCustomer']) ? 1 : 0;
+		DB_query("INSERT INTO writeoffs (debtorno, requestdate, requestedby, amount, currcode, amounthome, reason, status, stoponwriteoff)
+					VALUES ('" . DB_escape_string($DebtorNo) . "',
+							NOW(),
+							'" . $_SESSION['UserID'] . "',
+							'" . $Amount . "',
+							'" . $Customer['currcode'] . "',
+							'" . $AmountHome . "',
+							'" . DB_escape_string($_POST['Reason']) . "',
+							'Pending',
+							'" . $StopCustomer . "')");
+		$WriteOffID = DB_Last_Insert_ID('writeoffs', 'id');
+		if ($AmountHome > $ApprovalLimit and !$IsApprover) {
+			CreditLogEvent($DebtorNo, 'writeoff', __('Write-off requested, waiting for the Finance Director') . ': ' . $_POST['Reason'], '', __('Pending'), $Amount, $Customer['currcode']);
+			prnMsg(__('The write-off is above') . ' ' . locale_number_format($ApprovalLimit, $HomeDecimals) . ' ' . $_SESSION['CompanyRecord']['currencydefault'] . ' ' . __('so it waits for the approval of the Finance Director. Nothing has been posted'), 'info');
+		} elseif (BadDebtPost($WriteOffID, $DebtorNo, $Amount, $_POST['Reason'], $BadDebtAct, $StopCustomer, $AmountHome > $ApprovalLimit ? $_SESSION['UserID'] : '')) {
+			prnMsg(__('The bad debt has been written off'), 'success');
+		} else {
+			/* it could not be posted so do not leave it waiting for approval */
+			DB_query("UPDATE writeoffs SET status = 'Rejected', decidedby = '" . $_SESSION['UserID'] . "', decidedate = NOW() WHERE id = '" . $WriteOffID . "'");
+		}
+	}
+}
+
+/* The form */
+$SelectedDebtor = '';
+if (isset($_GET['DebtorNo'])) {
+	$SelectedDebtor = $_GET['DebtorNo'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$SelectedDebtor = $_POST['DebtorNo'];
+}
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Write off a Bad Debt') . '</legend>
+	<field><label for="DebtorNo">' . __('Customer') . ':</label><select name="DebtorNo">';
+$Result = DB_query("SELECT debtorsmaster.debtorno, debtorsmaster.name, debtorsmaster.currcode, SUM(debtortrans.balance) AS owing
+					FROM debtorsmaster
+					INNER JOIN debtortrans ON debtorsmaster.debtorno = debtortrans.debtorno
+					WHERE debtortrans.type IN (10, " . CREDIT_TYPE_CHARGE . ")
+						AND debtortrans.settled = 0
+						AND debtortrans.balance > 0
+					GROUP BY debtorsmaster.debtorno, debtorsmaster.name, debtorsmaster.currcode
+					ORDER BY debtorsmaster.name");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option value="' . htmlspecialchars($MyRow['debtorno'], ENT_QUOTES, 'UTF-8') . '"' . ($MyRow['debtorno'] == $SelectedDebtor ? ' selected="selected"' : '') . '>'
+		. htmlspecialchars($MyRow['debtorno'] . ' - ' . $MyRow['name'], ENT_QUOTES, 'UTF-8') . ' (' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['owing'], 2) . ')</option>';
+}
+echo '</select></field>
+	<field><label for="Amount">' . __('Amount to write off (customer currency)') . ':</label>
+		<input type="text" class="number" name="Amount" size="14" maxlength="14" required="required" /></field>
+	<field><label for="Reason">' . __('Reason') . ':</label>
+		<input type="text" name="Reason" size="60" maxlength="200" required="required" /></field>
+	<field><label for="StopCustomer">' . __('Put the customer on stop') . ':</label>
+		<input type="checkbox" name="StopCustomer"' . ((!isset($_SESSION['WriteOffAutoStop']) or $_SESSION['WriteOffAutoStop'] == 1) ? ' checked="checked"' : '') . ' /></field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="WriteOff" value="' . __('Write Off') . '" onclick="return confirm(\'' . __('Write off this bad debt?') . '\');" /></div>
+	</form><br />';
+
+/* Waiting for approval */
+$Result = DB_query("SELECT writeoffs.*, debtorsmaster.name
+					FROM writeoffs INNER JOIN debtorsmaster ON writeoffs.debtorno = debtorsmaster.debtorno
+					WHERE writeoffs.status = 'Pending'
+					ORDER BY writeoffs.id");
+if (DB_num_rows($Result) > 0) {
+	echo '<table class="selection"><caption>' . __('Write-offs waiting for the approval of the Finance Director') . '</caption>
+		<tr><th>' . __('Requested') . '</th><th>' . __('By') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . __('Reason') . '</th><th></th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . $MyRow['requestdate'] . '</td>
+				<td>' . $MyRow['requestedby'] . '</td>
+				<td>' . htmlspecialchars($MyRow['debtorno'] . ' - ' . $MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], 2) . '</td>
+				<td>' . htmlspecialchars($MyRow['reason'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td>';
+		if ($IsApprover) {
+			echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+					<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+					<input type="hidden" name="WriteOffID" value="' . $MyRow['id'] . '" />
+					<input type="submit" name="Approve" value="' . __('Approve') . '" />
+					<input type="submit" name="Reject" value="' . __('Reject') . '" />
+				</form>';
+		} else {
+			echo __('Waiting');
+		}
+		echo '</td></tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');

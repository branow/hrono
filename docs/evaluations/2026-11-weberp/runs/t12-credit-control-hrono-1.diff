diff --git a/CreditCharges.php b/CreditCharges.php
new file mode 100644
index 0000000..d165720
--- /dev/null
+++ b/CreditCharges.php
@@ -0,0 +1,263 @@
+<?php
+
+/* Month-end interest and late fees on overdue balances, and the waiver of a charge.
+
+Interest is a simple annual rate on the balance of every undisputed invoice that is overdue by at least ChargeMinDaysOverdue days at the end of
+the month, for the days of the month it was overdue. Interest and fees are not charged on interest and fees. The late fee is a fixed amount in
+the home currency, converted to the currency of the customer, charged once per customer per month. Credit control sees what will be charged
+to whom and confirms it. A customer is charged once for a month, interest and fee separately, because of the unique key on creditcharges. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Month-End Interest and Late Fees');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditCharges';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$Rate = isset($_SESSION['InterestRate']) ? $_SESSION['InterestRate'] : 0;
+$Fee = isset($_SESSION['LateFeeAmount']) ? $_SESSION['LateFeeAmount'] : 0;
+$MinDaysOverdue = isset($_SESSION['ChargeMinDaysOverdue']) ? $_SESSION['ChargeMinDaysOverdue'] : 30;
+$InterestAct = isset($_SESSION['InterestIncomeAct']) ? $_SESSION['InterestIncomeAct'] : '';
+$FeeAct = isset($_SESSION['LateFeeIncomeAct']) ? $_SESSION['LateFeeIncomeAct'] : '';
+
+/* The months that can be charged are the months that have ended */
+$LastMonth = date('Y-m', mktime(0, 0, 0, date('n') - 1, 1, date('Y')));
+$ChargeMonth = $LastMonth;
+if (isset($_POST['ChargeMonth']) and preg_match('/^\d{4}-(0[1-9]|1[0-2])$/', $_POST['ChargeMonth'])) {
+	$ChargeMonth = $_POST['ChargeMonth'];
+}
+if ($ChargeMonth > $LastMonth) {
+	prnMsg(__('Only a month that has ended can be charged'), 'error');
+	$ChargeMonth = $LastMonth;
+}
+$MonthStart = $ChargeMonth . '-01';
+$MonthEnd = date('Y-m-t', strtotime($MonthStart));
+$DaysInMonth = (int) date('t', strtotime($MonthStart));
+
+$SettingsOK = true;
+if ($Rate == 0 and $Fee == 0) {
+	prnMsg(__('Neither an interest rate nor a late fee is set, so there is nothing to charge. Set them in Credit Control Settings'), 'warn');
+	$SettingsOK = false;
+}
+if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+	if ($Rate > 0 and $InterestAct == '') {
+		prnMsg(__('Choose the interest income account in Credit Control Settings before charging interest'), 'error');
+		$SettingsOK = false;
+	}
+	if ($Fee > 0 and $FeeAct == '') {
+		prnMsg(__('Choose the late fee income account in Credit Control Settings before charging late fees'), 'error');
+		$SettingsOK = false;
+	}
+}
+
+/* What would be charged for the month: array of debtorno => array(name, currcode, decimals, rate, interest, fee, lines) */
+function CreditChargesDue($ChargeMonth, $MonthEnd, $DaysInMonth, $Rate, $Fee, $MinDaysOverdue) {
+	$Due = array();
+	$Result = DB_query("SELECT debtortrans.debtorno,
+								debtortrans.transno,
+								debtortrans.balance,
+								TO_DAYS('" . $MonthEnd . "') - TO_DAYS(" . CreditDueDateSQL() . ") AS daysoverdue,
+								debtorsmaster.name,
+								debtorsmaster.currcode,
+								debtorsmaster.nointerest,
+								debtorsmaster.nofees,
+								currencies.decimalplaces,
+								currencies.rate
+						FROM debtortrans
+						INNER JOIN debtorsmaster ON debtortrans.debtorno = debtorsmaster.debtorno
+						INNER JOIN paymentterms ON debtorsmaster.paymentterms = paymentterms.termsindicator
+						INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+						WHERE debtortrans.type = 10
+							AND debtortrans.settled = 0
+							AND debtortrans.balance > 0
+							AND debtortrans.disputed = 0
+							AND debtortrans.trandate <= '" . $MonthEnd . "'
+							AND TO_DAYS('" . $MonthEnd . "') - TO_DAYS(" . CreditDueDateSQL() . ") >= " . (int) $MinDaysOverdue . "
+						ORDER BY debtortrans.debtorno, debtortrans.id");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$D = $MyRow['debtorno'];
+		if (!isset($Due[$D])) {
+			$Due[$D] = array('name' => $MyRow['name'],
+							'currcode' => $MyRow['currcode'],
+							'decimals' => $MyRow['decimalplaces'],
+							'rate' => $MyRow['rate'],
+							'interest' => 0,
+							'fee' => 0,
+							'nointerest' => $MyRow['nointerest'],
+							'nofees' => $MyRow['nofees'],
+							'invoices' => 0);
+		}
+		$Due[$D]['invoices']++;
+		$Due[$D]['interest'] += $MyRow['balance'] * ($Rate / 100) / 365 * min($MyRow['daysoverdue'], $DaysInMonth);
+	}
+	foreach ($Due as $D => $Row) {
+		$Due[$D]['interest'] = ($Rate > 0 and $Row['nointerest'] == 0) ? round($Row['interest'], $Row['decimals']) : 0;
+		$Due[$D]['fee'] = ($Fee > 0 and $Row['nofees'] == 0) ? round($Fee * $Row['rate'], $Row['decimals']) : 0;
+		/* a customer that was charged already this month is not charged again */
+		$Result = DB_query("SELECT kind FROM creditcharges WHERE debtorno = '" . DB_escape_string($D) . "' AND chargemonth = '" . $ChargeMonth . "'");
+		while ($MyRow = DB_fetch_row($Result)) {
+			if ($MyRow[0] == 'I') {
+				$Due[$D]['interest'] = 0;
+			} else {
+				$Due[$D]['fee'] = 0;
+			}
+		}
+		if ($Due[$D]['interest'] <= 0 and $Due[$D]['fee'] <= 0) {
+			unset($Due[$D]);
+		}
+	}
+	return $Due;
+}
+
+/* Waive a charge */
+if (isset($_POST['Waive']) and isset($_POST['WaiveID'])) {
+	$ChargeID = (int) $_POST['WaiveID'];
+	$Reason = trim($_POST['WaiveReason' . $ChargeID]);
+	$Result = DB_query("SELECT creditcharges.*,
+							debtortrans.rate AS transrate,
+							debtortrans.balance,
+							currencies.decimalplaces
+						FROM creditcharges
+						INNER JOIN debtortrans ON creditcharges.chargetransid = debtortrans.id
+						INNER JOIN debtorsmaster ON creditcharges.debtorno = debtorsmaster.debtorno
+						INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+						WHERE creditcharges.id = '" . $ChargeID . "'");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('The charge could not be found'), 'error');
+	} else {
+		$Charge = DB_fetch_array($Result);
+		if ($Reason == '') {
+			prnMsg(__('The reason for waiving the charge must be entered'), 'error');
+		} elseif ($Charge['waivetransid'] != 0) {
+			prnMsg(__('This charge has already been waived'), 'warn');
+		} elseif ($Charge['balance'] < $Charge['amount'] - pow(10, -$Charge['decimalplaces'])) {
+			prnMsg(__('This charge has been paid in whole or part so it cannot be waived here. Raise a credit note instead'), 'error');
+		} else {
+			$Account = ($Charge['kind'] == 'I') ? $InterestAct : $FeeAct;
+			DB_Txn_Begin();
+			$Posted = CreditPostDebtorTrans($Charge['debtorno'], CREDIT_TYPE_WAIVER, -$Charge['amount'],
+							__('Waiver of') . ' ' . ($Charge['kind'] == 'I' ? __('interest') : __('late fee')) . ' ' . $Charge['chargemonth'], $Reason, $Account, $Charge['transrate']);
+			$Diff = CreditAllocate($Posted['id'], $Posted['rate'], $Charge['chargetransid'], $Charge['transrate'], $Charge['amount'], $Charge['decimalplaces']);
+			CreditSettleTrans($Posted['id'], $Charge['amount'], $Diff, $Charge['decimalplaces']);
+			DB_query("UPDATE creditcharges
+						SET waivetransid = '" . $Posted['id'] . "',
+							waivedby = '" . $_SESSION['UserID'] . "',
+							waivedate = NOW(),
+							waivereason = '" . DB_escape_string($Reason) . "'
+						WHERE id = '" . $ChargeID . "'", '', '', true);
+			CreditLogEvent($Charge['debtorno'], 'waiver', $Reason, $Charge['chargemonth'], ($Charge['kind'] == 'I' ? __('Interest') : __('Late fee')), $Charge['amount'], $Charge['currcode']);
+			EnsureGLEntriesBalance(CREDIT_TYPE_WAIVER, $Posted['transno']);
+			DB_Txn_Commit();
+			prnMsg(__('The charge has been waived and the waiver posted to the ledger'), 'success');
+		}
+	}
+}
+
+/* Post the charges for the month */
+if (isset($_POST['PostCharges']) and $SettingsOK) {
+	$Posted = 0;
+	foreach (CreditChargesDue($ChargeMonth, $MonthEnd, $DaysInMonth, $Rate, $Fee, $MinDaysOverdue) as $DebtorNo => $Row) {
+		foreach (array('I' => 'interest', 'F' => 'fee') as $Kind => $Name) {
+			$Amount = ($Kind == 'I') ? $Row['interest'] : $Row['fee'];
+			if ($Amount <= 0) {
+				continue;
+			}
+			DB_Txn_Begin();
+			/* the lock and the unique key stop the same month being charged twice, even by two people at once */
+			$Existing = DB_query("SELECT id FROM creditcharges
+									WHERE debtorno = '" . DB_escape_string($DebtorNo) . "'
+										AND chargemonth = '" . $ChargeMonth . "'
+										AND kind = '" . $Kind . "'
+									FOR UPDATE");
+			if (DB_num_rows($Existing) > 0) {
+				DB_Txn_Rollback();
+				continue;
+			}
+			if ($Kind == 'I') {
+				$Reference = __('Interest') . ' ' . $ChargeMonth;
+				$Text = __('Interest on overdue balance for') . ' ' . $ChargeMonth . ' ' . __('at') . ' ' . $Rate . '% ' . __('per annum');
+				$Account = $InterestAct;
+			} else {
+				$Reference = __('Late fee') . ' ' . $ChargeMonth;
+				$Text = __('Late payment fee for') . ' ' . $ChargeMonth;
+				$Account = $FeeAct;
+			}
+			$Trans = CreditPostDebtorTrans($DebtorNo, CREDIT_TYPE_CHARGE, $Amount, $Reference, $Text, $Account);
+			DB_query("INSERT INTO creditcharges (debtorno, chargemonth, kind, amount, currcode, chargetransid, chargedby, chargedate)
+						VALUES ('" . DB_escape_string($DebtorNo) . "',
+								'" . $ChargeMonth . "',
+								'" . $Kind . "',
+								'" . $Amount . "',
+								'" . $Row['currcode'] . "',
+								'" . $Trans['id'] . "',
+								'" . $_SESSION['UserID'] . "',
+								NOW())", __('The charge could not be recorded because'), '', true);
+			CreditLogEvent($DebtorNo, 'charge', $Text, '', $Kind == 'I' ? __('Interest') : __('Late fee'), $Amount, $Row['currcode']);
+			EnsureGLEntriesBalance(CREDIT_TYPE_CHARGE, $Trans['transno']);
+			DB_Txn_Commit();
+			$Posted++;
+		}
+	}
+	prnMsg($Posted . ' ' . __('charges have been posted for') . ' ' . $ChargeMonth, 'success');
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Month to Charge') . '</legend>
+	<field><label for="ChargeMonth">' . __('Month') . ' (YYYY-MM):</label>
+		<input type="text" name="ChargeMonth" size="8" maxlength="7" pattern="\d{4}-\d{2}" value="' . $ChargeMonth . '" /></field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Preview" value="' . __('Show what will be charged') . '" /></div>';
+
+if ($SettingsOK) {
+	$Due = CreditChargesDue($ChargeMonth, $MonthEnd, $DaysInMonth, $Rate, $Fee, $MinDaysOverdue);
+	echo '<p>' . __('Interest rate') . ' ' . $Rate . '% ' . __('per annum, late fee') . ' ' . locale_number_format($Fee, $_SESSION['CompanyRecord']['decimalplaces'] ?? 2) . ' ' . $_SESSION['CompanyRecord']['currencydefault'] . ', ' . __('balances overdue at least') . ' ' . $MinDaysOverdue . ' ' . __('days at') . ' ' . ConvertSQLDate($MonthEnd) . '</p>';
+	if (count($Due) == 0) {
+		prnMsg(__('Nothing is left to charge for') . ' ' . $ChargeMonth, 'info');
+	} else {
+		echo '<table class="selection"><caption>' . __('To be charged for') . ' ' . $ChargeMonth . '</caption>
+			<tr><th>' . __('Customer') . '</th><th>' . __('Currency') . '</th><th>' . __('Overdue Invoices') . '</th><th>' . __('Interest') . '</th><th>' . __('Late Fee') . '</th></tr>';
+		foreach ($Due as $DebtorNo => $Row) {
+			echo '<tr class="striped_row">
+					<td>' . htmlspecialchars($DebtorNo . ' - ' . $Row['name'], ENT_QUOTES, 'UTF-8') . '</td>
+					<td>' . $Row['currcode'] . '</td>
+					<td class="number">' . $Row['invoices'] . '</td>
+					<td class="number">' . locale_number_format($Row['interest'], $Row['decimals']) . '</td>
+					<td class="number">' . locale_number_format($Row['fee'], $Row['decimals']) . '</td>
+				</tr>';
+		}
+		echo '</table><br />
+			<div class="centre"><input type="submit" name="PostCharges" value="' . __('Confirm and Post these Charges') . '" onclick="return confirm(\'' . __('Post these charges to the customer accounts and the general ledger?') . '\');" /></div>';
+	}
+}
+
+/* Charges that can be waived */
+echo '<br /><table class="selection"><caption>' . __('Charges of') . ' ' . $ChargeMonth . '</caption>
+	<tr><th>' . __('Customer') . '</th><th>' . __('Description') . '</th><th>' . __('Amount') . '</th><th>' . __('Waive - reason') . '</th></tr>';
+$Result = DB_query("SELECT creditcharges.id, creditcharges.debtorno, debtorsmaster.name, creditcharges.kind, creditcharges.amount, creditcharges.currcode, creditcharges.waivetransid, creditcharges.waivereason
+					FROM creditcharges
+					INNER JOIN debtorsmaster ON creditcharges.debtorno = debtorsmaster.debtorno
+					WHERE creditcharges.chargemonth = '" . $ChargeMonth . "'
+					ORDER BY creditcharges.debtorno, creditcharges.kind");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>' . htmlspecialchars($MyRow['debtorno'] . ' - ' . $MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td>' . ($MyRow['kind'] == 'I' ? __('Interest') : __('Late fee')) . '</td>
+			<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], 2) . '</td>
+			<td>';
+	if ($MyRow['waivetransid'] != 0) {
+		echo __('Waived') . ' - ' . htmlspecialchars($MyRow['waivereason'], ENT_QUOTES, 'UTF-8');
+	} else {
+		echo '<input type="text" name="WaiveReason' . $MyRow['id'] . '" size="30" maxlength="200" />
+			<button type="submit" name="Waive" value="1" onclick="this.form.WaiveID.value=' . $MyRow['id'] . ';">' . __('Waive') . '</button>';
+	}
+	echo '</td></tr>';
+}
+echo '</table><input type="hidden" name="WaiveID" value="" /></form>';
+
+include('includes/footer.php');
diff --git a/CreditControlReport.php b/CreditControlReport.php
new file mode 100644
index 0000000..71912c7
--- /dev/null
+++ b/CreditControlReport.php
@@ -0,0 +1,128 @@
+<?php
+
+/* The credit control report: customers due or overdue for a credit review, customers over their credit limit and by how much, and
+customers on watch or on stop. It can be filtered by sales rep and by currency and the totals are in the home currency.
+A sales rep login sees only that rep's customers. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Control Report');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlReport';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$Home = $_SESSION['CompanyRecord']['currencydefault'];
+$HomeDecimals = $_SESSION['CompanyRecord']['decimalplaces'];
+
+$Salesman = '';
+if (!empty($_SESSION['SalesmanLogin'])) {
+	$Salesman = $_SESSION['SalesmanLogin'];
+} elseif (isset($_POST['Salesman'])) {
+	$Salesman = $_POST['Salesman'];
+}
+$Currency = isset($_POST['Currency']) ? $_POST['Currency'] : '';
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Select') . '</legend>';
+if (empty($_SESSION['SalesmanLogin'])) {
+	echo '<field><label for="Salesman">' . __('Sales rep') . ':</label><select name="Salesman"><option value="">' . __('All') . '</option>';
+	$Result = DB_query("SELECT salesmancode, salesmanname FROM salesman ORDER BY salesmanname");
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<option value="' . $MyRow['salesmancode'] . '"' . ($MyRow['salesmancode'] == $Salesman ? ' selected="selected"' : '') . '>' . htmlspecialchars($MyRow['salesmanname'], ENT_QUOTES, 'UTF-8') . '</option>';
+	}
+	echo '</select></field>';
+}
+echo '<field><label for="Currency">' . __('Currency') . ':</label><select name="Currency"><option value="">' . __('All') . '</option>';
+$Result = DB_query("SELECT currabrev, currency FROM currencies ORDER BY currabrev");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option value="' . $MyRow['currabrev'] . '"' . ($MyRow['currabrev'] == $Currency ? ' selected="selected"' : '') . '>' . $MyRow['currabrev'] . ' - ' . htmlspecialchars($MyRow['currency'], ENT_QUOTES, 'UTF-8') . '</option>';
+}
+echo '</select></field></fieldset>
+	<div class="centre"><input type="submit" name="View" value="' . __('Show') . '" /></div></form><br />';
+
+$Where = '';
+if ($Salesman != '') {
+	$Where .= " AND debtorsmaster.debtorno IN (SELECT debtorno FROM custbranch WHERE salesman = '" . DB_escape_string($Salesman) . "')";
+}
+if ($Currency != '') {
+	$Where .= " AND debtorsmaster.currcode = '" . DB_escape_string($Currency) . "'";
+}
+
+$Result = DB_query("SELECT debtorsmaster.debtorno,
+						debtorsmaster.name,
+						debtorsmaster.currcode,
+						debtorsmaster.creditlimit,
+						debtorsmaster.nextreviewdate,
+						holdreasons.dissallowinvoices,
+						holdreasons.reasondescription,
+						currencies.rate,
+						currencies.decimalplaces,
+						COALESCE(SUM(debtortrans.balance), 0) AS balance
+					FROM debtorsmaster
+					INNER JOIN holdreasons ON debtorsmaster.holdreason = holdreasons.reasoncode
+					INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+					LEFT JOIN debtortrans ON debtorsmaster.debtorno = debtortrans.debtorno
+					WHERE 1 = 1 " . $Where . "
+					GROUP BY debtorsmaster.debtorno, debtorsmaster.name, debtorsmaster.currcode, debtorsmaster.creditlimit, debtorsmaster.nextreviewdate,
+						holdreasons.dissallowinvoices, holdreasons.reasondescription, currencies.rate, currencies.decimalplaces
+					ORDER BY debtorsmaster.name");
+
+$ReviewDue = array();
+$OverLimit = array();
+$Flagged = array();
+$OverTotal = 0;
+$BalanceTotal = 0;
+while ($MyRow = DB_fetch_array($Result)) {
+	$MyRow['homebalance'] = $MyRow['balance'] / $MyRow['rate'];
+	$MyRow['over'] = $MyRow['balance'] - $MyRow['creditlimit'];
+	if ($MyRow['nextreviewdate'] <= date('Y-m-d')) {
+		$ReviewDue[] = $MyRow;
+	}
+	if ($MyRow['over'] > 0) {
+		$OverLimit[] = $MyRow;
+		$OverTotal += $MyRow['over'] / $MyRow['rate'];
+	}
+	if ($MyRow['dissallowinvoices'] == 1 or $MyRow['dissallowinvoices'] == 2) {
+		$Flagged[] = $MyRow;
+		$BalanceTotal += $MyRow['homebalance'];
+	}
+}
+
+function CreditReportRow($Row, $RootPath) {
+	return '<tr class="striped_row">
+			<td><a href="' . $RootPath . '/CustomerCredit.php?DebtorNo=' . urlencode($Row['debtorno']) . '">' . htmlspecialchars($Row['debtorno'] . ' - ' . $Row['name'], ENT_QUOTES, 'UTF-8') . '</a></td>
+			<td>' . $Row['currcode'] . '</td>
+			<td class="number">' . locale_number_format($Row['creditlimit'], 0) . '</td>
+			<td class="number">' . locale_number_format($Row['balance'], $Row['decimalplaces']) . '</td>
+			<td class="number">' . ($Row['over'] > 0 ? locale_number_format($Row['over'], $Row['decimalplaces']) : '') . '</td>
+			<td class="number">' . locale_number_format($Row['homebalance'], $_SESSION['CompanyRecord']['decimalplaces']) . '</td>
+			<td>' . CreditStatusText($Row['dissallowinvoices']) . ' - ' . htmlspecialchars($Row['reasondescription'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td>' . ($Row['nextreviewdate'] == '1000-01-01' ? '<b>' . __('Not set') . '</b>' : ConvertSQLDate($Row['nextreviewdate'])) . '</td>
+		</tr>';
+}
+$Head = '<tr><th>' . __('Customer') . '</th><th>' . __('Currency') . '</th><th>' . __('Credit Limit') . '</th><th>' . __('Balance') . '</th><th>' . __('Over Limit By') . '</th><th>' . __('Balance in') . ' ' . $Home . '</th><th>' . __('Status') . '</th><th>' . __('Next Review') . '</th></tr>';
+
+echo '<table class="selection"><caption>' . __('Due or overdue for a credit review') . ' (' . count($ReviewDue) . ')</caption>' . $Head;
+foreach ($ReviewDue as $Row) {
+	echo CreditReportRow($Row, $RootPath);
+}
+echo '</table><br />';
+
+echo '<table class="selection"><caption>' . __('Over their credit limit') . ' (' . count($OverLimit) . ')</caption>' . $Head;
+foreach ($OverLimit as $Row) {
+	echo CreditReportRow($Row, $RootPath);
+}
+echo '<tr><th colspan="5">' . __('Total over limit in') . ' ' . $Home . '</th><th class="number">' . locale_number_format($OverTotal, $HomeDecimals) . '</th><th colspan="2"></th></tr></table><br />';
+
+echo '<table class="selection"><caption>' . __('On watch or on stop') . ' (' . count($Flagged) . ')</caption>' . $Head;
+foreach ($Flagged as $Row) {
+	echo CreditReportRow($Row, $RootPath);
+}
+echo '<tr><th colspan="5">' . __('Total balance in') . ' ' . $Home . '</th><th class="number">' . locale_number_format($BalanceTotal, $HomeDecimals) . '</th><th colspan="2"></th></tr></table>';
+
+include('includes/footer.php');
diff --git a/CreditControlSettings.php b/CreditControlSettings.php
new file mode 100644
index 0000000..13eabd7
--- /dev/null
+++ b/CreditControlSettings.php
@@ -0,0 +1,129 @@
+<?php
+
+/* Finance sets the credit control rules: the standard review period, over-limit holds, the reminder spacing, the interest rate, the late fee,
+the days overdue before a balance is charged, the ledger accounts the charges and write-offs post to and the write-off approval limit */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Control Settings');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlSettings';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/maintenance.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$Defaults = array('CreditReviewMonths' => 12,
+				'CreditHoldOverLimit' => 1,
+				'DunningMinDaysBetween' => 7,
+				'DunningAutoStop' => 0,
+				'InterestRate' => 0,
+				'LateFeeAmount' => 0,
+				'ChargeMinDaysOverdue' => 30,
+				'InterestIncomeAct' => '',
+				'LateFeeIncomeAct' => '',
+				'BadDebtAct' => '',
+				'WriteOffApprovalLimit' => 1000,
+				'WriteOffAutoStop' => 1);
+foreach ($Defaults as $Name => $Value) {
+	if (!isset($_SESSION[$Name])) {
+		$_SESSION[$Name] = $Value;
+	}
+}
+
+if (isset($_POST['submit'])) {
+	$InputError = 0;
+	$Numbers = array('CreditReviewMonths' => __('The standard review period'),
+					'DunningMinDaysBetween' => __('The days between reminders'),
+					'InterestRate' => __('The interest rate'),
+					'LateFeeAmount' => __('The late fee'),
+					'ChargeMinDaysOverdue' => __('The days overdue before charging'),
+					'WriteOffApprovalLimit' => __('The write-off approval limit'));
+	foreach ($Numbers as $Name => $Description) {
+		$_POST[$Name] = filter_number_format($_POST[$Name]);
+		if (!is_numeric($_POST[$Name]) or $_POST[$Name] < 0) {
+			$InputError = 1;
+			prnMsg($Description . ' ' . __('must be a number that is not negative'), 'error');
+		}
+	}
+	if ($_POST['CreditReviewMonths'] < 1) {
+		$InputError = 1;
+		prnMsg(__('The standard review period must be at least one month'), 'error');
+	}
+	if ($_POST['InterestRate'] > 100) {
+		$InputError = 1;
+		prnMsg(__('The interest rate is an annual percentage and cannot be more than 100'), 'error');
+	}
+	foreach (array('InterestIncomeAct', 'LateFeeIncomeAct', 'BadDebtAct') as $Name) {
+		if ($_POST[$Name] != '') {
+			$Result = DB_query("SELECT accountcode FROM chartmaster WHERE accountcode = '" . DB_escape_string($_POST[$Name]) . "'");
+			if (DB_num_rows($Result) == 0) {
+				$InputError = 1;
+				prnMsg($_POST[$Name] . ' ' . __('is not a general ledger account'), 'error');
+			}
+		}
+	}
+	if ($InputError == 0) {
+		$_POST['CreditHoldOverLimit'] = isset($_POST['CreditHoldOverLimit']) ? 1 : 0;
+		$_POST['DunningAutoStop'] = isset($_POST['DunningAutoStop']) ? 1 : 0;
+		$_POST['WriteOffAutoStop'] = isset($_POST['WriteOffAutoStop']) ? 1 : 0;
+		foreach ($Defaults as $Name => $Value) {
+			DB_query("INSERT INTO config (confname, confvalue)
+						VALUES ('" . $Name . "', '" . DB_escape_string($_POST[$Name]) . "')
+						ON DUPLICATE KEY UPDATE confvalue = '" . DB_escape_string($_POST[$Name]) . "'");
+			$_SESSION[$Name] = $_POST[$Name];
+		}
+		prnMsg(__('The credit control settings have been saved'), 'success');
+	}
+}
+
+function CreditAccountSelect($Name, $Selected) {
+	$Result = DB_query("SELECT accountcode, accountname FROM chartmaster ORDER BY accountcode");
+	echo '<select name="' . $Name . '"><option value="">' . __('Not set') . '</option>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<option value="' . $MyRow['accountcode'] . '"' . ($MyRow['accountcode'] == $Selected ? ' selected="selected"' : '') . '>'
+			. $MyRow['accountcode'] . ' - ' . htmlspecialchars($MyRow['accountname'], ENT_QUOTES, 'UTF-8') . '</option>';
+	}
+	echo '</select>';
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Reviews and Holds') . '</legend>
+	<field><label for="CreditReviewMonths">' . __('Standard review period (months)') . ':</label>
+		<input type="text" class="number" name="CreditReviewMonths" size="5" maxlength="3" value="' . $_SESSION['CreditReviewMonths'] . '" /></field>
+	<field><label for="CreditHoldOverLimit">' . __('Hold orders that take a customer over their limit for approval') . ':</label>
+		<input type="checkbox" name="CreditHoldOverLimit"' . ($_SESSION['CreditHoldOverLimit'] == 1 ? ' checked="checked"' : '') . ' /></field>
+	</fieldset>
+	<fieldset><legend>' . __('Reminder Letters') . '</legend>
+	<field><label for="DunningMinDaysBetween">' . __('Minimum days between two letters to a customer') . ':</label>
+		<input type="text" class="number" name="DunningMinDaysBetween" size="5" maxlength="3" value="' . $_SESSION['DunningMinDaysBetween'] . '" /></field>
+	<field><label for="DunningAutoStop">' . __('Put the customer on stop when the final letter is sent') . ':</label>
+		<input type="checkbox" name="DunningAutoStop"' . ($_SESSION['DunningAutoStop'] == 1 ? ' checked="checked"' : '') . ' /></field>
+	</fieldset>
+	<fieldset><legend>' . __('Interest and Late Fees (charged at month end)') . '</legend>
+	<field><label for="InterestRate">' . __('Interest - simple annual rate (%)') . ':</label>
+		<input type="text" class="number" name="InterestRate" size="8" maxlength="6" value="' . $_SESSION['InterestRate'] . '" /></field>
+	<field><label for="LateFeeAmount">' . __('Late fee per customer per month (home currency)') . ':</label>
+		<input type="text" class="number" name="LateFeeAmount" size="10" maxlength="10" value="' . $_SESSION['LateFeeAmount'] . '" /></field>
+	<field><label for="ChargeMinDaysOverdue">' . __('Days overdue before a balance is charged') . ':</label>
+		<input type="text" class="number" name="ChargeMinDaysOverdue" size="5" maxlength="4" value="' . $_SESSION['ChargeMinDaysOverdue'] . '" /></field>
+	<field><label for="InterestIncomeAct">' . __('Interest income account') . ':</label>';
+CreditAccountSelect('InterestIncomeAct', $_SESSION['InterestIncomeAct']);
+echo '</field>
+	<field><label for="LateFeeIncomeAct">' . __('Late fee income account') . ':</label>';
+CreditAccountSelect('LateFeeIncomeAct', $_SESSION['LateFeeIncomeAct']);
+echo '</field>
+	</fieldset>
+	<fieldset><legend>' . __('Bad Debt Write-off') . '</legend>
+	<field><label for="BadDebtAct">' . __('Bad debt account') . ':</label>';
+CreditAccountSelect('BadDebtAct', $_SESSION['BadDebtAct']);
+echo '</field>
+	<field><label for="WriteOffApprovalLimit">' . __('Write-offs above this amount (home currency) need the Finance Director') . ':</label>
+		<input type="text" class="number" name="WriteOffApprovalLimit" size="12" maxlength="12" value="' . $_SESSION['WriteOffApprovalLimit'] . '" /></field>
+	<field><label for="WriteOffAutoStop">' . __('Put the customer on stop after a write-off unless credit control decides otherwise') . ':</label>
+		<input type="checkbox" name="WriteOffAutoStop"' . ($_SESSION['WriteOffAutoStop'] == 1 ? ' checked="checked"' : '') . ' /></field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="submit" value="' . __('Save') . '" /></div>
+	</form>';
+
+include('includes/footer.php');
diff --git a/CreditHeldOrders.php b/CreditHeldOrders.php
new file mode 100644
index 0000000..7988b34
--- /dev/null
+++ b/CreditHeldOrders.php
@@ -0,0 +1,80 @@
+<?php
+
+/* Credit control's list of open orders that need a decision or attention: orders held because they take the customer over the credit limit,
+orders of customers on stop and orders taken for customers on watch. Credit control can release a held order, or an order of a customer on
+stop, so that it can be dispatched and invoiced. Orders of customers on watch are accepted and are listed here for information. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Held and Watched Orders');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditHeldOrders';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+if (isset($_POST['ReleaseOrder'])) {
+	$OrderNo = (int) $_POST['ReleaseOrder'];
+	$Reason = trim($_POST['ReleaseReason' . $OrderNo]);
+	if ($Reason == '') {
+		prnMsg(__('The reason for releasing the order must be entered'), 'error');
+	} else {
+		$Result = DB_query("SELECT debtorno FROM salesorders WHERE orderno = '" . $OrderNo . "'");
+		if (DB_num_rows($Result) == 1) {
+			$MyRow = DB_fetch_row($Result);
+			DB_query("UPDATE salesorders SET creditheld = 0, creditreleased = 1 WHERE orderno = '" . $OrderNo . "'");
+			CreditLogEvent($MyRow[0], 'orderreleased', $Reason, '', (string) $OrderNo);
+			prnMsg(__('Order') . ' ' . $OrderNo . ' ' . __('has been released by credit control'), 'success');
+		}
+	}
+}
+
+function CreditOrdersTable($Caption, $Where, $CanRelease, $RootPath) {
+	$Result = DB_query("SELECT salesorders.orderno,
+							salesorders.debtorno,
+							debtorsmaster.name,
+							debtorsmaster.currcode,
+							salesorders.orddate,
+							salesorders.creditheld,
+							salesorders.creditreleased,
+							holdreasons.reasondescription,
+							SUM(salesorderdetails.unitprice * (salesorderdetails.quantity - salesorderdetails.qtyinvoiced) * (1 - salesorderdetails.discountpercent)) AS ordervalue
+						FROM salesorders
+						INNER JOIN salesorderdetails ON salesorders.orderno = salesorderdetails.orderno
+						INNER JOIN debtorsmaster ON salesorders.debtorno = debtorsmaster.debtorno
+						INNER JOIN holdreasons ON debtorsmaster.holdreason = holdreasons.reasoncode
+						WHERE salesorders.quotation = 0
+							AND salesorderdetails.completed = 0
+							AND " . $Where . "
+						GROUP BY salesorders.orderno, salesorders.debtorno, debtorsmaster.name, debtorsmaster.currcode, salesorders.orddate,
+							salesorders.creditheld, salesorders.creditreleased, holdreasons.reasondescription
+						ORDER BY salesorders.orddate");
+	echo '<table class="selection"><caption>' . $Caption . ' (' . DB_num_rows($Result) . ')</caption>
+		<tr><th>' . __('Order') . '</th><th>' . __('Customer') . '</th><th>' . __('Date') . '</th><th>' . __('Open Value') . '</th><th>' . __('Credit Status') . '</th><th>' . ($CanRelease ? __('Release - reason') : '') . '</th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td><a href="' . $RootPath . '/OrderDetails.php?OrderNumber=' . $MyRow['orderno'] . '">' . $MyRow['orderno'] . '</a></td>
+				<td><a href="' . $RootPath . '/CustomerCredit.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . htmlspecialchars($MyRow['debtorno'] . ' - ' . $MyRow['name'], ENT_QUOTES, 'UTF-8') . '</a></td>
+				<td>' . ConvertSQLDate($MyRow['orddate']) . '</td>
+				<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['ordervalue'], 2) . '</td>
+				<td>' . htmlspecialchars($MyRow['reasondescription'], ENT_QUOTES, 'UTF-8') . ($MyRow['creditreleased'] ? ' - ' . __('released') : '') . '</td>
+				<td>';
+		if ($CanRelease and $MyRow['creditreleased'] == 0) {
+			echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+					<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+					<input type="text" name="ReleaseReason' . $MyRow['orderno'] . '" size="30" maxlength="200" />
+					<button type="submit" name="ReleaseOrder" value="' . $MyRow['orderno'] . '">' . __('Release') . '</button>
+				</form>';
+		}
+		echo '</td></tr>';
+	}
+	echo '</table><br />';
+}
+
+CreditOrdersTable(__('Held over the credit limit - waiting for approval'), 'salesorders.creditheld = 1 AND salesorders.creditreleased = 0', true, $RootPath);
+CreditOrdersTable(__('Open orders of customers on stop'), 'holdreasons.dissallowinvoices = 1', true, $RootPath);
+CreditOrdersTable(__('Open orders of customers on watch'), 'holdreasons.dissallowinvoices = 2', false, $RootPath);
+
+include('includes/footer.php');
diff --git a/CreditReconciliation.php b/CreditReconciliation.php
new file mode 100644
index 0000000..551a593
--- /dev/null
+++ b/CreditReconciliation.php
@@ -0,0 +1,97 @@
+<?php
+
+/* Month-end agreement of the customer balances with the trade debtors control account in the general ledger. When the two differ it lists
+what explains the difference: customer transactions with no ledger posting, and ledger postings to the control account that have no
+customer transaction behind them (for example manual journals). */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Debtors Ledger Reconciliation');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditReconciliation';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$ControlAccount = $_SESSION['CompanyRecord']['debtorsact'];
+$Decimals = $_SESSION['CompanyRecord']['decimalplaces'];
+$Home = $_SESSION['CompanyRecord']['currencydefault'];
+
+if ($_SESSION['CompanyRecord']['gllink_debtors'] != 1) {
+	prnMsg(__('Debtors are not linked to the general ledger so there is no control account to agree to'), 'warn');
+	include('includes/footer.php');
+	exit();
+}
+
+/* The customer accounts in home currency, each transaction at its own rate, which is how the ledger holds it */
+$Result = DB_query("SELECT debtorsmaster.currcode,
+						SUM(debtortrans.balance) AS balance,
+						SUM(debtortrans.balance / debtortrans.rate) AS homebalance
+					FROM debtortrans
+					INNER JOIN debtorsmaster ON debtortrans.debtorno = debtorsmaster.debtorno
+					WHERE debtortrans.rate <> 0
+					GROUP BY debtorsmaster.currcode
+					ORDER BY debtorsmaster.currcode");
+echo '<table class="selection"><caption>' . __('Customer balances') . '</caption>
+	<tr><th>' . __('Currency') . '</th><th>' . __('Balance in the currency') . '</th><th>' . __('In') . ' ' . $Home . '</th></tr>';
+$CustomerTotal = 0;
+while ($MyRow = DB_fetch_array($Result)) {
+	$CustomerTotal += $MyRow['homebalance'];
+	echo '<tr class="striped_row"><td>' . $MyRow['currcode'] . '</td><td class="number">' . locale_number_format($MyRow['balance'], 2) . '</td><td class="number">' . locale_number_format($MyRow['homebalance'], $Decimals) . '</td></tr>';
+}
+echo '<tr><th colspan="2">' . __('Total of customer balances') . '</th><th class="number">' . locale_number_format($CustomerTotal, $Decimals) . '</th></tr></table><br />';
+
+$Result = DB_query("SELECT COALESCE(SUM(amount), 0) FROM gltotals WHERE account = '" . $ControlAccount . "'");
+$MyRow = DB_fetch_row($Result);
+$LedgerTotal = $MyRow[0];
+$Difference = $LedgerTotal - $CustomerTotal;
+
+echo '<table class="selection">
+	<tr><th>' . __('Trade debtors control account') . ' ' . $ControlAccount . '</th><td class="number">' . locale_number_format($LedgerTotal, $Decimals) . '</td></tr>
+	<tr><th>' . __('Total of customer balances') . '</th><td class="number">' . locale_number_format($CustomerTotal, $Decimals) . '</td></tr>
+	<tr><th>' . __('Difference') . '</th><td class="number"><b>' . locale_number_format($Difference, $Decimals) . '</b></td></tr>
+	</table><br />';
+
+if (abs($Difference) < pow(10, -$Decimals)) {
+	prnMsg(__('The customer balances agree with the trade debtors control account'), 'success');
+} else {
+	prnMsg(__('The customer balances do not agree with the trade debtors control account. Look at the two lists below, and at exchange differences on foreign currency customers'), 'warn');
+}
+
+$Result = DB_query("SELECT debtortrans.type, systypes.typename, debtortrans.transno, debtortrans.debtorno, debtortrans.trandate,
+						(debtortrans.ovamount + debtortrans.ovgst + debtortrans.ovfreight + debtortrans.ovdiscount) / debtortrans.rate AS homeamount
+					FROM debtortrans
+					INNER JOIN systypes ON debtortrans.type = systypes.typeid
+					WHERE debtortrans.rate <> 0
+						AND (debtortrans.ovamount + debtortrans.ovgst + debtortrans.ovfreight + debtortrans.ovdiscount) <> 0
+						AND NOT EXISTS (SELECT 1 FROM gltrans
+										WHERE gltrans.type = debtortrans.type
+											AND gltrans.typeno = debtortrans.transno
+											AND gltrans.account = '" . $ControlAccount . "')
+					ORDER BY debtortrans.trandate DESC
+					LIMIT 200");
+echo '<table class="selection"><caption>' . __('Customer transactions with no posting to the control account') . '</caption>
+	<tr><th>' . __('Type') . '</th><th>' . __('Number') . '</th><th>' . __('Customer') . '</th><th>' . __('Date') . '</th><th>' . __('Amount') . '</th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row"><td>' . $MyRow['typename'] . '</td><td>' . $MyRow['transno'] . '</td><td>' . htmlspecialchars($MyRow['debtorno'], ENT_QUOTES, 'UTF-8') . '</td><td>' . ConvertSQLDate($MyRow['trandate']) . '</td><td class="number">' . locale_number_format($MyRow['homeamount'], $Decimals) . '</td></tr>';
+}
+echo '</table><br />';
+
+$Result = DB_query("SELECT gltrans.type, systypes.typename, gltrans.typeno, gltrans.trandate, gltrans.narrative, SUM(gltrans.amount) AS amount
+					FROM gltrans
+					INNER JOIN systypes ON gltrans.type = systypes.typeid
+					WHERE gltrans.account = '" . $ControlAccount . "'
+						AND NOT EXISTS (SELECT 1 FROM debtortrans
+										WHERE debtortrans.type = gltrans.type
+											AND debtortrans.transno = gltrans.typeno)
+					GROUP BY gltrans.type, systypes.typename, gltrans.typeno, gltrans.trandate, gltrans.narrative
+					ORDER BY gltrans.trandate DESC
+					LIMIT 200");
+echo '<table class="selection"><caption>' . __('Postings to the control account with no customer transaction') . '</caption>
+	<tr><th>' . __('Type') . '</th><th>' . __('Number') . '</th><th>' . __('Date') . '</th><th>' . __('Narrative') . '</th><th>' . __('Amount') . '</th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row"><td>' . $MyRow['typename'] . '</td><td>' . $MyRow['typeno'] . '</td><td>' . ConvertSQLDate($MyRow['trandate']) . '</td><td>' . htmlspecialchars($MyRow['narrative'], ENT_QUOTES, 'UTF-8') . '</td><td class="number">' . locale_number_format($MyRow['amount'], $Decimals) . '</td></tr>';
+}
+echo '</table>';
+
+include('includes/footer.php');

@@ -0,0 +1,53 @@
+<?php
+
+/* The bad debt write-offs over a period: customer, amount, reason, who requested it and who approved it */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Bad Debt Write-off Report');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditWriteOffReport';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$DateRe = '/^\d{4}-\d{2}-\d{2}$/';
+$From = (isset($_POST['FromDate']) and preg_match($DateRe, $_POST['FromDate'])) ? $_POST['FromDate'] : date('Y-m-01', mktime(0, 0, 0, date('n') - 11, 1, date('Y')));
+$To = (isset($_POST['ToDate']) and preg_match($DateRe, $_POST['ToDate'])) ? $_POST['ToDate'] : date('Y-m-d');
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Period') . '</legend>
+	<field><label for="FromDate">' . __('From') . ':</label><input type="date" name="FromDate" value="' . $From . '" /></field>
+	<field><label for="ToDate">' . __('To') . ':</label><input type="date" name="ToDate" value="' . $To . '" /></field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="View" value="' . __('Show') . '" /></div></form><br />';
+
+$Result = DB_query("SELECT writeoffs.*, debtorsmaster.name
+					FROM writeoffs INNER JOIN debtorsmaster ON writeoffs.debtorno = debtorsmaster.debtorno
+					WHERE DATE(writeoffs.requestdate) >= '" . $From . "'
+						AND DATE(writeoffs.requestdate) <= '" . $To . "'
+					ORDER BY writeoffs.requestdate");
+echo '<table class="selection">
+	<tr><th>' . __('Date') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . __('Home Currency') . '</th><th>' . __('Reason') . '</th><th>' . __('Requested By') . '</th><th>' . __('Approved By') . '</th><th>' . __('Status') . '</th><th>' . __('Write-off No') . '</th></tr>';
+$TotalHome = 0;
+while ($MyRow = DB_fetch_array($Result)) {
+	if ($MyRow['status'] == 'Posted') {
+		$TotalHome += $MyRow['amounthome'];
+	}
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate(substr($MyRow['requestdate'], 0, 10)) . '</td>
+			<td>' . htmlspecialchars($MyRow['debtorno'] . ' - ' . $MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], 2) . '</td>
+			<td class="number">' . locale_number_format($MyRow['amounthome'], $_SESSION['CompanyRecord']['decimalplaces']) . '</td>
+			<td>' . htmlspecialchars($MyRow['reason'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td>' . $MyRow['requestedby'] . '</td>
+			<td>' . ($MyRow['decidedby'] != '' ? $MyRow['decidedby'] : ($MyRow['status'] == 'Posted' ? __('Within the approval limit') : '')) . '</td>
+			<td>' . $MyRow['status'] . '</td>
+			<td class="number">' . ($MyRow['transno'] != 0 ? $MyRow['transno'] : '') . '</td>
+		</tr>';
+}
+echo '<tr><th colspan="3">' . __('Total posted in') . ' ' . $_SESSION['CompanyRecord']['currencydefault'] . '</th><th class="number">' . locale_number_format($TotalHome, $_SESSION['CompanyRecord']['decimalplaces']) . '</th><th colspan="5"></th></tr>
+	</table>';
+
+include('includes/footer.php');
diff --git a/CustomerCredit.php b/CustomerCredit.php
new file mode 100644
index 0000000..d394706
--- /dev/null
+++ b/CustomerCredit.php
@@ -0,0 +1,396 @@
+<?php
+
+/* The credit control view of one customer: credit status, limit, review history, disputed invoices, reminders, charges, write-offs and the
+full credit control history. Credit control (token 21) records reviews, changes status and limits and marks invoices disputed. Sales reps see
+their own customers only and cannot change anything. A customer logon sees its own balance, reminders and charges only. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Customer Credit Control');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CustomerCredit';
+include('includes/header.php');
+
+$IsCustomerLogin = (!empty($_SESSION['CustomerLogin']) and $_SESSION['CustomerLogin'] == 1);
+
+if ($IsCustomerLogin) {
+	$DebtorNo = $_SESSION['CustomerID'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+} elseif (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_SESSION['CustomerID'])) {
+	$DebtorNo = $_SESSION['CustomerID'];
+} else {
+	prnMsg(__('To display the credit control details a customer must first be selected from the customer selection screen'), 'info');
+	echo '<br /><div class="centre"><a href="' . $RootPath . '/SelectCustomer.php">' . __('Select a Customer') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.creditlimit,
+				debtorsmaster.nextreviewdate,
+				debtorsmaster.nointerest,
+				debtorsmaster.nofees,
+				debtorsmaster.holdreason,
+				debtorsmaster.currcode,
+				currencies.decimalplaces,
+				currencies.rate
+		FROM debtorsmaster
+		INNER JOIN currencies
+			ON debtorsmaster.currcode = currencies.currabrev
+		WHERE debtorsmaster.debtorno = '" . DB_escape_string($DebtorNo) . "'";
+$Result = DB_query($SQL);
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('The customer could not be found'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+if (!CreditUserMaySee($DebtorNo)) {
+	prnMsg(__('You have no authority to review the credit information of this customer'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($Result);
+$DebtorNo = $Customer['debtorno'];
+$DP = $Customer['decimalplaces'];
+$CanAct = (!$IsCustomerLogin and CreditUserCan());
+
+/* Actions */
+if ($CanAct and isset($_POST['SaveReview'])) {
+	$InputError = 0;
+	$Outcome = $_POST['Outcome'];
+	$NewLimit = filter_number_format($_POST['NewLimit']);
+	$NextReview = $_POST['NextReviewDate'];
+	if (!in_array($Outcome, array('confirmed', 'raised', 'reduced', 'watch', 'stop'))) {
+		$InputError = 1;
+		prnMsg(__('Select the outcome of the review'), 'error');
+	}
+	if (!is_numeric($NewLimit) or $NewLimit < 0) {
+		$InputError = 1;
+		prnMsg(__('The credit limit must be a number that is not negative'), 'error');
+	}
+	if ($Outcome == 'raised' and $NewLimit <= $Customer['creditlimit']) {
+		$InputError = 1;
+		prnMsg(__('A review that raises the limit must give a limit higher than the current limit'), 'error');
+	}
+	if ($Outcome == 'reduced' and $NewLimit >= $Customer['creditlimit']) {
+		$InputError = 1;
+		prnMsg(__('A review that reduces the limit must give a limit lower than the current limit'), 'error');
+	}
+	if (in_array($Outcome, array('confirmed', 'watch', 'stop'))) {
+		$NewLimit = $Customer['creditlimit'];
+	}
+	if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $NextReview) or !checkdate((int) substr($NextReview, 5, 2), (int) substr($NextReview, 8, 2), (int) substr($NextReview, 0, 4)) or $NextReview <= date('Y-m-d')) {
+		$InputError = 1;
+		prnMsg(__('The next review date must be a date in the future'), 'error');
+	}
+	if (trim($_POST['Notes']) == '') {
+		$InputError = 1;
+		prnMsg(__('The notes of the review must be entered - they are the reason for the decision'), 'error');
+	}
+	$StatusCode = false;
+	if ($Outcome == 'watch' or $Outcome == 'stop') {
+		$StatusCode = CreditFirstReasonOfType($Outcome == 'stop' ? 1 : 2);
+		if ($StatusCode === false) {
+			$InputError = 1;
+			prnMsg(__('There is no credit status code defined for this outcome - define one in Credit Status Code Maintenance'), 'error');
+		}
+	}
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+		DB_query("INSERT INTO creditreviews (debtorno, reviewdate, userid, outcome, oldlimit, newlimit, notes, nextreviewdate)
+					VALUES ('" . $DebtorNo . "',
+							CURRENT_DATE,
+							'" . $_SESSION['UserID'] . "',
+							'" . $Outcome . "',
+							'" . $Customer['creditlimit'] . "',
+							'" . $NewLimit . "',
+							'" . DB_escape_string($_POST['Notes']) . "',
+							'" . $NextReview . "')",
+				__('The credit review could not be recorded because'), '', true);
+		/* the limit changes in the same transaction as the review that gives the reason for it */
+		if ($NewLimit != $Customer['creditlimit']) {
+			DB_query("UPDATE debtorsmaster SET creditlimit = '" . $NewLimit . "' WHERE debtorno = '" . $DebtorNo . "'", '', '', true);
+			CreditLogEvent($DebtorNo, 'limit', $_POST['Notes'], locale_number_format($Customer['creditlimit'], 0), locale_number_format($NewLimit, 0), $NewLimit, $Customer['currcode']);
+		}

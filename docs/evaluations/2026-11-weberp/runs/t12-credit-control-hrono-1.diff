diff --git a/DunningRun.php b/DunningRun.php
new file mode 100644
index 0000000..fa6ba52
--- /dev/null
+++ b/DunningRun.php
@@ -0,0 +1,246 @@
+<?php
+
+/* The overdue reminder run. Credit control starts the run (normally weekly), sees who would receive which letter, leaves out the
+customers they are already talking to and sends the rest. The eligibility of every customer is worked out again at the moment of
+sending so a customer who has paid in between gets nothing.
+
+A customer moves up one stage at a time, and only while an undisputed invoice is still overdue by the days of the next stage.
+A customer is not sent the same stage twice for the same overdue episode, nor two letters within DunningMinDaysBetween days. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Overdue Reminder Run');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'DunningRun';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$Stages = array();
+$Result = DB_query("SELECT stage, daysoverdue, subject, body FROM dunningstages ORDER BY stage");
+while ($MyRow = DB_fetch_array($Result)) {
+	$Stages[$MyRow['stage']] = $MyRow;
+}
+if (count($Stages) == 0) {
+	prnMsg(__('No reminder letter stages are defined. Define the stages first'), 'error');
+	echo '<div class="centre"><a href="' . $RootPath . '/DunningStages.php">' . __('Reminder Letter Stages') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+$FinalStage = max(array_keys($Stages));
+$MinDays = isset($_SESSION['DunningMinDaysBetween']) ? $_SESSION['DunningMinDaysBetween'] : 7;
+
+/* Works out the letter, if any, a customer is due now. Returns false if none, or a string saying why not when $Reason is true */
+function DunningEvaluate($DebtorNo, $Stages, $MinDays, $Reason = false) {
+	$Result = DB_query("SELECT debtorsmaster.name, debtorsmaster.currcode, currencies.decimalplaces
+						FROM debtorsmaster
+						INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+						WHERE debtorsmaster.debtorno = '" . DB_escape_string($DebtorNo) . "'");
+	if (DB_num_rows($Result) == 0) {
+		return false;
+	}
+	$Letter = DB_fetch_array($Result);
+	$Letter['debtorno'] = $DebtorNo;
+	$Letter['amount'] = 0;
+	$Letter['maxdays'] = 0;
+	$Letter['invoices'] = array();
+	$OldestDue = '';
+	$Result = CreditGetOpenInvoices($DebtorNo);
+	while ($Invoice = DB_fetch_array($Result)) {
+		/* disputed invoices are not chased */
+		if ($Invoice['daysoverdue'] > 0 and $Invoice['disputed'] == 0) {
+			$Letter['amount'] += $Invoice['balance'];
+			$Letter['maxdays'] = max($Letter['maxdays'], $Invoice['daysoverdue']);
+			$Letter['invoices'][] = $Invoice;
+			if ($OldestDue == '' or $Invoice['duedate'] < $OldestDue) {
+				$OldestDue = $Invoice['duedate'];
+			}
+		}
+	}
+	if ($Letter['amount'] < pow(10, -$Letter['decimalplaces'])) {
+		return $Reason ? __('Nothing overdue') : false;
+	}
+	/* the letters sent since the oldest overdue invoice fell due belong to this overdue episode */
+	$Result = DB_query("SELECT stage, senddate
+						FROM dunningletters
+						WHERE debtorno = '" . DB_escape_string($DebtorNo) . "'
+							AND DATE(senddate) >= '" . $OldestDue . "'
+						ORDER BY id DESC
+						LIMIT 1");
+	$Letter['laststage'] = 0;
+	$Letter['lastdate'] = '';
+	if (DB_num_rows($Result) == 1) {
+		$MyRow = DB_fetch_array($Result);
+		$Letter['laststage'] = $MyRow['stage'];
+		$Letter['lastdate'] = $MyRow['senddate'];
+	}
+	$Letter['stage'] = 0;
+	foreach ($Stages as $StageNo => $Stage) {
+		if ($StageNo > $Letter['laststage']) {
+			$Letter['stage'] = $StageNo;
+			break;
+		}
+	}
+	if ($Letter['stage'] == 0) {
+		return $Reason ? __('Already sent the final stage') : false;
+	}
+	if ($Letter['maxdays'] < $Stages[$Letter['stage']]['daysoverdue']) {
+		return $Reason ? __('Not yet overdue enough for stage') . ' ' . $Letter['stage'] : false;
+	}
+	if ($Letter['lastdate'] != '' and (time() - strtotime($Letter['lastdate'])) < $MinDays * 86400) {
+		return $Reason ? __('A letter was sent less than') . ' ' . $MinDays . ' ' . __('days ago') : false;
+	}
+	$Letter['emails'] = CreditContactEmails($DebtorNo);
+	return $Letter;
+}
+
+function DunningInvoiceText($Letter) {
+	$Text = '';
+	foreach ($Letter['invoices'] as $Invoice) {
+		$Text .= ($Invoice['type'] == 10 ? __('Invoice') : __('Interest / fee')) . ' ' . $Invoice['transno'] . ' ' . __('dated') . ' ' . ConvertSQLDate($Invoice['trandate'])
+			. ', ' . __('due') . ' ' . ConvertSQLDate($Invoice['duedate']) . ', ' . $Letter['currcode'] . ' '
+			. locale_number_format($Invoice['balance'], $Letter['decimalplaces']) . ' (' . $Invoice['daysoverdue'] . ' ' . __('days overdue') . ")\n";
+	}
+	return $Text;
+}
+
+function DunningLetterText($Template, $Letter) {
+	$Search = array('{name}', '{debtorno}', '{currency}', '{amount}', '{invoices}', '{company}', '{date}');
+	$Replace = array($Letter['name'],
+					$Letter['debtorno'],
+					$Letter['currcode'],
+					locale_number_format($Letter['amount'], $Letter['decimalplaces']),
+					DunningInvoiceText($Letter),
+					$_SESSION['CompanyRecord']['coyname'],
+					date($_SESSION['DefaultDateFormat']));
+	return str_replace($Search, $Replace, $Template);
+}
+
+if (isset($_POST['SendLetters']) and isset($_POST['Send'])) {
+
+	$ToPost = array();
+	$Sent = 0;
+	foreach ($_POST['Send'] as $DebtorNo => $Ignore) {
+		$Letter = DunningEvaluate($DebtorNo, $Stages, $MinDays);
+		if ($Letter === false) {
+			prnMsg($DebtorNo . ': ' . __('no letter is due any more (it may have been paid or a letter has just been sent), so none was sent'), 'info');
+			continue;
+		}
+		$Subject = DunningLetterText($Stages[$Letter['stage']]['subject'], $Letter);
+		$Body = DunningLetterText($Stages[$Letter['stage']]['body'], $Letter);
+		$Emailed = 0;
+		$SentTo = '';
+		if (count($Letter['emails']) > 0) {
+			$EmailResult = SendEmailFromWebERP($_SESSION['CompanyRecord']['email'], array_fill_keys($Letter['emails'], ''), $Subject, $Body, array(), true);
+			if ($EmailResult !== true) {
+				prnMsg($DebtorNo . ': ' . __('the email could not be sent so the reminder has not been recorded') . ' - ' . (is_string($EmailResult) ? $EmailResult : ''), 'error');
+				continue;
+			}
+			$Emailed = 1;
+			$SentTo = implode(', ', $Letter['emails']);
+		}
+		$InvoiceList = array();
+		foreach ($Letter['invoices'] as $Invoice) {
+			$InvoiceList[] = $Invoice['transno'];
+		}
+		DB_Txn_Begin();
+		DB_query("INSERT INTO dunningletters (debtorno, stage, senddate, userid, currcode, amount, invoices, sentto, emailed)
+					VALUES ('" . DB_escape_string($DebtorNo) . "',
+							'" . $Letter['stage'] . "',
+							NOW(),
+							'" . $_SESSION['UserID'] . "',
+							'" . $Letter['currcode'] . "',
+							'" . $Letter['amount'] . "',
+							'" . DB_escape_string(implode(', ', $InvoiceList)) . "',
+							'" . DB_escape_string($SentTo) . "',
+							'" . $Emailed . "')",
+				__('The reminder could not be recorded because'), '', true);
+		CreditLogEvent($DebtorNo, 'reminder', $Emailed ? __('Emailed to') . ' ' . $SentTo : __('To be posted'), '', __('Stage') . ' ' . $Letter['stage'] . ' - ' . __('invoices') . ' ' . implode(', ', $InvoiceList), $Letter['amount'], $Letter['currcode']);
+		/* after the final letter the customer is flagged for credit control, or put on stop if Finance has chosen that */
+		if ($Letter['stage'] == $FinalStage and isset($_SESSION['DunningAutoStop']) and $_SESSION['DunningAutoStop'] == 1) {
+			$StopCode = CreditFirstReasonOfType(1);
+			if ($StopCode !== false) {
+				CreditSetStatus($DebtorNo, $StopCode, __('Final reminder letter sent'));
+			}
+		}
+		DB_Txn_Commit();
+		$Sent++;
+		if ($Emailed == 0) {
+			$ToPost[] = array('letter' => $Letter, 'subject' => $Subject, 'body' => $Body);
+		}
+	}
+	prnMsg($Sent . ' ' . __('reminder letters have been recorded'), 'success');
+
+	if (count($ToPost) > 0) {
+		echo '<h3>' . __('Customers with no email address - letters to post') . '</h3>';
+		foreach ($ToPost as $Post) {
+			echo '<div style="page-break-after: always; border-bottom: 1px solid #999; margin-bottom: 1em;"><b>' . htmlspecialchars($Post['letter']['debtorno'] . ' - ' . $Post['letter']['name'], ENT_QUOTES, 'UTF-8') . '</b><br />
+				<b>' . htmlspecialchars($Post['subject'], ENT_QUOTES, 'UTF-8') . '</b>
+				<pre>' . htmlspecialchars($Post['body'], ENT_QUOTES, 'UTF-8') . '</pre></div>';
+		}
+	}
+	echo '<div class="centre"><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">' . __('Back to the reminder run') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* The preview: who would get which letter */
+$Candidates = DB_query("SELECT DISTINCT debtortrans.debtorno
+						FROM debtortrans
+						INNER JOIN debtorsmaster ON debtortrans.debtorno = debtorsmaster.debtorno
+						INNER JOIN paymentterms ON debtorsmaster.paymentterms = paymentterms.termsindicator
+						WHERE debtortrans.type IN (10, " . CREDIT_TYPE_CHARGE . ")
+							AND debtortrans.settled = 0
+							AND debtortrans.balance > 0
+							AND debtortrans.disputed = 0
+							AND " . CreditDueDateSQL() . " < CURRENT_DATE
+						ORDER BY debtortrans.debtorno");
+
+$Due = array();
+$Waiting = array();
+while ($MyRow = DB_fetch_array($Candidates)) {
+	$Letter = DunningEvaluate($MyRow['debtorno'], $Stages, $MinDays);
+	if ($Letter !== false) {
+		$Due[] = $Letter;
+	} else {
+		$Waiting[$MyRow['debtorno']] = DunningEvaluate($MyRow['debtorno'], $Stages, $MinDays, true);
+	}
+}
+
+if (count($Due) == 0) {
+	prnMsg(__('No customer is due a reminder letter at the moment'), 'info');
+} else {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<p>' . __('Untick the customers to leave out of this run, for example where a payment has been promised, then send the letters.') . '</p>
+		<table class="selection">
+		<tr><th>' . __('Send') . '</th><th>' . __('Customer') . '</th><th>' . __('Stage') . '</th><th>' . __('Days Overdue') . '</th><th>' . __('Overdue Amount') . '</th><th>' . __('Last Letter') . '</th><th>' . __('Delivery') . '</th></tr>';
+	foreach ($Due as $Letter) {
+		echo '<tr class="striped_row">
+				<td><input type="checkbox" name="Send[' . htmlspecialchars($Letter['debtorno'], ENT_QUOTES, 'UTF-8') . ']" checked="checked" /></td>
+				<td><a href="' . $RootPath . '/CustomerCredit.php?DebtorNo=' . urlencode($Letter['debtorno']) . '">' . htmlspecialchars($Letter['debtorno'] . ' - ' . $Letter['name'], ENT_QUOTES, 'UTF-8') . '</a></td>
+				<td class="number">' . $Letter['stage'] . ($Letter['stage'] == $FinalStage ? ' (' . __('final') . ')' : '') . '</td>
+				<td class="number">' . $Letter['maxdays'] . '</td>
+				<td class="number">' . $Letter['currcode'] . ' ' . locale_number_format($Letter['amount'], $Letter['decimalplaces']) . '</td>
+				<td>' . ($Letter['lastdate'] == '' ? __('None') : __('Stage') . ' ' . $Letter['laststage'] . ' ' . $Letter['lastdate']) . '</td>
+				<td>' . (count($Letter['emails']) > 0 ? htmlspecialchars(implode(', ', $Letter['emails']), ENT_QUOTES, 'UTF-8') : '<b>' . __('No email address - letter to post') . '</b>') . '</td>
+			</tr>';
+	}
+	echo '</table><br />
+		<div class="centre"><input type="submit" name="SendLetters" value="' . __('Send the Letters') . '" /></div>
+		</form><br />';
+}
+
+if (count($Waiting) > 0) {
+	echo '<table class="selection"><caption>' . __('Overdue customers that get no letter in this run') . '</caption>
+		<tr><th>' . __('Customer') . '</th><th>' . __('Reason') . '</th></tr>';
+	foreach ($Waiting as $DebtorNo => $Why) {
+		echo '<tr class="striped_row"><td><a href="' . $RootPath . '/CustomerCredit.php?DebtorNo=' . urlencode($DebtorNo) . '">' . htmlspecialchars($DebtorNo, ENT_QUOTES, 'UTF-8') . '</a></td><td>' . $Why . '</td></tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/DunningStages.php b/DunningStages.php
new file mode 100644
index 0000000..8ccb978
--- /dev/null
+++ b/DunningStages.php
@@ -0,0 +1,131 @@
+<?php
+
+/* Finance maintains the stages of the overdue reminder letters: how many stages there are, how many days overdue trigger each stage and
+the subject and wording of each letter. The wording may use {name}, {debtorno}, {currency}, {amount}, {invoices}, {company} and {date} */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Reminder Letter Stages');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'DunningStages';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/maintenance.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+if (isset($_GET['SelectedStage'])) {
+	$SelectedStage = (int) $_GET['SelectedStage'];
+} elseif (isset($_POST['SelectedStage'])) {
+	$SelectedStage = (int) $_POST['SelectedStage'];
+}
+
+if (isset($_POST['submit'])) {
+	$InputError = 0;
+	$Stage = (int) $_POST['Stage'];
+	$Days = (int) $_POST['DaysOverdue'];
+	if ($Stage < 1 or $Stage > 9) {
+		$InputError = 1;
+		prnMsg(__('The stage number must be between 1 and 9'), 'error');
+	}
+	if ($Days < 1) {
+		$InputError = 1;
+		prnMsg(__('The days overdue must be at least 1'), 'error');
+	}
+	if (trim($_POST['Subject']) == '' or trim($_POST['Body']) == '') {
+		$InputError = 1;
+		prnMsg(__('The subject and the wording of the letter must be entered'), 'error');
+	}
+	if (mb_strlen($_POST['Subject']) > 100) {
+		$InputError = 1;
+		prnMsg(__('The subject must be 100 characters or less'), 'error');
+	}
+	/* stages escalate, so a later stage must be triggered by more days overdue than an earlier one */
+	$Result = DB_query("SELECT stage, daysoverdue FROM dunningstages WHERE stage <> '" . $Stage . "'");
+	while ($MyRow = DB_fetch_array($Result)) {
+		if (($MyRow['stage'] < $Stage and $MyRow['daysoverdue'] >= $Days) or ($MyRow['stage'] > $Stage and $MyRow['daysoverdue'] <= $Days)) {
+			$InputError = 1;
+			prnMsg(__('A later stage must be triggered by more days overdue than an earlier stage') . ' (' . __('stage') . ' ' . $MyRow['stage'] . ': ' . $MyRow['daysoverdue'] . ' ' . __('days') . ')', 'error');
+		}
+	}
+	if ($InputError == 0) {
+		DB_query("INSERT INTO dunningstages (stage, daysoverdue, subject, body)
+					VALUES ('" . $Stage . "',
+							'" . $Days . "',
+							'" . DB_escape_string($_POST['Subject']) . "',
+							'" . DB_escape_string($_POST['Body']) . "')
+					ON DUPLICATE KEY UPDATE daysoverdue = '" . $Days . "',
+											subject = '" . DB_escape_string($_POST['Subject']) . "',
+											body = '" . DB_escape_string($_POST['Body']) . "'",
+				__('The reminder letter stage could not be saved because'));
+		prnMsg(__('The reminder letter stage has been saved'), 'success');
+		unset($SelectedStage);
+		unset($_POST['Stage']);
+		unset($_POST['DaysOverdue']);
+		unset($_POST['Subject']);
+		unset($_POST['Body']);
+	}
+} elseif (isset($_GET['delete']) and isset($SelectedStage)) {
+	/* the stages must stay in sequence from 1, so only the last stage can be removed */
+	$Result = DB_query("SELECT MAX(stage) FROM dunningstages");
+	$MyRow = DB_fetch_row($Result);
+	if ($MyRow[0] != $SelectedStage) {
+		prnMsg(__('Only the last stage can be deleted'), 'warn');
+	} else {
+		DB_query("DELETE FROM dunningstages WHERE stage = '" . $SelectedStage . "'");
+		prnMsg(__('The reminder letter stage has been deleted'), 'success');
+	}
+	unset($SelectedStage);
+}
+
+if (!isset($SelectedStage)) {
+	echo '<table class="selection"><tr><th>' . __('Stage') . '</th><th>' . __('Days Overdue') . '</th><th>' . __('Subject') . '</th><th colspan="2"></th></tr>';
+	$Result = DB_query("SELECT stage, daysoverdue, subject FROM dunningstages ORDER BY stage");
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td class="number">' . $MyRow['stage'] . '</td>
+				<td class="number">' . $MyRow['daysoverdue'] . '</td>
+				<td>' . htmlspecialchars($MyRow['subject'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '?SelectedStage=' . $MyRow['stage'] . '">' . __('Edit') . '</a></td>
+				<td><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '?SelectedStage=' . $MyRow['stage'] . '&amp;delete=1" onclick="return confirm(\'' . __('Are you sure you wish to delete this stage?') . '\');">' . __('Delete') . '</a></td>
+			</tr>';
+	}

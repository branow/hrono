+/*
+ *  Returns the current exchange rate of every currency, keyed by currency code.
+ *  Call before updating the rates so RevalueForeignBankAccounts() can see what changed.
+ */
+function GetCurrencyRatesSnapshot() {
+	$Rates = array();
+	$Result = DB_query("SELECT currabrev, rate FROM currencies");
+	while ($Row = DB_fetch_array($Result)) {
+		$Rates[$Row['currabrev']] = $Row['rate'];
+	}
+	return $Rates;
+}
+
+/*
+ *  Posts a general ledger journal (type 36) for every foreign currency bank account so that its
+ *  balance in the bank's currency is unchanged by a change of exchange rate, the same
+ *  result as "Calculate and Post Exchange Difference" in the bank reconciliation.
+ *  @param array $OldRates Rates before the update, from GetCurrencyRatesSnapshot()
+ */
+function RevalueForeignBankAccounts($OldRates) {
+	$DefaultCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+	$ExchangeDiffAct = $_SESSION['CompanyRecord']['exchangediffact'];
+	$DecimalPlaces = $_SESSION['CompanyRecord']['decimalplaces'];
+	$PostingDate = Date($_SESSION['DefaultDateFormat']);
+	$PeriodNo = GetPeriod($PostingDate);
+
+	$SQL = "SELECT bankaccounts.accountcode,
+					bankaccounts.bankaccountname,
+					bankaccounts.currcode,
+					currencies.rate
+			FROM bankaccounts
+			INNER JOIN currencies
+				ON bankaccounts.currcode = currencies.currabrev
+			WHERE bankaccounts.currcode <> '" . $DefaultCurrency . "'";
+	$AccountsResult = DB_query($SQL);
+
+	while ($Account = DB_fetch_array($AccountsResult)) {
+		$NewRate = $Account['rate'];
+		$OldRate = $OldRates[$Account['currcode']] ?? 0;
+		if (!is_numeric($NewRate) or $NewRate <= 0 or !is_numeric($OldRate) or $OldRate <= 0 or $NewRate == $OldRate) {
+			continue;
+		}
+
+		$BalanceResult = DB_query("SELECT SUM(amount) AS total
+									FROM gltotals
+									WHERE account = '" . $Account['accountcode'] . "'
+										AND period <= " . $PeriodNo);
+		$BalanceRow = DB_fetch_array($BalanceResult);
+		$Balance = $BalanceRow['total'] ?? 0;
+
+		/* Rates are units of the bank currency per unit of functional currency. Keep the
+		bank currency balance (Balance * OldRate) constant at the new rate. */
+		$Adjustment = round($Balance * ($OldRate / $NewRate - 1), $DecimalPlaces);
+		if ($Adjustment == 0) {
+			continue;
+		}
+
+		DB_Txn_Begin();
+		DB_query("SELECT typeno FROM systypes WHERE typeid = 36 FOR UPDATE");
+		DB_query("UPDATE systypes SET typeno = typeno + 1 WHERE typeid = 36");
+		$TransNoResult = DB_query("SELECT typeno FROM systypes WHERE typeid = 36");
+		$TransNoRow = DB_fetch_row($TransNoResult);
+		$TransNo = $TransNoRow[0];
+
+		$Narrative = DB_escape_string(mb_substr($Account['bankaccountname'] . ' ' . __('revaluation on') . ' ' . $PostingDate, 0, 200));
+		$InsertPrefix = "INSERT INTO gltrans (type, typeno, trandate, periodno, account, narrative, amount)
+					VALUES (36, '" . $TransNo . "', '" . FormatDateForSQL($PostingDate) . "', '" . $PeriodNo . "', ";
+		DB_query($InsertPrefix . "'" . $ExchangeDiffAct . "', '" . $Narrative . "', '" . -$Adjustment . "')", '', '', true);
+		DB_query($InsertPrefix . "'" . $Account['accountcode'] . "', '" . $Narrative . "', '" . $Adjustment . "')", '', '', true);
+		DB_Txn_Commit();
+	}
+}

diff --git a/CreditControlWriteOffs.php b/CreditControlWriteOffs.php
new file mode 100644
index 0000000..6394be3
--- /dev/null
+++ b/CreditControlWriteOffs.php
@@ -0,0 +1,242 @@
+<?php
+
+/* Bad debt write offs.
+Credit control writes off all or part of a customer's balance with a reason. Write offs up to the limit Finance set in the
+credit control settings post straight away; larger ones wait for the Finance Director, who cannot approve their own request.
+A write off credits the customer's account (type 53, allocated to the oldest debts), debits the bad debt account, and posts any
+difference on exchange. Unless credit control decides otherwise the customer is put on stop when the write off is posted.
+The report at the bottom lists write offs over a period. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Bad Debt Write Offs');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlWriteOffs';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_delete.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Settings = CreditControlSettings();
+$Limit = (float) $Settings['CreditControlWriteOffLimit'];
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$HomeDP = $_SESSION['CompanyRecord']['decimalplaces'];
+$SelfURL = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+
+if ($Settings['CreditControlBadDebtAct'] == '') {
+	prnMsg(__('The bad debt GL account has not been set in the Credit Control Settings. Write offs cannot be posted until it is.'), 'error');
+}
+
+/* ---- A new write off ---- */
+if (isset($_POST['RequestWriteOff'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+	$Amount = filter_number_format($_POST['Amount']);
+	$Result = DB_query("SELECT debtorsmaster.currcode, currencies.rate, currencies.decimalplaces
+						FROM debtorsmaster
+						INNER JOIN currencies
+							ON currencies.currabrev=debtorsmaster.currcode
+						WHERE debtorsmaster.debtorno='" . $DebtorNo . "'");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('The customer could not be found'), 'error');
+	} elseif (!is_numeric($Amount) or $Amount <= 0) {
+		prnMsg(__('The amount to write off must be a number greater than zero'), 'error');
+	} elseif (trim($_POST['Reason']) == '') {
+		prnMsg(__('A reason must be given for a write off'), 'error');
+	} elseif ($Settings['CreditControlBadDebtAct'] == '') {
+		prnMsg(__('The bad debt GL account has not been set in the Credit Control Settings'), 'error');
+	} else {
+		$Customer = DB_fetch_array($Result);
+		$Balance = CreditControlBalance($DebtorNo);
+		// pending write offs count against the balance too, or two requests could write off the same debt
+		$PendingResult = DB_query("SELECT SUM(amount) FROM writeoffs WHERE debtorno='" . $DebtorNo . "' AND status='P'");
+		$PendingRow = DB_fetch_row($PendingResult);
+		$Amount = round($Amount, $Customer['decimalplaces']);
+		if ($Amount > $Balance - (float) $PendingRow[0] + 0.005) {
+			prnMsg(__('The amount is more than the customer balance') . ' (' . locale_number_format($Balance - (float) $PendingRow[0], $Customer['decimalplaces']) . ' ' . $Customer['currcode'] . ' ' . __('after write offs awaiting approval') . ')', 'error');
+		} else {
+			$Local = round($Amount / $Customer['rate'], $HomeDP);
+			DB_Txn_Begin();
+			DB_query("INSERT INTO writeoffs (debtorno, currcode, amount, localamount, reason, requestedby, requestdate, status, putonstop)
+						VALUES ('" . $DebtorNo . "', '" . $Customer['currcode'] . "', '" . $Amount . "', '" . $Local . "', '" . $_POST['Reason'] . "',
+								'" . $_SESSION['UserID'] . "', NOW(), 'P', '" . (isset($_POST['PutOnStop']) ? 1 : 0) . "')");
+			$WriteOffID = DB_Last_Insert_ID('writeoffs', 'id');
+			if ($Local <= $Limit) {
+				$Problem = CreditControlPostWriteOff($WriteOffID, $_SESSION['UserID'], __('Within the limit for credit control'));
+				if ($Problem == '') {
+					DB_Txn_Commit();
+					prnMsg(__('The write off has been posted'), 'success');
+				} else {
+					DB_Txn_Rollback();
+					prnMsg($Problem, 'error');
+				}
+			} else {
+				CreditControlLog($DebtorNo, 'WRITEOFF', __('Write off requested - waiting for Finance Director approval') . ': ' . $_POST['Reason'], $Amount, $Customer['currcode'], 'W' . $WriteOffID);
+				DB_Txn_Commit();
+				prnMsg(__('The write off is above') . ' ' . $HomeCurrency . ' ' . locale_number_format($Limit, $HomeDP) . ' ' . __('so it has been sent to the Finance Director for approval. Nothing has been posted yet'), 'info');
+			}
+		}
+	}
+}
+
+/* ---- The Finance Director decides ---- */
+if ((isset($_POST['Approve']) or isset($_POST['Reject'])) and CreditControlIsFinanceDirector()) {
+	$IDs = isset($_POST['Approve']) ? array_keys($_POST['Approve']) : array_keys($_POST['Reject']);
+	foreach ($IDs as $WriteOffID) {
+		$WriteOffID = (int) $WriteOffID;
+		$Note = isset($_POST['DecisionNote'][$WriteOffID]) ? $_POST['DecisionNote'][$WriteOffID] : '';
+		$Result = DB_query("SELECT * FROM writeoffs WHERE id='" . $WriteOffID . "' AND status='P'");
+		if (DB_num_rows($Result) == 0) {
+			continue;
+		}
+		$WriteOff = DB_fetch_array($Result);
+		if ($WriteOff['requestedby'] == $_SESSION['UserID']) {
+			prnMsg(__('A write off cannot be approved by the person who requested it'), 'error');
+			continue;
+		}
+		DB_Txn_Begin();
+		if (isset($_POST['Approve'])) {
+			$Problem = CreditControlPostWriteOff($WriteOffID, $_SESSION['UserID'], $Note);
+			if ($Problem == '') {
+				DB_Txn_Commit();
+				prnMsg(__('The write off has been approved and posted'), 'success');
+			} else {
+				DB_Txn_Rollback();
+				prnMsg($Problem, 'error');
+			}
+		} else {
+			DB_query("UPDATE writeoffs SET status='R', approvedby='" . $_SESSION['UserID'] . "', approveddate=NOW(), decisionnote='" . $Note . "' WHERE id='" . $WriteOffID . "'");
+			CreditControlLog($WriteOff['debtorno'], 'WRITEOFF', __('Write off rejected by the Finance Director') . ': ' . $Note, $WriteOff['amount'], $WriteOff['currcode'], 'W' . $WriteOffID);
+			DB_Txn_Commit();
+			prnMsg(__('The write off has been rejected'), 'success');
+		}
+	}
+}
+
+/* ---- Request form ---- */
+$DebtorNo = '';
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+}
+echo '<form method="post" action="' . $SelfURL . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Write off a bad debt') . '</legend>
+		<field>
+			<label for="DebtorNo">' . __('Customer code') . ':</label>
+			<input type="text" name="DebtorNo" size="10" maxlength="10" value="' . $DebtorNo . '" required="required" />';
+if ($DebtorNo != '') {
+	$Result = DB_query("SELECT name, currcode FROM debtorsmaster WHERE debtorno='" . $DebtorNo . "'");
+	if (DB_num_rows($Result) == 1) {
+		$Customer = DB_fetch_array($Result);
+		echo '<fieldhelp>' . CreditControlHTML($Customer['name']) . ' - ' . __('balance') . ' ' . $Customer['currcode'] . ' ' . locale_number_format(CreditControlBalance($DebtorNo), 2) . '</fieldhelp>';
+	}
+}
+echo '</field>
+		<field>
+			<label for="Amount">' . __('Amount to write off') . ' (' . __('customer currency') . '):</label>
+			<input type="text" class="number" name="Amount" size="14" maxlength="14" required="required" />
+			<fieldhelp>' . __('Write offs above') . ' ' . $HomeCurrency . ' ' . locale_number_format($Limit, $HomeDP) . ' ' . __('need the Finance Director to approve them') . '</fieldhelp>
+		</field>
+		<field>
+			<label for="Reason">' . __('Reason') . ':</label>
+			<input type="text" name="Reason" size="60" maxlength="200" required="required" />
+		</field>
+		<field>
+			<label for="PutOnStop">' . __('Put the customer on stop') . ':</label>
+			<input type="checkbox" name="PutOnStop" checked="checked" />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="RequestWriteOff" value="' . __('Write Off') . '" /></div>
+	</form>';
+
+/* ---- Waiting for approval ---- */
+$Result = DB_query("SELECT writeoffs.*, debtorsmaster.name, currencies.decimalplaces
+					FROM writeoffs
+					INNER JOIN debtorsmaster
+						ON debtorsmaster.debtorno=writeoffs.debtorno
+					INNER JOIN currencies
+						ON currencies.currabrev=writeoffs.currcode
+					WHERE writeoffs.status='P'
+					ORDER BY writeoffs.requestdate");
+if (DB_num_rows($Result) > 0) {
+	echo '<form method="post" action="' . $SelfURL . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<table class="selection">
+		<caption>' . __('Waiting for Finance Director approval') . '</caption>
+		<tr><th>' . __('Requested') . '</th><th>' . __('By') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . $HomeCurrency . '</th><th>' . __('Reason') . '</th>' . (CreditControlIsFinanceDirector() ? '<th>' . __('Note') . '</th><th colspan="2"></th>' : '') . '</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . ConvertSQLDate(substr($MyRow['requestdate'], 0, 10)) . '</td>
+				<td>' . $MyRow['requestedby'] . '</td>
+				<td>' . $MyRow['debtorno'] . ' ' . CreditControlHTML($MyRow['name']) . '</td>
+				<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], $MyRow['decimalplaces']) . '</td>
+				<td class="number">' . locale_number_format($MyRow['localamount'], $HomeDP) . '</td>
+				<td>' . CreditControlHTML($MyRow['reason']) . '</td>';
+		if (CreditControlIsFinanceDirector()) {
+			echo '<td><input type="text" name="DecisionNote[' . $MyRow['id'] . ']" size="20" maxlength="200" /></td>
+				<td><input type="submit" name="Approve[' . $MyRow['id'] . ']" value="' . __('Approve') . '" /></td>
+				<td><input type="submit" name="Reject[' . $MyRow['id'] . ']" value="' . __('Reject') . '" /></td>';
+		}
+		echo '</tr>';
+	}
+	echo '</table></form>';
+}
+
+/* ---- Write offs over a period ---- */
+$From = (isset($_POST['FromDate']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['FromDate'])) ? $_POST['FromDate'] : date('Y-m-d', strtotime('-12 months'));
+$To = (isset($_POST['ToDate']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['ToDate'])) ? $_POST['ToDate'] : date('Y-m-d');
+echo '<form method="post" action="' . $SelfURL . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Write off report') . '</legend>
+		<field>
+			<label for="FromDate">' . __('From') . ':</label>
+			<input type="date" name="FromDate" value="' . $From . '" />
+		</field>
+		<field>
+			<label for="ToDate">' . __('To') . ':</label>
+			<input type="date" name="ToDate" value="' . $To . '" />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Report" value="' . __('Show') . '" /></div>
+	</form>';
+
+$Result = DB_query("SELECT writeoffs.*, debtorsmaster.name, currencies.decimalplaces
+					FROM writeoffs
+					INNER JOIN debtorsmaster
+						ON debtorsmaster.debtorno=writeoffs.debtorno
+					INNER JOIN currencies
+						ON currencies.currabrev=writeoffs.currcode
+					WHERE DATE(writeoffs.requestdate) >= '" . $From . "'
+						AND DATE(writeoffs.requestdate) <= '" . $To . "'
+					ORDER BY writeoffs.requestdate");
+$Total = 0;
+echo '<table class="selection">
+	<caption>' . __('Write offs from') . ' ' . ConvertSQLDate($From) . ' ' . __('to') . ' ' . ConvertSQLDate($To) . '</caption>
+	<tr><th>' . __('Date') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . $HomeCurrency . '</th><th>' . __('Reason') . '</th><th>' . __('Requested by') . '</th><th>' . __('Approved by') . '</th><th>' . __('Status') . '</th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	$StatusText = ($MyRow['status'] == 'A') ? __('Posted') . ' (' . $MyRow['transno'] . ')' : (($MyRow['status'] == 'R') ? __('Rejected') : __('Waiting for approval'));
+	if ($MyRow['status'] == 'A') {
+		$Total += $MyRow['localamount'];
+	}
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate(substr($MyRow['requestdate'], 0, 10)) . '</td>
+			<td>' . $MyRow['debtorno'] . ' ' . CreditControlHTML($MyRow['name']) . '</td>
+			<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], $MyRow['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($MyRow['localamount'], $HomeDP) . '</td>
+			<td>' . CreditControlHTML($MyRow['reason']) . '</td>
+			<td>' . $MyRow['requestedby'] . '</td>
+			<td>' . $MyRow['approvedby'] . '</td>
+			<td>' . $StatusText . '</td>
+		</tr>';
+}
+echo '<tr class="total_row"><td colspan="3">' . __('Total posted') . ' (' . $HomeCurrency . ')</td><td class="number">' . locale_number_format($Total, $HomeDP) . '</td><td colspan="4"></td></tr>
+	</table>';
+
+include('includes/footer.php');

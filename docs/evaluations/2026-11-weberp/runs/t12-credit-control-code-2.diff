diff --git a/CreditControlCharges.php b/CreditControlCharges.php
new file mode 100644
index 0000000..a313f75
--- /dev/null
+++ b/CreditControlCharges.php
@@ -0,0 +1,260 @@
+<?php
+
+/* Month end interest and late fees.
+Credit control picks a month that has ended, sees who would be charged what, takes out any they do not want charged, and
+confirms. Each charge is raised in the customer's own currency as a separate, clearly described debtor transaction (type 51
+interest, type 52 fee) which posts to the income accounts Finance chose in the credit control settings. A customer is
+charged once a month for each kind of charge. Charges can be waived with a reason, which reverses them (type 54) in the ledger too.
+
+Interest is the annual rate / 12 on the overdue balance - the balance that is more than the grace days past due and not in dispute.
+Interest is not charged on interest or fees. A fee is a flat amount (held in the home currency, converted to the customer's currency)
+charged once a month to a customer with such a balance. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Month End Interest and Late Fees');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlCharges';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_add.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Settings = CreditControlSettings();
+$Rate = (float) $Settings['CreditControlInterestRate'];
+$FeeHome = (float) $Settings['CreditControlLateFee'];
+$GraceDays = (int) $Settings['CreditControlGraceDays'];
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$HomeDP = $_SESSION['CompanyRecord']['decimalplaces'];
+
+if ($Rate <= 0 and $FeeHome <= 0) {
+	prnMsg(__('Neither an interest rate nor a late fee has been set in the Credit Control Settings, so there is nothing to charge'), 'warn');
+}
+if ($Rate > 0 and $Settings['CreditControlInterestAct'] == '') {
+	prnMsg(__('The interest income GL account has not been set in the Credit Control Settings'), 'error');
+	$Rate = 0;
+}
+if ($FeeHome > 0 and $Settings['CreditControlFeeAct'] == '') {
+	prnMsg(__('The late fee income GL account has not been set in the Credit Control Settings'), 'error');
+	$FeeHome = 0;
+}
+
+/* the month to charge: one that has ended, last twelve offered, default the one before this */
+$Months = array();
+for ($i = 1; $i <= 12; $i++) {
+	$Months[] = date('Y-m', strtotime('first day of -' . $i . ' month'));
+}
+$Month = (isset($_POST['Month']) and in_array($_POST['Month'], $Months)) ? $_POST['Month'] : $Months[0];
+$MonthEnd = date('Y-m-t', strtotime($Month . '-01'));
+
+/* What would be charged for the month: array of rows per customer with interest and fee */
+function CreditControlChargeCandidates($Month, $MonthEnd, $Rate, $FeeHome, $GraceDays) {
+	$Rows = array();
+	$SQL = "SELECT debtortrans.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					currencies.rate,
+					currencies.decimalplaces,
+					IFNULL(debtorcredit.exemptinterest, 0) AS exemptinterest,
+					IFNULL(debtorcredit.exemptfees, 0) AS exemptfees
+			FROM debtortrans
+			INNER JOIN debtorsmaster
+				ON debtortrans.debtorno=debtorsmaster.debtorno
+			INNER JOIN currencies
+				ON debtorsmaster.currcode=currencies.currabrev
+			LEFT JOIN debtorcredit
+				ON debtorcredit.debtorno=debtorsmaster.debtorno
+			GROUP BY debtortrans.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					currencies.rate,
+					currencies.decimalplaces,
+					debtorcredit.exemptinterest,
+					debtorcredit.exemptfees
+			HAVING SUM(debtortrans.balance) > 0.005
+			ORDER BY debtorsmaster.name";
+	$Result = DB_query($SQL);
+	while ($Customer = DB_fetch_array($Result)) {
+		$Base = 0;
+		foreach (CreditControlOverdueItems($Customer['debtorno'], $MonthEnd, false) as $Item) {
+			if ($Item['daysoverdue'] > $GraceDays) {
+				$Base += $Item['balance'];
+			}
+		}
+		$Base = min($Base, CreditControlBalance($Customer['debtorno']));
+		if ($Base <= 0.005) {
+			continue;
+		}
+		$Already = array();
+		$AlreadyResult = DB_query("SELECT chargetype FROM latecharges WHERE debtorno='" . $Customer['debtorno'] . "' AND chargemonth='" . $Month . "'");
+		while ($AlreadyRow = DB_fetch_row($AlreadyResult)) {
+			$Already[$AlreadyRow[0]] = true;
+		}
+		$Customer['base'] = $Base;
+		$Customer['interest'] = 0;
+		$Customer['fee'] = 0;
+		if ($Rate > 0 and !$Customer['exemptinterest'] and !isset($Already['I'])) {
+			$Customer['interest'] = round($Base * $Rate / 100 / 12, $Customer['decimalplaces']);
+		}
+		if ($FeeHome > 0 and !$Customer['exemptfees'] and !isset($Already['F'])) {
+			$Customer['fee'] = round($FeeHome * $Customer['rate'], $Customer['decimalplaces']);
+		}
+		if ($Customer['interest'] > 0 or $Customer['fee'] > 0) {
+			$Rows[] = $Customer;
+		}
+	}
+	return $Rows;
+}
+
+/* ---- Waive a charge ---- */
+if (isset($_POST['Waive']) and is_array($_POST['Waive'])) {
+	foreach ($_POST['Waive'] as $ChargeID => $Label) {
+		$ChargeID = (int) $ChargeID;
+		$Reason = isset($_POST['WaiveReason'][$ChargeID]) ? trim($_POST['WaiveReason'][$ChargeID]) : '';
+		if ($Reason == '') {
+			prnMsg(__('A reason must be given for waiving a charge'), 'error');
+			continue;
+		}
+		DB_Txn_Begin();
+		$Problem = CreditControlWaiveCharge($ChargeID, $Reason);
+		if ($Problem == '') {
+			DB_Txn_Commit();
+			prnMsg(__('The charge has been waived and the waiver posted to the ledger'), 'success');
+		} else {
+			DB_Txn_Rollback();
+			prnMsg($Problem, 'error');
+		}
+	}
+}
+
+/* ---- Post the confirmed charges ---- */
+if (isset($_POST['PostCharges'])) {
+	$Include = (isset($_POST['Include']) and is_array($_POST['Include'])) ? $_POST['Include'] : array();
+	$Posted = 0;
+	foreach (CreditControlChargeCandidates($Month, $MonthEnd, $Rate, $FeeHome, $GraceDays) as $Customer) {
+		if (!isset($Include[$Customer['debtorno']])) {
+			continue;
+		}
+		DB_Txn_Begin();
+		$Failed = false;
+		foreach (array('I', 'F') as $ChargeType) {
+			$Amount = ($ChargeType == 'I') ? $Customer['interest'] : $Customer['fee'];
+			if ($Amount <= 0) {
+				continue;
+			}
+			if ($ChargeType == 'I') {
+				$Type = CC_TYPE_INTEREST;
+				$Account = $Settings['CreditControlInterestAct'];
+				$Narrative = __('Late payment interest') . ' ' . $Month . ' - ' . locale_number_format($Rate, 2) . '% ' . __('per year on') . ' ' . $Customer['currcode'] . ' ' . locale_number_format($Customer['base'], $Customer['decimalplaces']) . ' ' . __('overdue');
+			} else {
+				$Type = CC_TYPE_FEE;
+				$Account = $Settings['CreditControlFeeAct'];
+				$Narrative = __('Late payment fee') . ' ' . $Month;
+			}
+			$Post = CreditControlPostDebtorTrans($Type, $Customer['debtorno'], $Amount, $Narrative, $Account, $MonthEnd, ($ChargeType == 'I' ? __('Interest') : __('Late fee')) . ' ' . $Month);
+			if ($Post === false) {
+				prnMsg($Customer['debtorno'] . ': ' . __('the customer has no branch to post the charge to'), 'error');
+				$Failed = true;
+				break;
+			}
+			DB_query("INSERT INTO latecharges (debtorno, chargemonth, chargetype, amount, basis, currcode, transid, transno, chargedate, userid, status)
+						VALUES ('" . $Customer['debtorno'] . "', '" . $Month . "', '" . $ChargeType . "', '" . $Amount . "', '" . $Customer['base'] . "',
+								'" . $Customer['currcode'] . "', '" . $Post['id'] . "', '" . $Post['transno'] . "', '" . $MonthEnd . "', '" . $_SESSION['UserID'] . "', 'P')");
+			CreditControlLog($Customer['debtorno'], 'CHARGE', $Narrative, $Amount, $Customer['currcode'], $Type . '/' . $Post['transno']);
+		}
+		if ($Failed) {
+			DB_Txn_Rollback();
+		} else {
+			DB_Txn_Commit();
+			$Posted++;
+		}
+	}
+	prnMsg($Posted . ' ' . __('customers have been charged for') . ' ' . $Month, 'success');
+}
+
+/* ---- Month selection and preview ---- */
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Month to charge') . '</legend>
+		<field>
+			<label for="Month">' . __('Month') . ':</label>
+			<select name="Month">';
+foreach ($Months as $M) {
+	echo '<option value="' . $M . '"' . ($M == $Month ? ' selected="selected"' : '') . '>' . $M . '</option>';
+}
+echo '</select>
+			<fieldhelp>' . __('Interest is calculated on balances more than') . ' ' . $GraceDays . ' ' . __('days past due at the end of the month. Interest is') . ' ' . locale_number_format($Rate, 2) . '% ' . __('a year, the late fee is') . ' ' . $HomeCurrency . ' ' . locale_number_format($FeeHome, $HomeDP) . '.</fieldhelp>
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Preview" value="' . __('Show what will be charged') . '" /></div>';
+
+$Rows = CreditControlChargeCandidates($Month, $MonthEnd, $Rate, $FeeHome, $GraceDays);
+$TotalHome = 0;
+echo '<table class="selection">
+	<caption>' . __('To be charged for') . ' ' . $Month . ' (' . count($Rows) . ') - ' . __('untick a customer to leave them out') . '</caption>
+	<tr><th>' . __('Charge') . '</th><th>' . __('Customer') . '</th><th>' . __('Name') . '</th><th>' . __('Currency') . '</th><th>' . __('Overdue balance') . '</th><th>' . __('Interest') . '</th><th>' . __('Late fee') . '</th><th>' . __('Total') . ' (' . $HomeCurrency . ')</th></tr>';
+foreach ($Rows as $Customer) {
+	$RowHome = ($Customer['interest'] + $Customer['fee']) / $Customer['rate'];
+	$TotalHome += $RowHome;
+	echo '<tr class="striped_row">
+			<td><input type="checkbox" name="Include[' . $Customer['debtorno'] . ']" checked="checked" /></td>
+			<td>' . $Customer['debtorno'] . '</td>
+			<td>' . CreditControlHTML($Customer['name']) . '</td>
+			<td>' . $Customer['currcode'] . '</td>
+			<td class="number">' . locale_number_format($Customer['base'], $Customer['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($Customer['interest'], $Customer['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($Customer['fee'], $Customer['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($RowHome, $HomeDP) . '</td>
+		</tr>';
+}
+echo '<tr class="total_row"><td colspan="7">' . __('Total') . ' (' . $HomeCurrency . ')</td><td class="number">' . locale_number_format($TotalHome, $HomeDP) . '</td></tr>
+	</table>';
+if (count($Rows) > 0) {
+	echo '<div class="centre"><input type="submit" name="PostCharges" value="' . __('Confirm and post these charges') . '" onclick="return confirm(\'' . __('Post these charges to the customer accounts and the general ledger?') . '\');" /></div>';
+}
+
+/* ---- Charges already posted for the month, to waive ---- */
+$Result = DB_query("SELECT latecharges.id,
+							latecharges.debtorno,
+							debtorsmaster.name,
+							latecharges.chargetype,
+							latecharges.amount,
+							latecharges.currcode,
+							latecharges.transno,
+							latecharges.status,
+							latecharges.waivereason,
+							currencies.decimalplaces
+					FROM latecharges
+					INNER JOIN debtorsmaster
+						ON debtorsmaster.debtorno=latecharges.debtorno
+					INNER JOIN currencies
+						ON currencies.currabrev=debtorsmaster.currcode
+					WHERE latecharges.chargemonth='" . $Month . "'
+					ORDER BY debtorsmaster.name, latecharges.chargetype DESC");
+echo '<table class="selection">
+	<caption>' . __('Charges posted for') . ' ' . $Month . '</caption>
+	<tr><th>' . __('Customer') . '</th><th>' . __('Name') . '</th><th>' . __('Charge') . '</th><th>' . __('Number') . '</th><th>' . __('Amount') . '</th><th>' . __('Waive') . '</th><th></th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>' . $MyRow['debtorno'] . '</td>
+			<td>' . CreditControlHTML($MyRow['name']) . '</td>
+			<td>' . ($MyRow['chargetype'] == 'I' ? __('Interest') : __('Late fee')) . '</td>
+			<td>' . $MyRow['transno'] . '</td>
+			<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], $MyRow['decimalplaces']) . '</td>';
+	if ($MyRow['status'] == 'W') {
+		echo '<td colspan="2">' . __('Waived') . ': ' . CreditControlHTML($MyRow['waivereason']) . '</td>';
+	} else {
+		echo '<td><input type="text" name="WaiveReason[' . $MyRow['id'] . ']" size="30" maxlength="200" placeholder="' . __('Reason for waiving') . '" /></td>
+			<td><input type="submit" name="Waive[' . $MyRow['id'] . ']" value="' . __('Waive') . '" /></td>';
+	}
+	echo '</tr>';
+}
+echo '</table>
+	</form>';
+
+include('includes/footer.php');
diff --git a/CreditControlCustomer.php b/CreditControlCustomer.php
new file mode 100644
index 0000000..a901886
--- /dev/null
+++ b/CreditControlCustomer.php
@@ -0,0 +1,451 @@
+<?php
+
+/* The credit file of a customer for credit control: record reviews, put the customer on stop or watch, mark invoices
+as disputed, set exemptions from interest and fees, and see the full credit history */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Customer Credit File');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControl';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+} elseif (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+}
+
+/* No customer chosen yet - search for one */
+if (!isset($DebtorNo) or $DebtorNo == '') {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<fieldset>
+				<legend>' . __('Find a customer') . '</legend>
+				<field>
+					<label for="Search">' . __('Part of the customer code or name') . ':</label>
+					<input type="text" name="Search" size="20" maxlength="40" autofocus="autofocus" />
+				</field>
+			</fieldset>
+			<div class="centre">
+				<input type="submit" name="Find" value="' . __('Search') . '" />
+			</div>
+		</form>';
+	if (isset($_POST['Find'])) {
+		$SQL = "SELECT debtorsmaster.debtorno, debtorsmaster.name, debtorsmaster.currcode
+				FROM debtorsmaster
+				WHERE (debtorsmaster.debtorno LIKE '%" . $_POST['Search'] . "%'
+					OR debtorsmaster.name LIKE '%" . $_POST['Search'] . "%')
+				ORDER BY debtorsmaster.name
+				LIMIT 50";
+		$Result = DB_query($SQL);
+		echo '<table class="selection">
+				<tr><th>' . __('Code') . '</th><th>' . __('Name') . '</th><th>' . __('Currency') . '</th></tr>';
+		while ($MyRow = DB_fetch_array($Result)) {
+			echo '<tr class="striped_row">
+					<td><a href="' . $RootPath . '/CreditControlCustomer.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . $MyRow['debtorno'] . '</a></td>
+					<td>' . CreditControlHTML($MyRow['name']) . '</td>
+					<td>' . $MyRow['currcode'] . '</td>
+				</tr>';
+		}
+		echo '</table>';
+	}
+	include('includes/footer.php');
+	exit();
+}
+
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				debtorsmaster.creditlimit,
+				currencies.decimalplaces,
+				currencies.rate,
+				debtorcredit.nextreviewdate,
+				debtorcredit.exemptinterest,
+				debtorcredit.exemptfees,
+				debtorcredit.collectionnote
+		FROM debtorsmaster
+		INNER JOIN currencies
+			ON debtorsmaster.currcode=currencies.currabrev
+		LEFT JOIN debtorcredit
+			ON debtorcredit.debtorno=debtorsmaster.debtorno
+		WHERE debtorsmaster.debtorno='" . $DebtorNo . "'";
+$Result = DB_query($SQL);
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('The customer could not be found'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($Result);
+$Settings = CreditControlSettings();
+
+function CreditControlValidDate($Date) {
+	if (!preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $Date, $Parts)) {
+		return false;
+	}
+	return checkdate((int) $Parts[2], (int) $Parts[3], (int) $Parts[1]);
+}
+
+/* Make sure there is a debtorcredit row to update */
+CreditControlNewCustomer($DebtorNo);
+
+/* ---- Record a credit review ---- */
+if (isset($_POST['RecordReview'])) {
+	$InputError = 0;
+	$Outcome = $_POST['Outcome'];
+	$NewLimit = filter_number_format($_POST['NewLimit']);
+	$OldLimit = $Customer['creditlimit'];
+	$NextReview = $_POST['NextReviewDate'];
+
+	if (!in_array($Outcome, array('CONFIRMED', 'RAISED', 'REDUCED', 'WATCH', 'STOP'))) {
+		$InputError = 1;

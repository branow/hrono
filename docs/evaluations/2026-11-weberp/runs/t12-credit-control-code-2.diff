+	<tr><td colspan="4">' . __('In the wording you can use') . ' {customer} {company} {currency} {total} {invoices} {date}</td></tr>
+	<tr><th>' . __('Stage') . '</th><th>' . __('Days overdue') . '</th><th>' . __('Subject') . '</th><th>' . __('Wording') . '</th></tr>';
+$Result = DB_query("SELECT stage, daysoverdue, subject, body FROM dunningstages ORDER BY stage");
+$MaxStage = 0;
+while ($MyRow = DB_fetch_array($Result)) {

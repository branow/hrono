+				if ($Current['Status'] != $StatusCodes[$StatusText]) {
+					if (!CreditControlSetStatus($DebtorNo, $StatusCodes[$StatusText], __('Loaded from the credit control spreadsheet'))) {
+						prnMsg(__('Line') . ' ' . $Line . ': ' . __('the credit statuses for normal, watch and stop have not been set up in the credit control settings'), 'error');
+						$Errors++;
+					}
+				}
+			}
+			if ($LimitText != '' and $LimitText != $Customer['creditlimit']) {
+				DB_query("UPDATE debtorsmaster SET creditlimit='" . $LimitText . "' WHERE debtorno='" . $DebtorNo . "'");
+				CreditControlLog($DebtorNo, 'LIMIT', __('Credit limit loaded from the credit control spreadsheet') . ': ' . locale_number_format($Customer['creditlimit'], 0) . ' -> ' . locale_number_format($LimitText, 0), $LimitText, $Customer['currcode']);
+			}
+			if ($ReviewText != '') {
+				DB_query("UPDATE debtorcredit SET nextreviewdate='" . $ReviewText . "' WHERE debtorno='" . $DebtorNo . "'");
+				CreditControlLog($DebtorNo, 'REVIEW', __('Next review date loaded from the credit control spreadsheet') . ': ' . $ReviewText);
+			}
+		}
+		fclose($Handle);
+		if ($CheckOnly) {
+			prnMsg($Applied . ' ' . __('lines are fine') . ', ' . $Errors . ' ' . __('have errors. Nothing has been changed.'), $Errors > 0 ? 'warn' : 'success');
+		} elseif ($Errors > 0) {
+			DB_Txn_Rollback();
+			prnMsg(__('There were errors, so nothing has been loaded. Correct the file and load it again.'), 'error');
+		} else {
+			DB_Txn_Commit();
+			prnMsg($Applied . ' ' . __('customers have been updated'), 'success');
+		}
+	}
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" enctype="multipart/form-data">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<div class="page_help_text">' . __('The file has one customer a line: customer code, status (normal, watch or stop), credit limit, next review date (YYYY-MM-DD). The last two are optional. Customers on the old stop list must be loaded as stop.') . '</div>
+	<fieldset>
+		<legend>' . __('Select the file') . '</legend>
+		<field>
+			<label for="CSVFile">' . __('File') . ':</label>
+			<input type="file" name="CSVFile" accept=".csv" required="required" />
+		</field>
+		<field>
+			<label for="CheckOnly">' . __('Check the file only - change nothing') . ':</label>
+			<input type="checkbox" name="CheckOnly" checked="checked" />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Upload" value="' . __('Load') . '" /></div>
+	</form>';
+
+include('includes/footer.php');
diff --git a/CreditControlOrders.php b/CreditControlOrders.php
new file mode 100644
index 0000000..ae25484
--- /dev/null
+++ b/CreditControlOrders.php
@@ -0,0 +1,120 @@
+<?php
+
+/* Orders credit control has to look at:
+- orders held for approval because they would take the customer over their credit limit - release them to let them be dispatched
+- open orders for customers on stop (taken before the stop) - dispatch and invoicing is blocked unless credit control releases them
+- open orders for customers on watch - still supplied, listed so credit control can keep an eye on them */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Control Orders');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlOrders';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/sales.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+/* ---- Release an order ---- */
+if (isset($_POST['Release']) and is_array($_POST['Release'])) {
+	foreach ($_POST['Release'] as $OrderNo => $Label) {
+		$OrderNo = (int) $OrderNo;
+		$Note = isset($_POST['ReleaseNote'][$OrderNo]) ? $_POST['ReleaseNote'][$OrderNo] : '';
+		$Result = DB_query("SELECT debtorno FROM salesorders WHERE orderno='" . $OrderNo . "'");
+		if (DB_num_rows($Result) == 0) {
+			continue;
+		}
+		$Order = DB_fetch_array($Result);
+		DB_Txn_Begin();
+		DB_query("INSERT INTO creditorderholds (orderno, debtorno, reason, status, heldon, releasedby, releasedon, note)
+					VALUES ('" . $OrderNo . "', '" . $Order['debtorno'] . "', '" . DB_escape_string(__('Customer on stop')) . "', 'R', NOW(), '" . $_SESSION['UserID'] . "', NOW(), '" . $Note . "')
+					ON DUPLICATE KEY UPDATE status='R', releasedby='" . $_SESSION['UserID'] . "', releasedon=NOW(), note='" . $Note . "'");
+		CreditControlLog($Order['debtorno'], 'RELEASE', __('Order released by credit control') . ': ' . $Note, 0, '', $OrderNo);
+		DB_Txn_Commit();
+		prnMsg(__('Order') . ' ' . $OrderNo . ' ' . __('has been released'), 'success');
+	}
+}
+
+$SQL = "SELECT salesorders.orderno,
+				salesorders.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				salesorders.orddate,
+				salesorders.deliverydate,
+				currencies.decimalplaces,
+				holdreasons.dissallowinvoices,
+				creditorderholds.status AS holdstatus,
+				creditorderholds.reason AS holdreason,
+				SUM(salesorderdetails.unitprice * (salesorderdetails.quantity - salesorderdetails.qtyinvoiced) * (1 - salesorderdetails.discountpercent)) AS ordervalue
+		FROM salesorders
+		INNER JOIN salesorderdetails
+			ON salesorders.orderno=salesorderdetails.orderno
+			AND salesorderdetails.completed=0
+		INNER JOIN debtorsmaster
+			ON debtorsmaster.debtorno=salesorders.debtorno
+		INNER JOIN currencies
+			ON currencies.currabrev=debtorsmaster.currcode
+		LEFT JOIN holdreasons
+			ON holdreasons.reasoncode=debtorsmaster.holdreason
+		LEFT JOIN creditorderholds
+			ON creditorderholds.orderno=salesorders.orderno
+		WHERE salesorders.quotation=0
+		GROUP BY salesorders.orderno,
+				salesorders.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				salesorders.orddate,
+				salesorders.deliverydate,
+				currencies.decimalplaces,
+				holdreasons.dissallowinvoices,
+				creditorderholds.status,
+				creditorderholds.reason
+		ORDER BY salesorders.orddate, salesorders.orderno";
+$Result = DB_query($SQL);
+
+$Held = array();
+$Stopped = array();
+$Watched = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	if ($MyRow['holdstatus'] == 'H') {
+		$Held[] = $MyRow;
+	} elseif ($MyRow['dissallowinvoices'] == 1 and $MyRow['holdstatus'] != 'R') {
+		$Stopped[] = $MyRow;
+	} elseif ($MyRow['dissallowinvoices'] == 2) {
+		$Watched[] = $MyRow;
+	}
+}
+
+function CreditControlOrderTable($Caption, $Rows, $CanRelease, $RootPath) {
+	echo '<table class="selection">
+		<caption>' . $Caption . ' (' . count($Rows) . ')</caption>
+		<tr><th>' . __('Order') . '</th><th>' . __('Customer') . '</th><th>' . __('Ordered') . '</th><th>' . __('Delivery') . '</th><th>' . __('Value outstanding') . '</th><th>' . __('Reason') . '</th>' . ($CanRelease ? '<th>' . __('Note') . '</th><th></th>' : '') . '</tr>';
+	foreach ($Rows as $Row) {
+		echo '<tr class="striped_row">
+				<td><a href="' . $RootPath . '/OrderDetails.php?OrderNumber=' . $Row['orderno'] . '">' . $Row['orderno'] . '</a></td>
+				<td><a href="' . $RootPath . '/CreditControlCustomer.php?DebtorNo=' . urlencode($Row['debtorno']) . '">' . $Row['debtorno'] . '</a> ' . CreditControlHTML($Row['name']) . '</td>
+				<td>' . ConvertSQLDate($Row['orddate']) . '</td>
+				<td>' . ConvertSQLDate($Row['deliverydate']) . '</td>
+				<td class="number">' . $Row['currcode'] . ' ' . locale_number_format($Row['ordervalue'], $Row['decimalplaces']) . '</td>
+				<td>' . CreditControlHTML($Row['holdreason'] != '' ? $Row['holdreason'] : ($Row['dissallowinvoices'] == 1 ? __('Customer on stop') : '')) . '</td>';
+		if ($CanRelease) {
+			echo '<td><input type="text" name="ReleaseNote[' . $Row['orderno'] . ']" size="25" maxlength="200" /></td>
+				<td><input type="submit" name="Release[' . $Row['orderno'] . ']" value="' . __('Release') . '" /></td>';
+		}
+		echo '</tr>';
+	}
+	echo '</table>';
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+CreditControlOrderTable(__('Orders held for credit approval - over the credit limit'), $Held, true, $RootPath);
+CreditControlOrderTable(__('Open orders for customers on stop - blocked until released'), $Stopped, true, $RootPath);
+CreditControlOrderTable(__('Open orders for customers on watch'), $Watched, false, $RootPath);
+echo '</form>';
+
+include('includes/footer.php');
diff --git a/CreditControlReminders.php b/CreditControlReminders.php
new file mode 100644
index 0000000..111ac34
--- /dev/null
+++ b/CreditControlReminders.php
@@ -0,0 +1,276 @@
+<?php
+
+/* The overdue reminder letter run (dunning). Credit control starts it, normally weekly:
+1. it shows who would get which letter, and credit control takes out the customers it does not want to chase this time
+2. it emails the letters (customers with no accounts contact email are listed so the letter can be posted)
+and records each letter against the customer and the invoices it covered.
+
+A customer moves up one stage at a time, and only while items they were chased for are still unpaid. Paid in the meantime
+means no next letter. The same stage is never sent twice, and nothing is sent within the minimum gap since the last letter.
+Disputed invoices are not chased. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+/* A letter already sent, for printing and posting. Nothing else on the page */
+if (isset($_GET['Letter'])) {
+	$Result = DB_query("SELECT dunningletters.lettertext,
+								dunningletters.sentdate,
+								debtorsmaster.name
+						FROM dunningletters
+						INNER JOIN debtorsmaster
+							ON debtorsmaster.debtorno=dunningletters.debtorno
+						WHERE dunningletters.id='" . (int) $_GET['Letter'] . "'");
+	$Title = __('Reminder Letter');
+	include('includes/header.php');
+	if (DB_num_rows($Result) == 1) {
+		$Letter = DB_fetch_array($Result);
+		echo '<div class="centre"><b>' . CreditControlHTML($Letter['name']) . '</b> - ' . ConvertSQLDate(substr($Letter['sentdate'], 0, 10)) . '</div>
+			<pre style="white-space: pre-wrap;">' . CreditControlHTML($Letter['lettertext']) . '</pre>
+			<div class="centre"><input type="button" value="' . __('Print') . '" onclick="window.print()" /></div>';
+	} else {
+		prnMsg(__('The letter could not be found'), 'error');
+	}
+	include('includes/footer.php');
+	exit();
+}
+
+$Title = __('Credit Control Reminder Run');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlReminders';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_add.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Settings = CreditControlSettings();
+$GapDays = (int) $Settings['CreditControlReminderGapDays'];
+
+/* the stages, in order */
+$Stages = array();
+$Result = DB_query("SELECT stage, daysoverdue, subject, body FROM dunningstages ORDER BY stage");
+while ($MyRow = DB_fetch_array($Result)) {
+	$Stages[$MyRow['stage']] = $MyRow;
+}
+if (count($Stages) == 0) {
+	prnMsg(__('No reminder letter stages have been set up. Set them up in the Credit Control Settings first.'), 'warn');
+	include('includes/footer.php');
+	exit();
+}
+$LastStage = max(array_keys($Stages));
+
+/* The email addresses of the customer's accounts contacts - the contacts flagged to receive statements */
+function CreditControlAccountsEmails($DebtorNo) {
+	$Emails = array();
+	$Result = DB_query("SELECT email FROM custcontacts WHERE statement=1 AND debtorno='" . $DebtorNo . "'");
+	while ($MyRow = DB_fetch_array($Result)) {
+		if (IsEmailAddress($MyRow['email'])) {
+			$Emails[] = $MyRow['email'];
+		}
+	}
+	return $Emails;
+}
+
+/* Work out who gets which letter now. Returns array('send' => rows, 'recent' => rows, 'final' => rows) */
+function CreditControlReminderCandidates($Stages, $LastStage, $GapDays) {
+	$Candidates = array('send' => array(), 'recent' => array(), 'final' => array());
+	$SQL = "SELECT debtortrans.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					currencies.decimalplaces
+			FROM debtortrans
+			INNER JOIN debtorsmaster
+				ON debtortrans.debtorno=debtorsmaster.debtorno
+			INNER JOIN currencies
+				ON debtorsmaster.currcode=currencies.currabrev
+			GROUP BY debtortrans.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					currencies.decimalplaces
+			HAVING SUM(debtortrans.balance) > 0.005
+			ORDER BY debtorsmaster.name";
+	$Result = DB_query($SQL);
+	while ($Customer = DB_fetch_array($Result)) {
+		$Items = CreditControlOverdueItems($Customer['debtorno'], '', true);
+		if (count($Items) == 0) {
+			continue;
+		}
+		$Total = 0;
+		$Oldest = 0;
+		foreach ($Items as $Item) {
+			$Total += $Item['balance'];
+			$Oldest = max($Oldest, $Item['daysoverdue']);
+		}
+		// a customer who has paid but not had the receipt allocated has nothing to chase
+		$Total = min($Total, CreditControlBalance($Customer['debtorno']));
+		if ($Total <= 0.005) {
+			continue;
+		}
+		$Current = CreditControlCurrentStage($Customer['debtorno']);
+		$Customer['items'] = $Items;
+		$Customer['total'] = $Total;
+		$Customer['oldest'] = $Oldest;
+		$Customer['current'] = $Current;
+		$Status = CreditControlGetStatus($Customer['debtorno']);
+		$Customer['status'] = $Status['Status'];
+		if ($Current >= $LastStage) {
+			$Candidates['final'][] = $Customer;
+			continue;
+		}
+		$Next = $Current + 1;
+		if ($Oldest < $Stages[$Next]['daysoverdue']) {
+			continue;
+		}
+		$Customer['stage'] = $Next;
+		$LastLetter = DB_query("SELECT DATEDIFF(CURRENT_DATE, DATE(MAX(sentdate))) FROM dunningletters WHERE debtorno='" . $Customer['debtorno'] . "'");
+		$LastRow = DB_fetch_row($LastLetter);
+		if ($LastRow[0] !== null and $LastRow[0] < $GapDays) {
+			$Customer['dayssince'] = $LastRow[0];
+			$Candidates['recent'][] = $Customer;
+			continue;
+		}
+		$Customer['emails'] = CreditControlAccountsEmails($Customer['debtorno']);
+		$Candidates['send'][] = $Customer;
+	}
+	return $Candidates;
+}
+
+/* The text of a letter from the stage wording */
+function CreditControlLetterText($Stage, $Customer) {
+	$Lines = array();
+	foreach ($Customer['items'] as $Item) {
+		$Lines[] = $Item['typename'] . ' ' . $Item['transno'] . '  ' . __('dated') . ' ' . ConvertSQLDate($Item['trandate']) . '  ' . __('due') . ' ' . ConvertSQLDate($Item['duedate']) . '  ' .
+			$Customer['currcode'] . ' ' . locale_number_format($Item['balance'], $Customer['decimalplaces']) . '  (' . $Item['daysoverdue'] . ' ' . __('days overdue') . ')';
+	}
+	$Replace = array('{customer}' => html_entity_decode($Customer['name'], ENT_QUOTES, 'UTF-8'),
+					'{company}' => html_entity_decode($_SESSION['CompanyRecord']['coyname'], ENT_QUOTES, 'UTF-8'),
+					'{currency}' => $Customer['currcode'],
+					'{total}' => locale_number_format($Customer['total'], $Customer['decimalplaces']),
+					'{invoices}' => implode("\n", $Lines),
+					'{date}' => date($_SESSION['DefaultDateFormat']));
+	return strtr(html_entity_decode($Stage['body'], ENT_QUOTES, 'UTF-8'), $Replace);
+}
+
+/* ---- Send the letters ---- */
+if (isset($_POST['SendLetters'])) {
+	$Include = (isset($_POST['Include']) and is_array($_POST['Include'])) ? $_POST['Include'] : array();
+	$Candidates = CreditControlReminderCandidates($Stages, $LastStage, $GapDays);
+	$Sent = 0;
+	$ToPost = array();
+	foreach ($Candidates['send'] as $Customer) {
+		if (!isset($Include[$Customer['debtorno']])) {
+			continue;
+		}
+		$Stage = $Stages[$Customer['stage']];
+		$Text = CreditControlLetterText($Stage, $Customer);
+		$Subject = html_entity_decode($Stage['subject'], ENT_QUOTES, 'UTF-8');
+		if (count($Customer['emails']) > 0) {
+			$From = $_SESSION['CompanyRecord']['coyname'] . '<' . $_SESSION['CompanyRecord']['email'] . '>';
+			$EmailResult = SendEmailFromWebERP($From, array_fill_keys($Customer['emails'], ''), $Subject, $Text, array(), true);
+			if ($EmailResult !== true) {
+				prnMsg(__('The reminder to') . ' ' . $Customer['name'] . ' ' . __('could not be emailed and has not been recorded as sent'), 'error');
+				continue;
+			}
+			$Method = 'E';
+			$SentTo = mb_substr(implode(', ', $Customer['emails']), 0, 100);
+		} else {
+			$Method = 'P';
+			$SentTo = '';
+		}
+		DB_Txn_Begin();
+		DB_query("INSERT INTO dunningletters (debtorno, stage, sentdate, userid, currcode, amount, sentto, method, lettertext)
+					VALUES ('" . $Customer['debtorno'] . "',
+							'" . $Customer['stage'] . "',
+							NOW(),
+							'" . $_SESSION['UserID'] . "',
+							'" . $Customer['currcode'] . "',
+							'" . $Customer['total'] . "',
+							'" . DB_escape_string($SentTo) . "',
+							'" . $Method . "',
+							'" . DB_escape_string($Text) . "')");
+		$LetterID = DB_Last_Insert_ID('dunningletters', 'id');
+		foreach ($Customer['items'] as $Item) {
+			DB_query("INSERT INTO dunninglettersdetail (letterid, transid, amount)
+						VALUES ('" . $LetterID . "', '" . $Item['id'] . "', '" . $Item['balance'] . "')");
+		}
+		CreditControlLog($Customer['debtorno'],
+			'REMINDER',
+			__('Reminder stage') . ' ' . $Customer['stage'] . ' ' . ($Method == 'E' ? __('emailed to') . ' ' . $SentTo : __('to be posted')) . ' - ' . count($Customer['items']) . ' ' . __('items'),
+			$Customer['total'],
+			$Customer['currcode'],
+			'L' . $LetterID);
+		DB_Txn_Commit();
+		$Sent++;
+		if ($Method == 'P') {
+			$ToPost[] = array($Customer, $LetterID);
+		}
+	}
+	prnMsg($Sent . ' ' . __('reminder letters have been recorded as sent'), 'success');
+	if (count($ToPost) > 0) {
+		echo '<table class="selection">
+			<caption>' . __('No accounts contact email - these letters must be posted') . '</caption>';
+		foreach ($ToPost as $Post) {
+			echo '<tr class="striped_row">
+					<td>' . $Post[0]['debtorno'] . '</td>
+					<td>' . CreditControlHTML($Post[0]['name']) . '</td>
+					<td><a href="' . $RootPath . '/CreditControlReminders.php?Letter=' . $Post[1] . '" target="_blank">' . __('Print the letter') . '</a></td>
+				</tr>';
+		}
+		echo '</table>';
+	}
+}
+
+/* ---- Preview ---- */
+$Candidates = CreditControlReminderCandidates($Stages, $LastStage, $GapDays);
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<table class="selection">
+	<caption>' . __('Letters that will be sent - untick a customer to leave them out of this run') . ' (' . count($Candidates['send']) . ')</caption>
+	<tr><th>' . __('Send') . '</th><th>' . __('Customer') . '</th><th>' . __('Name') . '</th><th>' . __('Status') . '</th><th>' . __('Overdue') . '</th><th>' . __('Oldest (days)') . '</th><th>' . __('Letter') . '</th><th>' . __('Delivery') . '</th></tr>';
+foreach ($Candidates['send'] as $Customer) {
+	echo '<tr class="striped_row">
+			<td><input type="checkbox" name="Include[' . $Customer['debtorno'] . ']" checked="checked" /></td>
+			<td><a href="' . $RootPath . '/CreditControlCustomer.php?DebtorNo=' . urlencode($Customer['debtorno']) . '" target="_blank">' . $Customer['debtorno'] . '</a></td>
+			<td>' . CreditControlHTML($Customer['name']) . '</td>
+			<td>' . CreditControlStatusText($Customer['status']) . '</td>
+			<td class="number">' . $Customer['currcode'] . ' ' . locale_number_format($Customer['total'], $Customer['decimalplaces']) . '</td>
+			<td class="number">' . $Customer['oldest'] . '</td>
+			<td>' . __('Stage') . ' ' . $Customer['stage'] . ' - ' . CreditControlHTML($Stages[$Customer['stage']]['subject']) . '</td>
+			<td>' . (count($Customer['emails']) > 0 ? implode(', ', $Customer['emails']) : '<b>' . __('No email - letter must be posted') . '</b>') . '</td>
+		</tr>';
+}
+echo '</table>';
+if (count($Candidates['send']) > 0) {
+	echo '<div class="centre"><input type="submit" name="SendLetters" value="' . __('Send the letters') . '" /></div>';
+}
+echo '</form>';
+
+if (count($Candidates['recent']) > 0) {
+	echo '<table class="selection">
+		<caption>' . __('Not chased this time - a letter was sent less than') . ' ' . $GapDays . ' ' . __('days ago') . '</caption>';
+	foreach ($Candidates['recent'] as $Customer) {
+		echo '<tr class="striped_row"><td>' . $Customer['debtorno'] . '</td><td>' . CreditControlHTML($Customer['name']) . '</td><td>' . __('Last letter') . ' ' . $Customer['dayssince'] . ' ' . __('days ago') . '</td></tr>';
+	}
+	echo '</table>';
+}
+
+if (count($Candidates['final']) > 0) {
+	echo '<table class="selection">
+		<caption>' . __('Final notice already sent and still unpaid - credit control to decide whether to put on stop') . '</caption>';
+	foreach ($Candidates['final'] as $Customer) {
+		echo '<tr class="striped_row">
+				<td><a href="' . $RootPath . '/CreditControlCustomer.php?DebtorNo=' . urlencode($Customer['debtorno']) . '">' . $Customer['debtorno'] . '</a></td>
+				<td>' . CreditControlHTML($Customer['name']) . '</td>
+				<td>' . CreditControlStatusText($Customer['status']) . '</td>
+				<td class="number">' . $Customer['currcode'] . ' ' . locale_number_format($Customer['total'], $Customer['decimalplaces']) . '</td>
+				<td class="number">' . $Customer['oldest'] . ' ' . __('days') . '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/CreditControlReport.php b/CreditControlReport.php
new file mode 100644
index 0000000..5756596
--- /dev/null
+++ b/CreditControlReport.php
@@ -0,0 +1,192 @@
+<?php
+
+/* Credit control report: customers due or overdue for a credit review, customers over their credit limit and customers
+on watch or on stop. Filter by sales person and by currency; totals are in the home currency.
+A sales person's login only ever sees their own customers. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Control Report');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlReport';
+include('includes/header.php');
+
+echo '<p class="page_title_text">

diff --git a/CustomerCreditAccount.php b/CustomerCreditAccount.php
new file mode 100644
index 0000000..947fe8d
--- /dev/null
+++ b/CustomerCreditAccount.php
@@ -0,0 +1,182 @@
+<?php
+
+/* Credit information for one customer account, read only.
+- A customer logged in to the portal sees only their own account: balance, reminder letters sent to them and the interest
+  and fees charged. They are never shown a watch status or any internal notes.
+- A sales person's login sees the same for their own customers only, plus the credit status, limit and reason.
+- Credit control follows the link to the full credit file to act. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Customer Credit Account');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControl';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if ($CustomerLogin == 1) {
+	// a customer logon always shows their own account, whatever is asked for
+	$DebtorNo = $_SESSION['CustomerID'];
+} elseif (isset($_POST['DebtorNo']) and $_POST['DebtorNo'] != '') {
+	$DebtorNo = $_POST['DebtorNo'];
+} elseif (isset($_GET['DebtorNo']) and $_GET['DebtorNo'] != '') {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_SESSION['CustomerID']) and $_SESSION['CustomerID'] != '') {
+	$DebtorNo = $_SESSION['CustomerID'];
+} else {
+	$DebtorNo = '';
+}
+
+if ($DebtorNo == '') {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<fieldset>
+				<legend>' . __('Customer') . '</legend>
+				<field>
+					<label for="DebtorNo">' . __('Customer code') . ':</label>
+					<input type="text" name="DebtorNo" size="10" maxlength="10" autofocus="autofocus" />
+				</field>
+			</fieldset>
+			<div class="centre"><input type="submit" name="Show" value="' . __('Show') . '" /></div>
+		</form>';
+	include('includes/footer.php');
+	exit();
+}
+
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.creditlimit,
+				debtorsmaster.currcode,
+				currencies.decimalplaces,
+				debtorcredit.nextreviewdate
+		FROM debtorsmaster
+		INNER JOIN currencies
+			ON debtorsmaster.currcode=currencies.currabrev
+		LEFT JOIN debtorcredit
+			ON debtorcredit.debtorno=debtorsmaster.debtorno
+		WHERE debtorsmaster.debtorno='" . $DebtorNo . "'";
+$Result = DB_query($SQL);
+
+// a customer that does not exist and a customer a sales person may not see look the same
+if (DB_num_rows($Result) == 0 or !CreditControlCanSeeCustomer($DebtorNo)) {
+	prnMsg(__('There is no account to show'), 'warn');
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($Result);
+$DP = $Customer['decimalplaces'];
+$Status = CreditControlGetStatus($DebtorNo);
+$Balance = CreditControlBalance($DebtorNo);
+$Overdue = 0;
+foreach (CreditControlOverdueItems($DebtorNo, '', true) as $Item) {
+	$Overdue += $Item['balance'];
+}
+
+echo '<table class="selection">
+		<tr><th colspan="2">' . CreditControlHTML($Customer['name']) . ' (' . $DebtorNo . ')</th></tr>
+		<tr><td>' . __('Currency') . '</td><td>' . $Customer['currcode'] . '</td></tr>
+		<tr><td>' . __('Balance') . '</td><td class="number">' . locale_number_format($Balance, $DP) . '</td></tr>
+		<tr><td>' . __('Overdue') . '</td><td class="number">' . locale_number_format($Overdue, $DP) . '</td></tr>';
+
+if ($CustomerLogin == 1) {
+	// customers are told when their account is on hold, but never about watch
+	if ($Status['Status'] == 'S') {
+		echo '<tr><td colspan="2"><b>' . __('Your account is on hold. New orders cannot be accepted - please contact us.') . '</b></td></tr>';
+	}
+} else {
+	echo '<tr><td>' . __('Credit status') . '</td><td><b>' . CreditControlStatusText($Status['Status']) . '</b> (' . CreditControlHTML($Status['Reason']) . ')</td></tr>
+		<tr><td>' . __('Credit limit') . '</td><td class="number">' . locale_number_format($Customer['creditlimit'], $DP) . '</td></tr>
+		<tr><td>' . __('Next credit review') . '</td><td>' . (($Customer['nextreviewdate'] === null or $Customer['nextreviewdate'] == '1000-01-01') ? __('Not set') : ConvertSQLDate($Customer['nextreviewdate'])) . '</td></tr>';
+}
+echo '</table>';
+
+if ($CustomerLogin != 1 and CreditControlIsController()) {
+	echo '<p><a href="' . $RootPath . '/CreditControlCustomer.php?DebtorNo=' . urlencode($DebtorNo) . '">' . __('Open the credit file') . '</a></p>';
+}
+
+/* reminder letters sent, with the invoices they covered */
+$Result = DB_query("SELECT id, stage, sentdate, amount, currcode, method
+					FROM dunningletters
+					WHERE debtorno='" . $DebtorNo . "'
+					ORDER BY sentdate DESC, id DESC");
+echo '<table class="selection">
+		<caption>' . __('Reminders sent') . '</caption>
+		<tr><th>' . __('Date') . '</th><th>' . __('Stage') . '</th><th>' . __('Amount overdue') . '</th><th>' . __('Invoices covered') . '</th></tr>';
+if (DB_num_rows($Result) == 0) {
+	echo '<tr><td colspan="4">' . __('No reminders have been sent') . '</td></tr>';
+}
+while ($Letter = DB_fetch_array($Result)) {
+	$DetailResult = DB_query("SELECT systypes.typename, debtortrans.transno
+								FROM dunninglettersdetail
+								INNER JOIN debtortrans
+									ON debtortrans.id=dunninglettersdetail.transid
+								INNER JOIN systypes
+									ON systypes.typeid=debtortrans.type
+								WHERE dunninglettersdetail.letterid='" . $Letter['id'] . "'
+								ORDER BY debtortrans.trandate, debtortrans.id");
+	$Covered = array();
+	while ($Detail = DB_fetch_array($DetailResult)) {
+		$Covered[] = __($Detail['typename']) . ' ' . $Detail['transno'];
+	}
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate(substr($Letter['sentdate'], 0, 10)) . '</td>
+			<td>' . $Letter['stage'] . '</td>
+			<td class="number">' . $Letter['currcode'] . ' ' . locale_number_format($Letter['amount'], $DP) . '</td>
+			<td>' . implode(', ', $Covered) . '</td>
+		</tr>';
+}
+echo '</table>';
+
+/* the credit history, for auditors and office staff - not for customers, and not for a sales person's login */
+if ($CustomerLogin != 1 and $_SESSION['SalesmanLogin'] == '') {
+	$Result = DB_query("SELECT * FROM creditlog WHERE debtorno='" . $DebtorNo . "' ORDER BY id DESC");
+	echo '<table class="selection">
+		<caption>' . __('Credit history') . '</caption>
+		<tr><th>' . __('Date') . '</th><th>' . __('By') . '</th><th>' . __('Action') . '</th><th>' . __('Detail') . '</th><th>' . __('Amount') . '</th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . ConvertSQLDate(substr($MyRow['eventdate'], 0, 10)) . ' ' . substr($MyRow['eventdate'], 11, 5) . '</td>
+				<td>' . $MyRow['userid'] . '</td>
+				<td>' . $MyRow['eventtype'] . '</td>
+				<td>' . CreditControlHTML($MyRow['description']) . '</td>
+				<td class="number">' . ($MyRow['amount'] != 0 ? $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], $DP) : '') . '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+/* interest and fees charged */
+$Result = DB_query("SELECT latecharges.chargemonth,
+							latecharges.chargetype,
+							latecharges.amount,
+							latecharges.currcode,
+							latecharges.transno,
+							latecharges.chargedate,
+							latecharges.status
+					FROM latecharges
+					WHERE latecharges.debtorno='" . $DebtorNo . "'
+					ORDER BY latecharges.chargedate DESC, latecharges.id DESC");
+echo '<table class="selection">
+		<caption>' . __('Interest and fees charged') . '</caption>
+		<tr><th>' . __('Date') . '</th><th>' . __('Description') . '</th><th>' . __('Number') . '</th><th>' . __('Amount') . '</th><th></th></tr>';
+if (DB_num_rows($Result) == 0) {
+	echo '<tr><td colspan="5">' . __('No interest or fees have been charged') . '</td></tr>';
+}
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate($MyRow['chargedate']) . '</td>
+			<td>' . ($MyRow['chargetype'] == 'I' ? __('Late payment interest') : __('Late payment fee')) . ' ' . $MyRow['chargemonth'] . '</td>
+			<td>' . $MyRow['transno'] . '</td>
+			<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], $DP) . '</td>
+			<td>' . ($MyRow['status'] == 'W' ? __('Waived') : '') . '</td>
+		</tr>';
+}
+echo '</table>';
+
+include('includes/footer.php');

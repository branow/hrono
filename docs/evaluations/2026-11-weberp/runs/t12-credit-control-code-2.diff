+				} else {
+					prnMsg(__('Only the last stage can be deleted'), 'error');
+				}
+			}
+		}
+		if (isset($_POST['AddStage'])) {
+			$Result = DB_query("SELECT MAX(stage), MAX(daysoverdue) FROM dunningstages");
+			$MaxRow = DB_fetch_row($Result);
+			DB_query("INSERT INTO dunningstages (stage, daysoverdue, subject, body)

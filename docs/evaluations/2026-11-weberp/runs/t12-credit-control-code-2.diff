+if ($MaxStage > 0) {
+	echo '<input type="submit" name="DeleteStage[' . $MaxStage . ']" value="' . __('Delete the Last Stage') . '" onclick="return confirm(\'' . __('Delete the last reminder stage?') . '\');" />';
+}

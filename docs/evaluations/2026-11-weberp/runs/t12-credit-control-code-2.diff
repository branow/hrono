+								subject='" . $_POST['Subject'][$Stage] . "',
+								body='" . $_POST['Body'][$Stage] . "'
+							WHERE stage='" . (int) $Stage . "'");
+			}
+		}
+		if (isset($_POST['DeleteStage']) and is_array($_POST['DeleteStage'])) {
+			// only the last stage can go, so the numbers in the letter history keep their meaning
+			$Result = DB_query("SELECT MAX(stage) FROM dunningstages");
+			$MaxRow = DB_fetch_row($Result);
+			foreach ($_POST['DeleteStage'] as $Stage => $Label) {

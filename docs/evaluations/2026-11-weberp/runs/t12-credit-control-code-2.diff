+		}
+	}
+	foreach (array('InterestAct', 'FeeAct', 'BadDebtAct') as $Key) {
+		if ($_POST[$Key] != '') {
+			$Result = DB_query("SELECT accountcode FROM chartmaster WHERE accountcode='" . $_POST[$Key] . "'");
+			if (DB_num_rows($Result) == 0) {

+++ b/ForecastReview.php
@@ -0,0 +1,231 @@
+<?php
+
+// Search forecasts and review them period by period; a revised quantity overrides the calculated one.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Review and Revise Forecasts');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastReview';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$ForecastID = isset($_POST['ForecastID']) ? (int) $_POST['ForecastID'] : (isset($_GET['ForecastID']) ? (int) $_GET['ForecastID'] : 0);
+$Self = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+
+/* ------------------------------------------------------------ save the revisions */
+
+if ($ForecastID > 0 and (isset($_POST['Save']) or isset($_POST['Restore']))) {
+	$Result = DB_query("SELECT forecastid FROM forecasts WHERE forecastid = " . $ForecastID . " AND activekey = 1");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('Only the active forecast of an item and location can be revised'), 'error');
+	} elseif (isset($_POST['Restore'])) {
+		DB_query("UPDATE forecastlines SET revisedqty = NULL, revisedby = '', reviseddate = NULL WHERE forecastid = " . $ForecastID);
+		prnMsg(__('All revisions have been cleared, the calculated quantities apply'), 'success');
+	} else {
+		$Changes = array();
+		$InputError = false;
+		$Revised = (isset($_POST['Revised']) and is_array($_POST['Revised'])) ? $_POST['Revised'] : array();
+		foreach ($Revised as $Period => $Text) {
+			if (!preg_match('/^\d{4}-\d{2}-01$/', $Period)) {
+				continue;
+			}
+			$Text = trim($Text);
+			if ($Text === '') {
+				$Changes[$Period] = null; // clearing the box restores the calculated quantity
+			} else {
+				$Number = filter_number_format($Text);
+				if (!is_numeric($Number) or $Number < 0) {
+					$InputError = true;
+					prnMsg(ForecastMonthLabel($Period) . ': ' . __('the revised quantity must be a number that is not negative'), 'error');
+				} else {
+					$Changes[$Period] = (float) $Number;
+				}
+			}
+		}
+		if (!$InputError) {
+			foreach ($Changes as $Period => $Quantity) {
+				if ($Quantity === null) {
+					DB_query("UPDATE forecastlines SET revisedqty = NULL, revisedby = '', reviseddate = NULL
+								WHERE forecastid = " . $ForecastID . " AND periodstart = '" . $Period . "'");
+				} else {
+					// only a changed quantity is stamped with the user and date
+					// MySQL evaluates the assignments left to right: the stamps must be set before revisedqty changes
+					DB_query("UPDATE forecastlines SET revisedby = IF(revisedqty <=> " . $Quantity . ", revisedby, '" . $_SESSION['UserID'] . "'),
+								reviseddate = IF(revisedqty <=> " . $Quantity . ", reviseddate, NOW()),
+								revisedqty = " . $Quantity . "
+							WHERE forecastid = " . $ForecastID . " AND periodstart = '" . $Period . "'");
+				}
+			}
+			prnMsg(__('The revised quantities have been saved'), 'success');
+		}
+	}
+}
+
+/* ------------------------------------------------------------ one forecast */
+
+if ($ForecastID > 0) {
+	$Result = DB_query("SELECT forecasts.*, stockmaster.description, stockmaster.decimalplaces
+						FROM forecasts
+						LEFT JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+						WHERE forecasts.forecastid = " . $ForecastID);
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('That forecast does not exist'), 'error');
+	} else {
+		$Forecast = DB_fetch_array($Result);
+		$Active = ($Forecast['activekey'] == 1);
+		$Held = ForecastHistoryRange();
+		$LastYear = ForecastItemMonths($Forecast['stockid'], $Forecast['loccode']);
+
+		echo '<table class="selection">
+				<tr><th colspan="2">' . $Forecast['stockid'] . ' - ' . $Forecast['description'] . '</th></tr>
+				<tr class="striped_row"><td>' . __('Location') . '</td><td>' . ($Forecast['loccode'] == FORECAST_ALL_LOCATIONS ? __('All locations combined') : $Forecast['loccode']) . '</td></tr>
+				<tr class="striped_row"><td>' . __('Method') . '</td><td>' . ForecastMethodName($Forecast['method']) . ($Forecast['bestfit'] ? ' (' . __('best fit') . ')' : '') . '</td></tr>
+				<tr class="striped_row"><td>' . __('Parameters') . '</td><td>' . ForecastParamsDescribe($Forecast['method'], $Forecast['methodparams']) . '</td></tr>
+				<tr class="striped_row"><td>' . __('History used') . '</td><td>' . ForecastMonthLabel($Forecast['historyfrom']) . ' - ' . ForecastMonthLabel($Forecast['historyto']) . '</td></tr>
+				<tr class="striped_row"><td>' . __('Generated') . '</td><td>' . $Forecast['createddate'] . ' ' . $Forecast['createdby'] . '</td></tr>
+				<tr class="striped_row"><td>' . __('Status') . '</td><td>' . ($Active ? __('Active, used by MRP') : __('Superseded by a later forecast')) . '</td></tr>
+			</table><br />';
+
+		$Result = DB_query("SELECT periodstart, calcqty, revisedqty, revisedby, reviseddate
+							FROM forecastlines
+							WHERE forecastid = " . $ForecastID . "
+							ORDER BY periodstart");
+		if ($Active) {
+			echo '<form method="post" action="' . $Self . '">
+					<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+					<input type="hidden" name="ForecastID" value="' . $ForecastID . '" />';
+		}
+		echo '<table class="selection">
+				<tr>
+					<th>' . __('Period') . '</th>
+					<th>' . __('Calculated quantity') . '</th>
+					<th>' . __('Revised quantity') . '</th>
+					<th>' . __('Quantity used') . '</th>
+					<th>' . __('Last year actual') . '</th>
+					<th>' . __('Variance %') . '</th>
+				</tr>';
+		while ($Line = DB_fetch_array($Result)) {
+			$Effective = ($Line['revisedqty'] === null) ? $Line['calcqty'] : $Line['revisedqty'];
+			$LastYearMonth = ForecastAddMonths($Line['periodstart'], -12);
+			$HasLastYear = ($LastYearMonth >= $Held['from'] and $LastYearMonth <= $Held['to']);
+			$LastYearQty = isset($LastYear[$LastYearMonth]) ? $LastYear[$LastYearMonth] : 0;
+			$Variance = '-';
+			$Style = '';
+			if ($HasLastYear and $LastYearQty > 0) {
+				$Percent = 100 * ($Effective - $LastYearQty) / $LastYearQty;
+				$Variance = locale_number_format($Percent, 1);
+				if (abs($Percent) >= FORECAST_VARIANCE_HIGHLIGHT) {
+					$Style = ' style="background-color:#fdd;font-weight:bold"';
+				}
+			}
+			echo '<tr class="striped_row">
+					<td>' . ForecastMonthLabel($Line['periodstart']) . '</td>
+					<td class="number">' . locale_number_format($Line['calcqty'], 2) . '</td>';
+			if ($Active) {
+				echo '<td><input type="text" class="number" size="10" name="Revised[' . $Line['periodstart'] . ']" value="' . ($Line['revisedqty'] === null ? '' : number_format($Line['revisedqty'], 2, $DecimalPoint, '')) . '" /></td>';
+			} else {
+				echo '<td class="number">' . ($Line['revisedqty'] === null ? '' : locale_number_format($Line['revisedqty'], 2)) . '</td>';
+			}
+			echo '<td class="number"><b>' . locale_number_format($Effective, 2) . '</b></td>
+					<td class="number">' . ($HasLastYear ? locale_number_format($LastYearQty, 2) : '-') . '</td>
+					<td class="number"' . $Style . '>' . $Variance . '</td>
+				</tr>';
+		}
+		echo '</table>';
+		if ($Active) {
+			echo '<p>' . __('Enter a revised quantity to override the calculated one everywhere it is used: reports, accuracy and MRP. Clear the box to restore the calculated quantity.') . '</p>
+				<div class="centre">
+					<input type="submit" name="Save" value="' . __('Save revised quantities') . '" />
+					<input type="submit" name="Restore" value="' . __('Restore all calculated quantities') . '" />
+				</div>
+				</form>';
+		}
+		echo '<div class="centre"><a href="' . $Self . '">' . __('Search forecasts') . '</a></div>';
+	}
+	include('includes/footer.php');
+	exit();
+}
+
+/* ------------------------------------------------------------------- search */
+
+$StockID = isset($_POST['StockID']) ? mb_strtoupper(trim($_POST['StockID'])) : '';
+$CategoryID = isset($_POST['CategoryID']) ? $_POST['CategoryID'] : '';
+$LocCode = isset($_POST['Location']) ? $_POST['Location'] : '*';
+
+echo '<form method="post" action="' . $Self . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Search forecasts') . '</legend>
+		<field>
+			<label for="StockID">' . __('Item code contains') . ':</label>
+			<input type="text" name="StockID" size="21" maxlength="64" value="' . $StockID . '" />
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category') . ':</label>
+			<select name="CategoryID">' . ForecastCategoryOptions($CategoryID, __('All categories')) . '</select>
+		</field>
+		<field>
+			<label for="Location">' . __('Stock location') . ':</label>
+			<select name="Location"><option value="*"' . ($LocCode === '*' ? ' selected="selected"' : '') . '>' . __('Any location') . '</option>' . ForecastLocationOptions($LocCode, __('All locations combined')) . '</select>
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Search" value="' . __('Search') . '" /></div>
+	</form>';
+
+if (isset($_POST['Search'])) {
+	$Where = "forecasts.activekey = 1";
+	if ($StockID != '') {
+		$Where .= " AND forecasts.stockid LIKE '%" . $StockID . "%'";
+	}
+	if ($CategoryID != '') {
+		$Where .= " AND stockmaster.categoryid = '" . $CategoryID . "'";
+	}
+	if ($LocCode !== '*') {
+		$Where .= " AND forecasts.loccode = '" . $LocCode . "'";
+	}
+	$Result = DB_query("SELECT forecasts.forecastid, forecasts.stockid, forecasts.loccode, forecasts.method, forecasts.createddate,
+							stockmaster.description, stockmaster.categoryid,
+							MIN(forecastlines.periodstart) AS firstperiod,
+							MAX(forecastlines.periodstart) AS lastperiod,
+							SUM(forecastlines.revisedqty IS NOT NULL) AS revisions
+						FROM forecasts
+						INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+						INNER JOIN forecastlines ON forecastlines.forecastid = forecasts.forecastid
+						WHERE " . $Where . "
+						GROUP BY forecasts.forecastid, forecasts.stockid, forecasts.loccode, forecasts.method, forecasts.createddate, stockmaster.description, stockmaster.categoryid
+						ORDER BY forecasts.stockid, forecasts.loccode
+						LIMIT 500");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('No active forecasts match the search'), 'info');
+	} else {
+		echo '<table class="selection">
+				<tr>
+					<th>' . __('Item') . '</th>
+					<th>' . __('Description') . '</th>
+					<th>' . __('Category') . '</th>
+					<th>' . __('Location') . '</th>
+					<th>' . __('Method') . '</th>
+					<th>' . __('Periods') . '</th>
+					<th>' . __('Revisions') . '</th>
+					<th></th>
+				</tr>';
+		while ($Row = DB_fetch_array($Result)) {
+			echo '<tr class="striped_row">
+					<td>' . $Row['stockid'] . '</td>
+					<td>' . $Row['description'] . '</td>
+					<td>' . $Row['categoryid'] . '</td>
+					<td>' . ($Row['loccode'] == FORECAST_ALL_LOCATIONS ? __('All locations combined') : $Row['loccode']) . '</td>
+					<td>' . ForecastMethodName($Row['method']) . '</td>
+					<td>' . ForecastMonthLabel($Row['firstperiod']) . ' - ' . ForecastMonthLabel($Row['lastperiod']) . '</td>
+					<td class="number">' . $Row['revisions'] . '</td>
+					<td><a href="' . $Self . '?ForecastID=' . $Row['forecastid'] . '">' . __('Review') . '</a></td>
+				</tr>';
+		}
+		echo '</table>';
+	}
+}
+
+include('includes/footer.php');
diff --git a/ForecastSummary.php b/ForecastSummary.php
new file mode 100644
index 0000000..6c76808
--- /dev/null
+++ b/ForecastSummary.php
@@ -0,0 +1,139 @@
+<?php
+
+// Summary forecasts: the sales history aggregated by stock category, customer type, sales area or salesperson.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Summary Forecasts');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastSummary';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Defaults = ForecastDefaults();
+$Held = ForecastHistoryRange();
+$Self = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+
+if ($Held['from'] === null) {
+	prnMsg(__('No sales history has been extracted yet, extract it first'), 'warn');
+	echo '<div class="centre"><a href="' . $RootPath . '/ForecastHistory.php">' . __('Extract Sales History') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+$GroupNames = ForecastSummaryGroupNames();
+$GroupBy = (isset($_POST['GroupBy']) and isset($GroupNames[$_POST['GroupBy']])) ? $_POST['GroupBy'] : 'C';
+$Method = isset($_POST['Method']) ? (int) $_POST['Method'] : 0;
+$Horizon = isset($_POST['Horizon']) ? (int) $_POST['Horizon'] : (int) $Defaults['Horizon'];
+$Holdout = isset($_POST['Holdout']) ? (int) $_POST['Holdout'] : (int) $Defaults['HoldoutMonths'];
+
+if (isset($_POST['Generate'])) {
+	list($Params, $ParamErrors) = ForecastParamsFromInput($_POST, $Defaults);
+	$Errors = ForecastRelevantErrors($ParamErrors, $Method);
+	if ($Method != 0 and ForecastMethodMinHistory($Method) === null) {
+		$Errors[] = __('Select a forecasting method');
+	}
+	if ($Horizon < 1 or $Horizon > FORECAST_MAX_HORIZON) {
+		$Errors[] = __('The horizon must be between 1 and') . ' ' . FORECAST_MAX_HORIZON . ' ' . __('months');
+	}
+	if ($Holdout < 1 or $Holdout > 12) {
+		$Errors[] = __('The months held out for the accuracy test must be between 1 and 12');
+	}
+	if (count($Errors) > 0) {
+		foreach ($Errors as $Error) {
+			prnMsg($Error, 'error');
+		}
+	} else {
+		$Group = ForecastSummaryGroupSQL($GroupBy);
+		$Result = DB_query("SELECT " . $Group['key'] . " AS summarykey, h.monthstart, SUM(h.qty) AS qty
+							FROM forecasthistory AS h " . $Group['join'] . "
+							WHERE " . $Group['where'] . "
+							GROUP BY summarykey, h.monthstart");
+		$Months = array();
+		while ($Row = DB_fetch_array($Result)) {
+			$Months[$Row['summarykey']][$Row['monthstart']] = (float) $Row['qty'];
+		}
+		ksort($Months);
+		$Succeeded = 0;
+		$Failures = array();
+		foreach ($Months as $GroupKey => $MonthMap) {
+			$Series = ForecastBuildSeries($MonthMap, $Held['to']);
+			$UseMethod = $Method;
+			$Reason = '';
+			if ($UseMethod == 0) {
+				$BestFit = ForecastBestFit($Series['values'], $Holdout, $Params);
+				if ($BestFit['best'] == 0) {
+					$Reason = __('No method has enough history to be tested on the held out months');
+				} else {
+					$UseMethod = $BestFit['best'];
+				}
+			}
+			if ($Reason == '') {
+				$Outcome = ForecastCompute($UseMethod, $Series['values'], $Horizon, $Params);
+				if (isset($Outcome['error'])) {
+					$Reason = $Outcome['error'];
+				} else {
+					ForecastSaveSummary($GroupBy, $GroupKey, $UseMethod, $Params, $Series['start'], $Held['to'], $Outcome['values']);
+					$Succeeded++;
+				}
+			}
+			if ($Reason != '') {
+				$Failures[$GroupKey] = $Reason;
+			}
+		}
+		prnMsg($Succeeded . ' ' . __('successful') . ', ' . count($Failures) . ' ' . __('failed'), count($Failures) > 0 ? 'warn' : 'success');
+		if (count($Failures) > 0) {
+			echo '<table class="selection"><tr><th>' . $GroupNames[$GroupBy] . '</th><th>' . __('Reason') . '</th></tr>';
+			foreach ($Failures as $GroupKey => $Reason) {
+				echo '<tr class="striped_row"><td>' . ForecastSummaryLabel($GroupBy, $GroupKey) . '</td><td>' . $Reason . '</td></tr>';
+			}
+			echo '</table><br />';
+		}
+	}
+}
+
+echo '<p>' . __('Summary forecasts are built from the same sales history as the item forecasts, adding up every item sold to each group.') . ' ' . __('History held') . ': ' . ForecastMonthLabel($Held['from']) . ' - ' . ForecastMonthLabel($Held['to']) . '</p>';
+
+echo '<form method="post" action="' . $Self . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Summary forecast') . '</legend>
+		<field>
+			<label for="GroupBy">' . __('Summarise by') . ':</label>
+			<select name="GroupBy">';
+foreach ($GroupNames as $Code => $Name) {
+	echo '<option value="' . $Code . '"' . ($GroupBy == $Code ? ' selected="selected"' : '') . '>' . $Name . '</option>';
+}
+echo '</select>
+		</field>
+		<field>
+			<label for="Horizon">' . __('Number of future monthly periods') . ':</label>
+			<input type="text" class="number" name="Horizon" size="4" value="' . $Horizon . '" />
+		</field>
+		<field>
+			<label for="Method">' . __('Method') . ':</label>
+			<select name="Method">' . ForecastMethodOptions($Method) . '</select>
+		</field>
+		<field>
+			<label for="Holdout">' . __('Months held out for the best fit test') . ':</label>
+			<input type="text" class="number" name="Holdout" size="4" value="' . $Holdout . '" />
+		</field>
+	</fieldset>
+	<fieldset>
+		<legend>' . __('Method parameters') . '</legend>' . ForecastParamFields($_POST, $Defaults) . '
+	</fieldset>
+	<div class="centre"><input type="submit" name="Generate" value="' . __('Generate Summary Forecasts') . '" /></div>
+	</form>';
+
+$Result = DB_query("SELECT groupby, COUNT(*) AS summaries FROM forecastsummaries WHERE activekey = 1 GROUP BY groupby");
+if (DB_num_rows($Result) > 0) {
+	echo '<br /><table class="selection"><tr><th colspan="2">' . __('Active summary forecasts') . '</th></tr>';
+	while ($Row = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row"><td><a href="' . $RootPath . '/ForecastSummaryReview.php?GroupBy=' . $Row['groupby'] . '">' . $GroupNames[$Row['groupby']] . '</a></td><td class="number">' . $Row['summaries'] . '</td></tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/ForecastSummaryReview.php b/ForecastSummaryReview.php
new file mode 100644
index 0000000..c1211e5
--- /dev/null
+++ b/ForecastSummaryReview.php
@@ -0,0 +1,233 @@
+<?php
+
+// Reviews summary forecasts and the detail of the sales history behind each of them.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Summary Forecast Review');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastSummaryReview';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Self = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$GroupNames = ForecastSummaryGroupNames();
+$SummaryID = isset($_POST['SummaryID']) ? (int) $_POST['SummaryID'] : (isset($_GET['SummaryID']) ? (int) $_GET['SummaryID'] : 0);
+
+/* ---------------------------------------------------------- save the revisions */
+
+if ($SummaryID > 0 and (isset($_POST['Save']) or isset($_POST['Restore']))) {
+	$Result = DB_query("SELECT summaryid FROM forecastsummaries WHERE summaryid = " . $SummaryID . " AND activekey = 1");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('Only the active summary forecast of a group can be revised'), 'error');
+	} elseif (isset($_POST['Restore'])) {
+		DB_query("UPDATE forecastsummarylines SET revisedqty = NULL WHERE summaryid = " . $SummaryID);
+		prnMsg(__('All revisions have been cleared, the calculated quantities apply'), 'success');
+	} else {
+		$InputError = false;
+		$Changes = array();
+		$Revised = (isset($_POST['Revised']) and is_array($_POST['Revised'])) ? $_POST['Revised'] : array();
+		foreach ($Revised as $Period => $Text) {
+			if (!preg_match('/^\d{4}-\d{2}-01$/', $Period)) {
+				continue;
+			}
+			$Text = trim($Text);
+			if ($Text === '') {
+				$Changes[$Period] = 'NULL';
+			} else {
+				$Number = filter_number_format($Text);
+				if (!is_numeric($Number) or $Number < 0) {
+					$InputError = true;
+					prnMsg(ForecastMonthLabel($Period) . ': ' . __('the revised quantity must be a number that is not negative'), 'error');
+				} else {
+					$Changes[$Period] = (float) $Number;
+				}
+			}
+		}
+		if (!$InputError) {
+			foreach ($Changes as $Period => $Quantity) {
+				DB_query("UPDATE forecastsummarylines SET revisedqty = " . $Quantity . "
+							WHERE summaryid = " . $SummaryID . " AND periodstart = '" . $Period . "'");
+			}
+			prnMsg(__('The revised quantities have been saved'), 'success');
+		}
+	}
+}
+
+/* ------------------------------------------------------------ one summary */
+
+if ($SummaryID > 0) {
+	$Result = DB_query("SELECT * FROM forecastsummaries WHERE summaryid = " . $SummaryID);
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('That summary forecast does not exist'), 'error');
+		include('includes/footer.php');
+		exit();
+	}
+	$Summary = DB_fetch_array($Result);
+	$Active = ($Summary['activekey'] == 1);
+	$Held = ForecastHistoryRange();
+	$Group = ForecastSummaryGroupSQL($Summary['groupby']);
+	$KeyCondition = $Group['key'] . " = '" . $Summary['groupkey'] . "'";
+
+	// last year's actual of the group, month by month
+	$Result = DB_query("SELECT h.monthstart, SUM(h.qty) AS qty
+						FROM forecasthistory AS h " . $Group['join'] . "
+						WHERE " . $KeyCondition . "
+						GROUP BY h.monthstart");
+	$LastYear = array();
+	while ($Row = DB_fetch_array($Result)) {
+		$LastYear[$Row['monthstart']] = (float) $Row['qty'];
+	}
+
+	echo '<table class="selection">
+			<tr><th colspan="2">' . $GroupNames[$Summary['groupby']] . ': ' . ForecastSummaryLabel($Summary['groupby'], $Summary['groupkey']) . '</th></tr>
+			<tr class="striped_row"><td>' . __('Method') . '</td><td>' . ForecastMethodName($Summary['method']) . '</td></tr>
+			<tr class="striped_row"><td>' . __('Parameters') . '</td><td>' . ForecastParamsDescribe($Summary['method'], $Summary['methodparams']) . '</td></tr>
+			<tr class="striped_row"><td>' . __('History used') . '</td><td>' . ForecastMonthLabel($Summary['historyfrom']) . ' - ' . ForecastMonthLabel($Summary['historyto']) . '</td></tr>
+			<tr class="striped_row"><td>' . __('Generated') . '</td><td>' . $Summary['createddate'] . ' ' . $Summary['createdby'] . '</td></tr>
+			<tr class="striped_row"><td>' . __('Status') . '</td><td>' . ($Active ? __('Active') : __('Superseded by a later forecast')) . '</td></tr>
+		</table><br />';
+
+	$Result = DB_query("SELECT periodstart, calcqty, revisedqty FROM forecastsummarylines WHERE summaryid = " . $SummaryID . " ORDER BY periodstart");
+	if ($Active) {
+		echo '<form method="post" action="' . $Self . '">
+				<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+				<input type="hidden" name="SummaryID" value="' . $SummaryID . '" />';
+	}
+	echo '<table class="selection">
+			<tr>
+				<th>' . __('Period') . '</th>
+				<th>' . __('Calculated quantity') . '</th>
+				<th>' . __('Revised quantity') . '</th>
+				<th>' . __('Quantity used') . '</th>
+				<th>' . __('Last year actual') . '</th>
+				<th>' . __('Variance %') . '</th>
+			</tr>';
+	while ($Line = DB_fetch_array($Result)) {
+		$Effective = ($Line['revisedqty'] === null) ? $Line['calcqty'] : $Line['revisedqty'];
+		$LastYearMonth = ForecastAddMonths($Line['periodstart'], -12);
+		$HasLastYear = ($LastYearMonth >= $Held['from'] and $LastYearMonth <= $Held['to']);
+		$LastYearQty = isset($LastYear[$LastYearMonth]) ? $LastYear[$LastYearMonth] : 0;
+		$Variance = '-';
+		$Style = '';
+		if ($HasLastYear and $LastYearQty > 0) {
+			$Percent = 100 * ($Effective - $LastYearQty) / $LastYearQty;
+			$Variance = locale_number_format($Percent, 1);
+			if (abs($Percent) >= FORECAST_VARIANCE_HIGHLIGHT) {
+				$Style = ' style="background-color:#fdd;font-weight:bold"';
+			}
+		}
+		echo '<tr class="striped_row">
+				<td>' . ForecastMonthLabel($Line['periodstart']) . '</td>
+				<td class="number">' . locale_number_format($Line['calcqty'], 2) . '</td>';
+		if ($Active) {
+			echo '<td><input type="text" class="number" size="10" name="Revised[' . $Line['periodstart'] . ']" value="' . ($Line['revisedqty'] === null ? '' : number_format($Line['revisedqty'], 2, $DecimalPoint, '')) . '" /></td>';
+		} else {
+			echo '<td class="number">' . ($Line['revisedqty'] === null ? '' : locale_number_format($Line['revisedqty'], 2)) . '</td>';
+		}
+		echo '<td class="number"><b>' . locale_number_format($Effective, 2) . '</b></td>
+				<td class="number">' . ($HasLastYear ? locale_number_format($LastYearQty, 2) : '-') . '</td>
+				<td class="number"' . $Style . '>' . $Variance . '</td>
+			</tr>';
+	}
+	echo '</table>';
+	if ($Active) {
+		echo '<div class="centre">
+				<input type="submit" name="Save" value="' . __('Save revised quantities') . '" />
+				<input type="submit" name="Restore" value="' . __('Restore all calculated quantities') . '" />
+			</div>
+			</form>';
+	}
+
+	// the detail behind the summary: the last 12 months of history of every item in the group
+	$DetailFrom = ForecastAddMonths($Summary['historyto'], -11);
+	$Result = DB_query("SELECT h.stockid, h.monthstart, SUM(h.qty) AS qty
+						FROM forecasthistory AS h " . ($Summary['groupby'] == 'C' ? $Group['join'] : '') . "
+						WHERE " . $KeyCondition . "
+						AND h.monthstart >= '" . $DetailFrom . "'
+						AND h.monthstart <= '" . $Summary['historyto'] . "'
+						GROUP BY h.stockid, h.monthstart");
+	$Items = array();
+	while ($Row = DB_fetch_array($Result)) {
+		$Items[$Row['stockid']][$Row['monthstart']] = (float) $Row['qty'];
+	}
+	uasort($Items, function ($A, $B) {
+		return array_sum($B) <=> array_sum($A);
+	});
+	echo '<br /><table class="selection"><tr><th colspan="15">' . __('Detail: net sales of the items in this group, last 12 months of history') . '</th></tr><tr><th>' . __('Item') . '</th>';
+	$Month = $DetailFrom;
+	for ($i = 0; $i < 12; $i++) {
+		echo '<th>' . ForecastMonthLabel($Month) . '</th>';
+		$Month = ForecastAddMonths($Month, 1);
+	}
+	echo '<th>' . __('Total') . '</th><th>' . __('Share %') . '</th></tr>';
+	$GrandTotal = 0;
+	foreach ($Items as $ItemMonths) {
+		$GrandTotal += array_sum($ItemMonths);
+	}
+	$Shown = 0;
+	foreach ($Items as $ItemCode => $ItemMonths) {
+		if (++$Shown > 100) {
+			break;
+		}
+		echo '<tr class="striped_row"><td>' . $ItemCode . '</td>';
+		$Month = $DetailFrom;
+		for ($i = 0; $i < 12; $i++) {
+			echo '<td class="number">' . (isset($ItemMonths[$Month]) ? locale_number_format($ItemMonths[$Month], 0) : '') . '</td>';
+			$Month = ForecastAddMonths($Month, 1);
+		}
+		echo '<td class="number">' . locale_number_format(array_sum($ItemMonths), 0) . '</td>
+				<td class="number">' . ($GrandTotal > 0 ? locale_number_format(100 * array_sum($ItemMonths) / $GrandTotal, 1) : '-') . '</td>
+			</tr>';
+	}
+	echo '<tr><th>' . __('Total') . '</th><th colspan="12"></th><th class="number">' . locale_number_format($GrandTotal, 0) . '</th><th></th></tr></table>';
+	if (count($Items) > 100) {
+		prnMsg(__('Only the 100 items with the most sales are shown'), 'info');
+	}
+	echo '<div class="centre"><a href="' . $Self . '?GroupBy=' . $Summary['groupby'] . '">' . __('Back to the summary forecasts') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* ------------------------------------------------------------------- list */
+
+$GroupBy = (isset($_GET['GroupBy']) and isset($GroupNames[$_GET['GroupBy']])) ? $_GET['GroupBy'] : '';
+echo '<div class="centre">';
+foreach ($GroupNames as $Code => $Name) {
+	echo '<a href="' . $Self . '?GroupBy=' . $Code . '">' . $Name . '</a> | ';
+}
+echo '<a href="' . $Self . '">' . __('All') . '</a></div><br />';
+
+$Result = DB_query("SELECT summaryid, groupby, groupkey, method, historyto, createddate
+					FROM forecastsummaries
+					WHERE activekey = 1" . ($GroupBy != '' ? " AND groupby = '" . $GroupBy . "'" : '') . "
+					ORDER BY groupby, groupkey");
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('There are no active summary forecasts'), 'info');
+	echo '<div class="centre"><a href="' . $RootPath . '/ForecastSummary.php">' . __('Summary Forecasts') . '</a></div>';
+} else {
+	echo '<table class="selection">
+			<tr>
+				<th>' . __('Summarised by') . '</th>
+				<th>' . __('Group') . '</th>
+				<th>' . __('Method') . '</th>
+				<th>' . __('History to') . '</th>
+				<th>' . __('Generated') . '</th>
+				<th></th>
+			</tr>';
+	while ($Row = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . $GroupNames[$Row['groupby']] . '</td>
+				<td>' . ForecastSummaryLabel($Row['groupby'], $Row['groupkey']) . '</td>
+				<td>' . ForecastMethodName($Row['method']) . '</td>
+				<td>' . ForecastMonthLabel($Row['historyto']) . '</td>
+				<td>' . $Row['createddate'] . '</td>
+				<td><a href="' . $Self . '?SummaryID=' . $Row['summaryid'] . '">' . __('Review') . '</a></td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/ForecastToMRP.php b/ForecastToMRP.php
new file mode 100644
index 0000000..6a1dd9b
--- /dev/null
+++ b/ForecastToMRP.php
@@ -0,0 +1,147 @@
+<?php
+
+// Converts the active forecasts into MRP demands (the master schedule) under the forecast demand type.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Convert Forecasts to MRP Demands');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastToMRP';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Self = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$ScopeType = (isset($_POST['ScopeType']) and in_array($_POST['ScopeType'], array('All', 'Category', 'Item'))) ? $_POST['ScopeType'] : 'All';
+$CategoryID = isset($_POST['CategoryID']) ? $_POST['CategoryID'] : '';
+$StockID = isset($_POST['StockID']) ? mb_strtoupper(trim($_POST['StockID'])) : '';
+$Mode = (isset($_POST['Mode']) and $_POST['Mode'] == 'Incremental') ? 'Incremental' : 'Replace';
+$FromDate = isset($_POST['FromDate']) ? $_POST['FromDate'] : date('Y-m-01');
+$ToDate = isset($_POST['ToDate']) ? $_POST['ToDate'] : date('Y-m-d', strtotime(date('Y-m-01') . ' +6 month -1 day'));
+
+if (isset($_POST['Convert'])) {
+	$Errors = array();
+	if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $FromDate) or !preg_match('/^\d{4}-\d{2}-\d{2}$/', $ToDate)) {
+		$Errors[] = __('Enter the first and the last date of the horizon');
+	} elseif ($FromDate > $ToDate) {
+		$Errors[] = __('The horizon cannot end before it starts');
+	}
+	$ItemFilter = "stockmaster.discontinued = 0";
+	if ($ScopeType == 'Category') {
+		$ItemFilter .= " AND stockmaster.categoryid = '" . $CategoryID . "'";
+		$Result = DB_query("SELECT categoryid FROM stockcategory WHERE categoryid = '" . $CategoryID . "'");
+		if (DB_num_rows($Result) == 0) {
+			$Errors[] = __('Select a stock category');
+		}
+	} elseif ($ScopeType == 'Item') {
+		$ItemFilter .= " AND stockmaster.stockid = '" . $StockID . "'";
+		$Result = DB_query("SELECT stockid FROM stockmaster WHERE stockid = '" . $StockID . "' AND discontinued = 0");
+		if (DB_num_rows($Result) == 0) {
+			$Errors[] = __('Enter the code of an existing active item');
+		}
+	}
+
+	if (count($Errors) > 0) {
+		foreach ($Errors as $Error) {
+			prnMsg($Error, 'error');
+		}
+	} else {
+		DB_Txn_Begin();
+		// the demand type is created again if it was deleted: mrpdemands refers to it
+		DB_query("INSERT IGNORE INTO mrpdemandtypes (mrpdemandtype, description) VALUES ('" . FORECAST_MRP_DEMAND_TYPE . "', 'Statistical Forecast')", '', '', true);
+		$Deleted = 0;
+		if ($Mode == 'Replace') {
+			// only demands this module wrote (fromforecast = 1): hand entered or other demands are never touched
+			$Result = DB_query("DELETE mrpdemands FROM mrpdemands
+								INNER JOIN stockmaster ON stockmaster.stockid = mrpdemands.stockid
+								WHERE mrpdemands.mrpdemandtype = '" . FORECAST_MRP_DEMAND_TYPE . "'
+								AND mrpdemands.fromforecast = 1
+								AND mrpdemands.duedate >= '" . $FromDate . "'
+								AND mrpdemands.duedate <= '" . $ToDate . "'
+								AND " . $ItemFilter, '', '', true);
+			$Deleted = DB_affected_rows($Result);
+		}
+		// An item forecast for all locations combined is used as it is; an item with forecasts only per location gets the
+		// sum of them, MRP demands have no location. The revised quantity wins over the calculated one.
+		$AlreadyThere = '';
+		if ($Mode == 'Incremental') {
+			$AlreadyThere = " AND NOT EXISTS (SELECT 1 FROM mrpdemands AS d
+												WHERE d.stockid = forecasts.stockid
+												AND d.mrpdemandtype = '" . FORECAST_MRP_DEMAND_TYPE . "'
+												AND d.fromforecast = 1
+												AND d.duedate = forecastlines.periodstart)";
+		}
+		$Result = DB_query("INSERT INTO mrpdemands (stockid, mrpdemandtype, quantity, duedate, fromforecast)
+							SELECT forecasts.stockid,
+								'" . FORECAST_MRP_DEMAND_TYPE . "',
+								ROUND(SUM(" . FORECAST_EFFECTIVE_QTY . "), 4),
+								forecastlines.periodstart,
+								1
+							FROM forecasts
+							INNER JOIN forecastlines ON forecastlines.forecastid = forecasts.forecastid
+							INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+							WHERE forecasts.activekey = 1
+							AND forecastlines.periodstart >= '" . $FromDate . "'
+							AND forecastlines.periodstart <= '" . $ToDate . "'
+							AND " . $ItemFilter . "
+							AND (forecasts.loccode = '' OR NOT EXISTS (SELECT 1 FROM forecasts AS fa
+																		WHERE fa.stockid = forecasts.stockid
+																		AND fa.loccode = ''
+																		AND fa.activekey = 1))" . $AlreadyThere . "
+							GROUP BY forecasts.stockid, forecastlines.periodstart
+							HAVING SUM(" . FORECAST_EFFECTIVE_QTY . ") > 0", '', '', true);
+		$Created = DB_affected_rows($Result);
+		DB_Txn_Commit();
+
+		prnMsg($Created . ' ' . __('MRP demands have been created under demand type') . ' ' . FORECAST_MRP_DEMAND_TYPE . ($Mode == 'Replace' ? ', ' . $Deleted . ' ' . __('earlier forecast demands for the same items and dates were replaced') : ', ' . __('periods already present were left as they are')), 'success');
+		echo '<div class="centre"><a href="' . $RootPath . '/MRPDemands.php">' . __('Master Schedule') . '</a> | <a href="' . $RootPath . '/MRP.php">' . __('MRP Calculation') . '</a> | <a href="' . $RootPath . '/MRPReport.php">' . __('MRP Report') . '</a></div><br />';
+	}
+}
+
+$Result = DB_query("SELECT COUNT(*), MIN(duedate), MAX(duedate), COUNT(DISTINCT stockid)
+					FROM mrpdemands
+					WHERE mrpdemandtype = '" . FORECAST_MRP_DEMAND_TYPE . "' AND fromforecast = 1");
+$Row = DB_fetch_row($Result);
+echo '<p>' . __('The master schedule currently holds') . ' ' . (int) $Row[0] . ' ' . __('forecast demands') . ($Row[0] > 0 ? ' ' . __('for') . ' ' . $Row[3] . ' ' . __('items') . ', ' . ConvertSQLDate($Row[1]) . ' - ' . ConvertSQLDate($Row[2]) : '') . '. ' . __('Demands entered by hand or created from other sources are never changed here.') . '</p>';
+
+echo '<form method="post" action="' . $Self . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Forecasts to convert') . '</legend>
+		<field>
+			<label for="ScopeAll">' . __('All items with an active forecast') . ':</label>
+			<input type="radio" id="ScopeAll" name="ScopeType" value="All"' . ($ScopeType == 'All' ? ' checked="checked"' : '') . ' />
+		</field>
+		<field>
+			<label for="ScopeCategory">' . __('Items of a stock category') . ':</label>
+			<input type="radio" id="ScopeCategory" name="ScopeType" value="Category"' . ($ScopeType == 'Category' ? ' checked="checked"' : '') . ' />
+			<select name="CategoryID">' . ForecastCategoryOptions($CategoryID) . '</select>
+		</field>
+		<field>
+			<label for="ScopeItem">' . __('A single item') . ':</label>
+			<input type="radio" id="ScopeItem" name="ScopeType" value="Item"' . ($ScopeType == 'Item' ? ' checked="checked"' : '') . ' />
+			<input type="text" name="StockID" size="21" maxlength="64" value="' . $StockID . '" />
+		</field>
+		<field>
+			<label for="FromDate">' . __('Horizon from') . ':</label>
+			<input type="date" name="FromDate" required="required" value="' . $FromDate . '" />
+		</field>
+		<field>
+			<label for="ToDate">' . __('Horizon to') . ':</label>

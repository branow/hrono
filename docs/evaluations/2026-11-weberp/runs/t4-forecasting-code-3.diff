diff --git a/ForecastAccuracy.php b/ForecastAccuracy.php
new file mode 100644
index 0000000..06c0a3d
--- /dev/null
+++ b/ForecastAccuracy.php
@@ -0,0 +1,166 @@
+<?php
+
+// Compares past forecasts with the sales that followed: MAD, POA, MSE and RMSE per item, category and method.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Accuracy');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastAccuracy';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Defaults = ForecastDefaults();
+$Held = ForecastHistoryRange();
+$Self = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$LowPOA = (float) $Defaults['LowAccuracyPOA'];
+
+if ($Held['from'] === null) {
+	prnMsg(__('No sales history has been extracted yet, extract it first'), 'warn');
+	include('includes/footer.php');
+	exit();
+}
+
+$FromMonth = isset($_POST['FromMonth']) ? $_POST['FromMonth'] : substr(ForecastAddMonths($Held['to'], -11), 0, 7);
+$ToMonth = isset($_POST['ToMonth']) ? $_POST['ToMonth'] : substr($Held['to'], 0, 7);
+$CategoryID = isset($_POST['CategoryID']) ? $_POST['CategoryID'] : '';
+
+echo '<p>' . __('Each forecast period that has since been sold is compared with the actual sales of that month. The quantity used is the revised quantity when there is one. When an item was forecast more than once for a month, the latest forecast made for it is the one measured.') . '</p>';
+echo '<p>' . __('MAD is the mean absolute deviation, MSE the mean squared error, RMSE its square root. POA, the percent of accuracy, is 100 less the total absolute error as a percent of total actual sales (never below 0).') . '</p>';
+
+echo '<form method="post" action="' . $Self . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Forecast periods to compare') . '</legend>
+		<field>
+			<label for="FromMonth">' . __('From month') . ':</label>
+			<input type="month" name="FromMonth" required="required" value="' . $FromMonth . '" />
+		</field>
+		<field>
+			<label for="ToMonth">' . __('To month') . ':</label>
+			<input type="month" name="ToMonth" required="required" value="' . $ToMonth . '" />
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category') . ':</label>
+			<select name="CategoryID">' . ForecastCategoryOptions($CategoryID, __('All categories')) . '</select>
+		</field>
+		<field>
+			<label for="AllVersions">' . __('Measure every forecast version, not only the latest one per month') . ':</label>
+			<input type="checkbox" name="AllVersions" value="1"' . (isset($_POST['AllVersions']) ? ' checked="checked"' : '') . ' />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Show" value="' . __('Show accuracy') . '" /></div>
+	</form>';
+
+if (isset($_POST['Show'])) {
+	$From = ForecastMonthStart($FromMonth);
+	$To = ForecastMonthStart($ToMonth);
+	if ($From === null or $To === null or $From > $To) {
+		prnMsg(__('Enter a valid range of months'), 'error');
+		include('includes/footer.php');
+		exit();
+	}
+	if ($To > $Held['to']) {
+		$To = $Held['to'];
+		prnMsg(__('Only months with sales history can be compared, the range ends with') . ' ' . ForecastMonthLabel($To), 'info');
+	}
+	$Where = "forecastlines.periodstart >= '" . $From . "' AND forecastlines.periodstart <= '" . $To . "'";
+	if ($CategoryID != '') {
+		$Where .= " AND stockmaster.categoryid = '" . $CategoryID . "'";
+	}
+	if (!isset($_POST['AllVersions'])) {
+		$Where .= " AND forecasts.forecastid = (SELECT MAX(f2.forecastid)
+												FROM forecasts AS f2
+												INNER JOIN forecastlines AS l2 ON l2.forecastid = f2.forecastid
+												WHERE f2.stockid = forecasts.stockid
+												AND f2.loccode = forecasts.loccode
+												AND l2.periodstart = forecastlines.periodstart)";
+	}
+	$Result = DB_query("SELECT forecasts.stockid, forecasts.loccode, forecasts.method, stockmaster.categoryid,
+							" . FORECAST_EFFECTIVE_QTY . " AS fqty,
+							(SELECT COALESCE(SUM(h.qty), 0)
+								FROM forecasthistory AS h
+								WHERE h.stockid = forecasts.stockid
+								AND h.monthstart = forecastlines.periodstart
+								AND (forecasts.loccode = '' OR h.loccode = forecasts.loccode)) AS actual
+						FROM forecasts
+						INNER JOIN forecastlines ON forecastlines.forecastid = forecasts.forecastid
+						INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+						WHERE " . $Where);
+
+	$ByItem = array();
+	$ByCategory = array();
+	$ByMethod = array();
+	$Overall = array();
+	while ($Row = DB_fetch_array($Result)) {
+		$Sums = ForecastErrorSums(array((float) $Row['actual']), array((float) $Row['fqty']));
+		$ItemKey = $Row['stockid'] . "\t" . $Row['loccode'] . "\t" . $Row['method'];
+		$ByItem[$ItemKey] = ForecastAddSums(isset($ByItem[$ItemKey]) ? $ByItem[$ItemKey] : array(), $Sums);
+		$ByCategory[$Row['categoryid']] = ForecastAddSums(isset($ByCategory[$Row['categoryid']]) ? $ByCategory[$Row['categoryid']] : array(), $Sums);
+		$ByMethod[$Row['method']] = ForecastAddSums(isset($ByMethod[$Row['method']]) ? $ByMethod[$Row['method']] : array(), $Sums);
+		$Overall = ForecastAddSums($Overall, $Sums);
+	}
+
+	if (count($ByItem) == 0) {
+		prnMsg(__('There are no forecasts for months that have been sold in this range'), 'info');
+		include('includes/footer.php');
+		exit();
+	}
+
+	$Header = '<th>' . __('Periods') . '</th><th>' . __('MAD') . '</th><th>' . __('POA %') . '</th><th>' . __('MSE') . '</th><th>' . __('RMSE') . '</th>';
+	$MeasureCells = function ($Sums) {
+		$M = ForecastMeasures($Sums);
+		return '<td class="number">' . $M['n'] . '</td>
+				<td class="number">' . ForecastFormatMeasure($M['mad']) . '</td>
+				<td class="number">' . ForecastFormatMeasure($M['poa'], 1) . '</td>
+				<td class="number">' . ForecastFormatMeasure($M['mse']) . '</td>
+				<td class="number">' . ForecastFormatMeasure($M['rmse']) . '</td>';
+	};
+
+	echo '<br /><table class="selection"><tr><th>' . __('All forecasts compared') . '</th>' . $Header . '</tr><tr class="striped_row"><td>' . ForecastMonthLabel($From) . ' - ' . ForecastMonthLabel($To) . '</td>' . $MeasureCells($Overall) . '</tr></table>';
+
+	ksort($ByMethod);
+	echo '<br /><table class="selection"><tr><th>' . __('Method') . '</th>' . $Header . '</tr>';
+	foreach ($ByMethod as $Method => $Sums) {
+		echo '<tr class="striped_row"><td>' . $Method . ' - ' . ForecastMethodName($Method) . '</td>' . $MeasureCells($Sums) . '</tr>';
+	}
+	echo '</table>';
+
+	ksort($ByCategory);
+	echo '<br /><table class="selection"><tr><th>' . __('Stock category') . '</th>' . $Header . '</tr>';
+	foreach ($ByCategory as $Category => $Sums) {
+		echo '<tr class="striped_row"><td>' . ForecastSummaryLabel('C', $Category) . '</td>' . $MeasureCells($Sums) . '</tr>';
+	}
+	echo '</table>';
+
+	// items, the least accurate first; those below the company threshold are flagged
+	$Poa = array();
+	foreach ($ByItem as $ItemKey => $Sums) {
+		$M = ForecastMeasures($Sums);
+		$Poa[$ItemKey] = ($M['poa'] === null) ? 0 : $M['poa'];
+	}
+	asort($Poa);
+	echo '<br /><table class="selection"><tr><th>' . __('Item') . '</th><th>' . __('Location') . '</th><th>' . __('Method') . '</th>' . $Header . '<th></th></tr>';
+	$Shown = 0;
+	$LowCount = 0;
+	foreach ($Poa as $ItemKey => $ItemPoa) {
+		$IsLow = ($ItemPoa < $LowPOA);
+		$LowCount += $IsLow ? 1 : 0;
+		if (++$Shown > 500) {
+			continue;
+		}
+		list($ItemCode, $Loc, $Method) = explode("\t", $ItemKey);
+		echo '<tr class="striped_row"' . ($IsLow ? ' style="background-color:#fdd"' : '') . '>
+				<td>' . $ItemCode . '</td>
+				<td>' . ($Loc == FORECAST_ALL_LOCATIONS ? __('All locations combined') : $Loc) . '</td>
+				<td>' . ForecastMethodName($Method) . '</td>' . $MeasureCells($ByItem[$ItemKey]) . '
+				<td>' . ($IsLow ? '<b>' . __('Low accuracy') . '</b>' : '') . '</td>
+			</tr>';
+	}
+	echo '</table>';
+	prnMsg($LowCount . ' ' . __('of') . ' ' . count($Poa) . ' ' . __('item forecasts have a POA below') . ' ' . locale_number_format($LowPOA, 0) . '%' . (count($Poa) > 500 ? ' - ' . __('only the 500 least accurate are listed') : ''), $LowCount > 0 ? 'warn' : 'success');
+}
+
+include('includes/footer.php');
diff --git a/ForecastCompare.php b/ForecastCompare.php
new file mode 100644
index 0000000..a4895bc
--- /dev/null
+++ b/ForecastCompare.php
@@ -0,0 +1,144 @@
+<?php
+
+// Method comparison: one item's history forecast with several methods side by side with their accuracy.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Method Comparison');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastCompare';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Defaults = ForecastDefaults();
+$Held = ForecastHistoryRange();
+$Self = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+
+if ($Held['from'] === null) {
+	prnMsg(__('No sales history has been extracted yet, extract it first'), 'warn');
+	include('includes/footer.php');
+	exit();
+}
+
+$StockID = isset($_POST['StockID']) ? mb_strtoupper(trim($_POST['StockID'])) : (isset($_GET['StockID']) ? mb_strtoupper(trim($_GET['StockID'])) : '');
+$LocCode = isset($_POST['Location']) ? $_POST['Location'] : FORECAST_ALL_LOCATIONS;
+$Holdout = isset($_POST['Holdout']) ? (int) $_POST['Holdout'] : (int) $Defaults['HoldoutMonths'];
+$Selected = (isset($_POST['Methods']) and is_array($_POST['Methods'])) ? array_map('intval', $_POST['Methods']) : (isset($_POST['Compare']) ? array() : array_keys(ForecastMethodNames()));
+
+echo '<form method="post" action="' . $Self . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Item to compare') . '</legend>
+		<field>
+			<label for="StockID">' . __('Item code') . ':</label>
+			<input type="text" name="StockID" size="21" maxlength="64" value="' . $StockID . '" />
+		</field>
+		<field>
+			<label for="Location">' . __('Stock location') . ':</label>
+			<select name="Location">' . ForecastLocationOptions($LocCode, __('All locations combined')) . '</select>
+		</field>
+		<field>
+			<label for="Holdout">' . __('Most recent months held out and forecast') . ':</label>
+			<input type="text" class="number" name="Holdout" size="4" value="' . $Holdout . '" />
+		</field>
+		<field>
+			<label>' . __('Methods') . ':</label>
+			<div>';
+foreach (ForecastMethodNames() as $Id => $Name) {
+	echo '<input type="checkbox" name="Methods[]" value="' . $Id . '"' . (in_array($Id, $Selected) ? ' checked="checked"' : '') . ' /> ' . $Id . ' - ' . $Name . '<br />';
+}
+echo '</div>
+		</field>
+	</fieldset>
+	<fieldset>
+		<legend>' . __('Method parameters') . '</legend>' . ForecastParamFields($_POST, $Defaults) . '
+	</fieldset>
+	<div class="centre"><input type="submit" name="Compare" value="' . __('Compare methods') . '" /></div>
+	</form>';
+
+if (isset($_POST['Compare'])) {
+	list($Params, $ParamErrors) = ForecastParamsFromInput($_POST, $Defaults);
+	$Errors = array();
+	foreach ($Selected as $Id) {
+		foreach (ForecastRelevantErrors($ParamErrors, $Id) as $Error) {
+			$Errors[$Error] = $Error;
+		}
+	}
+	$Result = DB_query("SELECT description FROM stockmaster WHERE stockid = '" . $StockID . "'");
+	if (DB_num_rows($Result) == 0) {
+		$Errors[] = __('Enter the code of an existing item');
+	}
+	if (count($Selected) == 0) {
+		$Errors[] = __('Select at least one method');
+	}
+	if ($Holdout < 1 or $Holdout > 12) {
+		$Errors[] = __('The months held out for the accuracy test must be between 1 and 12');
+	}
+	if (count($Errors) > 0) {
+		foreach ($Errors as $Error) {
+			prnMsg($Error, 'error');
+		}
+	} else {
+		$Series = ForecastItemSeries($StockID, $LocCode, $Held['to']);
+		$N = count($Series['values']);
+		if ($N == 0) {
+			prnMsg(__('There is no sales history for this item'), 'error');
+		} elseif ($N <= $Holdout) {
+			prnMsg(sprintf(__('The item has only %d months of history, fewer than the %d months to hold out'), $N, $Holdout), 'error');
+		} else {
+			$Actual = array_slice($Series['values'], $N - $Holdout);
+			$FirstHeld = ForecastAddMonths($Held['to'], -($Holdout - 1));
+			echo '<br /><p>' . $StockID . ': ' . ForecastMonthLabel($Series['start']) . ' - ' . ForecastMonthLabel($Held['to']) . ' (' . $N . ' ' . __('months') . '). ' . sprintf(__('The last %d months are held out: each method forecasts them from the months before.'), $Holdout) . '</p>';
+
+			$Evaluations = array();
+			$Best = 0;
+			foreach ($Selected as $Id) {
+				$Evaluation = ForecastEvaluate($Id, $Series['values'], $Holdout, $Params);
+				$Evaluations[$Id] = $Evaluation;
+				if (!isset($Evaluation['error']) and ($Best == 0 or $Evaluation['sums']['abs'] < $Evaluations[$Best]['sums']['abs'] - 0.0000001)) {
+					$Best = $Id;
+				}
+			}
+
+			echo '<table class="selection"><tr>
+					<th>' . __('Method') . '</th>
+					<th>' . __('MAD') . '</th>
+					<th>' . __('POA %') . '</th>
+					<th>' . __('MSE') . '</th>
+					<th>' . __('RMSE') . '</th>';
+			$Month = $FirstHeld;
+			for ($i = 0; $i < $Holdout; $i++) {
+				echo '<th>' . ForecastMonthLabel($Month) . '</th>';
+				$Month = ForecastAddMonths($Month, 1);
+			}
+			echo '</tr><tr><td><b>' . __('Actual') . '</b></td><td colspan="4"></td>';
+			foreach ($Actual as $Value) {
+				echo '<td class="number"><b>' . locale_number_format($Value, 2) . '</b></td>';
+			}
+			echo '</tr>';
+			ksort($Evaluations);
+			foreach ($Evaluations as $Id => $Evaluation) {
+				if (isset($Evaluation['error'])) {
+					echo '<tr class="striped_row"><td>' . $Id . ' - ' . ForecastMethodName($Id) . '</td><td colspan="' . (4 + $Holdout) . '">' . $Evaluation['error'] . '</td></tr>';
+					continue;
+				}
+				$Measures = ForecastMeasures($Evaluation['sums']);
+				echo '<tr class="striped_row"' . ($Id == $Best ? ' style="background-color:#dfd"' : '') . '>
+						<td>' . $Id . ' - ' . ForecastMethodName($Id) . ($Id == $Best ? ' <b>(' . __('best') . ')</b>' : '') . '</td>
+						<td class="number">' . ForecastFormatMeasure($Measures['mad']) . '</td>
+						<td class="number">' . ForecastFormatMeasure($Measures['poa'], 1) . '</td>
+						<td class="number">' . ForecastFormatMeasure($Measures['mse']) . '</td>
+						<td class="number">' . ForecastFormatMeasure($Measures['rmse']) . '</td>';
+				foreach ($Evaluation['forecast'] as $Value) {
+					echo '<td class="number">' . locale_number_format($Value, 2) . '</td>';
+				}
+				echo '</tr>';
+			}
+			echo '</table>';
+		}
+	}
+}
+
+include('includes/footer.php');

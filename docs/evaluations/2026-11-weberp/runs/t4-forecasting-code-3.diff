+// 5. The module goes right after Manufacturing. Every module after it moves one place along, so the
+// flag lists of the existing users get a 'no' inserted at that place: they keep exactly the modules they
+// had, and the administrator decides who also gets Forecasting.
+$Result = DB_query("SELECT modulelink FROM modules WHERE modulelink='forecast'");
+if (DB_num_rows($Result) == 0) {
+	$ModulesBefore = 6;
+	$Result = DB_query("SELECT secroleid, sequence FROM modules WHERE modulelink='manuf' ORDER BY (secroleid=8) DESC, secroleid");
+	if (DB_num_rows($Result) > 0) {
+		$MyRow = DB_fetch_array($Result);
+		$Result = DB_query("SELECT COUNT(*) FROM modules WHERE secroleid='" . $MyRow['secroleid'] . "' AND sequence<='" . $MyRow['sequence'] . "'");
+		$CountRow = DB_fetch_row($Result);
+		$ModulesBefore = (int) $CountRow[0];
+	}
+	executeSQL("UPDATE `modules` AS m INNER JOIN `modules` AS mf ON mf.secroleid=m.secroleid AND mf.modulelink='manuf' SET m.sequence=m.sequence+1 WHERE m.sequence>mf.sequence", false);
+	$Response = executeSQL("INSERT INTO `modules` (`secroleid`, `modulelink`, `reportlink`, `modulename`, `sequence`)
+							SELECT `secroleid`, 'forecast', 'fcst', '" . __('Forecasting') . "', `sequence`+1
+							FROM `modules`
+							WHERE `modulelink`='manuf'", false);
+	if ($Response == 0) {
+		OutputResult(__('The module') . ' ' . __('Forecasting') . ' ' . __('has been inserted'), 'success');
+		// 'a,b,c,d,e,f,g,...,' becomes 'a,b,c,d,e,f,0,g,...,' - the flags list always ends with a comma
+		executeSQL("UPDATE `www_users`
+					SET `modulesallowed`=CONCAT(SUBSTRING_INDEX(`modulesallowed`, ',', " . $ModulesBefore . "),
+												',0,',
+												SUBSTRING(`modulesallowed`, LENGTH(SUBSTRING_INDEX(`modulesallowed`, ',', " . $ModulesBefore . ")) + 2))
+					WHERE LENGTH(`modulesallowed`) - LENGTH(REPLACE(`modulesallowed`, ',', '')) >= " . $ModulesBefore, false);
+	} else {
+		OutputResult(__('The module') . ' ' . __('Forecasting') . ' ' . __('could not be inserted'), 'error');
+	}
+} else {

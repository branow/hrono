+		<tr class="striped_row"><td>' . __('Items with an active forecast') . '</td><td class="number">' . $Forecasts[1] . '</td></tr>
+		<tr class="striped_row"><td>' . __('Revised forecast periods') . '</td><td class="number">' . $Revisions[0] . '</td></tr>
+		<tr class="striped_row"><td>' . __('Active summary forecasts') . '</td><td class="number">' . $Summaries[0] . '</td></tr>
+		<tr class="striped_row"><td>' . __('Sales history range') . '</td><td>' . ($Held['from'] === null ? __('None extracted yet') : ForecastMonthLabel($Held['from']) . ' - ' . ForecastMonthLabel($Held['to'])) . '</td></tr>
+		<tr class="striped_row"><td>' . __('Items and months of history held') . '</td><td class="number">' . $Held['items'] . ' / ' . $Held['months'] . '</td></tr>
+		<tr class="striped_row"><td>' . __('Forecast demands in the MRP master schedule') . '</td><td class="number">' . $Demands[0] . '</td></tr>
+	</table><br />';
+
+$Links = array(
+	'ForecastHistory.php' => __('Extract Sales History'),
+	'ForecastGenerate.php' => __('Generate Forecasts'),
+	'ForecastReview.php' => __('Review and Revise Forecasts'),
+	'ForecastInquiry.php' => __('Forecast Inquiry'),
+	'ForecastSummary.php' => __('Summary Forecasts'),
+	'ForecastSummaryReview.php' => __('Summary Forecast Review'),
+	'ForecastAccuracy.php' => __('Forecast Accuracy'),
+	'ForecastCompare.php' => __('Forecast Method Comparison'),
+	'ForecastToMRP.php' => __('Convert Forecasts to MRP Demands'),
+	'ForecastParameters.php' => __('Forecasting Parameters'),
+	'MRPDemands.php' => __('MRP Master Schedule'),
+	'MRP.php' => __('MRP Calculation'),
+	'MRPReport.php' => __('MRP Report')
+);
+echo '<table class="selection"><tr><th>' . __('Functions') . '</th></tr>';
+foreach ($Links as $Script => $Caption) {
+	if (ForecastMayOpen($Script)) {
+		echo '<tr class="striped_row"><td><a href="' . $RootPath . '/' . $Script . '">' . $Caption . '</a></td></tr>';
+	}
+}
+echo '</table>';
+
+include('includes/footer.php');
diff --git a/ForecastGenerate.php b/ForecastGenerate.php
new file mode 100644
index 0000000..88592ae
--- /dev/null
+++ b/ForecastGenerate.php
@@ -0,0 +1,336 @@
+<?php
+
+// Generates demand forecasts for one item or for every active item of a stock category.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Generate Forecasts');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastGenerate';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Defaults = ForecastDefaults();
+$Held = ForecastHistoryRange();
+$BatchSize = max(1, (int) $Defaults['BatchSize']);
+
+if ($Held['from'] === null) {
+	prnMsg(__('No sales history has been extracted yet, extract it first'), 'warn');
+	echo '<div class="centre"><a href="' . $RootPath . '/ForecastHistory.php">' . __('Extract Sales History') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+$HistoryEnd = $Held['to'];
+
+/* ------------------------------------------------------------ a batch in progress */
+
+if (isset($_GET['Batch'])) {
+	$BatchID = (int) $_GET['Batch'];
+	$Result = DB_query("SELECT * FROM forecastbatches WHERE batchid = " . $BatchID . " AND userid = '" . $_SESSION['UserID'] . "'");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('That batch does not exist'), 'error');
+		include('includes/footer.php');
+		exit();
+	}
+	$Batch = DB_fetch_array($Result);
+	$Params = ForecastParamsDecode($Batch['methodparams']);
+	$ItemsSQL = "SELECT stockid FROM stockmaster
+				WHERE categoryid = '" . $Batch['categoryid'] . "'
+				AND discontinued = 0
+				ORDER BY stockid";
+
+	if ($Batch['phase'] != 'D') {
+		$Result = DB_query($ItemsSQL . " LIMIT " . (int) $Batch['nextitem'] . ", " . $BatchSize);
+		$Processed = 0;
+		while ($Item = DB_fetch_array($Result)) {
+			$Processed++;
+			$StockID = $Item['stockid'];
+			if ($Batch['phase'] == 'E') {
+				// test every method on the held out months and keep the errors for the category verdict
+				$Series = ForecastItemSeries($StockID, $Batch['loccode'], $HistoryEnd);
+				if (count($Series['values']) > 0) {
+					$Fit = ForecastBestFit($Series['values'], $Batch['holdout'], $Params);
+					foreach ($Fit['results'] as $Method => $Evaluation) {
+						DB_query("REPLACE INTO forecastbatchfit (batchid, stockid, method, abserr, actual)
+									VALUES (" . $BatchID . ", '" . $StockID . "', " . $Method . ", " . $Evaluation['sums']['abs'] . ", " . $Evaluation['sums']['actual'] . ")");
+					}
+				}
+			} else {
+				$Method = (int) $Batch['chosenmethod'];
+				if ($Method == 0) {
+					$Outcome = array('error' => __('No method has enough history to be tested on the held out months'));
+				} else {
+					$Outcome = ForecastGenerateItem($StockID, $Batch['loccode'], $Method, $Params, $Batch['horizon'], $Batch['holdout'], $HistoryEnd, $Batch['method'] == 0);
+				}
+				if (isset($Outcome['error'])) {
+					DB_query("REPLACE INTO forecastbatchresults (batchid, stockid, success, message, forecastid)
+								VALUES (" . $BatchID . ", '" . $StockID . "', 0, '" . DB_escape_string(mb_substr($Outcome['error'], 0, 250)) . "', 0)");
+					$Batch['failed']++;
+				} else {
+					DB_query("REPLACE INTO forecastbatchresults (batchid, stockid, success, message, forecastid)
+								VALUES (" . $BatchID . ", '" . $StockID . "', 1, '', " . $Outcome['forecastid'] . ")");
+					$Batch['succeeded']++;
+				}
+			}
+		}
+		$Batch['nextitem'] += $Processed;
+
+		if ($Processed == 0 or $Batch['nextitem'] >= $Batch['totalitems']) {
+			if ($Batch['phase'] == 'E') {
+				// the method that does best across the category: lowest total error relative to total sales,
+				// among the methods that could be tested on at least half of the items that could be tested at all
+				$Result = DB_query("SELECT COUNT(DISTINCT stockid) FROM forecastbatchfit WHERE batchid = " . $BatchID);
+				$Row = DB_fetch_row($Result);
+				$Tested = (int) $Row[0];
+				$Chosen = 0;
+				$ChosenScore = 0;
+				$Result = DB_query("SELECT method, SUM(abserr) AS abserr, SUM(actual) AS actual, COUNT(*) AS items
+									FROM forecastbatchfit
+									WHERE batchid = " . $BatchID . "
+									GROUP BY method
+									ORDER BY method");
+				while ($Row = DB_fetch_array($Result)) {
+					if ($Row['items'] * 2 < $Tested) {
+						continue;
+					}
+					$Score = ($Row['actual'] > 0) ? $Row['abserr'] / $Row['actual'] : $Row['abserr'];
+					if ($Chosen == 0 or $Score < $ChosenScore - 0.0000001) {
+						$Chosen = (int) $Row['method'];
+						$ChosenScore = $Score;
+					}
+				}
+				$Batch['chosenmethod'] = $Chosen;
+				$Batch['phase'] = 'G';
+				$Batch['nextitem'] = 0;
+				$Batch['succeeded'] = 0;
+				$Batch['failed'] = 0;
+			} else {
+				$Batch['phase'] = 'D';
+			}
+		}
+		DB_query("UPDATE forecastbatches SET phase = '" . $Batch['phase'] . "',
+					chosenmethod = " . (int) $Batch['chosenmethod'] . ",
+					nextitem = " . (int) $Batch['nextitem'] . ",
+					succeeded = " . (int) $Batch['succeeded'] . ",
+					failed = " . (int) $Batch['failed'] . "
+				WHERE batchid = " . $BatchID);
+	}
+
+	$BatchURL = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '?Batch=' . $BatchID;
+	$CategoryName = '';
+	$Result = DB_query("SELECT categorydescription FROM stockcategory WHERE categoryid = '" . $Batch['categoryid'] . "'");
+	if ($Row = DB_fetch_row($Result)) {
+		$CategoryName = $Row[0];
+	}
+	echo '<table class="selection">
+			<tr><th colspan="2">' . __('Batch forecast') . ' ' . $BatchID . ' - ' . $Batch['categoryid'] . ' ' . $CategoryName . '</th></tr>
+			<tr class="striped_row"><td>' . __('Location') . '</td><td>' . ($Batch['loccode'] == FORECAST_ALL_LOCATIONS ? __('All locations combined') : $Batch['loccode']) . '</td></tr>
+			<tr class="striped_row"><td>' . __('Method') . '</td><td>' . ($Batch['method'] == 0 ? __('Best fit') . ($Batch['chosenmethod'] > 0 ? ': ' . ForecastMethodName($Batch['chosenmethod']) : '') : ForecastMethodName($Batch['method'])) . '</td></tr>
+			<tr class="striped_row"><td>' . __('Horizon') . '</td><td>' . $Batch['horizon'] . ' ' . __('months') . '</td></tr>
+		</table><br />';
+
+	if ($Batch['phase'] == 'D') {
+		prnMsg($Batch['succeeded'] . ' ' . __('successful') . ', ' . $Batch['failed'] . ' ' . __('failed'), $Batch['failed'] > 0 ? 'warn' : 'success');
+		if ($Batch['method'] == 0 and $Batch['chosenmethod'] == 0) {
+			prnMsg(__('No method could be tested on the held out months for any item of this category'), 'warn');
+		}
+		$ShowAll = isset($_GET['ShowAll']);
+		$Result = DB_query("SELECT forecastbatchresults.stockid, stockmaster.description, forecastbatchresults.success, forecastbatchresults.message
+							FROM forecastbatchresults
+							LEFT JOIN stockmaster ON stockmaster.stockid = forecastbatchresults.stockid
+							WHERE forecastbatchresults.batchid = " . $BatchID . ($ShowAll ? '' : ' AND forecastbatchresults.success = 0') . "
+							ORDER BY forecastbatchresults.success, forecastbatchresults.stockid");
+		echo '<table class="selection">
+				<tr>
+					<th>' . __('Item') . '</th>
+					<th>' . __('Description') . '</th>
+					<th>' . __('Result') . '</th>
+					<th>' . __('Reason') . '</th>
+				</tr>';
+		while ($Row = DB_fetch_array($Result)) {
+			echo '<tr class="striped_row">
+					<td>' . $Row['stockid'] . '</td>
+					<td>' . $Row['description'] . '</td>
+					<td>' . ($Row['success'] ? __('Successful') : __('Failed')) . '</td>
+					<td>' . $Row['message'] . '</td>
+				</tr>';
+		}
+		echo '</table>';
+		echo '<div class="centre">' . ($ShowAll ? '<a href="' . $BatchURL . '">' . __('Show only the failures') . '</a>' : '<a href="' . $BatchURL . '&amp;ShowAll=1">' . __('Show every result') . '</a>') . ' | <a href="' . $RootPath . '/ForecastReview.php">' . __('Review and Revise Forecasts') . '</a></div>';
+	} else {
+		$PhaseText = ($Batch['phase'] == 'E') ? __('Testing the methods on the held out months') : __('Generating forecasts');
+		echo '<div class="centre">
+				<p>' . $PhaseText . ': ' . $Batch['nextitem'] . ' / ' . $Batch['totalitems'] . ' ' . __('items') . '</p>
+				<progress value="' . $Batch['nextitem'] . '" max="' . max(1, $Batch['totalitems']) . '"></progress>
+				<p>' . $Batch['succeeded'] . ' ' . __('successful') . ', ' . $Batch['failed'] . ' ' . __('failed') . '</p>
+				<p><a href="' . $BatchURL . '">' . __('Continue') . '</a></p>
+			</div>
+			<script>setTimeout(function() { window.location.href = "' . $BatchURL . '"; }, 300);</script>';
+	}
+	include('includes/footer.php');
+	exit();
+}
+
+/* ------------------------------------------------------------------ the request */
+
+$Method = isset($_POST['Method']) ? (int) $_POST['Method'] : 0;
+$Horizon = isset($_POST['Horizon']) ? (int) $_POST['Horizon'] : (int) $Defaults['Horizon'];
+$Holdout = isset($_POST['Holdout']) ? (int) $_POST['Holdout'] : (int) $Defaults['HoldoutMonths'];
+$Scope = (isset($_POST['Scope']) and $_POST['Scope'] == 'Category') ? 'Category' : 'Item';
+$LocCode = isset($_POST['Location']) ? $_POST['Location'] : FORECAST_ALL_LOCATIONS;
+$StockID = isset($_POST['StockID']) ? mb_strtoupper(trim($_POST['StockID'])) : (isset($_GET['StockID']) ? mb_strtoupper(trim($_GET['StockID'])) : '');
+$CategoryID = isset($_POST['CategoryID']) ? $_POST['CategoryID'] : '';
+
+if (isset($_POST['Generate'])) {
+	$Errors = array();
+	list($Params, $ParamErrors) = ForecastParamsFromInput($_POST, $Defaults);
+	$Errors = ForecastRelevantErrors($ParamErrors, $Method);
+	if ($Method != 0 and ForecastMethodMinHistory($Method) === null) {
+		$Errors[] = __('Select a forecasting method');
+	}
+	if ($Horizon < 1 or $Horizon > FORECAST_MAX_HORIZON) {
+		$Errors[] = __('The horizon must be between 1 and') . ' ' . FORECAST_MAX_HORIZON . ' ' . __('months');
+	}
+	if ($Holdout < 1 or $Holdout > 12) {
+		$Errors[] = __('The months held out for the accuracy test must be between 1 and 12');
+	}
+	if ($LocCode != FORECAST_ALL_LOCATIONS) {
+		$Result = DB_query("SELECT loccode FROM locations WHERE loccode = '" . $LocCode . "'");
+		if (DB_num_rows($Result) == 0) {
+			$Errors[] = __('The location does not exist');
+		}
+	}
+	if ($Scope == 'Item') {
+		$Result = DB_query("SELECT stockid, description FROM stockmaster WHERE stockid = '" . $StockID . "'");
+		if (DB_num_rows($Result) == 0) {
+			$Errors[] = __('Enter the code of an existing item');
+		} else {
+			$ItemRow = DB_fetch_array($Result);
+		}
+	} else {
+		$Result = DB_query("SELECT COUNT(*) FROM stockmaster WHERE categoryid = '" . $CategoryID . "' AND discontinued = 0");
+		$Row = DB_fetch_row($Result);
+		$ItemCount = (int) $Row[0];
+		if ($ItemCount == 0) {
+			$Errors[] = __('The category has no active items');
+		}
+	}
+
+	if (count($Errors) > 0) {
+		foreach ($Errors as $Error) {
+			prnMsg($Error, 'error');
+		}
+	} elseif ($Scope == 'Category') {
+		DB_query("INSERT INTO forecastbatches (userid, categoryid, loccode, method, methodparams, horizon, holdout, phase, chosenmethod, totalitems, started)
+					VALUES ('" . $_SESSION['UserID'] . "',
+						'" . $CategoryID . "',
+						'" . $LocCode . "',
+						" . $Method . ",
+						'" . DB_escape_string(json_encode($Params)) . "',
+						" . $Horizon . ",
+						" . $Holdout . ",
+						'" . ($Method == 0 ? 'E' : 'G') . "',
+						" . $Method . ",
+						" . $ItemCount . ",
+						NOW())");
+		$BatchID = DB_Last_Insert_ID('forecastbatches', 'batchid');
+		echo '<div class="centre"><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '?Batch=' . $BatchID . '">' . __('Start the batch') . '</a></div>
+			<script>window.location.href = "' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '?Batch=' . $BatchID . '";</script>';
+		include('includes/footer.php');
+		exit();
+	} else {
+		$Outcome = ForecastGenerateItem($StockID, $LocCode, $Method, $Params, $Horizon, $Holdout, $HistoryEnd);
+		if (isset($Outcome['error'])) {
+			prnMsg($StockID . ' - ' . $Outcome['error'], 'error');
+		} else {
+			prnMsg(__('Forecast generated for') . ' ' . $StockID . ' - ' . $ItemRow['description'] . ': 1 ' . __('successful') . ', 0 ' . __('failed'), 'success');
+			echo '<table class="selection">
+					<tr><th colspan="2">' . __('Forecast') . ' ' . $Outcome['forecastid'] . '</th></tr>
+					<tr class="striped_row"><td>' . __('Location') . '</td><td>' . ($LocCode == FORECAST_ALL_LOCATIONS ? __('All locations combined') : $LocCode) . '</td></tr>
+					<tr class="striped_row"><td>' . __('Method') . '</td><td>' . ForecastMethodName($Outcome['method']) . ($Outcome['bestfit'] !== null ? ' (' . __('best fit') . ')' : '') . '</td></tr>
+					<tr class="striped_row"><td>' . __('Parameters') . '</td><td>' . ForecastParamsDescribe($Outcome['method'], ForecastParamsEncode($Outcome['method'], $Params)) . '</td></tr>
+					<tr class="striped_row"><td>' . __('History used') . '</td><td>' . ForecastMonthLabel($Outcome['start']) . ' - ' . ForecastMonthLabel($HistoryEnd) . '</td></tr>
+				</table><br />';
+			if ($Outcome['bestfit'] !== null) {
+				echo '<table class="selection">
+						<tr><th colspan="6">' . sprintf(__('Best fit: accuracy on the last %d months held out'), $Holdout) . '</th></tr>
+						<tr>
+							<th>' . __('Method') . '</th>
+							<th>' . __('MAD') . '</th>
+							<th>' . __('POA %') . '</th>
+							<th>' . __('MSE') . '</th>
+							<th>' . __('RMSE') . '</th>
+							<th>' . __('Result') . '</th>
+						</tr>';
+				foreach (ForecastMethodNames() as $Id => $Name) {
+					if (isset($Outcome['bestfit']['results'][$Id])) {
+						$Measures = ForecastMeasures($Outcome['bestfit']['results'][$Id]['sums']);
+						echo '<tr class="striped_row">
+								<td>' . $Id . ' - ' . $Name . '</td>
+								<td class="number">' . ForecastFormatMeasure($Measures['mad']) . '</td>
+								<td class="number">' . ForecastFormatMeasure($Measures['poa'], 1) . '</td>
+								<td class="number">' . ForecastFormatMeasure($Measures['mse']) . '</td>
+								<td class="number">' . ForecastFormatMeasure($Measures['rmse']) . '</td>
+								<td>' . ($Id == $Outcome['method'] ? '<b>' . __('Recommended') . '</b>' : '') . '</td>
+							</tr>';
+					} else {
+						echo '<tr class="striped_row">
+								<td>' . $Id . ' - ' . $Name . '</td>
+								<td colspan="5">' . $Outcome['bestfit']['errors'][$Id] . '</td>
+							</tr>';
+					}
+				}
+				echo '</table><br />';
+			}
+			ForecastShowValues($HistoryEnd, $Outcome['values']);
+			echo '<div class="centre"><a href="' . $RootPath . '/ForecastReview.php?ForecastID=' . $Outcome['forecastid'] . '">' . __('Review and Revise Forecasts') . '</a></div><br />';
+		}
+	}
+}
+
+/* ------------------------------------------------------------------------ the form */
+
+echo '<p>' . __('History held') . ': ' . ForecastMonthLabel($Held['from']) . ' - ' . ForecastMonthLabel($Held['to']) . ' (' . $Held['months'] . ' ' . __('months') . '). ' . __('Forecasts start with the month after the last month of history. An item with less history than the method needs is reported, not forecast.') . '</p>';
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset>
+		<legend>' . __('What to forecast') . '</legend>
+		<field>
+			<label for="ScopeItem">' . __('A single item') . ':</label>
+			<input type="radio" id="ScopeItem" name="Scope" value="Item"' . ($Scope == 'Item' ? ' checked="checked"' : '') . ' />
+			<input type="text" name="StockID" size="21" maxlength="64" value="' . $StockID . '" />
+		</field>
+		<field>
+			<label for="ScopeCategory">' . __('Every active item of a stock category') . ':</label>
+			<input type="radio" id="ScopeCategory" name="Scope" value="Category"' . ($Scope == 'Category' ? ' checked="checked"' : '') . ' />
+			<select name="CategoryID">' . ForecastCategoryOptions($CategoryID) . '</select>
+		</field>
+		<field>
+			<label for="Location">' . __('Stock location') . ':</label>
+			<select name="Location">' . ForecastLocationOptions($LocCode, __('All locations combined')) . '</select>
+		</field>
+		<field>
+			<label for="Horizon">' . __('Number of future monthly periods') . ':</label>
+			<input type="text" class="number" name="Horizon" size="4" value="' . $Horizon . '" />
+		</field>
+		<field>
+			<label for="Method">' . __('Method') . ':</label>
+			<select name="Method">' . ForecastMethodOptions($Method) . '</select>
+		</field>
+		<field>
+			<label for="Holdout">' . __('Months held out for the best fit test') . ':</label>
+			<input type="text" class="number" name="Holdout" size="4" value="' . $Holdout . '" />
+		</field>
+	</fieldset>
+	<fieldset>
+		<legend>' . __('Method parameters') . '</legend>' . ForecastParamFields($_POST, $Defaults) . '
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="Generate" value="' . __('Generate Forecasts') . '" />
+	</div>
+	</form>';
+
+include('includes/footer.php');
diff --git a/ForecastHistory.php b/ForecastHistory.php
new file mode 100644
index 0000000..1d2b568
--- /dev/null
+++ b/ForecastHistory.php
@@ -0,0 +1,109 @@
+<?php
+
+// Extracts the net invoiced sales of every item into monthly buckets per stock location for forecasting.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Extract Sales History');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastHistory';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$LastComplete = ForecastLastCompleteMonth();
+$Held = ForecastHistoryRange();
+
+if (isset($_POST['Extract'])) {
+	$From = ForecastMonthStart($_POST['FromMonth'] ?? '');
+	$To = ForecastMonthStart($_POST['ToMonth'] ?? '');
+	$InputError = false;
+
+	if ($From === null or $To === null) {
+		prnMsg(__('Enter the first and the last month of the history to extract'), 'error');
+		$InputError = true;
+	} elseif ($From > $To) {
+		prnMsg(__('The first month must not be after the last month'), 'error');
+		$InputError = true;
+	} else {
+		if ($To > $LastComplete) {
+			// a part month would look like a collapse in demand to every method
+			$To = $LastComplete;
+			prnMsg(__('The current month is not complete, the history ends with the last complete month') . ': ' . ForecastMonthLabel($To), 'warn');
+			if ($From > $To) {
+				$InputError = true;
+				prnMsg(__('The first month must not be after the last month'), 'error');
+			}
+		}
+		// the held history has to stay one continuous run of months, else a missing month would read as zero sales
+		if (!$InputError and $Held['from'] !== null
+			and ($To < ForecastAddMonths($Held['from'], -1) or $From > ForecastAddMonths($Held['to'], 1))) {
+			$InputError = true;
+			prnMsg(__('The months to extract must overlap or follow directly on from the history held') . ' (' . ForecastMonthLabel($Held['from']) . ' - ' . ForecastMonthLabel($Held['to']) . '). ' . __('Extract a range that touches it, the history is replaced for the months extracted'), 'error');
+		}
+	}
+
+	if (!$InputError) {
+		$Rows = ForecastExtractHistory($From, $To);
+		prnMsg(__('Sales history for') . ' ' . ForecastMonthLabel($From) . ' - ' . ForecastMonthLabel($To) . ' ' . __('has been replaced') . ': ' . $Rows . ' ' . __('history rows written'), 'success');
+		$Held = ForecastHistoryRange();
+	}
+}
+
+echo '<p>' . __('Actual sales are the invoiced quantities less the credit notes and returns, taken from the stock movements by month and stock location. Extracting a range replaces the history of those months, it does not add to it.') . '</p>';
+
+echo '<table class="selection"><tr><th colspan="2">' . __('History held') . '</th></tr>';
+if ($Held['from'] === null) {
+	echo '<tr><td colspan="2">' . __('No sales history has been extracted yet') . '</td></tr>';
+} else {
+	echo '<tr class="striped_row"><td>' . __('Months') . '</td><td>' . ForecastMonthLabel($Held['from']) . ' - ' . ForecastMonthLabel($Held['to']) . ' (' . $Held['months'] . ')</td></tr>
+		<tr class="striped_row"><td>' . __('Items') . '</td><td class="number">' . $Held['items'] . '</td></tr>
+		<tr class="striped_row"><td>' . __('History rows') . '</td><td class="number">' . $Held['rows'] . '</td></tr>';
+}
+echo '</table><br />';
+
+$DefaultTo = isset($_POST['ToMonth']) ? $_POST['ToMonth'] : substr($LastComplete, 0, 7);
+$DefaultFrom = isset($_POST['FromMonth']) ? $_POST['FromMonth'] : substr(ForecastAddMonths($LastComplete, -23), 0, 7);
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset>
+		<legend>' . __('Months to extract') . '</legend>
+		<field>
+			<label for="FromMonth">' . __('From month') . ':</label>
+			<input type="month" name="FromMonth" required="required" value="' . $DefaultFrom . '" />
+		</field>
+		<field>
+			<label for="ToMonth">' . __('To month') . ':</label>
+			<input type="month" name="ToMonth" required="required" value="' . $DefaultTo . '" />
+			<fieldhelp>' . __('24 months are recommended. The last month cannot be later than the last complete month') . '</fieldhelp>
+		</field>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="Extract" value="' . __('Extract Sales History') . '" />
+	</div>
+	</form>';
+
+if ($Held['from'] !== null) {
+	$Result = DB_query("SELECT monthstart, COUNT(DISTINCT stockid) AS items, SUM(qty) AS qty
+						FROM forecasthistory
+						GROUP BY monthstart
+						ORDER BY monthstart");
+	echo '<br /><table class="selection">
+			<tr>
+				<th>' . __('Month') . '</th>
+				<th>' . __('Items sold') . '</th>
+				<th>' . __('Net quantity') . '</th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . ForecastMonthLabel($MyRow['monthstart']) . '</td>
+				<td class="number">' . $MyRow['items'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['qty'], 2) . '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/ForecastInquiry.php b/ForecastInquiry.php
new file mode 100644
index 0000000..ec562e2
--- /dev/null
+++ b/ForecastInquiry.php
@@ -0,0 +1,126 @@
+<?php
+
+// Inquiry on forecasts by item, category, location and period.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Inquiry');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastInquiry';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Self = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$StockID = isset($_POST['StockID']) ? mb_strtoupper(trim($_POST['StockID'])) : '';
+$CategoryID = isset($_POST['CategoryID']) ? $_POST['CategoryID'] : '';
+$LocCode = isset($_POST['Location']) ? $_POST['Location'] : '*';
+$FromMonth = isset($_POST['FromMonth']) ? $_POST['FromMonth'] : '';
+$ToMonth = isset($_POST['ToMonth']) ? $_POST['ToMonth'] : '';
+
+echo '<form method="post" action="' . $Self . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Select the forecasts') . '</legend>
+		<field>
+			<label for="StockID">' . __('Item code contains') . ':</label>
+			<input type="text" name="StockID" size="21" maxlength="64" value="' . $StockID . '" />
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category') . ':</label>
+			<select name="CategoryID">' . ForecastCategoryOptions($CategoryID, __('All categories')) . '</select>
+		</field>
+		<field>
+			<label for="Location">' . __('Stock location') . ':</label>
+			<select name="Location"><option value="*"' . ($LocCode === '*' ? ' selected="selected"' : '') . '>' . __('Any location') . '</option>' . ForecastLocationOptions($LocCode, __('All locations combined')) . '</select>
+		</field>
+		<field>
+			<label for="FromMonth">' . __('Periods from') . ':</label>
+			<input type="month" name="FromMonth" value="' . $FromMonth . '" />
+		</field>
+		<field>
+			<label for="ToMonth">' . __('Periods to') . ':</label>
+			<input type="month" name="ToMonth" value="' . $ToMonth . '" />
+		</field>
+		<field>
+			<label for="Superseded">' . __('Include superseded forecasts') . ':</label>
+			<input type="checkbox" name="Superseded" value="1"' . (isset($_POST['Superseded']) ? ' checked="checked"' : '') . ' />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Search" value="' . __('Search') . '" /></div>
+	</form>';
+
+if (isset($_POST['Search'])) {
+	$Where = "1 = 1";
+	if (!isset($_POST['Superseded'])) {
+		$Where .= " AND forecasts.activekey = 1";
+	}
+	if ($StockID != '') {
+		$Where .= " AND forecasts.stockid LIKE '%" . $StockID . "%'";
+	}
+	if ($CategoryID != '') {
+		$Where .= " AND stockmaster.categoryid = '" . $CategoryID . "'";
+	}
+	if ($LocCode !== '*') {
+		$Where .= " AND forecasts.loccode = '" . $LocCode . "'";
+	}
+	if (ForecastMonthStart($FromMonth) !== null) {
+		$Where .= " AND forecastlines.periodstart >= '" . ForecastMonthStart($FromMonth) . "'";
+	}
+	if (ForecastMonthStart($ToMonth) !== null) {
+		$Where .= " AND forecastlines.periodstart <= '" . ForecastMonthStart($ToMonth) . "'";
+	}
+	$Limit = 2000;
+	$Result = DB_query("SELECT forecasts.forecastid, forecasts.stockid, forecasts.loccode, forecasts.method, forecasts.activekey,
+							stockmaster.description, stockmaster.categoryid,
+							forecastlines.periodstart, forecastlines.calcqty, forecastlines.revisedqty,
+							" . FORECAST_EFFECTIVE_QTY . " AS quantity
+						FROM forecasts
+						INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+						INNER JOIN forecastlines ON forecastlines.forecastid = forecasts.forecastid
+						WHERE " . $Where . "
+						ORDER BY forecasts.stockid, forecasts.loccode, forecasts.forecastid, forecastlines.periodstart
+						LIMIT " . ($Limit + 1));
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('No forecasts match the selection'), 'info');
+	} else {
+		echo '<table class="selection">
+				<tr>
+					<th>' . __('Item') . '</th>
+					<th>' . __('Description') . '</th>
+					<th>' . __('Category') . '</th>
+					<th>' . __('Location') . '</th>
+					<th>' . __('Method') . '</th>
+					<th>' . __('Period') . '</th>
+					<th>' . __('Calculated quantity') . '</th>
+					<th>' . __('Revised quantity') . '</th>
+					<th>' . __('Quantity used') . '</th>
+					<th>' . __('Status') . '</th>
+				</tr>';
+		$Rows = 0;
+		while ($Row = DB_fetch_array($Result)) {
+			if (++$Rows > $Limit) {
+				break;
+			}
+			echo '<tr class="striped_row">
+					<td><a href="' . $RootPath . '/ForecastReview.php?ForecastID=' . $Row['forecastid'] . '">' . $Row['stockid'] . '</a></td>
+					<td>' . $Row['description'] . '</td>
+					<td>' . $Row['categoryid'] . '</td>
+					<td>' . ($Row['loccode'] == FORECAST_ALL_LOCATIONS ? __('All locations combined') : $Row['loccode']) . '</td>
+					<td>' . ForecastMethodName($Row['method']) . '</td>
+					<td>' . ForecastMonthLabel($Row['periodstart']) . '</td>
+					<td class="number">' . locale_number_format($Row['calcqty'], 2) . '</td>
+					<td class="number">' . ($Row['revisedqty'] === null ? '' : locale_number_format($Row['revisedqty'], 2)) . '</td>
+					<td class="number"><b>' . locale_number_format($Row['quantity'], 2) . '</b></td>
+					<td>' . ($Row['activekey'] == 1 ? __('Active') : __('Superseded')) . '</td>
+				</tr>';
+		}
+		echo '</table>';
+		if ($Rows > $Limit) {
+			prnMsg(sprintf(__('Only the first %d rows are shown, narrow the selection'), $Limit), 'warn');
+		}
+	}
+}
+
+include('includes/footer.php');

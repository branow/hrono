+
+$Title = __('Forecasting Dashboard');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastDashboard';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Held = ForecastHistoryRange();
+
+$Result = DB_query("SELECT COUNT(*), COUNT(DISTINCT stockid) FROM forecasts WHERE activekey = 1");
+$Forecasts = DB_fetch_row($Result);
+$Result = DB_query("SELECT COUNT(*) FROM forecastsummaries WHERE activekey = 1");

+<?php
+
+// Company-wide default parameters of the forecasting module, edited by an administrator.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecasting Parameters');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastParameters';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+// name => array(label, minimum, maximum, whole number)
+$Fields = array(
+	'Alpha' => array(__('Smoothing constant alpha'), 0.1, 0.9, false),
+	'Beta' => array(__('Smoothing constant beta'), 0.1, 0.9, false),
+	'Gamma' => array(__('Smoothing constant gamma'), 0.1, 0.9, false),
+	'SeasonLength' => array(__('Season length in months'), 2, 12, true),
+	'MAPeriods' => array(__('Moving average periods'), 2, 24, true),
+	'HoldoutMonths' => array(__('Months held out for the best fit test'), 1, 12, true),
+	'Horizon' => array(__('Default horizon in months'), 1, FORECAST_MAX_HORIZON, true),
+	'GrowthPercent' => array(__('Default percent over last year'), -100, 1000, false),
+	'LowAccuracyPOA' => array(__('Flag items with a POA below'), 0, 100, false),
+	'BatchSize' => array(__('Items processed per step of a batch'), 1, 500, true)
+);
+
+$Current = ForecastDefaults();
+
+if (isset($_POST['Save'])) {
+	$InputError = false;
+	$New = array();
+	foreach ($Fields as $Name => $Field) {
+		$Number = isset($_POST[$Name]) ? ForecastNumber($_POST[$Name]) : null;
+		if ($Number === null or $Number < $Field[1] or $Number > $Field[2] or ($Field[3] and $Number != floor($Number))) {
+			$InputError = true;
+			prnMsg($Field[0] . ': ' . sprintf(__('enter a %s between %s and %s'), $Field[3] ? __('whole number') : __('number'), $Field[1], $Field[2]), 'error');
+		} else {
+			$New[$Name] = $Number;
+		}
+	}
+	if (!$InputError) {
+		foreach ($New as $Name => $Number) {
+			DB_query("REPLACE INTO forecastparameters (paramname, paramvalue) VALUES ('" . $Name . "', '" . $Number . "')");
+		}
+		prnMsg(__('The forecasting parameters have been saved'), 'success');
+		$Current = ForecastDefaults();
+	}
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Defaults used when the user does not override them') . '</legend>';
+foreach ($Fields as $Name => $Field) {
+	$Value = isset($_POST[$Name]) ? $_POST[$Name] : $Current[$Name];
+	echo '<field>
+			<label for="' . $Name . '">' . $Field[0] . ':</label>
+			<input type="text" class="number" name="' . $Name . '" size="6" value="' . htmlspecialchars($Value, ENT_QUOTES, 'UTF-8') . '" />
+		</field>';
+}
+echo '</fieldset>
+	<div class="centre"><input type="submit" name="Save" value="' . __('Save') . '" /></div>
+	</form>';
+
+include('includes/footer.php');
diff --git a/ForecastReview.php b/ForecastReview.php
new file mode 100644
index 0000000..8de5304

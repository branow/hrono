+<?php
+
+/* HR starts and cancels staff appraisals */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Staff Appraisals');// Screen identification.
+$ViewTopic = 'Labour';// Filename's id in ManualContents.php's TOC.
+$BookMark = 'StartingAppraisals';// Anchor's id in the manual's html document.
+include('includes/header.php');
+include('includes/SQL_CommonFunctions.php');
+include('includes/AppraisalFunctions.php');
+
+echo '<p class="page_title_text"><img alt="" src="', $RootPath, '/css/', $Theme,
+	'/images/user.png" title="',// Icon image.
+	__('Staff Appraisals'), '" /> ',// Icon title.
+	__('Staff Appraisals'), '</p>';// Page title.
+
+$TypeLabels = AppraisalTypeLabels();
+$StatusLabels = AppraisalStatusLabels();
+
+if (isset($_POST['EmployeeID'])) {
+	$SelectedEmployee = (int)$_POST['EmployeeID'];
+} elseif (isset($_GET['EmployeeID'])) {
+	$SelectedEmployee = (int)$_GET['EmployeeID'];
+}
+if (isset($_POST['AppraisalType'])) {
+	$SelectedType = (int)$_POST['AppraisalType'];
+} elseif (isset($_GET['Type'])) {
+	$SelectedType = (int)$_GET['Type'];
+}
+if (isset($SelectedEmployee) and $SelectedEmployee == 0) {
+	unset($SelectedEmployee);
+}
+if (!isset($SelectedType) or !isset($TypeLabels[$SelectedType])) {
+	$SelectedType = APPRAISAL_ANNUAL;
+}
+
+/* Cancel an appraisal that has not been completed */
+if (isset($_POST['CancelAppraisal'])) {
+	$Result = DB_query("UPDATE appraisals
+						SET status='" . APPRAISAL_CANCELLED . "'
+						WHERE appraisalid='" . (int)$_POST['AppraisalID'] . "'
+						AND status='" . APPRAISAL_OPEN . "'");
+	if (DB_affected_rows($Result) == 1) {
+		prnMsg(__('The appraisal has been cancelled'), 'success');
+	} else {
+		prnMsg(__('Only an appraisal that has not been completed can be cancelled'), 'warn');
+	}
+}
+
+/* Start an appraisal */
+if (isset($_POST['StartAppraisal'])) {
+	$InputError = 0;
+
+	if (!isset($SelectedEmployee)) {
+		$SelectedEmployee = 0;
+	}
+	$EmployeeResult = DB_query("SELECT id, firstname, surname, manager, active
+								FROM employees
+								WHERE id='" . $SelectedEmployee . "'");
+	if (DB_num_rows($EmployeeResult) == 0) {
+		$InputError = 1;
+		prnMsg(__('The member of staff to be appraised must be selected'), 'error');
+	} else {
+		$EmployeeRow = DB_fetch_array($EmployeeResult);
+		if ($EmployeeRow['active'] != 1) {
+			$InputError = 1;
+			prnMsg(__('This person has left, so they are not due appraisals'), 'error');
+		}
+	}
+
+	if (!isset($_POST['AppraisalType']) or ($_POST['AppraisalType'] != APPRAISAL_ANNUAL and $_POST['AppraisalType'] != APPRAISAL_MIDYEAR)) {
+		$InputError = 1;
+		prnMsg(__('The type of appraisal must be annual or mid-year'), 'error');
+	}
+
+	$DueDateSQL = AppraisalDateToSQL(isset($_POST['DueDate']) ? $_POST['DueDate'] : '');
+	if ($DueDateSQL === false) {
+		$InputError = 1;
+		prnMsg(__('The date the appraisal is due must be entered as a valid date in the format') . ' ' . $_SESSION['DefaultDateFormat'], 'error');
+	}
+
+	if ($InputError == 0) {
+		// the reviewer is the manager unless HR chose someone else further up the reporting line
+		$Chain = GetReportingChain($SelectedEmployee);
+		if (isset($_POST['ReviewerID']) and $_POST['ReviewerID'] != '') {
+			$ReviewerID = (int)$_POST['ReviewerID'];
+		} elseif (count($Chain) > 0) {
+			$ReviewerID = $Chain[0];
+		} else {
+			$ReviewerID = 0;
+		}
+		if (!in_array($ReviewerID, $Chain)) {
+			$InputError = 1;
+			prnMsg(__('The reviewer must be above the person in the reporting line: their manager, their manager\'s manager, and so on'), 'error');
+		} else {
+			$ReviewerResult = DB_query("SELECT id, firstname, surname, email, userid, active
+										FROM employees
+										WHERE id='" . $ReviewerID . "'");
+			$ReviewerRow = DB_fetch_array($ReviewerResult);
+			if ($ReviewerRow['active'] != 1) {
+				$InputError = 1;
+				prnMsg(__('The reviewer has left. Another reviewer above the person in the reporting line must be chosen'), 'error');
+			} elseif ($ReviewerRow['userid'] == '') {
+				$InputError = 1;
+				prnMsg(__('The reviewer is not a webERP user so cannot do the appraisal. Another reviewer above the person in the reporting line must be chosen'), 'error');
+			}
+		}
+	}
+
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+		// lock the person's record so that two appraisals cannot be started for them at the same time
+		DB_query("SELECT id FROM employees WHERE id='" . $SelectedEmployee . "' FOR UPDATE", '', '', true);
+		$OpenResult = DB_query("SELECT COUNT(*) FROM appraisals
+								WHERE employeeid='" . $SelectedEmployee . "'
+								AND status='" . APPRAISAL_OPEN . "'", '', '', true);
+		$OpenRow = DB_fetch_row($OpenResult);
+		if ($OpenRow[0] > 0) {
+			DB_Txn_Commit(); // nothing has been written - this releases the lock and restores autocommit
+			prnMsg(__('This person already has an appraisal that has not been completed or cancelled'), 'error');
+		} else {
+			DB_query("INSERT INTO appraisals (employeeid,
+											reviewerid,
+											appraisaltype,
+											status,
+											startdate,
+											duedate,
+											startedby)
+						VALUES ('" . $SelectedEmployee . "',
+								'" . $ReviewerID . "',
+								'" . (int)$_POST['AppraisalType'] . "',
+								'" . APPRAISAL_OPEN . "',
+								'" . date('Y-m-d') . "',
+								'" . $DueDateSQL . "',
+								'" . $_SESSION['UserID'] . "')",
+						__('The appraisal could not be started because'), '', true);
+			$AppraisalID = DB_Last_Insert_ID('appraisals', 'appraisalid');
+			DB_Txn_Commit();
+
+			prnMsg(__('The appraisal has been started'), 'success');
+
+			// tell the reviewer that the appraisal is waiting for them
+			if ($ReviewerRow['email'] == '') {
+				prnMsg(__('The reviewer has no email address, so they have not been told about the appraisal'), 'warn');
+			} else {
+				$EmailSubject = __('Appraisal waiting for you') . ': ' . $EmployeeRow['firstname'] . ' ' . $EmployeeRow['surname'];
+				$EmailBody = '<p>' . $ReviewerRow['firstname'] . ' ' . $ReviewerRow['surname'] . ',</p>
+					<p>' . __('The') . ' ' . $TypeLabels[(int)$_POST['AppraisalType']] . ' ' . __('appraisal of') . ' ' . $EmployeeRow['firstname'] . ' ' . $EmployeeRow['surname'] . ' ' . __('is waiting for you. It is due on') . ' ' . ConvertSQLDate($DueDateSQL) . '.</p>
+					<p><a href="' . AppraisalLink('AppraisalReview.php', 'AppraisalID=' . $AppraisalID) . '">' . __('Open the appraisal') . '</a></p>';
+				$EmailResult = SendEmailFromWebERP($_SESSION['CompanyRecord']['email'],
+												array($ReviewerRow['email']),
+												$EmailSubject,
+												$EmailBody,
+												'',
+												true);
+				if ($EmailResult === true) {
+					prnMsg(__('The reviewer has been told by email'), 'success');
+				} else {
+					prnMsg(__('The appraisal was started but the email to the reviewer could not be sent'), 'warn');
+				}
+			}
+			unset($SelectedEmployee);
+			unset($_POST['DueDate']);
+		}
+	}
+}
+
+/* Choose the person to be appraised and, once chosen, the details of the appraisal */
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Start an Appraisal'), '</legend>
+		<field>
+			<label for="EmployeeID">', __('Member of staff'), ':</label>
+			<select name="EmployeeID" id="EmployeeID">';
+if (!isset($SelectedEmployee)) {
+	echo '<option selected="selected" value="">', __('Select a member of staff'), '</option>';
+}
+$EmployeesResult = DB_query("SELECT id, firstname, surname
+							FROM employees
+							WHERE active=1
+							ORDER BY surname, firstname");
+while ($MyRow = DB_fetch_array($EmployeesResult)) {
+	echo '<option', (isset($SelectedEmployee) and $SelectedEmployee == $MyRow['id']) ? ' selected="selected"' : '', ' value="', $MyRow['id'], '">', $MyRow['firstname'], ' ', $MyRow['surname'], '</option>';
+}
+echo '</select>
+			<input type="submit" name="ChooseEmployee" value="', __('Select'), '" />
+		</field>';
+
+if (isset($SelectedEmployee)) {
+	$Chain = GetReportingChain($SelectedEmployee);
+	echo '<field>
+			<label for="AppraisalType">', __('Type of appraisal'), ':</label>
+			<select name="AppraisalType" id="AppraisalType">';
+	foreach ($TypeLabels as $TypeID => $TypeLabel) {
+		echo '<option', ($SelectedType == $TypeID) ? ' selected="selected"' : '', ' value="', $TypeID, '">', $TypeLabel, '</option>';
+	}
+	echo '</select>
+		</field>
+		<field>
+			<label for="DueDate">', __('Due date'), ':</label>
+			<input type="text" name="DueDate" id="DueDate" required="required" size="11" maxlength="10" placeholder="', $_SESSION['DefaultDateFormat'], '" value="', isset($_POST['DueDate']) ? $_POST['DueDate'] : '', '" />
+			<fieldhelp>', __('Enter the date in the format'), ' ', $_SESSION['DefaultDateFormat'], '</fieldhelp>
+		</field>
+		<field>
+			<label for="ReviewerID">', __('Reviewer'), ':</label>';
+	if (count($Chain) == 0) {
+		echo '<fieldtext>', __('This person has no manager, so there is nobody above them to review the appraisal'), '</fieldtext>';
+	} else {
+		echo '<select name="ReviewerID" id="ReviewerID">';
+		$FirstReviewer = true;
+		foreach ($Chain as $ChainID) {
+			$ChainResult = DB_query("SELECT firstname, surname, userid, active FROM employees WHERE id='" . $ChainID . "'");
+			$ChainRow = DB_fetch_array($ChainResult);
+			if ($ChainRow['active'] != 1 or $ChainRow['userid'] == '') {
+				continue; // someone who has left or cannot log in cannot do the appraisal
+			}
+			$IsDefault = ($ChainID == $Chain[0]);
+			if (isset($_POST['ReviewerID']) and $_POST['ReviewerID'] != '') {
+				$IsDefault = ($_POST['ReviewerID'] == $ChainID);
+			}
+			echo '<option', $IsDefault ? ' selected="selected"' : '', ' value="', $ChainID, '">', $ChainRow['firstname'], ' ', $ChainRow['surname'], ($ChainID == $Chain[0]) ? ' (' . __('manager') . ')' : '', '</option>';
+		}
+		echo '</select>
+			<fieldhelp>', __('The reviewer is the manager unless another person above in the reporting line is chosen'), '</fieldhelp>';
+	}
+	echo '</field>';
+}
+echo '</fieldset>';
+if (isset($SelectedEmployee)) {
+	echo '<div class="centre">
+			<input type="submit" name="StartAppraisal" value="', __('Start Appraisal'), '" />
+		</div>';
+}
+echo '</form><br />';
+
+/* All the appraisals */
+$SQL = "SELECT appraisals.appraisalid,
+				appraisals.appraisaltype,
+				appraisals.status,
+				appraisals.duedate,
+				appraisals.completeddate,
+				appraisals.overallrating,
+				employees.firstname,
+				employees.surname,
+				reviewers.firstname AS reviewerfirstname,
+				reviewers.surname AS reviewersurname
+		FROM appraisals
+		INNER JOIN employees ON appraisals.employeeid=employees.id
+		INNER JOIN employees AS reviewers ON appraisals.reviewerid=reviewers.id
+		ORDER BY appraisals.status, appraisals.duedate DESC, appraisals.appraisalid DESC";
+$Result = DB_query($SQL);
+if (DB_num_rows($Result) > 0) {
+	echo '<table class="selection">
+		<thead>
+			<tr>
+				<th class="SortedColumn">', __('Member of staff'), '</th>
+				<th class="SortedColumn">', __('Type'), '</th>
+				<th class="SortedColumn">', __('Due date'), '</th>
+				<th class="SortedColumn">', __('Reviewer'), '</th>
+				<th class="SortedColumn">', __('Status'), '</th>
+				<th class="SortedColumn">', __('Completed'), '</th>
+				<th class="SortedColumn">', __('Overall result'), '</th>
+				<th class="noPrint">&nbsp;</th>
+			</tr>
+		</thead>
+		<tbody>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>', $MyRow['firstname'], ' ', $MyRow['surname'], '</td>
+				<td>', $TypeLabels[$MyRow['appraisaltype']], '</td>
+				<td>', ConvertSQLDate($MyRow['duedate']), '</td>
+				<td>', $MyRow['reviewerfirstname'], ' ', $MyRow['reviewersurname'], '</td>
+				<td>', $StatusLabels[$MyRow['status']], '</td>
+				<td>', ($MyRow['completeddate'] === null) ? '' : ConvertSQLDate($MyRow['completeddate']), '</td>
+				<td>', ($MyRow['status'] == APPRAISAL_COMPLETED) ? AppraisalOverallText($MyRow['overallrating']) : AppraisalOverallText(null), '</td>

@@ -0,0 +1,103 @@
+<?php
+
+/* The staff who are due an appraisal */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Appraisals Due');// Screen identification.
+$ViewTopic = 'Labour';// Filename's id in ManualContents.php's TOC.
+$BookMark = 'AppraisalsDue';// Anchor's id in the manual's html document.
+include('includes/header.php');
+include('includes/AppraisalFunctions.php');
+
+echo '<p class="page_title_text"><img alt="" src="', $RootPath, '/css/', $Theme,
+	'/images/user.png" title="',// Icon image.
+	__('Appraisals Due'), '" /> ',// Icon title.
+	__('Appraisals Due'), '</p>';// Page title.
+
+$Frequency = GetAppraisalFrequency();
+$TypeLabels = AppraisalTypeLabels();
+$Today = date('Y-m-d');
+
+echo '<div class="page_help_text">', __('Annual appraisals are due every'), ' ', $Frequency, ' ', __('months'), '. ',
+	__('A mid-year appraisal is due six months after the last annual appraisal'), '.</div><br />';
+
+// Everyone still with us who has no appraisal open now, with the dates of their last completed appraisals
+$SQL = "SELECT employees.id,
+				employees.firstname,
+				employees.surname,
+				employees.jobtitle,
+				departments.description AS departmentname,
+				managers.firstname AS managerfirstname,
+				managers.surname AS managersurname,
+				(SELECT MAX(appraisals.completeddate) FROM appraisals
+					WHERE appraisals.employeeid=employees.id
+					AND appraisals.status='" . APPRAISAL_COMPLETED . "'
+					AND appraisals.appraisaltype='" . APPRAISAL_ANNUAL . "') AS lastannual,
+				(SELECT MAX(appraisals.completeddate) FROM appraisals
+					WHERE appraisals.employeeid=employees.id
+					AND appraisals.status='" . APPRAISAL_COMPLETED . "'
+					AND appraisals.appraisaltype='" . APPRAISAL_MIDYEAR . "') AS lastmidyear
+		FROM employees
+		LEFT JOIN departments ON employees.departmentid=departments.departmentid
+		LEFT JOIN employees AS managers ON employees.manager=managers.id
+		WHERE employees.active=1
+		AND NOT EXISTS (SELECT 1 FROM appraisals
+						WHERE appraisals.employeeid=employees.id
+						AND appraisals.status='" . APPRAISAL_OPEN . "')
+		ORDER BY employees.surname, employees.firstname";
+$Result = DB_query($SQL);
+
+$DueList = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	if ($MyRow['lastannual'] === null) {
+		// never had an annual appraisal
+		$MyRow['duetype'] = APPRAISAL_ANNUAL;
+		$MyRow['duesince'] = null;
+	} elseif (AppraisalAddMonths($MyRow['lastannual'], $Frequency) < $Today) {
+		$MyRow['duetype'] = APPRAISAL_ANNUAL;
+		$MyRow['duesince'] = AppraisalAddMonths($MyRow['lastannual'], $Frequency);
+	} elseif (AppraisalAddMonths($MyRow['lastannual'], 6) <= $Today
+			and ($MyRow['lastmidyear'] === null or $MyRow['lastmidyear'] < $MyRow['lastannual'])) {
+		// the mid-year appraisal for the year since the last annual appraisal has not been done
+		$MyRow['duetype'] = APPRAISAL_MIDYEAR;
+		$MyRow['duesince'] = AppraisalAddMonths($MyRow['lastannual'], 6);
+	} else {
+		continue;
+	}
+	$DueList[] = $MyRow;
+}
+
+if (count($DueList) > 0) {
+	echo '<table class="selection">
+		<thead>
+			<tr>
+				<th class="SortedColumn">', __('Member of staff'), '</th>
+				<th class="SortedColumn">', __('Department'), '</th>
+				<th class="SortedColumn">', __('Job title'), '</th>
+				<th class="SortedColumn">', __('Manager'), '</th>
+				<th class="SortedColumn">', __('Last annual appraisal'), '</th>
+				<th class="SortedColumn">', __('Appraisal due'), '</th>
+				<th class="SortedColumn">', __('Due since'), '</th>
+				<th class="noPrint">&nbsp;</th>
+			</tr>
+		</thead>
+		<tbody>';
+	foreach ($DueList as $DueRow) {
+		echo '<tr class="striped_row">
+				<td>', $DueRow['firstname'], ' ', $DueRow['surname'], '</td>
+				<td>', $DueRow['departmentname'], '</td>
+				<td>', $DueRow['jobtitle'], '</td>
+				<td>', $DueRow['managerfirstname'], ' ', $DueRow['managersurname'], '</td>
+				<td>', ($DueRow['lastannual'] === null) ? __('Never') : ConvertSQLDate($DueRow['lastannual']), '</td>
+				<td>', $TypeLabels[$DueRow['duetype']], '</td>
+				<td>', ($DueRow['duesince'] === null) ? '' : ConvertSQLDate($DueRow['duesince']), '</td>
+				<td class="noPrint"><a href="', $RootPath, '/Appraisals.php?EmployeeID=', $DueRow['id'], '&amp;Type=', $DueRow['duetype'], '">', __('Start appraisal'), '</a></td>
+			</tr>';
+	}
+	echo '</tbody></table>';
+} else {
+	prnMsg(__('Nobody is due an appraisal'), 'info');
+}
+
+include('includes/footer.php');

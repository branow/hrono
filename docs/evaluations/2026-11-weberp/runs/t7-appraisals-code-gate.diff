+			echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+					<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+					<input type="hidden" name="AppraisalID" value="', $MyRow['appraisalid'], '" />
+					<input type="submit" name="CancelAppraisal" value="', __('Cancel'), '" onclick="return confirm(\'', __('Are you sure you wish to cancel this appraisal?'), '\');" />
+				</form>';
+		}
+		echo '</td>
+			</tr>';
+	}
+	echo '</tbody></table>';
+} else {
+	prnMsg(__('No appraisals have been started yet'), 'info');
+}
+
+include('includes/footer.php');

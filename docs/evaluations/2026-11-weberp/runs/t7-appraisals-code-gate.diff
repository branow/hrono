diff --git a/AppraisalCriteria.php b/AppraisalCriteria.php
new file mode 100644
index 0000000..0cf5d9d
--- /dev/null
+++ b/AppraisalCriteria.php
@@ -0,0 +1,238 @@
+<?php
+
+/* Maintenance of the criteria staff are appraised on and of the appraisal frequency */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Appraisal Criteria');// Screen identification.
+$ViewTopic = 'Labour';// Filename's id in ManualContents.php's TOC.
+$BookMark = 'Appraisals';// Anchor's id in the manual's html document.
+include('includes/header.php');
+include('includes/AppraisalFunctions.php');
+
+echo '<p class="page_title_text"><img alt="" src="', $RootPath, '/css/', $Theme,
+	'/images/user.png" title="',// Icon image.
+	__('Appraisal Criteria'), '" /> ',// Icon title.
+	__('Appraisal Criteria'), '</p>';// Page title.
+
+if (isset($_GET['SelectedCriterion'])) {
+	$SelectedCriterion = (int)$_GET['SelectedCriterion'];
+} elseif (isset($_POST['SelectedCriterion']) and $_POST['SelectedCriterion'] != '') {
+	$SelectedCriterion = (int)$_POST['SelectedCriterion'];
+}
+
+/* The company setting: months between annual appraisals */
+if (isset($_POST['SaveFrequency'])) {
+	$Months = $_POST['FrequencyMonths'];
+	if (!ctype_digit($Months) or (int)$Months < 1 or (int)$Months > 120) {
+		prnMsg(__('The appraisal frequency must be a whole number of months between 1 and 120'), 'error');
+	} else {
+		$Result = DB_query("SELECT confvalue FROM config WHERE confname='AppraisalFrequencyMonths'");
+		if (DB_num_rows($Result) == 0) {
+			DB_query("INSERT INTO config (confname, confvalue) VALUES ('AppraisalFrequencyMonths', '" . (int)$Months . "')");
+		} else {
+			DB_query("UPDATE config SET confvalue='" . (int)$Months . "' WHERE confname='AppraisalFrequencyMonths'");
+		}
+		$_SESSION['AppraisalFrequencyMonths'] = (int)$Months;
+		prnMsg(__('The appraisal frequency has been changed'), 'success');
+	}
+}
+
+/* Add or change a criterion */
+if (isset($_POST['SaveCriterion'])) {
+	$InputError = 0;
+
+	$Weight = filter_number_format($_POST['Weight']);
+	if (trim($_POST['Description']) == '') {
+		$InputError = 1;
+		prnMsg(__('The description of the criterion must not be empty'), 'error');
+	} elseif (mb_strlen($_POST['Description']) > 100) {
+		$InputError = 1;
+		prnMsg(__('The description of the criterion must be no more than 100 characters'), 'error');
+	}
+	if (!is_numeric($Weight) or $Weight <= 0 or $Weight > 999999) {
+		$InputError = 1;
+		prnMsg(__('The weight must be a number greater than zero'), 'error');
+	}
+	$JobTitle = trim($_POST['JobTitle']);
+	if (mb_strlen($JobTitle) > 50) {
+		$InputError = 1;
+		prnMsg(__('The job title must be no more than 50 characters'), 'error');
+	}
+
+	if ($InputError == 0) {
+		if (isset($SelectedCriterion)) {
+			DB_query("UPDATE appraisalcriteria
+						SET description='" . $_POST['Description'] . "',
+							weight='" . round($Weight, 2) . "',
+							jobtitle='" . $JobTitle . "'
+						WHERE criterionid='" . $SelectedCriterion . "'");
+			prnMsg(__('The criterion has been changed'), 'success');
+		} else {
+			DB_query("INSERT INTO appraisalcriteria (description,
+													weight,
+													jobtitle)
+								VALUES ('" . $_POST['Description'] . "',
+										'" . round($Weight, 2) . "',
+										'" . $JobTitle . "')");
+			prnMsg(__('The criterion has been added'), 'success');
+		}
+		unset($SelectedCriterion);
+		unset($_POST['Description']);
+		unset($_POST['Weight']);
+		unset($_POST['JobTitle']);
+	}
+}
+
+/* Retire, reinstate or delete a criterion */
+if (isset($_POST['Retire']) or isset($_POST['Reinstate']) or isset($_POST['Delete'])) {
+	$CriterionID = (int)$_POST['CriterionID'];
+	if (isset($_POST['Retire'])) {
+		DB_query("UPDATE appraisalcriteria SET retired=1 WHERE criterionid='" . $CriterionID . "'");
+		prnMsg(__('The criterion has been retired. It will no longer be used in new appraisals'), 'success');
+	} elseif (isset($_POST['Reinstate'])) {
+		DB_query("UPDATE appraisalcriteria SET retired=0 WHERE criterionid='" . $CriterionID . "'");
+		prnMsg(__('The criterion is in use again'), 'success');
+	} else {
+		// a criterion that has been used in an appraisal can only be retired
+		$Result = DB_query("SELECT COUNT(*) FROM appraisalscores WHERE criterionid='" . $CriterionID . "'");
+		$Row = DB_fetch_row($Result);
+		if ($Row[0] > 0) {
+			prnMsg(__('This criterion has been used in appraisals so it cannot be deleted. It can be retired instead'), 'warn');
+		} else {
+			DB_query("DELETE FROM appraisalcriteria WHERE criterionid='" . $CriterionID . "'");
+			prnMsg(__('The criterion has been deleted'), 'success');
+		}
+	}
+	unset($SelectedCriterion);
+}
+
+/* List of the criteria */
+$SQL = "SELECT appraisalcriteria.criterionid,
+				appraisalcriteria.description,
+				appraisalcriteria.weight,
+				appraisalcriteria.jobtitle,
+				appraisalcriteria.retired,
+				(SELECT COUNT(*) FROM appraisalscores
+					WHERE appraisalscores.criterionid=appraisalcriteria.criterionid) AS timesused
+		FROM appraisalcriteria
+		ORDER BY appraisalcriteria.retired, appraisalcriteria.description";
+$Result = DB_query($SQL);
+if (DB_num_rows($Result) > 0) {
+	echo '<table class="selection">
+		<thead>
+			<tr>
+				<th class="SortedColumn">', __('Criterion'), '</th>
+				<th class="SortedColumn">', __('Weight'), '</th>
+				<th class="SortedColumn">', __('Applies to'), '</th>
+				<th class="SortedColumn">', __('Status'), '</th>
+				<th class="noPrint" colspan="2">&nbsp;</th>
+			</tr>
+		</thead>
+		<tbody>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>', $MyRow['description'], '</td>
+				<td class="number">', locale_number_format($MyRow['weight'], 2), '</td>
+				<td>', ($MyRow['jobtitle'] == '') ? __('Every job title') : $MyRow['jobtitle'], '</td>
+				<td>', ($MyRow['retired'] == 1) ? __('Retired') : __('Active'), '</td>
+				<td class="noPrint"><a href="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '?SelectedCriterion=', $MyRow['criterionid'], '">', __('Edit'), '</a></td>
+				<td class="noPrint">
+					<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+						<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+						<input type="hidden" name="CriterionID" value="', $MyRow['criterionid'], '" />';
+		if ($MyRow['retired'] == 1) {
+			echo '<input type="submit" name="Reinstate" value="', __('Use again'), '" />';
+		} else {
+			echo '<input type="submit" name="Retire" value="', __('Retire'), '" />';
+		}
+		if ($MyRow['timesused'] == 0) {
+			echo '<input type="submit" name="Delete" value="', __('Delete'), '" onclick="return confirm(\'', __('Are you sure you wish to delete this criterion?'), '\');" />';
+		}
+		echo '</form>
+				</td>
+			</tr>';
+	}
+	echo '</tbody></table><br />';
+} else {
+	prnMsg(__('No appraisal criteria have been set up yet'), 'info');
+}
+
+/* The form to add or change a criterion */
+if (isset($SelectedCriterion) and !isset($_POST['SaveCriterion'])) {
+	$Result = DB_query("SELECT description, weight, jobtitle
+						FROM appraisalcriteria
+						WHERE criterionid='" . $SelectedCriterion . "'");
+	if (DB_num_rows($Result) == 0) {
+		unset($SelectedCriterion);
+	} else {
+		$MyRow = DB_fetch_array($Result);
+		$_POST['Description'] = $MyRow['description'];
+		$_POST['Weight'] = locale_number_format($MyRow['weight'], 2);
+		$_POST['JobTitle'] = $MyRow['jobtitle'];
+	}
+}
+foreach (array('Description' => '', 'Weight' => '1', 'JobTitle' => '') as $FieldName => $DefaultValue) {
+	if (!isset($_POST[$FieldName])) {
+		$_POST[$FieldName] = $DefaultValue;
+	}
+}
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />';
+if (isset($SelectedCriterion)) {
+	echo '<input type="hidden" name="SelectedCriterion" value="', $SelectedCriterion, '" />
+		<fieldset>
+			<legend>', __('Amend Criterion'), '</legend>';
+} else {
+	echo '<fieldset>
+			<legend>', __('New Criterion'), '</legend>';
+}
+echo '<field>
+		<label for="Description">', __('Criterion'), ':</label>
+		<input type="text" name="Description" id="Description" required="required" size="50" maxlength="100" value="', $_POST['Description'], '" />
+		<fieldhelp>', __('What staff are rated on, for example Quality of work'), '</fieldhelp>
+	</field>
+	<field>
+		<label for="Weight">', __('Weight'), ':</label>
+		<input type="text" class="number" name="Weight" id="Weight" required="required" size="8" maxlength="10" value="', $_POST['Weight'], '" />
+		<fieldhelp>', __('How much the rating on this criterion counts towards the overall result compared to the other criteria'), '</fieldhelp>
+	</field>
+	<field>
+		<label for="JobTitle">', __('Job Title'), ':</label>
+		<input type="text" name="JobTitle" id="JobTitle" size="31" maxlength="50" list="JobTitles" value="', $_POST['JobTitle'], '" />
+		<datalist id="JobTitles">';
+$JobTitlesResult = DB_query("SELECT DISTINCT jobtitle FROM employees WHERE jobtitle<>'' ORDER BY jobtitle");
+while ($MyRow = DB_fetch_array($JobTitlesResult)) {
+	echo '<option value="', $MyRow['jobtitle'], '"></option>';
+}
+echo '</datalist>
+		<fieldhelp>', __('Leave empty if the criterion applies to every job title, otherwise enter the one job title it applies to'), '</fieldhelp>
+	</field>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="SaveCriterion" value="', __('Enter Information'), '" />
+	</div>
+	</form>';
+if (isset($SelectedCriterion)) {
+	echo '<div class="centre"><a href="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">', __('Add a new criterion'), '</a></div>';
+}
+
+/* The appraisal frequency */
+echo '<br />
+	<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Appraisal Frequency'), '</legend>
+		<field>
+			<label for="FrequencyMonths">', __('Months between annual appraisals'), ':</label>
+			<input type="text" class="number" name="FrequencyMonths" id="FrequencyMonths" required="required" size="4" maxlength="3" value="', GetAppraisalFrequency(), '" />
+			<fieldhelp>', __('A member of staff is due an annual appraisal when the last one was completed longer ago than this. A mid-year appraisal is due six months after the last annual appraisal'), '</fieldhelp>
+		</field>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="SaveFrequency" value="', __('Change Frequency'), '" />
+	</div>
+	</form>';
+
+include('includes/footer.php');
diff --git a/AppraisalReview.php b/AppraisalReview.php
new file mode 100644
index 0000000..6888628
--- /dev/null
+++ b/AppraisalReview.php
@@ -0,0 +1,321 @@
+<?php
+
+/* Reviewers see the appraisals waiting for them and rate the member of staff on each criterion */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Conduct Appraisals');// Screen identification.
+$ViewTopic = 'Labour';// Filename's id in ManualContents.php's TOC.
+$BookMark = 'DoingAppraisals';// Anchor's id in the manual's html document.
+include('includes/header.php');
+include('includes/SQL_CommonFunctions.php');
+include('includes/AppraisalFunctions.php');
+
+echo '<p class="page_title_text"><img alt="" src="', $RootPath, '/css/', $Theme,
+	'/images/user.png" title="',// Icon image.
+	__('Conduct Appraisals'), '" /> ',// Icon title.
+	__('Conduct Appraisals'), '</p>';// Page title.
+
+$TypeLabels = AppraisalTypeLabels();
+$RatingLabels = AppraisalRatingLabels();
+
+// The reviewer is the person whose employee record is linked to the logged in webERP user
+$MyEmployeeIDs = AppraisalEmployeeIDsOfUser();
+if (count($MyEmployeeIDs) == 0) {
+	prnMsg(__('Your webERP user is not linked to an employee record, so there are no appraisals waiting for you'), 'info');
+	include('includes/footer.php');
+	exit();
+}
+$MyEmployeeList = implode(',', $MyEmployeeIDs);
+
+if (isset($_POST['AppraisalID'])) {
+	$AppraisalID = (int)$_POST['AppraisalID'];
+} elseif (isset($_GET['AppraisalID'])) {
+	$AppraisalID = (int)$_GET['AppraisalID'];
+}
+
+if (isset($AppraisalID)) {
+	// only the reviewer can see the appraisal
+	$SQL = "SELECT appraisals.appraisalid,
+					appraisals.employeeid,
+					appraisals.appraisaltype,
+					appraisals.status,
+					appraisals.duedate,
+					appraisals.overallcomment,
+					employees.firstname,
+					employees.surname,
+					employees.jobtitle,
+					employees.email
+			FROM appraisals
+			INNER JOIN employees ON appraisals.employeeid=employees.id
+			WHERE appraisals.appraisalid='" . $AppraisalID . "'
+			AND appraisals.reviewerid IN (" . $MyEmployeeList . ")";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('This appraisal is not waiting for you'), 'error');
+		unset($AppraisalID);
+	} else {
+		$Appraisal = DB_fetch_array($Result);
+	}
+}
+
+/* Save or complete the appraisal */
+if (isset($AppraisalID) and (isset($_POST['SaveAppraisal']) or isset($_POST['CompleteAppraisal']))) {
+	$Completing = isset($_POST['CompleteAppraisal']);
+	$InputError = 0;
+
+	if ($Appraisal['status'] != APPRAISAL_OPEN) {
+		$InputError = 1;
+		prnMsg(__('This appraisal has been completed or cancelled, so it cannot be changed'), 'error');
+	}
+
+	$Criteria = AppraisalCriteriaFor($Appraisal['jobtitle']);
+	$Ratings = array();
+	$Comments = array();
+	foreach ($Criteria as $CriterionID => $Criterion) {
+		$Rating = isset($_POST['Rating_' . $CriterionID]) ? $_POST['Rating_' . $CriterionID] : '';
+		if ($Rating !== '' and (!ctype_digit($Rating) or (int)$Rating < 1 or (int)$Rating > 5)) {
+			$InputError = 1;
+			prnMsg(__('The rating for') . ' ' . $Criterion['description'] . ' ' . __('must be from 1 to 5'), 'error');
+		}
+		if ($Completing and $Rating === '') {
+			$InputError = 1;
+			prnMsg(__('The appraisal cannot be completed until') . ' ' . $Criterion['description'] . ' ' . __('has been rated'), 'error');
+		}
+		$Ratings[$CriterionID] = $Rating;
+		$Comments[$CriterionID] = isset($_POST['Comment_' . $CriterionID]) ? $_POST['Comment_' . $CriterionID] : '';
+		if (mb_strlen($Comments[$CriterionID]) > 4000) {
+			$InputError = 1;
+			prnMsg(__('The comment for') . ' ' . $Criterion['description'] . ' ' . __('must be no more than 4000 characters'), 'error');
+		}
+	}
+	$OverallComment = isset($_POST['OverallComment']) ? $_POST['OverallComment'] : '';
+	if (mb_strlen($OverallComment) > 4000) {
+		$InputError = 1;
+		prnMsg(__('The overall comment must be no more than 4000 characters'), 'error');
+	}
+	if ($Completing and count($Criteria) == 0) {
+		$InputError = 1;
+		prnMsg(__('There are no criteria for this job title, so the appraisal cannot be completed. Please see HR'), 'error');
+	}
+
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+		// check again, while holding the lock, that the appraisal is still open
+		$StatusResult = DB_query("SELECT status FROM appraisals WHERE appraisalid='" . $AppraisalID . "' FOR UPDATE", '', '', true);
+		$StatusRow = DB_fetch_row($StatusResult);
+		if ($StatusRow[0] != APPRAISAL_OPEN) {
+			DB_Txn_Commit(); // nothing has been written - this releases the lock and restores autocommit
+			prnMsg(__('This appraisal has been completed or cancelled, so it cannot be changed'), 'error');
+			$Appraisal['status'] = $StatusRow[0];
+		} else {
+			$ErrMsg = __('The appraisal could not be saved because');
+			$Scores = array();
+			foreach ($Criteria as $CriterionID => $Criterion) {
+				$RatingSQL = ($Ratings[$CriterionID] === '') ? 'NULL' : "'" . (int)$Ratings[$CriterionID] . "'";
+				if ($Completing) {
+					// the description and weight are kept with the rating so that later changes to the criterion
+					// do not change a completed appraisal
+					DB_query("INSERT INTO appraisalscores (appraisalid, criterionid, rating, comment, criteriondescription, weight)
+								VALUES ('" . $AppraisalID . "',
+										'" . $CriterionID . "',
+										" . $RatingSQL . ",
+										'" . $Comments[$CriterionID] . "',
+										'" . DB_escape_string($Criterion['description']) . "',
+										'" . $Criterion['weight'] . "')
+								ON DUPLICATE KEY UPDATE rating=VALUES(rating),
+														comment=VALUES(comment),
+														criteriondescription=VALUES(criteriondescription),
+														weight=VALUES(weight)", $ErrMsg, '', true);
+					$Scores[] = array('weight' => $Criterion['weight'], 'rating' => (int)$Ratings[$CriterionID]);
+				} else {
+					DB_query("INSERT INTO appraisalscores (appraisalid, criterionid, rating, comment)
+								VALUES ('" . $AppraisalID . "',
+										'" . $CriterionID . "',
+										" . $RatingSQL . ",
+										'" . $Comments[$CriterionID] . "')
+								ON DUPLICATE KEY UPDATE rating=VALUES(rating),
+														comment=VALUES(comment)", $ErrMsg, '', true);
+				}
+			}
+
+			if ($Completing) {
+				// ratings saved earlier for criteria that no longer apply are not part of the completed appraisal
+				DB_query("DELETE FROM appraisalscores
+							WHERE appraisalid='" . $AppraisalID . "'
+							AND criterionid NOT IN (" . implode(',', array_keys($Criteria)) . ")", $ErrMsg, '', true);
+				$Overall = AppraisalOverallResult($Scores);
+				DB_query("UPDATE appraisals
+							SET status='" . APPRAISAL_COMPLETED . "',
+								completeddate='" . date('Y-m-d') . "',
+								jobtitle='" . DB_escape_string($Appraisal['jobtitle']) . "',
+								overallscore='" . $Overall[0] . "',
+								overallrating='" . $Overall[1] . "',
+								overallcomment='" . $OverallComment . "'
+							WHERE appraisalid='" . $AppraisalID . "'
+							AND status='" . APPRAISAL_OPEN . "'", $ErrMsg, '', true);
+			} else {
+				DB_query("UPDATE appraisals
+							SET overallcomment='" . $OverallComment . "'
+							WHERE appraisalid='" . $AppraisalID . "'
+							AND status='" . APPRAISAL_OPEN . "'", $ErrMsg, '', true);
+			}
+			DB_Txn_Commit();
+
+			if ($Completing) {
+				$Appraisal['status'] = APPRAISAL_COMPLETED;
+				prnMsg(__('The appraisal has been completed. The overall result is') . ' ' . AppraisalOverallText($Overall[1]), 'success');
+
+				// tell the person who was appraised
+				if ($Appraisal['email'] == '') {
+					prnMsg(__('The person appraised has no email address, so they have not been told that the appraisal is complete'), 'warn');
+				} else {
+					$EmailSubject = __('Your appraisal has been completed');
+					$EmailBody = '<p>' . $Appraisal['firstname'] . ' ' . $Appraisal['surname'] . ',</p>
+						<p>' . __('Your') . ' ' . $TypeLabels[$Appraisal['appraisaltype']] . ' ' . __('appraisal has been completed. The overall result is') . ' ' . AppraisalOverallText($Overall[1]) . '.</p>
+						<p><a href="' . AppraisalLink('MyAppraisals.php', 'AppraisalID=' . $AppraisalID) . '">' . __('View your appraisal') . '</a></p>';
+					$EmailResult = SendEmailFromWebERP($_SESSION['CompanyRecord']['email'],
+													array($Appraisal['email']),
+													$EmailSubject,
+													$EmailBody,
+													'',
+													true);
+					if ($EmailResult === true) {
+						prnMsg(__('The person appraised has been told by email'), 'success');
+					} else {
+						prnMsg(__('The appraisal was completed but the email to the person appraised could not be sent'), 'warn');
+					}
+				}
+			} else {
+				prnMsg(__('The appraisal has been saved. You can come back to it later to complete it'), 'success');
+				$Appraisal['overallcomment'] = $OverallComment;
+			}
+		}
+	}
+}
+
+if (isset($AppraisalID)) {
+	/* One appraisal */
+	echo '<div class="centre"><a href="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">', __('Back to the appraisals waiting for me'), '</a></div><br />';
+
+	if ($Appraisal['status'] == APPRAISAL_COMPLETED) {
+		DisplayCompletedAppraisal($AppraisalID);
+	} elseif ($Appraisal['status'] == APPRAISAL_CANCELLED) {
+		prnMsg(__('This appraisal has been cancelled'), 'info');
+	} else {
+		$Criteria = AppraisalCriteriaFor($Appraisal['jobtitle']);
+
+		// the ratings saved so far - or what was just entered if it could not be saved
+		$Saved = array();
+		$SavedResult = DB_query("SELECT criterionid, rating, comment FROM appraisalscores WHERE appraisalid='" . $AppraisalID . "'");
+		while ($SavedRow = DB_fetch_array($SavedResult)) {
+			$Saved[$SavedRow['criterionid']] = $SavedRow;
+		}
+		if (isset($InputError) and $InputError == 1) {
+			$OverallCommentValue = isset($OverallComment) ? $OverallComment : '';
+		} else {
+			$OverallCommentValue = (string)$Appraisal['overallcomment'];
+		}
+
+		echo '<table class="selection">
+			<tr><th>', __('Member of staff'), '</th><td>', $Appraisal['firstname'], ' ', $Appraisal['surname'], '</td></tr>
+			<tr><th>', __('Job title'), '</th><td>', $Appraisal['jobtitle'], '</td></tr>
+			<tr><th>', __('Type of appraisal'), '</th><td>', $TypeLabels[$Appraisal['appraisaltype']], '</td></tr>
+			<tr><th>', __('Due date'), '</th><td>', ConvertSQLDate($Appraisal['duedate']), '</td></tr>
+			<tr><th>', __('Overall result'), '</th><td>', AppraisalOverallText(null), '</td></tr>
+			</table><br />';
+
+		if (count($Criteria) == 0) {
+			prnMsg(__('There are no appraisal criteria for this job title. Please see HR'), 'warn');
+		}
+
+		echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+			<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+			<input type="hidden" name="AppraisalID" value="', $AppraisalID, '" />
+			<table class="selection">
+			<thead>
+				<tr>
+					<th>', __('Criterion'), '</th>
+					<th>', __('Weight'), '</th>
+					<th>', __('Rating'), '</th>
+					<th>', __('Comment'), '</th>
+				</tr>
+			</thead>
+			<tbody>';
+		foreach ($Criteria as $CriterionID => $Criterion) {
+			if (isset($InputError) and $InputError == 1 and isset($Ratings[$CriterionID])) {
+				$RatingValue = $Ratings[$CriterionID];
+				$CommentValue = $Comments[$CriterionID];
+			} elseif (isset($Saved[$CriterionID])) {
+				$RatingValue = ($Saved[$CriterionID]['rating'] === null) ? '' : $Saved[$CriterionID]['rating'];
+				$CommentValue = (string)$Saved[$CriterionID]['comment'];
+			} else {
+				$RatingValue = '';
+				$CommentValue = '';
+			}
+			echo '<tr class="striped_row">
+					<td>', $Criterion['description'], '</td>
+					<td class="number">', locale_number_format($Criterion['weight'], 2), '</td>
+					<td><select name="Rating_', $CriterionID, '">
+						<option value=""', ($RatingValue === '') ? ' selected="selected"' : '', '>', __('Not rated'), '</option>';
+			foreach ($RatingLabels as $RatingValueOption => $RatingLabel) {
+				echo '<option value="', $RatingValueOption, '"', ((string)$RatingValue === (string)$RatingValueOption) ? ' selected="selected"' : '', '>', $RatingValueOption, ' - ', $RatingLabel, '</option>';
+			}
+			echo '</select></td>
+					<td><textarea name="Comment_', $CriterionID, '" rows="3" cols="50">', $CommentValue, '</textarea></td>
+				</tr>';
+		}
+		echo '</tbody></table><br />
+			<table class="selection">
+				<tr><th>', __('Overall comment'), '</th></tr>
+				<tr><td><textarea name="OverallComment" rows="5" cols="70">', $OverallCommentValue, '</textarea></td></tr>
+			</table>
+			<br />
+			<div class="centre">
+				<input type="submit" name="SaveAppraisal" value="', __('Save'), '" />
+				<input type="submit" name="CompleteAppraisal" value="', __('Complete Appraisal'), '" onclick="return confirm(\'', __('Once completed the appraisal cannot be changed. Are you sure you wish to complete it?'), '\');" />
+			</div>
+			</form>';
+	}
+} else {
+	/* The appraisals waiting for the reviewer */
+	$SQL = "SELECT appraisals.appraisalid,
+					appraisals.appraisaltype,
+					appraisals.duedate,
+					employees.firstname,
+					employees.surname,
+					employees.jobtitle
+			FROM appraisals
+			INNER JOIN employees ON appraisals.employeeid=employees.id
+			WHERE appraisals.reviewerid IN (" . $MyEmployeeList . ")
+			AND appraisals.status='" . APPRAISAL_OPEN . "'
+			ORDER BY appraisals.duedate, employees.surname";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) > 0) {
+		echo '<table class="selection">
+			<thead>
+				<tr>
+					<th class="SortedColumn">', __('Member of staff'), '</th>
+					<th class="SortedColumn">', __('Job title'), '</th>
+					<th class="SortedColumn">', __('Type'), '</th>
+					<th class="SortedColumn">', __('Due date'), '</th>
+					<th class="noPrint">&nbsp;</th>
+				</tr>
+			</thead>
+			<tbody>';
+		while ($MyRow = DB_fetch_array($Result)) {
+			echo '<tr class="striped_row">
+					<td>', $MyRow['firstname'], ' ', $MyRow['surname'], '</td>
+					<td>', $MyRow['jobtitle'], '</td>
+					<td>', $TypeLabels[$MyRow['appraisaltype']], '</td>
+					<td>', ConvertSQLDate($MyRow['duedate']), '</td>
+					<td class="noPrint"><a href="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '?AppraisalID=', $MyRow['appraisalid'], '">', __('Do appraisal'), '</a></td>
+				</tr>';
+		}
+		echo '</tbody></table>';
+	} else {
+		prnMsg(__('There are no appraisals waiting for you'), 'info');
+	}
+}
+
+include('includes/footer.php');
diff --git a/Appraisals.php b/Appraisals.php

diff --git a/CreditReminders.php b/CreditReminders.php
new file mode 100644
index 0000000..188a7f3
--- /dev/null
+++ b/CreditReminders.php
@@ -0,0 +1,279 @@
+<?php
+
+/* Overdue reminders. Three levels: friendly (an invoice is past due), firm (first overdue band) and final notice
+(second overdue band), using exactly the ageing the invoice, statement and aged debtors report use. Credit control
+sees who would get which level, leaves anybody out and then sends a PDF letter by email to the customer's
+statement contacts. A letter that cannot be emailed is not counted as sent. A customer on hold gets the final notice wording. */
+
+require(__DIR__ . '/includes/session.php');
+require_once __DIR__ . '/vendor/autoload.php';
+
+use Dompdf\Dompdf;
+
+include('includes/SetDomPDFOptions.php');
+include_once('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Control Reminders');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditReminders';
+
+/* Everything that is overdue and could be reminded, grouped by customer, worked out from the database each time */
+function ReminderCandidates($OnlyDebtor = '') {
+	$SQL = "SELECT debtortrans.id,
+					debtortrans.type,
+					debtortrans.transno,
+					debtortrans.trandate,
+					debtortrans.balance,
+					debtortrans.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.address1,
+					debtorsmaster.address2,
+					debtorsmaster.address3,
+					debtorsmaster.address4,
+					debtorsmaster.address5,
+					debtorsmaster.address6,
+					debtorsmaster.currcode,
+					currencies.decimalplaces,
+					holdreasons.dissallowinvoices,
+					" . CreditReminderLevelSQL() . " AS lvl,
+					" . CreditDueDateSQL() . " AS duedate,
+					(SELECT GROUP_CONCAT(creditreminderitems.reminderlevel)
+						FROM creditreminderitems
+						WHERE creditreminderitems.debtortransid=debtortrans.id) AS reminded
+			FROM debtortrans
+			INNER JOIN debtorsmaster ON debtortrans.debtorno=debtorsmaster.debtorno
+			INNER JOIN paymentterms ON debtorsmaster.paymentterms=paymentterms.termsindicator
+			INNER JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+			INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+			WHERE debtortrans.type IN (10, 13)
+			AND ROUND(debtortrans.balance, currencies.decimalplaces) > 0
+			AND " . CreditReminderLevelSQL() . " >= 1" .
+			($OnlyDebtor != '' ? " AND debtortrans.debtorno='" . $OnlyDebtor . "'" : '') .
+			CreditSalesmanTransSQL('debtortrans') .
+			CreditSalesmanCustomerSQL('debtortrans.debtorno') . "
+			ORDER BY debtortrans.debtorno, debtortrans.trandate, debtortrans.transno";
+	$Result = DB_query($SQL, __('The overdue invoices could not be retrieved because'));
+	$Customers = array();
+	while ($Row = DB_fetch_array($Result)) {
+		$No = $Row['debtorno'];
+		if (!isset($Customers[$No])) {
+			$Customers[$No] = array('name' => $Row['name'],
+									'address' => array($Row['address1'], $Row['address2'], $Row['address3'], $Row['address4'], $Row['address5'], $Row['address6']),
+									'currcode' => $Row['currcode'],
+									'dp' => $Row['decimalplaces'],
+									'onhold' => ($Row['dissallowinvoices'] == 1),
+									'level' => 0,
+									'items' => array(),
+									'total' => 0);
+		}
+		$Customers[$No]['items'][] = $Row;
+		$Customers[$No]['total'] += $Row['balance'];
+		if ($Row['lvl'] > $Customers[$No]['level']) {
+			$Customers[$No]['level'] = $Row['lvl'];
+		}
+	}
+	foreach ($Customers as $No => $Customer) {
+		if ($Customer['onhold']) {
+			$Customers[$No]['level'] = 3; // customers on hold get the final notice wording
+		}
+		/* a customer never gets the same level twice for the same invoices */
+		$Pending = 0;
+		foreach ($Customer['items'] as $Item) {
+			$Reminded = $Item['reminded'] == '' ? array() : explode(',', $Item['reminded']);
+			if (!in_array($Customers[$No]['level'], $Reminded)) {
+				$Pending++;
+			}
+		}
+		$Customers[$No]['pending'] = $Pending;
+		/* the contacts who receive statements */
+		$Recipients = array();
+		$ContactResult = DB_query("SELECT email FROM custcontacts WHERE debtorno='" . $No . "' AND statement=1");
+		while ($ContactRow = DB_fetch_row($ContactResult)) {
+			if (IsEmailAddress($ContactRow[0]) and !in_array($ContactRow[0], $Recipients)) {
+				$Recipients[] = $ContactRow[0];
+			}
+		}
+		$Customers[$No]['recipients'] = $Recipients;
+	}
+	return $Customers;
+}
+
+function ReminderLetterHTML($DebtorNo, $Customer) {
+	$Level = $Customer['level'];
+	$HTML = '<html><head><style>
+				body { font-family: DejaVu Sans, sans-serif; font-size: 11px; }
+				table { width: 100%; border-collapse: collapse; }
+				th, td { border: 1px solid #ccc; padding: 4px; }
+				.number { text-align: right; }
+			</style></head><body>
+			<table style="border:0"><tr>
+				<td style="border:0"><img src="' . $_SESSION['LogoFile'] . '" alt="" style="height:50px;" /></td>
+				<td style="border:0;text-align:right"><b>' . $_SESSION['CompanyRecord']['coyname'] . '</b><br />' .
+				$_SESSION['CompanyRecord']['regoffice1'] . '<br />' . $_SESSION['CompanyRecord']['regoffice2'] . '<br />' .
+				$_SESSION['CompanyRecord']['regoffice3'] . '<br />' . $_SESSION['CompanyRecord']['regoffice4'] . '<br />' .
+				$_SESSION['CompanyRecord']['regoffice5'] . ' ' . $_SESSION['CompanyRecord']['regoffice6'] . '<br />' .
+				__('Telephone') . ': ' . $_SESSION['CompanyRecord']['telephone'] . '<br />' . __('Email') . ': ' . $_SESSION['CompanyRecord']['email'] . '</td>
+			</tr></table>
+			<p>' . ConvertSQLDate(date('Y-m-d')) . '</p>
+			<p><b>' . $Customer['name'] . '</b><br />';
+	foreach ($Customer['address'] as $Line) {
+		if (trim($Line) != '') {
+			$HTML .= $Line . '<br />';
+		}
+	}
+	$HTML .= '</p>
+			<h2>' . CreditReminderLevelName($Level) . ' - ' . __('Account') . ' ' . $DebtorNo . '</h2>
+			<p>' . nl2br(CreditReminderText($Level)) . '</p>
+			<table><tr><th>' . __('Document') . '</th><th>' . __('Number') . '</th><th>' . __('Date') . '</th><th>' . __('Due Date') . '</th><th>' . __('Amount Outstanding') . '</th></tr>';
+	foreach ($Customer['items'] as $Item) {
+		$HTML .= '<tr><td>' . ($Item['type'] == 13 ? __('Late payment charge') : __('Invoice')) . '</td>
+					<td>' . $Item['transno'] . '</td>
+					<td>' . ConvertSQLDate($Item['trandate']) . '</td>
+					<td>' . ConvertSQLDate($Item['duedate']) . '</td>
+					<td class="number">' . locale_number_format($Item['balance'], $Customer['dp']) . '</td></tr>';
+	}
+	$HTML .= '<tr><td colspan="4"><b>' . __('Total overdue') . ' (' . $Customer['currcode'] . ')</b></td>
+				<td class="number"><b>' . locale_number_format($Customer['total'], $Customer['dp']) . '</b></td></tr></table>';
+	$BankResult = DB_query("SELECT bankaccountnumber, bankaccountcode FROM bankaccounts WHERE invoice='1'");
+	if (DB_num_rows($BankResult) == 1) {
+		$BankRow = DB_fetch_array($BankResult);
+		$HTML .= '<p>' . __('Please make payment to account') . ': ' . $BankRow['bankaccountnumber'] . ' ' . $BankRow['bankaccountcode'] . '<br />' . __('Quoting your account reference') . ' ' . $DebtorNo . '</p>';
+	}
+	return $HTML . '</body></html>';
+}
+
+/* Records the reminder and emails the letter in one step: nothing stays recorded unless the email went. Returns '' or the reason it failed. */
+function SendReminder($DebtorNo, $Customer) {
+	global $DomPDFOptions;
+	if (count($Customer['recipients']) == 0) {
+		return __('The customer has no contact who receives statements with a valid email address');
+	}
+	if ($Customer['pending'] == 0) {
+		return __('This level has already been sent for these invoices');
+	}
+	DB_Txn_Begin();
+	DB_query("INSERT INTO creditreminders (debtorno, reminderlevel, sentdate, userid, sentto, onhold)
+				VALUES ('" . $DebtorNo . "', '" . $Customer['level'] . "', '" . date('Y-m-d H:i:s') . "', '" . $_SESSION['UserID'] . "',
+						'" . mb_substr(implode(', ', $Customer['recipients']), 0, 255) . "', '" . ($Customer['onhold'] ? 1 : 0) . "')", '', '', false, false);
+	if (DB_error_no() != 0) {
+		DB_Txn_Rollback();
+		return __('The reminder could not be recorded');
+	}
+	$ReminderID = DB_Last_Insert_ID('creditreminders', 'id');
+	foreach ($Customer['items'] as $Item) {
+		$Reminded = $Item['reminded'] == '' ? array() : explode(',', $Item['reminded']);
+		if (in_array($Customer['level'], $Reminded)) {
+			continue;
+		}
+		DB_query("INSERT INTO creditreminderitems (reminderid, debtorno, reminderlevel, debtortransid, transtype, transno, balance)
+					VALUES ('" . $ReminderID . "', '" . $DebtorNo . "', '" . $Customer['level'] . "', '" . $Item['id'] . "',
+							'" . $Item['type'] . "', '" . $Item['transno'] . "', '" . $Item['balance'] . "')", '', '', false, false);
+		if (DB_error_no() != 0) {
+			DB_Txn_Rollback();
+			return __('The same level was already sent for one of these invoices by another run');
+		}
+	}
+	$PdfFile = sys_get_temp_dir() . '/' . $_SESSION['DatabaseName'] . '_Reminder_' . preg_replace('/[^A-Za-z0-9_-]/', '', $DebtorNo) . '_L' . $Customer['level'] . '_' . date('Y-m-d') . '.pdf';
+	$DomPDF = new Dompdf($DomPDFOptions);
+	$DomPDF->loadHtml(ReminderLetterHTML($DebtorNo, $Customer));
+	$DomPDF->setPaper($_SESSION['PageSize'], 'portrait');
+	$DomPDF->render();
+	if (file_put_contents($PdfFile, $DomPDF->output()) === false) {
+		DB_Txn_Rollback();
+		return __('The letter could not be created');
+	}
+	$To = array();
+	foreach ($Customer['recipients'] as $Address) {
+		$To[$Address] = '';
+	}
+	$Sent = SendEmailFromWebERP($_SESSION['CompanyRecord']['email'],
+								$To,
+								$_SESSION['CompanyRecord']['coyname'] . ' - ' . CreditReminderLevelName($Customer['level']) . ' - ' . __('Account') . ' ' . $DebtorNo,
+								__('Please find attached our letter about your account') . ' ' . $DebtorNo . '.',
+								array($PdfFile),
+								true);
+	unlink($PdfFile);
+	if ($Sent !== true) {
+		DB_Txn_Rollback();
+		return __('The email could not be sent') . (is_string($Sent) ? ': ' . $Sent : '');
+	}
+	DB_Txn_Commit();
+	return '';
+}
+
+include('includes/header.php');
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . $Title . '</p>';
+
+if (!CreditControlUser() or CreditCustomerLogin()) {
+	prnMsg(__('Only credit control may send reminders'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+if (isset($_POST['Send'])) {
+	$Selected = isset($_POST['Include']) && is_array($_POST['Include']) ? array_keys($_POST['Include']) : array();
+	$Candidates = ReminderCandidates();
+	$Sent = array();
+	$Failed = array();
+	foreach ($Selected as $DebtorNo) {
+		if (!isset($Candidates[$DebtorNo])) {
+			continue;
+		}
+		$Error = SendReminder($DebtorNo, $Candidates[$DebtorNo]);
+		if ($Error == '') {
+			$Sent[$DebtorNo] = $Candidates[$DebtorNo];
+		} else {
+			$Failed[$DebtorNo] = $Error;
+		}
+	}
+	echo '<p class="success">' . count($Sent) . ' ' . __('reminders sent') . '</p>';
+	if (count($Failed) > 0) {
+		echo '<table class="selection"><caption class="bad">' . __('Reminders NOT sent - they are not counted as sent') . '</caption>
+				<tr><th>' . __('Customer') . '</th><th>' . __('Reason') . '</th></tr>';
+		foreach ($Failed as $DebtorNo => $Reason) {
+			echo '<tr class="striped_row"><td>' . $DebtorNo . ' ' . (isset($Candidates[$DebtorNo]) ? $Candidates[$DebtorNo]['name'] : '') . '</td><td>' . $Reason . '</td></tr>';
+		}
+		echo '</table><br />';
+	}
+	if (count($Sent) > 0) {
+		echo '<table class="selection"><caption>' . __('Reminders sent') . '</caption>
+				<tr><th>' . __('Customer') . '</th><th>' . __('Level') . '</th><th>' . __('Sent To') . '</th></tr>';
+		foreach ($Sent as $DebtorNo => $Customer) {
+			echo '<tr class="striped_row"><td>' . $DebtorNo . ' ' . $Customer['name'] . '</td><td>' . CreditReminderLevelName($Customer['level']) . '</td><td>' . implode(', ', $Customer['recipients']) . '</td></tr>';
+		}
+		echo '</table><br />';
+	}
+}
+
+$Candidates = ReminderCandidates();
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<table class="selection">
+		<caption>' . __('Who would get which reminder - untick anybody to leave them out') . '</caption>
+		<tr><th>' . __('Send') . '</th><th>' . __('Customer') . '</th><th>' . __('Level') . '</th><th>' . __('Overdue Invoices') . '</th><th>' . __('Total Overdue') . '</th><th>' . __('Not Yet Reminded At This Level') . '</th><th>' . __('Will Be Emailed To') . '</th></tr>';
+$Offered = 0;
+foreach ($Candidates as $DebtorNo => $Customer) {
+	$CanSend = ($Customer['pending'] > 0 && count($Customer['recipients']) > 0);
+	if ($Customer['pending'] > 0) {
+		$Offered++;
+	}
+	echo '<tr class="striped_row">
+			<td>' . ($Customer['pending'] > 0 ? '<input type="checkbox" name="Include[' . $DebtorNo . ']" value="1"' . ($CanSend ? ' checked="checked"' : '') . ' />' : '') . '</td>
+			<td>' . $DebtorNo . ' - ' . $Customer['name'] . ($Customer['onhold'] ? ' <b>(' . __('on hold') . ')</b>' : '') . '</td>
+			<td>' . CreditReminderLevelName($Customer['level']) . '</td>
+			<td class="number">' . count($Customer['items']) . '</td>
+			<td class="number">' . locale_number_format($Customer['total'], $Customer['dp']) . ' ' . $Customer['currcode'] . '</td>
+			<td class="number">' . $Customer['pending'] . '</td>
+			<td>' . (count($Customer['recipients']) > 0 ? implode(', ', $Customer['recipients']) : '<span class="bad">' . __('No contact receives statements - cannot be emailed') . '</span>') . ($Customer['pending'] == 0 ? ' (' . __('already sent') . ')' : '') . '</td>
+		</tr>';
+}
+if (count($Candidates) == 0) {
+	echo '<tr><td colspan="7">' . __('Nothing is overdue') . '</td></tr>';
+}
+echo '</table>';
+if ($Offered > 0) {
+	echo '<div class="centre"><input type="submit" name="Send" value="' . __('Send The Reminders Selected') . '" onclick="return confirm(\'' . __('Send the reminders selected?') . '\');" /></div>';
+}
+echo '</form>';
+
+include('includes/footer.php');
diff --git a/CreditReviewDue.php b/CreditReviewDue.php
new file mode 100644
index 0000000..4cfe599
--- /dev/null
+++ b/CreditReviewDue.php
@@ -0,0 +1,131 @@
+<?php
+
+/* Customers whose credit review is overdue or falls due within a number of days, with balance, overdue amount,
+credit limit, credit still available and the date they last paid. Screen or PDF. Salespeople only see their own customers. */
+
+require(__DIR__ . '/includes/session.php');
+require_once __DIR__ . '/vendor/autoload.php';
+
+use Dompdf\Dompdf;
+
+include('includes/SetDomPDFOptions.php');
+include('includes/SQL_CommonFunctions.php');
+include_once('includes/CreditControlFunctions.php');
+
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditReviewDue';
+
+if (CreditCustomerLogin()) {
+	$Title = __('Credit Reviews Due');
+	include('includes/header.php');
+	prnMsg(__('This report is not available to customer logins'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+if (isset($_POST['Days']) and is_numeric($_POST['Days'])) {
+	$Days = (int)$_POST['Days'];
+} else {
+	$Days = 30;
+}
+
+if (isset($_POST['PrintPDF']) or isset($_POST['View'])) {
+
+	$LimitDate = date('Y-m-d', strtotime('+' . $Days . ' days'));
+	$SQL = "SELECT debtorsmaster.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.creditlimit,
+					debtorsmaster.nextreviewdate,
+					debtorsmaster.lastpaiddate,
+					debtorsmaster.currcode,
+					currencies.decimalplaces,
+					COALESCE(SUM(debtortrans.balance), 0) AS balance,
+					COALESCE(SUM(CASE WHEN debtortrans.id IS NOT NULL AND " . CreditReminderLevelSQL() . " >= 1
+									THEN debtortrans.balance ELSE 0 END), 0) AS overdue
+			FROM debtorsmaster
+			INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+			INNER JOIN paymentterms ON debtorsmaster.paymentterms=paymentterms.termsindicator
+			LEFT JOIN debtortrans ON debtortrans.debtorno=debtorsmaster.debtorno" . CreditSalesmanTransSQL('debtortrans') . "
+			WHERE debtorsmaster.nextreviewdate <= '" . $LimitDate . "'" . CreditSalesmanCustomerSQL('debtorsmaster.debtorno') . "
+			GROUP BY debtorsmaster.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.creditlimit,
+					debtorsmaster.nextreviewdate,
+					debtorsmaster.lastpaiddate,
+					debtorsmaster.currcode,
+					currencies.decimalplaces
+			ORDER BY debtorsmaster.nextreviewdate, debtorsmaster.debtorno";
+	$Result = DB_query($SQL, __('The customers due for review could not be retrieved because'));
+
+	$HTML = '';
+	if (isset($_POST['PrintPDF'])) {
+		$HTML .= '<html><head><link href="css/reports.css" rel="stylesheet" type="text/css" /></head><body>';
+	}
+	$HTML .= '<div class="centre" id="ReportHeader">' . $_SESSION['CompanyRecord']['coyname'] . '<br />' .
+			__('Credit reviews overdue or due within') . ' ' . $Days . ' ' . __('days') . ' - ' . ConvertSQLDate(date('Y-m-d')) . '</div>
+			<table class="selection">
+			<tr>
+				<th>' . __('Customer') . '</th>
+				<th>' . __('Name') . '</th>
+				<th>' . __('Review Due') . '</th>
+				<th>' . __('Balance') . '</th>
+				<th>' . __('Overdue Amount') . '</th>
+				<th>' . __('Credit Limit') . '</th>
+				<th>' . __('Credit Available') . '</th>
+				<th>' . __('Last Paid') . '</th>
+				<th>' . __('Currency') . '</th>
+			</tr>';
+	$Today = date('Y-m-d');
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Available = GetCreditAvailable($MyRow['debtorno']);
+		$Overdue = $MyRow['nextreviewdate'] < $Today;
+		$HTML .= '<tr class="striped_row">
+				<td>' . $MyRow['debtorno'] . '</td>
+				<td>' . $MyRow['name'] . '</td>
+				<td>' . ConvertSQLDate($MyRow['nextreviewdate']) . ($Overdue ? ' (' . __('overdue') . ')' : '') . '</td>
+				<td class="number">' . locale_number_format($MyRow['balance'], $MyRow['decimalplaces']) . '</td>
+				<td class="number">' . locale_number_format($MyRow['overdue'], $MyRow['decimalplaces']) . '</td>
+				<td class="number">' . locale_number_format($MyRow['creditlimit'], $MyRow['decimalplaces']) . '</td>
+				<td class="number">' . locale_number_format($Available, $MyRow['decimalplaces']) . '</td>
+				<td>' . (mb_strlen((string)$MyRow['lastpaiddate']) > 1 ? ConvertSQLDate(mb_substr($MyRow['lastpaiddate'], 0, 10)) : '') . '</td>
+				<td>' . $MyRow['currcode'] . '</td>
+			</tr>';
+	}
+	$HTML .= '</table>';
+
+	if (isset($_POST['PrintPDF'])) {
+		$HTML .= '</body></html>';
+		$DomPDF = new Dompdf($DomPDFOptions);
+		$DomPDF->loadHtml($HTML);
+		$DomPDF->setPaper($_SESSION['PageSize'], 'landscape');
+		$DomPDF->render();
+		$DomPDF->stream($_SESSION['DatabaseName'] . '_CreditReviewsDue_' . date('Y-m-d') . '.pdf', array('Attachment' => false));
+		exit();
+	}
+
+	$Title = __('Credit Reviews Due');
+	include('includes/header.php');
+	echo '<p class="page_title_text">' . $Title . '</p>' . $HTML;
+	echo '<div class="centre noPrint"><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">' . __('New selection') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+$Title = __('Credit Reviews Due');
+include('includes/header.php');
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . $Title . '</p>';
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Customers whose credit review is overdue or due soon') . '</legend>
+			<field>
+				<label for="Days">' . __('Due within this many days') . ':</label>
+				<input type="text" class="integer" name="Days" size="5" maxlength="4" value="' . $Days . '" />
+			</field>
+		</fieldset>
+		<div class="centre">
+			<input type="submit" name="View" value="' . __('View') . '" />
+			<input type="submit" name="PrintPDF" value="' . __('Print PDF') . '" />
+		</div>
+	</form>';
+include('includes/footer.php');
diff --git a/CreditReviews.php b/CreditReviews.php
new file mode 100644
index 0000000..6986e5c
--- /dev/null
+++ b/CreditReviews.php
@@ -0,0 +1,312 @@
+<?php
+
+/* Credit reviews of a customer: record a review (credit control only), see the history newest first and void an
+entry made by mistake. Also shows the reminders sent to the customer and the late payment charges raised.
+A customer who logs in sees only their own reminders and charges, never the reviews. */
+
+require(__DIR__ . '/includes/session.php');
+include_once('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Reviews');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditReviews';
+include('includes/header.php');
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+} elseif (isset($_SESSION['CustomerID']) and $_SESSION['CustomerID'] != '') {
+	$DebtorNo = $_SESSION['CustomerID'];
+}
+
+if (CreditCustomerLogin()) {
+	$DebtorNo = $_SESSION['CustomerID'];
+}
+
+if (!isset($DebtorNo) or $DebtorNo == '') {
+	prnMsg(__('Select a customer first, then choose its credit reviews'), 'info');
+	echo '<div class="centre"><a href="' . $RootPath . '/SelectCustomer.php">' . __('Select a customer') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+$SQL = "SELECT debtorsmaster.name,
+				debtorsmaster.currcode,
+				debtorsmaster.creditlimit,
+				debtorsmaster.holdreason,
+				debtorsmaster.nextreviewdate,
+				holdreasons.reasondescription,
+				holdreasons.dissallowinvoices,
+				currencies.decimalplaces
+		FROM debtorsmaster
+		INNER JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+		INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+		WHERE debtorsmaster.debtorno='" . $DebtorNo . "'";
+$Result = DB_query($SQL);
+if (DB_num_rows($Result) == 0 or !CreditCanSeeCustomer($DebtorNo)) {
+	prnMsg(__('You have no authority to review the credit information of this customer, or the customer does not exist'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($Result);
+$DP = $Customer['decimalplaces'];
+$Outcomes = CreditReviewOutcomes();
+$HereURL = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+
+if (CreditCanSeeReviews()) {
+
+	/* ---- a new review ---- */
+	if (isset($_POST['SubmitReview'])) {
+		$InputError = 0;
+		$ReviewDate = CreditSQLDate($_POST['ReviewDate']);
+		$NextReviewDate = CreditSQLDate($_POST['NextReviewDate']);
+		if ($ReviewDate == '' or $NextReviewDate == '') {
+			$InputError = 1;
+			prnMsg(__('The review date and the date the next review is due must be valid dates'), 'error');
+		}
+		if (!isset($Outcomes[$_POST['Outcome']])) {
+			$InputError = 1;
+			prnMsg(__('Choose the outcome of the review'), 'error');
+		}
+		$NewLimit = filter_number_format($_POST['NewLimit']);
+		if (($_POST['Outcome'] == 'raised' or $_POST['Outcome'] == 'lowered') and !is_numeric($NewLimit)) {
+			$InputError = 1;
+			prnMsg(__('Enter the new credit limit'), 'error');
+		}
+		if ($InputError == 0) {
+			$Error = CreditSaveReview($DebtorNo, $_POST['Outcome'], $NewLimit, $_POST['NewHoldReason'], $ReviewDate, $NextReviewDate, $_POST['Comments']);
+			if ($Error == '') {
+				prnMsg(__('The review has been recorded and the customer account updated'), 'success');
+				unset($_POST['Comments']);
+				$Result = DB_query($SQL);
+				$Customer = DB_fetch_array($Result);
+			} else {
+				prnMsg($Error, 'error');
+			}
+		}
+	}
+
+	/* ---- void a review entered by mistake: it stays in the history, struck through, with who and why ---- */
+	if (isset($_POST['VoidReview'])) {
+		if (!CreditControlUser()) {
+			prnMsg(__('Only credit control may correct reviews'), 'error');
+		} elseif (trim($_POST['VoidReason']) == '') {
+			prnMsg(__('Give the reason the review is being voided'), 'error');
+		} else {
+			DB_Txn_Begin();
+			DB_query("UPDATE creditreviews SET voided=1,
+												voidedby='" . $_SESSION['UserID'] . "',
+												voiddate='" . date('Y-m-d H:i:s') . "',
+												voidreason='" . mb_substr($_POST['VoidReason'], 0, 255) . "'
+						WHERE id='" . (int)$_POST['ReviewID'] . "'
+						AND debtorno='" . $DebtorNo . "'
+						AND voided=0", '', '', true);
+			/* the next review date goes back to what the latest review still standing says */
+			$LatestResult = DB_query("SELECT nextreviewdate FROM creditreviews
+										WHERE debtorno='" . $DebtorNo . "' AND voided=0
+										ORDER BY reviewdate DESC, id DESC LIMIT 1", '', '', true);
+			if (DB_num_rows($LatestResult) == 1) {
+				$LatestRow = DB_fetch_row($LatestResult);
+				DB_query("UPDATE debtorsmaster SET nextreviewdate='" . $LatestRow[0] . "' WHERE debtorno='" . $DebtorNo . "'", '', '', true);
+			}
+			DB_Txn_Commit();
+			prnMsg(__('The review has been voided') . '. ' . __('Changes to the credit limit or hold status that review made are not undone - record a new review if they need correcting'), 'warn');
+			$Result = DB_query($SQL);
+			$Customer = DB_fetch_array($Result);
+		}
+	}
+}
+
+/* ---- the customer ---- */
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . __('Customer') . '" alt="" />
+		' . $Title . ': ' . $DebtorNo . ' - ' . $Customer['name'] . '</p>';
+echo '<div class="centre noPrint"><a href="' . $RootPath . '/SelectCustomer.php?DebtorNo=' . urlencode($DebtorNo) . '">' . __('Back to the customer') . '</a></div>';
+
+$State = CreditHoldState($Customer['dissallowinvoices']);
+if ($State == 'hold') {
+	echo '<p class="bad" style="font-size:large"><b>' . __('ACCOUNT ON HOLD') . '</b></p>';
+} elseif ($State == 'watch') {
+	echo '<p class="warn" style="font-size:large"><b>' . __('ACCOUNT ON WATCH') . '</b></p>';
+}
+echo '<table class="selection">
+		<tr><th>' . __('Credit Status') . '</th><td>' . $Customer['reasondescription'] . '</td></tr>
+		<tr><th>' . __('Credit Limit') . '</th><td class="number">' . locale_number_format($Customer['creditlimit'], $DP) . ' ' . $Customer['currcode'] . '</td></tr>
+		<tr><th>' . __('Next Review Due') . '</th><td>' . ConvertSQLDate($Customer['nextreviewdate']) . '</td></tr>
+	</table><br />';
+
+if (CreditCanSeeReviews()) {
+
+	/* ---- the form, for credit control only; everybody else sees the hold but cannot change it ---- */
+	if (CreditControlUser()) {
+		$Today = date('Y-m-d');
+		$Next = date('Y-m-d', strtotime('+' . CreditReviewIntervalDays() . ' days'));
+		echo '<form method="post" action="' . $HereURL . '">
+				<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+				<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+				<fieldset>
+				<legend>' . __('Record A Credit Review') . '</legend>
+				<field>
+					<label for="ReviewDate">' . __('Review Date') . ':</label>
+					<input type="date" name="ReviewDate" value="' . (isset($_POST['ReviewDate']) ? $_POST['ReviewDate'] : $Today) . '" required="required" />
+				</field>
+				<field>
+					<label for="Outcome">' . __('Outcome') . ':</label>
+					<select name="Outcome" required="required">';
+		foreach ($Outcomes as $Code => $Text) {
+			echo '<option value="' . $Code . '"' . ((isset($_POST['Outcome']) and $_POST['Outcome'] == $Code) ? ' selected="selected"' : '') . '>' . $Text . '</option>';
+		}
+		echo '</select>
+				</field>
+				<field>
+					<label for="NewLimit">' . __('New Credit Limit (when raised or lowered)') . ':</label>
+					<input type="text" class="number" name="NewLimit" size="16" maxlength="14" value="' . (isset($_POST['NewLimit']) ? $_POST['NewLimit'] : '') . '" />
+				</field>
+				<field>
+					<label for="NewHoldReason">' . __('Credit Status (when put on hold, on watch or released)') . ':</label>
+					<select name="NewHoldReason">';
+		$ReasonResult = DB_query("SELECT reasoncode, reasondescription, dissallowinvoices FROM holdreasons ORDER BY dissallowinvoices, reasoncode");
+		while ($ReasonRow = DB_fetch_array($ReasonResult)) {
+			$Kind = array(0 => __('invoicing allowed'), 1 => __('on hold'), 2 => __('watch'));
+			echo '<option value="' . $ReasonRow['reasoncode'] . '"' . ((isset($_POST['NewHoldReason']) and $_POST['NewHoldReason'] == $ReasonRow['reasoncode']) ? ' selected="selected"' : '') . '>' . $ReasonRow['reasondescription'] . ' (' . (isset($Kind[$ReasonRow['dissallowinvoices']]) ? $Kind[$ReasonRow['dissallowinvoices']] : $ReasonRow['dissallowinvoices']) . ')</option>';
+		}
+		echo '</select>
+				</field>
+				<field>
+					<label for="NextReviewDate">' . __('Next Review Due') . ':</label>
+					<input type="date" name="NextReviewDate" value="' . (isset($_POST['NextReviewDate']) ? $_POST['NextReviewDate'] : $Next) . '" required="required" />
+				</field>
+				<field>
+					<label for="Comments">' . __('Comments') . ':</label>
+					<textarea name="Comments" cols="90" rows="12">' . (isset($_POST['Comments']) ? $_POST['Comments'] : '') . '</textarea>
+				</field>
+				</fieldset>
+				<div class="centre"><input type="submit" name="SubmitReview" value="' . __('Record Review') . '" /></div>
+			</form>';
+	} else {
+		echo '<p class="warn">' . __('Only credit control can record reviews and change the credit limit or hold status') . '</p>';
+	}
+
+	/* ---- history, newest first ---- */
+	$HistoryResult = DB_query("SELECT creditreviews.*, www_users.realname
+								FROM creditreviews
+								LEFT JOIN www_users ON creditreviews.userid=www_users.userid
+								WHERE creditreviews.debtorno='" . $DebtorNo . "'
+								ORDER BY creditreviews.reviewdate DESC, creditreviews.id DESC");
+	echo '<table class="selection">
+			<caption>' . __('Review History') . '</caption>
+			<tr>
+				<th>' . __('Date') . '</th>
+				<th>' . __('By') . '</th>
+				<th>' . __('Outcome') . '</th>
+				<th>' . __('Credit Limit') . '</th>
+				<th>' . __('Credit Status') . '</th>
+				<th>' . __('Next Review') . '</th>
+				<th>' . __('Comments') . '</th>
+				<th></th>
+			</tr>';
+	if (DB_num_rows($HistoryResult) == 0) {
+		echo '<tr><td colspan="8">' . __('There are no reviews recorded for this customer') . '</td></tr>';
+	}
+	$ReasonNames = array();
+	$ReasonResult = DB_query("SELECT reasoncode, reasondescription FROM holdreasons");
+	while ($ReasonRow = DB_fetch_array($ReasonResult)) {
+		$ReasonNames[$ReasonRow['reasoncode']] = $ReasonRow['reasondescription'];
+	}
+	while ($Review = DB_fetch_array($HistoryResult)) {
+		$Style = $Review['voided'] == 1 ? ' style="text-decoration:line-through"' : '';
+		$LimitText = locale_number_format($Review['oldcreditlimit'], $DP);
+		if ($Review['newcreditlimit'] != $Review['oldcreditlimit']) {
+			$LimitText .= ' &rarr; ' . locale_number_format($Review['newcreditlimit'], $DP);
+		}
+		$StatusText = isset($ReasonNames[$Review['oldholdreason']]) ? $ReasonNames[$Review['oldholdreason']] : $Review['oldholdreason'];
+		if ($Review['newholdreason'] != $Review['oldholdreason']) {

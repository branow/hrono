+<?php
+
+// Credit control: reviews, reminders, late payment charges and bad debt write-offs.
+// Every step is idempotent so a re-run (or a run on a database installed from the demo data) is harmless.
+
+// 1. The date the next credit review of a customer is due
+AddColumn('nextreviewdate', 'debtorsmaster', 'date', 'NOT NULL', '1000-01-01', 'language_id');
+
+// 2. The two new default ledger accounts: late payment charge income and bad debt expense
+AddColumn('latechargeact', 'companies', 'varchar(20)', 'NOT NULL', '0', 'freightact');
+AddColumn('baddebtact', 'companies', 'varchar(20)', 'NOT NULL', '0', 'latechargeact');
+
+// 3. Tables. Reviews, reminders and charges belong to the customer.
+CreateTable('creditreviews', "CREATE TABLE `creditreviews` (
+  `id` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `reviewdate` date NOT NULL DEFAULT '1000-01-01',
+  `userid` varchar(20) NOT NULL DEFAULT '',
+  `outcome` varchar(10) NOT NULL DEFAULT 'kept',
+  `oldcreditlimit` double NOT NULL DEFAULT '0',
+  `newcreditlimit` double NOT NULL DEFAULT '0',
+  `oldholdreason` smallint NOT NULL DEFAULT '0',
+  `newholdreason` smallint NOT NULL DEFAULT '0',
+  `nextreviewdate` date NOT NULL DEFAULT '1000-01-01',
+  `comments` text,
+  `inputdate` datetime NOT NULL DEFAULT '1000-01-01 00:00:00',
+  `voided` tinyint NOT NULL DEFAULT '0',
+  `voidedby` varchar(20) NOT NULL DEFAULT '',
+  `voiddate` datetime DEFAULT NULL,
+  `voidreason` varchar(255) NOT NULL DEFAULT '',
+  PRIMARY KEY (`id`),
+  KEY `debtorno` (`debtorno`),
+  KEY `reviewdate` (`reviewdate`),
+  CONSTRAINT `creditreviews_ibfk_1` FOREIGN KEY (`debtorno`) REFERENCES `debtorsmaster` (`debtorno`)
+)");
+
+CreateTable('creditreminders', "CREATE TABLE `creditreminders` (
+  `id` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `reminderlevel` tinyint NOT NULL DEFAULT '1',
+  `sentdate` datetime NOT NULL DEFAULT '1000-01-01 00:00:00',
+  `userid` varchar(20) NOT NULL DEFAULT '',
+  `sentto` varchar(255) NOT NULL DEFAULT '',
+  `onhold` tinyint NOT NULL DEFAULT '0',
+  PRIMARY KEY (`id`),
+  KEY `debtorno` (`debtorno`),
+  KEY `sentdate` (`sentdate`),
+  CONSTRAINT `creditreminders_ibfk_1` FOREIGN KEY (`debtorno`) REFERENCES `debtorsmaster` (`debtorno`)
+)");
+
+CreateTable('creditreminderitems', "CREATE TABLE `creditreminderitems` (
+  `id` int NOT NULL AUTO_INCREMENT,
+  `reminderid` int NOT NULL DEFAULT '0',
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `reminderlevel` tinyint NOT NULL DEFAULT '1',
+  `debtortransid` int NOT NULL DEFAULT '0',
+  `transtype` smallint NOT NULL DEFAULT '10',
+  `transno` int NOT NULL DEFAULT '0',
+  `balance` double NOT NULL DEFAULT '0',
+  PRIMARY KEY (`id`),
+  UNIQUE KEY `onceperlevel` (`debtortransid`, `reminderlevel`),
+  KEY `reminderid` (`reminderid`),
+  KEY `debtorno` (`debtorno`),
+  CONSTRAINT `creditreminderitems_ibfk_1` FOREIGN KEY (`reminderid`) REFERENCES `creditreminders` (`id`)
+)");
+
+CreateTable('creditcharges', "CREATE TABLE `creditcharges` (
+  `id` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `chargemonth` char(7) NOT NULL DEFAULT '',
+  `debtortransid` int NOT NULL DEFAULT '0',
+  `transno` int NOT NULL DEFAULT '0',
+  `interest` double NOT NULL DEFAULT '0',
+  `fee` double NOT NULL DEFAULT '0',
+  `userid` varchar(20) NOT NULL DEFAULT '',
+  `inputdate` datetime NOT NULL DEFAULT '1000-01-01 00:00:00',
+  PRIMARY KEY (`id`),
+  UNIQUE KEY `onceamonth` (`debtorno`, `chargemonth`),
+  CONSTRAINT `creditcharges_ibfk_1` FOREIGN KEY (`debtorno`) REFERENCES `debtorsmaster` (`debtorno`)
+)");
+
+// 4. Settings
+NewConfigValue('LateChargeInterestRate', '0');
+NewConfigValue('LateChargeReminderFee', '0');
+NewConfigValue('CreditReviewIntervalDays', '365');
+NewConfigValue('ReminderText1', 'Our records show that the invoices listed below are now past due. If you have already paid them please disregard this reminder, otherwise we would be grateful for your payment.');
+NewConfigValue('ReminderText2', 'Despite our earlier reminder the invoices listed below remain unpaid and are seriously overdue. Please arrange payment immediately.');
+NewConfigValue('ReminderText3', 'FINAL NOTICE: the invoices listed below remain unpaid. Unless payment is received immediately we will take further action, which may include withholding supply and charging late payment fees.');
+
+// 5. Transaction types for the late payment charge and the bad debt write-off
+NewSysType(13, 'Late Payment Charge');
+NewSysType(14, 'Bad Debt Write-off');
+
+// 6. Security: only holders of token 21 (credit controllers) can hold, release or change limits.
+//    The System Administrator role gets the token; other roles are granted it through the role maintenance.
+NewSecurityToken(21, 'Credit Control - hold, release, reviews, reminders, charges and write-offs');
+InsertRecord('securitygroups', array('secroleid', 'tokenid'), array(8, 21), array('secroleid', 'tokenid'), array(8, 21));
+
+// 7. Pages and menu entries on the receivables menus
+NewScript('CreditReviews.php', 2);
+NewScript('CreditReviewDue.php', 2);
+NewScript('CreditReminders.php', 21);
+NewScript('LateCharges.php', 21);
+NewScript('BadDebtWriteOff.php', 21);
+
+NewMenuItem('AR', 'Maintenance', __('Credit Reviews'), '/CreditReviews.php', 3);
+NewMenuItem('AR', 'Reports', __('Credit Reviews Due'), '/CreditReviewDue.php', 11);
+NewMenuItem('AR', 'Transactions', __('Credit Control Reminders'), '/CreditReminders.php', 5);
+NewMenuItem('AR', 'Transactions', __('Late Payment Charges'), '/LateCharges.php', 6);
+NewMenuItem('AR', 'Transactions', __('Bad Debt Write-off'), '/BadDebtWriteOff.php', 7);
+
+// 8. Existing customers have never been reviewed in webERP: their first review falls due one review interval from now.
+//    Only customers still carrying the sentinel are touched, so a re-run does not move dates that have been set.
+$FirstReviewDate = date('Y-m-d', strtotime('+365 days'));
+$ReviewResult = DB_query("SELECT confvalue FROM config WHERE confname='CreditReviewIntervalDays'");
+if (DB_num_rows($ReviewResult) == 1) {
+	$ReviewRow = DB_fetch_row($ReviewResult);
+	if ((int)$ReviewRow[0] > 0) {
+		$FirstReviewDate = date('Y-m-d', strtotime('+' . (int)$ReviewRow[0] . ' days'));
+	}
+}
+UpdateField('debtorsmaster', 'nextreviewdate', $FirstReviewDate, "nextreviewdate='1000-01-01'");
+
+if ($_SESSION['Updates']['Errors'] == 0) {
+	UpdateDBNo(basename(__FILE__, '.php'), __('Credit control: reviews, reminders, late payment charges and bad debt write-offs'));

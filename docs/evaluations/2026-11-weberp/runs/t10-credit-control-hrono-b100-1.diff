+				<td class="number"' . $Style . '>' . $LimitText . '</td>
+				<td' . $Style . '>' . $StatusText . '</td>
+				<td' . $Style . '>' . ConvertSQLDate($Review['nextreviewdate']) . '</td>
+				<td' . $Style . '>' . nl2br($Review['comments']) . '</td>
+				<td>';

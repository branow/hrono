+/* Late payment charges, run by credit control at month end: interest on overdue invoices at the rate set in the system
+parameters and a fixed reminder fee for each final notice sent in the month. Nothing is charged until credit control
+runs it, and running it twice for the same month charges nobody twice (one charge per customer per month, enforced by
+the database). A charge is a customer transaction (type 13) in the customer's currency, posted to the income account
+chosen in the company preferences. */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/SQL_CommonFunctions.php');
+include_once('includes/CreditControlFunctions.php');
+
+$Title = __('Late Payment Charges');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'LateCharges';
+include('includes/header.php');
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . $Title . '</p>';
+
+if (!CreditControlUser() or CreditCustomerLogin()) {
+	prnMsg(__('Only credit control may charge late payment interest and fees'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$InterestRate = isset($_SESSION['LateChargeInterestRate']) ? (float)$_SESSION['LateChargeInterestRate'] : 0;
+$ReminderFee = isset($_SESSION['LateChargeReminderFee']) ? (float)$_SESSION['LateChargeReminderFee'] : 0;
+$Accounts = CreditCompanyAccounts();
+$Why = '';
+if (!CreditAccountPostable($Accounts['latechargeact'], $Why)) {
+	prnMsg(__('The late payment charge income account cannot be used') . ': ' . $Why . '. ' . __('Choose it in the company preferences'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+if ($InterestRate <= 0 and $ReminderFee <= 0) {
+	prnMsg(__('Neither an interest rate nor a reminder fee has been set in the system parameters, so there is nothing to charge'), 'warn');
+	include('includes/footer.php');
+	exit();
+}
+
+/* the month being charged, as YYYY-MM, which must have ended */
+$Month = date('Y-m', strtotime('first day of last month'));
+if (isset($_POST['Month']) and preg_match('/^\d{4}-\d{2}$/', $_POST['Month'])) {
+	$Month = $_POST['Month'];
+}
+$MonthStart = $Month . '-01';
+$MonthEnd = date('Y-m-t', strtotime($MonthStart));
+if ($MonthEnd > date('Y-m-d')) {
+	prnMsg(__('That month has not ended yet'), 'error');
+	$Month = date('Y-m', strtotime('first day of last month'));
+	$MonthStart = $Month . '-01';
+	$MonthEnd = date('Y-m-t', strtotime($MonthStart));
+}
+
+/* what each customer would be charged for the month */
+function LateChargeCandidates($MonthStart, $MonthEnd, $InterestRate, $ReminderFee) {
+	$Customers = array();
+	$SQL = "SELECT debtortrans.id,
+					debtortrans.transno,
+					debtortrans.balance,
+					debtortrans.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					currencies.decimalplaces,
+					currencies.rate,
+					" . CreditDueDateSQL() . " AS duedate
+			FROM debtortrans
+			INNER JOIN debtorsmaster ON debtortrans.debtorno=debtorsmaster.debtorno
+			INNER JOIN paymentterms ON debtorsmaster.paymentterms=paymentterms.termsindicator
+			INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+			WHERE debtortrans.type=10
+			AND ROUND(debtortrans.balance, currencies.decimalplaces) > 0
+			AND " . CreditDueDateSQL() . " < '" . $MonthEnd . "'" .
+			CreditSalesmanCustomerSQL('debtortrans.debtorno') . "
+			ORDER BY debtortrans.debtorno, debtortrans.transno";
+	$Result = DB_query($SQL);
+	while ($Row = DB_fetch_array($Result)) {
+		$No = $Row['debtorno'];
+		if (!isset($Customers[$No])) {
+			$Customers[$No] = array('name' => $Row['name'], 'currcode' => $Row['currcode'], 'dp' => $Row['decimalplaces'], 'rate' => $Row['rate'], 'interest' => 0, 'fee' => 0, 'finals' => 0, 'invoices' => array());
+		}
+		/* interest accrues for every day of the month after the invoice fell due */
+		$From = max($Row['duedate'], date('Y-m-d', strtotime($MonthStart . ' -1 day')));
+		$Days = (int)round((strtotime($MonthEnd) - strtotime($From)) / 86400);
+		if ($Days > 0 and $InterestRate > 0) {
+			$Interest = round($Row['balance'] * $InterestRate / 100 * $Days / 365, $Row['decimalplaces']);
+			$Customers[$No]['interest'] += $Interest;
+			$Customers[$No]['invoices'][] = $Row['transno'] . ' (' . $Days . ' ' . __('days') . ')';
+		}
+	}
+	/* the reminder fee: one for each final notice sent in the month, in the home currency, converted to the customer's currency */
+	if ($ReminderFee > 0) {
+		$Result = DB_query("SELECT creditreminders.debtorno, COUNT(*) AS finals, debtorsmaster.name, debtorsmaster.currcode, currencies.decimalplaces, currencies.rate
+							FROM creditreminders
+							INNER JOIN debtorsmaster ON creditreminders.debtorno=debtorsmaster.debtorno
+							INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+							WHERE creditreminders.reminderlevel=3
+							AND creditreminders.sentdate >= '" . $MonthStart . " 00:00:00'
+							AND creditreminders.sentdate <= '" . $MonthEnd . " 23:59:59'" .
+							CreditSalesmanCustomerSQL('creditreminders.debtorno') . "
+							GROUP BY creditreminders.debtorno, debtorsmaster.name, debtorsmaster.currcode, currencies.decimalplaces, currencies.rate");
+		while ($Row = DB_fetch_array($Result)) {
+			$No = $Row['debtorno'];
+			if (!isset($Customers[$No])) {
+				$Customers[$No] = array('name' => $Row['name'], 'currcode' => $Row['currcode'], 'dp' => $Row['decimalplaces'], 'rate' => $Row['rate'], 'interest' => 0, 'fee' => 0, 'finals' => 0, 'invoices' => array());
+			}
+			$Customers[$No]['finals'] = $Row['finals'];
+			$Customers[$No]['fee'] = round($Row['finals'] * $ReminderFee * $Row['rate'], $Row['decimalplaces']);
+		}
+	}
+	foreach ($Customers as $No => $Customer) {
+		$Customers[$No]['total'] = $Customer['interest'] + $Customer['fee'];
+		$Done = DB_query("SELECT transno FROM creditcharges WHERE debtorno='" . $No . "' AND chargemonth='" . mb_substr($MonthStart, 0, 7) . "'");
+		$Customers[$No]['done'] = (DB_num_rows($Done) > 0);
+		if ($Customers[$No]['total'] <= 0) {
+			unset($Customers[$No]);
+		}
+	}
+	return $Customers;
+}
+
+if (isset($_POST['Run'])) {
+	$Selected = isset($_POST['Include']) && is_array($_POST['Include']) ? array_keys($_POST['Include']) : array();
+	$Tags = array();
+	if (isset($_POST['Tags']) && is_array($_POST['Tags'])) {
+		foreach ($_POST['Tags'] as $Tag) {
+			$Tags[] = (int)$Tag;
+		}
+	}
+	$Candidates = LateChargeCandidates($MonthStart, $MonthEnd, $InterestRate, $ReminderFee);
+	$Charged = array();
+	$Skipped = array();
+	foreach ($Selected as $DebtorNo) {
+		if (!isset($Candidates[$DebtorNo])) {
+			continue;
+		}
+		$Customer = $Candidates[$DebtorNo];
+		if ($Customer['done']) {
+			$Skipped[$DebtorNo] = __('Already charged for') . ' ' . $Month;
+			continue;
+		}
+		DB_Txn_Begin();
+		$Text = __('Late payment charge for') . ' ' . $Month . ': ' . __('interest') . ' ' . locale_number_format($Customer['interest'], $Customer['dp']) .
+				($Customer['finals'] > 0 ? ', ' . $Customer['finals'] . ' ' . __('final notice fee(s)') . ' ' . locale_number_format($Customer['fee'], $Customer['dp']) : '');
+		$Trans = CreditPostTransaction(13, $DebtorNo, $Customer['total'], __('Late charges') . ' ' . $Month, $Text, $MonthEnd, $Accounts['latechargeact'], $Tags);
+		DB_query("INSERT INTO creditcharges (debtorno, chargemonth, debtortransid, transno, interest, fee, userid, inputdate)
+					VALUES ('" . $DebtorNo . "', '" . $Month . "', '" . $Trans['id'] . "', '" . $Trans['transno'] . "', '" . $Customer['interest'] . "',
+							'" . $Customer['fee'] . "', '" . $_SESSION['UserID'] . "', '" . date('Y-m-d H:i:s') . "')", '', '', false, false);
+		if (DB_error_no() != 0) {
+			// somebody else charged this customer for the month in the meantime - nothing of this attempt is kept
+			DB_Txn_Rollback();
+			$Skipped[$DebtorNo] = __('Already charged for') . ' ' . $Month;
+			continue;
+		}
+		DB_Txn_Commit();
+		$Charged[$DebtorNo] = array('transno' => $Trans['transno'], 'total' => $Customer['total'], 'name' => $Customer['name'], 'dp' => $Customer['dp'], 'currcode' => $Customer['currcode']);
+	}
+	if (count($Charged) > 0) {
+		echo '<table class="selection"><caption>' . __('Charges raised') . '</caption>
+				<tr><th>' . __('Customer') . '</th><th>' . __('Charge No') . '</th><th>' . __('Amount') . '</th><th></th></tr>';
+		foreach ($Charged as $DebtorNo => $Charge) {
+			echo '<tr class="striped_row"><td>' . $DebtorNo . ' - ' . $Charge['name'] . '</td><td>' . $Charge['transno'] . '</td>
+					<td class="number">' . locale_number_format($Charge['total'], $Charge['dp']) . ' ' . $Charge['currcode'] . '</td>
+					<td><a target="_blank" href="' . $RootPath . '/PrintCustTrans.php?FromTransNo=' . $Charge['transno'] . '&amp;InvOrCredit=Charge&amp;View=Yes">' . __('Print') . '</a></td></tr>';
+		}
+		echo '</table><br />';
+	}
+	foreach ($Skipped as $DebtorNo => $Reason) {
+		prnMsg($DebtorNo . ': ' . $Reason, 'warn');
+	}
+}
+
+$Candidates = LateChargeCandidates($MonthStart, $MonthEnd, $InterestRate, $ReminderFee);
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Month to charge') . '</legend>
+			<field><label for="Month">' . __('Month') . ':</label><select name="Month" onchange="this.form.submit()">';
+for ($i = 1; $i <= 12; $i++) {
+	$Option = date('Y-m', strtotime('first day of -' . $i . ' month'));
+	echo '<option value="' . $Option . '"' . ($Option == $Month ? ' selected="selected"' : '') . '>' . $Option . '</option>';
+}
+echo '</select></field>
+			<field><label>' . __('Interest rate per year') . ':</label><fieldtext>' . $InterestRate . '%</fieldtext></field>
+			<field><label>' . __('Fee per final notice (home currency)') . ':</label><fieldtext>' . locale_number_format($ReminderFee, $_SESSION['CompanyRecord']['decimalplaces']) . '</fieldtext></field>
+			<field><label for="Tags">' . __('Ledger tags') . ':</label><select name="Tags[]" multiple="multiple" size="5">';
+$TagResult = DB_query("SELECT tagref, tagdescription FROM tags ORDER BY tagdescription");
+while ($TagRow = DB_fetch_array($TagResult)) {
+	echo '<option value="' . $TagRow['tagref'] . '">' . $TagRow['tagdescription'] . '</option>';
+}
+echo '</select></field>
+		</fieldset>
+		<table class="selection">
+		<caption>' . __('Charges for') . ' ' . $Month . ' - ' . __('untick anybody to leave them out') . '</caption>
+		<tr><th>' . __('Charge') . '</th><th>' . __('Customer') . '</th><th>' . __('Interest') . '</th><th>' . __('Final Notices') . '</th><th>' . __('Fee') . '</th><th>' . __('Total') . '</th></tr>';
+$Offered = 0;
+foreach ($Candidates as $DebtorNo => $Customer) {
+	if (!$Customer['done']) {
+		$Offered++;
+	}
+	echo '<tr class="striped_row">
+			<td>' . ($Customer['done'] ? __('Already charged') : '<input type="checkbox" name="Include[' . $DebtorNo . ']" value="1" checked="checked" />') . '</td>
+			<td>' . $DebtorNo . ' - ' . $Customer['name'] . '</td>
+			<td class="number">' . locale_number_format($Customer['interest'], $Customer['dp']) . '</td>
+			<td class="number">' . $Customer['finals'] . '</td>
+			<td class="number">' . locale_number_format($Customer['fee'], $Customer['dp']) . '</td>
+			<td class="number">' . locale_number_format($Customer['total'], $Customer['dp']) . ' ' . $Customer['currcode'] . '</td>
+		</tr>';
+}
+if (count($Candidates) == 0) {
+	echo '<tr><td colspan="6">' . __('Nothing to charge for this month') . '</td></tr>';
+}
+echo '</table>';
+if ($Offered > 0) {
+	echo '<div class="centre"><input type="submit" name="Run" value="' . __('Charge The Customers Selected') . '" onclick="return confirm(\'' . __('Raise these charges?') . '\');" /></div>';
+}
+echo '</form>';
+
+include('includes/footer.php');

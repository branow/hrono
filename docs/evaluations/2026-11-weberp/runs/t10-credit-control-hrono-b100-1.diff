+++ b/BadDebtWriteOff.php
@@ -0,0 +1,169 @@
+<?php
+
+/* Bad debt write-off, by credit control: writes off what is left on chosen invoices of a customer, or the whole
+balance, with a reason. The write-off is a customer transaction (type 14) in the customer's currency, posted to the bad debt
+expense account chosen in the company preferences - never to a control account - and allocated to the invoices it clears.
+For a foreign currency customer the difference between the rate of the invoice and the rate of the write-off goes to the
+sales exchange difference account, exactly as it does when a receipt is allocated. */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/SQL_CommonFunctions.php');
+include_once('includes/CreditControlFunctions.php');
+
+$Title = __('Bad Debt Write-off');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'BadDebtWriteOff';
+include('includes/header.php');
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . $Title . '</p>';
+
+if (!CreditControlUser() or CreditCustomerLogin()) {
+	prnMsg(__('Only credit control may write off bad debts'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+} elseif (isset($_SESSION['CustomerID'])) {
+	$DebtorNo = $_SESSION['CustomerID'];
+}
+if (!isset($DebtorNo) or $DebtorNo == '') {
+	prnMsg(__('Select a customer first'), 'info');
+	echo '<div class="centre"><a href="' . $RootPath . '/SelectCustomer.php">' . __('Select a customer') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+$CustomerResult = DB_query("SELECT debtorsmaster.name, debtorsmaster.currcode, currencies.decimalplaces, currencies.rate
+							FROM debtorsmaster INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+							WHERE debtorsmaster.debtorno='" . $DebtorNo . "'");
+if (DB_num_rows($CustomerResult) == 0 or !CreditCanSeeCustomer($DebtorNo)) {
+	prnMsg(__('The customer does not exist or you have no authority to see it'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($CustomerResult);
+$DP = $Customer['decimalplaces'];
+
+$Accounts = CreditCompanyAccounts();
+$Why = '';
+if (!CreditAccountPostable($Accounts['baddebtact'], $Why)) {
+	prnMsg(__('The bad debt expense account cannot be used') . ': ' . $Why . '. ' . __('Choose it in the company preferences'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$OpenSQL = "SELECT debtortrans.id, debtortrans.type, debtortrans.transno, debtortrans.trandate, debtortrans.rate,
+					debtortrans.ovamount + debtortrans.ovgst + debtortrans.ovfreight + debtortrans.ovdiscount AS total,
+					debtortrans.alloc, debtortrans.diffonexch, debtortrans.balance, debtortrans.branchcode, debtortrans.salesperson
+			FROM debtortrans
+			WHERE debtortrans.debtorno='" . $DebtorNo . "'
+			AND debtortrans.type IN (10, 13)
+			AND ROUND(debtortrans.balance, " . $DP . ") > 0";
+
+if (isset($_POST['WriteOff'])) {
+	$Reason = trim($_POST['Reason']);
+	$Chosen = array();
+	if (isset($_POST['WholeBalance'])) {
+		$Chosen = 'all';
+	} elseif (isset($_POST['Include']) && is_array($_POST['Include'])) {
+		$Chosen = array_map('intval', array_keys($_POST['Include']));
+	}
+	if (mb_strlen($Reason) < 3) {
+		prnMsg(__('A reason for the write-off must be given'), 'error');
+	} elseif ($Chosen !== 'all' and count($Chosen) == 0) {
+		prnMsg(__('Choose the invoices to write off, or the whole balance'), 'error');
+	} else {
+		DB_Txn_Begin();
+		// lock and read what is really left on the invoices now
+		$Result = DB_query($OpenSQL . ($Chosen === 'all' ? '' : " AND debtortrans.id IN (" . implode(',', $Chosen) . ")") . " ORDER BY debtortrans.trandate, debtortrans.transno FOR UPDATE", '', '', true);
+		$Items = array();
+		$Total = 0;
+		while ($Row = DB_fetch_array($Result)) {
+			$Items[] = $Row;
+			$Total += $Row['balance'];
+		}
+		if (count($Items) == 0) {
+			DB_Txn_Rollback();
+			prnMsg(__('There is nothing left to write off on those invoices'), 'warn');
+		} else {
+			$Total = round($Total, $DP);
+			$Today = date('Y-m-d');
+			$WriteOff = CreditPostTransaction(14, $DebtorNo, -$Total, __('Bad debt write-off'), $Reason, $Today, $Accounts['baddebtact'], array(), $Items[0]['branchcode'], $Items[0]['salesperson']);
+			$TotalDiff = 0;
+			foreach ($Items as $Item) {
+				$Amount = $Item['balance'];
+				// difference between the rate of the invoice and the rate of the write-off, as when a payment is allocated
+				$Diff = ($Amount / $WriteOff['rate']) - ($Amount / $Item['rate']);
+				$TotalDiff += $Diff;
+				DB_query("INSERT INTO custallocns (datealloc, amt, transid_allocfrom, transid_allocto)
+							VALUES ('" . $Today . "', '" . $Amount . "', '" . $WriteOff['id'] . "', '" . $Item['id'] . "')", __('The allocation of the write-off could not be inserted because'), '', true);
+				$NewAlloc = $Item['alloc'] + $Amount;
+				$Settled = (abs($NewAlloc - $Item['total']) < CurrencyTolerance($Customer['currcode'])) ? 1 : 0;
+				DB_query("UPDATE debtortrans SET alloc='" . $NewAlloc . "', diffonexch='" . ($Item['diffonexch'] + $Diff) . "', settled='" . $Settled . "'
+							WHERE id='" . $Item['id'] . "'", __('The invoice could not be cleared because'), '', true);
+			}
+			DB_query("UPDATE debtortrans SET alloc='" . -$Total . "', diffonexch='" . -$TotalDiff . "', settled=1 WHERE id='" . $WriteOff['id'] . "'",
+					__('The write-off could not be settled because'), '', true);
+			if (round($TotalDiff, $_SESSION['CompanyRecord']['decimalplaces']) != 0 and $Accounts['gllink_debtors'] == 1) {
+				$Movt = -$TotalDiff;
+				$Why = '';
+				if (!CreditAccountIsSet($Accounts['salesexchangediffact'])) {
+					DB_Txn_Rollback();
+					prnMsg(__('The sales exchange difference account is not set up, the write-off has not been made'), 'error');
+					include('includes/footer.php');
+					exit();
+				}
+				$PeriodDate = ConvertSQLDate($Today);
+				$PeriodNo = GetPeriod($PeriodDate);
+				DB_query("INSERT INTO gltrans (type, typeno, trandate, periodno, account, narrative, amount)
+							VALUES (14, '" . $WriteOff['transno'] . "', '" . $Today . "', '" . $PeriodNo . "', '" . $Accounts['salesexchangediffact'] . "', '', '" . round($Movt, $_SESSION['CompanyRecord']['decimalplaces']) . "')",
+						__('The exchange difference could not be posted because'), '', true);
+				DB_query("INSERT INTO gltrans (type, typeno, trandate, periodno, account, narrative, amount)
+							VALUES (14, '" . $WriteOff['transno'] . "', '" . $Today . "', '" . $PeriodNo . "', '" . $Accounts['debtorsact'] . "', '', '" . round(-$Movt, $_SESSION['CompanyRecord']['decimalplaces']) . "')",
+						__('The debtors control exchange difference could not be posted because'), '', true);
+			}
+			DB_Txn_Commit();
+			prnMsg(__('Write-off number') . ' ' . $WriteOff['transno'] . ' ' . __('of') . ' ' . locale_number_format($Total, $DP) . ' ' . $Customer['currcode'] . ' ' . __('has been posted and the invoices cleared'), 'success');
+		}
+	}
+}
+
+echo '<p><b>' . $DebtorNo . ' - ' . $Customer['name'] . '</b> (' . $Customer['currcode'] . ')</p>';
+$Result = DB_query($OpenSQL . " ORDER BY debtortrans.trandate, debtortrans.transno");
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('This customer has no invoices with a balance left to write off'), 'info');
+	include('includes/footer.php');
+	exit();
+}
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+		<table class="selection">
+		<tr><th>' . __('Write Off') . '</th><th>' . __('Type') . '</th><th>' . __('Number') . '</th><th>' . __('Date') . '</th><th>' . __('Amount') . '</th><th>' . __('Left To Pay') . '</th></tr>';
+$Sum = 0;
+while ($Row = DB_fetch_array($Result)) {
+	$Sum += $Row['balance'];
+	echo '<tr class="striped_row">
+			<td><input type="checkbox" name="Include[' . $Row['id'] . ']" value="1" /></td>
+			<td>' . ($Row['type'] == 13 ? __('Late payment charge') : __('Invoice')) . '</td>
+			<td>' . $Row['transno'] . '</td>
+			<td>' . ConvertSQLDate($Row['trandate']) . '</td>
+			<td class="number">' . locale_number_format($Row['total'], $DP) . '</td>
+			<td class="number">' . locale_number_format($Row['balance'], $DP) . '</td>
+		</tr>';
+}
+echo '<tr><td colspan="5"><b>' . __('Whole balance') . '</b> <input type="checkbox" name="WholeBalance" value="1" /></td><td class="number"><b>' . locale_number_format($Sum, $DP) . '</b></td></tr>
+		</table>
+		<fieldset>
+			<field>
+				<label for="Reason">' . __('Reason') . ':</label>
+				<textarea name="Reason" cols="70" rows="4" required="required"></textarea>
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="WriteOff" value="' . __('Write Off') . '" onclick="return confirm(\'' . __('Write off the amounts selected as bad debt?') . '\');" /></div>
+	</form>';
+
+include('includes/footer.php');

+}
+echo '</table><br />';
+
+/* ---- late payment charges ---- */
+$ChargeResult = DB_query("SELECT creditcharges.chargemonth, creditcharges.transno, creditcharges.interest, creditcharges.fee, debtortrans.trandate
+							FROM creditcharges
+							INNER JOIN debtortrans ON creditcharges.debtortransid=debtortrans.id
+							WHERE creditcharges.debtorno='" . $DebtorNo . "'" . $TransFilter . "
+							ORDER BY creditcharges.chargemonth DESC");

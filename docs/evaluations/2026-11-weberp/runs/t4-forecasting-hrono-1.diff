diff --git a/ForecastAccuracy.php b/ForecastAccuracy.php
new file mode 100644
index 0000000..02519d6
--- /dev/null
+++ b/ForecastAccuracy.php
@@ -0,0 +1,174 @@
+<?php
+
+// Compares past forecasts with the sales that followed: MAD, POA, MSE and RMSE per item, category and method.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Accuracy');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastAccuracy';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$FormAction = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$MethodNames = fcMethodNames();
+$Parameters = fcGetParameters();
+$History = fcHistoryRange();
+
+if ($History['from'] === null) {
+	prnMsg(__('There is no sales history to compare forecasts with. Extract the sales history first.'), 'warn');
+	include('includes/footer.php');
+	exit();
+}
+
+$FromMonth = $_POST['FromMonth'] ?? fcMonthLabel(max($History['from'], fcMonthAdd($History['to'], -5)));
+$ToMonth = $_POST['ToMonth'] ?? fcMonthLabel($History['to']);
+
+echo '<form method="post" action="' . $FormAction . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Accuracy of past forecasts') . '</legend>
+	<field>
+		<label for="FromMonth">' . __('From month') . ':</label>
+		<input type="month" name="FromMonth" id="FromMonth" required="required" value="' . $FromMonth . '" />
+	</field>
+	<field>
+		<label for="ToMonth">' . __('To month') . ':</label>
+		<input type="month" name="ToMonth" id="ToMonth" required="required" value="' . $ToMonth . '" />
+	</field>
+	</fieldset>
+	<div class="page_help_text">' . __('Months in the range are compared with the sales history held (') . fcMonthLabel($History['from']) . ' - ' . fcMonthLabel($History['to']) . __('). For each item and month the latest forecast made before that month began is used, with its revised quantity where there is one. MAD is the mean absolute deviation, MSE the mean squared error, RMSE its square root and POA the percent of accuracy: total forecast as a percent of total actual sales (100 is perfect).') . '</div>
+	<div class="centre"><input type="submit" name="Show" value="' . __('Show accuracy') . '" /></div>
+	</form>';
+
+if (isset($_POST['Show'])) {
+	if (!fcIsMonth($FromMonth) or !fcIsMonth($ToMonth) or $FromMonth > $ToMonth) {
+		prnMsg(__('Enter a valid range of months'), 'error');
+		include('includes/footer.php');
+		exit();
+	}
+	$From = $FromMonth . '-01';
+	$To = $ToMonth . '-01';
+	if ($From < $History['from']) {
+		$From = $History['from'];
+	}
+	if ($To > $History['to']) {
+		$To = $History['to'];
+	}
+
+	/* the forecast in force for each item, location and month: the latest one generated before the month began */
+	$Result = DB_query("SELECT fcforecasts.forecastid,
+							fcforecasts.stockid,
+							fcforecasts.loccode,
+							fcforecasts.methodid,
+							fcforecastdetails.periodstart,
+							" . fcEffectiveQuantitySQL() . " AS qty,
+							stockmaster.categoryid
+						FROM fcforecastdetails
+						INNER JOIN fcforecasts ON fcforecasts.forecastid = fcforecastdetails.forecastid
+						INNER JOIN stockmaster ON stockmaster.stockid = fcforecasts.stockid
+						WHERE fcforecastdetails.periodstart >= '" . $From . "'
+						AND fcforecastdetails.periodstart <= '" . $To . "'
+						AND fcforecasts.createdon < fcforecastdetails.periodstart
+						ORDER BY fcforecasts.forecastid");
+	$Chosen = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Chosen[$MyRow['stockid'] . "\t" . $MyRow['loccode'] . "\t" . $MyRow['periodstart']] = $MyRow;
+	}
+	if (count($Chosen) == 0) {
+		prnMsg(__('There are no forecasts for the months in this range that were generated before those months began'), 'info');
+		include('includes/footer.php');
+		exit();
+	}
+
+	/* actual sales of the same months, per item and location and over all locations */
+	$Result = DB_query("SELECT stockid, loccode, periodstart, SUM(quantity) AS qty
+						FROM fcsaleshistory
+						WHERE periodstart >= '" . $From . "' AND periodstart <= '" . $To . "'
+						GROUP BY stockid, loccode, periodstart");
+	$ActualByLocation = array();
+	$ActualAll = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$ActualByLocation[$MyRow['stockid'] . "\t" . $MyRow['loccode'] . "\t" . $MyRow['periodstart']] = (float) $MyRow['qty'];
+		$Key = $MyRow['stockid'] . "\t" . FC_ALL_LOCATIONS . "\t" . $MyRow['periodstart'];
+		$ActualAll[$Key] = ($ActualAll[$Key] ?? 0) + (float) $MyRow['qty'];
+	}
+
+	$ByItem = $ByCategory = $ByMethod = array();
+	foreach ($Chosen as $Key => $Row) {
+		$Actual = $Row['loccode'] == FC_ALL_LOCATIONS ? ($ActualAll[$Key] ?? 0) : ($ActualByLocation[$Key] ?? 0);
+		$Forecast = (float) $Row['qty'];
+		foreach (array(
+			array(&$ByItem, $Row['stockid'] . "\t" . $Row['loccode']),
+			array(&$ByCategory, $Row['categoryid']),
+			array(&$ByMethod, $Row['methodid'])
+		) as $Target) {
+			$Target[0][$Target[1]]['actual'][] = $Actual;
+			$Target[0][$Target[1]]['forecast'][] = $Forecast;
+		}
+	}
+
+	$Tolerance = (float) $Parameters['poathreshold'];
+	$Table = function ($Groups, $Label, $Name, $Limit = 0) use ($Tolerance) {
+		$Rows = array();
+		foreach ($Groups as $Group => $Series) {
+			$Metrics = fcMetrics($Series['actual'], $Series['forecast']);
+			$Low = ($Metrics['poa'] === null) ? ($Metrics['forecast'] > 0) : (abs($Metrics['poa'] - 100) > $Tolerance);
+			$Rows[] = array($Group, $Metrics, $Low);
+		}
+		usort($Rows, function ($A, $B) {
+			if ($A[2] != $B[2]) {
+				return $B[2] <=> $A[2];
+			}
+			return strcmp((string) $A[0], (string) $B[0]);
+		});
+		if ($Limit > 0) {
+			$Rows = array_slice($Rows, 0, $Limit);
+		}
+		echo '<br /><table class="selection"><tr><th colspan="8">' . $Label . '</th></tr>
+				<tr><th>' . $Name . '</th><th>' . __('Months') . '</th><th>' . __('Actual') . '</th><th>' . __('Forecast') . '</th><th>MAD</th><th>POA %</th><th>MSE</th><th>RMSE</th></tr>';
+		foreach ($Rows as $Row) {
+			list($Group, $Metrics, $Low) = $Row;
+			echo '<tr class="striped_row"' . ($Low ? ' style="background-color: #ffd9d9;"' : '') . '>
+					<td>' . $Group . '</td>
+					<td class="number">' . $Metrics['n'] . '</td>
+					<td class="number">' . fcMoney($Metrics['actual']) . '</td>
+					<td class="number">' . fcMoney($Metrics['forecast']) . '</td>
+					<td class="number">' . fcMoney($Metrics['mad']) . '</td>
+					<td class="number">' . ($Metrics['poa'] === null ? __('n/a') : locale_number_format($Metrics['poa'], 1)) . ($Low ? ' &#9888;' : '') . '</td>
+					<td class="number">' . fcMoney($Metrics['mse']) . '</td>
+					<td class="number">' . fcMoney($Metrics['rmse']) . '</td>
+				</tr>';
+		}
+		echo '</table>';
+	};
+
+	echo '<div class="page_help_text">' . __('Shaded rows with a warning sign have low accuracy: the POA is more than') . ' ' . $Tolerance . ' ' . __('points away from 100, or nothing was sold although a forecast was made. The tolerance is set in the forecast parameters.') . '</div>';
+
+	$MethodGroups = array();
+	foreach ($ByMethod as $Method => $Series) {
+		$MethodGroups[$Method . ' - ' . ($MethodNames[$Method] ?? '')] = $Series;
+	}
+	$Table($MethodGroups, __('Accuracy per method'), __('Method'));
+
+	$CategoryNames = array();
+	$CategoryResult = DB_query("SELECT categoryid, categorydescription FROM stockcategory");
+	while ($MyRow = DB_fetch_array($CategoryResult)) {
+		$CategoryNames[$MyRow['categoryid']] = $MyRow['categoryid'] . ' - ' . htmlspecialchars($MyRow['categorydescription'], ENT_QUOTES, 'UTF-8');
+	}
+	$CategoryGroups = array();
+	foreach ($ByCategory as $Category => $Series) {
+		$CategoryGroups[$CategoryNames[$Category] ?? $Category] = $Series;
+	}
+	$Table($CategoryGroups, __('Accuracy per category'), __('Category'));
+
+	$ItemGroups = array();
+	foreach ($ByItem as $Group => $Series) {
+		list($Stock, $Location) = explode("\t", $Group);
+		$ItemGroups['<a href="' . $RootPath . '/ForecastMethodComparison.php?StockID=' . urlencode($Stock) . '&amp;Location=' . urlencode($Location) . '">' . htmlspecialchars($Stock, ENT_QUOTES, 'UTF-8') . '</a> (' . ($Location == FC_ALL_LOCATIONS ? __('all locations') : $Location) . ')'] = $Series;
+	}
+	$Table($ItemGroups, __('Accuracy per item (items with low accuracy first, at most 500 shown)'), __('Item'), 500);
+}
+
+include('includes/footer.php');
diff --git a/ForecastDashboard.php b/ForecastDashboard.php

+CREATE TABLE `fcforecasts` (
+  `forecastid` int NOT NULL AUTO_INCREMENT,
+  `stockid` varchar(64) NOT NULL DEFAULT '',
+  `loccode` varchar(5) NOT NULL DEFAULT 'ALL',
+  `methodid` tinyint NOT NULL DEFAULT '0',
+  `parameters` varchar(255) NOT NULL DEFAULT '',
+  `bestfit` tinyint NOT NULL DEFAULT '0',
+  `historymonths` smallint NOT NULL DEFAULT '0',
+  `active` tinyint NOT NULL DEFAULT '1',
+  `createdon` datetime NOT NULL DEFAULT '1000-01-01 00:00:00',
+  `createdby` varchar(20) NOT NULL DEFAULT '',
+  PRIMARY KEY (`forecastid`),
+  KEY `stockloc` (`stockid`,`loccode`,`active`),

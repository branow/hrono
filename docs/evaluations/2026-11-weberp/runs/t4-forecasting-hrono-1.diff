+<?php
+
+// Converts the active forecasts (revised quantity first) into MRP demands under the forecast demand type so that the
+// normal MRP run (with "use MRP demands") plans purchases and work orders from them.
+//
+// The demands written are recorded in fcmrpdemands. Replace mode removes only recorded demands, so demands entered
+// by hand (including hand entered ones under the same demand type) or created by other processes are never touched.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Convert Forecasts to MRP Demands');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastToMRP';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$FormAction = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+
+$Scope = $_POST['Scope'] ?? 'all';
+$StockID = isset($_POST['StockID']) ? trim(mb_strtoupper($_POST['StockID'])) : '';
+$CategoryID = $_POST['CategoryID'] ?? '';
+$Mode = $_POST['Mode'] ?? 'replace';
+$FromMonth = $_POST['FromMonth'] ?? date('Y-m');
+$ToMonth = $_POST['ToMonth'] ?? fcMonthLabel(fcMonthAdd(date('Y-m-01'), 5));
+
+if (isset($_POST['Convert'])) {
+	$InputError = 0;
+	if (!fcIsMonth($FromMonth) or !fcIsMonth($ToMonth) or $FromMonth > $ToMonth) {
+		prnMsg(__('Enter a valid horizon: the first month must not be after the last month'), 'error');
+		$InputError = 1;
+	}
+	if ($Mode != 'replace' and $Mode != 'incremental') {
+		prnMsg(__('Choose replace or incremental mode'), 'error');
+		$InputError = 1;
+	}
+	$ScopeSQL = '';
+	if ($Scope == 'item') {
+		$Result = DB_query("SELECT stockid FROM stockmaster WHERE stockid = '" . $StockID . "'");
+		if ($StockID == '' or DB_num_rows($Result) == 0) {
+			prnMsg(__('Enter the code of an existing item'), 'error');
+			$InputError = 1;
+		}
+		$ScopeSQL = " AND stockmaster.stockid = '" . $StockID . "'";
+	} elseif ($Scope == 'category') {
+		$ScopeSQL = " AND stockmaster.categoryid = '" . $CategoryID . "'";
+	}
+
+	if ($InputError == 0) {
+		$From = $FromMonth . '-01';
+		$To = $ToMonth . '-01';
+		$Today = date('Y-m-d');
+
+		/* the demand type for forecasts must exist (the upgrade creates it; recreate it if somebody deleted it) */
+		DB_query("INSERT IGNORE INTO mrpdemandtypes (mrpdemandtype, description) VALUES ('" . FC_MRP_DEMAND_TYPE . "', 'Forecast')");
+
+		/* demands recorded as converted that were since deleted in the master schedule are no longer ours */
+		DB_query("DELETE FROM fcmrpdemands
+					WHERE NOT EXISTS (SELECT 1 FROM mrpdemands
+									WHERE mrpdemands.demandid = fcmrpdemands.demandid
+									AND mrpdemands.stockid = fcmrpdemands.stockid
+									AND mrpdemands.mrpdemandtype = '" . FC_MRP_DEMAND_TYPE . "')");
+
+		/* quantities to convert: per item and month the revised quantity, else the calculated one. When an item has
+		   a forecast for all locations combined that one is used, otherwise the forecasts of its locations add up -
+		   never both, which would count the same sales twice. */
+		$Result = DB_query("SELECT fcforecasts.forecastid,
+								fcforecasts.stockid,
+								fcforecasts.loccode,
+								fcforecastdetails.periodstart,
+								" . fcEffectiveQuantitySQL() . " AS qty
+							FROM fcforecasts
+							INNER JOIN fcforecastdetails ON fcforecastdetails.forecastid = fcforecasts.forecastid
+							INNER JOIN stockmaster ON stockmaster.stockid = fcforecasts.stockid
+							WHERE fcforecasts.active = 1
+							AND fcforecastdetails.periodstart >= '" . $From . "'
+							AND fcforecastdetails.periodstart <= '" . $To . "'" . $ScopeSQL . "
+							ORDER BY fcforecasts.stockid, fcforecastdetails.periodstart, fcforecasts.forecastid");
+		$Rows = array();
+		$HasAllLocations = array();
+		while ($MyRow = DB_fetch_array($Result)) {
+			$Rows[] = $MyRow;
+			if ($MyRow['loccode'] == FC_ALL_LOCATIONS) {
+				$HasAllLocations[$MyRow['stockid']] = true;
+			}
+		}
+		$Quantities = array();
+		foreach ($Rows as $MyRow) {
+			if (isset($HasAllLocations[$MyRow['stockid']]) and $MyRow['loccode'] != FC_ALL_LOCATIONS) {
+				continue;
+			}
+			$Key = $MyRow['stockid'] . "\t" . $MyRow['periodstart'];
+			if (!isset($Quantities[$Key])) {
+				$Quantities[$Key] = array('stockid' => $MyRow['stockid'], 'period' => $MyRow['periodstart'], 'qty' => 0, 'forecastid' => $MyRow['forecastid']);
+			}
+			$Quantities[$Key]['qty'] += (float) $MyRow['qty'];
+		}
+
+		$Deleted = $Added = $Skipped = 0;
+		DB_Txn_Begin();
+		if ($Mode == 'replace') {
+			/* the forecast demands of the items in scope and the horizon, whether or not they have a forecast now */
+			$Result = DB_query("SELECT fcmrpdemands.demandid
+								FROM fcmrpdemands
+								INNER JOIN stockmaster ON stockmaster.stockid = fcmrpdemands.stockid
+								WHERE fcmrpdemands.periodstart >= '" . $From . "'
+								AND fcmrpdemands.periodstart <= '" . $To . "'" . $ScopeSQL, '', '', true);
+			$DemandIDs = array();
+			while ($MyRow = DB_fetch_row($Result)) {
+				$DemandIDs[] = (int) $MyRow[0];
+			}
+			foreach (array_chunk($DemandIDs, 200) as $Chunk) {
+				DB_query("DELETE FROM mrpdemands WHERE mrpdemandtype = '" . FC_MRP_DEMAND_TYPE . "' AND demandid IN (" . implode(',', $Chunk) . ")", '', '', true);
+				DB_query("DELETE FROM fcmrpdemands WHERE demandid IN (" . implode(',', $Chunk) . ")", '', '', true);
+			}
+			$Deleted = count($DemandIDs);
+		}
+		foreach ($Quantities as $Row) {
+			if ($Row['qty'] <= 0) {
+				continue;
+			}
+			if ($Mode == 'incremental') {
+				$Result = DB_query("SELECT demandid FROM fcmrpdemands
+									WHERE stockid = '" . DB_escape_string($Row['stockid']) . "'
+									AND periodstart = '" . $Row['period'] . "'", '', '', true);
+				if (DB_num_rows($Result) > 0) {
+					$Skipped++;
+					continue;
+				}
+			}
+			/* due on the first of the month, or today for a month already under way */
+			$DueDate = max($Row['period'], $Today);
+			DB_query("INSERT INTO mrpdemands (stockid, mrpdemandtype, quantity, duedate)
+						VALUES ('" . DB_escape_string($Row['stockid']) . "', '" . FC_MRP_DEMAND_TYPE . "', '" . $Row['qty'] . "', '" . $DueDate . "')", '', '', true);
+			$DemandID = DB_Last_Insert_ID('mrpdemands', 'demandid');
+			DB_query("INSERT INTO fcmrpdemands (demandid, stockid, periodstart, forecastid)
+						VALUES ('" . $DemandID . "', '" . DB_escape_string($Row['stockid']) . "', '" . $Row['period'] . "', '" . $Row['forecastid'] . "')", '', '', true);
+			$Added++;
+		}
+		DB_Txn_Commit();
+
+		prnMsg(__('Forecast demands for') . ' ' . $FromMonth . ' - ' . $ToMonth . ': ' . $Deleted . ' ' . __('replaced demands removed') . ', ' . $Added . ' ' . __('demands written') . ', ' . $Skipped . ' ' . __('periods skipped because they were already converted'), 'success');
+		prnMsg(__('Run the MRP calculation with the option to use MRP demands to plan from these demands.'), 'info');
+	}
+}
+
+$Result = DB_query("SELECT COUNT(*), MIN(periodstart), MAX(periodstart) FROM fcmrpdemands");
+$MyRow = DB_fetch_row($Result);
+echo '<div class="page_help_text">' . __('Forecast demands currently in the master schedule') . ': ' . $MyRow[0] . ($MyRow[0] > 0 ? ' (' . fcMonthLabel($MyRow[1]) . ' - ' . fcMonthLabel($MyRow[2]) . ')' : '') . '</div>';
+
+echo '<form method="post" action="' . $FormAction . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Convert active forecasts') . '</legend>
+	<field>
+		<label for="ScopeAll">' . __('All items with an active forecast') . ':</label>
+		<input type="radio" name="Scope" id="ScopeAll" value="all"' . ($Scope == 'all' ? ' checked="checked"' : '') . ' />
+	</field>
+	<field>
+		<label for="ScopeCategory">' . __('Items of a stock category') . ':</label>
+		<input type="radio" name="Scope" id="ScopeCategory" value="category"' . ($Scope == 'category' ? ' checked="checked"' : '') . ' />
+		<select name="CategoryID">' . fcCategoryOptions($CategoryID) . '</select>
+	</field>
+	<field>
+		<label for="ScopeItem">' . __('One item') . ':</label>
+		<input type="radio" name="Scope" id="ScopeItem" value="item"' . ($Scope == 'item' ? ' checked="checked"' : '') . ' />
+		<input type="text" name="StockID" size="21" maxlength="64" value="' . htmlspecialchars($StockID, ENT_QUOTES, 'UTF-8') . '" />
+	</field>
+	<field>
+		<label for="FromMonth">' . __('Horizon from month') . ':</label>
+		<input type="month" name="FromMonth" id="FromMonth" required="required" value="' . $FromMonth . '" />
+	</field>
+	<field>
+		<label for="ToMonth">' . __('Horizon to month') . ':</label>
+		<input type="month" name="ToMonth" id="ToMonth" required="required" value="' . $ToMonth . '" />
+	</field>
+	<field>
+		<label for="Mode">' . __('Mode') . ':</label>
+		<select name="Mode" id="Mode">
+			<option value="replace"' . ($Mode == 'replace' ? ' selected="selected"' : '') . '>' . __('Replace the forecast demands of these items and months') . '</option>
+			<option value="incremental"' . ($Mode == 'incremental' ? ' selected="selected"' : '') . '>' . __('Incremental - add only months not yet converted') . '</option>
+		</select>
+	</field>
+	</fieldset>
+	<div class="page_help_text">' . __('Each month becomes one demand of the revised quantity if there is one, otherwise the calculated quantity, due on the first day of the month (today for the current month). Converting again never doubles the demand. Demands entered by hand or by other processes are not touched.') . '</div>
+	<div class="centre"><input type="submit" name="Convert" value="' . __('Convert to MRP Demands') . '" /></div>
+	</form>';
+
+include('includes/footer.php');

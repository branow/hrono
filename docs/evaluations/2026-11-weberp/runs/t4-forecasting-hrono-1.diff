+			$LabelCache[$MyRow['dimension']] = fcSummaryValues($MyRow['dimension']);
+		}
+		echo '<tr class="striped_row">
+				<td>' . ($Dimensions[$MyRow['dimension']] ?? $MyRow['dimension']) . '</td>
+				<td>' . htmlspecialchars($LabelCache[$MyRow['dimension']][$MyRow['dimensionvalue']] ?? $MyRow['dimensionvalue'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td>' . $MyRow['methodid'] . ' - ' . ($MethodNames[$MyRow['methodid']] ?? '') . '</td>
+				<td>' . $MyRow['createdon'] . '</td>
+				<td><a href="' . $FormAction . '?SummaryID=' . $MyRow['summaryid'] . '">' . __('Review') . '</a></td>
+			</tr>';
+	}
+	echo '</table><br />';
+}
+
+$SelectedDimension = $_POST['Dimension'] ?? 'category';
+echo '<form method="post" action="' . $FormAction . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />

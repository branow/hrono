+foreach ($Dimensions as $Key => $Name) {
+	echo '<option value="' . $Key . '"' . ($SelectedDimension == $Key ? ' selected="selected"' : '') . '>' . $Name . '</option>';
+}
+echo '</select>
+	</field>
+	<field>
+		<label for="DimensionValue">' . __('Value') . ':</label>
+		<select name="DimensionValue" id="DimensionValue">
+			<option value="*">' . __('Every value with sales') . '</option>';
+foreach (fcSummaryValues($SelectedDimension) as $Code => $Name) {
+	echo '<option value="' . htmlspecialchars($Code, ENT_QUOTES, 'UTF-8') . '"' . ((string) ($_POST['DimensionValue'] ?? '') === (string) $Code ? ' selected="selected"' : '') . '>' . htmlspecialchars($Name, ENT_QUOTES, 'UTF-8') . '</option>';
+}
+echo '</select>
+		<fieldhelp>' . __('Change the Summarise by choice and use Show values to list the values of that choice.') . '</fieldhelp>

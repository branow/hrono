+++ b/ForecastDashboard.php
@@ -0,0 +1,59 @@
+<?php
+
+// Forecasting dashboard: counts, the sales history held and links to every function.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecasting Dashboard');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastDashboard';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$Result = DB_query("SELECT COUNT(*) FROM fcforecasts WHERE active = 1");
+$MyRow = DB_fetch_row($Result);
+$ActiveForecasts = $MyRow[0];
+$Result = DB_query("SELECT COUNT(*) FROM fcsummaryforecasts WHERE active = 1");
+$MyRow = DB_fetch_row($Result);
+$ActiveSummaries = $MyRow[0];
+$Result = DB_query("SELECT COUNT(*) FROM fcmrpdemands");
+$MyRow = DB_fetch_row($Result);
+$ConvertedDemands = $MyRow[0];
+$History = fcHistoryRange();
+
+echo '<table class="selection">
+		<tr><th colspan="2">' . __('Forecasting at a glance') . '</th></tr>
+		<tr><td>' . __('Active item forecasts') . '</td><td class="number">' . locale_number_format($ActiveForecasts, 0) . '</td></tr>
+		<tr><td>' . __('Active summary forecasts') . '</td><td class="number">' . locale_number_format($ActiveSummaries, 0) . '</td></tr>
+		<tr><td>' . __('Forecast demands in the MRP master schedule') . '</td><td class="number">' . locale_number_format($ConvertedDemands, 0) . '</td></tr>
+		<tr><td>' . __('Sales history range') . '</td><td>' . ($History['from'] === null ? __('None extracted yet') : fcMonthLabel($History['from']) . ' - ' . fcMonthLabel($History['to'])) . '</td></tr>
+		<tr><td>' . __('Months / items in the sales history') . '</td><td class="number">' . locale_number_format($History['months'], 0) . ' / ' . locale_number_format($History['items'], 0) . '</td></tr>
+	</table><br />';
+
+$Links = array(
+	array('/ForecastSalesHistory.php', __('Extract Sales History')),
+	array('/ForecastGenerate.php', __('Generate Forecasts')),
+	array('/ForecastReview.php', __('Review and Revise Forecasts')),
+	array('/ForecastSummary.php', __('Summary Forecasts')),
+	array('/ForecastAccuracy.php', __('Forecast Accuracy')),
+	array('/ForecastMethodComparison.php', __('Forecast Method Comparison')),
+	array('/ForecastInquiry.php', __('Forecast Inquiry')),
+	array('/ForecastToMRP.php', __('Convert Forecasts to MRP Demands')),
+	array('/ForecastParameters.php', __('Forecast Parameters')),
+	array('/MRPDemands.php', __('Master Schedule')),
+	array('/MRP.php', __('MRP Calculation')),
+	array('/MRPReport.php', __('MRP'))
+);
+echo '<table class="selection"><tr><th>' . __('Forecasting functions') . '</th></tr>';
+foreach ($Links as $Link) {
+	$ScriptName = substr($Link[0], 1);
+	/* only offer the functions the user may use */
+	if (isset($_SESSION['PageSecurityArray'][$ScriptName]) and in_array($_SESSION['PageSecurityArray'][$ScriptName], $_SESSION['AllowedPageSecurityTokens'])) {
+		echo '<tr class="striped_row"><td><a href="' . $RootPath . $Link[0] . '">' . $Link[1] . '</a></td></tr>';
+	}
+}
+echo '</table>';
+
+include('includes/footer.php');
diff --git a/ForecastGenerate.php b/ForecastGenerate.php
new file mode 100644
index 0000000..57dd4a0
--- /dev/null
+++ b/ForecastGenerate.php
@@ -0,0 +1,284 @@
+<?php
+
+// Generates forecasts for one item, or for every active item of a stock category in batch steps.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Generate Forecasts');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastGenerate';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$FormAction = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$MethodNames = fcMethodNames();
+$Defaults = fcGetParameters();
+$Parameters = $Defaults;
+$ParameterKeys = array('alpha', 'beta', 'gamma', 'seasonlength', 'maperiods', 'holdoutmonths', 'growthpercent', 'flexibleweights', 'wmaweights');
+
+/** Shows a stored forecast period by period */
+function fcShowForecast($ForecastID) {
+	$Result = DB_query("SELECT periodstart, calculatedqty, revisedqty FROM fcforecastdetails
+						WHERE forecastid = '" . $ForecastID . "' ORDER BY periodstart");
+	echo '<table class="selection"><tr><th>' . __('Month') . '</th><th>' . __('Forecast quantity') . '</th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row"><td>' . fcMonthLabel($MyRow['periodstart']) . '</td><td class="number">' . fcMoney($MyRow['calculatedqty']) . '</td></tr>';
+	}
+	echo '</table>';
+}
+
+/* ------------------------------------------------------------------------------------------------------ */
+/* Batch step: the state of a category run is kept in the session                                         */
+/* ------------------------------------------------------------------------------------------------------ */
+
+if (isset($_POST['Cancel'])) {
+	unset($_SESSION['FcBatch']);
+	prnMsg(__('The batch run has been cancelled. Forecasts already generated stay in place.'), 'info');
+}
+
+$Start = isset($_POST['Start']);
+$InputError = 0;
+$Scope = $_POST['Scope'] ?? 'item';
+$Method = isset($_POST['Method']) ? (int) $_POST['Method'] : 0;
+$Horizon = isset($_POST['Horizon']) ? (int) $_POST['Horizon'] : (int) $Defaults['defaulthorizon'];
+$Location = $_POST['Location'] ?? FC_ALL_LOCATIONS;
+$StockID = isset($_POST['StockID']) ? trim(mb_strtoupper($_POST['StockID'])) : '';
+$CategoryID = $_POST['CategoryID'] ?? '';
+
+if ($Start) {
+	foreach ($ParameterKeys as $Key) {
+		if (isset($_POST[$Key])) {
+			$Parameters[$Key] = trim($_POST[$Key]);
+		}
+	}
+	foreach (fcValidateParameters($Parameters) as $Problem) {
+		prnMsg($Problem, 'error');
+		$InputError = 1;
+	}
+	if ($Horizon < 1 or $Horizon > 36) {
+		prnMsg(__('The horizon must be from 1 to 36 months'), 'error');
+		$InputError = 1;
+	}
+	if ($Method != 0 and !isset($MethodNames[$Method])) {
+		prnMsg(__('Unknown forecasting method'), 'error');
+		$InputError = 1;
+	}
+	if ($Location != FC_ALL_LOCATIONS) {
+		$Result = DB_query("SELECT loccode FROM locations WHERE loccode = '" . $Location . "'");
+		if (DB_num_rows($Result) == 0) {
+			prnMsg(__('The stock location does not exist'), 'error');
+			$InputError = 1;
+		}
+	}
+	$History = fcHistoryRange();
+	if ($History['from'] === null) {
+		prnMsg(__('There is no sales history to forecast from. Extract the sales history first.'), 'error');
+		$InputError = 1;
+	}
+	if ($Scope == 'item') {
+		$Result = DB_query("SELECT stockid FROM stockmaster WHERE stockid = '" . $StockID . "'");
+		if ($StockID == '' or DB_num_rows($Result) == 0) {
+			prnMsg(__('Enter the code of an existing item'), 'error');
+			$InputError = 1;
+		}
+	} else {
+		$Items = fcActiveItemsOfCategory($CategoryID);
+		if (count($Items) == 0) {
+			prnMsg(__('The category has no active items'), 'error');
+			$InputError = 1;
+		}
+	}
+
+	if ($InputError == 0 and $Scope == 'item') {
+		$Outcome = fcGenerateItemForecast($StockID, $Location, $Method, $Horizon, $Parameters);
+		if ($Outcome['ok']) {
+			prnMsg($StockID . ': ' . __('forecast generated with method') . ' ' . $Outcome['method'] . ' - ' . $MethodNames[$Outcome['method']] . ($Method == 0 ? ' (' . __('best fit') . ')' : ''), 'success');
+			if ($Method == 0) {
+				$Series = fcItemSeries($StockID, $Location);
+				$Holdout = fcHoldoutTest($Series['values'], (int) $Parameters['holdoutmonths'], fcMethodParameters($Parameters));
+				echo '<table class="selection"><tr><th>' . __('Method') . '</th><th>' . __('MAD on the hold-out months') . '</th><th>' . __('Result') . '</th></tr>';
+				foreach ($Holdout as $MethodID => $Test) {
+					echo '<tr class="striped_row' . ($MethodID == $Outcome['method'] ? ' highlight' : '') . '"><td>' . $MethodID . ' - ' . $MethodNames[$MethodID] . '</td>
+							<td class="number">' . ($Test['ok'] ? fcMoney($Test['metrics']['mad']) : '') . '</td>
+							<td>' . ($Test['ok'] ? ($MethodID == $Outcome['method'] ? __('Best fit') : '') : htmlspecialchars($Test['error'], ENT_QUOTES, 'UTF-8')) . '</td></tr>';
+				}
+				echo '</table><br />';
+			}
+			fcShowForecast($Outcome['forecastid']);
+			echo '<br /><div class="centre"><a href="' . $RootPath . '/ForecastReview.php?ForecastID=' . $Outcome['forecastid'] . '">' . __('Review and revise this forecast') . '</a></div><br />';
+		} else {
+			prnMsg($StockID . ': ' . __('no forecast was generated') . ' - ' . htmlspecialchars($Outcome['error'], ENT_QUOTES, 'UTF-8'), 'warn');
+		}
+	} elseif ($InputError == 0) {
+		$_SESSION['FcBatch'] = array(
+			'items' => $Items,
+			'position' => 0,
+			'phase' => $Method == 0 ? 'evaluate' : 'generate',
+			'method' => $Method,
+			'bestfit' => $Method == 0,
+			'location' => $Location,
+			'horizon' => $Horizon,
+			'parameters' => $Parameters,
+			'tallies' => array(),
+			'succeeded' => array(),
+			'failed' => array(),
+			'category' => $CategoryID
+		);
+		$_POST['Continue'] = 1;
+	}
+}
+
+if (isset($_POST['Continue']) and isset($_SESSION['FcBatch'])) {
+	$Batch = &$_SESSION['FcBatch'];
+	$Total = count($Batch['items']);
+	$Limit = min($Total, $Batch['position'] + max(1, (int) $Batch['parameters']['batchsize']));
+	$P = fcMethodParameters($Batch['parameters']);
+
+	if ($Batch['phase'] == 'evaluate') {
+		for (; $Batch['position'] < $Limit; $Batch['position']++) {
+			$Item = DB_escape_string($Batch['items'][$Batch['position']]);
+			$Series = fcItemSeries($Item, $Batch['location']);
+			if (count($Series['values']) > 0) {
+				fcAddToTallies($Batch['tallies'], fcHoldoutTest($Series['values'], (int) $Batch['parameters']['holdoutmonths'], $P), (int) $Batch['parameters']['holdoutmonths']);
+			}
+		}
+		if ($Batch['position'] >= $Total) {
+			/* the category's method: the best across its items */
+			$Recommended = fcBestMethodForTallies($Batch['tallies']);
+			if ($Recommended === null) {
+				foreach ($Batch['items'] as $Item) {
+					$Batch['failed'][] = array($Item, __('Too little history for any method to be tested'));
+				}
+				$Batch['phase'] = 'done';
+			} else {
+				$Batch['method'] = $Recommended;
+				$Batch['phase'] = 'generate';
+				$Batch['position'] = 0;
+				prnMsg(__('Best fit for the category') . ': ' . $Recommended . ' - ' . $MethodNames[$Recommended], 'info');
+			}
+		}
+	} elseif ($Batch['phase'] == 'generate') {
+		for (; $Batch['position'] < $Limit; $Batch['position']++) {
+			$Item = $Batch['items'][$Batch['position']];
+			$Outcome = fcGenerateItemForecast(DB_escape_string($Item), $Batch['location'], $Batch['method'], $Batch['horizon'], $Batch['parameters']);
+			if ($Outcome['ok']) {
+				$Batch['succeeded'][] = array($Item, $Outcome['method']);
+			} else {
+				$Batch['failed'][] = array($Item, $Outcome['error']);
+			}
+		}
+		if ($Batch['position'] >= $Total) {
+			$Batch['phase'] = 'done';
+		}
+	}
+
+	if ($Batch['phase'] != 'done') {
+		$Done = $Batch['phase'] == 'evaluate' ? $Batch['position'] : $Batch['position'];
+		echo '<div class="centre">
+				<p>' . ($Batch['phase'] == 'evaluate' ? __('Testing the methods on the items') : __('Generating forecasts')) . ': ' . $Done . ' / ' . $Total . '</p>
+				<progress value="' . $Done . '" max="' . $Total . '"></progress>
+				<form id="BatchForm" method="post" action="' . $FormAction . '">
+					<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+					<input type="hidden" name="Continue" value="1" />
+					<input type="submit" value="' . __('Continue') . '" />
+					<input type="submit" name="Cancel" value="' . __('Cancel') . '" />
+				</form>
+			</div>
+			<script>document.getElementById("BatchForm").submit();</script>';
+	} else {
+		prnMsg(count($Batch['succeeded']) . ' ' . __('successful') . ', ' . count($Batch['failed']) . ' ' . __('failed'), count($Batch['failed']) == 0 ? 'success' : 'warn');
+		if (count($Batch['failed']) > 0) {
+			echo '<table class="selection"><tr><th colspan="2">' . __('Items without a forecast') . '</th></tr>
+					<tr><th>' . __('Item') . '</th><th>' . __('Reason') . '</th></tr>';
+			foreach ($Batch['failed'] as $Failure) {
+				echo '<tr class="striped_row"><td>' . htmlspecialchars($Failure[0], ENT_QUOTES, 'UTF-8') . '</td><td>' . htmlspecialchars($Failure[1], ENT_QUOTES, 'UTF-8') . '</td></tr>';
+			}
+			echo '</table><br />';
+		}
+		if (count($Batch['succeeded']) > 0) {
+			echo '<table class="selection"><tr><th colspan="2">' . __('Forecasts generated') . '</th></tr>
+					<tr><th>' . __('Item') . '</th><th>' . __('Method') . '</th></tr>';
+			foreach ($Batch['succeeded'] as $Success) {
+				echo '<tr class="striped_row"><td><a href="' . $RootPath . '/ForecastReview.php?StockID=' . urlencode($Success[0]) . '">' . htmlspecialchars($Success[0], ENT_QUOTES, 'UTF-8') . '</a></td><td>' . $Success[1] . ' - ' . $MethodNames[$Success[1]] . '</td></tr>';
+			}
+			echo '</table><br />';
+		}
+		unset($Batch);
+		unset($_SESSION['FcBatch']);
+	}
+}
+
+/* ------------------------------------------------------------------------------------------------------ */
+/* Input form (not shown while a batch is running)                                                        */
+/* ------------------------------------------------------------------------------------------------------ */
+
+if (!(isset($_POST['Continue']) and isset($_SESSION['FcBatch']))) {
+	$History = fcHistoryRange();
+	if ($History['from'] === null) {
+		prnMsg(__('There is no sales history yet.') . ' <a href="' . $RootPath . '/ForecastSalesHistory.php">' . __('Extract the sales history') . '</a>', 'warn');
+	} else {
+		echo '<div class="page_help_text">' . __('Sales history held') . ': ' . fcMonthLabel($History['from']) . ' - ' . fcMonthLabel($History['to']) . '</div>';
+	}
+
+	echo '<form method="post" action="' . $FormAction . '">';
+	echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+	echo '<fieldset><legend>' . __('Scope') . '</legend>
+		<field>
+			<label for="ScopeItem">' . __('Single item') . ':</label>
+			<input type="radio" name="Scope" id="ScopeItem" value="item"' . ($Scope == 'item' ? ' checked="checked"' : '') . ' />
+			<input type="text" name="StockID" size="21" maxlength="64" value="' . htmlspecialchars($StockID, ENT_QUOTES, 'UTF-8') . '" placeholder="' . __('Item code') . '" />
+		</field>
+		<field>
+			<label for="ScopeCategory">' . __('All active items of a stock category') . ':</label>
+			<input type="radio" name="Scope" id="ScopeCategory" value="category"' . ($Scope == 'category' ? ' checked="checked"' : '') . ' />
+			<select name="CategoryID">' . fcCategoryOptions($CategoryID) . '</select>
+		</field>
+		<field>
+			<label for="Location">' . __('Stock location') . ':</label>
+			<select name="Location" id="Location">' . fcLocationOptions($Location) . '</select>
+		</field>
+		<field>
+			<label for="Horizon">' . __('Horizon (future months)') . ':</label>
+			<input type="number" name="Horizon" id="Horizon" min="1" max="36" value="' . $Horizon . '" />
+		</field>
+		<field>
+			<label for="Method">' . __('Method') . ':</label>
+			<select name="Method" id="Method">' . fcMethodOptions($Method) . '</select>
+		</field>
+	</fieldset>';
+
+	$Parameters = $Defaults;
+	foreach ($ParameterKeys as $Key) {
+		if (isset($_POST[$Key])) {
+			$Parameters[$Key] = $_POST[$Key];
+		}
+	}
+	$Labels = array(
+		'growthpercent' => __('Percent over last year'),
+		'maperiods' => __('Moving average periods'),
+		'flexibleweights' => __('Flexible method weights, most recent month first'),
+		'wmaweights' => __('Weighted moving average weights, most recent month first'),
+		'alpha' => __('Alpha'),
+		'beta' => __('Beta'),
+		'gamma' => __('Gamma'),
+		'seasonlength' => __('Season length'),
+		'holdoutmonths' => __('Hold-out months for best fit')
+	);
+	echo '<fieldset><legend>' . __('Parameters (company defaults - change to override for this run)') . '</legend>';
+	foreach ($Labels as $Key => $Label) {
+		echo '<field>
+				<label for="' . $Key . '">' . $Label . ':</label>
+				<input type="text" name="' . $Key . '" id="' . $Key . '" size="30" value="' . htmlspecialchars($Parameters[$Key], ENT_QUOTES, 'UTF-8') . '" />
+			</field>';
+	}
+	echo '</fieldset>
+		<div class="page_help_text">' . __('Best fit hides the most recent months, forecasts them with every method the history allows and uses the method with the lowest mean absolute deviation. For a category the method that does best across its items is used. Items with less history than the method needs are reported and get no forecast. Generating again replaces the active forecast of the item and location.') . '</div>
+		<div class="centre">
+			<input type="submit" name="Start" value="' . __('Generate Forecasts') . '" />
+		</div>
+		</form>';
+}
+
+include('includes/footer.php');
diff --git a/ForecastInquiry.php b/ForecastInquiry.php
new file mode 100644
index 0000000..95c97f2
--- /dev/null
+++ b/ForecastInquiry.php
@@ -0,0 +1,119 @@
+<?php
+
+// Inquiry on forecasts by item, category, location and period.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Inquiry');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastInquiry';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$FormAction = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$MethodNames = fcMethodNames();
+
+$StockCode = trim($_POST['StockCode'] ?? '');
+$CategoryID = $_POST['CategoryID'] ?? '';
+$Location = $_POST['Location'] ?? FC_ALL_LOCATIONS;
+$AnyLocation = (isset($_POST['AnyLocation']) || !isset($_POST['Show']));
+$FromMonth = $_POST['FromMonth'] ?? '';
+$ToMonth = $_POST['ToMonth'] ?? '';
+$IncludeSuperseded = isset($_POST['IncludeSuperseded']);
+
+echo '<form method="post" action="' . $FormAction . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Select forecasts') . '</legend>
+	<field>
+		<label for="StockCode">' . __('Part of the item code or description') . ':</label>
+		<input type="text" name="StockCode" id="StockCode" size="20" maxlength="64" value="' . htmlspecialchars($StockCode, ENT_QUOTES, 'UTF-8') . '" />
+	</field>
+	<field>
+		<label for="CategoryID">' . __('Stock category') . ':</label>
+		<select name="CategoryID" id="CategoryID">' . fcCategoryOptions($CategoryID, true) . '</select>
+	</field>
+	<field>
+		<label for="Location">' . __('Stock location') . ':</label>
+		<select name="Location" id="Location">' . fcLocationOptions($Location) . '</select>
+	</field>
+	<field>
+		<label for="AnyLocation">' . __('Forecasts of any location') . ':</label>
+		<input type="checkbox" name="AnyLocation" id="AnyLocation" value="1"' . ($AnyLocation ? ' checked="checked"' : '') . ' />
+	</field>
+	<field>
+		<label for="FromMonth">' . __('From month') . ':</label>
+		<input type="month" name="FromMonth" id="FromMonth" value="' . htmlspecialchars($FromMonth, ENT_QUOTES, 'UTF-8') . '" />
+	</field>
+	<field>
+		<label for="ToMonth">' . __('To month') . ':</label>
+		<input type="month" name="ToMonth" id="ToMonth" value="' . htmlspecialchars($ToMonth, ENT_QUOTES, 'UTF-8') . '" />
+	</field>
+	<field>
+		<label for="IncludeSuperseded">' . __('Include superseded forecasts') . ':</label>
+		<input type="checkbox" name="IncludeSuperseded" id="IncludeSuperseded" value="1"' . ($IncludeSuperseded ? ' checked="checked"' : '') . ' />
+	</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Show" value="' . __('Show forecasts') . '" /></div>
+	</form>';
+
+if (isset($_POST['Show'])) {
+	$SQL = "SELECT fcforecasts.forecastid,
+					fcforecasts.stockid,
+					stockmaster.description,
+					fcforecasts.loccode,
+					fcforecasts.methodid,
+					fcforecasts.active,
+					fcforecastdetails.periodstart,
+					fcforecastdetails.calculatedqty,
+					fcforecastdetails.revisedqty
+				FROM fcforecasts
+				INNER JOIN fcforecastdetails ON fcforecastdetails.forecastid = fcforecasts.forecastid
+				INNER JOIN stockmaster ON stockmaster.stockid = fcforecasts.stockid
+				WHERE 1 = 1";
+	if (!$IncludeSuperseded) {
+		$SQL .= " AND fcforecasts.active = 1";
+	}
+	if ($StockCode != '') {
+		$SQL .= " AND (fcforecasts.stockid " . LIKE . " '%" . $StockCode . "%' OR stockmaster.description " . LIKE . " '%" . $StockCode . "%')";
+	}
+	if ($CategoryID != '') {
+		$SQL .= " AND stockmaster.categoryid = '" . $CategoryID . "'";
+	}
+	if (!$AnyLocation) {
+		$SQL .= " AND fcforecasts.loccode = '" . $Location . "'";
+	}
+	if (fcIsMonth($FromMonth)) {
+		$SQL .= " AND fcforecastdetails.periodstart >= '" . $FromMonth . "-01'";
+	}
+	if (fcIsMonth($ToMonth)) {
+		$SQL .= " AND fcforecastdetails.periodstart <= '" . $ToMonth . "-01'";
+	}
+	$SQL .= " ORDER BY fcforecasts.stockid, fcforecasts.loccode, fcforecasts.forecastid, fcforecastdetails.periodstart LIMIT 2000";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('No forecasts match the selection'), 'info');
+	} else {
+		echo '<br /><table class="selection">
+				<tr><th>' . __('Item') . '</th><th>' . __('Description') . '</th><th>' . __('Location') . '</th><th>' . __('Method') . '</th><th>' . __('Month') . '</th>
+				<th>' . __('Calculated quantity') . '</th><th>' . __('Revised quantity') . '</th><th>' . __('Quantity used') . '</th><th>' . __('Status') . '</th></tr>';
+		while ($MyRow = DB_fetch_array($Result)) {
+			$Used = $MyRow['revisedqty'] !== null ? $MyRow['revisedqty'] : $MyRow['calculatedqty'];
+			echo '<tr class="striped_row">
+					<td><a href="' . $RootPath . '/ForecastReview.php?ForecastID=' . $MyRow['forecastid'] . '">' . htmlspecialchars($MyRow['stockid'], ENT_QUOTES, 'UTF-8') . '</a></td>
+					<td>' . htmlspecialchars($MyRow['description'], ENT_QUOTES, 'UTF-8') . '</td>
+					<td>' . ($MyRow['loccode'] == FC_ALL_LOCATIONS ? __('All') : $MyRow['loccode']) . '</td>
+					<td>' . $MyRow['methodid'] . ' - ' . ($MethodNames[$MyRow['methodid']] ?? '') . '</td>
+					<td>' . fcMonthLabel($MyRow['periodstart']) . '</td>
+					<td class="number">' . fcMoney($MyRow['calculatedqty']) . '</td>
+					<td class="number">' . ($MyRow['revisedqty'] !== null ? fcMoney($MyRow['revisedqty']) : '') . '</td>
+					<td class="number">' . fcMoney($Used) . '</td>
+					<td>' . ($MyRow['active'] ? __('Active') : __('Superseded')) . '</td>
+				</tr>';
+		}
+		echo '</table>';
+	}
+}
+
+include('includes/footer.php');
diff --git a/ForecastMethodComparison.php b/ForecastMethodComparison.php
new file mode 100644
index 0000000..90e315e
--- /dev/null
+++ b/ForecastMethodComparison.php
@@ -0,0 +1,98 @@
+<?php
+
+// Forecasts the history of one item with every method side by side: the most recent months are held out, each method
+// forecasts them from the earlier months and is rated against what was actually sold.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Method Comparison');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastMethodComparison';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$FormAction = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$MethodNames = fcMethodNames();
+$Parameters = fcGetParameters();
+
+$StockID = trim(mb_strtoupper($_POST['StockID'] ?? $_GET['StockID'] ?? ''));
+$Location = $_POST['Location'] ?? $_GET['Location'] ?? FC_ALL_LOCATIONS;
+$Holdout = (int) ($_POST['Holdout'] ?? $_GET['Holdout'] ?? $Parameters['holdoutmonths']);
+
+echo '<form method="post" action="' . $FormAction . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Compare methods on one item') . '</legend>
+	<field>
+		<label for="StockID">' . __('Item code') . ':</label>
+		<input type="text" name="StockID" id="StockID" size="21" maxlength="64" required="required" value="' . htmlspecialchars($StockID, ENT_QUOTES, 'UTF-8') . '" />
+	</field>
+	<field>
+		<label for="Location">' . __('Stock location') . ':</label>
+		<select name="Location" id="Location">' . fcLocationOptions($Location) . '</select>
+	</field>
+	<field>
+		<label for="Holdout">' . __('Months held out and forecast') . ':</label>
+		<input type="number" name="Holdout" id="Holdout" min="1" max="12" value="' . $Holdout . '" />
+	</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Compare" value="' . __('Compare methods') . '" /></div>
+	</form>';
+
+if (isset($_POST['Compare']) or (isset($_GET['StockID']) and $StockID != '')) {
+	$Result = DB_query("SELECT description FROM stockmaster WHERE stockid = '" . $StockID . "'");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('The item does not exist'), 'error');
+	} elseif ($Holdout < 1 or $Holdout > 12) {
+		prnMsg(__('The months held out must be from 1 to 12'), 'error');
+	} else {
+		$Series = fcItemSeries($StockID, $Location);
+		$Y = $Series['values'];
+		if (count($Y) <= $Holdout) {
+			prnMsg(__('Not enough sales history for this item to hold out the months and forecast them'), 'warn');
+		} else {
+			$Tests = fcHoldoutTest($Y, $Holdout, fcMethodParameters($Parameters));
+			$Best = fcBestMethod($Tests);
+			$Actual = array_slice($Y, count($Y) - $Holdout);
+			$FirstMonth = fcMonthAdd($Series['last'], -($Holdout - 1));
+
+			echo '<br /><table class="selection">
+					<tr><th colspan="7">' . htmlspecialchars($StockID, ENT_QUOTES, 'UTF-8') . ': ' . count($Y) . ' ' . __('months of history, last') . ' ' . $Holdout . ' ' . __('months held out') . '</th></tr>
+					<tr><th>' . __('Method') . '</th><th>' . __('Result') . '</th><th>MAD</th><th>POA %</th><th>MSE</th><th>RMSE</th></tr>';
+			foreach ($Tests as $Method => $Test) {
+				echo '<tr class="striped_row"' . ($Method === $Best ? ' style="font-weight: bold; background-color: #d9ffd9;"' : '') . '>
+						<td>' . $Method . ' - ' . $MethodNames[$Method] . '</td>';
+				if ($Test['ok']) {
+					$Metrics = $Test['metrics'];
+					echo '<td>' . ($Method === $Best ? __('Best fit') : '') . '</td>
+						<td class="number">' . fcMoney($Metrics['mad']) . '</td>
+						<td class="number">' . ($Metrics['poa'] === null ? __('n/a') : locale_number_format($Metrics['poa'], 1)) . '</td>
+						<td class="number">' . fcMoney($Metrics['mse']) . '</td>
+						<td class="number">' . fcMoney($Metrics['rmse']) . '</td>';
+				} else {
+					echo '<td colspan="5">' . __('Not applicable') . ': ' . htmlspecialchars($Test['error'], ENT_QUOTES, 'UTF-8') . '</td>';
+				}
+				echo '</tr>';
+			}
+			echo '</table><br />';
+
+			echo '<table class="selection"><tr><th colspan="' . (2 + count($MethodNames)) . '">' . __('Hold-out months: actual sales and the forecast of each method') . '</th></tr>
+					<tr><th>' . __('Month') . '</th><th>' . __('Actual') . '</th>';
+			foreach ($MethodNames as $Method => $Name) {
+				echo '<th title="' . htmlspecialchars($Name, ENT_QUOTES, 'UTF-8') . '">' . $Method . '</th>';
+			}
+			echo '</tr>';
+			for ($i = 0; $i < $Holdout; $i++) {
+				echo '<tr class="striped_row"><td>' . fcMonthLabel(fcMonthAdd($FirstMonth, $i)) . '</td><td class="number">' . fcMoney($Actual[$i]) . '</td>';
+				foreach ($Tests as $Test) {
+					echo '<td class="number">' . ($Test['ok'] ? fcMoney($Test['forecast'][$i]) : '') . '</td>';
+				}
+				echo '</tr>';
+			}
+			echo '</table>';
+		}
+	}
+}
+
+include('includes/footer.php');
diff --git a/ForecastParameters.php b/ForecastParameters.php
new file mode 100644
index 0000000..9a89494
--- /dev/null
+++ b/ForecastParameters.php
@@ -0,0 +1,76 @@
+<?php
+
+// Company wide defaults of the forecasting methods, used whenever the user does not override them.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Parameters');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastParameters';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$Defaults = fcDefaultParameters();
+$Parameters = fcGetParameters();
+
+$Fields = array(
+	'alpha' => array(__('Alpha (level smoothing constant, 0.1 to 0.9)'), 6),
+	'beta' => array(__('Beta (trend smoothing constant, 0.1 to 0.9)'), 6),
+	'gamma' => array(__('Gamma (seasonal smoothing constant, 0.1 to 0.9)'), 6),
+	'seasonlength' => array(__('Season length in months'), 4),
+	'maperiods' => array(__('Moving average periods'), 4),
+	'holdoutmonths' => array(__('Hold-out months for best fit'), 4),
+	'defaulthorizon' => array(__('Default horizon in months'), 4),
+	'growthpercent' => array(__('Percent over last year'), 8),
+	'flexibleweights' => array(__('Flexible method weights, most recent month first'), 50),
+	'wmaweights' => array(__('Weighted moving average weights, most recent month first'), 30),
+	'poathreshold' => array(__('Accuracy tolerance: flag items whose POA is more than this many points from 100'), 4),
+	'variancethreshold' => array(__('Highlight variances to last year above this percent'), 4),
+	'batchsize' => array(__('Items processed per step of a batch run'), 4)
+);
+
+if (isset($_POST['submit'])) {
+	$New = array();
+	foreach ($Fields as $Name => $Field) {
+		$New[$Name] = isset($_POST[$Name]) ? trim($_POST[$Name]) : $Parameters[$Name];
+	}
+	$Problems = fcValidateParameters($New);
+	if (count($Problems) > 0) {
+		foreach ($Problems as $Problem) {
+			prnMsg($Problem, 'error');
+		}
+		$Parameters = $New;
+	} else {
+		foreach ($New as $Name => $Value) {
+			DB_query("REPLACE INTO fcparameters (parametername, parametervalue) VALUES ('" . $Name . "', '" . $Value . "')");
+		}
+		$Parameters = $New;
+		prnMsg(__('The forecast parameters have been updated'), 'success');
+	}
+} elseif (isset($_POST['Reset'])) {
+	foreach ($Defaults as $Name => $Value) {
+		DB_query("REPLACE INTO fcparameters (parametername, parametervalue) VALUES ('" . $Name . "', '" . $Value . "')");
+	}
+	$Parameters = $Defaults;
+	prnMsg(__('The forecast parameters have been set back to the standard values'), 'success');
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset><legend>' . __('Forecast defaults') . '</legend>';
+foreach ($Fields as $Name => $Field) {
+	echo '<field>
+			<label for="' . $Name . '">' . $Field[0] . ':</label>
+			<input type="text" name="' . $Name . '" id="' . $Name . '" size="' . $Field[1] . '" maxlength="100" value="' . htmlspecialchars($Parameters[$Name], ENT_QUOTES, 'UTF-8') . '" />
+		</field>';
+}
+echo '</fieldset>
+	<div class="centre">
+		<input type="submit" name="submit" value="' . __('Update') . '" />
+		<input type="submit" name="Reset" value="' . __('Reset to standard values') . '" />
+	</div>
+	</form>';
+
+include('includes/footer.php');
diff --git a/ForecastReview.php b/ForecastReview.php
new file mode 100644
index 0000000..494b1e0
--- /dev/null
+++ b/ForecastReview.php
@@ -0,0 +1,215 @@
+<?php
+
+// Search forecasts and review them period by period: calculated quantity, revised quantity (which takes priority
+// everywhere), last year's actual for the same month and the variance.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Review and Revise Forecasts');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastReview';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$FormAction = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$MethodNames = fcMethodNames();
+$Parameters = fcGetParameters();
+
+$ForecastID = (int) ($_POST['ForecastID'] ?? $_GET['ForecastID'] ?? 0);
+
+/* a link from the batch result list or the inquiry names an item: go to its active forecast */
+if ($ForecastID == 0 and isset($_GET['StockID'])) {
+	$Result = DB_query("SELECT forecastid FROM fcforecasts WHERE stockid = '" . $_GET['StockID'] . "' AND active = 1 ORDER BY loccode LIMIT 1");
+	if ($MyRow = DB_fetch_row($Result)) {
+		$ForecastID = (int) $MyRow[0];
+	}
+}
+
+if ($ForecastID > 0) {
+	$Result = DB_query("SELECT fcforecasts.*, stockmaster.description
+						FROM fcforecasts
+						LEFT JOIN stockmaster ON stockmaster.stockid = fcforecasts.stockid
+						WHERE forecastid = '" . $ForecastID . "'");
+	$Forecast = DB_fetch_array($Result);
+	if (!$Forecast) {
+		prnMsg(__('The forecast does not exist'), 'error');
+		$ForecastID = 0;
+	}
+}
+
+if ($ForecastID > 0) {
+	$Stock = DB_escape_string($Forecast['stockid']);
+
+	if (isset($_POST['Save'])) {
+		if ($Forecast['active'] != 1) {
+			prnMsg(__('Only the active forecast can be revised'), 'error');
+		} else {
+			$InputError = 0;
+			$Revisions = array();
+			foreach (($_POST['Revised'] ?? array()) as $Period => $Value) {
+				$Value = trim($Value);
+				if ($Value === '') {
+					$Revisions[$Period] = 'NULL';
+				} elseif (!is_numeric($Value) or $Value < 0) {
+					prnMsg(fcMonthLabel($Period) . ': ' . __('the revised quantity must be a number that is not negative'), 'error');
+					$InputError = 1;
+				} else {
+					$Revisions[$Period] = "'" . (float) $Value . "'";
+				}
+			}
+			if ($InputError == 0) {
+				foreach ($Revisions as $Period => $Value) {
+					if (preg_match('/^\d{4}-\d{2}-01$/', $Period)) {
+						DB_query("UPDATE fcforecastdetails SET revisedqty = " . $Value . "
+									WHERE forecastid = '" . $ForecastID . "'
+									AND periodstart = '" . $Period . "'");
+					}
+				}
+				prnMsg(__('The revised quantities have been saved. A blank revised quantity means the calculated quantity applies.'), 'success');
+			}
+		}
+	}
+
+	echo '<table class="selection">
+			<tr><th colspan="2">' . htmlspecialchars($Forecast['stockid'], ENT_QUOTES, 'UTF-8') . ' - ' . htmlspecialchars($Forecast['description'] ?? '', ENT_QUOTES, 'UTF-8') . '</th></tr>
+			<tr><td>' . __('Stock location') . '</td><td>' . ($Forecast['loccode'] == FC_ALL_LOCATIONS ? __('All locations combined') : $Forecast['loccode']) . '</td></tr>
+			<tr><td>' . __('Method') . '</td><td>' . $Forecast['methodid'] . ' - ' . ($MethodNames[$Forecast['methodid']] ?? '') . ($Forecast['bestfit'] ? ' (' . __('best fit') . ')' : '') . '</td></tr>
+			<tr><td>' . __('Parameters') . '</td><td>' . htmlspecialchars($Forecast['parameters'], ENT_QUOTES, 'UTF-8') . '</td></tr>
+			<tr><td>' . __('Months of history used') . '</td><td>' . $Forecast['historymonths'] . '</td></tr>
+			<tr><td>' . __('Generated') . '</td><td>' . $Forecast['createdon'] . ' ' . htmlspecialchars($Forecast['createdby'], ENT_QUOTES, 'UTF-8') . '</td></tr>
+			<tr><td>' . __('Status') . '</td><td>' . ($Forecast['active'] ? __('Active - used by MRP') : __('Superseded')) . '</td></tr>
+		</table><br />';
+
+	$Result = DB_query("SELECT periodstart, calculatedqty, revisedqty FROM fcforecastdetails
+						WHERE forecastid = '" . $ForecastID . "' ORDER BY periodstart");
+	$Details = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Details[] = $MyRow;
+	}
+	$History = fcHistoryRange();
+	$LastYear = array();
+	if (count($Details) > 0 and $History['from'] !== null) {
+		$LastYear = fcActuals($Stock, $Forecast['loccode'], fcMonthAdd($Details[0]['periodstart'], -12), fcMonthAdd($Details[count($Details) - 1]['periodstart'], -12));
+	}
+
+	echo '<form method="post" action="' . $FormAction . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="ForecastID" value="' . $ForecastID . '" />
+		<table class="selection">
+		<tr>
+			<th>' . __('Month') . '</th>
+			<th>' . __('Calculated quantity') . '</th>
+			<th>' . __('Revised quantity') . '</th>
+			<th>' . __('Quantity used') . '</th>
+			<th>' . __('Last year actual') . '</th>
+			<th>' . __('Variance %') . '</th>
+		</tr>';
+	foreach ($Details as $Detail) {
+		$Used = $Detail['revisedqty'] !== null ? (float) $Detail['revisedqty'] : (float) $Detail['calculatedqty'];
+		$PreviousMonth = fcMonthAdd($Detail['periodstart'], -12);
+		$HasLastYear = ($History['from'] !== null && $PreviousMonth >= $History['from'] && $PreviousMonth <= $History['to']);
+		$Previous = $HasLastYear ? ($LastYear[$PreviousMonth] ?? 0) : null;
+		$VarianceText = '';
+		$Highlight = '';
+		if ($Previous !== null) {
+			if ($Previous > 0) {
+				$Variance = 100 * ($Used - $Previous) / $Previous;
+				$VarianceText = locale_number_format($Variance, 1);
+				if (abs($Variance) > (float) $Parameters['variancethreshold']) {
+					$Highlight = ' style="background-color: #ffd9d9; font-weight: bold;"';
+				}
+			} elseif ($Used > 0) {
+				$VarianceText = __('new');
+				$Highlight = ' style="background-color: #ffd9d9; font-weight: bold;"';
+			}
+		}
+		echo '<tr class="striped_row">
+				<td>' . fcMonthLabel($Detail['periodstart']) . '</td>
+				<td class="number">' . fcMoney($Detail['calculatedqty']) . '</td>
+				<td>' . ($Forecast['active'] ? '<input type="text" class="number" size="10" name="Revised[' . $Detail['periodstart'] . ']" value="' . ($Detail['revisedqty'] !== null ? (float) $Detail['revisedqty'] : '') . '" />' : ($Detail['revisedqty'] !== null ? fcMoney($Detail['revisedqty']) : '')) . '</td>
+				<td class="number">' . fcMoney($Used) . '</td>
+				<td class="number">' . ($Previous !== null ? fcMoney($Previous) : '') . '</td>
+				<td class="number"' . $Highlight . '>' . $VarianceText . '</td>
+			</tr>';
+	}
+	echo '</table>';
+	if ($Forecast['active']) {
+		echo '<div class="page_help_text">' . __('A revised quantity takes priority over the calculated quantity in every report, in the accuracy statistics and in the MRP demands. Clear a revised quantity to restore the calculated quantity. Variances above') . ' ' . $Parameters['variancethreshold'] . '% ' . __('are highlighted.') . '</div>
+			<div class="centre"><input type="submit" name="Save" value="' . __('Save revised quantities') . '" /></div>';
+	}
+	echo '</form>
+		<br /><div class="centre"><a href="' . $FormAction . '">' . __('Search forecasts') . '</a></div>';
+} else {
+	/* search */
+	$SearchStock = trim($_POST['StockCode'] ?? '');
+	$SearchCategory = $_POST['CategoryID'] ?? '';
+	$SearchLocation = $_POST['Location'] ?? FC_ALL_LOCATIONS;
+	$AnyLocation = (isset($_POST['AnyLocation']) || !isset($_POST['Search']));
+
+	echo '<form method="post" action="' . $FormAction . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset><legend>' . __('Search forecasts') . '</legend>
+		<field>
+			<label for="StockCode">' . __('Part of the item code or description') . ':</label>
+			<input type="text" name="StockCode" id="StockCode" size="20" maxlength="64" value="' . htmlspecialchars($SearchStock, ENT_QUOTES, 'UTF-8') . '" />
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category') . ':</label>
+			<select name="CategoryID" id="CategoryID">' . fcCategoryOptions($SearchCategory, true) . '</select>
+		</field>
+		<field>
+			<label for="Location">' . __('Stock location') . ':</label>
+			<select name="Location" id="Location">' . fcLocationOptions($SearchLocation) . '</select>
+		</field>
+		<field>
+			<label for="AnyLocation">' . __('Forecasts of any location') . ':</label>
+			<input type="checkbox" name="AnyLocation" id="AnyLocation" value="1"' . ($AnyLocation ? ' checked="checked"' : '') . ' />
+		</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Search" value="' . __('Search') . '" /></div>
+		</form>';
+
+	if (isset($_POST['Search'])) {
+		$SQL = "SELECT fcforecasts.forecastid,
+						fcforecasts.stockid,
+						stockmaster.description,
+						fcforecasts.loccode,
+						fcforecasts.methodid,
+						fcforecasts.createdon
+					FROM fcforecasts
+					INNER JOIN stockmaster ON stockmaster.stockid = fcforecasts.stockid
+					WHERE fcforecasts.active = 1";
+		if ($SearchStock != '') {
+			$SQL .= " AND (fcforecasts.stockid " . LIKE . " '%" . $SearchStock . "%' OR stockmaster.description " . LIKE . " '%" . $SearchStock . "%')";
+		}
+		if ($SearchCategory != '') {
+			$SQL .= " AND stockmaster.categoryid = '" . $SearchCategory . "'";
+		}
+		if (!$AnyLocation) {
+			$SQL .= " AND fcforecasts.loccode = '" . $SearchLocation . "'";
+		}
+		$SQL .= " ORDER BY fcforecasts.stockid, fcforecasts.loccode LIMIT 500";
+		$Result = DB_query($SQL);
+		if (DB_num_rows($Result) == 0) {
+			prnMsg(__('No active forecasts match the search'), 'info');
+		} else {
+			echo '<br /><table class="selection">
+					<tr><th>' . __('Item') . '</th><th>' . __('Description') . '</th><th>' . __('Location') . '</th><th>' . __('Method') . '</th><th>' . __('Generated') . '</th><th></th></tr>';
+			while ($MyRow = DB_fetch_array($Result)) {
+				echo '<tr class="striped_row">
+						<td>' . htmlspecialchars($MyRow['stockid'], ENT_QUOTES, 'UTF-8') . '</td>
+						<td>' . htmlspecialchars($MyRow['description'], ENT_QUOTES, 'UTF-8') . '</td>
+						<td>' . ($MyRow['loccode'] == FC_ALL_LOCATIONS ? __('All') : $MyRow['loccode']) . '</td>
+						<td>' . $MyRow['methodid'] . ' - ' . ($MethodNames[$MyRow['methodid']] ?? '') . '</td>
+						<td>' . $MyRow['createdon'] . '</td>
+						<td><a href="' . $FormAction . '?ForecastID=' . $MyRow['forecastid'] . '">' . __('Review') . '</a></td>
+					</tr>';
+			}
+			echo '</table>';
+		}
+	}
+}
+
+include('includes/footer.php');
diff --git a/ForecastSalesHistory.php b/ForecastSalesHistory.php
new file mode 100644
index 0000000..e9aa59e
--- /dev/null
+++ b/ForecastSalesHistory.php
@@ -0,0 +1,81 @@
+<?php
+
+// Extracts the net sales (invoices less credit notes) of every item into monthly buckets per stock location.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Sales History');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastSalesHistory';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$LastCompleteMonth = fcLastCompleteMonth();
+$Held = fcHistoryRange();
+
+if (isset($_POST['Extract'])) {
+	$InputError = 0;
+	if (!fcIsMonth($_POST['FromMonth']) or !fcIsMonth($_POST['ToMonth'])) {
+		prnMsg(__('The first and last month of the range must be entered as year and month'), 'error');
+		$InputError = 1;
+	} else {
+		$FromMonth = $_POST['FromMonth'] . '-01';
+		$ToMonth = $_POST['ToMonth'] . '-01';
+		if ($FromMonth > $ToMonth) {
+			prnMsg(__('The first month of the range is after the last month'), 'error');
+			$InputError = 1;
+		}
+		if ($ToMonth > $LastCompleteMonth) {
+			prnMsg(__('The range can only run up to the last complete month') . ': ' . fcMonthLabel($LastCompleteMonth) . '. ' . __('A month still in progress would understate the sales of that month'), 'error');
+			$InputError = 1;
+		}
+		/* a gap between the held history and the new range would be read as months without sales */
+		if ($InputError == 0 and $Held['from'] !== null and ($FromMonth > fcMonthAdd($Held['to'], 1) or $ToMonth < fcMonthAdd($Held['from'], -1))) {
+			prnMsg(__('The range must overlap or follow directly on the history held') . ' (' . fcMonthLabel($Held['from']) . ' - ' . fcMonthLabel($Held['to']) . '), ' . __('otherwise the months in between would be treated as months without sales'), 'error');
+			$InputError = 1;
+		}
+	}
+	if ($InputError == 0) {
+		$Rows = fcExtractSalesHistory($FromMonth, $ToMonth);
+		prnMsg(__('The sales history of') . ' ' . fcMonthLabel($FromMonth) . ' - ' . fcMonthLabel($ToMonth) . ' ' . __('has been extracted and replaces any history held before for those months') . ': ' . locale_number_format($Rows, 0) . ' ' . __('item/location/month records'), 'success');
+		$Held = fcHistoryRange();
+	}
+}
+
+echo '<table class="selection">
+		<tr><th colspan="2">' . __('Sales history held') . '</th></tr>';
+if ($Held['from'] === null) {
+	echo '<tr><td colspan="2">' . __('No sales history has been extracted yet') . '</td></tr>';
+} else {
+	echo '<tr><td>' . __('Date range') . '</td><td>' . fcMonthLabel($Held['from']) . ' - ' . fcMonthLabel($Held['to']) . '</td></tr>
+		<tr><td>' . __('Months') . '</td><td class="number">' . locale_number_format($Held['months'], 0) . '</td></tr>
+		<tr><td>' . __('Items') . '</td><td class="number">' . locale_number_format($Held['items'], 0) . '</td></tr>
+		<tr><td>' . __('Item/location/month records') . '</td><td class="number">' . locale_number_format($Held['rows'], 0) . '</td></tr>';
+}
+echo '</table><br />';
+
+$DefaultTo = $_POST['ToMonth'] ?? fcMonthLabel($LastCompleteMonth);
+$DefaultFrom = $_POST['FromMonth'] ?? fcMonthLabel(fcMonthAdd($LastCompleteMonth, -23));
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset>
+		<legend>' . __('Extract Sales History') . '</legend>
+		<field>
+			<label for="FromMonth">' . __('From month') . ':</label>
+			<input type="month" name="FromMonth" id="FromMonth" required="required" value="' . $DefaultFrom . '" max="' . fcMonthLabel($LastCompleteMonth) . '" />
+		</field>
+		<field>
+			<label for="ToMonth">' . __('To month') . ':</label>
+			<input type="month" name="ToMonth" id="ToMonth" required="required" value="' . $DefaultTo . '" max="' . fcMonthLabel($LastCompleteMonth) . '" />
+		</field>
+	</fieldset>
+	<div class="page_help_text">' . __('The history is the net quantity invoiced (sales invoices and counter sales less credit notes and counter returns) taken from the stock movements, by calendar month of the invoice date, per item and stock location. 24 months is recommended. Extracting a range again replaces that range, it does not add to it.') . '</div>
+	<div class="centre">
+		<input type="submit" name="Extract" value="' . __('Extract Sales History') . '" />
+	</div>
+	</form>';
+
+include('includes/footer.php');
diff --git a/ForecastSummary.php b/ForecastSummary.php
new file mode 100644
index 0000000..be56abe
--- /dev/null
+++ b/ForecastSummary.php
@@ -0,0 +1,300 @@
+<?php
+
+// Summary forecasts: aggregated forecasts by stock category, customer type, sales area or salesperson, built from
+// the same monthly sales history, with a review of the items behind each summary.
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Summary Forecasts');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastSummary';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$FormAction = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$MethodNames = fcMethodNames();
+$Defaults = fcGetParameters();
+
+$Dimensions = array(
+	'category' => __('Stock category'),
+	'custtype' => __('Customer type'),
+	'area' => __('Sales area'),
+	'salesman' => __('Salesperson')
+);
+
+/** SQL condition on fcsaleshistory (joined to stockmaster) for a dimension value */
+function fcSummaryCondition($Dimension, $Value) {
+	switch ($Dimension) {
+		case 'category':
+			return "stockmaster.categoryid = '" . $Value . "'";
+		case 'custtype':
+			return "fcsaleshistory.debtortype = '" . (int) $Value . "'";
+		case 'area':
+			return "fcsaleshistory.area = '" . $Value . "'";
+		default:
+			return "fcsaleshistory.salesman = '" . $Value . "'";
+	}
+}
+
+/** The values of a dimension with sales in the history: value => label */
+function fcSummaryValues($Dimension) {
+	switch ($Dimension) {
+		case 'category':
+			$SQL = "SELECT DISTINCT stockcategory.categoryid AS code, stockcategory.categorydescription AS label
+					FROM fcsaleshistory
+					INNER JOIN stockmaster ON stockmaster.stockid = fcsaleshistory.stockid
+					INNER JOIN stockcategory ON stockcategory.categoryid = stockmaster.categoryid
+					ORDER BY label";
+			break;
+		case 'custtype':
+			$SQL = "SELECT DISTINCT fcsaleshistory.debtortype AS code, COALESCE(debtortype.typename, '" . DB_escape_string(__('Not a customer sale')) . "') AS label
+					FROM fcsaleshistory
+					LEFT JOIN debtortype ON debtortype.typeid = fcsaleshistory.debtortype
+					ORDER BY label";
+			break;
+		case 'area':
+			$SQL = "SELECT DISTINCT fcsaleshistory.area AS code, COALESCE(areas.areadescription, '" . DB_escape_string(__('No area')) . "') AS label
+					FROM fcsaleshistory
+					LEFT JOIN areas ON areas.areacode = fcsaleshistory.area
+					ORDER BY label";
+			break;
+		default:
+			$SQL = "SELECT DISTINCT fcsaleshistory.salesman AS code, COALESCE(salesman.salesmanname, '" . DB_escape_string(__('No salesperson')) . "') AS label
+					FROM fcsaleshistory
+					LEFT JOIN salesman ON salesman.salesmancode = fcsaleshistory.salesman
+					ORDER BY label";
+	}
+	$Result = DB_query($SQL);
+	$Values = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Values[$MyRow['code']] = $MyRow['label'];
+	}
+	return $Values;
+}
+
+function fcSummarySeries($Dimension, $Value) {
+	$History = fcHistoryRange();
+	if ($History['from'] === null) {
+		return array('values' => array(), 'first' => null, 'last' => null);
+	}
+	$Result = DB_query("SELECT fcsaleshistory.periodstart, SUM(fcsaleshistory.quantity) AS qty
+						FROM fcsaleshistory
+						INNER JOIN stockmaster ON stockmaster.stockid = fcsaleshistory.stockid
+						WHERE " . fcSummaryCondition($Dimension, $Value) . "
+						GROUP BY fcsaleshistory.periodstart");
+	$ByMonth = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$ByMonth[$MyRow['periodstart']] = (float) $MyRow['qty'];
+	}
+	return fcBuildSeries($ByMonth, $History['from'], $History['to']);
+}
+
+/* ------------------------------------------------------------------------------------------------------ */
+
+if (isset($_POST['Generate'])) {
+	$Parameters = $Defaults;
+	foreach (array('alpha', 'beta', 'gamma', 'seasonlength', 'maperiods', 'holdoutmonths', 'growthpercent', 'flexibleweights', 'wmaweights') as $Key) {
+		if (isset($_POST[$Key]) and trim($_POST[$Key]) !== '') {
+			$Parameters[$Key] = trim($_POST[$Key]);
+		}
+	}
+	$Dimension = $_POST['Dimension'] ?? 'category';
+	$Method = (int) ($_POST['Method'] ?? 0);
+	$Horizon = (int) ($_POST['Horizon'] ?? $Defaults['defaulthorizon']);
+	$InputError = 0;
+	foreach (fcValidateParameters($Parameters) as $Problem) {
+		prnMsg($Problem, 'error');
+		$InputError = 1;
+	}
+	if (!isset($Dimensions[$Dimension])) {
+		prnMsg(__('Choose what to summarise by'), 'error');
+		$InputError = 1;
+	}
+	if ($Horizon < 1 or $Horizon > 36 or ($Method != 0 and !isset($MethodNames[$Method]))) {
+		prnMsg(__('The horizon must be from 1 to 36 months and the method one of the listed methods'), 'error');
+		$InputError = 1;
+	}
+	if (fcHistoryRange()['from'] === null) {
+		prnMsg(__('There is no sales history to forecast from. Extract the sales history first.'), 'error');
+		$InputError = 1;
+	}
+	if ($InputError == 0) {
+		$AllValues = fcSummaryValues($Dimension);
+		if (($_POST['DimensionValue'] ?? '*') === '*') {
+			$Wanted = array_keys($AllValues);
+		} else {
+			$Wanted = array($_POST['DimensionValue']);
+		}
+		$P = fcMethodParameters($Parameters);
+		$Succeeded = 0;
+		$Failed = array();
+		foreach ($Wanted as $Value) {
+			$Value = (string) $Value;
+			$Label = $AllValues[$Value] ?? $Value;
+			$Series = fcSummarySeries($Dimension, DB_escape_string($Value));
+			$UseMethod = $Method;
+			$BestFit = 0;
+			if (count($Series['values']) == 0) {
+				$Failed[] = array($Label, __('No sales history'));
+				continue;
+			}
+			if ($UseMethod == 0) {
+				$BestFit = 1;
+				$UseMethod = fcBestMethod(fcHoldoutTest($Series['values'], (int) $Parameters['holdoutmonths'], $P));
+				if ($UseMethod === null) {
+					$Failed[] = array($Label, __('Too little history for any method to be tested'));
+					continue;
+				}
+			}
+			$Forecast = fcForecast($UseMethod, $Series['values'], $Horizon, $P);
+			if (!$Forecast['ok']) {
+				$Failed[] = array($Label, $Forecast['error']);
+				continue;
+			}
+			DB_Txn_Begin();
+			DB_query("UPDATE fcsummaryforecasts SET active = 0
+						WHERE dimension = '" . $Dimension . "' AND dimensionvalue = '" . DB_escape_string($Value) . "' AND active = 1", '', '', true);
+			DB_query("INSERT INTO fcsummaryforecasts (dimension, dimensionvalue, methodid, parameters, bestfit, historymonths, active, createdon, createdby)
+						VALUES ('" . $Dimension . "', '" . DB_escape_string($Value) . "', '" . $UseMethod . "', '" . DB_escape_string(fcParametersUsed($UseMethod, $Parameters)) . "',
+							'" . $BestFit . "', '" . count($Series['values']) . "', 1, '" . date('Y-m-d H:i:s') . "', '" . DB_escape_string($_SESSION['UserID']) . "')", '', '', true);
+			$SummaryID = DB_Last_Insert_ID('fcsummaryforecasts', 'summaryid');
+			$FirstPeriod = fcMonthAdd($Series['last'], 1);
+			foreach ($Forecast['values'] as $Index => $Quantity) {
+				DB_query("INSERT INTO fcsummarydetails (summaryid, periodstart, calculatedqty)
+							VALUES ('" . $SummaryID . "', '" . fcMonthAdd($FirstPeriod, $Index) . "', '" . $Quantity . "')", '', '', true);
+			}
+			DB_Txn_Commit();
+			$Succeeded++;
+		}
+		prnMsg($Succeeded . ' ' . __('successful') . ', ' . count($Failed) . ' ' . __('failed'), count($Failed) == 0 ? 'success' : 'warn');
+		foreach ($Failed as $Failure) {
+			prnMsg(htmlspecialchars($Failure[0], ENT_QUOTES, 'UTF-8') . ': ' . htmlspecialchars($Failure[1], ENT_QUOTES, 'UTF-8'), 'warn');
+		}
+	}
+}
+
+/* ------------------------------------------------------------------------------------------------------ */
+/* Review of one summary: its forecast and the items behind it                                            */
+/* ------------------------------------------------------------------------------------------------------ */
+
+$SummaryID = (int) ($_GET['SummaryID'] ?? 0);
+if ($SummaryID > 0) {
+	$Result = DB_query("SELECT * FROM fcsummaryforecasts WHERE summaryid = '" . $SummaryID . "'");
+	$Summary = DB_fetch_array($Result);
+	if ($Summary) {
+		$Labels = fcSummaryValues($Summary['dimension']);
+		$Label = $Labels[$Summary['dimensionvalue']] ?? $Summary['dimensionvalue'];
+		echo '<table class="selection">
+				<tr><th colspan="2">' . ($Dimensions[$Summary['dimension']] ?? '') . ': ' . htmlspecialchars($Label, ENT_QUOTES, 'UTF-8') . '</th></tr>
+				<tr><td>' . __('Method') . '</td><td>' . $Summary['methodid'] . ' - ' . ($MethodNames[$Summary['methodid']] ?? '') . ($Summary['bestfit'] ? ' (' . __('best fit') . ')' : '') . '</td></tr>
+				<tr><td>' . __('Parameters') . '</td><td>' . htmlspecialchars($Summary['parameters'], ENT_QUOTES, 'UTF-8') . '</td></tr>
+				<tr><td>' . __('Generated') . '</td><td>' . $Summary['createdon'] . '</td></tr>
+				<tr><td>' . __('Status') . '</td><td>' . ($Summary['active'] ? __('Active') : __('Superseded')) . '</td></tr>
+			</table><br />';
+		$Result = DB_query("SELECT periodstart, calculatedqty FROM fcsummarydetails WHERE summaryid = '" . $SummaryID . "' ORDER BY periodstart");
+		echo '<table class="selection"><tr><th>' . __('Month') . '</th><th>' . __('Forecast quantity') . '</th></tr>';
+		while ($MyRow = DB_fetch_array($Result)) {
+			echo '<tr class="striped_row"><td>' . fcMonthLabel($MyRow['periodstart']) . '</td><td class="number">' . fcMoney($MyRow['calculatedqty']) . '</td></tr>';
+		}
+		echo '</table><br />';
+
+		/* the detail behind the summary: the items that make up the history it was built from */
+		$History = fcHistoryRange();
+		$Since = $History['to'] !== null ? fcMonthAdd($History['to'], -11) : '1000-01-01';
+		$Result = DB_query("SELECT fcsaleshistory.stockid,
+								stockmaster.description,
+								SUM(fcsaleshistory.quantity) AS qty,
+								SUM(CASE WHEN fcsaleshistory.periodstart >= '" . $Since . "' THEN fcsaleshistory.quantity ELSE 0 END) AS lastyear
+							FROM fcsaleshistory
+							INNER JOIN stockmaster ON stockmaster.stockid = fcsaleshistory.stockid
+							WHERE " . fcSummaryCondition($Summary['dimension'], DB_escape_string($Summary['dimensionvalue'])) . "
+							GROUP BY fcsaleshistory.stockid, stockmaster.description
+							ORDER BY lastyear DESC
+							LIMIT 200");
+		$Rows = array();
+		$TotalLastYear = 0;
+		while ($MyRow = DB_fetch_array($Result)) {
+			$Rows[] = $MyRow;
+			$TotalLastYear += $MyRow['lastyear'];
+		}
+		echo '<table class="selection"><tr><th colspan="5">' . __('Items behind this summary') . '</th></tr>
+				<tr><th>' . __('Item') . '</th><th>' . __('Description') . '</th><th>' . __('Sold in all history') . '</th><th>' . __('Sold in the last 12 months') . '</th><th>' . __('Share of last 12 months %') . '</th></tr>';
+		foreach ($Rows as $Row) {
+			echo '<tr class="striped_row">
+					<td><a href="' . $RootPath . '/ForecastReview.php?StockID=' . urlencode($Row['stockid']) . '">' . htmlspecialchars($Row['stockid'], ENT_QUOTES, 'UTF-8') . '</a></td>
+					<td>' . htmlspecialchars($Row['description'], ENT_QUOTES, 'UTF-8') . '</td>
+					<td class="number">' . fcMoney($Row['qty']) . '</td>
+					<td class="number">' . fcMoney($Row['lastyear']) . '</td>
+					<td class="number">' . ($TotalLastYear > 0 ? locale_number_format(100 * $Row['lastyear'] / $TotalLastYear, 1) : '') . '</td>
+				</tr>';
+		}
+		echo '</table><br /><div class="centre"><a href="' . $FormAction . '">' . __('Back to summary forecasts') . '</a></div>';
+		include('includes/footer.php');
+		exit();
+	}
+}
+
+/* ------------------------------------------------------------------------------------------------------ */
+
+$Result = DB_query("SELECT summaryid, dimension, dimensionvalue, methodid, createdon FROM fcsummaryforecasts
+					WHERE active = 1 ORDER BY dimension, dimensionvalue");
+if (DB_num_rows($Result) > 0) {
+	echo '<table class="selection"><tr><th colspan="5">' . __('Active summary forecasts') . '</th></tr>
+			<tr><th>' . __('Summary by') . '</th><th>' . __('Value') . '</th><th>' . __('Method') . '</th><th>' . __('Generated') . '</th><th></th></tr>';
+	$LabelCache = array();

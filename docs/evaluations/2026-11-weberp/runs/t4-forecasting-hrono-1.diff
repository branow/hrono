+UPDATE `modules` SET `sequence` = `sequence` + 1 WHERE `sequence` >= 7;
+
+INSERT INTO `modules` (`secroleid`, `modulelink`, `reportlink`, `modulename`, `sequence`) SELECT `secroleid`, 'forecast', 'fc', 'Forecasting', 7 FROM `securityroles`;
+
+INSERT INTO `menuitems` (`secroleid`, `modulelink`, `menusection`, `caption`, `url`, `sequence`)
+SELECT roles.secroleid, items.modulelink, items.menusection, items.caption, items.url, items.sequence
+FROM (SELECT `secroleid` FROM `securityroles`) AS roles
+CROSS JOIN (
+SELECT 'forecast' AS modulelink, 'Transactions' AS menusection, 'Forecasting Dashboard' AS caption, '/ForecastDashboard.php' AS url, 1 AS sequence
+UNION ALL SELECT 'forecast', 'Transactions', 'Extract Sales History', '/ForecastSalesHistory.php', 2
+UNION ALL SELECT 'forecast', 'Transactions', 'Generate Forecasts', '/ForecastGenerate.php', 3
+UNION ALL SELECT 'forecast', 'Transactions', 'Summary Forecasts', '/ForecastSummary.php', 4
+UNION ALL SELECT 'forecast', 'Transactions', 'Convert Forecasts to MRP Demands', '/ForecastToMRP.php', 5
+UNION ALL SELECT 'forecast', 'Reports', 'Forecast Inquiry', '/ForecastInquiry.php', 1
+UNION ALL SELECT 'forecast', 'Reports', 'Forecast Accuracy', '/ForecastAccuracy.php', 2
+UNION ALL SELECT 'forecast', 'Reports', 'Forecast Method Comparison', '/ForecastMethodComparison.php', 3
+UNION ALL SELECT 'forecast', 'Reports', 'MRP', '/MRPReport.php', 4
+UNION ALL SELECT 'forecast', 'Maintenance', 'Review and Revise Forecasts', '/ForecastReview.php', 1
+UNION ALL SELECT 'forecast', 'Maintenance', 'Forecast Parameters', '/ForecastParameters.php', 2
+UNION ALL SELECT 'forecast', 'Maintenance', 'Master Schedule', '/MRPDemands.php', 3
+UNION ALL SELECT 'forecast', 'Maintenance', 'MRP Calculation', '/MRP.php', 4
+) AS items;
+

@@ -131,6 +132,26 @@ if (isset($_POST['submit'])) {
 
 		$SQL_ClientSince = FormatDateForSQL($_POST['ClientSince']);
 
+		/* Credit control: only credit control may change the credit status or the credit limit of an existing customer.
+		For anyone else the stored values are kept whatever was posted. Changes by credit control are logged. */
+		$CreditChanged = false;
+		if (!isset($_POST['New'])) {
+			$OldCreditResult = DB_query("SELECT holdreason, creditlimit FROM debtorsmaster WHERE debtorno = '" . $_POST['DebtorNo'] . "'");
+			if (DB_num_rows($OldCreditResult) == 1) {
+				$OldCredit = DB_fetch_array($OldCreditResult);
+				$NewLimitPosted = filter_number_format($_POST['CreditLimit']);
+				if (!CanMaintainCredit()) {
+					if ($_POST['HoldReason'] != $OldCredit['holdreason'] OR $NewLimitPosted != $OldCredit['creditlimit']) {
+						prnMsg(__('Only credit control can change the credit status or credit limit of a customer. These fields have not been changed'), 'warn');
+					}

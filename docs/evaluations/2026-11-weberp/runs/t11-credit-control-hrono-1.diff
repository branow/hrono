diff --git a/CreditControl.php b/CreditControl.php
new file mode 100644
index 0000000..0653095
--- /dev/null
+++ b/CreditControl.php
@@ -0,0 +1,239 @@
+<?php
+
+/* Credit control for one customer: record a credit review, put the customer on or off stop or watch,
+and see the full history of credit decisions. Restricted to security token 21 (credit controller,
+deputy, Finance Director) through the scripts table. */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Control');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControl';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . __('Credit Control') . '" alt="" /> ' . $Title . '</p>';
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+}
+
+if (!isset($DebtorNo) OR $DebtorNo == '') {
+	prnMsg(__('Select a customer first') . ' - <a href="' . $RootPath . '/SelectCustomer.php">' . __('Customer selection') . '</a>', 'info');
+	include('includes/footer.php');
+	exit();
+}
+
+$Result = DB_query("SELECT debtorsmaster.debtorno,
+						debtorsmaster.name,
+						debtorsmaster.currcode,
+						debtorsmaster.creditlimit,
+						debtorsmaster.nextreviewdate,
+						currencies.decimalplaces
+					FROM debtorsmaster
+					INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+					WHERE debtorsmaster.debtorno = '" . DB_escape_string($DebtorNo) . "'");
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('The customer record could not be found'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($Result);
+$DebtorNo = $Customer['debtorno'];
+
+/* Defence in depth: the page token is checked by session.php, but a sales rep login must never reach this */
+if (!CanMaintainCredit() OR (isset($_SESSION['SalesmanLogin']) AND $_SESSION['SalesmanLogin'] != '')) {
+	prnMsg(__('You are not authorised to maintain credit control information'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$Status = GetCreditStatus($DebtorNo);
+
+if (isset($_POST['RecordReview'])) {
+	$InputError = 0;
+	$NewLimit = filter_number_format($_POST['NewCreditLimit']);
+	$Outcome = $_POST['Outcome'];
+	$ValidOutcomes = array('LimitConfirmed', 'LimitRaised', 'LimitReduced', 'PutOnWatch', 'PutOnStop');
+	if (!in_array($Outcome, $ValidOutcomes)) {
+		$InputError = 1;
+		prnMsg(__('Select the outcome of the review'), 'error');
+	}
+	if (!is_numeric($NewLimit) OR $NewLimit < 0) {
+		$InputError = 1;
+		prnMsg(__('The credit limit must be a number of zero or more'), 'error');
+	}
+	if (!Is_Date($_POST['NextReviewDate'])) {
+		$InputError = 1;
+		prnMsg(__('The next review date must be a valid date in the format') . ' ' . $_SESSION['DefaultDateFormat'], 'error');
+	} elseif (FormatDateForSQL($_POST['NextReviewDate']) <= date('Y-m-d')) {
+		$InputError = 1;
+		prnMsg(__('The next review date must be in the future'), 'error');
+	}
+	if (trim($_POST['Notes']) == '') {
+		$InputError = 1;
+		prnMsg(__('Notes explaining the review outcome must be entered'), 'error');
+	}
+	if ($Outcome == 'LimitRaised' AND $NewLimit <= $Customer['creditlimit']) {
+		$InputError = 1;
+		prnMsg(__('A raised credit limit must be higher than the current limit'), 'error');
+	}
+	if ($Outcome == 'LimitReduced' AND $NewLimit >= $Customer['creditlimit']) {
+		$InputError = 1;
+		prnMsg(__('A reduced credit limit must be lower than the current limit'), 'error');
+	}
+	if ($Outcome == 'LimitConfirmed') {
+		$NewLimit = $Customer['creditlimit'];
+	}
+	$NewStatusCode = false;
+	if ($Outcome == 'PutOnWatch' OR $Outcome == 'PutOnStop') {
+		$NewStatusCode = GetHoldReasonCode($Outcome == 'PutOnStop' ? CREDIT_STATUS_STOP : CREDIT_STATUS_WATCH);
+		if ($NewStatusCode === false) {
+			$InputError = 1;
+			prnMsg(__('No credit status code exists for this outcome. Set one up in Credit Status Maintenance first'), 'error');
+		}
+	}
+
+	if ($InputError == 0) {
+		$NextReview = FormatDateForSQL($_POST['NextReviewDate']);
+		DB_Txn_Begin();
+		$SQL = "UPDATE debtorsmaster SET nextreviewdate = '" . $NextReview . "'";
+		if ($NewLimit != $Customer['creditlimit']) {
+			$SQL .= ", creditlimit = '" . $NewLimit . "'";
+		}
+		if ($NewStatusCode !== false) {
+			$SQL .= ", holdreason = '" . $NewStatusCode . "'";
+		}
+		DB_query($SQL . " WHERE debtorno = '" . DB_escape_string($DebtorNo) . "'", __('The credit review could not be saved'));
+		LogCreditAction($DebtorNo, 'Review', $_POST['Notes'], $Customer['creditlimit'], $NewLimit, $Outcome, $NextReview);
+		if ($NewStatusCode !== false) {
+			LogCreditAction($DebtorNo, $Outcome == 'PutOnStop' ? 'Stop' : 'Watch', $_POST['Notes'], CreditStatusText($Status['status']), CreditStatusText($Outcome == 'PutOnStop' ? CREDIT_STATUS_STOP : CREDIT_STATUS_WATCH));
+		}
+		DB_Txn_Commit();
+		prnMsg(__('The credit review has been recorded'), 'success');
+		$Customer['creditlimit'] = $NewLimit;
+		$Customer['nextreviewdate'] = $NextReview;
+		$Status = GetCreditStatus($DebtorNo);
+	}
+}
+
+if (isset($_POST['ChangeStatus'])) {
+	$InputError = 0;
+	$NewStatus = (int) $_POST['NewStatus'];
+	if (!in_array($NewStatus, array(CREDIT_STATUS_NORMAL, CREDIT_STATUS_STOP, CREDIT_STATUS_WATCH))) {
+		$InputError = 1;
+	}
+	if (trim($_POST['StatusReason']) == '') {
+		$InputError = 1;
+		prnMsg(__('A reason must be entered for a change of credit status'), 'error');
+	}
+	$ReasonCode = false;
+	if ($InputError == 0) {
+		$CodeResult = DB_query("SELECT reasoncode FROM holdreasons
+								WHERE reasoncode = '" . (int) $_POST['StatusCode'] . "'
+								AND dissallowinvoices = '" . $NewStatus . "'");
+		if (DB_num_rows($CodeResult) == 0) {
+			$InputError = 1;
+			prnMsg(__('Select a credit status code that matches the new status'), 'error');
+		} else {
+			$CodeRow = DB_fetch_row($CodeResult);
+			$ReasonCode = $CodeRow[0];
+		}
+	}
+	if ($InputError == 0 AND $NewStatus == $Status['status'] AND $ReasonCode == $Status['reasoncode']) {
+		$InputError = 1;
+		prnMsg(__('The customer already has this credit status'), 'warn');
+	}
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+		DB_query("UPDATE debtorsmaster SET holdreason = '" . $ReasonCode . "'
+					WHERE debtorno = '" . DB_escape_string($DebtorNo) . "'", __('The credit status could not be changed'));
+		$ActionName = ($NewStatus == CREDIT_STATUS_STOP) ? 'Stop' : (($NewStatus == CREDIT_STATUS_WATCH) ? 'Watch' : 'Release');
+		LogCreditAction($DebtorNo, $ActionName, $_POST['StatusReason'], CreditStatusText($Status['status']) . ' / ' . $Status['reason'], CreditStatusText($NewStatus));
+		DB_Txn_Commit();
+		prnMsg(__('The credit status has been changed to') . ' ' . CreditStatusText($NewStatus), 'success');
+		$Status = GetCreditStatus($DebtorNo);
+	}
+}
+
+echo '<table class="selection">
+		<tr><th colspan="2">' . htmlspecialchars($Customer['name'], ENT_QUOTES, 'UTF-8') . ' (' . htmlspecialchars($DebtorNo, ENT_QUOTES, 'UTF-8') . ')</th></tr>
+		<tr><td>' . __('Credit status') . '</td><td><b>' . CreditStatusText($Status['status']) . '</b> - ' . htmlspecialchars($Status['reason'], ENT_QUOTES, 'UTF-8') . '</td></tr>
+		<tr><td>' . __('Credit limit') . '</td><td>' . locale_number_format($Customer['creditlimit'], $Customer['decimalplaces']) . ' ' . $Customer['currcode'] . '</td></tr>
+		<tr><td>' . __('Next review due') . '</td><td>' . ConvertSQLDate($Customer['nextreviewdate']) . '</td></tr>
+	</table><br />';
+
+$StatusOptions = '';
+$CodeResult = DB_query("SELECT reasoncode, reasondescription, dissallowinvoices FROM holdreasons ORDER BY dissallowinvoices, reasoncode");
+$CodeRows = array();
+while ($CodeRow = DB_fetch_array($CodeResult)) {
+	$CodeRows[] = $CodeRow;
+	$StatusOptions .= '<option value="' . $CodeRow['reasoncode'] . '" title="' . $CodeRow['dissallowinvoices'] . '">' . CreditStatusText($CodeRow['dissallowinvoices']) . ' - ' . htmlspecialchars($CodeRow['reasondescription'], ENT_QUOTES, 'UTF-8') . '</option>';
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<input type="hidden" name="DebtorNo" value="' . htmlspecialchars($DebtorNo, ENT_QUOTES, 'UTF-8') . '" />';
+
+/* Record a credit review */
+$DefaultNext = isset($_POST['NextReviewDate']) ? $_POST['NextReviewDate'] : ConvertSQLDate(DefaultNextReviewDate());
+echo '<fieldset><legend>' . __('Record a credit review') . '</legend>
+	<field><label for="Outcome">' . __('Outcome') . '</label>
+		<select name="Outcome" id="Outcome">
+			<option value="LimitConfirmed">' . __('Limit confirmed') . '</option>
+			<option value="LimitRaised">' . __('Limit raised') . '</option>
+			<option value="LimitReduced">' . __('Limit reduced') . '</option>
+			<option value="PutOnWatch">' . __('Put on watch') . '</option>
+			<option value="PutOnStop">' . __('Put on stop') . '</option>
+		</select></field>
+	<field><label for="NewCreditLimit">' . __('Credit limit') . '</label>
+		<input type="text" class="number" name="NewCreditLimit" id="NewCreditLimit" size="12" value="' . locale_number_format($Customer['creditlimit'], $Customer['decimalplaces']) . '" /></field>
+	<field><label for="NextReviewDate">' . __('Next review date') . '</label>
+		<input type="text" class="date" name="NextReviewDate" id="NextReviewDate" size="10" value="' . $DefaultNext . '" /></field>
+	<field><label for="Notes">' . __('Notes') . '</label>
+		<textarea name="Notes" id="Notes" rows="3" cols="50">' . (isset($_POST['Notes']) ? htmlspecialchars($_POST['Notes'], ENT_QUOTES, 'UTF-8') : '') . '</textarea></field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="RecordReview" value="' . __('Record Review') . '" /></div>';
+
+/* Change credit status */
+echo '<fieldset><legend>' . __('Change credit status') . '</legend>
+	<field><label for="NewStatus">' . __('New status') . '</label>
+		<select name="NewStatus" id="NewStatus">
+			<option value="0">' . __('Normal') . '</option>
+			<option value="2">' . __('On watch') . '</option>
+			<option value="1">' . __('On stop') . '</option>
+		</select></field>
+	<field><label for="StatusCode">' . __('Credit status code') . '</label>
+		<select name="StatusCode" id="StatusCode">' . $StatusOptions . '</select>
+		<fieldhelp>' . __('The code must belong to the chosen status; codes are maintained in Credit Status Maintenance') . '</fieldhelp></field>
+	<field><label for="StatusReason">' . __('Reason') . '</label>
+		<textarea name="StatusReason" id="StatusReason" rows="2" cols="50"></textarea></field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="ChangeStatus" value="' . __('Change Status') . '" /></div>
+	</form>';
+
+/* Full history, newest first: read-only */
+echo '<br /><table class="selection">
+		<tr><th colspan="8">' . __('Credit history') . '</th></tr>
+		<tr><th>' . __('Date') . '</th><th>' . __('Action') . '</th><th>' . __('By') . '</th><th>' . __('Outcome') . '</th><th>' . __('From') . '</th><th>' . __('To') . '</th><th>' . __('Next review') . '</th><th>' . __('Notes') . '</th></tr>';
+$HistoryResult = DB_query("SELECT actiondate, action, userid, outcome, oldvalue, newvalue, nextreviewdate, notes
+							FROM creditcontrollog
+							WHERE debtorno = '" . DB_escape_string($DebtorNo) . "'
+							ORDER BY actiondate DESC, id DESC");
+while ($Row = DB_fetch_array($HistoryResult)) {
+	echo '<tr class="striped_row">
+			<td>' . $Row['actiondate'] . '</td>
+			<td>' . htmlspecialchars($Row['action'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td>' . htmlspecialchars($Row['userid'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td>' . htmlspecialchars($Row['outcome'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td>' . htmlspecialchars($Row['oldvalue'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td>' . htmlspecialchars($Row['newvalue'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td>' . ($Row['nextreviewdate'] > '1000-01-01' ? ConvertSQLDate($Row['nextreviewdate']) : '') . '</td>
+			<td>' . nl2br(htmlspecialchars($Row['notes'], ENT_QUOTES, 'UTF-8')) . '</td>
+		</tr>';
+}
+echo '</table>';
+
+include('includes/footer.php');
diff --git a/CreditControlReport.php b/CreditControlReport.php
new file mode 100644
index 0000000..97aabf2
--- /dev/null
+++ b/CreditControlReport.php
@@ -0,0 +1,148 @@
+<?php
+
+/* Credit control report: customers due or overdue for a credit review, customers over their credit
+limit and customers on watch or on stop. Filterable by sales rep and currency; totals in home currency. */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Control Report');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlReport';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+/* A sales rep login sees only their own customers, whatever is posted */
+$RepLogin = (isset($_SESSION['SalesmanLogin']) AND $_SESSION['SalesmanLogin'] != '') ? $_SESSION['SalesmanLogin'] : '';
+$Salesman = ($RepLogin != '') ? $RepLogin : (isset($_POST['Salesman']) ? $_POST['Salesman'] : '');
+$Currency = isset($_POST['Currency']) ? $_POST['Currency'] : '';
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Filter') . '</legend>';
+
+if ($RepLogin == '') {
+	echo '<field><label for="Salesman">' . __('Sales rep') . '</label><select name="Salesman" id="Salesman"><option value="">' . __('All') . '</option>';
+	$Result = DB_query("SELECT salesmancode, salesmanname FROM salesman ORDER BY salesmanname");
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<option value="' . $MyRow['salesmancode'] . '"' . ($Salesman == $MyRow['salesmancode'] ? ' selected="selected"' : '') . '>' . htmlspecialchars($MyRow['salesmanname'], ENT_QUOTES, 'UTF-8') . '</option>';
+	}
+	echo '</select></field>';
+}
+echo '<field><label for="Currency">' . __('Currency') . '</label><select name="Currency" id="Currency"><option value="">' . __('All') . '</option>';
+$Result = DB_query("SELECT currabrev, currency FROM currencies ORDER BY currabrev");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option value="' . $MyRow['currabrev'] . '"' . ($Currency == $MyRow['currabrev'] ? ' selected="selected"' : '') . '>' . $MyRow['currabrev'] . ' - ' . htmlspecialchars($MyRow['currency'], ENT_QUOTES, 'UTF-8') . '</option>';
+}
+echo '</select></field></fieldset>
+	<div class="centre"><input type="submit" name="Show" value="' . __('Show Report') . '" /></div></form>';
+
+/* One row per customer: balance is the sum of open debtor transactions in the customer's currency,
+and the home-currency value converts each transaction at its own rate */
+$SQL = "SELECT debtorsmaster.debtorno,
+			debtorsmaster.name,
+			debtorsmaster.currcode,
+			debtorsmaster.creditlimit,
+			debtorsmaster.nextreviewdate,
+			holdreasons.dissallowinvoices,
+			holdreasons.reasondescription,
+			currencies.decimalplaces,
+			currencies.rate,
+			(SELECT MIN(custbranch.salesman) FROM custbranch WHERE custbranch.debtorno = debtorsmaster.debtorno) AS salesman,
+			COALESCE((SELECT SUM(debtortrans.ovamount + debtortrans.ovgst + debtortrans.ovfreight + debtortrans.ovdiscount - debtortrans.alloc)
+				FROM debtortrans WHERE debtortrans.debtorno = debtorsmaster.debtorno), 0) AS balance,
+			COALESCE((SELECT SUM((debtortrans.ovamount + debtortrans.ovgst + debtortrans.ovfreight + debtortrans.ovdiscount - debtortrans.alloc) / debtortrans.rate)
+				FROM debtortrans WHERE debtortrans.debtorno = debtorsmaster.debtorno AND debtortrans.rate <> 0), 0) AS homebalance
+		FROM debtorsmaster
+		INNER JOIN holdreasons ON debtorsmaster.holdreason = holdreasons.reasoncode
+		INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+		WHERE 1 = 1";
+if ($Currency != '') {
+	$SQL .= " AND debtorsmaster.currcode = '" . DB_escape_string($Currency) . "'";
+}
+if ($Salesman != '') {
+	$SQL .= " AND EXISTS (SELECT 1 FROM custbranch WHERE custbranch.debtorno = debtorsmaster.debtorno AND custbranch.salesman = '" . DB_escape_string($Salesman) . "')";
+}
+$SQL .= " ORDER BY debtorsmaster.name";
+$Result = DB_query($SQL, __('The credit control report could not be retrieved'));
+
+$Today = date('Y-m-d');
+$Review = array();
+$Over = array();
+$Flagged = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	if ($MyRow['nextreviewdate'] <= $Today) {
+		$Review[] = $MyRow;
+	}
+	if ($MyRow['balance'] > $MyRow['creditlimit']) {
+		$MyRow['overby'] = $MyRow['balance'] - $MyRow['creditlimit'];
+		$MyRow['homeoverby'] = ($MyRow['rate'] != 0) ? $MyRow['overby'] / $MyRow['rate'] : 0;
+		$Over[] = $MyRow;
+	}
+	if ($MyRow['dissallowinvoices'] != CREDIT_STATUS_NORMAL) {
+		$Flagged[] = $MyRow;
+	}
+}
+
+$HomeDP = $_SESSION['CompanyRecord']['decimalplaces'];
+$HomeCurr = $_SESSION['CompanyRecord']['currencydefault'];
+
+function CreditReportTable($Heading, $Rows, $Columns, $HomeCurr, $HomeDP, $TotalField, $RootPath) {
+	echo '<br /><table class="selection"><tr><th colspan="' . (count($Columns) + 1) . '">' . $Heading . ' (' . count($Rows) . ')</th></tr><tr><th>' . __('Customer') . '</th>';
+	foreach ($Columns as $Label => $Field) {
+		echo '<th>' . $Label . '</th>';
+	}
+	echo '</tr>';
+	$Total = 0;
+	foreach ($Rows as $Row) {
+		echo '<tr class="striped_row"><td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($Row['debtorno']) . '">' . htmlspecialchars($Row['name'], ENT_QUOTES, 'UTF-8') . '</a></td>';
+		foreach ($Columns as $Label => $Field) {
+			echo '<td>' . call_user_func($Field, $Row) . '</td>';
+		}
+		echo '</tr>';
+		if ($TotalField !== '') {
+			$Total += $Row[$TotalField];
+		}
+	}
+	if ($TotalField !== '') {
+		echo '<tr><th colspan="' . count($Columns) . '">' . __('Total in') . ' ' . $HomeCurr . '</th><th class="number">' . locale_number_format($Total, $HomeDP) . '</th></tr>';
+	}
+	echo '</table>';
+}
+
+$Money = function ($Field) {
+	return function ($Row) use ($Field) {
+		return '<span class="number">' . locale_number_format($Row[$Field], $Row['decimalplaces']) . '</span> ' . $Row['currcode'];
+	};
+};
+$Text = function ($Field) {
+	return function ($Row) use ($Field) {
+		return htmlspecialchars($Row[$Field], ENT_QUOTES, 'UTF-8');
+	};
+};
+$ReviewDate = function ($Row) {
+	return ConvertSQLDate($Row['nextreviewdate']);
+};
+$StatusCol = function ($Row) {
+	return CreditStatusText($Row['dissallowinvoices']) . ' - ' . htmlspecialchars($Row['reasondescription'], ENT_QUOTES, 'UTF-8');
+};
+$HomeCol = function ($Field, $DP) {
+	return function ($Row) use ($Field, $DP) {
+		return locale_number_format($Row[$Field], $DP);
+	};
+};
+
+CreditReportTable(__('Due or overdue for credit review'), $Review,
+	array(__('Next review due') => $ReviewDate, __('Credit limit') => $Money('creditlimit'), __('Status') => $StatusCol),
+	$HomeCurr, $HomeDP, '', $RootPath);
+
+CreditReportTable(__('Over credit limit'), $Over,
+	array(__('Credit limit') => $Money('creditlimit'), __('Balance') => $Money('balance'), __('Over by') => $Money('overby'), __('Over by') . ' (' . $HomeCurr . ')' => $HomeCol('homeoverby', $HomeDP)),
+	$HomeCurr, $HomeDP, 'homeoverby', $RootPath);
+
+CreditReportTable(__('On watch or on stop'), $Flagged,
+	array(__('Status') => $StatusCol, __('Balance') => $Money('balance'), __('Balance') . ' (' . $HomeCurr . ')' => $HomeCol('homebalance', $HomeDP)),
+	$HomeCurr, $HomeDP, 'homebalance', $RootPath);
+
+include('includes/footer.php');

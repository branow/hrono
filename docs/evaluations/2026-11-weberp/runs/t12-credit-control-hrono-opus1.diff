diff --git a/CreditStatusImport.php b/CreditStatusImport.php
new file mode 100644
index 0000000..2860e41
--- /dev/null
+++ b/CreditStatusImport.php
@@ -0,0 +1,122 @@
+<?php
+
+/* Loads the credit status, credit limit and next review date of customers from a csv file - used at go live to load
+ * the credit control spreadsheet (the stop list, the limits and the review dates).
+ * Columns: customer code, status, credit limit, next review date (YYYY-MM-DD), reason
+ *  - status is normal, watch or stop (the credit status codes set in the credit control settings) or a credit status code;
+ *    blank leaves the status unchanged
+ *  - a blank credit limit or review date leaves it unchanged
+ * The whole file is checked first and nothing is loaded if any line is wrong. Every change is recorded in the
+ * customer's credit control history with the reason. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Import Customer Credit Status');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditStatusImport';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text"><img src="', $RootPath, '/css/', $Theme, '/images/customer.png" title="', $Title, '" alt="" />', ' ', $Title, '</p>';
+
+$StatusCodes = array('normal' => CreditControlConfig('CreditNormalHoldReason'),
+					'watch' => CreditControlConfig('CreditWatchHoldReason'),
+					'stop' => CreditControlConfig('CreditStopHoldReason'));
+
+if (isset($_POST['Import']) AND isset($_FILES['CSVFile']) AND $_FILES['CSVFile']['name'] != '') {
+	$FileHandle = fopen($_FILES['CSVFile']['tmp_name'], 'r');
+	$Lines = array();
+	$Errors = array();
+	$LineNo = 0;
+	while (($Row = fgetcsv($FileHandle, 10000, ',')) !== false) {
+		$LineNo++;
+		if ($LineNo == 1 AND isset($_POST['HeaderRow'])) {
+			continue;
+		}
+		if (count($Row) < 2 OR trim($Row[0]) == '') {
+			continue;
+		}
+		$DebtorNo = mb_strtoupper(trim($Row[0]));
+		$Status = isset($Row[1]) ? mb_strtolower(trim($Row[1])) : '';
+		$Limit = isset($Row[2]) ? trim($Row[2]) : '';
+		$ReviewDate = isset($Row[3]) ? trim($Row[3]) : '';
+		$Reason = isset($Row[4]) ? trim($Row[4]) : '';
+		$Result = DB_query("SELECT debtorno FROM debtorsmaster WHERE debtorno='" . DB_escape_string($DebtorNo) . "'");
+		if (DB_num_rows($Result) == 0) {
+			$Errors[] = __('Line') . ' ' . $LineNo . ': ' . __('customer') . ' ' . $DebtorNo . ' ' . __('does not exist');
+			continue;
+		}
+		$HoldReason = '';
+		if ($Status != '') {
+			if (isset($StatusCodes[$Status])) {
+				$HoldReason = $StatusCodes[$Status];
+			} else {
+				$Result = DB_query("SELECT reasoncode FROM holdreasons WHERE reasoncode='" . (int)$Status . "'");
+				if (!is_numeric($Status) OR DB_num_rows($Result) == 0) {
+					$Errors[] = __('Line') . ' ' . $LineNo . ': ' . __('the status must be normal, watch, stop or a credit status code');
+					continue;
+				}
+				$HoldReason = (int)$Status;
+			}
+		}
+		if ($Limit != '' AND (!is_numeric($Limit) OR $Limit < 0)) {
+			$Errors[] = __('Line') . ' ' . $LineNo . ': ' . __('the credit limit must be a number of zero or more');
+			continue;
+		}
+		if ($ReviewDate != '' AND (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $ReviewDate) OR !checkdate((int)mb_substr($ReviewDate, 5, 2), (int)mb_substr($ReviewDate, 8, 2), (int)mb_substr($ReviewDate, 0, 4)))) {
+			$Errors[] = __('Line') . ' ' . $LineNo . ': ' . __('the next review date must be in the format YYYY-MM-DD');
+			continue;
+		}
+		$Lines[] = array($DebtorNo, $HoldReason, $Limit, $ReviewDate, $Reason);
+	}
+	fclose($FileHandle);
+
+	if (count($Errors) > 0) {
+		foreach ($Errors as $Error) {
+			prnMsg($Error, 'error');
+		}
+		prnMsg(__('Nothing has been loaded - correct the file and import it again'), 'warn');
+	} else {
+		$Loaded = 0;
+		DB_Txn_Begin();
+		foreach ($Lines as $Line) {
+			list($DebtorNo, $HoldReason, $Limit, $ReviewDate, $Reason) = $Line;
+			$Reason = __('Loaded from the credit control spreadsheet') . ($Reason != '' ? ': ' . $Reason : '');
+			if ($HoldReason !== '') {
+				ChangeCustomerCreditStatus($DebtorNo, $HoldReason, $Reason);
+			}
+			if ($Limit !== '') {
+				ChangeCustomerCreditLimit($DebtorNo, $Limit, $Reason);
+			}
+			if ($ReviewDate !== '') {
+				DB_query("UPDATE debtorsmaster SET nextreviewdate='" . $ReviewDate . "' WHERE debtorno='" . DB_escape_string($DebtorNo) . "'",
+						__('The next review date could not be updated because'), '', true);
+				LogCreditEvent($DebtorNo, 'reviewdate', __('Next review date set to') . ' ' . ConvertSQLDate($ReviewDate), '', $ReviewDate, 0, '', 0, 0, $Reason);
+			}
+			$Loaded++;
+		}
+		DB_Txn_Commit();
+		prnMsg($Loaded . ' ' . __('customers have been updated'), 'success');
+	}
+}
+
+echo '<form method="post" enctype="multipart/form-data" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<div class="page_help_text">', __('The csv file has the columns: customer code, status (normal, watch, stop or a credit status code), credit limit, next review date (YYYY-MM-DD), reason. Blank columns leave the value unchanged'), '</div>
+	<fieldset>
+		<legend>', __('Credit Status File'), '</legend>
+		<field>
+			<label for="CSVFile">', __('CSV File'), ':</label>
+			<input type="file" name="CSVFile" required="required" accept=".csv" />
+		</field>
+		<field>
+			<label for="HeaderRow">', __('First line is a heading'), ':</label>
+			<input type="checkbox" name="HeaderRow" checked="checked" />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Import" value="', __('Import'), '" /></div>
+	</form>';
+
+include('includes/footer.php');
diff --git a/CreditWriteOff.php b/CreditWriteOff.php
new file mode 100644
index 0000000..196927f
--- /dev/null
+++ b/CreditWriteOff.php
@@ -0,0 +1,240 @@
+<?php
+
+/* Bad debt write off. Credit control selects the unpaid items of a customer to write off (all or part) with a reason.
+ * Write offs up to the approval limit (CreditWriteOffApprovalLimit, home currency) are posted straight away;
+ * larger ones wait for approval by a holder of the approvals token (CreditWriteOffApprove.php) and change nothing
+ * until then. Posting creates a type 46 credit in the customer's currency debiting the bad debt account, allocated
+ * to the items written off - any exchange difference against the original invoice rate is realised through the
+ * allocation, as in CustomerAllocations.php. The customer is put on stop unless credit control decides otherwise.
+ * A debt later recovered is recorded as a type 47 debit (credit to the bad debt account) for the receipt to be
+ * allocated against. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Bad Debt Write Off');
+$ViewTopic = 'CreditControl';
+$BookMark = 'BadDebtWriteOff';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text"><img src="', $RootPath, '/css/', $Theme, '/images/money_delete.png" title="', $Title, '" alt="" />', ' ', $Title, '</p>';
+
+if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1 AND CreditControlConfig('CreditBadDebtAct') == '') {
+	prnMsg(__('The bad debt GL account has not been set up in the credit control settings. Write offs cannot be posted until it is'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = trim($_GET['DebtorNo']);
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = trim($_POST['DebtorNo']);
+} elseif (isset($_SESSION['CustomerID']) AND $_SESSION['CustomerID'] != '') {
+	$DebtorNo = $_SESSION['CustomerID'];
+}
+
+if (!isset($DebtorNo) OR $DebtorNo == '' OR GetCustomerCreditPosition($DebtorNo) === false) {
+	echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+		<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+		<fieldset>
+			<legend>', __('Select Customer'), '</legend>
+			<field>
+				<label for="DebtorNo">', __('Customer Code'), ':</label>
+				<input type="text" name="DebtorNo" autofocus="autofocus" required="required" size="11" maxlength="10" />
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Select" value="', __('Select'), '" /></div>
+		</form>';
+	include('includes/footer.php');
+	exit();
+}
+$Position = GetCustomerCreditPosition($DebtorNo);
+$DecimalPlaces = $Position['decimalplaces'];
+$ApprovalLimit = isset($_SESSION['CreditWriteOffApprovalLimit']) ? floatval($_SESSION['CreditWriteOffApprovalLimit']) : 0;
+
+/* ===== Request / post a write off ===== */
+if (isset($_POST['WriteOff'])) {
+	$InputError = 0;
+	$Items = array();
+	$Total = 0;
+	$Result = DB_query("SELECT id, type, transno, balance FROM debtortrans
+						WHERE debtorno='" . $DebtorNo . "' AND settled=0 AND balance>0");
+	while ($MyRow = DB_fetch_array($Result)) {
+		if (isset($_POST['Amount_' . $MyRow['id']]) AND filter_number_format($_POST['Amount_' . $MyRow['id']]) != 0) {
+			$Amount = round(filter_number_format($_POST['Amount_' . $MyRow['id']]), $DecimalPlaces);
+			if (!is_numeric($Amount) OR $Amount < 0 OR $Amount > round($MyRow['balance'], $DecimalPlaces)) {
+				prnMsg(__('The amount to write off against') . ' ' . $MyRow['transno'] . ' ' . __('must be between zero and the amount outstanding'), 'error');
+				$InputError = 1;
+			} elseif ($Amount > 0) {
+				$Items[$MyRow['id']] = $Amount;
+				$Total += $Amount;
+			}
+		}
+	}
+	if ($Total <= 0) {
+		prnMsg(__('Enter the amounts to write off'), 'error');
+		$InputError = 1;
+	}
+	if (trim($_POST['Reason']) == '') {
+		prnMsg(__('A reason must be given for writing off a bad debt'), 'error');
+		$InputError = 1;
+	}
+	if ($InputError == 0) {
+		$HomeAmount = round($Total / $Position['rate'], $_SESSION['CompanyRecord']['decimalplaces']);
+		$PutOnStop = isset($_POST['PutOnStop']) ? 1 : 0;
+		DB_Txn_Begin();
+		DB_query("INSERT INTO creditwriteoffs (debtorno, requestdate, requestedby, amount, currcode, rate, homeamount, reason, putonstop, status)
+					VALUES ('" . $DebtorNo . "', NOW(), '" . $_SESSION['UserID'] . "', '" . $Total . "', '" . $Position['currcode'] . "',
+							'" . $Position['rate'] . "', '" . $HomeAmount . "', '" . $_POST['Reason'] . "', '" . $PutOnStop . "', 0)",
+				__('The write off could not be recorded because'), '', true);
+		$WriteOffID = DB_Last_Insert_ID('creditwriteoffs', 'writeoffid');
+		foreach ($Items as $DebtorTransID => $Amount) {
+			DB_query("INSERT INTO creditwriteoffitems (writeoffid, debtortransid, amount)
+						VALUES ('" . $WriteOffID . "', '" . $DebtorTransID . "', '" . $Amount . "')",
+					__('The write off items could not be recorded because'), '', true);
+		}
+		if ($HomeAmount <= $ApprovalLimit) {
+			$TransNo = PostBadDebtWriteOff($WriteOffID);
+			if ($TransNo === false OR !CreditControlGLBalances(CREDIT_TYPE_WRITEOFF, $TransNo)) {
+				DB_Txn_Rollback();
+				prnMsg(__('The write off could not be posted - nothing has been changed'), 'error');
+			} else {
+				DB_Txn_Commit();
+				prnMsg(__('The bad debt has been written off with transaction') . ' ' . $TransNo, 'success');
+			}
+		} else {
+			LogCreditEvent($DebtorNo, 'writeoffreq', __('Bad debt write off') . ' ' . $WriteOffID . ' ' . __('requested - awaiting approval as it is over the approval limit of') . ' ' . $_SESSION['CompanyRecord']['currencydefault'] . ' ' . $ApprovalLimit,
+							'', 'pending', -$Total, $Position['currcode'], 0, $WriteOffID, $_POST['Reason']);
+			DB_Txn_Commit();
+			prnMsg(__('The write off of') . ' ' . $Position['currcode'] . ' ' . locale_number_format($Total, $DecimalPlaces) . ' (' . $_SESSION['CompanyRecord']['currencydefault'] . ' ' . locale_number_format($HomeAmount, $_SESSION['CompanyRecord']['decimalplaces']) . ') ' .
+					__('is over the approval limit. It has been sent for approval and nothing changes on the customer account until it is approved'), 'warn');
+		}
+		$Position = GetCustomerCreditPosition($DebtorNo);
+	}
+}
+
+/* ===== Record a recovery of a debt written off ===== */
+if (isset($_POST['Recover'])) {
+	$Result = DB_query("SELECT writeoffid, amount, recoveredamount, transno FROM creditwriteoffs
+						WHERE writeoffid='" . (int)$_POST['WriteOffID'] . "' AND debtorno='" . $DebtorNo . "' AND status=1");
+	$WriteOff = DB_fetch_array($Result);
+	$Amount = round(filter_number_format($_POST['RecoverAmount']), $DecimalPlaces);
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('The write off could not be found'), 'error');
+	} elseif (!is_numeric($Amount) OR $Amount <= 0 OR $Amount > round($WriteOff['amount'] - $WriteOff['recoveredamount'], $DecimalPlaces)) {
+		prnMsg(__('The amount recovered must be more than zero and no more than the amount written off and not yet recovered'), 'error');
+	} else {
+		$Narrative = __('Bad debt recovered') . ' - ' . __('write off') . ' ' . $WriteOff['writeoffid'] . ' (' . $WriteOff['transno'] . ')';
+		DB_Txn_Begin();
+		list($TransNo, $DebtorTransID, $PeriodNo) = PostCreditControlTransaction($DebtorNo, CREDIT_TYPE_RECOVERY, $Amount, $Position['rate'], date('Y-m-d'),
+																			__('Recovery') . ' ' . $WriteOff['writeoffid'], $Narrative, CreditControlConfig('CreditBadDebtAct'));
+		DB_query("UPDATE creditwriteoffs SET recoveredamount=recoveredamount+" . $Amount . " WHERE writeoffid='" . (int)$_POST['WriteOffID'] . "'",
+				__('The write off could not be updated because'), '', true);
+		LogCreditEvent($DebtorNo, 'recovery', $Narrative, '', '', $Amount, $Position['currcode'], CREDIT_TYPE_RECOVERY, $TransNo);
+		DB_Txn_Commit();
+		prnMsg(__('The recovery has been recorded as transaction') . ' ' . $TransNo . '. ' . __('Allocate the receipt from the customer against it'), 'success');
+	}
+}
+
+ShowCreditStatusWarnings($DebtorNo);
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<input type="hidden" name="DebtorNo" value="', $DebtorNo, '" />
+	<table class="selection">
+		<tr><th colspan="6">', $DebtorNo, ' - ', htmlspecialchars($Position['name'], ENT_QUOTES, 'UTF-8', false), ' - ', __('Unpaid Items'), ' (', $Position['currcode'], ')</th></tr>
+		<tr>
+			<th>', __('Type'), '</th>
+			<th>', __('Number'), '</th>
+			<th>', __('Date'), '</th>
+			<th>', __('Reference'), '</th>
+			<th>', __('Outstanding'), '</th>
+			<th>', __('Write Off'), '</th>
+		</tr>';
+$Result = DB_query("SELECT debtortrans.id, systypes.typename, debtortrans.transno, debtortrans.trandate, debtortrans.reference, debtortrans.balance
+					FROM debtortrans INNER JOIN systypes ON debtortrans.type=systypes.typeid
+					WHERE debtortrans.debtorno='" . $DebtorNo . "'
+						AND debtortrans.settled=0
+						AND debtortrans.balance>0
+					ORDER BY debtortrans.trandate, debtortrans.transno");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>', __($MyRow['typename']), '</td>
+			<td class="number">', $MyRow['transno'], '</td>
+			<td class="date">', ConvertSQLDate($MyRow['trandate']), '</td>
+			<td>', $MyRow['reference'], '</td>
+			<td class="number">', locale_number_format($MyRow['balance'], $DecimalPlaces), '</td>
+			<td><input type="text" class="number" name="Amount_', $MyRow['id'], '" size="12" maxlength="14" value="0" /></td>
+		</tr>';
+}
+echo '</table>
+	<fieldset>
+		<legend>', __('Write Off'), '</legend>
+		<field>
+			<label for="Reason">', __('Reason'), ':</label>
+			<input type="text" name="Reason" size="60" maxlength="250" />
+		</field>
+		<field>
+			<label for="PutOnStop">', __('Put the customer on stop'), ':</label>
+			<input type="checkbox" name="PutOnStop" checked="checked" />
+			<fieldhelp>', __('Customers who have a debt written off are put on stop unless credit control decides otherwise'), '</fieldhelp>
+		</field>
+		<field>
+			<label>', __('Approval'), ':</label>
+			<fieldtext>', __('Write offs over'), ' ', $_SESSION['CompanyRecord']['currencydefault'], ' ', locale_number_format($ApprovalLimit, $_SESSION['CompanyRecord']['decimalplaces']), ' ', __('need approval before they are posted'), '</fieldtext>
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="WriteOff" value="', __('Write Off'), '" onclick="return confirm(\'', __('Write off the amounts entered as a bad debt?'), '\');" /></div>
+	</form>';
+
+/* ===== Write offs of this customer ===== */
+$Result = DB_query("SELECT writeoffid, requestdate, requestedby, amount, currcode, reason, status, approvedby, approveddate, rejectreason, transno, recoveredamount
+					FROM creditwriteoffs WHERE debtorno='" . $DebtorNo . "' ORDER BY requestdate DESC");
+if (DB_num_rows($Result) > 0) {
+	echo '<table class="selection">
+			<tr><th colspan="8">', __('Write Offs For This Customer'), '</th></tr>
+			<tr>
+				<th>', __('Requested'), '</th>
+				<th>', __('By'), '</th>
+				<th>', __('Amount'), '</th>
+				<th>', __('Reason'), '</th>
+				<th>', __('Status'), '</th>
+				<th>', __('Approved By'), '</th>
+				<th>', __('Recovered'), '</th>
+				<th></th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		if ($MyRow['status'] == 0) {
+			$Status = __('Awaiting approval');
+		} elseif ($MyRow['status'] == 1) {
+			$Status = __('Posted') . ' ' . $MyRow['transno'];
+		} else {
+			$Status = __('Rejected') . ': ' . $MyRow['rejectreason'];
+		}
+		echo '<tr class="striped_row">
+				<td>', ConvertSQLDateTime($MyRow['requestdate']), '</td>
+				<td>', $MyRow['requestedby'], '</td>
+				<td class="number">', $MyRow['currcode'], ' ', locale_number_format($MyRow['amount'], $DecimalPlaces), '</td>
+				<td>', $MyRow['reason'], '</td>
+				<td>', $Status, '</td>
+				<td>', $MyRow['approvedby'], '</td>
+				<td class="number">', locale_number_format($MyRow['recoveredamount'], $DecimalPlaces), '</td>
+				<td>';
+		if ($MyRow['status'] == 1 AND $MyRow['recoveredamount'] < $MyRow['amount']) {
+			echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+					<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+					<input type="hidden" name="DebtorNo" value="', $DebtorNo, '" />
+					<input type="hidden" name="WriteOffID" value="', $MyRow['writeoffid'], '" />
+					<input type="text" class="number" name="RecoverAmount" size="10" maxlength="14" />
+					<input type="submit" name="Recover" value="', __('Record Recovery'), '" />
+				</form>';
+		}
+		echo '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/CreditWriteOffApprove.php b/CreditWriteOffApprove.php
new file mode 100644
index 0000000..ec4b461
--- /dev/null
+++ b/CreditWriteOffApprove.php
@@ -0,0 +1,112 @@
+<?php
+
+/* Approval of bad debt write offs over the approval limit - for the holders of the credit control approvals token
+ * (the Finance Director). A write off cannot be approved by the person who requested it. Nothing is posted until
+ * the write off is approved. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Approve Bad Debt Write Offs');
+$ViewTopic = 'CreditControl';
+$BookMark = 'BadDebtWriteOff';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text"><img src="', $RootPath, '/css/', $Theme, '/images/money_delete.png" title="', $Title, '" alt="" />', ' ', $Title, '</p>';
+
+if (isset($_POST['Approve']) OR isset($_POST['Reject'])) {
+	$Result = DB_query("SELECT writeoffid, debtorno, requestedby, amount, currcode, status FROM creditwriteoffs
+						WHERE writeoffid='" . (int)$_POST['WriteOffID'] . "'");
+	$WriteOff = DB_fetch_array($Result);
+	if (DB_num_rows($Result) == 0 OR $WriteOff['status'] != 0) {
+		prnMsg(__('This write off is no longer awaiting approval'), 'error');
+	} elseif ($WriteOff['requestedby'] == $_SESSION['UserID']) {
+		prnMsg(__('A write off cannot be approved or rejected by the person who requested it'), 'error');
+	} elseif (isset($_POST['Approve'])) {
+		if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1 AND CreditControlConfig('CreditBadDebtAct') == '') {
+			prnMsg(__('The bad debt GL account has not been set up in the credit control settings'), 'error');
+		} else {
+			DB_Txn_Begin();
+			DB_query("UPDATE creditwriteoffs SET approvedby='" . $_SESSION['UserID'] . "', approveddate=NOW()
+						WHERE writeoffid='" . (int)$_POST['WriteOffID'] . "'", __('The write off could not be approved because'), '', true);
+			$TransNo = PostBadDebtWriteOff((int)$_POST['WriteOffID']);
+			if ($TransNo === false OR !CreditControlGLBalances(CREDIT_TYPE_WRITEOFF, $TransNo)) {
+				DB_Txn_Rollback();
+				prnMsg(__('The write off could not be posted - the items may have been paid since it was requested. Nothing has been changed'), 'error');
+			} else {
+				DB_Txn_Commit();
+				prnMsg(__('The write off has been approved and posted as transaction') . ' ' . $TransNo, 'success');
+			}
+		}
+	} else {
+		if (trim($_POST['RejectReason']) == '') {
+			prnMsg(__('A reason must be given for rejecting a write off'), 'error');
+		} else {
+			DB_Txn_Begin();
+			DB_query("UPDATE creditwriteoffs SET status=2, approvedby='" . $_SESSION['UserID'] . "', approveddate=NOW(), rejectreason='" . $_POST['RejectReason'] . "'
+						WHERE writeoffid='" . (int)$_POST['WriteOffID'] . "'", __('The write off could not be rejected because'), '', true);
+			LogCreditEvent($WriteOff['debtorno'], 'writeoffrej', __('Bad debt write off') . ' ' . $WriteOff['writeoffid'] . ' ' . __('rejected'), 'pending', 'rejected',
+							-$WriteOff['amount'], $WriteOff['currcode'], 0, $WriteOff['writeoffid'], $_POST['RejectReason']);
+			DB_Txn_Commit();
+			prnMsg(__('The write off has been rejected'), 'success');
+		}
+	}
+}
+
+$Result = DB_query("SELECT creditwriteoffs.writeoffid, creditwriteoffs.debtorno, debtorsmaster.name, creditwriteoffs.requestdate,
+							creditwriteoffs.requestedby, creditwriteoffs.amount, creditwriteoffs.currcode, creditwriteoffs.homeamount,
+							creditwriteoffs.reason, creditwriteoffs.putonstop, currencies.decimalplaces
+					FROM creditwriteoffs
+					INNER JOIN debtorsmaster ON creditwriteoffs.debtorno=debtorsmaster.debtorno
+					INNER JOIN currencies ON creditwriteoffs.currcode=currencies.currabrev
+					WHERE creditwriteoffs.status=0
+					ORDER BY creditwriteoffs.requestdate");
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('There are no write offs awaiting approval'), 'info');
+} else {
+	echo '<table class="selection">
+			<tr>
+				<th>', __('Customer'), '</th>
+				<th>', __('Requested'), '</th>
+				<th>', __('By'), '</th>
+				<th>', __('Amount'), '</th>
+				<th>', __('Home Currency'), '</th>
+				<th>', __('Reason'), '</th>
+				<th>', __('Items'), '</th>
+				<th></th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Items = '';
+		$ItemResult = DB_query("SELECT systypes.typename, debtortrans.transno, creditwriteoffitems.amount
+								FROM creditwriteoffitems
+								INNER JOIN debtortrans ON creditwriteoffitems.debtortransid=debtortrans.id
+								INNER JOIN systypes ON debtortrans.type=systypes.typeid
+								WHERE creditwriteoffitems.writeoffid='" . $MyRow['writeoffid'] . "'");
+		while ($ItemRow = DB_fetch_array($ItemResult)) {
+			$Items .= __($ItemRow['typename']) . ' ' . $ItemRow['transno'] . ': ' . locale_number_format($ItemRow['amount'], $MyRow['decimalplaces']) . '<br />';
+		}
+		echo '<tr class="striped_row">
+				<td><a href="', $RootPath, '/CreditControl.php?DebtorNo=', urlencode($MyRow['debtorno']), '" target="_blank">', $MyRow['debtorno'], ' - ', htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8', false), '</a></td>
+				<td>', ConvertSQLDateTime($MyRow['requestdate']), '</td>
+				<td>', $MyRow['requestedby'], '</td>
+				<td class="number">', $MyRow['currcode'], ' ', locale_number_format($MyRow['amount'], $MyRow['decimalplaces']), '</td>
+				<td class="number">', locale_number_format($MyRow['homeamount'], $_SESSION['CompanyRecord']['decimalplaces']), '</td>
+				<td>', $MyRow['reason'], ($MyRow['putonstop'] ? '<br />' . __('Customer to be put on stop') : ''), '</td>
+				<td>', $Items, '</td>
+				<td>
+					<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+						<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+						<input type="hidden" name="WriteOffID" value="', $MyRow['writeoffid'], '" />
+						<input type="submit" name="Approve" value="', __('Approve'), '" onclick="return confirm(\'', __('Approve and post this write off?'), '\');" /><br />
+						<input type="text" name="RejectReason" size="20" maxlength="250" placeholder="', __('Reason for rejection'), '" />
+						<input type="submit" name="Reject" value="', __('Reject'), '" />
+					</form>
+				</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/CreditWriteOffReport.php b/CreditWriteOffReport.php
new file mode 100644
index 0000000..ab3c037
--- /dev/null
+++ b/CreditWriteOffReport.php
@@ -0,0 +1,117 @@
+<?php
+
+/* Bad debt write offs over a period - customer, amount, reason, who requested and who approved */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Bad Debt Write Off Report');
+$ViewTopic = 'CreditControl';
+$BookMark = 'WriteOffReport';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="', $RootPath, '/css/', $Theme, '/images/reports.png" title="', $Title, '" alt="" />', ' ', $Title, '</p>';
+
+if (!isset($_POST['FromDate'])) {
+	$_POST['FromDate'] = date('Y-m-d', mktime(0, 0, 0, date('m') - 12, date('d'), date('Y')));
+}
+if (!isset($_POST['ToDate'])) {
+	$_POST['ToDate'] = date('Y-m-d');
+}
+if (!isset($_POST['Status'])) {
+	$_POST['Status'] = 'All';
+}
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '" class="noPrint">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Report Criteria'), '</legend>
+		<field>
+			<label for="FromDate">', __('Requested From'), ':</label>
+			<input type="date" name="FromDate" required="required" value="', $_POST['FromDate'], '" />
+		</field>
+		<field>
+			<label for="ToDate">', __('Requested To'), ':</label>
+			<input type="date" name="ToDate" required="required" value="', $_POST['ToDate'], '" />
+		</field>
+		<field>
+			<label for="Status">', __('Status'), ':</label>
+			<select name="Status">';
+foreach (array('All' => __('All'), '1' => __('Posted'), '0' => __('Awaiting approval'), '2' => __('Rejected')) as $Code => $Text) {
+	echo '<option ', ($_POST['Status'] == $Code ? 'selected="selected" ' : ''), 'value="', $Code, '">', $Text, '</option>';
+}
+echo '</select>
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="View" value="', __('Show Write Offs'), '" /></div>
+	</form>';
+
+if (isset($_POST['View'])) {
+	$SQL = "SELECT creditwriteoffs.writeoffid,
+					creditwriteoffs.debtorno,
+					debtorsmaster.name,
+					creditwriteoffs.requestdate,
+					creditwriteoffs.requestedby,
+					creditwriteoffs.amount,
+					creditwriteoffs.currcode,
+					creditwriteoffs.homeamount,
+					creditwriteoffs.reason,
+					creditwriteoffs.status,
+					creditwriteoffs.approvedby,
+					creditwriteoffs.approveddate,
+					creditwriteoffs.rejectreason,
+					creditwriteoffs.transno,
+					creditwriteoffs.recoveredamount,
+					currencies.decimalplaces
+				FROM creditwriteoffs
+				INNER JOIN debtorsmaster ON creditwriteoffs.debtorno=debtorsmaster.debtorno
+				INNER JOIN currencies ON creditwriteoffs.currcode=currencies.currabrev
+				WHERE creditwriteoffs.requestdate >= '" . $_POST['FromDate'] . "'
+					AND creditwriteoffs.requestdate < DATE_ADD('" . $_POST['ToDate'] . "', INTERVAL 1 DAY)";
+	if ($_POST['Status'] != 'All') {
+		$SQL .= " AND creditwriteoffs.status='" . (int)$_POST['Status'] . "'";
+	}
+	$SQL .= " ORDER BY creditwriteoffs.requestdate";
+	$Result = DB_query($SQL);
+	echo '<table class="selection">
+			<tr>

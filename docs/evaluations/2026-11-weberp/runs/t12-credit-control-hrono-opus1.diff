+UpdateField('scripts', 'pagesecurity', '21', "script='CreditStatus.php'");
+
+/* Hold reasons used by credit control - reuse existing watch and stop reasons if the company already has them */
+$Result = DB_query("SELECT reasoncode FROM holdreasons WHERE dissallowinvoices=2 ORDER BY reasoncode");
+if (DB_num_rows($Result) > 0) {
+	$MyRow = DB_fetch_array($Result);
+	$WatchReason = $MyRow['reasoncode'];
+} else {
+	$Result = DB_query("SELECT reasoncode FROM holdreasons WHERE reasoncode=90");
+	$WatchReason = (DB_num_rows($Result) == 0) ? 90 : 98;
+	InsertRecord('holdreasons', array('reasoncode'), array($WatchReason), array('reasoncode', 'reasondescription', 'dissallowinvoices'), array($WatchReason, 'Watch - credit control', 2));
+}
+$Result = DB_query("SELECT reasoncode FROM holdreasons WHERE dissallowinvoices=1 ORDER BY reasoncode");
+if (DB_num_rows($Result) > 0) {
+	$MyRow = DB_fetch_array($Result);
+	$StopReason = $MyRow['reasoncode'];
+} else {
+	$Result = DB_query("SELECT reasoncode FROM holdreasons WHERE reasoncode=91");
+	$StopReason = (DB_num_rows($Result) == 0) ? 91 : 99;
+	InsertRecord('holdreasons', array('reasoncode'), array($StopReason), array('reasoncode', 'reasondescription', 'dissallowinvoices'), array($StopReason, 'On stop - credit control', 1));
+}
+$Result = DB_query("SELECT reasoncode FROM holdreasons WHERE dissallowinvoices NOT IN (1,2) ORDER BY reasoncode");
+if (DB_num_rows($Result) > 0) {
+	$MyRow = DB_fetch_array($Result);
+	$NormalReason = $MyRow['reasoncode'];
+} else {
+	$Result = DB_query("SELECT reasoncode FROM holdreasons WHERE reasoncode=0");
+	$NormalReason = (DB_num_rows($Result) == 0) ? 0 : 97;
+	InsertRecord('holdreasons', array('reasoncode'), array($NormalReason), array('reasoncode', 'reasondescription', 'dissallowinvoices'), array($NormalReason, 'Normal account', 0));
+}
+

diff --git a/CreditCharges.php b/CreditCharges.php
new file mode 100644
index 0000000..689e424
--- /dev/null
+++ b/CreditCharges.php
@@ -0,0 +1,300 @@
+<?php
+
+/* Month end interest and late payment fees.
+ * For the month selected, customers with undisputed items overdue by at least CreditChargeDaysOverdue days at the
+ * month end are charged, in their own currency:
+ *   interest = overdue balance (net of unallocated payments and credits, excluding interest and fees already charged -
+ *              no interest on interest) x annual rate / 12
+ *   late fee = the fixed fee set in home currency, converted at the customer's currency rate - one per customer per month
+ * Exempt customers are not charged. Each charge is a separate customer transaction (type 13 interest, 14 fee) posted to
+ * the debtors control and the income account chosen by Finance. A month cannot be charged twice for a customer
+ * (creditcharges has a unique key on customer, period and charge type).
+ * Credit control can waive a charge with a reason - a type 45 credit at the charge's own rate, allocated to the
+ * charge and reversed out of the same income account. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Month End Interest and Late Fees');
+$ViewTopic = 'CreditControl';
+$BookMark = 'MonthEndCharges';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text"><img src="', $RootPath, '/css/', $Theme, '/images/money_add.png" title="', $Title, '" alt="" />', ' ', $Title, '</p>';
+
+$InterestRate = isset($_SESSION['CreditInterestRate']) ? floatval($_SESSION['CreditInterestRate']) : 0;
+$LateFee = isset($_SESSION['CreditLateFee']) ? floatval($_SESSION['CreditLateFee']) : 0;
+$ChargeDays = isset($_SESSION['CreditChargeDaysOverdue']) ? (int)$_SESSION['CreditChargeDaysOverdue'] : 30;
+
+/* the GL account codes are read as text - see CreditControlConfig() */
+$InterestAct = CreditControlConfig('CreditInterestAct');
+$FeeAct = CreditControlConfig('CreditFeeAct');
+
+$ConfigError = false;
+if ($InterestRate <= 0 AND $LateFee <= 0) {
+	prnMsg(__('No interest rate or late fee has been set up. Finance sets these in the credit control settings'), 'warn');
+	$ConfigError = true;
+}
+if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+	if ($InterestRate > 0 AND $InterestAct == '') {
+		prnMsg(__('The GL account for interest income has not been set up in the credit control settings'), 'error');
+		$ConfigError = true;
+	}
+	if ($LateFee > 0 AND $FeeAct == '') {
+		prnMsg(__('The GL account for late fee income has not been set up in the credit control settings'), 'error');
+		$ConfigError = true;
+	}
+}
+
+/* Calculates the charges due to every customer for the period - returns an array of proposed charges */
+function ProposeCharges($PeriodNo, $PeriodEnd, $InterestRate, $LateFee, $ChargeDays) {
+	$Proposals = array();
+	$Result = DB_query("SELECT DISTINCT debtorsmaster.debtorno,
+									debtorsmaster.name,
+									debtorsmaster.currcode,
+									debtorsmaster.interestexempt,
+									debtorsmaster.feeexempt,
+									currencies.rate,
+									currencies.decimalplaces
+						FROM debtorsmaster
+						INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+						INNER JOIN debtortrans ON debtortrans.debtorno=debtorsmaster.debtorno
+						WHERE debtortrans.settled=0
+							AND debtortrans.balance>0
+							AND debtortrans.trandate<='" . $PeriodEnd . "'
+						ORDER BY debtorsmaster.debtorno");
+	while ($Customer = DB_fetch_array($Result)) {
+		if ($Customer['interestexempt'] == 1 AND $Customer['feeexempt'] == 1) {
+			continue;
+		}
+		$Overdue = GetOverdueItems($Customer['debtorno'], $PeriodEnd, $ChargeDays, true);
+		$Tolerance = pow(10, -$Customer['decimalplaces']);
+		if ($Overdue['net'] < $Tolerance) {
+			continue;
+		}
+		$Charged = array();
+		$ChargedResult = DB_query("SELECT chargetype FROM creditcharges
+									WHERE debtorno='" . DB_escape_string($Customer['debtorno']) . "'
+										AND periodno='" . $PeriodNo . "'");
+		while ($MyRow = DB_fetch_array($ChargedResult)) {
+			$Charged[] = $MyRow['chargetype'];
+		}
+		if ($InterestRate > 0 AND $Customer['interestexempt'] == 0 AND !in_array('interest', $Charged)) {
+			$Amount = round($Overdue['net'] * $InterestRate / 100 / 12, $Customer['decimalplaces']);
+			if ($Amount >= $Tolerance) {
+				$Proposals[] = array('customer' => $Customer, 'type' => 'interest', 'basis' => $Overdue['net'], 'rate' => $InterestRate, 'amount' => $Amount);
+			}
+		}
+		if ($LateFee > 0 AND $Customer['feeexempt'] == 0 AND !in_array('fee', $Charged)) {
+			$Amount = round($LateFee * $Customer['rate'], $Customer['decimalplaces']);
+			if ($Amount >= $Tolerance) {
+				$Proposals[] = array('customer' => $Customer, 'type' => 'fee', 'basis' => $Overdue['net'], 'rate' => 0, 'amount' => $Amount);
+			}
+		}
+	}
+	return $Proposals;
+}
+
+/* ===== Waive a charge ===== */
+if (isset($_POST['Waive'])) {
+	$Result = DB_query("SELECT creditcharges.chargeid, creditcharges.debtorno, creditcharges.chargetype, creditcharges.transno,
+								creditcharges.debtortransid, creditcharges.currcode, creditcharges.waived,
+								debtortrans.rate, debtortrans.balance
+						FROM creditcharges INNER JOIN debtortrans
+							ON creditcharges.debtortransid=debtortrans.id
+						WHERE creditcharges.chargeid='" . (int)$_POST['ChargeID'] . "'");
+	$Charge = DB_fetch_array($Result);
+	if (DB_num_rows($Result) == 0 OR $Charge['waived'] == 1) {
+		prnMsg(__('The charge could not be found or has already been waived'), 'error');
+	} elseif (trim($_POST['WaiveReason']) == '') {
+		prnMsg(__('A reason must be given for waiving a charge'), 'error');
+	} elseif ($Charge['balance'] <= 0) {
+		prnMsg(__('This charge has already been paid - it cannot be waived. A credit note should be raised instead if the customer is to be refunded'), 'error');
+	} else {
+		$GLAccount = ($Charge['chargetype'] == 'interest') ? $InterestAct : $FeeAct;
+		$Narrative = __('Waiver of') . ' ' . ($Charge['chargetype'] == 'interest' ? __('interest charge') : __('late payment fee')) . ' ' . $Charge['transno'] . ' - ' . $_POST['WaiveReason'];
+		DB_Txn_Begin();
+		/* at the charge's own rate so the reversal exactly reverses the charge in the ledger */
+		list($WaiveTransNo, $WaiveTransID, $PeriodNo) = PostCreditControlTransaction($Charge['debtorno'], CREDIT_TYPE_WAIVER, -$Charge['balance'], $Charge['rate'],
+																				date('Y-m-d'), __('Waiver') . ' ' . $Charge['transno'], $Narrative, $GLAccount);
+		AllocateCreditControlTransaction($WaiveTransID, $Charge['debtortransid'], $Charge['balance']);
+		if (!CreditControlGLBalances(CREDIT_TYPE_WAIVER, $WaiveTransNo)) {
+			DB_Txn_Rollback();
+			prnMsg(__('The general ledger entries of the waiver do not balance - nothing has been posted'), 'error');
+		} else {
+			DB_query("UPDATE creditcharges SET waived=1, waivedby='" . $_SESSION['UserID'] . "', waiveddate=NOW(),
+											waivereason='" . $_POST['WaiveReason'] . "', waivetransno='" . $WaiveTransNo . "'
+						WHERE chargeid='" . (int)$_POST['ChargeID'] . "'", __('The charge could not be updated because'), '', true);
+			LogCreditEvent($Charge['debtorno'], 'waiver', $Narrative, '', '', -$Charge['balance'], $Charge['currcode'], CREDIT_TYPE_WAIVER, $WaiveTransNo, $_POST['WaiveReason']);
+			DB_Txn_Commit();
+			prnMsg(__('The charge has been waived with credit') . ' ' . $WaiveTransNo, 'success');
+		}
+	}
+}
+
+/* ===== Period selection - defaults to the last month ended ===== */
+if (!isset($_POST['PeriodNo'])) {
+	$Result = DB_query("SELECT periodno FROM periods WHERE lastdate_in_period < CURRENT_DATE ORDER BY periodno DESC LIMIT 1");
+	$MyRow = DB_fetch_row($Result);
+	$_POST['PeriodNo'] = $MyRow[0];
+}
+$Result = DB_query("SELECT lastdate_in_period FROM periods WHERE periodno='" . (int)$_POST['PeriodNo'] . "'");
+$MyRow = DB_fetch_row($Result);
+$PeriodEnd = $MyRow[0];
+
+/* ===== Post the charges confirmed ===== */
+if (isset($_POST['PostCharges']) AND !$ConfigError) {
+	if ($PeriodEnd >= date('Y-m-d')) {
+		prnMsg(__('Charges can only be posted for a month that has ended'), 'error');
+	} else {
+		$Proposals = ProposeCharges((int)$_POST['PeriodNo'], $PeriodEnd, $InterestRate, $LateFee, $ChargeDays);
+		$Posted = 0;
+		foreach ($Proposals as $Proposal) {
+			$Customer = $Proposal['customer'];
+			if (!isset($_POST['Charge_' . $Customer['debtorno'] . '_' . $Proposal['type']])) {
+				continue; /* left out by credit control */
+			}
+			if ($Proposal['type'] == 'interest') {
+				$Type = CREDIT_TYPE_INTEREST;
+				$GLAccount = $InterestAct;
+				$Narrative = __('Interest on overdue balance of') . ' ' . $Customer['currcode'] . ' ' . locale_number_format($Proposal['basis'], $Customer['decimalplaces']) . ' ' .
+							__('for') . ' ' . MonthAndYearFromSQLDate($PeriodEnd) . ' ' . __('at') . ' ' . $Proposal['rate'] . '% ' . __('per annum');
+			} else {
+				$Type = CREDIT_TYPE_FEE;
+				$GLAccount = $FeeAct;
+				$Narrative = __('Late payment fee for') . ' ' . MonthAndYearFromSQLDate($PeriodEnd);
+			}
+			DB_Txn_Begin();
+			list($TransNo, $DebtorTransID, $PostedPeriod) = PostCreditControlTransaction($Customer['debtorno'], $Type, $Proposal['amount'], $Customer['rate'],
+																					$PeriodEnd, MonthAndYearFromSQLDate($PeriodEnd), $Narrative, $GLAccount);
+			DB_query("INSERT INTO creditcharges (debtorno, periodno, chargetype, chargedate, basisamount, rate, amount, currcode,
+												transtype, transno, debtortransid, userid)
+						VALUES ('" . DB_escape_string($Customer['debtorno']) . "',
+								'" . (int)$_POST['PeriodNo'] . "',
+								'" . $Proposal['type'] . "',
+								'" . $PeriodEnd . "',
+								'" . $Proposal['basis'] . "',
+								'" . $Proposal['rate'] . "',
+								'" . $Proposal['amount'] . "',
+								'" . $Customer['currcode'] . "',
+								'" . $Type . "',
+								'" . $TransNo . "',
+								'" . $DebtorTransID . "',
+								'" . $_SESSION['UserID'] . "')",
+					__('The charge could not be recorded - it may already have been charged for this month'), '', true);
+			if (!CreditControlGLBalances($Type, $TransNo)) {
+				DB_Txn_Rollback();
+				prnMsg(__('The general ledger entries for the charge to') . ' ' . $Customer['debtorno'] . ' ' . __('do not balance - it has not been posted'), 'error');
+				continue;
+			}
+			LogCreditEvent($Customer['debtorno'], ($Proposal['type'] == 'interest' ? 'interest' : 'fee'), $Narrative, '', '', $Proposal['amount'], $Customer['currcode'], $Type, $TransNo);
+			DB_Txn_Commit();
+			$Posted++;
+		}
+		prnMsg($Posted . ' ' . __('charges have been posted for') . ' ' . MonthAndYearFromSQLDate($PeriodEnd), 'success');
+	}
+}
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Charge Month'), '</legend>
+		<field>
+			<label for="PeriodNo">', __('Month End'), ':</label>
+			<select name="PeriodNo">';
+$Result = DB_query("SELECT periodno, lastdate_in_period FROM periods WHERE lastdate_in_period < CURRENT_DATE ORDER BY periodno DESC LIMIT 24");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option ', ($MyRow['periodno'] == $_POST['PeriodNo'] ? 'selected="selected" ' : ''), 'value="', $MyRow['periodno'], '">', MonthAndYearFromSQLDate($MyRow['lastdate_in_period']), '</option>';
+}
+echo '</select>
+		</field>
+		<field>
+			<label>', __('Settings'), ':</label>
+			<fieldtext>', __('Interest'), ' ', $InterestRate, '% ', __('per annum'), ', ', __('late fee'), ' ', $_SESSION['CompanyRecord']['currencydefault'], ' ', $LateFee, ', ',
+				__('charged when items are at least'), ' ', $ChargeDays, ' ', __('days overdue at the month end'), '</fieldtext>
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Preview" value="', __('Preview Charges'), '" /></div>';
+
+if (isset($_POST['Preview']) AND !$ConfigError) {
+	$Proposals = ProposeCharges((int)$_POST['PeriodNo'], $PeriodEnd, $InterestRate, $LateFee, $ChargeDays);
+	echo '<table class="selection">
+			<tr><th colspan="6">', __('Charges to be posted for'), ' ', MonthAndYearFromSQLDate($PeriodEnd), '</th></tr>
+			<tr>
+				<th>', __('Charge'), '</th>
+				<th>', __('Customer'), '</th>
+				<th>', __('Type'), '</th>
+				<th>', __('Overdue Balance'), '</th>
+				<th>', __('Amount'), '</th>
+				<th>', __('Home Currency'), '</th>
+			</tr>';
+	$HomeTotal = 0;
+	foreach ($Proposals as $Proposal) {
+		$Customer = $Proposal['customer'];
+		$HomeAmount = $Proposal['amount'] / $Customer['rate'];
+		$HomeTotal += $HomeAmount;
+		echo '<tr class="striped_row">
+				<td class="centre"><input type="checkbox" name="Charge_', $Customer['debtorno'], '_', $Proposal['type'], '" checked="checked" /></td>
+				<td>', $Customer['debtorno'], ' - ', htmlspecialchars($Customer['name'], ENT_QUOTES, 'UTF-8', false), '</td>
+				<td>', ($Proposal['type'] == 'interest' ? __('Interest') : __('Late fee')), '</td>
+				<td class="number">', locale_number_format($Proposal['basis'], $Customer['decimalplaces']), '</td>
+				<td class="number">', $Customer['currcode'], ' ', locale_number_format($Proposal['amount'], $Customer['decimalplaces']), '</td>
+				<td class="number">', locale_number_format($HomeAmount, $_SESSION['CompanyRecord']['decimalplaces']), '</td>
+			</tr>';
+	}
+	echo '<tr class="total_row"><td colspan="5">', __('Total'), '</td><td class="number">', locale_number_format($HomeTotal, $_SESSION['CompanyRecord']['decimalplaces']), '</td></tr>
+		</table>';
+	if (count($Proposals) > 0) {
+		echo '<div class="centre"><input type="submit" name="PostCharges" value="', __('Post Charges'), '" onclick="return confirm(\'', __('Post the charges ticked to the customer accounts and the general ledger?'), '\');" /></div>';
+	} else {
+		prnMsg(__('There are no charges to post for this month - customers already charged for the month are not charged again'), 'info');
+	}
+}
+echo '</form>';
+
+/* ===== Charges of the month, with waiver ===== */
+$Result = DB_query("SELECT creditcharges.chargeid, creditcharges.debtorno, debtorsmaster.name, creditcharges.chargetype, creditcharges.transno,
+							creditcharges.amount, creditcharges.currcode, creditcharges.waived, creditcharges.waivedby, creditcharges.waivereason,
+							currencies.decimalplaces
+					FROM creditcharges
+					INNER JOIN debtorsmaster ON creditcharges.debtorno=debtorsmaster.debtorno
+					INNER JOIN currencies ON creditcharges.currcode=currencies.currabrev
+					WHERE creditcharges.periodno='" . (int)$_POST['PeriodNo'] . "'
+					ORDER BY creditcharges.debtorno, creditcharges.chargetype");
+if (DB_num_rows($Result) > 0) {
+	echo '<table class="selection">
+			<tr><th colspan="6">', __('Charges Posted For'), ' ', MonthAndYearFromSQLDate($PeriodEnd), '</th></tr>
+			<tr>
+				<th>', __('Customer'), '</th>
+				<th>', __('Type'), '</th>
+				<th>', __('Number'), '</th>
+				<th>', __('Amount'), '</th>
+				<th>', __('Waived'), '</th>
+				<th></th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>', $MyRow['debtorno'], ' - ', htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8', false), '</td>
+				<td>', ($MyRow['chargetype'] == 'interest' ? __('Interest') : __('Late fee')), '</td>
+				<td class="number">', $MyRow['transno'], '</td>
+				<td class="number">', $MyRow['currcode'], ' ', locale_number_format($MyRow['amount'], $MyRow['decimalplaces']), '</td>
+				<td>', ($MyRow['waived'] ? $MyRow['waivedby'] . ': ' . $MyRow['waivereason'] : ''), '</td>
+				<td>';
+		if ($MyRow['waived'] == 0) {
+			echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+					<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+					<input type="hidden" name="PeriodNo" value="', (int)$_POST['PeriodNo'], '" />
+					<input type="hidden" name="ChargeID" value="', $MyRow['chargeid'], '" />
+					<input type="text" name="WaiveReason" size="25" maxlength="250" placeholder="', __('Reason'), '" />
+					<input type="submit" name="Waive" value="', __('Waive'), '" />
+				</form>';
+		}
+		echo '</td>
+			</tr>';
+	}
+	echo '</table>';
+}

diff --git a/DunningLetter.php b/DunningLetter.php
new file mode 100644
index 0000000..ff6825d
--- /dev/null
+++ b/DunningLetter.php
@@ -0,0 +1,75 @@
+<?php
+
+/* Shows a reminder letter that has been sent, for printing and posting or for the customer to view in the portal.
+ * A customer login can only see its own letters, a sales rep only the letters of their own customers. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Reminder Letter');
+$ViewTopic = 'CreditControl';
+$BookMark = 'ReminderRun';
+include('includes/header.php');
+
+include('includes/CreditControlFunctions.php');
+
+if (!isset($_GET['LetterID'])) {
+	prnMsg(__('A reminder letter must be selected'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$Result = DB_query("SELECT dunningletters.letterid,
+							dunningletters.debtorno,
+							dunningletters.stageno,
+							dunningletters.letterdate,
+							dunningletters.method,
+							dunningletters.emailto,
+							dunningletters.subject,
+							dunningletters.lettertext,
+							debtorsmaster.name,
+							debtorsmaster.address1,
+							debtorsmaster.address2,
+							debtorsmaster.address3,
+							debtorsmaster.address4,
+							debtorsmaster.address5,
+							debtorsmaster.address6
+						FROM dunningletters INNER JOIN debtorsmaster
+							ON dunningletters.debtorno=debtorsmaster.debtorno
+						WHERE dunningletters.letterid='" . (int)$_GET['LetterID'] . "'");
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('The reminder letter could not be found'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$Letter = DB_fetch_array($Result);
+
+if ($CustomerLogin == 1) {
+	$Result = DB_query("SELECT customerid FROM www_users WHERE userid='" . $_SESSION['UserID'] . "'");
+	$MyRow = DB_fetch_array($Result);
+	if ($MyRow['customerid'] != $Letter['debtorno']) {
+		prnMsg(__('This letter is addressed to another customer and cannot be displayed for privacy reasons'), 'error');
+		include('includes/footer.php');
+		exit();
+	}
+} elseif (!UserMaySeeCustomerCredit($Letter['debtorno'])) {
+	prnMsg(__('Your account is set up to see only the credit information of your own customers'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+echo '<div style="max-width:700px;margin:auto">
+		<p><b>', htmlspecialchars($_SESSION['CompanyRecord']['coyname'], ENT_QUOTES, 'UTF-8', false), '</b></p>
+		<p>', htmlspecialchars($Letter['name'], ENT_QUOTES, 'UTF-8', false), '<br />';
+foreach (array('address1', 'address2', 'address3', 'address4', 'address5', 'address6') as $Line) {
+	if (trim($Letter[$Line]) != '') {
+		echo htmlspecialchars($Letter[$Line], ENT_QUOTES, 'UTF-8', false), '<br />';
+	}
+}
+echo '</p>
+		<p>', ConvertSQLDate($Letter['letterdate']), '</p>
+		<p><b>', htmlspecialchars($Letter['subject'], ENT_QUOTES, 'UTF-8', false), '</b></p>
+		<p>', nl2br(htmlspecialchars($Letter['lettertext'], ENT_QUOTES, 'UTF-8', false)), '</p>
+		<p class="noPrint"><i>', ($Letter['method'] == 'email' ? __('Sent by email to') . ' ' . $Letter['emailto'] : __('Sent by post')), '</i></p>
+	</div>';
+
+include('includes/footer.php');
diff --git a/DunningRun.php b/DunningRun.php
new file mode 100644
index 0000000..b34b328
--- /dev/null
+++ b/DunningRun.php
@@ -0,0 +1,268 @@
+<?php
+
+/* Reminder letter run (dunning). Credit control starts the run (weekly), previews who will get which letter,
+ * leaves out customers (promised payment, in discussion) and sends. Letters go by email to the customer's
+ * accounts contacts (contacts flagged for statements); customers with no email address are listed so the letter
+ * can be printed and posted. Every letter is recorded against the customer with the items it covered.
+ *
+ * Rules:
+ * - only undisputed items overdue by at least the stage's days are chased, net of unallocated payments and credits,
+ *   so a customer who has paid (even if the cash is not yet allocated) gets nothing
+ * - a customer moves up one stage at a time and only while the items covered by the previous letter are still overdue;
+ *   items that become overdue after earlier items were paid start again at stage 1
+ * - no customer gets two letters within the minimum number of days between letters (DunningMinDaysBetween) */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Reminder Letter Run');
+$ViewTopic = 'CreditControl';
+$BookMark = 'ReminderRun';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text"><img src="', $RootPath, '/css/', $Theme, '/images/email.png" title="', $Title, '" alt="" />', ' ', $Title, '</p>';
+
+/* The stages in order */
+$Stages = array();
+$Result = DB_query("SELECT stageno, stagename, daysoverdue, subject, lettertext, finalnotice FROM dunningstages ORDER BY stageno");
+while ($MyRow = DB_fetch_array($Result)) {
+	$Stages[$MyRow['stageno']] = $MyRow;
+}
+if (count($Stages) == 0) {
+	prnMsg(__('No reminder letter stages are defined'), 'error');
+	echo '<div class="centre"><a href="', $RootPath, '/DunningStages.php">', __('Define the reminder letter stages'), '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+$MinDaysBetween = isset($_SESSION['DunningMinDaysBetween']) ? (int)$_SESSION['DunningMinDaysBetween'] : 7;
+
+/* Works out the reminder due to a customer - returns false if no letter is due */
+function DunningProposal($Customer, $Stages, $MinDaysBetween) {
+	$FirstStage = reset($Stages);
+	$Overdue = GetOverdueItems($Customer['debtorno'], date('Y-m-d'), $FirstStage['daysoverdue']);
+	if ($Overdue['net'] < pow(10, -$Customer['decimalplaces']) OR count($Overdue['items']) == 0) {
+		return false;
+	}
+	$ItemIDs = array();
+	foreach ($Overdue['items'] as $Item) {
+		$ItemIDs[] = (int)$Item['id'];
+	}
+	/* the highest stage already sent that covered any of the items still overdue */
+	$Result = DB_query("SELECT MAX(dunningletters.stageno)
+						FROM dunningletters INNER JOIN dunninglettertrans
+							ON dunningletters.letterid=dunninglettertrans.letterid
+						WHERE dunningletters.debtorno='" . DB_escape_string($Customer['debtorno']) . "'
+							AND dunninglettertrans.debtortransid IN (" . implode(',', $ItemIDs) . ")");
+	$MyRow = DB_fetch_row($Result);
+	$LastStage = is_null($MyRow[0]) ? 0 : $MyRow[0];
+	/* not two letters in a short time */
+	$Result = DB_query("SELECT DATEDIFF(CURRENT_DATE, MAX(letterdate)) FROM dunningletters
+						WHERE debtorno='" . DB_escape_string($Customer['debtorno']) . "'");
+	$MyRow = DB_fetch_row($Result);
+	if (!is_null($MyRow[0]) AND $MyRow[0] < $MinDaysBetween) {
+		return false;
+	}
+	$NextStage = false;
+	foreach ($Stages as $StageNo => $Stage) {
+		if ($StageNo > $LastStage) {
+			$NextStage = $Stage;
+			break;
+		}
+	}
+	if ($NextStage === false OR $Overdue['maxdays'] < $NextStage['daysoverdue']) {
+		return false;
+	}
+	return array('stage' => $NextStage, 'overdue' => $Overdue, 'laststage' => $LastStage);
+}
+
+/* The customers with overdue debit balances - optionally restricted by currency and sales person */
+function DunningCustomers() {
+	$SQL = "SELECT DISTINCT debtorsmaster.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					currencies.decimalplaces,
+					holdreasons.dissallowinvoices
+			FROM debtorsmaster
+			INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+			LEFT JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+			INNER JOIN debtortrans ON debtortrans.debtorno=debtorsmaster.debtorno
+			WHERE debtortrans.settled=0
+				AND debtortrans.balance>0";
+	if (isset($_POST['Currency']) AND $_POST['Currency'] != 'All') {
+		$SQL .= " AND debtorsmaster.currcode='" . $_POST['Currency'] . "'";
+	}
+	if (isset($_POST['Salesman']) AND $_POST['Salesman'] != 'All') {
+		$SQL .= " AND EXISTS (SELECT 1 FROM custbranch WHERE custbranch.debtorno=debtorsmaster.debtorno AND custbranch.salesman='" . $_POST['Salesman'] . "')";
+	}
+	$SQL .= " ORDER BY debtorsmaster.debtorno";
+	return DB_query($SQL);
+}
+
+if (isset($_POST['SendLetters'])) {
+	$FromEmail = (isset($_SESSION['DunningFromEmail']) AND IsEmailAddress($_SESSION['DunningFromEmail'])) ? $_SESSION['DunningFromEmail'] : $_SESSION['CompanyRecord']['email'];
+	$From = $_SESSION['CompanyRecord']['coyname'] . ' <' . $FromEmail . '>';
+	$Sent = 0;
+	$ToPost = array();
+	$Failed = array();
+	$Result = DunningCustomers();
+	while ($Customer = DB_fetch_array($Result)) {
+		if (!isset($_POST['Send_' . $Customer['debtorno']])) {
+			continue; /* left out by credit control */
+		}
+		/* recalculated at the time of sending - the position may have changed since the preview */
+		$Proposal = DunningProposal($Customer, $Stages, $MinDaysBetween);
+		if ($Proposal === false) {
+			continue;
+		}
+		$Stage = $Proposal['stage'];
+		$Subject = BuildDunningLetter(html_entity_decode($Stage['subject'], ENT_QUOTES, 'UTF-8'), $Customer, $Proposal['overdue']);
+		$Letter = BuildDunningLetter(html_entity_decode($Stage['lettertext'], ENT_QUOTES, 'UTF-8'), $Customer, $Proposal['overdue']);
+		$Emails = GetCustomerAccountsEmails($Customer['debtorno']);
+		$Method = (count($Emails) > 0) ? 'email' : 'post';
+
+		DB_Txn_Begin();
+		$SQL = "INSERT INTO dunningletters (debtorno, stageno, letterdate, sentdate, userid, method, emailto, currcode, amount, subject, lettertext)
+				VALUES ('" . DB_escape_string($Customer['debtorno']) . "',
+						'" . $Stage['stageno'] . "',
+						CURRENT_DATE,
+						NOW(),
+						'" . $_SESSION['UserID'] . "',
+						'" . $Method . "',
+						'" . DB_escape_string(mb_substr(implode(', ', array_keys($Emails)), 0, 255)) . "',
+						'" . $Customer['currcode'] . "',
+						'" . $Proposal['overdue']['net'] . "',
+						'" . DB_escape_string(mb_substr($Subject, 0, 100)) . "',
+						'" . DB_escape_string($Letter) . "')";
+		DB_query($SQL, __('The reminder letter could not be recorded because'), '', true);
+		$LetterID = DB_Last_Insert_ID('dunningletters', 'letterid');
+		foreach ($Proposal['overdue']['items'] as $Item) {
+			DB_query("INSERT INTO dunninglettertrans (letterid, debtortransid, amount, daysoverdue)
+						VALUES ('" . $LetterID . "', '" . $Item['id'] . "', '" . $Item['balance'] . "', '" . $Item['daysoverdue'] . "')",
+					__('The items covered by the reminder letter could not be recorded because'), '', true);
+		}
+		LogCreditEvent($Customer['debtorno'], 'reminder',
+						__('Reminder letter stage') . ' ' . $Stage['stageno'] . ' (' . $Stage['stagename'] . ') ' . __('sent by') . ' ' . ($Method == 'email' ? __('email to') . ' ' . implode(', ', array_keys($Emails)) : __('post')),
+						$Proposal['laststage'], $Stage['stageno'], $Proposal['overdue']['net'], $Customer['currcode'], 0, $LetterID);
+		DB_Txn_Commit();
+
+		if ($Method == 'email') {
+			$EmailResult = SendEmailFromWebERP($From, $Emails, $Subject, $Letter, '', true);
+			if ($EmailResult === true) {
+				$Sent++;
+			} else {
+				$Failed[] = array($Customer, $LetterID, $EmailResult);
+			}
+		} else {
+			$ToPost[] = array($Customer, $LetterID, $Stage);
+		}
+	}
+	prnMsg($Sent . ' ' . __('reminder letters were emailed'), 'success');
+	if (count($Failed) > 0) {
+		echo '<table class="selection">

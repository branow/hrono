diff --git a/DebtorsControlReconciliation.php b/DebtorsControlReconciliation.php
new file mode 100644
index 0000000..d678258
--- /dev/null
+++ b/DebtorsControlReconciliation.php
@@ -0,0 +1,219 @@
+<?php
+
+/* Month end reconciliation of the customer accounts (sales ledger) with the debtors control account in the general
+ * ledger, after interest, fees, waivers and write offs have been posted.
+ *  1. The total of all customer transactions to the period end in home currency (at each transaction's own rate,
+ *     plus the exchange differences realised by allocations) against the debtors control account balance.
+ *  2. The movement of the selected periods by transaction type, customer side against GL.
+ *  3. The transactions that explain any difference: customer transactions whose GL debtors entries do not agree, and
+ *     entries to the debtors control account with no customer transaction (for example manual journals). */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Debtors Control Reconciliation');
+$ViewTopic = 'CreditControl';
+$BookMark = 'DebtorsControlReconciliation';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="', $RootPath, '/css/', $Theme, '/images/reports.png" title="', $Title, '" alt="" />', ' ', $Title, '</p>';
+
+if ($_SESSION['CompanyRecord']['gllink_debtors'] != 1) {
+	prnMsg(__('The debtors ledger is not linked to the general ledger in the company preferences - there is nothing to reconcile'), 'info');
+	include('includes/footer.php');
+	exit();
+}
+
+$DebtorsAct = $_SESSION['CompanyRecord']['debtorsact'];
+$Decimals = $_SESSION['CompanyRecord']['decimalplaces'];
+$Tolerance = pow(10, -$Decimals);
+
+if (!isset($_POST['ToPeriod'])) {
+	$Result = DB_query("SELECT periodno FROM periods WHERE lastdate_in_period < CURRENT_DATE ORDER BY periodno DESC LIMIT 1");
+	$MyRow = DB_fetch_row($Result);
+	$_POST['ToPeriod'] = $MyRow[0];
+}
+if (!isset($_POST['FromPeriod'])) {
+	$_POST['FromPeriod'] = $_POST['ToPeriod'];
+}
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '" class="noPrint">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Periods'), '</legend>';
+$Periods = array();
+$Result = DB_query("SELECT periodno, lastdate_in_period FROM periods ORDER BY periodno DESC");
+while ($MyRow = DB_fetch_array($Result)) {
+	$Periods[$MyRow['periodno']] = MonthAndYearFromSQLDate($MyRow['lastdate_in_period']);
+}
+foreach (array('FromPeriod' => __('From Period'), 'ToPeriod' => __('To Period')) as $Field => $Label) {
+	echo '<field>
+			<label for="', $Field, '">', $Label, ':</label>
+			<select name="', $Field, '">';
+	foreach ($Periods as $PeriodNo => $Text) {
+		echo '<option ', ($PeriodNo == $_POST[$Field] ? 'selected="selected" ' : ''), 'value="', $PeriodNo, '">', $Text, '</option>';
+	}
+	echo '</select>
+		</field>';
+}
+echo '</fieldset>
+	<div class="centre"><input type="submit" name="Show" value="', __('Reconcile'), '" /></div>
+	</form>';
+
+if (isset($_POST['Show'])) {
+	$FromPeriod = (int)$_POST['FromPeriod'];
+	$ToPeriod = (int)$_POST['ToPeriod'];
+
+	/* what a customer transaction should have posted to the debtors control account in home currency: its amount at its own
+	 * rate, plus (for receipts and credits, whose allocations post the realised exchange difference under their own number)
+	 * the exchange differences realised - stored as minus diffonexch on the receipt or credit */
+	$ExpectedSQL = "((debtortrans.ovamount+debtortrans.ovgst+debtortrans.ovfreight+debtortrans.ovdiscount)/debtortrans.rate
+					- IF((debtortrans.ovamount+debtortrans.ovgst+debtortrans.ovfreight+debtortrans.ovdiscount) < 0, debtortrans.diffonexch, 0))";
+
+	/* 1. Balances at the end of the period */
+	$Result = DB_query("SELECT COALESCE(SUM(" . $ExpectedSQL . "),0) FROM debtortrans WHERE prd <= " . $ToPeriod);
+	$MyRow = DB_fetch_row($Result);
+	$LedgerTotal = $MyRow[0];
+	$Result = DB_query("SELECT COALESCE(SUM(amount),0) FROM gltrans WHERE account='" . $DebtorsAct . "' AND periodno <= " . $ToPeriod);
+	$MyRow = DB_fetch_row($Result);
+	$GLTotal = $MyRow[0];
+	$Result = DB_query("SELECT COALESCE(SUM(debtortrans.balance/debtortrans.rate),0) FROM debtortrans WHERE prd <= " . $ToPeriod);
+	$MyRow = DB_fetch_row($Result);
+	$OutstandingTotal = $MyRow[0];
+
+	$Difference = round($GLTotal - $LedgerTotal, $Decimals);
+	echo '<table class="selection">
+			<tr><th colspan="2">', __('At the end of'), ' ', $Periods[$ToPeriod], '</th></tr>
+			<tr><td>', __('Customer accounts in home currency'), '</td><td class="number">', locale_number_format($LedgerTotal, $Decimals), '</td></tr>
+			<tr><td>', __('Debtors control account'), ' ', $DebtorsAct, '</td><td class="number">', locale_number_format($GLTotal, $Decimals), '</td></tr>
+			<tr><td><b>', __('Difference'), '</b></td><td class="number"><b>', locale_number_format($Difference, $Decimals), '</b></td></tr>
+			<tr><td>', __('Outstanding customer balances at the transaction rates (for information)'), '</td><td class="number">', locale_number_format($OutstandingTotal, $Decimals), '</td></tr>
+		</table>';
+	if (abs($Difference) < $Tolerance) {
+		prnMsg(__('The customer accounts agree with the debtors control account'), 'success');
+	} else {
+		prnMsg(__('The customer accounts do not agree with the debtors control account - the transactions below explain the difference'), 'warn');
+	}
+
+	/* 2. Movement by type for the periods selected */
+	$Movements = array();
+	$Result = DB_query("SELECT debtortrans.type, systypes.typename, SUM(" . $ExpectedSQL . ") AS amount
+						FROM debtortrans INNER JOIN systypes ON debtortrans.type=systypes.typeid
+						WHERE debtortrans.prd >= " . $FromPeriod . " AND debtortrans.prd <= " . $ToPeriod . "
+						GROUP BY debtortrans.type, systypes.typename");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Movements[$MyRow['type']] = array('name' => $MyRow['typename'], 'ledger' => $MyRow['amount'], 'gl' => 0);
+	}
+	$Result = DB_query("SELECT gltrans.type, systypes.typename, SUM(gltrans.amount) AS amount
+						FROM gltrans INNER JOIN systypes ON gltrans.type=systypes.typeid
+						WHERE gltrans.account='" . $DebtorsAct . "'
+							AND gltrans.periodno >= " . $FromPeriod . " AND gltrans.periodno <= " . $ToPeriod . "
+						GROUP BY gltrans.type, systypes.typename");
+	while ($MyRow = DB_fetch_array($Result)) {
+		if (!isset($Movements[$MyRow['type']])) {
+			$Movements[$MyRow['type']] = array('name' => $MyRow['typename'], 'ledger' => 0, 'gl' => 0);
+		}
+		$Movements[$MyRow['type']]['gl'] = $MyRow['amount'];
+	}
+	ksort($Movements);
+	echo '<table class="selection">
+			<tr><th colspan="5">', __('Movement'), ' ', $Periods[$FromPeriod], ' - ', $Periods[$ToPeriod], '</th></tr>
+			<tr>
+				<th>', __('Type'), '</th>
+				<th>', __('Transaction Type'), '</th>
+				<th>', __('Customer Accounts'), '</th>
+				<th>', __('Debtors Control'), '</th>
+				<th>', __('Difference'), '</th>
+			</tr>';
+	$TotalLedger = 0;
+	$TotalGL = 0;
+	foreach ($Movements as $Type => $Movement) {
+		$TotalLedger += $Movement['ledger'];
+		$TotalGL += $Movement['gl'];
+		$TypeDifference = round($Movement['gl'] - $Movement['ledger'], $Decimals);
+		echo '<tr class="striped_row">
+				<td class="number">', $Type, '</td>
+				<td>', __($Movement['name']), '</td>
+				<td class="number">', locale_number_format($Movement['ledger'], $Decimals), '</td>
+				<td class="number">', locale_number_format($Movement['gl'], $Decimals), '</td>
+				<td class="number">', (abs($TypeDifference) < $Tolerance ? '' : '<b>' . locale_number_format($TypeDifference, $Decimals) . '</b>'), '</td>
+			</tr>';
+	}
+	echo '<tr class="total_row">
+			<td colspan="2">', __('Total'), '</td>
+			<td class="number">', locale_number_format($TotalLedger, $Decimals), '</td>
+			<td class="number">', locale_number_format($TotalGL, $Decimals), '</td>
+			<td class="number">', locale_number_format($TotalGL - $TotalLedger, $Decimals), '</td>
+		</tr>
+		</table>';
+
+	/* 3a. Customer transactions whose debtors control entries do not agree */
+	$Result = DB_query("SELECT debtortrans.type, systypes.typename, debtortrans.transno, debtortrans.debtorno, debtortrans.trandate, debtortrans.prd,
+								" . $ExpectedSQL . " AS expected,
+								COALESCE(gl.amount,0) AS glamount
+						FROM debtortrans
+						INNER JOIN systypes ON debtortrans.type=systypes.typeid
+						LEFT JOIN (SELECT type, typeno, SUM(amount) AS amount
+									FROM gltrans
+									WHERE account='" . $DebtorsAct . "'
+									GROUP BY type, typeno) AS gl
+							ON gl.type=debtortrans.type AND gl.typeno=debtortrans.transno
+						WHERE debtortrans.prd >= " . $FromPeriod . " AND debtortrans.prd <= " . $ToPeriod . "
+							AND ABS(" . $ExpectedSQL . " - COALESCE(gl.amount,0)) >= " . $Tolerance . "
+						ORDER BY debtortrans.type, debtortrans.transno");
+	echo '<table class="selection">
+			<tr><th colspan="7">', __('Customer Transactions Not Agreeing With The Debtors Control Account'), '</th></tr>
+			<tr>
+				<th>', __('Type'), '</th>
+				<th>', __('Number'), '</th>
+				<th>', __('Customer'), '</th>
+				<th>', __('Date'), '</th>
+				<th>', __('Customer Account'), '</th>
+				<th>', __('Debtors Control'), '</th>
+				<th>', __('Difference'), '</th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>', __($MyRow['typename']), '</td>
+				<td class="number"><a href="', $RootPath, '/GLTransInquiry.php?TypeID=', $MyRow['type'], '&amp;TransNo=', $MyRow['transno'], '" target="_blank">', $MyRow['transno'], '</a></td>
+				<td>', $MyRow['debtorno'], '</td>
+				<td class="date">', ConvertSQLDate($MyRow['trandate']), '</td>
+				<td class="number">', locale_number_format($MyRow['expected'], $Decimals), '</td>
+				<td class="number">', locale_number_format($MyRow['glamount'], $Decimals), '</td>
+				<td class="number">', locale_number_format($MyRow['glamount'] - $MyRow['expected'], $Decimals), '</td>
+			</tr>';
+	}
+	echo '</table>';
+
+	/* 3b. Entries to the debtors control account with no customer transaction */
+	$Result = DB_query("SELECT gltrans.type, systypes.typename, gltrans.typeno, gltrans.trandate, gltrans.narrative, SUM(gltrans.amount) AS amount
+						FROM gltrans INNER JOIN systypes ON gltrans.type=systypes.typeid
+						WHERE gltrans.account='" . $DebtorsAct . "'
+							AND gltrans.periodno >= " . $FromPeriod . " AND gltrans.periodno <= " . $ToPeriod . "
+							AND NOT EXISTS (SELECT 1 FROM debtortrans
+											WHERE debtortrans.type=gltrans.type
+												AND debtortrans.transno=gltrans.typeno)
+						GROUP BY gltrans.type, systypes.typename, gltrans.typeno, gltrans.trandate, gltrans.narrative
+						HAVING ABS(SUM(gltrans.amount)) >= " . $Tolerance . "
+						ORDER BY gltrans.trandate");
+	echo '<table class="selection">
+			<tr><th colspan="5">', __('Debtors Control Entries With No Customer Transaction (for example manual journals)'), '</th></tr>
+			<tr>
+				<th>', __('Type'), '</th>
+				<th>', __('Number'), '</th>
+				<th>', __('Date'), '</th>
+				<th>', __('Narrative'), '</th>
+				<th>', __('Amount'), '</th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>', __($MyRow['typename']), '</td>
+				<td class="number"><a href="', $RootPath, '/GLTransInquiry.php?TypeID=', $MyRow['type'], '&amp;TransNo=', $MyRow['typeno'], '" target="_blank">', $MyRow['typeno'], '</a></td>
+				<td class="date">', ConvertSQLDate($MyRow['trandate']), '</td>
+				<td>', htmlspecialchars($MyRow['narrative'], ENT_QUOTES, 'UTF-8', false), '</td>
+				<td class="number">', locale_number_format($MyRow['amount'], $Decimals), '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');

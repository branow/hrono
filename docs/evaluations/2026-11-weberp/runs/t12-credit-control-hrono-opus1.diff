+INSERT INTO `scripts` VALUES ('CreditCharges.php',21,'Calculates, previews and posts month end interest and late payment fees on overdue customer balances, and waives charges'),('CreditControl.php',2,'Shows the credit status, limit, balance, reviews, reminders, charges and credit control history of a customer. Credit control users can record reviews, change the credit status and mark disputed invoices'),('CreditControlReport.php',2,'Lists customers due for a credit review, over their credit limit, on watch or on stop'),('CreditControlSettings.php',10,'Defines the credit control parameters - review periods, interest rate, late fee, GL accounts and write off approval limit'),('CreditOrderHolds.php',21,'Lists sales orders held for credit approval and orders taken for customers on watch, and allows credit control to release them'),('CreditStatusImport.php',21,'Imports the credit status, credit limit and next review date of customers from a csv file'),('CreditWriteOff.php',21,'Writes off bad debts against customer invoices, subject to approval above the approval limit'),('CreditWriteOffApprove.php',22,'Approves or rejects bad debt write offs over the approval limit'),('CreditWriteOffReport.php',21,'Lists bad debt write offs over a date range with reason, requester and approver'),('DebtorsControlReconciliation.php',8,'Reconciles the customer balances to the debtors control account in the general ledger by transaction type and lists the transactions that do not agree'),('DunningLetter.php',1,'Displays a reminder letter sent to a customer - customer logins can only see their own letters'),('DunningRun.php',21,'Previews and sends the overdue reminder letters to customers by email and lists the customers to be posted letters'),('DunningStages.php',21,'Defines the reminder letter stages - the days overdue that trigger each stage and the wording of each letter');
+INSERT INTO `dunningstages` VALUES (1,'Polite reminder',30,'Payment reminder - account {AccountNo}','Dear {CustomerName},\n\nOur records show that the invoices listed below on your account {AccountNo} are now past their due date. The overdue amount is {Currency} {OverdueAmount}.\n\n{InvoiceList}\n\nIf you have already sent payment please accept our thanks and disregard this reminder. Otherwise we would be grateful for payment at your earliest convenience.\n\nYours sincerely,\n\nCredit Control\n{CompanyName}',0),(2,'Second reminder',45,'Second reminder - overdue account {AccountNo}','Dear {CustomerName},\n\nWe wrote to you recently about the overdue invoices on your account {AccountNo}. We have not yet received payment and the overdue amount is now {Currency} {OverdueAmount}.\n\n{InvoiceList}\n\nPlease arrange payment immediately or contact our credit control department if there is a reason this amount cannot be paid.\n\nYours sincerely,\n\nCredit Control\n{CompanyName}',0),(3,'Final notice',60,'FINAL NOTICE - account {AccountNo}','Dear {CustomerName},\n\nDespite our previous reminders the invoices below on your account {AccountNo} remain unpaid. The overdue amount is {Currency} {OverdueAmount}.\n\n{InvoiceList}\n\nUnless payment is received within 7 days your account will be placed on stop and no further orders will be supplied. Interest and late payment fees will also be charged on the overdue balance in accordance with our terms of trade.\n\nYours sincerely,\n\nCredit Control\n{CompanyName}',1);

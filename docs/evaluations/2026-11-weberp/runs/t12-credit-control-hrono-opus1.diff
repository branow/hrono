+/* Give the new tokens to the roles that hold the system administration token - the administrator then
+ * grants token 21 to the credit controllers' role and token 22 to the Finance Director's role in WWW_Access.php */
+$Result = DB_query("SELECT secroleid FROM securitygroups WHERE tokenid=15");
+while ($MyRow = DB_fetch_array($Result)) {
+	InsertRecord('securitygroups', array('secroleid', 'tokenid'), array($MyRow['secroleid'], 21), array('secroleid', 'tokenid'), array($MyRow['secroleid'], 21));
+	InsertRecord('securitygroups', array('secroleid', 'tokenid'), array($MyRow['secroleid'], 22), array('secroleid', 'tokenid'), array($MyRow['secroleid'], 22));
+}

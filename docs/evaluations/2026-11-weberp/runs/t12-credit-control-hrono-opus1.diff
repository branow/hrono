+				<td>', ConvertSQLDateTime($MyRow['holddate']), '</td>
+				<td class="number">', locale_number_format($MyRow['ordervalue'], $DecimalPlaces), '</td>
+				<td>', ($MyRow['status'] == CREDIT_HOLD_HELD ? '<b>' . __('Held') . '</b>' : ($MyRow['status'] == CREDIT_HOLD_RELEASED ? __('Released') : __('Noted'))), '</td>
+				<td>', $MyRow['releasedby'], ' ', (is_null($MyRow['releasedate']) ? '' : ConvertSQLDateTime($MyRow['releasedate'])), ' ', $MyRow['notes'], '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+/* ===== The full credit control history - reviews, status and limit changes, reminders, charges, waivers, write offs ===== */
+$Result = DB_query("SELECT eventdate, userid, eventtype, description, amount, currcode, transtype, transno, notes
+					FROM custcreditevents
+					WHERE debtorno='" . $DebtorNo . "'
+					ORDER BY eventdate DESC, eventid DESC");
+echo '<table class="selection">
+		<tr><th colspan="6">', __('Credit Control History'), '</th></tr>
+		<tr>
+			<th>', __('Date'), '</th>
+			<th>', __('User'), '</th>
+			<th>', __('Action'), '</th>
+			<th>', __('Detail'), '</th>
+			<th>', __('Amount'), '</th>
+			<th>', __('Reason / Notes'), '</th>
+		</tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>', ConvertSQLDateTime($MyRow['eventdate']), '</td>
+			<td>', $MyRow['userid'], '</td>
+			<td>', $MyRow['eventtype'], '</td>
+			<td>', htmlspecialchars($MyRow['description'], ENT_QUOTES, 'UTF-8', false), '</td>
+			<td class="number">', ($MyRow['amount'] != 0 ? $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], $DecimalPlaces) : ''), '</td>
+			<td>', nl2br(htmlspecialchars($MyRow['notes'], ENT_QUOTES, 'UTF-8', false)), '</td>
+		</tr>';
+}
+echo '</table>';
+
+echo '<div class="centre">
+		<a href="', $RootPath, '/CustomerAccount.php?CustomerID=', urlencode($DebtorNo), '">', __('Customer Account'), '</a> |
+		<a href="', $RootPath, '/CustomerInquiry.php?CustomerID=', urlencode($DebtorNo), '">', __('Customer Transaction Inquiry'), '</a>';
+if (CanManageCredit()) {
+	echo ' | <a href="', $RootPath, '/CreditWriteOff.php?DebtorNo=', urlencode($DebtorNo), '">', __('Bad Debt Write Off'), '</a>';
+}
+echo '</div>';
+
+include('includes/footer.php');

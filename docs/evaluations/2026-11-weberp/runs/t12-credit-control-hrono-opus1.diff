+/* Shows the credit status of a customer wherever staff look at the customer or take an order for them.
+ * Staff see stop, watch, the reason, over limit and review due. Customer logins only see that the account is on hold. */
+function ShowCreditStatusWarnings($DebtorNo) {
+	global $CustomerLogin;
+	$Position = GetCustomerCreditPosition($DebtorNo);
+	if ($Position === false) {
+		return;
+	}
+	if (isset($CustomerLogin) AND $CustomerLogin == 1) {
+		if ($Position['status'] == CREDIT_STATUS_STOP) {
+			prnMsg(__('Your account is currently on hold. Please contact our credit control department to discuss your account'), 'warn');
+		}
+		return;
+	}
+	if (!UserMaySeeCustomerCredit($DebtorNo)) {
+		return;
+	}
+	$Name = htmlspecialchars($Position['name'], ENT_QUOTES, 'UTF-8', false);
+	$Reason = LastCreditStatusReason($DebtorNo);
+	if ($Position['status'] == CREDIT_STATUS_STOP) {
+		prnMsg(__('CREDIT STATUS: ON STOP') . ' - ' . $Name . ' ' . __('is on stop') . ' (' . $Position['reasondescription'] . ')' .
+				($Reason != '' ? '. ' . __('Reason') . ': ' . $Reason : '') . '. ' .
+				__('No new orders can be accepted and goods cannot be dispatched or invoiced unless credit control releases the order. Please contact credit control'), 'error');
+	} elseif ($Position['status'] == CREDIT_STATUS_WATCH) {
+		prnMsg(__('CREDIT STATUS: WATCH') . ' - ' . $Name . ' ' . __('is on watch') . ' (' . $Position['reasondescription'] . ')' .
+				($Reason != '' ? '. ' . __('Reason') . ': ' . $Reason : '') . '. ' .
+				__('Orders can be taken but credit control will review them'), 'warn');
+	}
+	if ($Position['overlimit'] > pow(10, -$Position['decimalplaces'])) {
+		prnMsg($Name . ' ' . __('is over their credit limit of') . ' ' . $Position['currcode'] . ' ' . locale_number_format($Position['creditlimit'], $Position['decimalplaces']) . ' ' .
+				__('by') . ' ' . locale_number_format($Position['overlimit'], $Position['decimalplaces']) . ' ' . __('(balance plus open orders)') . '. ' .
+				__('Orders that take the customer over their limit are held for credit approval'), 'warn');
+	}
+}

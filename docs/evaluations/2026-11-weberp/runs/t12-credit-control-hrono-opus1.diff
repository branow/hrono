+<?php
+
+/* Credit held orders - orders held for credit approval because they take the customer over the credit limit,
+ * open orders of customers on stop (taken before the stop), and orders taken for customers on watch.
+ * Credit control releases held orders here so they can be picked, dispatched and invoiced. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Held Orders');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditHeldOrders';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text"><img src="', $RootPath, '/css/', $Theme, '/images/customer.png" title="', $Title, '" alt="" />', ' ', $Title, '</p>';
+
+if (isset($_POST['Release'])) {
+	$Released = 0;
+	foreach ($_POST as $Key => $Value) {
+		if (mb_substr($Key, 0, 11) == 'ReleaseOrd_' AND $Value == 'on') {
+			$OrderNo = (int)mb_substr($Key, 11);
+			if (trim($_POST['ReleaseNotes']) == '') {
+				prnMsg(__('A note must be entered explaining why the orders are released'), 'error');
+				break;
+			}
+			DB_Txn_Begin();
+			ReleaseOrderCreditHold($OrderNo, $_POST['ReleaseNotes']);
+			DB_Txn_Commit();
+			$Released++;
+		}
+	}
+	if ($Released > 0) {
+		prnMsg($Released . ' ' . __('orders have been released for dispatch'), 'success');
+	}
+}
+
+if (!isset($_POST['WatchDays'])) {
+	$_POST['WatchDays'] = 30;
+}
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />';
+
+/* Orders that cannot be dispatched: held for approval, or open orders of customers on stop not yet released */
+$SQL = "SELECT salesorders.orderno,
+				salesorders.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				debtorsmaster.creditlimit,
+				salesorders.orddate,
+				salesorders.salesperson,
+				currencies.decimalplaces,
+				holdreasons.dissallowinvoices,
+				creditorderholds.holdtype,
+				creditorderholds.status,
+				creditorderholds.holddate,
+				creditorderholds.exposure
+			FROM salesorders
+			INNER JOIN debtorsmaster ON salesorders.debtorno=debtorsmaster.debtorno
+			INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+			LEFT JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+			LEFT JOIN creditorderholds ON creditorderholds.orderno=salesorders.orderno
+			WHERE salesorders.quotation=0
+				AND EXISTS (SELECT 1 FROM salesorderdetails
+							WHERE salesorderdetails.orderno=salesorders.orderno
+								AND salesorderdetails.completed=0)
+				AND (creditorderholds.status=" . CREDIT_HOLD_HELD . "
+					OR (holdreasons.dissallowinvoices=1
+						AND (creditorderholds.orderno IS NULL
+							OR NOT (creditorderholds.status=" . CREDIT_HOLD_RELEASED . " AND creditorderholds.holdtype='stop'))))
+			ORDER BY salesorders.orddate, salesorders.orderno";
+$Result = DB_query($SQL);
+
+echo '<table class="selection">
+		<tr><th colspan="9">', __('Orders Held By Credit Control'), '</th></tr>
+		<tr>
+			<th>', __('Order'), '</th>
+			<th>', __('Customer'), '</th>
+			<th>', __('Order Date'), '</th>
+			<th>', __('Reason Held'), '</th>
+			<th>', __('Order Value'), '</th>
+			<th>', __('Balance + Open Orders'), '</th>
+			<th>', __('Credit Limit'), '</th>
+			<th>', __('Sales Person'), '</th>
+			<th>', __('Release'), '</th>
+		</tr>';
+$HeldCount = 0;
+while ($MyRow = DB_fetch_array($Result)) {
+	$HeldCount++;
+	$Position = GetCustomerCreditPosition($MyRow['debtorno']);
+	if ($MyRow['dissallowinvoices'] == 1) {
+		$Reason = __('Customer on stop');
+	} else {
+		$Reason = __('Over credit limit');
+	}
+	echo '<tr class="striped_row">
+			<td><a href="', $RootPath, '/OrderDetails.php?OrderNumber=', $MyRow['orderno'], '" target="_blank">', $MyRow['orderno'], '</a></td>
+			<td><a href="', $RootPath, '/CreditControl.php?DebtorNo=', urlencode($MyRow['debtorno']), '">', $MyRow['debtorno'], ' - ', htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8', false), '</a></td>
+			<td class="date">', ConvertSQLDate($MyRow['orddate']), '</td>
+			<td>', $Reason, '</td>
+			<td class="number">', $MyRow['currcode'], ' ', locale_number_format(SalesOrderOutstandingValue($MyRow['orderno']), $MyRow['decimalplaces']), '</td>
+			<td class="number">', locale_number_format($Position['exposure'], $MyRow['decimalplaces']), '</td>
+			<td class="number">', locale_number_format($MyRow['creditlimit'], $MyRow['decimalplaces']), '</td>
+			<td>', $MyRow['salesperson'], '</td>
+			<td class="centre"><input type="checkbox" name="ReleaseOrd_', $MyRow['orderno'], '" /></td>
+		</tr>';
+}
+echo '</table>';
+
+if ($HeldCount > 0) {
+	echo '<fieldset>
+			<field>
+				<label for="ReleaseNotes">', __('Reason for releasing the selected orders'), ':</label>
+				<input type="text" name="ReleaseNotes" size="60" maxlength="250" />
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Release" value="', __('Release Selected Orders'), '" /></div>';
+} else {
+	prnMsg(__('There are no orders held by credit control'), 'info');
+}
+
+/* Orders taken for customers on watch - for credit control to see */
+$SQL = "SELECT creditorderholds.orderno,
+				creditorderholds.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				currencies.decimalplaces,
+				creditorderholds.holddate,
+				creditorderholds.ordervalue,
+				creditorderholds.status,
+				salesorders.salesperson
+			FROM creditorderholds
+			INNER JOIN debtorsmaster ON creditorderholds.debtorno=debtorsmaster.debtorno
+			INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+			INNER JOIN salesorders ON creditorderholds.orderno=salesorders.orderno
+			WHERE creditorderholds.holdtype='watch'
+				AND creditorderholds.holddate >= DATE_SUB(CURRENT_DATE, INTERVAL " . (int)$_POST['WatchDays'] . " DAY)
+			ORDER BY creditorderholds.holddate DESC";
+$Result = DB_query($SQL);
+echo '<table class="selection">
+		<tr><th colspan="5">', __('Orders Taken For Customers On Watch In The Last'), '
+			<input type="text" class="integer" name="WatchDays" size="4" maxlength="4" value="', (int)$_POST['WatchDays'], '" /> ', __('days'), '
+			<input type="submit" name="Refresh" value="', __('Refresh'), '" /></th></tr>
+		<tr>
+			<th>', __('Order'), '</th>
+			<th>', __('Customer'), '</th>
+			<th>', __('Taken'), '</th>
+			<th>', __('Order Value'), '</th>
+			<th>', __('Sales Person'), '</th>
+		</tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td><a href="', $RootPath, '/OrderDetails.php?OrderNumber=', $MyRow['orderno'], '" target="_blank">', $MyRow['orderno'], '</a></td>
+			<td><a href="', $RootPath, '/CreditControl.php?DebtorNo=', urlencode($MyRow['debtorno']), '">', $MyRow['debtorno'], ' - ', htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8', false), '</a></td>
+			<td>', ConvertSQLDateTime($MyRow['holddate']), '</td>
+			<td class="number">', $MyRow['currcode'], ' ', locale_number_format($MyRow['ordervalue'], $MyRow['decimalplaces']), '</td>
+			<td>', $MyRow['salesperson'], '</td>
+		</tr>';
+}
+echo '</table>
+	</form>';
+
+include('includes/footer.php');

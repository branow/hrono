+/* Existing customers are left with a NULL next review date - they show as due for review on the
+ * credit control report until Finance sets the date from CreditControlSettings.php or CreditStatusImport.php */
+AddColumn('nextreviewdate', 'debtorsmaster', 'date', 'NULL', '', 'language_id');
+AddColumn('interestexempt', 'debtorsmaster', 'tinyint', 'NOT NULL', '0', 'nextreviewdate');
+AddColumn('feeexempt', 'debtorsmaster', 'tinyint', 'NOT NULL', '0', 'interestexempt');

+include('includes/footer.php');
diff --git a/CreditControl.php b/CreditControl.php
new file mode 100644
index 0000000..dba86be
--- /dev/null
+++ b/CreditControl.php
@@ -0,0 +1,495 @@
+<?php
+
+/* Customer credit control - the credit position and full credit control history of a customer.
+ * Everyone allowed to see the customer (sales reps only for their own customers) sees the position and history.
+ * Users with the credit control token (21) can record credit reviews, change the credit status (stop/watch),
+ * set interest and fee exemptions, mark invoices as disputed and add notes. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Customer Credit Control');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CustomerCreditControl';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+if (isset($_GET['DebtorNo'])) {

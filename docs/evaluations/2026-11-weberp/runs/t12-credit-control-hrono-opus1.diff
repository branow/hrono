+<?php
+
+/* Credit control report - customers due or overdue for a credit review, customers over their credit limit (and by
+ * how much) and customers on watch or on stop. Filterable by sales person and currency, totals in home currency.
+ * Sales reps only ever see their own customers. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Control Report');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditControlReport';
+include('includes/header.php');
+
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text"><img src="', $RootPath, '/css/', $Theme, '/images/reports.png" title="', $Title, '" alt="" />', ' ', $Title, '</p>';
+
+if ($_SESSION['SalesmanLogin'] != '') {
+	$_POST['Salesman'] = $_SESSION['SalesmanLogin'];
+}
+if (!isset($_POST['Salesman'])) {
+	$_POST['Salesman'] = 'All';
+}
+if (!isset($_POST['Currency'])) {
+	$_POST['Currency'] = 'All';
+}
+if (!isset($_POST['ReviewDueBy'])) {
+	$_POST['ReviewDueBy'] = date('Y-m-d');
+}
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '" class="noPrint">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Report Criteria'), '</legend>
+		<field>
+			<label for="Salesman">', __('Sales Person'), ':</label>';
+if ($_SESSION['SalesmanLogin'] != '') {
+	echo '<fieldtext>', $_SESSION['UsersRealName'], '</fieldtext>';
+} else {
+	echo '<select name="Salesman">
+			<option value="All">', __('All'), '</option>';
+	$Result = DB_query("SELECT salesmancode, salesmanname FROM salesman ORDER BY salesmanname");
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<option ', ($_POST['Salesman'] == $MyRow['salesmancode'] ? 'selected="selected" ' : ''), 'value="', $MyRow['salesmancode'], '">', $MyRow['salesmanname'], '</option>';
+	}
+	echo '</select>';
+}
+echo '</field>
+		<field>
+			<label for="Currency">', __('Customer Currency'), ':</label>
+			<select name="Currency">
+				<option value="All">', __('All'), '</option>';
+$Result = DB_query("SELECT currabrev, currency FROM currencies ORDER BY currabrev");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option ', ($_POST['Currency'] == $MyRow['currabrev'] ? 'selected="selected" ' : ''), 'value="', $MyRow['currabrev'], '">', $MyRow['currabrev'], ' - ', $MyRow['currency'], '</option>';
+}
+echo '</select>
+		</field>
+		<field>
+			<label for="ReviewDueBy">', __('Reviews Due By'), ':</label>
+			<input type="date" name="ReviewDueBy" required="required" value="', $_POST['ReviewDueBy'], '" />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="View" value="', __('Show Report'), '" /></div>
+	</form>';
+
+if (isset($_POST['View']) OR $_SESSION['SalesmanLogin'] != '') {
+	$SQL = "SELECT debtorsmaster.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					debtorsmaster.creditlimit,
+					debtorsmaster.nextreviewdate,
+					holdreasons.dissallowinvoices,
+					holdreasons.reasondescription,
+					currencies.rate,
+					currencies.decimalplaces,
+					(SELECT COALESCE(SUM(debtortrans.balance),0) FROM debtortrans
+						WHERE debtortrans.debtorno=debtorsmaster.debtorno) AS balance,
+					(SELECT COALESCE(SUM(salesorderdetails.unitprice * (salesorderdetails.quantity - salesorderdetails.qtyinvoiced) * (1 - salesorderdetails.discountpercent)),0)
+						FROM salesorders INNER JOIN salesorderdetails ON salesorders.orderno=salesorderdetails.orderno
+						WHERE salesorders.debtorno=debtorsmaster.debtorno
+							AND salesorderdetails.completed=0
+							AND salesorders.quotation=0) AS openorders,
+					(SELECT dunningletters.stageno FROM dunningletters
+						WHERE dunningletters.debtorno=debtorsmaster.debtorno
+						ORDER BY dunningletters.letterdate DESC, dunningletters.letterid DESC LIMIT 1) AS laststage,
+					(SELECT dunningletters.letterdate FROM dunningletters
+						WHERE dunningletters.debtorno=debtorsmaster.debtorno
+						ORDER BY dunningletters.letterdate DESC, dunningletters.letterid DESC LIMIT 1) AS lastletterdate,
+					(SELECT MAX(custcreditreviews.reviewdate) FROM custcreditreviews
+						WHERE custcreditreviews.debtorno=debtorsmaster.debtorno) AS lastreview
+				FROM debtorsmaster
+				INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+				LEFT JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+				WHERE 1=1";
+	if ($_POST['Currency'] != 'All') {
+		$SQL .= " AND debtorsmaster.currcode='" . $_POST['Currency'] . "'";
+	}
+	if ($_POST['Salesman'] != 'All') {
+		$SQL .= " AND EXISTS (SELECT 1 FROM custbranch WHERE custbranch.debtorno=debtorsmaster.debtorno AND custbranch.salesman='" . $_POST['Salesman'] . "')";
+	}
+	$SQL .= " ORDER BY debtorsmaster.debtorno";
+	$Result = DB_query($SQL);
+
+	$FinalStages = array();
+	$StageResult = DB_query("SELECT stageno FROM dunningstages WHERE finalnotice=1");
+	while ($MyRow = DB_fetch_array($StageResult)) {
+		$FinalStages[] = $MyRow['stageno'];
+	}
+
+	$ReviewDue = array();
+	$OverLimit = array();
+	$WatchStop = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$MyRow['status'] = CreditStatusFromFlag($MyRow['dissallowinvoices']);
+		$MyRow['exposure'] = $MyRow['balance'] + $MyRow['openorders'];
+		$MyRow['overlimit'] = $MyRow['exposure'] - $MyRow['creditlimit'];
+		if (is_null($MyRow['nextreviewdate']) OR $MyRow['nextreviewdate'] <= $_POST['ReviewDueBy']) {
+			$ReviewDue[] = $MyRow;
+		}
+		if ($MyRow['overlimit'] > pow(10, -$MyRow['decimalplaces'])) {
+			$OverLimit[] = $MyRow;
+		}
+		if ($MyRow['status'] != CREDIT_STATUS_NORMAL
+			OR (!is_null($MyRow['laststage']) AND in_array($MyRow['laststage'], $FinalStages) AND $MyRow['balance'] > 0)) {
+			$WatchStop[] = $MyRow;
+		}
+	}
+
+	$HomeDecimals = $_SESSION['CompanyRecord']['decimalplaces'];
+
+	/* --- Reviews due --- */
+	echo '<table class="selection">
+			<tr><th colspan="7">', __('Customers Due Or Overdue For A Credit Review By'), ' ', ConvertSQLDate($_POST['ReviewDueBy']), '</th></tr>
+			<tr>
+				<th>', __('Customer'), '</th>
+				<th>', __('Next Review'), '</th>
+				<th>', __('Last Review'), '</th>
+				<th>', __('Credit Status'), '</th>
+				<th>', __('Credit Limit'), '</th>
+				<th>', __('Balance'), '</th>
+				<th>', __('Balance'), ' ', $_SESSION['CompanyRecord']['currencydefault'], '</th>
+			</tr>';
+	$Total = 0;
+	foreach ($ReviewDue as $MyRow) {
+		$Total += $MyRow['balance'] / $MyRow['rate'];
+		echo '<tr class="striped_row">
+				<td><a href="', $RootPath, '/CreditControl.php?DebtorNo=', urlencode($MyRow['debtorno']), '">', $MyRow['debtorno'], ' - ', htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8', false), '</a></td>
+				<td>', (is_null($MyRow['nextreviewdate']) ? __('Not set') : ConvertSQLDate($MyRow['nextreviewdate'])), '</td>
+				<td>', (is_null($MyRow['lastreview']) ? '' : ConvertSQLDate($MyRow['lastreview'])), '</td>
+				<td>', CreditStatusName($MyRow['status']), '</td>
+				<td class="number">', $MyRow['currcode'], ' ', locale_number_format($MyRow['creditlimit'], $MyRow['decimalplaces']), '</td>
+				<td class="number">', locale_number_format($MyRow['balance'], $MyRow['decimalplaces']), '</td>
+				<td class="number">', locale_number_format($MyRow['balance'] / $MyRow['rate'], $HomeDecimals), '</td>
+			</tr>';
+	}
+	echo '<tr class="total_row"><td colspan="6">', count($ReviewDue), ' ', __('customers'), '</td><td class="number">', locale_number_format($Total, $HomeDecimals), '</td></tr>
+		</table>';
+
+	/* --- Over credit limit --- */
+	echo '<table class="selection">
+			<tr><th colspan="8">', __('Customers Over Their Credit Limit (balance plus open orders)'), '</th></tr>
+			<tr>
+				<th>', __('Customer'), '</th>
+				<th>', __('Credit Status'), '</th>
+				<th>', __('Credit Limit'), '</th>
+				<th>', __('Balance'), '</th>
+				<th>', __('Open Orders'), '</th>
+				<th>', __('Over Limit By'), '</th>
+				<th>', __('Over Limit By'), ' ', $_SESSION['CompanyRecord']['currencydefault'], '</th>
+				<th>', __('Balance'), ' ', $_SESSION['CompanyRecord']['currencydefault'], '</th>
+			</tr>';
+	$TotalOver = 0;
+	$Total = 0;
+	foreach ($OverLimit as $MyRow) {
+		$TotalOver += $MyRow['overlimit'] / $MyRow['rate'];
+		$Total += $MyRow['balance'] / $MyRow['rate'];
+		echo '<tr class="striped_row">
+				<td><a href="', $RootPath, '/CreditControl.php?DebtorNo=', urlencode($MyRow['debtorno']), '">', $MyRow['debtorno'], ' - ', htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8', false), '</a></td>
+				<td>', CreditStatusName($MyRow['status']), '</td>
+				<td class="number">', $MyRow['currcode'], ' ', locale_number_format($MyRow['creditlimit'], $MyRow['decimalplaces']), '</td>
+				<td class="number">', locale_number_format($MyRow['balance'], $MyRow['decimalplaces']), '</td>
+				<td class="number">', locale_number_format($MyRow['openorders'], $MyRow['decimalplaces']), '</td>
+				<td class="number">', locale_number_format($MyRow['overlimit'], $MyRow['decimalplaces']), '</td>
+				<td class="number">', locale_number_format($MyRow['overlimit'] / $MyRow['rate'], $HomeDecimals), '</td>
+				<td class="number">', locale_number_format($MyRow['balance'] / $MyRow['rate'], $HomeDecimals), '</td>
+			</tr>';
+	}
+	echo '<tr class="total_row"><td colspan="6">', count($OverLimit), ' ', __('customers'), '</td>
+			<td class="number">', locale_number_format($TotalOver, $HomeDecimals), '</td>
+			<td class="number">', locale_number_format($Total, $HomeDecimals), '</td></tr>
+		</table>';
+
+	/* --- Watch and stop --- */
+	echo '<table class="selection">
+			<tr><th colspan="7">', __('Customers On Watch Or On Stop, And Customers Sent A Final Notice'), '</th></tr>
+			<tr>
+				<th>', __('Customer'), '</th>
+				<th>', __('Credit Status'), '</th>
+				<th>', __('Reason'), '</th>
+				<th>', __('Last Reminder'), '</th>
+				<th>', __('Credit Limit'), '</th>
+				<th>', __('Balance'), '</th>
+				<th>', __('Balance'), ' ', $_SESSION['CompanyRecord']['currencydefault'], '</th>
+			</tr>';
+	$Total = 0;
+	foreach ($WatchStop as $MyRow) {
+		$Total += $MyRow['balance'] / $MyRow['rate'];
+		$LastReminder = is_null($MyRow['laststage']) ? '' : __('Stage') . ' ' . $MyRow['laststage'] . ' ' . ConvertSQLDate($MyRow['lastletterdate']);
+		if (!is_null($MyRow['laststage']) AND in_array($MyRow['laststage'], $FinalStages) AND $MyRow['status'] != CREDIT_STATUS_STOP) {
+			$LastReminder .= ' - <b>' . __('final notice sent - decide whether to put on stop') . '</b>';
+		}
+		echo '<tr class="striped_row">
+				<td><a href="', $RootPath, '/CreditControl.php?DebtorNo=', urlencode($MyRow['debtorno']), '">', $MyRow['debtorno'], ' - ', htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8', false), '</a></td>
+				<td>', CreditStatusName($MyRow['status']), '</td>
+				<td>', $MyRow['reasondescription'], '</td>
+				<td>', $LastReminder, '</td>
+				<td class="number">', $MyRow['currcode'], ' ', locale_number_format($MyRow['creditlimit'], $MyRow['decimalplaces']), '</td>
+				<td class="number">', locale_number_format($MyRow['balance'], $MyRow['decimalplaces']), '</td>
+				<td class="number">', locale_number_format($MyRow['balance'] / $MyRow['rate'], $HomeDecimals), '</td>
+			</tr>';
+	}
+	echo '<tr class="total_row"><td colspan="6">', count($WatchStop), ' ', __('customers'), '</td><td class="number">', locale_number_format($Total, $HomeDecimals), '</td></tr>
+		</table>';
+}
+
+include('includes/footer.php');
diff --git a/CreditControlSettings.php b/CreditControlSettings.php
new file mode 100644
index 0000000..222e02b
--- /dev/null
+++ b/CreditControlSettings.php
@@ -0,0 +1,218 @@
+<?php
+
+/* Credit control settings set by Finance: review periods, holding of over limit orders, the hold reasons used for
+ * normal/watch/stop, interest rate, late fee, days overdue before charging, the GL accounts for interest income,
+ * late fee income and bad debts, the write off approval limit and the reminder letter settings.
+ * Also sets the next review date of customers that have none (existing customers when credit control goes live). */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Control Settings');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditControlSettings';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="', $RootPath, '/css/', $Theme, '/images/maintenance.png" title="', $Title, '" alt="" />', ' ', $Title, '</p>';
+
+$Settings = array('CreditReviewMonths', 'CreditReviewMonthsHighRisk', 'CreditHoldOverLimit', 'CreditNormalHoldReason', 'CreditWatchHoldReason',
+				'CreditStopHoldReason', 'CreditInterestRate', 'CreditLateFee', 'CreditChargeDaysOverdue', 'CreditInterestAct', 'CreditFeeAct',
+				'CreditBadDebtAct', 'CreditWriteOffApprovalLimit', 'DunningMinDaysBetween', 'DunningFromEmail');
+
+/* hold reasons by credit control status */
+$HoldReasons = array(0 => array(), 1 => array(), 2 => array());
+$Result = DB_query("SELECT reasoncode, reasondescription, dissallowinvoices FROM holdreasons ORDER BY reasoncode");
+while ($MyRow = DB_fetch_array($Result)) {
+	$Flag = ($MyRow['dissallowinvoices'] == 1 OR $MyRow['dissallowinvoices'] == 2) ? $MyRow['dissallowinvoices'] : 0;
+	$HoldReasons[$Flag][$MyRow['reasoncode']] = $MyRow['reasondescription'];
+}
+
+if (isset($_POST['submit'])) {
+	$InputError = 0;
+	foreach (array('CreditReviewMonths', 'CreditReviewMonthsHighRisk', 'CreditChargeDaysOverdue', 'DunningMinDaysBetween') as $Field) {
+		if (!is_numeric($_POST[$Field]) OR $_POST[$Field] < 0 OR (int)$_POST[$Field] != $_POST[$Field]) {
+			prnMsg(__('The review periods, days overdue and days between letters must be whole numbers'), 'error');
+			$InputError = 1;
+			break;
+		}
+	}
+	if ($_POST['CreditReviewMonths'] < 1 OR $_POST['CreditReviewMonthsHighRisk'] < 1) {
+		prnMsg(__('The review periods must be at least one month'), 'error');
+		$InputError = 1;
+	}
+	foreach (array('CreditInterestRate', 'CreditLateFee', 'CreditWriteOffApprovalLimit') as $Field) {
+		$_POST[$Field] = filter_number_format($_POST[$Field]);
+		if (!is_numeric($_POST[$Field]) OR $_POST[$Field] < 0) {
+			prnMsg(__('The interest rate, late fee and approval limit must be numbers of zero or more'), 'error');
+			$InputError = 1;
+			break;
+		}
+	}
+	if ($_POST['DunningFromEmail'] != '' AND !IsEmailAddress($_POST['DunningFromEmail'])) {
+		prnMsg(__('The reminder letter from email address is not a valid email address'), 'error');
+		$InputError = 1;
+	}
+	if (!isset($HoldReasons[1][$_POST['CreditStopHoldReason']]) OR !isset($HoldReasons[2][$_POST['CreditWatchHoldReason']]) OR !isset($HoldReasons[0][$_POST['CreditNormalHoldReason']])) {
+		prnMsg(__('The stop, watch and normal credit status codes must be codes set up with those statuses'), 'error');
+		$InputError = 1;
+	}
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+		foreach ($Settings as $Setting) {
+			/* insert the row if an older database does not have it yet */
+			$Result = DB_query("SELECT confname FROM config WHERE confname='" . $Setting . "'");
+			if (DB_num_rows($Result) == 0) {
+				DB_query("INSERT INTO config (confname, confvalue) VALUES ('" . $Setting . "', '" . $_POST[$Setting] . "')", __('The credit control settings could not be updated because'), '', true);
+			} else {
+				DB_query("UPDATE config SET confvalue='" . $_POST[$Setting] . "' WHERE confname='" . $Setting . "'", __('The credit control settings could not be updated because'), '', true);
+			}
+		}
+		DB_Txn_Commit();
+		prnMsg(__('The credit control settings have been updated'), 'success');
+		$ForceConfigReload = true; // Required to force a load even if stored in the session vars
+		include('includes/GetConfig.php');
+		$ForceConfigReload = false;
+	}
+}
+
+if (isset($_POST['SetReviewDates'])) {
+	if ($_POST['InitialReviewDate'] <= date('Y-m-d')) {
+		prnMsg(__('The review date must be in the future'), 'error');
+	} else {
+		$Result = DB_query("UPDATE debtorsmaster SET nextreviewdate='" . $_POST['InitialReviewDate'] . "' WHERE nextreviewdate IS NULL",
+							__('The next review dates could not be set because'));
+		prnMsg(__('The next review date has been set for the customers that did not have one'), 'success');
+	}
+}
+
+include('includes/CreditControlFunctions.php');
+foreach ($Settings as $Setting) {
+	if (!isset($_POST[$Setting]) OR isset($_POST['SetReviewDates'])) {
+		/* read as text - the session copy of numeric values is a float */
+		$_POST[$Setting] = CreditControlConfig($Setting);
+	}
+}
+
+/* P&L accounts the user may use, for the income and bad debt accounts */
+$GLAccounts = array();
+$Result = DB_query("SELECT chartmaster.accountcode, chartmaster.accountname
+					FROM chartmaster INNER JOIN accountgroups ON chartmaster.group_=accountgroups.groupname
+					INNER JOIN glaccountusers ON glaccountusers.accountcode=chartmaster.accountcode
+						AND glaccountusers.userid='" . $_SESSION['UserID'] . "' AND glaccountusers.canupd=1
+					WHERE accountgroups.pandl=1
+					ORDER BY chartmaster.accountcode");
+while ($MyRow = DB_fetch_array($Result)) {
+	$GLAccounts[$MyRow['accountcode']] = $MyRow['accountcode'] . ' - ' . $MyRow['accountname'];
+}
+
+function SettingsSelect($Name, $Options, $Selected, $AllowNone = false) {
+	$HTML = '<select name="' . $Name . '">';
+	if ($AllowNone) {
+		$HTML .= '<option value="">' . __('Not set') . '</option>';
+	}
+	foreach ($Options as $Value => $Text) {
+		$HTML .= '<option ' . ((string)$Value == (string)$Selected ? 'selected="selected" ' : '') . 'value="' . $Value . '">' . $Text . '</option>';
+	}
+	return $HTML . '</select>';
+}
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Credit Reviews And Credit Limits'), '</legend>
+		<field>
+			<label for="CreditReviewMonths">', __('Standard review period (months)'), ':</label>
+			<input type="text" class="integer" name="CreditReviewMonths" size="3" maxlength="3" value="', $_POST['CreditReviewMonths'], '" />
+		</field>
+		<field>
+			<label for="CreditReviewMonthsHighRisk">', __('Review period for customers on watch or stop (months)'), ':</label>
+			<input type="text" class="integer" name="CreditReviewMonthsHighRisk" size="3" maxlength="3" value="', $_POST['CreditReviewMonthsHighRisk'], '" />
+		</field>
+		<field>
+			<label for="CreditHoldOverLimit">', __('Hold orders that take a customer over their credit limit'), ':</label>
+			', SettingsSelect('CreditHoldOverLimit', array(1 => __('Yes - hold for credit control approval'), 0 => __('No')), $_POST['CreditHoldOverLimit']), '
+		</field>
+		<field>
+			<label for="CreditNormalHoldReason">', __('Credit status code for normal'), ':</label>
+			', SettingsSelect('CreditNormalHoldReason', $HoldReasons[0], $_POST['CreditNormalHoldReason']), '
+		</field>
+		<field>
+			<label for="CreditWatchHoldReason">', __('Credit status code for watch'), ':</label>
+			', SettingsSelect('CreditWatchHoldReason', $HoldReasons[2], $_POST['CreditWatchHoldReason']), '
+		</field>
+		<field>
+			<label for="CreditStopHoldReason">', __('Credit status code for stop'), ':</label>
+			', SettingsSelect('CreditStopHoldReason', $HoldReasons[1], $_POST['CreditStopHoldReason']), '
+			<fieldhelp>', __('Used when a customer is put on stop automatically after a bad debt write off'), '</fieldhelp>
+		</field>
+	</fieldset>
+	<fieldset>
+		<legend>', __('Interest And Late Fees'), '</legend>
+		<field>
+			<label for="CreditInterestRate">', __('Interest rate (% per annum)'), ':</label>

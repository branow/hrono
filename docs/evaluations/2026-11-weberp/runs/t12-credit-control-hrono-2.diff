+		echo '<button type="submit" name="ReleaseOrder" value="' . $MyRow['orderno'] . '">' . __('Release') . '</button>';
+	}
+	echo '</td></tr>';
+}
+echo '</table></form>';
+
+include('includes/footer.php');

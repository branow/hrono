diff --git a/CreditReview.php b/CreditReview.php
new file mode 100644
index 0000000..39ddbf7
--- /dev/null
+++ b/CreditReview.php
@@ -0,0 +1,258 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Customer Credit Review');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditReview';
+include('includes/header.php');
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+} elseif (isset($_SESSION['CustomerID']) and $_SESSION['CustomerID'] != '') {
+	$DebtorNo = $_SESSION['CustomerID'];
+} else {
+	prnMsg(__('Select a customer first'), 'info');
+	echo '<div class="centre"><a href="' . $RootPath . '/SelectCustomer.php">' . __('Select a customer') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				debtorsmaster.creditlimit,
+				debtorsmaster.nextreviewdate,
+				debtorsmaster.nointerest,
+				debtorsmaster.nofees,
+				currencies.decimalplaces
+		FROM debtorsmaster
+		INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+		WHERE debtorsmaster.debtorno='" . DB_escape_string($DebtorNo) . "'";
+$Result = DB_query($SQL);
+if (DB_num_rows($Result) == 0 or !CreditControlCanSeeCustomer($DebtorNo)) {
+	// the same message for a missing customer and for another rep's customer
+	prnMsg(__('There is no credit information available for this customer, or you are not authorised to see it'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($Result);
+$DebtorNo = $Customer['debtorno'];
+$CanEdit = CanDoCreditControl();
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . __('Credit review') . '" alt="" />' . ' ' . $Title . ' - ' . htmlspecialchars($Customer['name'], ENT_QUOTES, 'UTF-8') . ' (' . $DebtorNo . ')</p>';
+
+$Outcomes = array('confirmed' => __('Limit confirmed'),
+				'raised' => __('Limit raised'),
+				'reduced' => __('Limit reduced'),
+				'watch' => __('Put on watch'),
+				'stop' => __('Put on stop'),
+				'normal' => __('Taken off stop or watch'));
+
+/* ---- actions: only credit control may change anything ---- */
+if ($CanEdit and isset($_POST['RecordReview'])) {
+	$InputError = 0;
+	$Outcome = $_POST['Outcome'];
+	$NewLimit = filter_number_format($_POST['NewLimit']);
+	$Notes = trim($_POST['Notes']);
+	$NextReview = $_POST['NextReviewDate'];
+	if (!isset($Outcomes[$Outcome])) {
+		$InputError = 1;
+		prnMsg(__('Choose the outcome of the review'), 'error');
+	}
+	if ($NewLimit < 0 or !is_numeric($NewLimit)) {
+		$InputError = 1;
+		prnMsg(__('The new credit limit must be zero or more'), 'error');
+	}
+	if ($Outcome == 'raised' and $NewLimit <= $Customer['creditlimit']) {
+		$InputError = 1;
+		prnMsg(__('A raised limit must be more than the current limit'), 'error');
+	}
+	if ($Outcome == 'reduced' and $NewLimit >= $Customer['creditlimit']) {
+		$InputError = 1;
+		prnMsg(__('A reduced limit must be less than the current limit'), 'error');
+	}
+	if (in_array($Outcome, array('confirmed', 'watch', 'stop', 'normal'))) {
+		$NewLimit = $Customer['creditlimit']; // these outcomes leave the limit alone
+	}
+	if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $NextReview) or strtotime($NextReview) === false or $NextReview <= date('Y-m-d')) {
+		$InputError = 1;
+		prnMsg(__('The next review date must be a date in the future'), 'error');
+	}
+	if ($Notes == '' and $Outcome != 'confirmed') {
+		$InputError = 1;
+		prnMsg(__('Notes giving the reason are required'), 'error');
+	}
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+		DB_query("INSERT INTO creditreviews (debtorno, reviewdate, userid, outcome, oldlimit, newlimit, notes, nextreviewdate)
+					VALUES ('" . DB_escape_string($DebtorNo) . "', CURRENT_DATE, '" . DB_escape_string($_SESSION['UserID']) . "',
+							'" . $Outcome . "', '" . $Customer['creditlimit'] . "', '" . $NewLimit . "',
+							'" . DB_escape_string($Notes) . "', '" . $NextReview . "')",
+				__('The credit review could not be recorded because'));
+		if ($NewLimit != $Customer['creditlimit']) {
+			CreditControlSetLimit($DebtorNo, $NewLimit, $Notes);
+		}
+		if ($Outcome == 'watch' or $Outcome == 'stop' or $Outcome == 'normal') {
+			CreditControlSetStatus($DebtorNo, $Outcome, $Notes);
+		}
+		DB_query("UPDATE debtorsmaster SET nextreviewdate='" . $NextReview . "' WHERE debtorno='" . DB_escape_string($DebtorNo) . "'");
+		CreditControlLog($DebtorNo, 'review', $Customer['nextreviewdate'], $NextReview, $NewLimit, $Customer['currcode'], $Outcomes[$Outcome] . ': ' . $Notes);
+		DB_Txn_Commit();
+		prnMsg(__('The credit review has been recorded'), 'success');
+		$Result = DB_query($SQL);
+		$Customer = DB_fetch_array($Result);
+	}
+}
+
+if ($CanEdit and isset($_POST['SaveExemptions'])) {
+	$NoInterest = isset($_POST['NoInterest']) ? 1 : 0;
+	$NoFees = isset($_POST['NoFees']) ? 1 : 0;
+	if (trim($_POST['ExemptReason']) == '') {
+		prnMsg(__('A reason is required to change the interest and fee exemptions'), 'error');
+	} elseif ($NoInterest != $Customer['nointerest'] or $NoFees != $Customer['nofees']) {
+		DB_Txn_Begin();
+		DB_query("UPDATE debtorsmaster SET nointerest='" . $NoInterest . "', nofees='" . $NoFees . "' WHERE debtorno='" . DB_escape_string($DebtorNo) . "'");
+		CreditControlLog($DebtorNo, 'exemption', 'interest ' . $Customer['nointerest'] . ' fees ' . $Customer['nofees'], 'interest ' . $NoInterest . ' fees ' . $NoFees, 0, '', trim($_POST['ExemptReason']));
+		DB_Txn_Commit();
+		prnMsg(__('The exemptions have been saved'), 'success');
+		$Result = DB_query($SQL);
+		$Customer = DB_fetch_array($Result);
+	}
+}
+
+if ($CanEdit and isset($_POST['SaveDisputes'])) {
+	$Reason = trim($_POST['DisputeReason']);
+	if ($Reason == '') {
+		prnMsg(__('A reason is required to mark or clear a dispute'), 'error');
+	} else {
+		DB_Txn_Begin();
+		$InvResult = DB_query("SELECT id, type, transno, disputed, balance FROM debtortrans WHERE debtorno='" . DB_escape_string($DebtorNo) . "' AND type IN (10,70) AND balance > 0.005");
+		while ($Inv = DB_fetch_array($InvResult)) {
+			$Disputed = isset($_POST['Disputed' . $Inv['id']]) ? 1 : 0;
+			if ($Disputed != $Inv['disputed']) {
+				DB_query("UPDATE debtortrans SET disputed='" . $Disputed . "' WHERE id='" . $Inv['id'] . "'");
+				CreditControlLog($DebtorNo, 'dispute', '', ($Disputed ? __('disputed') : __('dispute settled')) . ' ' . $Inv['type'] . '/' . $Inv['transno'], $Inv['balance'], $Customer['currcode'], $Reason);
+			}
+		}
+		DB_Txn_Commit();
+		prnMsg(__('The disputed invoices have been saved'), 'success');
+	}
+}
+
+/* ---- display ---- */
+$Status = CreditControlStatus($DebtorNo);
+$Balance = CreditControlAccountBalance($DebtorNo);
+$Overdue = CreditControlNetOverdue(CreditControlOverdueItems($DebtorNo, array(10, 70)), $DebtorNo);
+$Dp = $Customer['decimalplaces'];
+
+echo '<table class="selection">
+		<tr><th>' . __('Credit status') . '</th><td><b>' . $Status['name'] . '</b>' . ($Status['description'] != '' ? ' (' . htmlspecialchars($Status['description'], ENT_QUOTES, 'UTF-8') . ')' : '') . '</td>
+			<th>' . __('Credit limit') . '</th><td class="number">' . $Customer['currcode'] . ' ' . locale_number_format($Customer['creditlimit'], $Dp) . '</td></tr>
+		<tr><th>' . __('Balance') . '</th><td class="number">' . locale_number_format($Balance, $Dp) . '</td>
+			<th>' . __('Overdue (undisputed)') . '</th><td class="number">' . locale_number_format($Overdue, $Dp) . '</td></tr>
+		<tr><th>' . __('Next review due') . '</th><td>' . ConvertSQLDate($Customer['nextreviewdate']) . '</td>
+			<th>' . __('Exempt from') . '</th><td>' . ($Customer['nointerest'] ? __('interest') . ' ' : '') . ($Customer['nofees'] ? __('fees') : '') . '</td></tr>
+	</table><br />';
+
+if ($CanEdit) {
+	$NextDefault = CreditControlDefaultNextReview();
+	$Dp = $Customer['decimalplaces'];
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+		<fieldset><legend>' . __('Record a credit review') . '</legend>
+		<field><label for="Outcome">' . __('Outcome') . ':</label><select name="Outcome" id="Outcome">';
+	foreach ($Outcomes as $Key => $Text) {
+		echo '<option value="' . $Key . '">' . $Text . '</option>';
+	}
+	echo '</select></field>
+		<field><label for="NewLimit">' . __('New credit limit (only for raised or reduced)') . ':</label>
+			<input type="text" class="number" name="NewLimit" id="NewLimit" size="12" value="' . locale_number_format($Customer['creditlimit'], $Dp) . '" /></field>
+		<field><label for="NextReviewDate">' . __('Next review date') . ':</label>
+			<input type="date" name="NextReviewDate" id="NextReviewDate" required="required" value="' . $NextDefault . '" /></field>
+		<field><label for="Notes">' . __('Notes') . ':</label><textarea name="Notes" id="Notes" rows="3" cols="50"></textarea></field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="RecordReview" value="' . __('Record Review') . '" /></div>
+		</form>';
+
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+		<fieldset><legend>' . __('Interest and late fee exemptions') . '</legend>
+		<field><label for="NoInterest">' . __('Exempt from interest') . ':</label><input type="checkbox" name="NoInterest" id="NoInterest"' . ($Customer['nointerest'] ? ' checked="checked"' : '') . ' /></field>
+		<field><label for="NoFees">' . __('Exempt from late fees') . ':</label><input type="checkbox" name="NoFees" id="NoFees"' . ($Customer['nofees'] ? ' checked="checked"' : '') . ' /></field>
+		<field><label for="ExemptReason">' . __('Reason') . ':</label><input type="text" name="ExemptReason" id="ExemptReason" size="40" maxlength="100" /></field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="SaveExemptions" value="' . __('Save Exemptions') . '" /></div>
+		</form>';
+}
+
+/* open invoices - dispute flags */
+$InvResult = DB_query("SELECT id, type, transno, trandate, balance, disputed, " . "systypes.typename
+						FROM debtortrans INNER JOIN systypes ON debtortrans.type=systypes.typeid
+						WHERE debtortrans.debtorno='" . DB_escape_string($DebtorNo) . "' AND debtortrans.type IN (10,70) AND debtortrans.balance > 0.005
+						ORDER BY debtortrans.trandate");
+if (DB_num_rows($InvResult) > 0) {
+	if ($CanEdit) {
+		echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />';
+	}
+	echo '<table class="selection"><caption>' . __('Open invoices and charges - a disputed item is not chased and not charged interest') . '</caption>
+		<tr><th>' . __('Type') . '</th><th>' . __('Number') . '</th><th>' . __('Date') . '</th><th>' . __('Balance') . '</th><th>' . __('Disputed') . '</th></tr>';
+	while ($Inv = DB_fetch_array($InvResult)) {
+		echo '<tr class="striped_row"><td>' . $Inv['typename'] . '</td><td>' . $Inv['transno'] . '</td><td>' . ConvertSQLDate($Inv['trandate']) . '</td>
+			<td class="number">' . locale_number_format($Inv['balance'], $Dp) . '</td><td>';
+		if ($CanEdit) {
+			echo '<input type="checkbox" name="Disputed' . $Inv['id'] . '"' . ($Inv['disputed'] ? ' checked="checked"' : '') . ' />';
+		} else {
+			echo ($Inv['disputed'] ? __('Yes') : '');
+		}
+		echo '</td></tr>';
+	}
+	echo '</table>';
+	if ($CanEdit) {
+		echo '<div class="centre">' . __('Reason') . ': <input type="text" name="DisputeReason" size="40" maxlength="100" />
+			<input type="submit" name="SaveDisputes" value="' . __('Save Disputed Invoices') . '" /></div></form>';
+	}
+}
+
+/* review history - rows are never changed or deleted */
+$Result = DB_query("SELECT * FROM creditreviews WHERE debtorno='" . DB_escape_string($DebtorNo) . "' ORDER BY id DESC");
+echo '<br /><table class="selection"><caption>' . __('Credit review history') . '</caption>
+	<tr><th>' . __('Date') . '</th><th>' . __('By') . '</th><th>' . __('Outcome') . '</th><th>' . __('Old limit') . '</th><th>' . __('New limit') . '</th><th>' . __('Next review') . '</th><th>' . __('Notes') . '</th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row"><td>' . ConvertSQLDate($MyRow['reviewdate']) . '</td><td>' . $MyRow['userid'] . '</td>
+		<td>' . (isset($Outcomes[$MyRow['outcome']]) ? $Outcomes[$MyRow['outcome']] : $MyRow['outcome']) . '</td>
+		<td class="number">' . locale_number_format($MyRow['oldlimit'], $Dp) . '</td><td class="number">' . locale_number_format($MyRow['newlimit'], $Dp) . '</td>
+		<td>' . ConvertSQLDate($MyRow['nextreviewdate']) . '</td><td>' . htmlspecialchars($MyRow['notes'], ENT_QUOTES, 'UTF-8') . '</td></tr>';
+}
+echo '</table>';
+
+/* everything credit control did, for the auditors */
+$Result = DB_query("SELECT * FROM creditcontrollog WHERE debtorno='" . DB_escape_string($DebtorNo) . "' ORDER BY id DESC");
+echo '<br /><table class="selection"><caption>' . __('Credit control history') . '</caption>
+	<tr><th>' . __('When') . '</th><th>' . __('By') . '</th><th>' . __('Event') . '</th><th>' . __('From') . '</th><th>' . __('To') . '</th><th>' . __('Amount') . '</th><th>' . __('Reason') . '</th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row"><td>' . ConvertSQLDateTime($MyRow['eventdate']) . '</td><td>' . $MyRow['userid'] . '</td><td>' . $MyRow['eventtype'] . '</td>
+		<td>' . htmlspecialchars($MyRow['oldvalue'], ENT_QUOTES, 'UTF-8') . '</td><td>' . htmlspecialchars($MyRow['newvalue'], ENT_QUOTES, 'UTF-8') . '</td>
+		<td class="number">' . ($MyRow['amount'] != 0 ? $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], $Dp) : '') . '</td>
+		<td>' . htmlspecialchars($MyRow['reason'], ENT_QUOTES, 'UTF-8') . '</td></tr>';
+}
+echo '</table>';
+
+/* reminders sent */
+$Result = DB_query("SELECT * FROM dunninglog WHERE debtorno='" . DB_escape_string($DebtorNo) . "' ORDER BY id DESC");
+echo '<br /><table class="selection"><caption>' . __('Reminder letters') . '</caption>
+	<tr><th>' . __('Date') . '</th><th>' . __('Stage') . '</th><th>' . __('Sent by') . '</th><th>' . __('Amount') . '</th><th>' . __('Invoices') . '</th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row"><td>' . ConvertSQLDate($MyRow['sentdate']) . '</td><td>' . $MyRow['stage'] . '</td><td>' . $MyRow['method'] . ' (' . $MyRow['userid'] . ')</td>
+		<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], $Dp) . '</td><td>' . htmlspecialchars($MyRow['invoices'], ENT_QUOTES, 'UTF-8') . '</td></tr>';
+}
+echo '</table>';
+
+include('includes/footer.php');

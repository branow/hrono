+		<td><textarea name="StageBody[' . $S . ']" rows="6" cols="60">' . htmlspecialchars($MyRow['body'], ENT_QUOTES, 'UTF-8') . '</textarea></td></tr>';
+}
+echo '</table><div class="centre"><input type="submit" name="SaveStages" value="' . __('Save Reminder Stages') . '" /></div></form>';
+
+echo '<br /><form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />

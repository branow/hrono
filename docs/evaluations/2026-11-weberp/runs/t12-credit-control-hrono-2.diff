+		$Position = '<b>' . __('Held - over credit limit') . '</b>';
+	} elseif ($MyRow['creditheld'] == 2) {
+		$Position = __('Released');
+	} elseif ($MyRow['dissallowinvoices'] == 1) {
+		$Position = '<b>' . __('Customer on stop - cannot be dispatched') . '</b>';
+	} else {
+		$Position = __('Customer on watch');
+	}
+	echo '<tr class="striped_row"><td><a href="' . $RootPath . '/OrderDetails.php?OrderNumber=' . $MyRow['orderno'] . '">' . $MyRow['orderno'] . '</a></td>
+		<td>' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td><td>' . ConvertSQLDate($MyRow['orddate']) . '</td>
+		<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['ordervalue'], 2) . '</td><td>' . $Position . '</td><td>';

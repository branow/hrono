+			$InputError = 1;
+			prnMsg(__('The interest rate, late fee and write-off limit must be zero or more'), 'error');
+			break;
+		}
+	}
+	foreach (array('CreditControlInterestAct', 'CreditControlFeeAct', 'CreditControlBadDebtAct') as $Name) {
+		$Values[$Name] = $_POST[$Name];
+		if ($Values[$Name] != '') {
+			$Result = DB_query("SELECT accountcode FROM chartmaster WHERE accountcode='" . DB_escape_string($Values[$Name]) . "'");
+			if (DB_num_rows($Result) == 0) {
+				$InputError = 1;
+				prnMsg($Values[$Name] . ' ' . __('is not a general ledger account'), 'error');
+			}
+		}
+	}
+	$Values['CreditControlStopOnWriteOff'] = isset($_POST['CreditControlStopOnWriteOff']) ? 1 : 0;
+	$Values['CreditControlStopOnFinalNotice'] = isset($_POST['CreditControlStopOnFinalNotice']) ? 1 : 0;
+	if ($InputError == 0) {
+		foreach ($Values as $Name => $Value) {
+			SaveConfigValue($Name, $Value);
+		}
+		prnMsg(__('The credit control parameters have been saved'), 'success');
+	}
+}
+
+if (isset($_POST['SaveStages'])) {
+	$InputError = 0;
+	$Stages = array();
+	$LastDays = 0;
+	foreach ($_POST['StageDays'] as $Stage => $Days) {
+		$Stage = (int)$Stage;
+		if ($Stage < 1 or ($Days === '' and $_POST['StageSubject'][$Stage] === '')) {
+			continue; // an empty row is not a stage
+		}
+		$Stages[$Stage] = array((int)$Days, $_POST['StageDescription'][$Stage], $_POST['StageSubject'][$Stage], $_POST['StageBody'][$Stage]);
+	}
+	ksort($Stages);
+	foreach ($Stages as $Stage => $Data) {
+		if ($Data[0] <= $LastDays or $Data[2] == '' or $Data[3] == '') {
+			$InputError = 1;
+			prnMsg(__('Each stage needs days overdue greater than the previous stage, a subject and the wording of the letter'), 'error');
+			break;
+		}
+		$LastDays = $Data[0];
+	}
+	if (count($Stages) == 0) {
+		$InputError = 1;
+		prnMsg(__('At least one reminder stage is required'), 'error');
+	}
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+		DB_query("DELETE FROM dunningstages");
+		foreach ($Stages as $Stage => $Data) {
+			DB_query("INSERT INTO dunningstages (stage, daysoverdue, description, subject, body)
+						VALUES ('" . $Stage . "', '" . $Data[0] . "', '" . DB_escape_string($Data[1]) . "', '" . DB_escape_string($Data[2]) . "', '" . DB_escape_string($Data[3]) . "')");
+		}
+		DB_Txn_Commit();
+		prnMsg(__('The reminder stages have been saved'), 'success');
+	}
+}
+
+if (isset($_POST['SetReviewDates'])) {
+	$Months = max(1, (int)$_POST['BulkMonths']);
+	DB_query("UPDATE debtorsmaster SET nextreviewdate = DATE_ADD(CURRENT_DATE, INTERVAL " . $Months . " MONTH) WHERE nextreviewdate <= CURRENT_DATE");
+	prnMsg(__('Next review dates have been set'), 'success');
+}
+
+/* Go live load of the status and limits kept on the old spreadsheet: debtorno,status,creditlimit,nextreviewdate */
+if (isset($_POST['LoadStatus']) and isset($_FILES['StatusFile']) and $_FILES['StatusFile']['name'] != '') {
+	$Handle = fopen($_FILES['StatusFile']['tmp_name'], 'r');
+	$Loaded = 0;
+	DB_Txn_Begin();
+	while ($Row = fgetcsv($Handle, 1000, ',')) {
+		$DebtorNo = trim($Row[0]);
+		$NewStatus = isset($Row[1]) ? strtolower(trim($Row[1])) : '';
+		$Result = DB_query("SELECT creditlimit FROM debtorsmaster WHERE debtorno='" . DB_escape_string($DebtorNo) . "'");
+		if (DB_num_rows($Result) == 0 or !in_array($NewStatus, array('normal', 'watch', 'stop'))) {
+			prnMsg(__('Row skipped') . ': ' . htmlspecialchars(implode(',', $Row), ENT_QUOTES, 'UTF-8'), 'warn');
+			continue;
+		}
+		CreditControlSetStatus($DebtorNo, $NewStatus, __('Loaded from the credit control spreadsheet at go-live'));
+		if (isset($Row[2]) and is_numeric(trim($Row[2])) and trim($Row[2]) >= 0) {
+			CreditControlSetLimit($DebtorNo, trim($Row[2]), __('Loaded from the credit control spreadsheet at go-live'));
+		}
+		if (isset($Row[3]) and preg_match('/^\d{4}-\d{2}-\d{2}$/', trim($Row[3]))) {
+			DB_query("UPDATE debtorsmaster SET nextreviewdate='" . trim($Row[3]) . "' WHERE debtorno='" . DB_escape_string($DebtorNo) . "'");
+		}
+		$Loaded++;
+	}
+	DB_Txn_Commit();
+	fclose($Handle);
+	prnMsg($Loaded . ' ' . __('customers loaded'), 'success');
+}
+
+foreach ($Params as $Name) {
+	if (!isset($_SESSION[$Name])) {
+		$_SESSION[$Name] = '';
+	}
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Parameters') . '</legend>
+	<field><label for="CreditControlReviewMonths">' . __('Standard review period (months)') . ':</label><input type="text" class="integer" name="CreditControlReviewMonths" id="CreditControlReviewMonths" size="3" value="' . $_SESSION['CreditControlReviewMonths'] . '" /></field>
+	<field><label for="CreditControlInterestRate">' . __('Interest rate on overdue balances (% per year, 0 for none)') . ':</label><input type="text" class="number" name="CreditControlInterestRate" id="CreditControlInterestRate" size="6" value="' . $_SESSION['CreditControlInterestRate'] . '" /></field>
+	<field><label for="CreditControlLateFee">' . __('Late fee per customer per month (in the home currency, 0 for none)') . ':</label><input type="text" class="number" name="CreditControlLateFee" id="CreditControlLateFee" size="8" value="' . $_SESSION['CreditControlLateFee'] . '" /></field>
+	<field><label for="CreditControlChargeDays">' . __('Days overdue before interest or a fee is charged') . ':</label><input type="text" class="integer" name="CreditControlChargeDays" id="CreditControlChargeDays" size="4" value="' . $_SESSION['CreditControlChargeDays'] . '" /></field>
+	<field><label for="CreditControlInterestAct">' . __('Interest income GL account') . ':</label><input type="text" name="CreditControlInterestAct" id="CreditControlInterestAct" size="12" maxlength="20" value="' . $_SESSION['CreditControlInterestAct'] . '" /></field>
+	<field><label for="CreditControlFeeAct">' . __('Late fee income GL account') . ':</label><input type="text" name="CreditControlFeeAct" id="CreditControlFeeAct" size="12" maxlength="20" value="' . $_SESSION['CreditControlFeeAct'] . '" /></field>
+	<field><label for="CreditControlBadDebtAct">' . __('Bad debt GL account') . ':</label><input type="text" name="CreditControlBadDebtAct" id="CreditControlBadDebtAct" size="12" maxlength="20" value="' . $_SESSION['CreditControlBadDebtAct'] . '" /></field>
+	<field><label for="CreditControlWriteOffLimit">' . __('Write-offs above this amount (home currency) need Finance Director approval') . ':</label><input type="text" class="number" name="CreditControlWriteOffLimit" id="CreditControlWriteOffLimit" size="10" value="' . $_SESSION['CreditControlWriteOffLimit'] . '" /></field>
+	<field><label for="CreditControlDunningGap">' . __('Minimum days between two reminder letters to a customer') . ':</label><input type="text" class="integer" name="CreditControlDunningGap" id="CreditControlDunningGap" size="3" value="' . $_SESSION['CreditControlDunningGap'] . '" /></field>
+	<field><label for="CreditControlStopOnWriteOff">' . __('Put the customer on stop when a debt is written off (can be overridden per write-off)') . ':</label><input type="checkbox" name="CreditControlStopOnWriteOff" id="CreditControlStopOnWriteOff"' . ($_SESSION['CreditControlStopOnWriteOff'] == 1 ? ' checked="checked"' : '') . ' /></field>
+	<field><label for="CreditControlStopOnFinalNotice">' . __('Put the customer on stop automatically when the final notice is sent') . ':</label><input type="checkbox" name="CreditControlStopOnFinalNotice" id="CreditControlStopOnFinalNotice"' . ($_SESSION['CreditControlStopOnFinalNotice'] == 1 ? ' checked="checked"' : '') . ' /></field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="SaveParams" value="' . __('Save Parameters') . '" /></div>
+	</form>';
+
+echo '<br /><form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<p>' . __('Placeholders in the wording:') . ' {name} {company} {currency} {total} {invoices} {date}</p>
+	<table class="selection"><caption>' . __('Reminder letter stages - clear the days and the subject of a row to remove the stage') . '</caption>
+	<tr><th>' . __('Stage') . '</th><th>' . __('Days overdue') . '</th><th>' . __('Description') . '</th><th>' . __('Email subject') . '</th><th>' . __('Wording') . '</th></tr>';
+$Result = DB_query("SELECT * FROM dunningstages ORDER BY stage");
+$Rows = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	$Rows[] = $MyRow;
+}
+$Rows[] = array('stage' => count($Rows) + 1, 'daysoverdue' => '', 'description' => '', 'subject' => '', 'body' => '');
+foreach ($Rows as $MyRow) {
+	$S = $MyRow['stage'];
+	echo '<tr class="striped_row"><td>' . $S . '</td>
+		<td><input type="text" class="integer" name="StageDays[' . $S . ']" size="4" value="' . $MyRow['daysoverdue'] . '" /></td>
+		<td><input type="text" name="StageDescription[' . $S . ']" size="20" maxlength="50" value="' . htmlspecialchars($MyRow['description'], ENT_QUOTES, 'UTF-8') . '" /></td>

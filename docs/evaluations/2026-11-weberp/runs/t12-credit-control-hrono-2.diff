diff --git a/sql/updates/44.php b/sql/updates/44.php
new file mode 100644
index 0000000..39d1e00
--- /dev/null
+++ b/sql/updates/44.php
@@ -0,0 +1,183 @@
+<?php
+
+// Credit control: reviews, stop/watch, reminder letters, interest and late fees, write-offs.
+// Keep in step with install/sql/tables/credit*.sql, dunning*.sql and install/sql/data/creditcontrol_*.sql
+
+// Schema - new columns on existing tables
+AddColumn('nextreviewdate', 'debtorsmaster', 'date', ' NOT NULL ', '1000-01-01', 'language_id');
+AddColumn('nointerest', 'debtorsmaster', 'tinyint', ' NOT NULL ', '0', 'nextreviewdate');
+AddColumn('nofees', 'debtorsmaster', 'tinyint', ' NOT NULL ', '0', 'nointerest');
+AddColumn('disputed', 'debtortrans', 'tinyint', ' NOT NULL ', '0', 'salesperson');
+AddColumn('creditheld', 'salesorders', 'tinyint', ' NOT NULL ', '0', 'internalcomment');
+
+// Schema - new tables
+CreateTable('creditreviews', "CREATE TABLE `creditreviews` (
+  `id` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `reviewdate` date NOT NULL DEFAULT '1000-01-01',
+  `userid` varchar(20) NOT NULL DEFAULT '',
+  `outcome` varchar(20) NOT NULL DEFAULT '',
+  `oldlimit` double NOT NULL DEFAULT '0',
+  `newlimit` double NOT NULL DEFAULT '0',
+  `notes` text DEFAULT NULL,
+  `nextreviewdate` date NOT NULL DEFAULT '1000-01-01',
+  PRIMARY KEY (`id`),
+  KEY `debtorno` (`debtorno`),
+  KEY `reviewdate` (`reviewdate`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
+
+CreateTable('creditcontrollog', "CREATE TABLE `creditcontrollog` (
+  `id` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `eventdate` datetime NOT NULL,
+  `userid` varchar(20) NOT NULL DEFAULT '',
+  `eventtype` varchar(20) NOT NULL DEFAULT '',
+  `oldvalue` varchar(50) NOT NULL DEFAULT '',
+  `newvalue` varchar(50) NOT NULL DEFAULT '',
+  `amount` double NOT NULL DEFAULT '0',
+  `currcode` char(3) NOT NULL DEFAULT '',
+  `reason` text DEFAULT NULL,
+  PRIMARY KEY (`id`),
+  KEY `debtorno` (`debtorno`,`eventdate`),
+  KEY `eventtype` (`eventtype`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
+
+CreateTable('dunningstages', "CREATE TABLE `dunningstages` (
+  `stage` tinyint NOT NULL DEFAULT '1',
+  `daysoverdue` smallint NOT NULL DEFAULT '30',
+  `description` varchar(50) NOT NULL DEFAULT '',
+  `subject` varchar(100) NOT NULL DEFAULT '',
+  `body` text DEFAULT NULL,
+  PRIMARY KEY (`stage`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
+
+CreateTable('dunninglog', "CREATE TABLE `dunninglog` (
+  `id` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `stage` tinyint NOT NULL DEFAULT '1',
+  `sentdate` date NOT NULL DEFAULT '1000-01-01',
+  `method` varchar(10) NOT NULL DEFAULT 'email',
+  `amount` double NOT NULL DEFAULT '0',
+  `currcode` char(3) NOT NULL DEFAULT '',
+  `invoices` text DEFAULT NULL,
+  `userid` varchar(20) NOT NULL DEFAULT '',
+  PRIMARY KEY (`id`),
+  KEY `debtorno` (`debtorno`,`sentdate`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
+
+CreateTable('creditcharges', "CREATE TABLE `creditcharges` (
+  `id` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `chargemonth` char(7) NOT NULL DEFAULT '',
+  `chargetype` varchar(10) NOT NULL DEFAULT 'interest',
+  `amount` double NOT NULL DEFAULT '0',
+  `currcode` char(3) NOT NULL DEFAULT '',
+  `rate` double NOT NULL DEFAULT '1',
+  `transid` int NOT NULL DEFAULT '0',
+  `transno` int NOT NULL DEFAULT '0',
+  `basis` varchar(200) NOT NULL DEFAULT '',
+  `postedby` varchar(20) NOT NULL DEFAULT '',
+  `posteddate` date NOT NULL DEFAULT '1000-01-01',
+  `waived` tinyint NOT NULL DEFAULT '0',
+  `waivetransno` int NOT NULL DEFAULT '0',
+  `waivereason` varchar(200) NOT NULL DEFAULT '',
+  PRIMARY KEY (`id`),
+  UNIQUE KEY `onechargepermonth` (`debtorno`,`chargemonth`,`chargetype`),
+  KEY `transid` (`transid`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
+
+CreateTable('creditwriteoffs', "CREATE TABLE `creditwriteoffs` (
+  `id` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `requestdate` date NOT NULL DEFAULT '1000-01-01',
+  `amount` double NOT NULL DEFAULT '0',
+  `currcode` char(3) NOT NULL DEFAULT '',
+  `homeamount` double NOT NULL DEFAULT '0',
+  `reason` text DEFAULT NULL,
+  `requestedby` varchar(20) NOT NULL DEFAULT '',
+  `status` tinyint NOT NULL DEFAULT '0' COMMENT '0 awaiting approval, 1 posted, 2 rejected',
+  `approvedby` varchar(20) NOT NULL DEFAULT '',
+  `approveddate` date NOT NULL DEFAULT '1000-01-01',
+  `transno` int NOT NULL DEFAULT '0',
+  `stopcustomer` tinyint NOT NULL DEFAULT '1',
+  PRIMARY KEY (`id`),
+  KEY `debtorno` (`debtorno`),
+  KEY `status` (`status`),
+  KEY `approveddate` (`approveddate`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
+
+// Transaction types for the debtors ledger
+NewSysType(70, 'Interest and Late Fee');
+NewSysType(71, 'Charge Waiver');
+NewSysType(72, 'Bad Debt Write-off');
+
+// Stop and watch are credit status (hold reason) records. Reuse any existing record of the same
+// meaning, otherwise create one on the next free code.
+foreach (array('Stop' => array('Credit control - on stop', 1), 'Watch' => array('Credit control - on watch', 2)) as $Which => $Reason) {
+	$Result = DB_query("SELECT reasoncode FROM holdreasons WHERE reasondescription='" . $Reason[0] . "'");
+	if (DB_num_rows($Result) == 1) {
+		$MyRow = DB_fetch_row($Result);
+		$Code = $MyRow[0];
+	} else {
+		$Result = DB_query("SELECT MAX(reasoncode) FROM holdreasons");
+		$MyRow = DB_fetch_row($Result);
+		$Code = max(89, (int)$MyRow[0]) + 1;
+		InsertRecord('holdreasons', array('reasoncode'), array($Code), array('reasoncode', 'reasondescription', 'dissallowinvoices'), array($Code, $Reason[0], $Reason[1]));
+	}
+	NewConfigValue('CreditControl' . $Which . 'Reason', $Code);
+}
+
+// Parameters
+NewConfigValue('CreditControlReviewMonths', '12');
+NewConfigValue('CreditControlInterestRate', '0');
+NewConfigValue('CreditControlLateFee', '0');
+NewConfigValue('CreditControlChargeDays', '30');
+NewConfigValue('CreditControlInterestAct', '');
+NewConfigValue('CreditControlFeeAct', '');
+NewConfigValue('CreditControlBadDebtAct', '');
+NewConfigValue('CreditControlWriteOffLimit', '500');
+NewConfigValue('CreditControlStopOnWriteOff', '1');
+NewConfigValue('CreditControlStopOnFinalNotice', '0');
+NewConfigValue('CreditControlDunningGap', '14');
+
+// Default reminder letter stages
+$Stages = array(
+	array(1, 30, 'Friendly reminder', 'Reminder: overdue invoices on your account', "Dear {name},\n\nOur records show that the invoices listed below are past their due date. If you have already paid them please disregard this letter, otherwise we would be grateful for payment.\n\n{invoices}\n\nTotal overdue: {currency} {total}\n\nKind regards\n{company}"),
+	array(2, 45, 'Second reminder', 'Second reminder: overdue invoices on your account', "Dear {name},\n\nWe wrote to you recently about the overdue invoices listed below and have not yet received payment. Please arrange payment immediately or contact us if there is a problem.\n\n{invoices}\n\nTotal overdue: {currency} {total}\n\nKind regards\n{company}"),
+	array(3, 60, 'Final notice', 'FINAL NOTICE: overdue invoices on your account', "Dear {name},\n\nDespite our earlier reminders the invoices listed below remain unpaid. Unless payment is received within 7 days your account will be put on stop and interest and late payment charges will be applied.\n\n{invoices}\n\nTotal overdue: {currency} {total}\n\nKind regards\n{company}")
+);
+foreach ($Stages as $Stage) {
+	InsertRecord('dunningstages', array('stage'), array($Stage[0]), array('stage', 'daysoverdue', 'description', 'subject', 'body'), $Stage);
+}
+
+// Security: 17 credit controller and deputy, 21 Finance Director (approval and setup)
+InsertRecord('securitytokens', array('tokenid'), array(17), array('tokenid', 'tokenname'), array(17, 'Credit control'));
+InsertRecord('securitytokens', array('tokenid'), array(21), array('tokenid', 'tokenname'), array(21, 'Credit control approval and setup'));
+foreach (array(5 => array(17), 6 => array(17, 21), 8 => array(17, 21)) as $RoleID => $Tokens) {
+	foreach ($Tokens as $TokenID) {
+		InsertRecord('securitygroups', array('secroleid', 'tokenid'), array($RoleID, $TokenID), array('secroleid', 'tokenid'), array($RoleID, $TokenID));
+	}
+}
+
+NewScript('CreditReview.php', 2);
+NewScript('CreditControlReport.php', 2);
+NewScript('CreditControlSetup.php', 21);
+NewScript('DunningRun.php', 17);
+NewScript('CreditCharges.php', 17);
+NewScript('CreditWriteOffs.php', 17);
+NewScript('CustomerCreditHistory.php', 1);
+
+NewMenuItem('AR', 'Transactions', __('Run Overdue Reminder Letters'), '/DunningRun.php', 20);
+NewMenuItem('AR', 'Transactions', __('Month End Interest and Late Fees'), '/CreditCharges.php', 21);
+NewMenuItem('AR', 'Transactions', __('Bad Debt Write-offs'), '/CreditWriteOffs.php', 22);
+NewMenuItem('AR', 'Reports', __('Credit Control Report'), '/CreditControlReport.php', 20);
+NewMenuItem('AR', 'Maintenance', __('Credit Control Setup'), '/CreditControlSetup.php', 20);
+NewMenuItem('Sales', 'Reports', __('Credit Reminders and Charges'), '/CustomerCreditHistory.php', 20);
+
+// Go live: every existing customer is "normal" with a next review date; credit control
+// can load the spreadsheet status and limits from Credit Control Setup.
+executeSQL("UPDATE debtorsmaster SET nextreviewdate = DATE_ADD(CURRENT_DATE, INTERVAL 12 MONTH) WHERE nextreviewdate = '1000-01-01'");
+
+if ($_SESSION['Updates']['Errors'] == 0) {
+	UpdateDBNo(basename(__FILE__, '.php'), __('Credit control'));
+}

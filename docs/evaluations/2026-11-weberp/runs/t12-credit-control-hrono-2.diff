new file mode 100644
index 0000000..3c6d0ee
--- /dev/null
+++ b/DunningRun.php
@@ -0,0 +1,182 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Overdue Reminder Letters');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'DunningRun';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$StageResult = DB_query("SELECT * FROM dunningstages ORDER BY stage");
+$Stages = array();
+while ($MyRow = DB_fetch_array($StageResult)) {
+	$Stages[$MyRow['stage']] = $MyRow;
+}
+if (count($Stages) == 0) {
+	prnMsg(__('No reminder stages are set up. Finance sets them up in Credit Control Setup'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$MaxStage = max(array_keys($Stages));
+$Gap = max(1, (int)$_SESSION['CreditControlDunningGap']);
+
+/* Work out who is due which letter. Only still-overdue, undisputed items count, and a customer
+ * moves up one stage at a time, never twice within the gap. */
+function DunningCandidates($Stages, $Gap) {
+	$Candidates = array();
+	$Result = DB_query("SELECT DISTINCT debtortrans.debtorno
+						FROM debtortrans
+						INNER JOIN debtorsmaster ON debtortrans.debtorno=debtorsmaster.debtorno
+						WHERE debtortrans.type IN (10,70) AND debtortrans.balance > 0.005 AND debtortrans.disputed=0");
+	$Debtors = array();
+	while ($MyRow = DB_fetch_row($Result)) {
+		$Debtors[] = $MyRow[0];
+	}
+	$FirstDays = min(array_column($Stages, 'daysoverdue'));
+	foreach ($Debtors as $DebtorNo) {
+		$Items = CreditControlOverdueItems($DebtorNo, array(10, 70), $FirstDays);
+		if (count($Items) == 0) {
+			continue;
+		}
+		$Total = CreditControlNetOverdue($Items, $DebtorNo);
+		if ($Total <= 0.005) {
+			continue; // payments on account cover what is overdue
+		}
+		$MaxDays = 0;
+		foreach ($Items as $Item) {
+			$MaxDays = max($MaxDays, $Item['daysoverdue']);
+		}
+		$Applicable = 0;
+		foreach ($Stages as $Stage => $Data) {
+			if ($MaxDays >= $Data['daysoverdue']) {
+				$Applicable = $Stage;
+			}
+		}
+		list($Last, $LastSent) = CreditControlLastStage($DebtorNo, $Items[0]['duedate']);
+		$Next = min($Applicable, $Last + 1);
+		if ($Next <= $Last) {
+			continue; // already had this stage, or paid down to a lower one
+		}
+		$Next = $Last + 1;
+		while (!isset($Stages[$Next]) and $Next <= max(array_keys($Stages))) {
+			$Next++;
+		}
+		if (!isset($Stages[$Next]) or $Stages[$Next]['daysoverdue'] > $MaxDays) {
+			continue;
+		}
+		if ($LastSent != null and $LastSent >= date('Y-m-d', strtotime('-' . $Gap . ' days'))) {
+			continue; // a letter went out recently
+		}
+		$Info = DB_fetch_array(DB_query("SELECT debtorsmaster.name, debtorsmaster.currcode, currencies.decimalplaces
+										FROM debtorsmaster INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+										WHERE debtorsmaster.debtorno='" . DB_escape_string($DebtorNo) . "'"));
+		$Candidates[$DebtorNo] = array('name' => $Info['name'], 'currcode' => $Info['currcode'], 'dp' => $Info['decimalplaces'],
+										'stage' => $Next, 'total' => $Total, 'items' => $Items, 'email' => DunningEmail($DebtorNo), 'last' => $Last);
+	}
+	return $Candidates;
+}
+
+/* The accounts contact: contacts flagged for statements, else the branch email */
+function DunningEmail($DebtorNo) {
+	$Result = DB_query("SELECT email FROM custcontacts WHERE debtorno='" . DB_escape_string($DebtorNo) . "' AND statement=1 AND email<>'' LIMIT 1");
+	if ($MyRow = DB_fetch_row($Result)) {
+		return $MyRow[0];
+	}
+	$Result = DB_query("SELECT email FROM custbranch WHERE debtorno='" . DB_escape_string($DebtorNo) . "' AND email<>'' ORDER BY branchcode LIMIT 1");
+	if ($MyRow = DB_fetch_row($Result)) {
+		return $MyRow[0];
+	}
+	return '';
+}
+
+function DunningInvoiceLines($Items, $DecimalPlaces) {
+	$Lines = '';
+	foreach ($Items as $Item) {
+		$Lines .= ($Item['type'] == 70 ? __('Charge') : __('Invoice')) . ' ' . $Item['transno'] . '  ' . __('dated') . ' ' . ConvertSQLDate($Item['trandate']) . '  ' . __('due') . ' ' . ConvertSQLDate($Item['duedate']) . '  ' . locale_number_format($Item['balance'], $DecimalPlaces) . "\n";
+	}
+	return $Lines;
+}
+
+if (isset($_POST['SendLetters']) and CanDoCreditControl()) {
+	$Candidates = DunningCandidates($Stages, $Gap);
+	$Sent = 0;
+	$Posted = array();
+	$Failed = array();
+	foreach ($Candidates as $DebtorNo => $Candidate) {
+		if (!isset($_POST['Send_' . $DebtorNo])) {
+			continue; // left out of this run
+		}
+		$Stage = $Stages[$Candidate['stage']];
+		$InvoiceLines = DunningInvoiceLines($Candidate['items'], $Candidate['dp']);
+		$Body = CreditControlLetterText($Stage['body'], $Candidate['name'], $Candidate['currcode'], $Candidate['total'], $InvoiceLines);
+		$Method = 'email';
+		if ($Candidate['email'] != '') {
+			$Mailed = SendEmailFromWebERP($_SESSION['CompanyRecord']['email'], $Candidate['email'], $Stage['subject'], $Body, array(), true);
+			if ($Mailed !== true) {
+				$Failed[] = $DebtorNo . ' ' . $Candidate['name'];
+				continue; // not recorded, so the next run tries again
+			}
+		} else {
+			$Method = 'post';
+			$Posted[$DebtorNo] = array($Candidate['name'], $Stage['subject'], $Body);
+		}
+		$InvoiceList = array();
+		foreach ($Candidate['items'] as $Item) {
+			$InvoiceList[] = $Item['type'] . '/' . $Item['transno'];
+		}
+		DB_Txn_Begin();
+		DB_query("INSERT INTO dunninglog (debtorno, stage, sentdate, method, amount, currcode, invoices, userid)
+					VALUES ('" . DB_escape_string($DebtorNo) . "', '" . $Candidate['stage'] . "', CURRENT_DATE, '" . $Method . "',
+							'" . $Candidate['total'] . "', '" . $Candidate['currcode'] . "',
+							'" . DB_escape_string(implode(', ', $InvoiceList)) . "', '" . DB_escape_string($_SESSION['UserID']) . "')");
+		CreditControlLog($DebtorNo, 'reminder', '', __('stage') . ' ' . $Candidate['stage'], $Candidate['total'], $Candidate['currcode'], $Stage['description'] . ' (' . $Method . '): ' . implode(', ', $InvoiceList));
+		if ($Candidate['stage'] == $MaxStage and $_SESSION['CreditControlStopOnFinalNotice'] == 1) {
+			CreditControlSetStatus($DebtorNo, 'stop', __('Final notice sent'));
+		}
+		DB_Txn_Commit();
+		$Sent++;
+	}
+	prnMsg($Sent . ' ' . __('reminders have been recorded'), 'success');
+	foreach ($Failed as $Line) {
+		prnMsg(__('The email could not be sent to') . ' ' . $Line, 'error');
+	}
+	foreach ($Posted as $DebtorNo => $Letter) {
+		echo '<div style="page-break-after: always; border: 1px solid #999; margin: 1em; padding: 1em;">
+			<p><b>' . __('Post this letter to') . ' ' . htmlspecialchars($Letter[0], ENT_QUOTES, 'UTF-8') . ' (' . $DebtorNo . ') - ' . __('no email address') . '</b></p>
+			<p><b>' . htmlspecialchars($Letter[1], ENT_QUOTES, 'UTF-8') . '</b></p>
+			<pre>' . htmlspecialchars($Letter[2], ENT_QUOTES, 'UTF-8') . '</pre></div>';
+	}
+	echo '<div class="centre"><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">' . __('Back to the run') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* Preview: who will get which letter */
+$Candidates = DunningCandidates($Stages, $Gap);
+if (count($Candidates) == 0) {
+	prnMsg(__('No customer is due a reminder letter today'), 'info');
+} else {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<table class="selection"><caption>' . __('Untick the customers to leave out of this run, for example where a payment has been promised') . '</caption>
+		<tr><th>' . __('Send') . '</th><th>' . __('Customer') . '</th><th>' . __('Letter') . '</th><th>' . __('Overdue') . '</th><th>' . __('Invoices') . '</th><th>' . __('Goes to') . '</th></tr>';
+	foreach ($Candidates as $DebtorNo => $Candidate) {
+		echo '<tr class="striped_row">
+			<td><input type="checkbox" name="Send_' . $DebtorNo . '" checked="checked" /></td>
+			<td><a href="' . $RootPath . '/CreditReview.php?DebtorNo=' . urlencode($DebtorNo) . '">' . htmlspecialchars($Candidate['name'], ENT_QUOTES, 'UTF-8') . '</a></td>
+			<td>' . $Candidate['stage'] . ' - ' . htmlspecialchars($Stages[$Candidate['stage']]['description'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td class="number">' . $Candidate['currcode'] . ' ' . locale_number_format($Candidate['total'], $Candidate['dp']) . '</td>
+			<td>' . count($Candidate['items']) . '</td>
+			<td>' . ($Candidate['email'] != '' ? htmlspecialchars($Candidate['email'], ENT_QUOTES, 'UTF-8') : '<b>' . __('No email address - the letter will be shown for posting') . '</b>') . '</td></tr>';
+	}
+	echo '</table>';
+	if (CanDoCreditControl()) {
+		echo '<div class="centre"><input type="submit" name="SendLetters" value="' . __('Send Reminders') . '" /></div>';
+	}
+	echo '</form>';
+}
+
+include('includes/footer.php');

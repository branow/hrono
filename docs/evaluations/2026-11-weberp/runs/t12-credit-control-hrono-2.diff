--- /dev/null
+++ b/CustomerCreditHistory.php
@@ -0,0 +1,63 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Reminders and Charges on the Account');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CustomerCreditHistory';
+include('includes/header.php');
+
+/* A customer log on only ever sees its own account, whatever is in the request.
+ * Staff pick a customer; reps are limited to their own customers. */
+if (!empty($_SESSION['CustomerLogin']) and $_SESSION['CustomerLogin'] == 1) {
+	$DebtorNo = $_SESSION['CustomerID'];
+} elseif (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_SESSION['CustomerID']) and $_SESSION['CustomerID'] != '') {
+	$DebtorNo = $_SESSION['CustomerID'];
+} else {
+	prnMsg(__('Select a customer first'), 'info');
+	echo '<div class="centre"><a href="' . $RootPath . '/SelectCustomer.php">' . __('Select a customer') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+$Result = DB_query("SELECT debtorsmaster.debtorno, debtorsmaster.name, debtorsmaster.currcode, currencies.decimalplaces
+					FROM debtorsmaster INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+					WHERE debtorsmaster.debtorno='" . DB_escape_string($DebtorNo) . "'");
+if (DB_num_rows($Result) == 0 or !CreditControlCanSeeCustomer($DebtorNo)) {
+	prnMsg(__('There is no account information available'), 'error');
+	include('includes/footer.php');
+	exit();
+}

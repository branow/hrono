diff --git a/CreditCharges.php b/CreditCharges.php
new file mode 100644
index 0000000..fafa901
--- /dev/null
+++ b/CreditCharges.php
@@ -0,0 +1,178 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Month End Interest and Late Fees');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditCharges';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/money_add.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$Rate = (float)$_SESSION['CreditControlInterestRate'];
+$FeeHome = (float)$_SESSION['CreditControlLateFee'];
+$ChargeDays = max(1, (int)$_SESSION['CreditControlChargeDays']);
+
+if ($Rate <= 0 and $FeeHome <= 0) {
+	prnMsg(__('Neither an interest rate nor a late fee is set. Finance sets them in Credit Control Setup'), 'warn');
+}
+if (($Rate > 0 and $_SESSION['CreditControlInterestAct'] == '') or ($FeeHome > 0 and $_SESSION['CreditControlFeeAct'] == '')) {
+	prnMsg(__('The income GL accounts for interest and late fees must be set in Credit Control Setup before charges can be posted'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+/* ---- waive a charge ---- */
+if (isset($_POST['Waive'])) {
+	$Reason = trim($_POST['WaiveReason']);
+	if ($Reason == '') {
+		prnMsg(__('A reason is required to waive a charge'), 'error');
+	} else {
+		DB_Txn_Begin();
+		$Done = CreditControlWaiveCharge((int)$_POST['Waive'], $Reason);
+		if ($Done) {
+			EnsureGLEntriesBalance(71, DB_fetch_row(DB_query("SELECT waivetransno FROM creditcharges WHERE id='" . (int)$_POST['Waive'] . "'"))[0]);
+			DB_Txn_Commit();
+			prnMsg(__('The charge has been waived and the reversal posted to the ledger'), 'success');
+		} else {
+			DB_Txn_Rollback();
+			prnMsg(__('That charge cannot be waived'), 'error');
+		}
+	}
+}
+
+/* The month being charged and the customers who qualify today */
+$Month = (isset($_POST['Month']) and preg_match('/^\d{4}-\d{2}$/', $_POST['Month'])) ? $_POST['Month'] : date('Y-m');
+
+function ChargeCandidates($Month, $Rate, $FeeHome, $ChargeDays) {
+	$Candidates = array();
+	$Result = DB_query("SELECT debtorsmaster.debtorno, debtorsmaster.name, debtorsmaster.currcode, debtorsmaster.nointerest, debtorsmaster.nofees,
+							currencies.rate, currencies.decimalplaces
+						FROM debtorsmaster INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+						WHERE EXISTS (SELECT 1 FROM debtortrans WHERE debtortrans.debtorno=debtorsmaster.debtorno AND debtortrans.type=10 AND debtortrans.balance > 0.005 AND debtortrans.disputed=0)
+						ORDER BY debtorsmaster.name");
+	while ($Customer = DB_fetch_array($Result)) {
+		$Items = CreditControlOverdueItems($Customer['debtorno'], array(10), $ChargeDays);
+		if (count($Items) == 0) {
+			continue;
+		}
+		// interest and fees are never charged on earlier interest and fees (type 70 is not in the list)
+		$Base = CreditControlNetOverdue($Items, $Customer['debtorno']);
+		if ($Base <= 0.005) {
+			continue;
+		}
+		$Customer['rate'] = ($Customer['rate'] > 0) ? $Customer['rate'] : 1;
+		$Interest = 0;
+		$Fee = 0;
+		if ($Rate > 0 and !$Customer['nointerest']) {
+			$Interest = round($Base * $Rate / 100 / 12, $Customer['decimalplaces']);
+		}
+		if ($FeeHome > 0 and !$Customer['nofees']) {
+			$Fee = round($FeeHome * $Customer['rate'], $Customer['decimalplaces']);
+		}
+		$Done = array();
+		$DoneResult = DB_query("SELECT chargetype FROM creditcharges WHERE debtorno='" . DB_escape_string($Customer['debtorno']) . "' AND chargemonth='" . $Month . "'");
+		while ($DoneRow = DB_fetch_row($DoneResult)) {
+			$Done[$DoneRow[0]] = true;
+		}
+		if (isset($Done['interest'])) {
+			$Interest = 0;
+		}
+		if (isset($Done['fee'])) {
+			$Fee = 0;
+		}
+		if ($Interest <= 0 and $Fee <= 0) {
+			continue;
+		}
+		$Customer['base'] = $Base;
+		$Customer['interest'] = $Interest;
+		$Customer['fee'] = $Fee;
+		$Customer['count'] = count($Items);
+		$Candidates[$Customer['debtorno']] = $Customer;
+	}
+	return $Candidates;
+}
+
+if (isset($_POST['PostCharges'])) {
+	$Candidates = ChargeCandidates($Month, $Rate, $FeeHome, $ChargeDays);
+	$Count = 0;
+	foreach ($Candidates as $DebtorNo => $Customer) {
+		if (!isset($_POST['Charge_' . $DebtorNo])) {
+			continue;
+		}
+		DB_Txn_Begin();
+		$Posted = false;
+		if ($Customer['interest'] > 0) {
+			$Basis = $Rate . '% p.a. on ' . locale_number_format($Customer['base'], $Customer['decimalplaces']) . ' ' . __('overdue more than') . ' ' . $ChargeDays . ' ' . __('days');
+			if (CreditControlPostCharge($DebtorNo, $Customer['currcode'], $Month, 'interest', $Customer['interest'], $Basis)) {
+				$Posted = true;
+			}
+		}
+		if ($Customer['fee'] > 0) {
+			$Basis = __('flat monthly fee, overdue more than') . ' ' . $ChargeDays . ' ' . __('days');
+			if (CreditControlPostCharge($DebtorNo, $Customer['currcode'], $Month, 'fee', $Customer['fee'], $Basis)) {
+				$Posted = true;
+			}
+		}
+		if ($Posted) {
+			// every charge posted for this customer in this run balances in the GL
+			$TransResult = DB_query("SELECT transno FROM creditcharges WHERE debtorno='" . DB_escape_string($DebtorNo) . "' AND chargemonth='" . $Month . "' AND posteddate=CURRENT_DATE");
+			while ($TransRow = DB_fetch_row($TransResult)) {
+				EnsureGLEntriesBalance(70, $TransRow[0]);
+			}
+			DB_Txn_Commit();
+			$Count++;
+		} else {
+			DB_Txn_Rollback();
+		}
+	}
+	prnMsg($Count . ' ' . __('customers have been charged for') . ' ' . $Month, 'success');
+}
+
+/* ---- preview ---- */
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Charges to raise') . '</legend>
+	<field><label for="Month">' . __('Month being charged (yyyy-mm)') . ':</label><input type="text" name="Month" id="Month" size="8" maxlength="7" value="' . $Month . '" /> <input type="submit" name="Preview" value="' . __('Refresh') . '" /></field>
+	<p>' . __('Interest') . ': ' . $Rate . '% ' . __('per year, one twelfth per month, on undisputed invoices overdue more than') . ' ' . $ChargeDays . ' ' . __('days') . '. ' . __('Late fee') . ': ' . locale_number_format($FeeHome, 2) . ' ' . $_SESSION['CompanyRecord']['currencydefault'] . ' ' . __('converted to the customer currency, once per customer per month') . '.</p>
+	</fieldset>';
+
+$Candidates = ChargeCandidates($Month, $Rate, $FeeHome, $ChargeDays);
+if (count($Candidates) == 0) {
+	prnMsg(__('Nothing to charge for') . ' ' . $Month, 'info');
+} else {
+	echo '<table class="selection"><caption>' . __('Untick a customer to leave them out. Charges already posted for the month are never charged again.') . '</caption>
+		<tr><th>' . __('Charge') . '</th><th>' . __('Customer') . '</th><th>' . __('Overdue balance') . '</th><th>' . __('Interest') . '</th><th>' . __('Late fee') . '</th></tr>';
+	foreach ($Candidates as $DebtorNo => $Customer) {
+		echo '<tr class="striped_row"><td><input type="checkbox" name="Charge_' . $DebtorNo . '" checked="checked" /></td>
+			<td>' . htmlspecialchars($Customer['name'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td class="number">' . $Customer['currcode'] . ' ' . locale_number_format($Customer['base'], $Customer['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($Customer['interest'], $Customer['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($Customer['fee'], $Customer['decimalplaces']) . '</td></tr>';
+	}
+	echo '</table><div class="centre"><input type="submit" name="PostCharges" value="' . __('Confirm and Post Charges') . '" onclick="return confirm(\'' . __('Post these charges to the customer accounts and the general ledger?') . '\');" /></div>';
+}
+
+/* ---- charges of the month with the waive button ---- */
+$Result = DB_query("SELECT creditcharges.*, debtorsmaster.name FROM creditcharges INNER JOIN debtorsmaster ON creditcharges.debtorno=debtorsmaster.debtorno
+					WHERE chargemonth='" . $Month . "' ORDER BY debtorsmaster.name, chargetype");
+if (DB_num_rows($Result) > 0) {
+	echo '<br /><table class="selection"><caption>' . __('Charges posted for') . ' ' . $Month . '</caption>
+		<tr><th>' . __('Customer') . '</th><th>' . __('Type') . '</th><th>' . __('Amount') . '</th><th>' . __('Basis') . '</th><th>' . __('Posted by') . '</th><th></th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row"><td>' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td><td>' . $MyRow['chargetype'] . '</td>
+			<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], 2) . '</td><td>' . htmlspecialchars($MyRow['basis'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td>' . $MyRow['postedby'] . ' ' . ConvertSQLDate($MyRow['posteddate']) . '</td><td>';
+		if ($MyRow['waived']) {
+			echo __('Waived') . ': ' . htmlspecialchars($MyRow['waivereason'], ENT_QUOTES, 'UTF-8');
+		} else {
+			echo '<button type="submit" name="Waive" value="' . $MyRow['id'] . '">' . __('Waive') . '</button>';
+		}
+		echo '</td></tr>';
+	}
+	echo '</table><div class="centre">' . __('Reason for waiving') . ': <input type="text" name="WaiveReason" size="40" maxlength="100" /></div>';
+}
+echo '</form>';
+
+include('includes/footer.php');
diff --git a/CreditControlReport.php b/CreditControlReport.php
new file mode 100644
index 0000000..bb5f164
--- /dev/null
+++ b/CreditControlReport.php
@@ -0,0 +1,196 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Control Report');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlReport';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+/* Release (or keep held) an order held for credit control */
+if (CanDoCreditControl() and isset($_POST['ReleaseOrder'])) {
+	$OrderNo = (int)$_POST['ReleaseOrder'];
+	$Result = DB_query("SELECT debtorno FROM salesorders WHERE orderno='" . $OrderNo . "' AND creditheld<>2");
+	if ($MyRow = DB_fetch_row($Result)) {
+		DB_Txn_Begin();
+		DB_query("UPDATE salesorders SET creditheld=2 WHERE orderno='" . $OrderNo . "'");
+		CreditControlLog($MyRow[0], 'order released', '', $OrderNo, 0, '', __('Order released by credit control'));
+		DB_Txn_Commit();
+		prnMsg(__('Order') . ' ' . $OrderNo . ' ' . __('has been released'), 'success');
+	}
+}
+
+$RepRestricted = ($_SESSION['SalesmanLogin'] != '');
+if ($RepRestricted) {
+	$_POST['Salesman'] = $_SESSION['SalesmanLogin'];
+}
+if (!isset($_POST['Salesman'])) {
+	$_POST['Salesman'] = '';
+}
+if (!isset($_POST['Currency'])) {
+	$_POST['Currency'] = '';
+}
+if (!isset($_POST['ReviewDays'])) {
+	$_POST['ReviewDays'] = 14;
+}
+$ReviewDays = (int)$_POST['ReviewDays'];
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Filter') . '</legend>';
+if (!$RepRestricted) {
+	echo '<field><label for="Salesman">' . __('Sales rep') . ':</label><select name="Salesman" id="Salesman"><option value="">' . __('All') . '</option>';
+	$Result = DB_query("SELECT salesmancode, salesmanname FROM salesman ORDER BY salesmanname");
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<option value="' . $MyRow['salesmancode'] . '"' . ($_POST['Salesman'] == $MyRow['salesmancode'] ? ' selected="selected"' : '') . '>' . htmlspecialchars($MyRow['salesmanname'], ENT_QUOTES, 'UTF-8') . '</option>';
+	}
+	echo '</select></field>';
+}
+echo '<field><label for="Currency">' . __('Currency') . ':</label><select name="Currency" id="Currency"><option value="">' . __('All') . '</option>';
+$Result = DB_query("SELECT currabrev FROM currencies ORDER BY currabrev");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option value="' . $MyRow['currabrev'] . '"' . ($_POST['Currency'] == $MyRow['currabrev'] ? ' selected="selected"' : '') . '>' . $MyRow['currabrev'] . '</option>';
+}
+echo '</select></field>
+	<field><label for="ReviewDays">' . __('Include reviews due within (days)') . ':</label><input type="text" class="integer" name="ReviewDays" id="ReviewDays" size="4" value="' . $ReviewDays . '" /></field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Show" value="' . __('Show') . '" /></div>
+	</form>';
+
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+
+/* one row per customer; the rep is the rep of the customer's first branch (one rep per customer) */
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				debtorsmaster.creditlimit,
+				debtorsmaster.nextreviewdate,
+				holdreasons.dissallowinvoices,
+				currencies.rate,
+				currencies.decimalplaces,
+				(SELECT SUM(debtortrans.balance) FROM debtortrans WHERE debtortrans.debtorno=debtorsmaster.debtorno) AS balance,
+				(SELECT custbranch.salesman FROM custbranch WHERE custbranch.debtorno=debtorsmaster.debtorno ORDER BY custbranch.branchcode LIMIT 1) AS salesman
+		FROM debtorsmaster
+		INNER JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+		INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+		WHERE 1=1";
+if ($_POST['Currency'] != '') {
+	$SQL .= " AND debtorsmaster.currcode='" . DB_escape_string($_POST['Currency']) . "'";
+}
+$SQL .= " HAVING 1=1";
+if ($_POST['Salesman'] != '') {
+	$SQL .= " AND salesman='" . DB_escape_string($_POST['Salesman']) . "'";
+}
+$SQL .= " ORDER BY debtorsmaster.name";
+$Result = DB_query($SQL, __('The customers could not be retrieved because'));
+
+$Due = array();
+$Over = array();
+$Flagged = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	$MyRow['balance'] = (float)$MyRow['balance'];
+	$MyRow['rate'] = ($MyRow['rate'] > 0) ? $MyRow['rate'] : 1;
+	if ($MyRow['nextreviewdate'] <= date('Y-m-d', strtotime('+' . $ReviewDays . ' days'))) {
+		$Due[] = $MyRow;
+	}
+	if ($MyRow['balance'] > $MyRow['creditlimit']) {
+		$Over[] = $MyRow;
+	}
+	if ($MyRow['dissallowinvoices'] != 0) {
+		$Flagged[] = $MyRow;
+	}
+}
+
+function CreditReportTable($Caption, $Rows, $Columns, $HomeCurrency) {
+	global $RootPath;
+	echo '<br /><table class="selection"><caption>' . $Caption . '</caption>
+		<tr><th>' . __('Customer') . '</th><th>' . __('Rep') . '</th><th>' . __('Currency') . '</th><th>' . __('Status') . '</th><th>' . __('Credit limit') . '</th><th>' . __('Balance') . '</th>';
+	foreach ($Columns as $Heading) {
+		echo '<th>' . $Heading . '</th>';
+	}
+	echo '<th>' . __('Balance') . ' (' . $HomeCurrency . ')</th></tr>';
+	$HomeTotal = 0;
+	foreach ($Rows as $Row) {
+		$Extra = '';
+		$HomeValue = $Row['balance'] / $Row['rate'];
+		if (isset($Columns['due'])) {
+			$Extra = '<td>' . ConvertSQLDate($Row['nextreviewdate']) . ($Row['nextreviewdate'] < date('Y-m-d') ? ' ' . __('(overdue)') : '') . '</td>';
+		}
+		if (isset($Columns['over'])) {
+			$Extra = '<td class="number">' . locale_number_format($Row['balance'] - $Row['creditlimit'], $Row['decimalplaces']) . '</td>';
+		}
+		if (isset($Columns['status'])) {
+			$Extra = '<td>' . ConvertSQLDate($Row['nextreviewdate']) . '</td>';
+		}
+		echo '<tr class="striped_row"><td><a href="' . $RootPath . '/CreditReview.php?DebtorNo=' . urlencode($Row['debtorno']) . '">' . htmlspecialchars($Row['name'], ENT_QUOTES, 'UTF-8') . '</a></td>
+			<td>' . $Row['salesman'] . '</td><td>' . $Row['currcode'] . '</td><td>' . CreditControlStatusName($Row['dissallowinvoices']) . '</td>
+			<td class="number">' . locale_number_format($Row['creditlimit'], $Row['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($Row['balance'], $Row['decimalplaces']) . '</td>' . $Extra . '
+			<td class="number">' . locale_number_format($HomeValue, 2) . '</td></tr>';
+		$HomeTotal += $HomeValue;
+	}
+	echo '<tr><th colspan="' . (7 + count($Columns)) . '" class="number">' . __('Total') . ' ' . $HomeCurrency . ': ' . locale_number_format($HomeTotal, 2) . '</th></tr></table>';
+}
+
+CreditReportTable(__('Customers due or overdue for a credit review'), $Due, array('due' => __('Next review')), $HomeCurrency);
+CreditReportTable(__('Customers over their credit limit'), $Over, array('over' => __('Over limit by')), $HomeCurrency);
+CreditReportTable(__('Customers on watch or on stop'), $Flagged, array('status' => __('Next review')), $HomeCurrency);
+
+/* orders held because they take the customer over the limit, and orders taken for customers on watch */
+$SQL = "SELECT salesorders.orderno,
+				salesorders.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				salesorders.orddate,
+				salesorders.creditheld,
+				holdreasons.dissallowinvoices,
+				salesorders.salesperson,
+				SUM(salesorderdetails.unitprice * (salesorderdetails.quantity - salesorderdetails.qtyinvoiced) * (1 - salesorderdetails.discountpercent)) AS ordervalue
+		FROM salesorders
+		INNER JOIN salesorderdetails ON salesorders.orderno=salesorderdetails.orderno
+		INNER JOIN debtorsmaster ON salesorders.debtorno=debtorsmaster.debtorno
+		INNER JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+		WHERE salesorders.quotation=0
+			AND salesorderdetails.completed=0
+			AND (salesorders.creditheld=1
+				OR (holdreasons.dissallowinvoices=1 AND salesorders.creditheld=0)
+				OR (holdreasons.dissallowinvoices=2 AND salesorders.orddate >= DATE_SUB(CURRENT_DATE, INTERVAL 60 DAY)))";
+if ($_POST['Salesman'] != '') {
+	$SQL .= " AND salesorders.salesperson='" . DB_escape_string($_POST['Salesman']) . "'";
+}
+if ($_POST['Currency'] != '') {
+	$SQL .= " AND debtorsmaster.currcode='" . DB_escape_string($_POST['Currency']) . "'";
+}
+$SQL .= " GROUP BY salesorders.orderno, salesorders.debtorno, debtorsmaster.name, debtorsmaster.currcode, salesorders.orddate, salesorders.creditheld, holdreasons.dissallowinvoices, salesorders.salesperson
+		ORDER BY salesorders.orddate";
+$Result = DB_query($SQL, __('The held orders could not be retrieved because'));
+echo '<br /><form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<input type="hidden" name="Salesman" value="' . htmlspecialchars($_POST['Salesman'], ENT_QUOTES, 'UTF-8') . '" />
+	<input type="hidden" name="Currency" value="' . htmlspecialchars($_POST['Currency'], ENT_QUOTES, 'UTF-8') . '" />

diff --git a/CreditWriteOffs.php b/CreditWriteOffs.php
new file mode 100644
index 0000000..fe3107b
--- /dev/null
+++ b/CreditWriteOffs.php
@@ -0,0 +1,163 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Bad Debt Write-offs');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditWriteOffs';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/money_delete.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$Limit = (float)$_SESSION['CreditControlWriteOffLimit'];
+
+/* Post a write-off request that is allowed to go through. Returns true when posted. */
+function PostWriteOffRequest($Request, $ApprovedBy) {
+	DB_Txn_Begin();
+	$TransNo = CreditControlPostWriteOff($Request['debtorno'], $Request['currcode'], $Request['amount'], $Request['reason']);
+	if ($TransNo == 0) {
+		DB_Txn_Rollback();
+		return false;
+	}
+	EnsureGLEntriesBalance(72, $TransNo);
+	DB_query("UPDATE creditwriteoffs SET status=1, approvedby='" . DB_escape_string($ApprovedBy) . "', approveddate=CURRENT_DATE, transno='" . $TransNo . "'
+				WHERE id='" . (int)$Request['id'] . "'");
+	CreditControlLog($Request['debtorno'], 'write-off', '', __('write-off') . ' ' . $TransNo, $Request['amount'], $Request['currcode'],
+		$Request['reason'] . ' (' . __('requested by') . ' ' . $Request['requestedby'] . ', ' . __('approved by') . ' ' . $ApprovedBy . ')');
+	if ($Request['stopcustomer'] == 1) {
+		CreditControlSetStatus($Request['debtorno'], 'stop', __('Debt written off'));
+	}
+	DB_Txn_Commit();
+	return true;
+}
+
+if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1 and $_SESSION['CreditControlBadDebtAct'] == '') {
+	prnMsg(__('The bad debt GL account must be set in Credit Control Setup before debts can be written off'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+if (isset($_POST['RequestWriteOff'])) {
+	$InputError = 0;
+	$DebtorNo = trim($_POST['DebtorNo']);
+	$Reason = trim($_POST['Reason']);
+	$Result = DB_query("SELECT debtorsmaster.currcode, currencies.rate, currencies.decimalplaces
+						FROM debtorsmaster INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+						WHERE debtorsmaster.debtorno='" . DB_escape_string($DebtorNo) . "'");
+	$Customer = DB_fetch_array($Result);
+	$Amount = filter_number_format($_POST['Amount']);
+	if (!$Customer) {
+		$InputError = 1;
+		prnMsg(__('That customer does not exist'), 'error');
+	} else {
+		if (!is_numeric($Amount) or $Amount <= 0) {
+			$InputError = 1;
+			prnMsg(__('The amount to write off must be more than zero'), 'error');
+		}
+		$Open = 0;
+		$OpenResult = DB_query("SELECT SUM(balance) FROM debtortrans WHERE debtorno='" . DB_escape_string($DebtorNo) . "' AND balance > 0.005");
+		$OpenRow = DB_fetch_row($OpenResult);
+		$Open = (float)$OpenRow[0];
+		$Pending = DB_fetch_row(DB_query("SELECT SUM(amount) FROM creditwriteoffs WHERE debtorno='" . DB_escape_string($DebtorNo) . "' AND status=0"));
+		if ($Amount > round($Open, $Customer['decimalplaces']) - (float)$Pending[0] + 0.005) {
+			$InputError = 1;
+			prnMsg(__('The amount is more than the unpaid balance of the customer less write-offs awaiting approval') . ' (' . locale_number_format($Open - (float)$Pending[0], $Customer['decimalplaces']) . ')', 'error');
+		}
+	}
+	if ($Reason == '') {
+		$InputError = 1;
+		prnMsg(__('A reason is required for a write-off'), 'error');
+	}
+	if ($InputError == 0) {
+		$Rate = ($Customer['rate'] > 0) ? $Customer['rate'] : 1;
+		$HomeAmount = round($Amount / $Rate, 2);
+		DB_query("INSERT INTO creditwriteoffs (debtorno, requestdate, amount, currcode, homeamount, reason, requestedby, status, stopcustomer)
+					VALUES ('" . DB_escape_string($DebtorNo) . "', CURRENT_DATE, '" . round($Amount, $Customer['decimalplaces']) . "', '" . $Customer['currcode'] . "',
+							'" . $HomeAmount . "', '" . DB_escape_string($Reason) . "', '" . DB_escape_string($_SESSION['UserID']) . "', 0,
+							'" . (isset($_POST['StopCustomer']) ? 1 : 0) . "')");
+		$RequestID = DB_Last_Insert_ID('creditwriteoffs', 'id');
+		$Request = DB_fetch_array(DB_query("SELECT * FROM creditwriteoffs WHERE id='" . (int)$RequestID . "'"));
+		if ($HomeAmount > $Limit) {
+			CreditControlLog($DebtorNo, 'write-off request', '', __('awaiting approval'), $Amount, $Customer['currcode'], $Reason);
+			prnMsg(__('The write-off is above the approval limit and has been sent to the Finance Director. Nothing is posted until it is approved'), 'info');
+		} elseif (PostWriteOffRequest($Request, $_SESSION['UserID'])) {
+			prnMsg(__('The write-off has been posted'), 'success');
+		} else {
+			prnMsg(__('The write-off could not be posted - the balance no longer covers it'), 'error');
+		}
+	}
+}
+
+if (isset($_POST['Decide']) and CanApproveCreditControl()) {
+	list($Action, $ID) = explode('_', $_POST['Decide']);
+	$Request = DB_fetch_array(DB_query("SELECT * FROM creditwriteoffs WHERE id='" . (int)$ID . "' AND status=0"));
+	if ($Request and $Action == 'approve') {
+		if (PostWriteOffRequest($Request, $_SESSION['UserID'])) {
+			prnMsg(__('The write-off has been approved and posted'), 'success');
+		} else {
+			prnMsg(__('The write-off could not be posted - the balance no longer covers it'), 'error');
+		}
+	} elseif ($Request and $Action == 'reject') {
+		DB_query("UPDATE creditwriteoffs SET status=2, approvedby='" . DB_escape_string($_SESSION['UserID']) . "', approveddate=CURRENT_DATE WHERE id='" . (int)$ID . "'");
+		CreditControlLog($Request['debtorno'], 'write-off rejected', '', '', $Request['amount'], $Request['currcode'], $Request['reason']);
+		prnMsg(__('The write-off has been rejected'), 'success');
+	}
+}
+
+if (!isset($_POST['DebtorNo'])) {
+	$_POST['DebtorNo'] = isset($_GET['DebtorNo']) ? $_GET['DebtorNo'] : (isset($_SESSION['CustomerID']) ? $_SESSION['CustomerID'] : '');
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Write off a bad debt') . '</legend>
+	<p>' . __('Write-offs above') . ' ' . locale_number_format($Limit, 2) . ' ' . $_SESSION['CompanyRecord']['currencydefault'] . ' ' . __('need Finance Director approval before they take effect') . '.</p>
+	<field><label for="DebtorNo">' . __('Customer code') . ':</label><input type="text" name="DebtorNo" id="DebtorNo" size="10" maxlength="10" required="required" value="' . htmlspecialchars($_POST['DebtorNo'], ENT_QUOTES, 'UTF-8') . '" /></field>
+	<field><label for="Amount">' . __('Amount to write off (customer currency)') . ':</label><input type="text" class="number" name="Amount" id="Amount" size="12" required="required" /></field>
+	<field><label for="Reason">' . __('Reason') . ':</label><input type="text" name="Reason" id="Reason" size="50" maxlength="200" required="required" /></field>
+	<field><label for="StopCustomer">' . __('Put the customer on stop') . ':</label><input type="checkbox" name="StopCustomer" id="StopCustomer"' . ($_SESSION['CreditControlStopOnWriteOff'] == 1 ? ' checked="checked"' : '') . ' /></field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="RequestWriteOff" value="' . __('Write Off') . '" /></div>
+	</form>';
+
+/* awaiting approval */
+$Result = DB_query("SELECT creditwriteoffs.*, debtorsmaster.name FROM creditwriteoffs INNER JOIN debtorsmaster ON creditwriteoffs.debtorno=debtorsmaster.debtorno WHERE status=0 ORDER BY id");
+if (DB_num_rows($Result) > 0) {
+	echo '<br /><form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<table class="selection"><caption>' . __('Write-offs awaiting Finance Director approval') . '</caption>
+		<tr><th>' . __('Date') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . __('Reason') . '</th><th>' . __('Requested by') . '</th><th></th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row"><td>' . ConvertSQLDate($MyRow['requestdate']) . '</td><td>' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], 2) . '</td><td>' . htmlspecialchars($MyRow['reason'], ENT_QUOTES, 'UTF-8') . '</td><td>' . $MyRow['requestedby'] . '</td><td>';
+		if (CanApproveCreditControl()) {
+			echo '<button type="submit" name="Decide" value="approve_' . $MyRow['id'] . '">' . __('Approve') . '</button> <button type="submit" name="Decide" value="reject_' . $MyRow['id'] . '">' . __('Reject') . '</button>';
+		}
+		echo '</td></tr>';
+	}
+	echo '</table></form>';
+}
+
+/* the write-off report */
+$From = (isset($_POST['From']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['From'])) ? $_POST['From'] : date('Y-m-01');
+$To = (isset($_POST['To']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['To'])) ? $_POST['To'] : date('Y-m-d');
+echo '<br /><form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset><legend>' . __('Write-off report') . '</legend>
+	<field><label for="From">' . __('From') . ':</label><input type="date" name="From" id="From" value="' . $From . '" /></field>
+	<field><label for="To">' . __('To') . ':</label><input type="date" name="To" id="To" value="' . $To . '" /></field>
+	</fieldset><div class="centre"><input type="submit" name="Report" value="' . __('Show') . '" /></div></form>';
+$Result = DB_query("SELECT creditwriteoffs.*, debtorsmaster.name FROM creditwriteoffs INNER JOIN debtorsmaster ON creditwriteoffs.debtorno=debtorsmaster.debtorno
+					WHERE status=1 AND approveddate BETWEEN '" . $From . "' AND '" . $To . "' ORDER BY approveddate, id");
+echo '<table class="selection"><tr><th>' . __('Date') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . __('Home currency') . '</th><th>' . __('Reason') . '</th><th>' . __('Requested by') . '</th><th>' . __('Approved by') . '</th><th>' . __('Transaction') . '</th></tr>';
+$HomeTotal = 0;
+while ($MyRow = DB_fetch_array($Result)) {
+	$HomeTotal += $MyRow['homeamount'];
+	echo '<tr class="striped_row"><td>' . ConvertSQLDate($MyRow['approveddate']) . '</td><td>' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+		<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], 2) . '</td><td class="number">' . locale_number_format($MyRow['homeamount'], 2) . '</td>
+		<td>' . htmlspecialchars($MyRow['reason'], ENT_QUOTES, 'UTF-8') . '</td><td>' . $MyRow['requestedby'] . '</td><td>' . $MyRow['approvedby'] . '</td><td>72/' . $MyRow['transno'] . '</td></tr>';
+}
+echo '<tr><th colspan="3">' . __('Total') . '</th><th class="number">' . locale_number_format($HomeTotal, 2) . '</th><th colspan="4"></th></tr></table>';
+
+include('includes/footer.php');
diff --git a/CustomerCreditHistory.php b/CustomerCreditHistory.php
new file mode 100644

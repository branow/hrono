diff --git a/CreditWriteOff.php b/CreditWriteOff.php
new file mode 100644
index 0000000..c04b4ad
--- /dev/null
+++ b/CreditWriteOff.php
@@ -0,0 +1,232 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+include_once('includes/CreditControlFunctions.php');
+
+$Title = __('Bad Debt Write-offs');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditWriteOff';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_delete.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$HomeDecimals = $_SESSION['CompanyRecord']['decimalplaces'];
+
+/* Post an approved write-off: a credit on the customer account allocated to the oldest open debit items, and the
+ * ledger posted debtors control credit, bad debt debit. The ledger is credited with what the debtors control account
+ * carries for the items written off (each item at its own rate), so any currency difference ends up in bad debt. */
+function CreditPostWriteOff($WriteOff, $ApprovedBy) {
+	$DebtorNo = $WriteOff['debtorno'];
+	$Amount = $WriteOff['amount'];
+
+	$Items = array();
+	$Result = DB_query("SELECT id, balance, rate FROM debtortrans
+						WHERE debtorno='" . $DebtorNo . "' AND settled=0 AND balance > 0.005
+							AND type NOT IN (" . CREDIT_TYPE_WAIVER . ", " . CREDIT_TYPE_WRITEOFF . ", 11, 12)
+						ORDER BY trandate, id");
+	$Available = 0;
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Items[] = $MyRow;
+		$Available += $MyRow['balance'];
+	}
+	if ($Amount > $Available + CurrencyTolerance($WriteOff['currcode'])) {
+		prnMsg(__('The write-off is more than the open invoices and charges of the customer'), 'error');
+		return false;
+	}
+	$Allocations = array();
+	$HomeValue = 0;
+	$Remaining = $Amount;
+	foreach ($Items as $Item) {
+		if ($Remaining <= 0.000001) {
+			break;
+		}
+		$Part = min($Remaining, $Item['balance']);
+		$Allocations[$Item['id']] = $Part;
+		$HomeValue += $Part / (($Item['rate'] > 0) ? $Item['rate'] : 1);
+		$Remaining -= $Part;
+	}
+	$Rate = ($HomeValue > 0) ? $Amount / $HomeValue : 1;
+
+	DB_Txn_Begin();
+	list($TransID, $TransNo) = CreditPostDebtorTrans($DebtorNo, CREDIT_TYPE_WRITEOFF, -$Amount, $Rate, $_SESSION['CompanyRecord']['baddebtact'],
+								__('Bad debt write-off') . ' ' . $WriteOff['writeoffid'] . ': ' . $WriteOff['reason'], '', -$HomeValue);
+	foreach ($Allocations as $ItemID => $Part) {
+		CreditAllocate($TransID, $ItemID, $Part, $WriteOff['currcode']);
+	}
+	DB_query("UPDATE creditwriteoffs SET status='A', approvedby='" . $ApprovedBy . "', approveddate='" . date('Y-m-d H:i:s') . "', debtortransid='" . $TransID . "'
+			WHERE writeoffid='" . $WriteOff['writeoffid'] . "'", '', '', true);
+	LogCreditEvent($DebtorNo, 'WRITEOFF', __('Bad debt written off, approved by') . ' ' . $ApprovedBy, $WriteOff['reason'], '', $Amount, CREDIT_TYPE_WRITEOFF, $TransNo);
+	if ($WriteOff['putonstop'] == 1) { // BR-28 unless credit control decides otherwise
+		$StopCode = GetCreditReasonCode(1);
+		if ($StopCode !== false) {
+			SetCreditStatus($DebtorNo, $StopCode, __('Bad debt written off'));
+		}
+	}
+	DB_Txn_Commit();
+	return true;
+}
+
+/* Request a write-off */
+if (isset($_POST['Request'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+	$Status = GetCreditStatus($DebtorNo);
+	$Amount = filter_number_format($_POST['Amount']);
+	$Reason = trim($_POST['Reason']);
+	$InputError = 0;
+	if ($Status === false) {
+		$InputError = 1;
+		prnMsg(__('The customer could not be found'), 'error');
+	}
+	if (!is_numeric($Amount) or $Amount <= 0) {
+		$InputError = 1;
+		prnMsg(__('The amount to write off must be a positive number'), 'error');
+	}
+	if (mb_strlen($Reason) < 3) {
+		$InputError = 1;
+		prnMsg(__('A reason must be given for a write-off'), 'error');
+	}
+	if ($_SESSION['CompanyRecord']['baddebtact'] == '0' and $_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+		$InputError = 1;
+		prnMsg(__('The bad debt GL account must be set in the Company Preferences before debts can be written off'), 'error');
+	}
+	if ($InputError == 0) {
+		$Rate = CreditCurrencyRate($Status['currcode']);
+		DB_query("INSERT INTO creditwriteoffs (debtorno, amount, currcode, reason, requestedby, requesteddate, status, putonstop)
+				VALUES ('" . $DebtorNo . "', '" . $Amount . "', '" . $Status['currcode'] . "', '" . $Reason . "', '" . $_SESSION['UserID'] . "',
+						'" . date('Y-m-d H:i:s') . "', 'P', '" . (isset($_POST['PutOnStop']) ? 1 : 0) . "')");
+		$WriteOffID = DB_Last_Insert_ID('creditwriteoffs', 'writeoffid');
+		LogCreditEvent($DebtorNo, 'WRITEOFFREQ', __('Write-off requested'), $Reason, '', $Amount);
+		$HomeAmount = $Amount / $Rate;
+		$Limit = (float) $_SESSION['CreditWriteOffLimit'];
+		if ($Limit > 0 and $HomeAmount <= $Limit) {
+			$Result = DB_query("SELECT * FROM creditwriteoffs WHERE writeoffid='" . $WriteOffID . "'");
+			if (CreditPostWriteOff(DB_fetch_array($Result), $_SESSION['UserID'])) {
+				prnMsg(__('The write-off is below the approval limit and has been posted'), 'success');
+			}
+		} else {
+			prnMsg(__('The write-off is above the approval limit and waits for the approval of the Finance Director'), 'info');
+		}
+	}
+}
+
+/* Approve or reject */
+if (isset($_POST['Approve']) or isset($_POST['Reject'])) {
+	if (!CreditUserCanApprove()) {
+		prnMsg(__('You do not have the authority to approve write-offs'), 'error');
+	} else {
+		$WriteOffID = (int) (isset($_POST['Approve']) ? $_POST['Approve'] : $_POST['Reject']);
+		$Result = DB_query("SELECT * FROM creditwriteoffs WHERE writeoffid='" . $WriteOffID . "' AND status='P'");
+		$WriteOff = DB_fetch_array($Result);
+		if ($WriteOff === false) {
+			prnMsg(__('This write-off is not waiting for approval'), 'error');
+		} elseif (isset($_POST['Approve'])) {
+			if (CreditPostWriteOff($WriteOff, $_SESSION['UserID'])) {
+				prnMsg(__('The write-off has been approved and posted'), 'success');
+			}
+		} else {
+			DB_query("UPDATE creditwriteoffs SET status='R', approvedby='" . $_SESSION['UserID'] . "', approveddate='" . date('Y-m-d H:i:s') . "' WHERE writeoffid='" . $WriteOffID . "'");
+			LogCreditEvent($WriteOff['debtorno'], 'WRITEOFFREJ', __('Write-off rejected'), '', '', $WriteOff['amount']);
+			prnMsg(__('The write-off has been rejected'), 'success');
+		}
+	}
+}
+
+$DebtorNo = isset($_GET['DebtorNo']) ? $_GET['DebtorNo'] : (isset($_POST['DebtorNo']) ? $_POST['DebtorNo'] : '');
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Request a write-off') . '</legend>
+			<field>
+				<label for="DebtorNo">' . __('Customer code') . ':</label>
+				<input type="text" name="DebtorNo" size="10" maxlength="10" value="' . $DebtorNo . '" required="required" />
+			</field>
+			<field>
+				<label for="Amount">' . __('Amount to write off (customer currency)') . ':</label>
+				<input type="text" class="number" name="Amount" size="12" required="required" />
+			</field>
+			<field>
+				<label for="Reason">' . __('Reason') . ':</label>
+				<input type="text" name="Reason" size="60" maxlength="250" required="required" />
+			</field>
+			<field>
+				<label for="PutOnStop">' . __('Put the customer on stop') . ':</label>
+				<input type="checkbox" name="PutOnStop" checked="checked" />
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Request" value="' . __('Request Write-off') . '" /></div>';
+
+/* waiting for approval */
+$Result = DB_query("SELECT writeoffid, debtorno, amount, currcode, reason, requestedby, requesteddate FROM creditwriteoffs WHERE status='P' ORDER BY writeoffid");
+if (DB_num_rows($Result) > 0) {
+	echo '<table class="selection">
+			<tr><th colspan="7">' . __('Write-offs waiting for approval') . '</th></tr>
+			<tr><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . __('Reason') . '</th><th>' . __('Requested by') . '</th><th>' . __('Date') . '</th><th colspan="2"></th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . $MyRow['debtorno'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['amount'], 2) . ' ' . $MyRow['currcode'] . '</td>
+				<td>' . htmlspecialchars($MyRow['reason'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td>' . $MyRow['requestedby'] . '</td>
+				<td>' . $MyRow['requesteddate'] . '</td>';
+		if (CreditUserCanApprove()) {
+			echo '<td><button type="submit" name="Approve" value="' . $MyRow['writeoffid'] . '">' . __('Approve') . '</button></td>
+				<td><button type="submit" name="Reject" value="' . $MyRow['writeoffid'] . '">' . __('Reject') . '</button></td>';
+		} else {
+			echo '<td colspan="2">' . __('Waiting for the Finance Director') . '</td>';
+		}
+		echo '</tr>';
+	}
+	echo '</table>';
+}
+echo '</form>';
+
+/* Report of write-offs over a period (BR-29) */
+if (!isset($_POST['FromDate'])) {
+	$_POST['FromDate'] = date('Y-m-01', mktime(0, 0, 0, date('n') - 11, 1, date('Y')));
+}
+if (!isset($_POST['ToDate'])) {
+	$_POST['ToDate'] = date('Y-m-d');
+}
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Write-off report') . '</legend>
+			<field><label for="FromDate">' . __('From') . ':</label><input type="date" name="FromDate" value="' . FormatDateForSQL($_POST['FromDate']) . '" /></field>
+			<field><label for="ToDate">' . __('To') . ':</label><input type="date" name="ToDate" value="' . FormatDateForSQL($_POST['ToDate']) . '" /></field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Report" value="' . __('Show Write-offs') . '" /></div>
+	</form>';
+
+if (isset($_POST['Report'])) {
+	$Result = DB_query("SELECT creditwriteoffs.*, debtorsmaster.name
+						FROM creditwriteoffs
+						INNER JOIN debtorsmaster ON creditwriteoffs.debtorno = debtorsmaster.debtorno
+						WHERE creditwriteoffs.requesteddate >= '" . FormatDateForSQL($_POST['FromDate']) . " 00:00:00'
+							AND creditwriteoffs.requesteddate <= '" . FormatDateForSQL($_POST['ToDate']) . " 23:59:59'
+						ORDER BY creditwriteoffs.writeoffid");
+	echo '<table class="selection">
+			<tr><th>' . __('Customer') . '</th><th>' . __('Name') . '</th><th>' . __('Amount') . '</th><th>' . __('Reason') . '</th><th>' . __('Requested by') . '</th><th>' . __('Approved by') . '</th><th>' . __('Status') . '</th></tr>';
+	$Total = 0;
+	while ($MyRow = DB_fetch_array($Result)) {
+		$StatusText = array('P' => __('Waiting for approval'), 'A' => __('Posted'), 'R' => __('Rejected'));
+		if ($MyRow['status'] == 'A') {
+			$Total += $MyRow['amount'] / CreditCurrencyRate($MyRow['currcode']);
+		}
+		echo '<tr class="striped_row">
+				<td>' . $MyRow['debtorno'] . '</td>
+				<td>' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td class="number">' . locale_number_format($MyRow['amount'], 2) . ' ' . $MyRow['currcode'] . '</td>
+				<td>' . htmlspecialchars($MyRow['reason'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td>' . $MyRow['requestedby'] . '</td>
+				<td>' . $MyRow['approvedby'] . '</td>
+				<td>' . $StatusText[$MyRow['status']] . '</td>
+			</tr>';
+	}
+	echo '<tr><td colspan="2"><b>' . __('Total posted at today\'s rates in') . ' ' . $_SESSION['CompanyRecord']['currencydefault'] . '</b></td><td class="number"><b>' . locale_number_format($Total, $HomeDecimals) . '</b></td><td colspan="4"></td></tr>
+		</table>';
+}
+
+include('includes/footer.php');

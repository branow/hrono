+					<td class="number">' . locale_number_format($Row['creditlimit'], $Row['decimalplaces']) . '</td>
+					<td class="number">' . locale_number_format($Row['balance'], $Row['decimalplaces']) . '</td>
+					<td class="number">' . $Column . '</td>
+					<td class="number">' . locale_number_format($HomeAmount, $_SESSION['CompanyRecord']['decimalplaces']) . '</td>
+				</tr>';
+		}
+		echo '<tr><td colspan="7"><b>' . __('Total') . ' (' . count($List[1]) . ')</b></td>
+				<td class="number"><b>' . locale_number_format($Total, $_SESSION['CompanyRecord']['decimalplaces']) . '</b></td></tr>
+			</table><br />';
+	}
+}
+
+include('includes/footer.php');

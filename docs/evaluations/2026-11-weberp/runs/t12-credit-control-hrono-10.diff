diff --git a/CreditDunningRun.php b/CreditDunningRun.php
new file mode 100644
index 0000000..0acb11b
--- /dev/null
+++ b/CreditDunningRun.php
@@ -0,0 +1,162 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+include_once('includes/CreditControlFunctions.php');
+
+$Title = __('Overdue Reminder Run');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditDunningRun';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/email.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Stages = array();
+$Result = DB_query("SELECT stage, daysoverdue, subject, body, autostop FROM dunningstages ORDER BY daysoverdue DESC");
+while ($MyRow = DB_fetch_array($Result)) {
+	$Stages[] = $MyRow;
+}
+if (count($Stages) == 0) {
+	prnMsg(__('No reminder stages are defined. Define them in Credit Control Settings first.'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+/* who gets which letter: only customers still overdue on non-disputed invoices, still owing a net balance, at the highest
+ * stage reached, and not the same stage again within the minimum interval (BR-15) */
+$Customers = array();
+$OverdueResult = CreditOverdueItems('', 1, false);
+while ($MyRow = DB_fetch_array($OverdueResult)) {
+	if (!isset($Customers[$MyRow['debtorno']])) {
+		$Customers[$MyRow['debtorno']] = array('items' => array(), 'maxdays' => 0, 'total' => 0);
+	}
+	$Customers[$MyRow['debtorno']]['items'][] = $MyRow;
+	$Customers[$MyRow['debtorno']]['total'] += $MyRow['balance'];
+	$Customers[$MyRow['debtorno']]['maxdays'] = max($Customers[$MyRow['debtorno']]['maxdays'], $MyRow['daysoverdue']);
+}
+
+$Run = array();
+foreach ($Customers as $DebtorNo => $Customer) {
+	$Target = false;
+	foreach ($Stages as $Stage) { // highest threshold first
+		if ($Customer['maxdays'] >= $Stage['daysoverdue']) {
+			$Target = $Stage;
+			break;
+		}
+	}
+	if ($Target === false) {
+		continue;
+	}
+	if (CreditCustomerBalance($DebtorNo) <= 0.005) {
+		continue; // paid or covered by unallocated cash
+	}
+	$Recent = DB_query("SELECT dunningid FROM dunninglog
+						WHERE debtorno='" . $DebtorNo . "' AND stage='" . $Target['stage'] . "'
+							AND sentdate > DATE_SUB(NOW(), INTERVAL " . (int) $_SESSION['CreditDunningMinDays'] . " DAY)");
+	if (DB_num_rows($Recent) > 0) {
+		continue;
+	}
+	$Status = GetCreditStatus($DebtorNo);
+	$Run[$DebtorNo] = array('stage' => $Target, 'customer' => $Customer, 'status' => $Status, 'emails' => CreditAccountsEmails($DebtorNo));
+}
+
+function CreditReminderText($DebtorNo, $Entry) {
+	$Text = $Entry['stage']['body'] . "\n\n" . $Entry['status']['name'] . ' (' . $DebtorNo . ')' . "\n\n";
+	$Decimals = CreditCurrencyDecimals($Entry['status']['currcode']);
+	$Text .= __('Invoice') . "\t" . __('Date') . "\t" . __('Due') . "\t" . __('Days overdue') . "\t" . __('Amount') . ' ' . $Entry['status']['currcode'] . "\n";
+	foreach ($Entry['customer']['items'] as $Item) {
+		$Text .= $Item['transno'] . "\t" . ConvertSQLDate($Item['trandate']) . "\t" . ConvertSQLDate($Item['duedate']) . "\t" . $Item['daysoverdue'] . "\t" . locale_number_format($Item['balance'], $Decimals) . "\n";
+	}
+	$Text .= "\n" . __('Total overdue') . ': ' . locale_number_format($Entry['customer']['total'], $Decimals) . ' ' . $Entry['status']['currcode'] . "\n";
+	return $Text;
+}
+
+function CreditRecordReminder($DebtorNo, $Entry, $Method, $EmailTo) {
+	$InvoiceList = array();
+	foreach ($Entry['customer']['items'] as $Item) {
+		$InvoiceList[] = $Item['transno'] . ' (' . locale_number_format($Item['balance'], CreditCurrencyDecimals($Entry['status']['currcode'])) . ')';
+	}
+	$SQL = "INSERT INTO dunninglog (debtorno, stage, sentdate, userid, method, emailto, currcode, amount, invoices)
+			VALUES ('" . $DebtorNo . "',
+					'" . $Entry['stage']['stage'] . "',
+					'" . date('Y-m-d H:i:s') . "',
+					'" . $_SESSION['UserID'] . "',
+					'" . $Method . "',
+					'" . DB_escape_string($EmailTo) . "',
+					'" . $Entry['status']['currcode'] . "',
+					'" . $Entry['customer']['total'] . "',
+					'" . DB_escape_string(implode(', ', $InvoiceList)) . "')";
+	DB_query($SQL, __('The reminder could not be recorded because'));
+	LogCreditEvent($DebtorNo, 'REMINDER', __('Reminder stage') . ' ' . $Entry['stage']['stage'] . ' ' . $Method, '', '', $Entry['stage']['stage']);
+	if ($Entry['stage']['autostop'] == 1) {
+		$StopCode = GetCreditReasonCode(1);
+		if ($StopCode !== false) {
+			SetCreditStatus($DebtorNo, $StopCode, __('Final reminder sent'));
+		}
+	}
+}
+
+if (isset($_POST['SendReminders']) or isset($_POST['RecordPosted'])) {
+	$Excluded = isset($_POST['Exclude']) ? $_POST['Exclude'] : array();
+	$Sent = 0;
+	foreach ($Run as $DebtorNo => $Entry) {
+		if (isset($Excluded[$DebtorNo])) {
+			continue;
+		}
+		if (isset($_POST['SendReminders']) and count($Entry['emails']) > 0) {
+			$EmailSent = SendEmailFromWebERP($_SESSION['CompanyRecord']['email'], $Entry['emails'], $Entry['stage']['subject'], CreditReminderText($DebtorNo, $Entry), array(), true);
+			if ($EmailSent === true) {
+				CreditRecordReminder($DebtorNo, $Entry, 'email', implode(', ', $Entry['emails']));
+				$Sent++;
+				unset($Run[$DebtorNo]);
+			} else {
+				prnMsg(__('The reminder to') . ' ' . $DebtorNo . ' ' . __('could not be sent') . ': ' . (is_string($EmailSent) ? $EmailSent : ''), 'error');
+			}
+		} elseif (isset($_POST['RecordPosted']) and count($Entry['emails']) == 0) {
+			CreditRecordReminder($DebtorNo, $Entry, 'post', '');
+			$Sent++;
+			unset($Run[$DebtorNo]);
+		}
+	}
+	prnMsg($Sent . ' ' . __('reminders have been recorded as sent'), 'success');
+}
+
+if (count($Run) == 0) {
+	prnMsg(__('No customers are due a reminder letter'), 'info');
+} else {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<table class="selection">
+			<tr><th colspan="9">' . __('Reminders due - tick Leave out for customers who must not be chased in this run') . '</th></tr>
+			<tr>
+				<th>' . __('Customer') . '</th>
+				<th>' . __('Name') . '</th>
+				<th>' . __('Days overdue') . '</th>
+				<th>' . __('Overdue') . '</th>
+				<th>' . __('Last stage sent') . '</th>
+				<th>' . __('Letter stage') . '</th>
+				<th>' . __('Delivery') . '</th>
+				<th>' . __('Leave out') . '</th>
+			</tr>';
+	foreach ($Run as $DebtorNo => $Entry) {
+		echo '<tr class="striped_row">
+				<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($DebtorNo) . '">' . $DebtorNo . '</a></td>
+				<td>' . htmlspecialchars($Entry['status']['name'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td class="number">' . $Entry['customer']['maxdays'] . '</td>
+				<td class="number">' . locale_number_format($Entry['customer']['total'], CreditCurrencyDecimals($Entry['status']['currcode'])) . ' ' . $Entry['status']['currcode'] . '</td>
+				<td class="number">' . CreditLastReminderStage($DebtorNo) . '</td>
+				<td class="number">' . $Entry['stage']['stage'] . '</td>
+				<td>' . (count($Entry['emails']) > 0 ? htmlspecialchars(implode(', ', $Entry['emails']), ENT_QUOTES, 'UTF-8') : '<b>' . __('No email address - letter must be posted') . '</b>') . '</td>
+				<td><input type="checkbox" name="Exclude[' . $DebtorNo . ']"' . (isset($_POST['Exclude'][$DebtorNo]) ? ' checked="checked"' : '') . ' /></td>
+			</tr>';
+	}
+	echo '</table>
+			<div class="centre">
+				<input type="submit" name="SendReminders" value="' . __('Email the Reminders') . '" />
+				<input type="submit" name="RecordPosted" value="' . __('Record Letters for Customers Without Email as Posted') . '" />
+			</div>
+		</form>';
+}
+
+include('includes/footer.php');
diff --git a/CreditOrderRelease.php b/CreditOrderRelease.php
new file mode 100644
index 0000000..f6ef15e
--- /dev/null
+++ b/CreditOrderRelease.php
@@ -0,0 +1,96 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+include_once('includes/CreditControlFunctions.php');
+
+$Title = __('Orders Held for Credit Control');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditOrderRelease';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if (isset($_POST['Release'])) {
+	$OrderNo = (int) $_POST['Release'];
+	$Result = DB_query("SELECT debtorno, creditheld FROM salesorders WHERE orderno='" . $OrderNo . "'");
+	$Order = DB_fetch_array($Result);
+	if ($Order === false) {
+		prnMsg(__('The order could not be found'), 'error');
+	} elseif (mb_strlen(trim($_POST['ReleaseReason'])) < 3) {
+		prnMsg(__('A reason must be given to release an order'), 'error');
+	} else {
+		DB_query("UPDATE salesorders SET creditheld=2, creditreleasedby='" . $_SESSION['UserID'] . "' WHERE orderno='" . $OrderNo . "'");
+		LogCreditEvent($Order['debtorno'], 'ORDERRELEASE', __('Order') . ' ' . $OrderNo . ' ' . __('released by credit control'), $_POST['ReleaseReason'], '', '', 30, $OrderNo);
+		prnMsg(__('Order') . ' ' . $OrderNo . ' ' . __('has been released and can now be dispatched and invoiced'), 'success');
+	}
+}
+
+$SQL = "SELECT salesorders.orderno,
+				salesorders.debtorno,
+				salesorders.orddate,
+				salesorders.creditheld,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				holdreasons.dissallowinvoices,
+				holdreasons.reasondescription,
+				SUM(salesorderdetails.unitprice * (salesorderdetails.quantity - salesorderdetails.qtyinvoiced) * (1 - salesorderdetails.discountpercent)) AS ordervalue
+		FROM salesorders
+		INNER JOIN salesorderdetails ON salesorders.orderno = salesorderdetails.orderno
+		INNER JOIN debtorsmaster ON salesorders.debtorno = debtorsmaster.debtorno
+		INNER JOIN holdreasons ON debtorsmaster.holdreason = holdreasons.reasoncode
+		WHERE salesorders.quotation = 0
+			AND salesorderdetails.completed = 0
+			AND (salesorders.creditheld = 1 OR holdreasons.dissallowinvoices IN (1, 2))
+		GROUP BY salesorders.orderno, salesorders.debtorno, salesorders.orddate, salesorders.creditheld, debtorsmaster.name,
+				debtorsmaster.currcode, holdreasons.dissallowinvoices, holdreasons.reasondescription
+		ORDER BY holdreasons.dissallowinvoices DESC, salesorders.orderno";
+$Result = DB_query($SQL);
+
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('There are no orders held for credit control and no open orders of customers on watch or on stop'), 'info');
+} else {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<table class="selection">
+			<tr>
+				<th>' . __('Order') . '</th>
+				<th>' . __('Date') . '</th>
+				<th>' . __('Customer') . '</th>
+				<th>' . __('Credit status') . '</th>
+				<th>' . __('Open order value') . '</th>
+				<th>' . __('Why listed') . '</th>
+				<th></th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Why = array();
+		if ($MyRow['creditheld'] == 1) {
+			$Why[] = __('Held: over credit limit');
+		}
+		if ($MyRow['creditheld'] == 2) {
+			$Why[] = __('Released by credit control');
+		}
+		if ($MyRow['dissallowinvoices'] == 1) {
+			$Why[] = __('Customer on stop');
+		}
+		if ($MyRow['dissallowinvoices'] == 2) {
+			$Why[] = __('Customer on watch');
+		}
+		$CanRelease = ($MyRow['creditheld'] != 2 and ($MyRow['creditheld'] == 1 or $MyRow['dissallowinvoices'] == 1));
+		echo '<tr class="striped_row">
+				<td><a href="' . $RootPath . '/OrderDetails.php?OrderNumber=' . $MyRow['orderno'] . '">' . $MyRow['orderno'] . '</a></td>
+				<td>' . ConvertSQLDate($MyRow['orddate']) . '</td>
+				<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . $MyRow['debtorno'] . '</a> ' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td>' . CreditStatusText($MyRow['dissallowinvoices']) . ' - ' . htmlspecialchars($MyRow['reasondescription'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td class="number">' . locale_number_format($MyRow['ordervalue'], 2) . ' ' . $MyRow['currcode'] . '</td>
+				<td>' . implode(', ', $Why) . '</td>
+				<td>' . ($CanRelease ? '<button type="submit" name="Release" value="' . $MyRow['orderno'] . '">' . __('Release') . '</button>' : '') . '</td>
+			</tr>';
+	}
+	echo '</table>
+			<div class="centre">' . __('Reason for releasing') . ': <input type="text" name="ReleaseReason" size="50" maxlength="250" /></div>
+		</form>';
+}
+
+include('includes/footer.php');
diff --git a/CreditReconciliation.php b/CreditReconciliation.php
new file mode 100644
index 0000000..23e1b19
--- /dev/null
+++ b/CreditReconciliation.php
@@ -0,0 +1,107 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+include_once('includes/CreditControlFunctions.php');
+
+$Title = __('Debtors Control Reconciliation');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditReconciliation';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/reports.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if ($_SESSION['CompanyRecord']['gllink_debtors'] != 1) {
+	prnMsg(__('Debtors are not linked to the general ledger, so there is nothing to reconcile'), 'info');
+	include('includes/footer.php');
+	exit();
+}
+
+$DebtorsAct = $_SESSION['CompanyRecord']['debtorsact'];
+$Decimals = $_SESSION['CompanyRecord']['decimalplaces'];
+
+$Result = DB_query("SELECT SUM(amount) FROM gltrans WHERE account='" . $DebtorsAct . "'");
+$MyRow = DB_fetch_row($Result);
+$GLBalance = (float) $MyRow[0];
+
+/* every customer transaction as the ledger saw it, at the rate it was posted at */
+$Result = DB_query("SELECT SUM((ovamount + ovgst + ovfreight + ovdiscount) / rate) FROM debtortrans WHERE rate > 0");
+$MyRow = DB_fetch_row($Result);
+$SubLedger = (float) $MyRow[0];
+
+/* open balances of the customers at the rate of each transaction: the figure of the customer accounts in home currency */
+$Result = DB_query("SELECT SUM(balance / rate) FROM debtortrans WHERE rate > 0");
+$MyRow = DB_fetch_row($Result);
+$Balances = (float) $MyRow[0];
+
+echo '<table class="selection">
+		<tr><th colspan="2">' . __('Debtors control account') . ' ' . $DebtorsAct . ' (' . $_SESSION['CompanyRecord']['currencydefault'] . ')</th></tr>
+		<tr><td>' . __('General ledger balance') . '</td><td class="number">' . locale_number_format($GLBalance, $Decimals) . '</td></tr>
+		<tr><td>' . __('All customer transactions at their posting rates') . '</td><td class="number">' . locale_number_format($SubLedger, $Decimals) . '</td></tr>
+		<tr><td>' . __('Difference: ledger less transactions') . '</td><td class="number"><b>' . locale_number_format($GLBalance - $SubLedger, $Decimals) . '</b></td></tr>
+		<tr><td>' . __('Total of customer balances (after allocations) at posting rates') . '</td><td class="number">' . locale_number_format($Balances, $Decimals) . '</td></tr>
+		<tr><td>' . __('Difference: ledger less customer balances') . '</td><td class="number"><b>' . locale_number_format($GLBalance - $Balances, $Decimals) . '</b></td></tr>
+	</table>';
+
+if (abs($GLBalance - $SubLedger) < 0.01 and abs($GLBalance - $Balances) < 0.01) {
+	prnMsg(__('The customer balances agree with the debtors control account'), 'success');
+} else {
+	prnMsg(__('The customer balances do not agree with the debtors control account. The lists below show why.'), 'warn');
+}
+
+/* customer transactions whose ledger entries do not match: missing postings, or exchange differences posted on allocation */
+$Result = DB_query("SELECT debtortrans.type,
+						debtortrans.transno,
+						debtortrans.debtorno,
+						debtortrans.trandate,
+						systypes.typename,
+						(debtortrans.ovamount + debtortrans.ovgst + debtortrans.ovfreight + debtortrans.ovdiscount) / debtortrans.rate AS expected,
+						COALESCE((SELECT SUM(gltrans.amount) FROM gltrans
+									WHERE gltrans.type = debtortrans.type AND gltrans.typeno = debtortrans.transno
+										AND gltrans.account = '" . $DebtorsAct . "'), 0) AS actual
+					FROM debtortrans
+					INNER JOIN systypes ON debtortrans.type = systypes.typeid
+					WHERE debtortrans.rate > 0
+					HAVING ABS(expected - actual) > 0.01
+					ORDER BY debtortrans.trandate DESC
+					LIMIT 200");
+echo '<table class="selection">
+		<tr><th colspan="6">' . __('Customer transactions whose debtors control posting differs (including exchange differences posted on allocation)') . '</th></tr>
+		<tr><th>' . __('Type') . '</th><th>' . __('Number') . '</th><th>' . __('Customer') . '</th><th>' . __('Date') . '</th><th>' . __('Customer transaction') . '</th><th>' . __('Ledger') . '</th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>' . $MyRow['typename'] . '</td>
+			<td class="number">' . $MyRow['transno'] . '</td>
+			<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . $MyRow['debtorno'] . '</a></td>
+			<td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+			<td class="number">' . locale_number_format($MyRow['expected'], $Decimals) . '</td>
+			<td class="number">' . locale_number_format($MyRow['actual'], $Decimals) . '</td>
+		</tr>';
+}
+echo '</table>';
+
+/* ledger entries on the control account that no customer transaction explains, for example manual journals */
+$Result = DB_query("SELECT gltrans.type, gltrans.typeno, systypes.typename, MIN(gltrans.trandate) AS trandate, SUM(gltrans.amount) AS amount
+					FROM gltrans
+					INNER JOIN systypes ON gltrans.type = systypes.typeid
+					WHERE gltrans.account = '" . $DebtorsAct . "'
+						AND NOT EXISTS (SELECT 1 FROM debtortrans WHERE debtortrans.type = gltrans.type AND debtortrans.transno = gltrans.typeno)
+					GROUP BY gltrans.type, gltrans.typeno, systypes.typename
+					HAVING ABS(SUM(gltrans.amount)) > 0.01
+					ORDER BY trandate DESC
+					LIMIT 200");
+echo '<table class="selection">
+		<tr><th colspan="4">' . __('Postings to the debtors control account with no customer transaction behind them (for example journals)') . '</th></tr>
+		<tr><th>' . __('Type') . '</th><th>' . __('Number') . '</th><th>' . __('Date') . '</th><th>' . __('Amount') . '</th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>' . $MyRow['typename'] . '</td>
+			<td class="number">' . $MyRow['typeno'] . '</td>
+			<td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+			<td class="number">' . locale_number_format($MyRow['amount'], $Decimals) . '</td>
+		</tr>';
+}
+echo '</table>';
+
+include('includes/footer.php');

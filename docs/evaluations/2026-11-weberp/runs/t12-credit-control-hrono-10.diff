diff --git a/CreditCharges.php b/CreditCharges.php
new file mode 100644
index 0000000..e04b8cd
--- /dev/null
+++ b/CreditCharges.php
@@ -0,0 +1,212 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+include_once('includes/CreditControlFunctions.php');
+
+$Title = __('Interest and Late Fees');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditCharges';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_add.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$InterestRate = (float) $_SESSION['CreditInterestRate'];
+$LateFee = (float) $_SESSION['CreditLateFee'];
+$ChargeDays = (int) $_SESSION['CreditChargeDays'];
+
+/* Waive a charge: a credit of the same amount, at the same rate, allocated to the charge, with the ledger reversed */
+if (isset($_POST['Waive'])) {
+	$ChargeID = (int) $_POST['Waive'];
+	$Reason = trim($_POST['WaiveReason']);
+	$Result = DB_query("SELECT creditcharges.chargeid, creditcharges.debtorno, creditcharges.chargetype, creditcharges.waived,
+							debtortrans.id, debtortrans.balance, debtortrans.rate, debtortrans.transno, debtorsmaster.currcode
+						FROM creditcharges
+						INNER JOIN debtortrans ON creditcharges.debtortransid = debtortrans.id
+						INNER JOIN debtorsmaster ON creditcharges.debtorno = debtorsmaster.debtorno
+						WHERE creditcharges.chargeid = '" . $ChargeID . "'");
+	$Charge = DB_fetch_array($Result);
+	if (mb_strlen($Reason) < 3) {
+		prnMsg(__('A reason must be given to waive a charge'), 'error');
+	} elseif ($Charge === false or $Charge['waived'] == 1 or $Charge['balance'] <= 0.005) {
+		prnMsg(__('This charge has already been waived or paid and cannot be waived'), 'error');
+	} else {
+		$Account = ($Charge['chargetype'] == 'I') ? $_SESSION['CompanyRecord']['interestincomeact'] : $_SESSION['CompanyRecord']['latefeeact'];
+		DB_Txn_Begin();
+		list($WaiverID, $WaiverNo) = CreditPostDebtorTrans($Charge['debtorno'], CREDIT_TYPE_WAIVER, -$Charge['balance'], $Charge['rate'], $Account,
+								__('Waiver of charge') . ' ' . $Charge['transno'] . ': ' . $Reason);
+		CreditAllocate($WaiverID, $Charge['id'], $Charge['balance'], $Charge['currcode']);
+		DB_query("UPDATE creditcharges SET waived=1, waivedtransid='" . $WaiverID . "' WHERE chargeid='" . $ChargeID . "'", '', '', true);
+		LogCreditEvent($Charge['debtorno'], 'WAIVER', __('Charge') . ' ' . $Charge['transno'] . ' ' . __('waived'), $Reason, $Charge['balance'], 0, CREDIT_TYPE_WAIVER, $WaiverNo);
+		DB_Txn_Commit();
+		prnMsg(__('The charge has been waived and the reversal posted to the general ledger'), 'success');
+	}
+}
+
+/* The month being charged */
+$Months = array();
+for ($i = 0; $i < 3; $i++) {
+	$Months[] = date('Y-m', mktime(0, 0, 0, date('n') - $i, 1, date('Y')));
+}
+$ChargeMonth = (isset($_POST['ChargeMonth']) and in_array($_POST['ChargeMonth'], $Months)) ? $_POST['ChargeMonth'] : $Months[0];
+
+if ($InterestRate <= 0 and $LateFee <= 0) {
+	prnMsg(__('No interest rate or late fee is set. Set them in Credit Control Settings.'), 'warn');
+} elseif (($InterestRate > 0 and $_SESSION['CompanyRecord']['interestincomeact'] == '0')
+		or ($LateFee > 0 and $_SESSION['CompanyRecord']['latefeeact'] == '0')) {
+	prnMsg(__('The interest income and late fee income GL accounts must be set in the Company Preferences before charges can be raised.'), 'error');
+} else {
+	/* what would be charged: overdue items past the charge days, not disputed, customers not exempt, month not charged before */
+	$Charges = array();
+	$OverdueResult = CreditOverdueItems('', max(1, $ChargeDays), false);
+	$Base = array();
+	while ($MyRow = DB_fetch_array($OverdueResult)) {
+		/* interest is charged on invoices and debtor journals, never on charges raised earlier (no interest on interest) */
+		if ($MyRow['type'] == CREDIT_TYPE_CHARGE) {
+			continue;
+		}
+		if (!isset($Base[$MyRow['debtorno']])) {
+			$Base[$MyRow['debtorno']] = 0;
+		}
+		$Base[$MyRow['debtorno']] += $MyRow['balance'];
+	}
+	/* a customer owing only on charges can still be charged the fee, so include them */
+	$OverdueResult = CreditOverdueItems('', max(1, $ChargeDays), false);
+	while ($MyRow = DB_fetch_array($OverdueResult)) {
+		if (!isset($Base[$MyRow['debtorno']])) {
+			$Base[$MyRow['debtorno']] = 0;
+		}
+	}
+	foreach ($Base as $DebtorNo => $Overdue) {
+		$Status = GetCreditStatus($DebtorNo);
+		$Decimals = CreditCurrencyDecimals($Status['currcode']);
+		$Rate = CreditCurrencyRate($Status['currcode']);
+		$Interest = 0;
+		$Fee = 0;
+		if ($InterestRate > 0 and !$Status['interestexempt']) {
+			$Interest = round($Overdue * $InterestRate / 100 / 12, $Decimals);
+		}
+		if ($LateFee > 0 and !$Status['feeexempt']) {
+			$Fee = round($LateFee * $Rate, $Decimals);
+		}
+		$Done = DB_query("SELECT chargetype FROM creditcharges WHERE debtorno='" . $DebtorNo . "' AND chargemonth='" . $ChargeMonth . "'");
+		while ($DoneRow = DB_fetch_row($Done)) {
+			if ($DoneRow[0] == 'I') {
+				$Interest = 0;
+			} else {
+				$Fee = 0;
+			}
+		}
+		if ($Interest < CurrencyTolerance($Status['currcode'])) {
+			$Interest = 0;
+		}
+		if ($Fee < CurrencyTolerance($Status['currcode'])) {
+			$Fee = 0;
+		}
+		if ($Interest > 0 or $Fee > 0) {
+			$Charges[$DebtorNo] = array('status' => $Status, 'overdue' => $Overdue, 'interest' => $Interest, 'fee' => $Fee, 'rate' => $Rate, 'decimals' => $Decimals);
+		}
+	}
+
+	if (isset($_POST['PostCharges'])) {
+		$Excluded = isset($_POST['Exclude']) ? $_POST['Exclude'] : array();
+		$Posted = 0;
+		foreach ($Charges as $DebtorNo => $Charge) {
+			if (isset($Excluded[$DebtorNo])) {
+				continue;
+			}
+			DB_Txn_Begin();
+			foreach (array('I' => array($Charge['interest'], $_SESSION['CompanyRecord']['interestincomeact'], __('Interest on overdue balance')),
+						'F' => array($Charge['fee'], $_SESSION['CompanyRecord']['latefeeact'], __('Late payment fee'))) as $Type => $Detail) {
+				if ($Detail[0] > 0) {
+					list($TransID, $TransNo) = CreditPostDebtorTrans($DebtorNo, CREDIT_TYPE_CHARGE, $Detail[0], $Charge['rate'], $Detail[1], $Detail[2] . ' ' . $ChargeMonth);
+					DB_query("INSERT INTO creditcharges (debtorno, chargemonth, chargetype, amount, debtortransid)
+							VALUES ('" . $DebtorNo . "', '" . $ChargeMonth . "', '" . $Type . "', '" . $Detail[0] . "', '" . $TransID . "')",
+							__('The charge has already been raised for this customer and month, or could not be recorded because'), '', true);
+					LogCreditEvent($DebtorNo, 'CHARGE', $Detail[2] . ' ' . $ChargeMonth, '', '', $Detail[0], CREDIT_TYPE_CHARGE, $TransNo);
+				}
+			}
+			DB_Txn_Commit();
+			unset($Charges[$DebtorNo]);
+			$Posted++;
+		}
+		prnMsg($Posted . ' ' . __('customers have been charged for') . ' ' . $ChargeMonth, 'success');
+	}
+
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<fieldset>
+				<legend>' . __('Month end charges') . '</legend>
+				<field>
+					<label for="ChargeMonth">' . __('Month to charge') . ':</label>
+					<select name="ChargeMonth">';
+	foreach ($Months as $Month) {
+		echo '<option value="' . $Month . '"' . ($Month == $ChargeMonth ? ' selected="selected"' : '') . '>' . $Month . '</option>';
+	}
+	echo '</select> <input type="submit" name="Preview" value="' . __('Show What Will Be Charged') . '" />
+				</field>
+				<field><label>' . __('Annual interest rate') . ':</label><fieldtext>' . locale_number_format($InterestRate, 2) . '%</fieldtext></field>
+				<field><label>' . __('Late fee') . ':</label><fieldtext>' . locale_number_format($LateFee, 2) . ' ' . $HomeCurrency . '</fieldtext></field>
+				<field><label>' . __('Charged when overdue by more than') . ':</label><fieldtext>' . $ChargeDays . ' ' . __('days') . '</fieldtext></field>
+			</fieldset>';
+
+	if (count($Charges) == 0) {
+		prnMsg(__('Nobody is due a charge for') . ' ' . $ChargeMonth, 'info');
+	} else {
+		echo '<table class="selection">
+				<tr><th colspan="7">' . __('Charges for') . ' ' . $ChargeMonth . '</th></tr>
+				<tr><th>' . __('Customer') . '</th><th>' . __('Name') . '</th><th>' . __('Currency') . '</th><th>' . __('Overdue balance') . '</th><th>' . __('Interest') . '</th><th>' . __('Late fee') . '</th><th>' . __('Leave out') . '</th></tr>';
+		foreach ($Charges as $DebtorNo => $Charge) {
+			echo '<tr class="striped_row">
+					<td>' . $DebtorNo . '</td>
+					<td>' . htmlspecialchars($Charge['status']['name'], ENT_QUOTES, 'UTF-8') . '</td>
+					<td>' . $Charge['status']['currcode'] . '</td>
+					<td class="number">' . locale_number_format($Charge['overdue'], $Charge['decimals']) . '</td>
+					<td class="number">' . locale_number_format($Charge['interest'], $Charge['decimals']) . '</td>
+					<td class="number">' . locale_number_format($Charge['fee'], $Charge['decimals']) . '</td>
+					<td><input type="checkbox" name="Exclude[' . $DebtorNo . ']" /></td>
+				</tr>';
+		}
+		echo '</table>
+				<div class="centre"><input type="submit" name="PostCharges" value="' . __('Confirm and Post These Charges') . '" onclick="return confirm(\'' . __('Post these charges to the customer accounts and the general ledger?') . '\');" /></div>';
+	}
+	echo '</form>';
+}
+
+/* Charges raised, with the means to waive them */
+$Filter = '';
+if (isset($_GET['DebtorNo'])) {
+	$Filter = " AND creditcharges.debtorno = '" . $_GET['DebtorNo'] . "'";
+}
+$Result = DB_query("SELECT creditcharges.chargeid, creditcharges.debtorno, creditcharges.chargemonth, creditcharges.chargetype,
+						creditcharges.amount, creditcharges.waived, debtortrans.transno, debtortrans.balance, debtorsmaster.currcode
+					FROM creditcharges
+					INNER JOIN debtortrans ON creditcharges.debtortransid = debtortrans.id
+					INNER JOIN debtorsmaster ON creditcharges.debtorno = debtorsmaster.debtorno
+					WHERE 1=1 " . $Filter . "
+					ORDER BY creditcharges.chargeid DESC LIMIT 100");
+if (DB_num_rows($Result) > 0) {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<table class="selection">
+			<tr><th colspan="7">' . __('Charges raised') . '</th></tr>
+			<tr><th>' . __('Customer') . '</th><th>' . __('Month') . '</th><th>' . __('Type') . '</th><th>' . __('Transaction') . '</th><th>' . __('Amount') . '</th><th>' . __('Outstanding') . '</th><th></th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . $MyRow['debtorno'] . '</td>
+				<td>' . $MyRow['chargemonth'] . '</td>
+				<td>' . ($MyRow['chargetype'] == 'I' ? __('Interest') : __('Late fee')) . '</td>
+				<td class="number">' . $MyRow['transno'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['amount'], 2) . ' ' . $MyRow['currcode'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['balance'], 2) . '</td>
+				<td>' . ($MyRow['waived'] ? __('Waived') : ($MyRow['balance'] > 0.005 ? '<button type="submit" name="Waive" value="' . $MyRow['chargeid'] . '">' . __('Waive') . '</button>' : '')) . '</td>
+			</tr>';
+	}
+	echo '</table>
+			<div class="centre">' . __('Reason for waiving') . ': <input type="text" name="WaiveReason" size="50" maxlength="250" /></div>
+		</form>';
+}
+
+include('includes/footer.php');
diff --git a/CreditControl.php b/CreditControl.php
new file mode 100644
index 0000000..9e86488
--- /dev/null
+++ b/CreditControl.php
@@ -0,0 +1,384 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+include_once('includes/CreditControlFunctions.php');
+
+$Title = __('Customer Credit Control');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControl';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+} elseif (!empty($_SESSION['CustomerID'])) {
+	$DebtorNo = $_SESSION['CustomerID'];
+}
+
+/* Customer search, restricted to the customers of a sales rep */
+if (isset($_POST['Search']) or !isset($DebtorNo) or $DebtorNo == '') {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<fieldset>
+				<legend>' . __('Select a customer') . '</legend>
+				<field>
+					<label for="Keywords">' . __('Name or code contains') . ':</label>
+					<input type="text" name="Keywords" size="20" maxlength="25" value="' . (isset($_POST['Keywords']) ? $_POST['Keywords'] : '') . '" />
+				</field>
+			</fieldset>
+			<div class="centre"><input type="submit" name="Search" value="' . __('Search Now') . '" /></div>
+		</form>';
+	if (isset($_POST['Search'])) {
+		$Keywords = str_replace(' ', '%', trim($_POST['Keywords']));
+		$SQL = "SELECT debtorsmaster.debtorno, debtorsmaster.name
+				FROM debtorsmaster
+				WHERE (debtorsmaster.name LIKE '%" . $Keywords . "%' OR debtorsmaster.debtorno LIKE '%" . $Keywords . "%')" .
+				CreditSalesmanFilter() . "
+				ORDER BY debtorsmaster.name LIMIT 50";
+		$Result = DB_query($SQL);
+		if (DB_num_rows($Result) == 0) {
+			prnMsg(__('No customers were found'), 'info');
+		} else {
+			echo '<table class="selection"><tr><th>' . __('Code') . '</th><th>' . __('Name') . '</th></tr>';
+			while ($MyRow = DB_fetch_array($Result)) {
+				echo '<tr class="striped_row">
+						<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . $MyRow['debtorno'] . '</a></td>
+						<td>' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+					</tr>';
+			}
+			echo '</table>';
+		}
+	}
+	include('includes/footer.php');
+	exit();
+}
+
+/* A rep sees only own customers (BR-33) */
+if (!CreditCanSeeCustomer($DebtorNo)) {
+	prnMsg(__('You have no authority to review the credit details of this customer'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$CanControl = CreditUserCanControl();
+
+if (isset($_POST['RecordReview']) or isset($_POST['ChangeStatus']) or isset($_POST['SaveExemptions']) or isset($_POST['SaveDisputes']) or isset($_POST['AddNote'])) {
+	if (!$CanControl) {
+		/* BR-07, BR-34: sales reps and order entry staff can see but not change */
+		prnMsg(__('You do not have the credit control authority to change the credit details of customers'), 'error');
+	} else {
+		$Status = GetCreditStatus($DebtorNo);
+
+		if (isset($_POST['RecordReview'])) {
+			$InputError = 0;
+			$Outcomes = array('CONFIRMED' => __('Limit confirmed'),
+								'RAISED' => __('Limit raised'),
+								'REDUCED' => __('Limit reduced'),
+								'WATCH' => __('Put on watch'),
+								'STOP' => __('Put on stop'));
+			$Outcome = $_POST['Outcome'];
+			$NewLimit = filter_number_format($_POST['NewLimit']);
+			if (!isset($Outcomes[$Outcome])) {
+				$InputError = 1;
+				prnMsg(__('The outcome of the review must be selected'), 'error');
+			}
+			if (!is_numeric($NewLimit) or $NewLimit < 0) {
+				$InputError = 1;
+				prnMsg(__('The credit limit must be a number that is not negative'), 'error');
+			}
+			if ($Outcome == 'RAISED' and $NewLimit <= $Status['creditlimit']) {
+				$InputError = 1;
+				prnMsg(__('A review that raises the limit must have a new limit above the current limit'), 'error');

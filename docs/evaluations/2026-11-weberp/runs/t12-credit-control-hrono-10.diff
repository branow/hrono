+<?php
+
+/* Go-live loader: credit status (for example the spreadsheet stop list), credit limits and next review dates.
+ * csv columns: debtorno, credit status code, credit limit (blank to leave), next review date yyyy-mm-dd (blank to leave) */
+
+require(__DIR__ . '/includes/session.php');
+include_once('includes/CreditControlFunctions.php');
+
+$Title = __('Import Credit Status');
+$ViewTopic = 'SpecialUtilities';
+$BookMark = 'ImportCreditStatus';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/maintenance.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if (isset($_POST['Import']) and isset($_FILES['ImportFile']) and $_FILES['ImportFile']['name'] != '') {
+	$FileHandle = fopen($_FILES['ImportFile']['tmp_name'], 'r');
+	$Row = 0;
+	$Done = 0;
+	DB_Txn_Begin();
+	while (($Fields = fgetcsv($FileHandle, 10000, ',')) !== false) {
+		$Row++;
+		if ($Row == 1 and !is_numeric($Fields[1])) {
+			continue; // header row
+		}
+		$DebtorNo = trim($Fields[0]);
+		$Status = GetCreditStatus($DebtorNo);
+		$Reason = DB_query("SELECT reasoncode FROM holdreasons WHERE reasoncode='" . (int) $Fields[1] . "'");
+		if ($Status === false or DB_num_rows($Reason) == 0) {
+			DB_Txn_Rollback();
+			prnMsg(__('Row') . ' ' . $Row . ': ' . __('the customer or the credit status code does not exist. Nothing was imported.'), 'error');
+			$Done = -1;
+			break;
+		}
+		SetCreditStatus($DebtorNo, (int) $Fields[1], __('Loaded at go-live'));
+		if (isset($Fields[2]) and trim($Fields[2]) != '' and is_numeric($Fields[2]) and $Fields[2] >= 0) {
+			SetCreditLimit($DebtorNo, $Fields[2], __('Loaded at go-live'));
+		}
+		if (isset($Fields[3]) and trim($Fields[3]) != '' and Is_Date($Fields[3])) {
+			DB_query("UPDATE debtorsmaster SET nextcreditreview='" . FormatDateForSQL($Fields[3]) . "' WHERE debtorno='" . $DebtorNo . "'");
+			LogCreditEvent($DebtorNo, 'REVIEWDATE', __('Next review date loaded at go-live'), '', '', FormatDateForSQL($Fields[3]));
+		}
+		$Done++;
+	}
+	fclose($FileHandle);
+	if ($Done >= 0) {
+		DB_Txn_Commit();
+		prnMsg($Done . ' ' . __('customers have been updated'), 'success');
+	}
+}
+
+echo '<form method="post" enctype="multipart/form-data" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('csv columns: customer code, credit status code, credit limit, next review date (yyyy-mm-dd). The last two may be blank.') . '</legend>
+			<field>
+				<label for="ImportFile">' . __('File') . ':</label>
+				<input type="file" name="ImportFile" />
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Import" value="' . __('Import') . '" /></div>
+	</form>';
+
+include('includes/footer.php');

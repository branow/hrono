diff --git a/LateCharges.php b/LateCharges.php
new file mode 100644
index 0000000..0be0243
--- /dev/null
+++ b/LateCharges.php
@@ -0,0 +1,340 @@
+<?php
+
+/* Month end late payment charges. The credit controller chooses when to run it - nothing is charged without her.
+  - interest: the late payment interest rate (a percentage per month, a company setting) on the balance of the
+    invoices that are past due, one charge per customer per month
+  - reminder fee: the fixed reminder fee (a company setting) for each final notice sent in the month. A final
+    notice is a letter that went out with the final notice wording, which includes those sent to customers on hold.
+Each charge is a customer transaction (type 13) in the customer's currency, which shows on the account, the
+inquiry, the statement and the aged debtors, can be printed and emailed and be matched against payments. It is
+posted to the ledger in the same period: debit debtors control, credit the late payment charges income account
+chosen in the company preferences, with the GL tags chosen here.
+Running it twice for a month cannot charge twice: creditcharges has a unique key on (customer, month, kind, reminder). */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Late Payment Charges');
+$ViewTopic = 'CreditControl';
+$BookMark = 'LateCharges';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/GLFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_add.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if (!CreditControllerAccess()) {
+	prnMsg(__('Only the credit controller can charge late payment interest and reminder fees'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$CompanyResult = DB_query("SELECT latechargeact, debtorsact FROM companies WHERE coycode = 1");
+$Company = DB_fetch_array($CompanyResult);
+$AccountResult = DB_query("SELECT accountcode FROM chartmaster WHERE accountcode = '" . $Company['latechargeact'] . "'");
+if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1 and (DB_num_rows($AccountResult) == 0 or $Company['latechargeact'] == $Company['debtorsact'])) {
+	prnMsg(__('The late payment charges income account has not been set up. Choose it in the company preferences first'), 'error');
+	echo '<div class="centre"><a href="' . $RootPath . '/CompanyPreferences.php">' . __('Company Preferences') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+$InterestRate = (float) ($_SESSION['LateInterestRate'] ?? 0);
+$ReminderFee = (float) ($_SESSION['ReminderFee'] ?? 0);
+
+/* the month to charge: this month or last month, as 'YYYY-MM' */
+$ThisMonth = date('Y-m');
+$LastMonth = date('Y-m', strtotime('first day of last month'));
+$ChargeMonth = (isset($_POST['ChargeMonth']) and in_array($_POST['ChargeMonth'], array($ThisMonth, $LastMonth))) ? $_POST['ChargeMonth'] : $LastMonth;
+$MonthStart = $ChargeMonth . '-01';
+$MonthEnd = date('Y-m-t', strtotime($MonthStart));
+$ChargeDate = min($MonthEnd, date('Y-m-d')); // never post-date a charge
+
+/**
+ * The charges that could be made for the month:
+ * array of array('key', 'kind', 'debtorno', 'name', 'reminderid', 'amount', 'basis', 'rate', 'decimals', 'currency', 'rate_fx',
+ *               'branchcode', 'salesperson', 'tpe', 'done')
+ */
+function LateChargeCandidates($ChargeMonth, $MonthStart, $MonthEnd, $InterestRate, $ReminderFee) {
+	$Charges = array();
+
+	/* interest on invoices that are past due now */
+	if ($InterestRate > 0) {
+		$SQL = "SELECT debtortrans.debtorno,
+						debtortrans.branchcode,
+						debtortrans.salesperson,
+						debtortrans.tpe,
+						debtortrans.balance,
+						debtorsmaster.name,
+						currencies.currabrev,
+						currencies.decimalplaces,
+						currencies.rate
+				FROM debtortrans
+				INNER JOIN debtorsmaster
+					ON debtortrans.debtorno = debtorsmaster.debtorno
+				INNER JOIN paymentterms
+					ON debtorsmaster.paymentterms = paymentterms.termsindicator
+				INNER JOIN currencies
+					ON debtorsmaster.currcode = currencies.currabrev
+				WHERE debtortrans.type = 10
+				AND ROUND(debtortrans.balance, currencies.decimalplaces) > 0
+				AND " . CreditPastDueSQL(1) . " = 1 " .
+				CreditSalesmanCustomerSQL('debtorsmaster.debtorno') .
+				CreditSalesmanTransSQL('debtortrans') . "
+				ORDER BY debtortrans.debtorno, debtortrans.trandate, debtortrans.transno";
+		$Result = DB_query($SQL);
+		$ByCustomer = array();
+		while ($MyRow = DB_fetch_array($Result)) {
+			if (!isset($ByCustomer[$MyRow['debtorno']])) {
+				$ByCustomer[$MyRow['debtorno']] = $MyRow;
+				$ByCustomer[$MyRow['debtorno']]['basis'] = 0;
+			}
+			$ByCustomer[$MyRow['debtorno']]['basis'] += $MyRow['balance'];
+		}
+		foreach ($ByCustomer as $DebtorNo => $Row) {
+			$Amount = round($Row['basis'] * $InterestRate / 100, $Row['decimalplaces']);
+			if ($Amount <= 0) {
+				continue;
+			}
+			$Charges[] = array('key' => 'i:' . $DebtorNo, 'kind' => 'interest', 'debtorno' => $DebtorNo, 'name' => $Row['name'],
+				'reminderid' => 0, 'amount' => $Amount, 'basis' => $Row['basis'], 'rate' => $InterestRate,
+				'decimals' => $Row['decimalplaces'], 'currency' => $Row['currabrev'], 'rate_fx' => $Row['rate'],
+				'branchcode' => $Row['branchcode'], 'salesperson' => $Row['salesperson'], 'tpe' => $Row['tpe']);
+		}
+	}
+
+	/* a fee for each final notice sent in the month */
+	if ($ReminderFee > 0) {
+		$SQL = "SELECT creditreminders.reminderid,
+						creditreminders.debtorno,
+						debtorsmaster.name,
+						currencies.currabrev,
+						currencies.decimalplaces,
+						currencies.rate,
+						MIN(debtortrans.branchcode) AS branchcode,
+						MIN(debtortrans.salesperson) AS salesperson,
+						MIN(debtortrans.tpe) AS tpe
+				FROM creditreminders
+				INNER JOIN debtorsmaster
+					ON creditreminders.debtorno = debtorsmaster.debtorno
+				INNER JOIN currencies
+					ON debtorsmaster.currcode = currencies.currabrev
+				INNER JOIN creditreminderitems
+					ON creditreminderitems.reminderid = creditreminders.reminderid
+				INNER JOIN debtortrans
+					ON debtortrans.id = creditreminderitems.debtortransid
+				WHERE (creditreminders.level = 3 OR creditreminders.onhold = 1)
+				AND creditreminders.sentdate >= '" . $MonthStart . " 00:00:00'
+				AND creditreminders.sentdate <= '" . $MonthEnd . " 23:59:59' " .
+				CreditSalesmanCustomerSQL('debtorsmaster.debtorno') .
+				CreditSalesmanTransSQL('debtortrans') . "
+				GROUP BY creditreminders.reminderid,
+						creditreminders.debtorno,
+						debtorsmaster.name,
+						currencies.currabrev,
+						currencies.decimalplaces,
+						currencies.rate
+				ORDER BY creditreminders.debtorno, creditreminders.reminderid";
+		$Result = DB_query($SQL);
+		while ($MyRow = DB_fetch_array($Result)) {
+			$Charges[] = array('key' => 'f:' . $MyRow['reminderid'], 'kind' => 'fee', 'debtorno' => $MyRow['debtorno'], 'name' => $MyRow['name'],
+				'reminderid' => $MyRow['reminderid'], 'amount' => round($ReminderFee, $MyRow['decimalplaces']), 'basis' => 0, 'rate' => 0,
+				'decimals' => $MyRow['decimalplaces'], 'currency' => $MyRow['currabrev'], 'rate_fx' => $MyRow['rate'],
+				'branchcode' => $MyRow['branchcode'], 'salesperson' => $MyRow['salesperson'], 'tpe' => $MyRow['tpe']);
+		}
+	}
+
+	/* mark what has been charged for the month already */
+	foreach ($Charges as $Index => $Charge) {
+		$Done = DB_query("SELECT chargeid FROM creditcharges
+						WHERE debtorno = '" . $Charge['debtorno'] . "'
+						AND chargemonth = '" . $ChargeMonth . "'
+						AND kind = '" . $Charge['kind'] . "'
+						AND reminderid = '" . $Charge['reminderid'] . "'");
+		$Charges[$Index]['done'] = (DB_num_rows($Done) > 0);
+	}
+	return $Charges;
+}
+
+/* ---------- make the charges ---------- */
+if (isset($_POST['Charge'])) {
+	$Tags = array();
+	if (isset($_POST['Tags']) and is_array($_POST['Tags'])) {
+		foreach ($_POST['Tags'] as $Tag) {
+			$Tags[] = (int) $Tag;
+		}
+	}
+	$Chosen = (isset($_POST['Include']) and is_array($_POST['Include'])) ? array_keys($_POST['Include']) : array();
+	$PeriodNo = GetPeriod(ConvertSQLDate($ChargeDate));
+	$Made = array();
+	$Skipped = array();
+
+	foreach (LateChargeCandidates($ChargeMonth, $MonthStart, $MonthEnd, $InterestRate, $ReminderFee) as $Charge) {
+		if (!in_array($Charge['key'], $Chosen)) {
+			continue;
+		}
+		if ($Charge['done']) {
+			$Skipped[] = $Charge['debtorno'] . ': ' . __('already charged for this month');
+			continue;
+		}
+
+		DB_Txn_Begin();
+
+		/* the unique key stops a second charge for the same customer, month, kind and reminder, even in a parallel run */
+		DB_query("INSERT INTO creditcharges (debtorno, chargemonth, kind, reminderid, basis, rate, amount, createdby, createddate)
+				VALUES ('" . $Charge['debtorno'] . "', '" . $ChargeMonth . "', '" . $Charge['kind'] . "', '" . $Charge['reminderid'] . "',
+						'" . $Charge['basis'] . "', '" . $Charge['rate'] . "', '" . $Charge['amount'] . "',
+						'" . $_SESSION['UserID'] . "', '" . date('Y-m-d H:i:s') . "')", '', '', false, false);
+		if (DB_error_no() != 0) {
+			DB_Txn_Rollback();
+			DB_Txn_Commit(); // back to autocommit
+			$Skipped[] = $Charge['debtorno'] . ': ' . __('already charged for this month');
+			continue;
+		}
+		$ChargeID = DB_Last_Insert_ID('creditcharges', 'chargeid');
+
+		$TransNo = GetNextTransNo(CREDIT_TRANS_CHARGE);
+		$Reference = ($Charge['kind'] == 'fee') ? __('Reminder fee') . ' ' . $ChargeMonth : __('Late payment interest') . ' ' . $ChargeMonth;
+		$Text = ($Charge['kind'] == 'fee')
+			? __('Fee for the final notice sent in') . ' ' . $ChargeMonth
+			: __('Interest at') . ' ' . $Charge['rate'] . '% ' . __('on overdue invoices of') . ' ' . locale_number_format($Charge['basis'], $Charge['decimals']) . ' ' . $Charge['currency'];
+
+		$SQL = "INSERT INTO debtortrans (transno,
+										type,
+										debtorno,
+										branchcode,
+										trandate,
+										inputdate,
+										prd,
+										reference,
+										tpe,
+										order_,
+										rate,
+										ovamount,
+										ovgst,
+										ovfreight,
+										ovdiscount,
+										invtext,
+										salesperson)
+				VALUES ('" . $TransNo . "',
+						'" . CREDIT_TRANS_CHARGE . "',
+						'" . $Charge['debtorno'] . "',
+						'" . $Charge['branchcode'] . "',
+						'" . $ChargeDate . "',
+						'" . date('Y-m-d H:i:s') . "',
+						'" . $PeriodNo . "',
+						'" . DB_escape_string($Reference) . "',
+						'" . $Charge['tpe'] . "',
+						0,
+						'" . $Charge['rate_fx'] . "',
+						'" . $Charge['amount'] . "',
+						0,
+						0,
+						0,
+						'" . DB_escape_string($Text) . "',
+						'" . $Charge['salesperson'] . "')";
+		DB_query($SQL, __('The charge could not be saved because'), '', true);
+		$DebtorTransID = DB_Last_Insert_ID('debtortrans', 'id');
+
+		DB_query("UPDATE creditcharges SET debtortransid = '" . $DebtorTransID . "' WHERE chargeid = '" . $ChargeID . "'", '', '', true);
+
+		if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+			$LocalAmount = round($Charge['amount'] / $Charge['rate_fx'], 4);
+			CreditPostGL(CREDIT_TRANS_CHARGE, $TransNo, $ChargeDate, $PeriodNo, $Company['debtorsact'], $Charge['debtorno'] . ' - ' . $Reference, $LocalAmount);
+			CreditPostGL(CREDIT_TRANS_CHARGE, $TransNo, $ChargeDate, $PeriodNo, $Company['latechargeact'], $Charge['debtorno'] . ' - ' . $Reference, -$LocalAmount, $Tags);
+		}
+
+		DB_Txn_Commit();
+		$Made[] = array($Charge, $TransNo);
+	}
+
+	if (count($Made) > 0) {
+		echo '<h3>' . __('Charges made') . '</h3><table class="selection"><tr><th>' . __('Customer') . '</th><th>' . __('Charge') . '</th><th>' . __('Number') . '</th><th>' . __('Amount') . '</th><th></th></tr>';
+		foreach ($Made as $Item) {
+			echo '<tr class="striped_row">
+					<td>' . $Item[0]['debtorno'] . ' - ' . $Item[0]['name'] . '</td>
+					<td>' . ($Item[0]['kind'] == 'fee' ? __('Reminder fee') : __('Interest')) . '</td>
+					<td>' . $Item[1] . '</td>
+					<td class="number">' . locale_number_format($Item[0]['amount'], $Item[0]['decimals']) . ' ' . $Item[0]['currency'] . '</td>
+					<td><a href="' . $RootPath . '/PrintCustCharge.php?TransNo=' . $Item[1] . '" target="_blank">' . __('PDF') . '</a>
+						<a href="' . $RootPath . '/PrintCustCharge.php?TransNo=' . $Item[1] . '&amp;Email=Yes">' . __('Email') . '</a></td>
+				</tr>';
+		}
+		echo '</table>';
+	}
+	if (count($Skipped) > 0) {
+		echo '<h3>' . __('Not charged') . '</h3><ul>';
+		foreach ($Skipped as $Text) {
+			echo '<li>' . $Text . '</li>';
+		}
+		echo '</ul>';
+	}
+	if (count($Made) == 0 and count($Skipped) == 0) {
+		prnMsg(__('Nothing was selected to charge'), 'info');
+	}
+	echo '<br />';
+}
+
+/* ---------- the list of what would be charged ---------- */
+$Charges = LateChargeCandidates($ChargeMonth, $MonthStart, $MonthEnd, $InterestRate, $ReminderFee);
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Month to charge') . '</legend>
+		<field>
+			<label for="ChargeMonth">' . __('Month') . ':</label>
+			<select name="ChargeMonth" onchange="this.form.submit()">
+				<option value="' . $LastMonth . '"' . ($ChargeMonth == $LastMonth ? ' selected="selected"' : '') . '>' . $LastMonth . '</option>
+				<option value="' . $ThisMonth . '"' . ($ChargeMonth == $ThisMonth ? ' selected="selected"' : '') . '>' . $ThisMonth . '</option>
+			</select>
+			<fieldhelp>' . __('The charges are dated') . ' ' . ConvertSQLDate($ChargeDate) . ' ' . __('and posted in the period of that date') . '. ' .
+				__('Interest rate per month') . ': ' . locale_number_format($InterestRate, 2) . '%. ' . __('Reminder fee') . ': ' . locale_number_format($ReminderFee, 2) . '</fieldhelp>
+		</field>';
+
+$TagResult = DB_query("SELECT tagref, tagdescription FROM tags ORDER BY tagdescription");
+if (DB_num_rows($TagResult) > 0) {
+	echo '<field>
+			<label for="Tags">' . __('GL Tags') . ':</label>
+			<select name="Tags[]" multiple="multiple" size="4">';
+	while ($TagRow = DB_fetch_array($TagResult)) {
+		echo '<option value="' . $TagRow['tagref'] . '">' . $TagRow['tagdescription'] . '</option>';
+	}
+	echo '</select>
+		</field>';
+}
+echo '</fieldset>';
+
+if ($InterestRate <= 0 and $ReminderFee <= 0) {
+	prnMsg(__('The late payment interest rate and the reminder fee are both zero. Set them in the system parameters first'), 'info');
+} elseif (count($Charges) == 0) {
+	prnMsg(__('There is nothing to charge for this month'), 'info');
+} else {
+	echo '<table class="selection">
+		<tr>
+			<th>' . __('Charge') . '</th>
+			<th>' . __('Customer') . '</th>
+			<th>' . __('Type') . '</th>
+			<th>' . __('Overdue Invoices') . '</th>
+			<th>' . __('Amount') . '</th>
+		</tr>';
+	foreach ($Charges as $Charge) {
+		echo '<tr class="striped_row">
+				<td>' . ($Charge['done']
+					? '<b>' . __('Charged already') . '</b>'
+					: '<input type="checkbox" name="Include[' . $Charge['key'] . ']" value="1" checked="checked" />') . '</td>
+				<td>' . $Charge['debtorno'] . ' - ' . $Charge['name'] . '</td>
+				<td>' . ($Charge['kind'] == 'fee' ? __('Reminder fee') : __('Interest')) . '</td>
+				<td class="number">' . ($Charge['kind'] == 'fee' ? '' : locale_number_format($Charge['basis'], $Charge['decimals'])) . '</td>
+				<td class="number">' . locale_number_format($Charge['amount'], $Charge['decimals']) . ' ' . $Charge['currency'] . '</td>
+			</tr>';
+	}
+	echo '</table>
+		<div class="centre"><input type="submit" name="Charge" value="' . __('Make the charges ticked') . '" onclick="return confirm(\'' . __('Charge the customers ticked?') . '\');" /></div>';
+}
+echo '</form>';
+
+include('includes/footer.php');

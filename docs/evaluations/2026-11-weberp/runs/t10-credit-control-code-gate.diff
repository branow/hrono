+  PRIMARY KEY (`chargeid`),
+  UNIQUE KEY `OncePerMonth` (`debtorno`,`chargemonth`,`kind`,`reminderid`),
+  KEY `DebtorTransID` (`debtortransid`),
+  CONSTRAINT `creditcharges_ibfk_1` FOREIGN KEY (`debtorno`) REFERENCES `debtorsmaster` (`debtorno`) ON DELETE CASCADE ON UPDATE CASCADE
+)", $CreditCharset);
+
+CreateTable('creditwriteoffs', "CREATE TABLE `creditwriteoffs` (

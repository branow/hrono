diff --git a/BadDebtWriteOff.php b/BadDebtWriteOff.php
new file mode 100644
index 0000000..c9123a9
--- /dev/null
+++ b/BadDebtWriteOff.php
@@ -0,0 +1,312 @@
+<?php
+
+/* Bad debt write-off. The credit controller writes off what is left on chosen invoices (or late payment charges)
+of a customer, or the whole balance, with a reason.
+
+The write-off is a customer transaction (type 14, like a credit note) that is allocated to the items it clears,
+so they are settled. In the ledger it is debit bad debt expense account (chosen in the company preferences - never a
+control account), credit debtors control. For a foreign currency customer the difference between the rate of the
+invoice and the rate of the write-off is worked out and posted exactly as CustomerAllocations.php does it for a
+payment: debit/credit the sales exchange variances account and adjust debtors control so that it holds the invoice
+at the rate it was posted at. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Bad Debt Write-off');
+$ViewTopic = 'CreditControl';
+$BookMark = 'BadDebtWriteOff';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/GLFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_delete.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if (!CreditControllerAccess()) {
+	prnMsg(__('Only the credit controller can write off bad debt'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+/* the bad debt expense account must exist, be a profit and loss account and not a control account */
+$CompanyResult = DB_query("SELECT baddebtact, debtorsact, creditorsact, payrollact, grnact, commissionsact, retainedearnings, freightact,
+								salesexchangediffact, purchasesexchangediffact, currencyexchangediffact, pytdiscountact
+							FROM companies WHERE coycode = 1");
+$Company = DB_fetch_array($CompanyResult);
+$ControlAccounts = array($Company['debtorsact'], $Company['creditorsact'], $Company['payrollact'], $Company['grnact'],
+	$Company['commissionsact'], $Company['retainedearnings'], $Company['freightact']);
+$AccountResult = DB_query("SELECT chartmaster.accountcode, accountgroups.pandl
+							FROM chartmaster
+							INNER JOIN accountgroups ON chartmaster.group_ = accountgroups.groupname
+							WHERE chartmaster.accountcode = '" . $Company['baddebtact'] . "'");
+$AccountRow = DB_fetch_array($AccountResult);
+if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1 and (!$AccountRow or $AccountRow['pandl'] != 1 or in_array($Company['baddebtact'], $ControlAccounts))) {
+	prnMsg(__('The bad debt expense account has not been set up, or it is not a profit and loss account. Choose it in the company preferences first - a write-off is never posted to a control account'), 'error');
+	echo '<div class="centre"><a href="' . $RootPath . '/CompanyPreferences.php">' . __('Company Preferences') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+$DebtorNo = '';
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper(trim($_GET['DebtorNo']));
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper(trim($_POST['DebtorNo']));
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Select the customer') . '</legend>
+		<field>
+			<label for="DebtorNo">' . __('Customer Code') . ':</label>
+			<input type="text" name="DebtorNo" value="' . $DebtorNo . '" size="12" maxlength="10" />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Select" value="' . __('Select') . '" /></div>
+	</form>';
+
+if ($DebtorNo == '') {
+	include('includes/footer.php');
+	exit();
+}
+
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				currencies.currabrev,
+				currencies.decimalplaces,
+				currencies.rate
+		FROM debtorsmaster
+		INNER JOIN currencies
+			ON debtorsmaster.currcode = currencies.currabrev
+		WHERE debtorsmaster.debtorno = '" . $DebtorNo . "'" . CreditSalesmanCustomerSQL('debtorsmaster.debtorno');
+$Result = DB_query($SQL);
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('The customer was not found, or you are not allowed to see it'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($Result);
+$Decimals = $Customer['decimalplaces'];
+
+/* ---------- write off ---------- */
+if (isset($_POST['WriteOff'])) {
+	$Reason = trim($_POST['Reason']);
+	$Chosen = (isset($_POST['Item']) and is_array($_POST['Item'])) ? array_map('intval', array_keys($_POST['Item'])) : array();
+	$Tags = array();
+	if (isset($_POST['Tags']) and is_array($_POST['Tags'])) {
+		foreach ($_POST['Tags'] as $Tag) {
+			$Tags[] = (int) $Tag;
+		}
+	}
+
+	if ($Reason == '') {
+		prnMsg(__('A reason for the write-off must be entered'), 'error');
+	} elseif (count($Chosen) == 0) {
+		prnMsg(__('Select the invoices to write off'), 'error');
+	} else {
+		DB_Txn_Begin();
+
+		DB_query("SELECT debtorno FROM debtorsmaster WHERE debtorno = '" . $DebtorNo . "' FOR UPDATE", '', '', true);
+
+		/* read what is left on the chosen items now, locking them */
+		$SQL = "SELECT debtortrans.id,
+						debtortrans.transno,
+						debtortrans.type,
+						debtortrans.rate,
+						debtortrans.balance,
+						debtortrans.branchcode,
+						debtortrans.salesperson,
+						debtortrans.tpe,
+						debtortrans.alloc,
+						debtortrans.diffonexch
+				FROM debtortrans
+				WHERE debtortrans.debtorno = '" . $DebtorNo . "'
+				AND debtortrans.type IN (10, " . CREDIT_TRANS_CHARGE . ")
+				AND ROUND(debtortrans.balance, " . $Decimals . ") > 0
+				AND debtortrans.id IN (" . implode(',', $Chosen) . ") " .
+				CreditSalesmanTransSQL('debtortrans') . "
+				ORDER BY debtortrans.id
+				FOR UPDATE";
+		$ItemsResult = DB_query($SQL, __('The items could not be read because'), '', true);
+		$Items = array();
+		while ($MyRow = DB_fetch_array($ItemsResult)) {
+			$Items[] = $MyRow;
+		}
+
+		if (count($Items) == 0) {
+			DB_Txn_Rollback();
+			DB_Txn_Commit(); // back to autocommit
+			prnMsg(__('There is nothing left to write off on the items selected'), 'warn');
+		} else {
+			$WriteOffRate = $Customer['rate'];
+			$Total = 0;
+			$TotalDiffOnExch = 0;
+			foreach ($Items as $Index => $Item) {
+				$Amount = round($Item['balance'], $Decimals);
+				$Items[$Index]['writeoff'] = $Amount;
+				// the same difference on exchange a payment gets in CustomerAllocations.php
+				$Items[$Index]['diffonexch'] = ($Amount / $WriteOffRate) - ($Amount / $Item['rate']);
+				$Total += $Amount;
+				$TotalDiffOnExch += $Items[$Index]['diffonexch'];
+			}
+
+			$TransNo = GetNextTransNo(CREDIT_TRANS_WRITEOFF);
+			$PeriodNo = GetPeriod(date($_SESSION['DefaultDateFormat']));
+			$Today = date('Y-m-d');
+
+			$SQL = "INSERT INTO debtortrans (transno,
+											type,
+											debtorno,
+											branchcode,
+											trandate,
+											inputdate,
+											prd,
+											reference,
+											tpe,
+											order_,
+											rate,
+											ovamount,
+											ovgst,
+											ovfreight,
+											ovdiscount,
+											diffonexch,
+											alloc,
+											settled,
+											invtext,
+											salesperson)
+					VALUES ('" . $TransNo . "',
+							'" . CREDIT_TRANS_WRITEOFF . "',
+							'" . $DebtorNo . "',
+							'" . $Items[0]['branchcode'] . "',
+							'" . $Today . "',
+							'" . date('Y-m-d H:i:s') . "',
+							'" . $PeriodNo . "',
+							'" . DB_escape_string(__('Bad debt write-off')) . "',
+							'" . $Items[0]['tpe'] . "',
+							0,
+							'" . $WriteOffRate . "',
+							'" . -$Total . "',
+							0,
+							0,
+							0,
+							'" . -$TotalDiffOnExch . "',
+							'" . -$Total . "',
+							1,
+							'" . $Reason . "',
+							'" . $Items[0]['salesperson'] . "')";
+			DB_query($SQL, __('The write-off could not be saved because'), '', true);
+			$WriteOffID = DB_Last_Insert_ID('debtortrans', 'id');
+
+			foreach ($Items as $Item) {
+				DB_query("INSERT INTO custallocns (datealloc, amt, transid_allocfrom, transid_allocto)
+						VALUES ('" . $Today . "', '" . $Item['writeoff'] . "', '" . $WriteOffID . "', '" . $Item['id'] . "')", __('The allocation could not be saved because'), '', true);
+				DB_query("UPDATE debtortrans
+						SET alloc = alloc + " . $Item['writeoff'] . ",
+							diffonexch = diffonexch + " . $Item['diffonexch'] . ",
+							settled = 1
+						WHERE id = '" . $Item['id'] . "'", __('The item could not be settled because'), '', true);
+			}
+
+			DB_query("INSERT INTO creditwriteoffs (debtorno, debtortransid, writeoffdate, userid, reason, amount)
+					VALUES ('" . $DebtorNo . "', '" . $WriteOffID . "', '" . $Today . "', '" . $_SESSION['UserID'] . "', '" . $Reason . "', '" . $Total . "')",
+					__('The write-off could not be recorded because'), '', true);
+
+			if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+				$Narrative = $DebtorNo . ' - ' . __('Bad debt write-off');
+				$LocalTotal = round($Total / $WriteOffRate, 4);
+				CreditPostGL(CREDIT_TRANS_WRITEOFF, $TransNo, $Today, $PeriodNo, $Company['debtorsact'], $Narrative, -$LocalTotal);
+				CreditPostGL(CREDIT_TRANS_WRITEOFF, $TransNo, $Today, $PeriodNo, $Company['baddebtact'], $Narrative, $LocalTotal, $Tags);
+
+				/* the difference on exchange between the rate of the invoices and the rate of the write-off */
+				$MovtInDiffOnExch = round(-$TotalDiffOnExch, 4);
+				if ($MovtInDiffOnExch != 0) {
+					CreditPostGL(CREDIT_TRANS_WRITEOFF, $TransNo, $Today, $PeriodNo, $Company['salesexchangediffact'], $Narrative, $MovtInDiffOnExch);
+					CreditPostGL(CREDIT_TRANS_WRITEOFF, $TransNo, $Today, $PeriodNo, $Company['debtorsact'], $Narrative, -$MovtInDiffOnExch);
+				}
+			}
+
+			DB_Txn_Commit();
+			prnMsg(__('Bad debt write-off number') . ' ' . $TransNo . ' ' . __('has been made for') . ' ' . locale_number_format($Total, $Decimals) . ' ' . $Customer['currabrev'], 'success');
+		}
+	}
+}
+
+/* ---------- what is left on the customer's account ---------- */
+$SQL = "SELECT debtortrans.id,
+				debtortrans.transno,
+				debtortrans.type,
+				systypes.typename,
+				debtortrans.trandate,
+				debtortrans.reference,
+				debtortrans.balance
+		FROM debtortrans
+		INNER JOIN systypes
+			ON debtortrans.type = systypes.typeid
+		WHERE debtortrans.debtorno = '" . $DebtorNo . "'
+		AND debtortrans.type IN (10, " . CREDIT_TRANS_CHARGE . ")
+		AND ROUND(debtortrans.balance, " . $Decimals . ") > 0 " .
+		CreditSalesmanTransSQL('debtortrans') . "
+		ORDER BY debtortrans.trandate, debtortrans.id";
+$Result = DB_query($SQL);
+
+echo '<h3>' . $Customer['debtorno'] . ' - ' . $Customer['name'] . ' (' . $Customer['currabrev'] . ')</h3>';
+
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('This customer has no invoices with an amount left to write off'), 'info');
+	include('includes/footer.php');
+	exit();
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+	<table class="selection">
+		<tr>
+			<th><input type="checkbox" onclick="var boxes = this.form.querySelectorAll(\'input.writeoffitem\'); for (var i = 0; i < boxes.length; i++) { boxes[i].checked = this.checked; }" title="' . __('The whole balance') . '" /></th>
+			<th>' . __('Type') . '</th>
+			<th>' . __('Number') . '</th>
+			<th>' . __('Date') . '</th>
+			<th>' . __('Reference') . '</th>
+			<th>' . __('Left To Pay') . '</th>
+		</tr>';
+$Total = 0;
+while ($MyRow = DB_fetch_array($Result)) {
+	$Total += $MyRow['balance'];
+	echo '<tr class="striped_row">
+			<td><input type="checkbox" class="writeoffitem" name="Item[' . $MyRow['id'] . ']" value="1" /></td>
+			<td>' . __($MyRow['typename']) . '</td>
+			<td>' . $MyRow['transno'] . '</td>
+			<td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+			<td>' . $MyRow['reference'] . '</td>
+			<td class="number">' . locale_number_format($MyRow['balance'], $Decimals) . '</td>
+		</tr>';
+}
+echo '<tr><td colspan="5"><b>' . __('Total') . '</b></td><td class="number"><b>' . locale_number_format($Total, $Decimals) . '</b></td></tr>
+	</table>
+	<fieldset>
+		<legend>' . __('Write-off') . '</legend>
+		<field>
+			<label for="Reason">' . __('Reason') . ':</label>
+			<textarea name="Reason" rows="4" cols="70" required="required">' . ($_POST['Reason'] ?? '') . '</textarea>
+		</field>';
+
+$TagResult = DB_query("SELECT tagref, tagdescription FROM tags ORDER BY tagdescription");
+if (DB_num_rows($TagResult) > 0) {
+	echo '<field>
+			<label for="Tags">' . __('GL Tags') . ':</label>
+			<select name="Tags[]" multiple="multiple" size="4">';
+	while ($TagRow = DB_fetch_array($TagResult)) {
+		echo '<option value="' . $TagRow['tagref'] . '">' . $TagRow['tagdescription'] . '</option>';
+	}
+	echo '</select>
+		</field>';
+}
+echo '</fieldset>
+	<div class="centre"><input type="submit" name="WriteOff" value="' . __('Write Off The Items Ticked') . '" onclick="return confirm(\'' . __('Write off the items ticked as bad debt?') . '\');" /></div>
+	</form>';
+
+include('includes/footer.php');

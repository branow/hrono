+			echo '<b>' . __('Entered by mistake') . '</b><br />' . $MyRow['voidedby'] . ' ' . $MyRow['voiddate'] . '<br />' . $MyRow['voidreason'];
+		} elseif (CreditControllerAccess()) {
+			echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+					<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+					<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+					<input type="hidden" name="ReviewID" value="' . $MyRow['reviewid'] . '" />
+					<input type="text" name="VoidReason" size="20" maxlength="255" placeholder="' . __('Reason') . '" />
+					<input type="submit" name="VoidReview" value="' . __('Entered by mistake') . '" onclick="return confirm(\'' . __('Mark this review as entered by mistake?') . '\');" />
+				</form>';
+		}
+		echo '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');

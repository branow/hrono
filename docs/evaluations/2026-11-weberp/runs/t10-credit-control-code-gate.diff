+<?php
+
+// CUSTOMER CREDIT CONTROL
+//   - credit reviews, overdue reminders, late payment charges and bad debt write-offs
+//   - tables created with the same character set as debtorsmaster so the foreign keys can be created
+
+$CreditCharset = '';
+if (function_exists('CharacterSet')) {
+	$CreditCharset = explode('_', (string) CharacterSet('debtorsmaster'))[0];
+}
+if ($CreditCharset == '') {
+	$CreditCharset = 'utf8mb4';
+}
+
+AddColumn('nextreviewdate', 'debtorsmaster', 'date', 'NULL', '', 'language_id');
+AddColumn('latechargeact', 'companies', 'varchar(20)', 'NOT NULL', '0', 'freightact');
+AddColumn('baddebtact', 'companies', 'varchar(20)', 'NOT NULL', '0', 'latechargeact');
+
+CreateTable('creditreviews', "CREATE TABLE `creditreviews` (
+  `reviewid` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `reviewdate` date NOT NULL DEFAULT '1000-01-01',
+  `reviewedby` varchar(20) NOT NULL DEFAULT '',
+  `outcome` varchar(10) NOT NULL DEFAULT 'keep',
+  `oldlimit` double NOT NULL DEFAULT '0',
+  `newlimit` double NOT NULL DEFAULT '0',
+  `oldholdreason` smallint NOT NULL DEFAULT '0',
+  `newholdreason` smallint NOT NULL DEFAULT '0',
+  `nextreviewdate` date DEFAULT NULL,
+  `comments` text DEFAULT NULL,
+  `voided` tinyint NOT NULL DEFAULT '0',
+  `voidedby` varchar(20) NOT NULL DEFAULT '',
+  `voiddate` datetime DEFAULT NULL,
+  `voidreason` varchar(255) NOT NULL DEFAULT '',
+  PRIMARY KEY (`reviewid`),
+  KEY `DebtorNo` (`debtorno`,`reviewdate`),
+  CONSTRAINT `creditreviews_ibfk_1` FOREIGN KEY (`debtorno`) REFERENCES `debtorsmaster` (`debtorno`) ON DELETE CASCADE ON UPDATE CASCADE
+)", $CreditCharset);
+
+CreateTable('creditreminders', "CREATE TABLE `creditreminders` (
+  `reminderid` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `level` tinyint NOT NULL DEFAULT '1',
+  `onhold` tinyint NOT NULL DEFAULT '0',
+  `sentdate` datetime NOT NULL,
+  `sentby` varchar(20) NOT NULL DEFAULT '',
+  `recipients` varchar(255) NOT NULL DEFAULT '',
+  PRIMARY KEY (`reminderid`),
+  KEY `DebtorNo` (`debtorno`,`sentdate`),
+  CONSTRAINT `creditreminders_ibfk_1` FOREIGN KEY (`debtorno`) REFERENCES `debtorsmaster` (`debtorno`) ON DELETE CASCADE ON UPDATE CASCADE
+)", $CreditCharset);
+
+CreateTable('creditreminderitems', "CREATE TABLE `creditreminderitems` (
+  `reminderid` int NOT NULL DEFAULT '0',
+  `debtortransid` int NOT NULL DEFAULT '0',
+  `level` tinyint NOT NULL DEFAULT '1',
+  PRIMARY KEY (`reminderid`,`debtortransid`),
+  UNIQUE KEY `InvoiceLevel` (`debtortransid`,`level`),
+  CONSTRAINT `creditreminderitems_ibfk_1` FOREIGN KEY (`reminderid`) REFERENCES `creditreminders` (`reminderid`) ON DELETE CASCADE,
+  CONSTRAINT `creditreminderitems_ibfk_2` FOREIGN KEY (`debtortransid`) REFERENCES `debtortrans` (`id`)
+)", $CreditCharset);
+
+CreateTable('creditcharges', "CREATE TABLE `creditcharges` (
+  `chargeid` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `chargemonth` char(7) NOT NULL DEFAULT '',
+  `kind` varchar(10) NOT NULL DEFAULT 'interest',
+  `reminderid` int NOT NULL DEFAULT '0',
+  `debtortransid` int NOT NULL DEFAULT '0',

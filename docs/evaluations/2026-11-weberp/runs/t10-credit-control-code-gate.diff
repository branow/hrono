diff --git a/CreditHistory.php b/CreditHistory.php
new file mode 100644
index 0000000..83470a1
--- /dev/null
+++ b/CreditHistory.php
@@ -0,0 +1,191 @@
+<?php
+
+/* Read only credit history of a customer: reviews, reminders sent, late payment charges and write-offs.
+Sales people only see customers of their own and only their own transactions. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Customer Credit History');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditHistory';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$DebtorNo = '';
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper(trim($_GET['DebtorNo']));
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper(trim($_POST['DebtorNo']));
+} elseif (isset($_SESSION['CustomerID'])) {
+	$DebtorNo = $_SESSION['CustomerID'];
+}
+
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.creditlimit,
+				debtorsmaster.nextreviewdate,
+				holdreasons.reasondescription,
+				holdreasons.dissallowinvoices,
+				currencies.currabrev,
+				currencies.decimalplaces
+		FROM debtorsmaster
+		INNER JOIN holdreasons
+			ON debtorsmaster.holdreason = holdreasons.reasoncode
+		INNER JOIN currencies
+			ON debtorsmaster.currcode = currencies.currabrev
+		WHERE debtorsmaster.debtorno = '" . $DebtorNo . "'" . CreditSalesmanCustomerSQL('debtorsmaster.debtorno');
+$Result = DB_query($SQL);
+if ($DebtorNo == '' or DB_num_rows($Result) == 0) {
+	prnMsg(__('The customer was not found, or you are not allowed to see it. Select a customer first'), 'error');
+	echo '<div class="centre"><a href="' . $RootPath . '/SelectCustomer.php">' . __('Select a customer') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($Result);
+$Decimals = $Customer['decimalplaces'];
+$Outcomes = CreditReviewOutcomes();
+$Levels = CreditReminderLevels();
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . ': ' . $Customer['debtorno'] . ' - ' . $Customer['name'] . '
+	</p>';
+
+$StatusText = $Customer['reasondescription'];
+if ($Customer['dissallowinvoices'] == CREDIT_HOLD_BLOCKED) {
+	$StatusText .= ' - ' . __('ON HOLD');
+} elseif ($Customer['dissallowinvoices'] == CREDIT_HOLD_WATCH) {
+	$StatusText .= ' - ' . __('on watch');
+}
+echo '<div class="centre">' . __('Credit Limit') . ': ' . locale_number_format($Customer['creditlimit'], $Decimals) . ' ' . $Customer['currabrev'] . ' | ' .
+	__('Credit Status') . ': ' . $StatusText . ' | ' .
+	__('Next Review Due') . ': ' . ($Customer['nextreviewdate'] ? ConvertSQLDate($Customer['nextreviewdate']) : __('Never reviewed'));
+if (CreditControllerAccess()) {
+	echo ' | <a href="' . $RootPath . '/CreditReviews.php?DebtorNo=' . urlencode($DebtorNo) . '">' . __('Record a review') . '</a>';
+}
+echo '</div><br />';
+
+/* ---------- reviews, newest first ---------- */
+echo '<h3>' . __('Credit Reviews') . '</h3>';
+$Result = DB_query("SELECT reviewdate, reviewedby, outcome, oldlimit, newlimit, nextreviewdate, comments, voided, voidedby, voiddate, voidreason
+					FROM creditreviews
+					WHERE debtorno = '" . $DebtorNo . "'
+					ORDER BY reviewdate DESC, reviewid DESC");
+if (DB_num_rows($Result) == 0) {
+	echo '<div class="centre">' . __('This customer has not been reviewed yet') . '</div>';
+} else {
+	echo '<table class="selection"><tr>
+			<th>' . __('Date') . '</th><th>' . __('Reviewed By') . '</th><th>' . __('Outcome') . '</th><th>' . __('Limit') . '</th><th>' . __('Next Review') . '</th><th>' . __('Comments') . '</th>
+		</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		$LimitText = locale_number_format($MyRow['oldlimit'], $Decimals);
+		if ($MyRow['oldlimit'] != $MyRow['newlimit']) {
+			$LimitText .= ' &rarr; ' . locale_number_format($MyRow['newlimit'], $Decimals);
+		}
+		$Voided = $MyRow['voided'] ? '<br /><b>' . __('Entered by mistake') . '</b> - ' . $MyRow['voidedby'] . ' ' . $MyRow['voiddate'] . ' ' . $MyRow['voidreason'] : '';
+		echo '<tr class="striped_row">
+				<td>' . ConvertSQLDate($MyRow['reviewdate']) . '</td>
+				<td>' . $MyRow['reviewedby'] . '</td>
+				<td>' . ($Outcomes[$MyRow['outcome']] ?? $MyRow['outcome']) . '</td>
+				<td class="number">' . $LimitText . '</td>
+				<td>' . ($MyRow['nextreviewdate'] ? ConvertSQLDate($MyRow['nextreviewdate']) : '') . '</td>
+				<td>' . nl2br($MyRow['comments'] ?? '') . $Voided . '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+/* ---------- reminders sent, with the invoices included ---------- */
+echo '<h3>' . __('Reminders Sent') . '</h3>';
+$Result = DB_query("SELECT creditreminders.reminderid,
+						creditreminders.level,
+						creditreminders.onhold,
+						creditreminders.sentdate,
+						creditreminders.sentby,
+						debtortrans.transno,
+						debtortrans.trandate,
+						(debtortrans.ovamount + debtortrans.ovgst + debtortrans.ovfreight + debtortrans.ovdiscount) AS total
+					FROM creditreminders
+					INNER JOIN creditreminderitems
+						ON creditreminderitems.reminderid = creditreminders.reminderid
+					INNER JOIN debtortrans
+						ON debtortrans.id = creditreminderitems.debtortransid
+					WHERE creditreminders.debtorno = '" . $DebtorNo . "'" . CreditSalesmanTransSQL('debtortrans') . "
+					ORDER BY creditreminders.sentdate DESC, creditreminders.reminderid DESC, debtortrans.transno");
+if (DB_num_rows($Result) == 0) {
+	echo '<div class="centre">' . __('No reminders have been sent to this customer') . '</div>';
+} else {
+	echo '<table class="selection"><tr>
+			<th>' . __('Sent') . '</th><th>' . __('Sent By') . '</th><th>' . __('Level') . '</th><th>' . __('Invoice') . '</th><th>' . __('Invoice Date') . '</th><th>' . __('Invoice Total') . '</th>
+		</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . $MyRow['sentdate'] . '</td>
+				<td>' . $MyRow['sentby'] . '</td>
+				<td>' . $Levels[$MyRow['level']] . ($MyRow['onhold'] ? ' (' . __('account on hold') . ')' : '') . '</td>
+				<td>' . $MyRow['transno'] . '</td>
+				<td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+				<td class="number">' . locale_number_format($MyRow['total'], $Decimals) . '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+/* ---------- late payment charges and write-offs ---------- */
+echo '<h3>' . __('Late Payment Charges') . '</h3>';
+$Result = DB_query("SELECT creditcharges.chargemonth, creditcharges.kind, creditcharges.basis, creditcharges.rate, creditcharges.amount,
+						creditcharges.createdby, debtortrans.transno, debtortrans.trandate
+					FROM creditcharges
+					INNER JOIN debtortrans
+						ON debtortrans.id = creditcharges.debtortransid
+					WHERE creditcharges.debtorno = '" . $DebtorNo . "'" . CreditSalesmanTransSQL('debtortrans') . "
+					ORDER BY creditcharges.chargemonth DESC, creditcharges.chargeid DESC");
+if (DB_num_rows($Result) == 0) {
+	echo '<div class="centre">' . __('No late payment charges have been made to this customer') . '</div>';
+} else {
+	echo '<table class="selection"><tr>
+			<th>' . __('Month') . '</th><th>' . __('Charge') . '</th><th>' . __('Number') . '</th><th>' . __('Date') . '</th><th>' . __('Charged On') . '</th><th>' . __('Rate') . '</th><th>' . __('Amount') . '</th><th>' . __('By') . '</th><th></th>
+		</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . $MyRow['chargemonth'] . '</td>
+				<td>' . ($MyRow['kind'] == 'fee' ? __('Reminder fee') : __('Interest')) . '</td>
+				<td>' . $MyRow['transno'] . '</td>
+				<td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+				<td class="number">' . ($MyRow['kind'] == 'fee' ? '' : locale_number_format($MyRow['basis'], $Decimals)) . '</td>
+				<td class="number">' . ($MyRow['kind'] == 'fee' ? '' : locale_number_format($MyRow['rate'], 2) . '%') . '</td>
+				<td class="number">' . locale_number_format($MyRow['amount'], $Decimals) . '</td>
+				<td>' . $MyRow['createdby'] . '</td>
+				<td><a href="' . $RootPath . '/PrintCustCharge.php?TransNo=' . $MyRow['transno'] . '" target="_blank">' . __('PDF') . '</a></td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+echo '<h3>' . __('Bad Debt Write-offs') . '</h3>';
+$Result = DB_query("SELECT creditwriteoffs.writeoffdate, creditwriteoffs.userid, creditwriteoffs.reason, creditwriteoffs.amount, debtortrans.transno
+					FROM creditwriteoffs
+					INNER JOIN debtortrans
+						ON debtortrans.id = creditwriteoffs.debtortransid
+					WHERE creditwriteoffs.debtorno = '" . $DebtorNo . "'" . CreditSalesmanTransSQL('debtortrans') . "
+					ORDER BY creditwriteoffs.writeoffdate DESC, creditwriteoffs.writeoffid DESC");
+if (DB_num_rows($Result) == 0) {
+	echo '<div class="centre">' . __('Nothing has been written off for this customer') . '</div>';
+} else {
+	echo '<table class="selection"><tr>
+			<th>' . __('Date') . '</th><th>' . __('Number') . '</th><th>' . __('Amount') . '</th><th>' . __('By') . '</th><th>' . __('Reason') . '</th>
+		</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . ConvertSQLDate($MyRow['writeoffdate']) . '</td>
+				<td>' . $MyRow['transno'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['amount'], $Decimals) . '</td>
+				<td>' . $MyRow['userid'] . '</td>
+				<td>' . nl2br($MyRow['reason'] ?? '') . '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/CreditReminders.php b/CreditReminders.php
new file mode 100644
index 0000000..1926ace
--- /dev/null
+++ b/CreditReminders.php
@@ -0,0 +1,278 @@
+<?php
+
+/* Overdue reminders. The credit controller sees which customer would get which level, can leave customers
+out, and then sends. Each reminder is a PDF letter emailed to the customer contacts who receive statements.
+
+Levels: 1 friendly reminder - an invoice is past due (the same test the aged debtors report, the customer
+inquiry and the statement use for "Past Due"), 2 firm reminder - the first overdue band (PastDueDays1),
+3 final notice - the second overdue band (PastDueDays2). Customers whose account is on hold get the final
+notice wording whatever the level.
+
+A customer never gets the same level twice for the same invoices: every invoice included in a reminder is
+recorded with the level in creditreminderitems which has a unique key on (invoice, level), and an invoice is
+only reminded again when it has reached a higher level than any it has been reminded at. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Overdue Reminders');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditReminders';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/email.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if (!CreditControllerAccess()) {
+	prnMsg(__('Only the credit controller can send reminders'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$Levels = CreditReminderLevels();
+
+/**
+ * Returns the customers that would get a reminder now:
+ * array(debtorno => array('name', 'address' => array, 'decimals', 'currency', 'onhold', 'level', 'invoices' => array(...)))
+ */
+function CreditReminderCandidates($OnlyDebtorNo = '') {
+	$SQL = "SELECT debtortrans.id,
+					debtortrans.transno,
+					debtortrans.debtorno,
+					debtortrans.trandate,
+					debtortrans.balance,
+					debtortrans.reference,
+					debtorsmaster.name,
+					debtorsmaster.address1,
+					debtorsmaster.address2,
+					debtorsmaster.address3,
+					debtorsmaster.address4,
+					debtorsmaster.address5,
+					debtorsmaster.address6,
+					currencies.currabrev,
+					currencies.decimalplaces,
+					holdreasons.dissallowinvoices,
+					paymentterms.daysbeforedue,
+					paymentterms.dayinfollowingmonth,
+					" . CreditPastDueSQL(1) . " AS due1,
+					" . CreditPastDueSQL(2) . " AS due2,
+					" . CreditPastDueSQL(3) . " AS due3,
+					COALESCE(reminded.maxlevel, 0) AS maxlevel
+			FROM debtortrans
+			INNER JOIN debtorsmaster
+				ON debtortrans.debtorno = debtorsmaster.debtorno
+			INNER JOIN paymentterms
+				ON debtorsmaster.paymentterms = paymentterms.termsindicator
+			INNER JOIN currencies
+				ON debtorsmaster.currcode = currencies.currabrev
+			INNER JOIN holdreasons
+				ON debtorsmaster.holdreason = holdreasons.reasoncode
+			LEFT JOIN (SELECT debtortransid, MAX(level) AS maxlevel
+						FROM creditreminderitems
+						GROUP BY debtortransid) AS reminded
+				ON reminded.debtortransid = debtortrans.id
+			WHERE debtortrans.type = 10
+			AND ROUND(debtortrans.balance, currencies.decimalplaces) > 0 " .
+			($OnlyDebtorNo != '' ? " AND debtortrans.debtorno = '" . $OnlyDebtorNo . "' " : '') .
+			CreditSalesmanCustomerSQL('debtorsmaster.debtorno') .
+			CreditSalesmanTransSQL('debtortrans') . "
+			ORDER BY debtortrans.debtorno, debtortrans.trandate, debtortrans.transno";
+	$Result = DB_query($SQL);
+
+	$Candidates = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Level = $MyRow['due3'] ? 3 : ($MyRow['due2'] ? 2 : ($MyRow['due1'] ? 1 : 0));
+		if ($Level == 0 or $Level <= $MyRow['maxlevel']) {
+			continue; // not past due, or already reminded at this level or a higher one
+		}
+		$DebtorNo = $MyRow['debtorno'];
+		if (!isset($Candidates[$DebtorNo])) {
+			$Candidates[$DebtorNo] = array(
+				'name' => $MyRow['name'],
+				'address' => array_filter(array($MyRow['address1'], $MyRow['address2'], $MyRow['address3'], $MyRow['address4'], $MyRow['address5'], $MyRow['address6'])),
+				'decimals' => $MyRow['decimalplaces'],
+				'currency' => $MyRow['currabrev'],
+				'onhold' => ($MyRow['dissallowinvoices'] == CREDIT_HOLD_BLOCKED),
+				'level' => 0,
+				'total' => 0,
+				'invoices' => array()
+			);
+		}
+		$Candidates[$DebtorNo]['level'] = max($Candidates[$DebtorNo]['level'], $Level);
+		$Candidates[$DebtorNo]['total'] += $MyRow['balance'];
+		$Candidates[$DebtorNo]['invoices'][] = array(
+			'id' => $MyRow['id'],
+			'transno' => $MyRow['transno'],
+			'trandate' => $MyRow['trandate'],
+			'duedate' => CalcDueDate(ConvertSQLDate($MyRow['trandate']), $MyRow['dayinfollowingmonth'], $MyRow['daysbeforedue']),
+			'balance' => $MyRow['balance'],
+			'reference' => $MyRow['reference'],
+			'level' => $Level
+		);
+	}
+	return $Candidates;
+}
+
+/** The letter as HTML */
+function CreditReminderLetterHTML($DebtorNo, $Customer, $Level) {
+	$Levels = CreditReminderLevels();
+	// customers on hold get the final notice wording
+	$WordingLevel = $Customer['onhold'] ? 3 : $Level;
+	$Wording = $_SESSION['ReminderText' . $WordingLevel] ?? '';
+
+	$HTML = '<!DOCTYPE html><html><head>' . CreditPDFStyle() . '</head><body>';
+	$HTML .= CreditLetterHeadHTML();
+	$HTML .= '<p>' . date($_SESSION['DefaultDateFormat']) . '</p>';
+	$HTML .= '<p><b>' . $Customer['name'] . '</b><br />' . implode('<br />', $Customer['address']) . '</p>';
+	$HTML .= '<div class="header">' . $Levels[$WordingLevel] . ' - ' . __('Account') . ' ' . $DebtorNo . '</div>';
+	$HTML .= '<p>' . nl2br($Wording) . '</p>';
+	$HTML .= '<table><tr><th>' . __('Invoice') . '</th><th>' . __('Reference') . '</th><th>' . __('Invoice Date') . '</th><th>' . __('Due Date') . '</th><th>' . __('Amount Outstanding') . '</th></tr>';
+	$Total = 0;
+	foreach ($Customer['invoices'] as $Invoice) {
+		$Total += $Invoice['balance'];
+		$HTML .= '<tr><td>' . $Invoice['transno'] . '</td><td>' . $Invoice['reference'] . '</td><td>' . ConvertSQLDate($Invoice['trandate']) . '</td><td>' . $Invoice['duedate'] . '</td><td class="right">' . locale_number_format($Invoice['balance'], $Customer['decimals']) . ' ' . $Customer['currency'] . '</td></tr>';
+	}
+	$HTML .= '<tr><td colspan="4"><b>' . __('Total') . '</b></td><td class="right"><b>' . locale_number_format($Total, $Customer['decimals']) . ' ' . $Customer['currency'] . '</b></td></tr></table>';
+	$HTML .= '<p>' . __('If you have already paid these invoices please let us know the date and the way the payment was made.') . '</p>';
+	$HTML .= '</body></html>';
+	return $HTML;
+}
+
+/* ---------- send the selected reminders ---------- */
+if (isset($_POST['Send'])) {
+	$Sent = array();
+	$Failed = array();
+	$Candidates = CreditReminderCandidates();
+	$Chosen = isset($_POST['Include']) && is_array($_POST['Include']) ? array_keys($_POST['Include']) : array();
+
+	foreach ($Chosen as $DebtorNo) {
+		if (!isset($Candidates[$DebtorNo])) {
+			$Failed[$DebtorNo] = __('Nothing to remind about any more - it was sent already, paid, or is not yet past due');
+			continue;
+		}
+		$Customer = $Candidates[$DebtorNo];
+		if (!isset($_POST['Level'][$DebtorNo]) or $_POST['Level'][$DebtorNo] != $Customer['level']) {
+			$Failed[$DebtorNo] = __('The level changed since the list was shown. Review the list again');
+			continue;
+		}
+		$Recipients = CreditStatementContacts($DebtorNo);
+		if (count($Recipients) == 0) {
+			$Failed[$DebtorNo] = __('The customer has no contact with an email address that receives statements');
+			continue;
+		}
+
+		DB_Txn_Begin();
+		$SQL = "INSERT INTO creditreminders (debtorno, level, onhold, sentdate, sentby, recipients)
+				VALUES ('" . $DebtorNo . "',
+						'" . $Customer['level'] . "',
+						'" . ($Customer['onhold'] ? 1 : 0) . "',
+						'" . date('Y-m-d H:i:s') . "',
+						'" . $_SESSION['UserID'] . "',
+						'" . DB_escape_string(mb_substr(implode(', ', array_keys($Recipients)), 0, 255)) . "')";
+		DB_query($SQL, __('The reminder could not be recorded because'), '', true);
+		$ReminderID = DB_Last_Insert_ID('creditreminders', 'reminderid');
+
+		$Duplicate = false;
+		foreach ($Customer['invoices'] as $Invoice) {
+			// the unique key (invoice, level) stops the same level being sent twice for the same invoice
+			DB_query("INSERT INTO creditreminderitems (reminderid, debtortransid, level)
+					VALUES ('" . $ReminderID . "', '" . $Invoice['id'] . "', '" . $Customer['level'] . "')", '', '', false, false);
+			if (DB_error_no() != 0) {
+				$Duplicate = true;
+				break;
+			}
+		}
+		if ($Duplicate) {
+			DB_Txn_Rollback();
+			DB_Txn_Commit(); // back to autocommit
+			$Failed[$DebtorNo] = __('Another reminder at this level for these invoices has just been sent');
+			continue;
+		}
+
+		$HTML = CreditReminderLetterHTML($DebtorNo, $Customer, $Customer['level']);
+		$WordingLevel = $Customer['onhold'] ? 3 : $Customer['level'];
+		$Delivered = CreditEmailPDF($Recipients,
+			$_SESSION['CompanyRecord']['coyname'] . ' - ' . $Levels[$WordingLevel] . ' - ' . $DebtorNo,
+			__('Please find attached a letter about your account') . ' ' . $DebtorNo . '.',
+			$HTML,
+			'Reminder_' . $DebtorNo . '_' . date('Ymd') . '.pdf');
+
+		if ($Delivered) {
+			DB_Txn_Commit();
+			$Sent[$DebtorNo] = $Levels[$Customer['level']] . ' - ' . implode(', ', array_keys($Recipients));
+		} else {
+			// the email failed so the reminder is not counted as sent
+			DB_Txn_Rollback();
+			DB_Txn_Commit(); // back to autocommit
+			$Failed[$DebtorNo] = __('The email could not be sent to') . ' ' . implode(', ', array_keys($Recipients));
+		}
+	}
+
+	if (count($Sent) > 0) {
+		echo '<h3>' . __('Reminders sent') . '</h3><table class="selection"><tr><th>' . __('Customer') . '</th><th>' . __('Reminder') . '</th></tr>';
+		foreach ($Sent as $DebtorNo => $Text) {
+			echo '<tr class="striped_row"><td>' . htmlspecialchars($DebtorNo, ENT_QUOTES, 'UTF-8') . '</td><td>' . $Text . '</td></tr>';
+		}
+		echo '</table>';
+	}
+	if (count($Failed) > 0) {
+		echo '<h3>' . __('Reminders NOT sent') . '</h3><table class="selection"><tr><th>' . __('Customer') . '</th><th>' . __('Reason') . '</th></tr>';
+		foreach ($Failed as $DebtorNo => $Text) {
+			echo '<tr class="striped_row"><td>' . htmlspecialchars($DebtorNo, ENT_QUOTES, 'UTF-8') . '</td><td class="bad">' . $Text . '</td></tr>';
+		}
+		echo '</table>';
+	}
+	if (count($Sent) == 0 and count($Failed) == 0) {
+		prnMsg(__('No customers were selected'), 'info');
+	}
+	echo '<br />';
+}
+
+/* ---------- the list of who would get what ---------- */
+$Candidates = CreditReminderCandidates();
+
+if (count($Candidates) == 0) {
+	prnMsg(__('There are no customers to send a reminder to'), 'info');
+	include('includes/footer.php');
+	exit();
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<table class="selection">
+		<tr>
+			<th>' . __('Send') . '</th>
+			<th>' . __('Customer') . '</th>
+			<th>' . __('Reminder') . '</th>
+			<th>' . __('Invoices') . '</th>
+			<th>' . __('Amount') . '</th>
+			<th>' . __('Sent To') . '</th>
+		</tr>';
+foreach ($Candidates as $DebtorNo => $Customer) {
+	$Recipients = CreditStatementContacts($DebtorNo);
+	$Invoices = array();
+	foreach ($Customer['invoices'] as $Invoice) {
+		$Invoices[] = $Invoice['transno'];
+	}
+	$LevelText = $Levels[$Customer['level']];
+	if ($Customer['onhold']) {
+		$LevelText .= '<br /><b>' . __('Account on hold - final notice wording') . '</b>';
+	}
+	echo '<tr class="striped_row">
+			<td><input type="checkbox" name="Include[' . $DebtorNo . ']" value="1"' . (count($Recipients) > 0 ? ' checked="checked"' : '') . ' />
+				<input type="hidden" name="Level[' . $DebtorNo . ']" value="' . $Customer['level'] . '" /></td>
+			<td><a href="' . $RootPath . '/CreditHistory.php?DebtorNo=' . urlencode($DebtorNo) . '">' . $DebtorNo . '</a> - ' . $Customer['name'] . '</td>
+			<td>' . $LevelText . '</td>
+			<td>' . implode(', ', $Invoices) . '</td>
+			<td class="number">' . locale_number_format($Customer['total'], $Customer['decimals']) . ' ' . $Customer['currency'] . '</td>
+			<td>' . (count($Recipients) > 0 ? implode(', ', array_keys($Recipients)) : '<span class="bad">' . __('No contact receives statements - it will not be sent') . '</span>') . '</td>
+		</tr>';
+}
+echo '</table>
+	<div class="centre"><input type="submit" name="Send" value="' . __('Send the reminders ticked') . '" onclick="return confirm(\'' . __('Send the reminders ticked?') . '\');" /></div>
+	</form>';
+
+include('includes/footer.php');
diff --git a/CreditReviewReport.php b/CreditReviewReport.php
new file mode 100644
index 0000000..1abdc28
--- /dev/null
+++ b/CreditReviewReport.php
@@ -0,0 +1,149 @@
+<?php
+
+/* Lists the customers whose credit review is overdue (or never done) or due within a number of days,
+with balance, overdue amount, credit limit, credit still available and the date they last paid.
+Can be printed as PDF. Sales people only see their own customers. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Days = 30;
+if (isset($_POST['Days']) and is_numeric($_POST['Days']) and $_POST['Days'] >= 0 and $_POST['Days'] <= 3650) {
+	$Days = (int) $_POST['Days'];
+} elseif (isset($_GET['Days']) and is_numeric($_GET['Days']) and $_GET['Days'] >= 0 and $_GET['Days'] <= 3650) {
+	$Days = (int) $_GET['Days'];
+}
+$Cutoff = date('Y-m-d', strtotime('+' . $Days . ' days'));
+
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.creditlimit,
+				debtorsmaster.nextreviewdate,
+				debtorsmaster.lastpaiddate,
+				currencies.currabrev,
+				currencies.decimalplaces,
+				holdreasons.reasondescription,
+				holdreasons.dissallowinvoices,
+				COALESCE(SUM(debtortrans.balance), 0) AS balance,
+				COALESCE(SUM(CASE WHEN debtortrans.id IS NOT NULL AND " . CreditPastDueSQL(1) . " = 1 THEN debtortrans.balance ELSE 0 END), 0) AS overdue
+		FROM debtorsmaster
+		INNER JOIN paymentterms
+			ON debtorsmaster.paymentterms = paymentterms.termsindicator
+		INNER JOIN currencies
+			ON debtorsmaster.currcode = currencies.currabrev
+		INNER JOIN holdreasons
+			ON debtorsmaster.holdreason = holdreasons.reasoncode
+		LEFT JOIN debtortrans
+			ON debtortrans.debtorno = debtorsmaster.debtorno " . CreditSalesmanTransSQL('debtortrans') . "
+		WHERE (debtorsmaster.nextreviewdate IS NULL OR debtorsmaster.nextreviewdate <= '" . $Cutoff . "') " . CreditSalesmanCustomerSQL('debtorsmaster.debtorno') . "
+		GROUP BY debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.creditlimit,
+				debtorsmaster.nextreviewdate,
+				debtorsmaster.lastpaiddate,
+				currencies.currabrev,
+				currencies.decimalplaces,
+				holdreasons.reasondescription,
+				holdreasons.dissallowinvoices,
+				paymentterms.daysbeforedue,
+				paymentterms.dayinfollowingmonth
+		ORDER BY debtorsmaster.nextreviewdate, debtorsmaster.debtorno";
+
+/* the group by includes the payment terms columns, so a customer is one row only as it has one set of terms */
+$Result = DB_query($SQL);
+
+$Today = date('Y-m-d');
+$Rows = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	$MyRow['available'] = GetCreditAvailable($MyRow['debtorno']);
+	if ($MyRow['nextreviewdate'] === null) {
+		$MyRow['state'] = __('Never reviewed');
+	} elseif ($MyRow['nextreviewdate'] < $Today) {
+		$MyRow['state'] = __('Overdue');
+	} else {
+		$MyRow['state'] = __('Due');
+	}
+	$Rows[] = $MyRow;
+}
+
+function CreditReviewReportTable($Rows, $ForPDF) {
+	$HTML = '<table class="selection"><tr>
+			<th>' . __('Customer') . '</th>
+			<th>' . __('Name') . '</th>
+			<th>' . __('Review Due') . '</th>
+			<th>' . __('State') . '</th>
+			<th>' . __('Credit Status') . '</th>
+			<th>' . __('Balance') . '</th>
+			<th>' . __('Overdue Amount') . '</th>
+			<th>' . __('Credit Limit') . '</th>
+			<th>' . __('Credit Available') . '</th>
+			<th>' . __('Last Paid') . '</th>
+		</tr>';
+	foreach ($Rows as $MyRow) {
+		$Decimals = $MyRow['decimalplaces'];
+		$Customer = $MyRow['debtorno'];
+		if (!$ForPDF) {
+			$Customer = '<a href="' . $GLOBALS['RootPath'] . '/CreditReviews.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . $MyRow['debtorno'] . '</a>';
+		}
+		$HTML .= '<tr class="striped_row">
+				<td>' . $Customer . '</td>
+				<td>' . $MyRow['name'] . '</td>
+				<td>' . ($MyRow['nextreviewdate'] ? ConvertSQLDate($MyRow['nextreviewdate']) : '') . '</td>
+				<td>' . $MyRow['state'] . '</td>
+				<td>' . $MyRow['reasondescription'] . '</td>
+				<td class="number right">' . locale_number_format($MyRow['balance'], $Decimals) . ' ' . $MyRow['currabrev'] . '</td>
+				<td class="number right">' . locale_number_format($MyRow['overdue'], $Decimals) . '</td>
+				<td class="number right">' . locale_number_format($MyRow['creditlimit'], $Decimals) . '</td>
+				<td class="number right">' . locale_number_format($MyRow['available'], $Decimals) . '</td>
+				<td>' . ($MyRow['lastpaiddate'] ? ConvertSQLDate($MyRow['lastpaiddate']) : '') . '</td>
+			</tr>';
+	}
+	return $HTML . '</table>';
+}
+
+if (isset($_POST['PrintPDF'])) {
+	$HTML = '<!DOCTYPE html><html><head>' . CreditPDFStyle() . '</head><body>' .
+		CreditLetterHeadHTML() .
+		'<div class="header">' . __('Customer Credit Reviews Due') . ' - ' . sprintf(__('overdue or due within %s days, up to'), $Days) . ' ' . ConvertSQLDate($Cutoff) . '</div>' .
+		CreditReviewReportTable($Rows, true) .
+		'</body></html>';
+	$PDF = CreditRenderPDF($HTML, 'landscape');
+	header('Content-Type: application/pdf');
+	header('Content-Disposition: inline; filename="' . $_SESSION['DatabaseName'] . '_CreditReviewsDue_' . date('Y-m-d') . '.pdf"');
+	echo $PDF;
+	exit();
+}
+
+$Title = __('Customer Credit Reviews Due');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditReviewReport';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Selection') . '</legend>
+		<field>
+			<label for="Days">' . __('Reviews overdue or due within (days)') . ':</label>
+			<input type="text" class="integer" name="Days" value="' . $Days . '" size="5" maxlength="4" />
+		</field>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="Show" value="' . __('Show') . '" />
+		<input type="submit" name="PrintPDF" value="' . __('Print PDF') . '" formtarget="_blank" />
+	</div>
+	</form>';
+
+if (count($Rows) == 0) {
+	prnMsg(__('No customer reviews are overdue or due within that time'), 'info');
+} else {
+	echo CreditReviewReportTable($Rows, false);
+}
+
+include('includes/footer.php');

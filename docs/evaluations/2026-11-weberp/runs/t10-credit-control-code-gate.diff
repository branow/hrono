+		<field><label>' . __('Balance') . ':</label><fieldtext>' . locale_number_format($BalanceRow[0], $Decimals) . '</fieldtext></field>
+		<field><label>' . __('Credit Status') . ':</label><fieldtext>' . $StatusText . '</fieldtext></field>
+		<field><label>' . __('Next Review Due') . ':</label><fieldtext>' . ($Customer['nextreviewdate'] ? ConvertSQLDate($Customer['nextreviewdate']) : __('Never reviewed')) . '</fieldtext></field>

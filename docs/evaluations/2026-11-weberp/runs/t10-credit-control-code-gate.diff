+			<input type="text" name="DebtorNo" value="' . $DebtorNo . '" size="12" maxlength="10" />
+			<fieldhelp>' . __('Or use the customer search and follow the Credit Reviews link on the customer page') . '</fieldhelp>
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Select" value="' . __('Select') . '" /></div>
+	</form>';
+
+if ($DebtorNo == '') {
+	include('includes/footer.php');
+	exit();
+}
+
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.creditlimit,
+				debtorsmaster.holdreason,
+				debtorsmaster.nextreviewdate,
+				holdreasons.reasondescription,
+				holdreasons.dissallowinvoices,
+				currencies.currabrev,
+				currencies.decimalplaces
+		FROM debtorsmaster
+		INNER JOIN holdreasons
+			ON debtorsmaster.holdreason = holdreasons.reasoncode
+		INNER JOIN currencies
+			ON debtorsmaster.currcode = currencies.currabrev
+		WHERE debtorsmaster.debtorno = '" . $DebtorNo . "'" . CreditSalesmanCustomerSQL('debtorsmaster.debtorno');
+$Result = DB_query($SQL);
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('The customer was not found, or you are not allowed to see it'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($Result);
+$Decimals = $Customer['decimalplaces'];
+
+$Outcomes = CreditReviewOutcomes();
+
+/* ---------- void a review entered by mistake ---------- */
+if (isset($_POST['VoidReview'])) {
+	if (!CreditControllerAccess()) {
+		prnMsg(__('Only the credit controller can correct a credit review'), 'error');
+	} elseif (trim($_POST['VoidReason']) == '') {
+		prnMsg(__('A reason for correcting the review must be entered'), 'error');
+	} else {
+		$SQL = "UPDATE creditreviews
+				SET voided = 1,
+					voidedby = '" . $_SESSION['UserID'] . "',
+					voiddate = '" . date('Y-m-d H:i:s') . "',
+					voidreason = '" . mb_substr($_POST['VoidReason'], 0, 255) . "'
+				WHERE reviewid = '" . (int) $_POST['ReviewID'] . "'
+				AND debtorno = '" . $DebtorNo . "'
+				AND voided = 0";
+		DB_query($SQL, __('The review could not be corrected because'));
+		prnMsg(__('The review has been marked as entered by mistake. It stays in the history. The credit limit and credit status of the customer have not been changed by this - enter a new review if they need to be put right'), 'success');
+	}
+}
+
+/* ---------- save a new review ---------- */
+if (isset($_POST['SaveReview'])) {

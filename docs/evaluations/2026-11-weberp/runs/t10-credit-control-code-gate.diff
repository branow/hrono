+	$NextReviewDate = trim($_POST['NextReviewDate']);
+
+	if (!CreditControllerAccess()) {
+		$InputError = 1;
+		prnMsg(__('Only the credit controller can record a credit review'), 'error');
+	}
+	if (!isset($Outcomes[$Outcome])) {
+		$InputError = 1;
+		prnMsg(__('Select the outcome of the review'), 'error');
+	}
+	if (!CreditIsSQLDate($NextReviewDate) or $NextReviewDate <= date('Y-m-d')) {
+		$InputError = 1;
+		prnMsg(__('The date the next review is due must be a date in the future'), 'error');
+	}
+	if ($InputError == 0 and $Outcome != 'keep' and $Comments == '') {
+		$InputError = 1;
+		prnMsg(__('Comments explaining why the limit or the status of the account is changed must be entered'), 'error');
+	}
+	if ($InputError == 0 and ($Outcome == 'raise' or $Outcome == 'lower')) {
+		$NewLimit = filter_number_format($_POST['NewLimit']);
+		if (!is_numeric($NewLimit) or $NewLimit < 0) {
+			$InputError = 1;
+			prnMsg(__('The new credit limit must be a number that is not negative'), 'error');
+		} elseif ($Outcome == 'raise' and $NewLimit <= $Customer['creditlimit']) {
+			$InputError = 1;
+			prnMsg(__('A raised credit limit must be higher than the current limit'), 'error');
+		} elseif ($Outcome == 'lower' and $NewLimit >= $Customer['creditlimit']) {
+			$InputError = 1;
+			prnMsg(__('A lowered credit limit must be lower than the current limit'), 'error');
+		}
+	}
+	if ($InputError == 0 and ($Outcome == 'hold' or $Outcome == 'watch' or $Outcome == 'release')) {
+		$WantedKind = array('hold' => CREDIT_HOLD_BLOCKED, 'watch' => CREDIT_HOLD_WATCH, 'release' => CREDIT_HOLD_NONE);
+		$NewHold = (int) $_POST['HoldReason' . $Outcome];
+		$HoldResult = DB_query("SELECT dissallowinvoices FROM holdreasons WHERE reasoncode = '" . $NewHold . "'");
+		$HoldRow = DB_fetch_row($HoldResult);
+		if (!$HoldRow or $HoldRow[0] != $WantedKind[$Outcome]) {
+			$InputError = 1;
+			prnMsg(__('The credit status selected does not match the outcome of the review'), 'error');
+		} elseif ($NewHold == $Customer['holdreason']) {
+			$InputError = 1;
+			prnMsg(__('The account already has that credit status'), 'error');
+		}
+	}
+
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+
+		/* lock the customer and read the values the review is changing from the database, not from the form */
+		$LockResult = DB_query("SELECT creditlimit, holdreason
+								FROM debtorsmaster
+								WHERE debtorno = '" . $DebtorNo . "'
+								FOR UPDATE", __('The customer could not be read because'), '', true);
+		$Old = DB_fetch_array($LockResult);
+
+		$SQL = "INSERT INTO creditreviews (debtorno,
+											reviewdate,
+											reviewedby,
+											outcome,
+											oldlimit,
+											newlimit,
+											oldholdreason,
+											newholdreason,
+											nextreviewdate,
+											comments)
+				VALUES ('" . $DebtorNo . "',
+						'" . date('Y-m-d') . "',
+						'" . $_SESSION['UserID'] . "',
+						'" . $Outcome . "',
+						'" . $Old['creditlimit'] . "',
+						'" . $NewLimit . "',
+						'" . $Old['holdreason'] . "',
+						'" . $NewHold . "',
+						'" . $NextReviewDate . "',
+						'" . $Comments . "')";
+		DB_query($SQL, __('The review could not be saved because'), '', true);
+
+		$SQL = "UPDATE debtorsmaster
+				SET creditlimit = '" . $NewLimit . "',
+					holdreason = '" . $NewHold . "',
+					nextreviewdate = '" . $NextReviewDate . "'
+				WHERE debtorno = '" . $DebtorNo . "'";
+		DB_query($SQL, __('The customer could not be updated because'), '', true);
+
+		DB_Txn_Commit();
+
+		prnMsg(__('The credit review has been recorded') . ': ' . $Outcomes[$Outcome], 'success');
+
+		// re-read the customer for the display below
+		$Result = DB_query("SELECT debtorsmaster.debtorno, debtorsmaster.name, debtorsmaster.creditlimit, debtorsmaster.holdreason,
+							debtorsmaster.nextreviewdate, holdreasons.reasondescription, holdreasons.dissallowinvoices,
+							currencies.currabrev, currencies.decimalplaces
+							FROM debtorsmaster
+							INNER JOIN holdreasons ON debtorsmaster.holdreason = holdreasons.reasoncode
+							INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+							WHERE debtorsmaster.debtorno = '" . $DebtorNo . "'");
+		$Customer = DB_fetch_array($Result);
+		unset($_POST['Comments']);
+	}
+}
+
+/* ---------- the customer and the form ---------- */
+$BalanceResult = DB_query("SELECT SUM(balance) FROM debtortrans WHERE debtorno = '" . $DebtorNo . "'");
+$BalanceRow = DB_fetch_row($BalanceResult);
+
+$StatusText = $Customer['reasondescription'];
+if ($Customer['dissallowinvoices'] == CREDIT_HOLD_BLOCKED) {
+	$StatusText .= ' - ' . __('ON HOLD');
+} elseif ($Customer['dissallowinvoices'] == CREDIT_HOLD_WATCH) {
+	$StatusText .= ' - ' . __('on watch');
+}
+
+echo '<fieldset>
+		<legend>' . $Customer['debtorno'] . ' - ' . $Customer['name'] . '</legend>

+			echo '<option value="' . $HoldRow['reasoncode'] . '"' . ((isset($_POST['HoldReason' . $Key]) and $_POST['HoldReason' . $Key] == $HoldRow['reasoncode']) ? ' selected="selected"' : '') . '>' . $HoldRow['reasondescription'] . '</option>';
+		}
+		echo '</select>
+			</field>';
+	}
+
+	echo '<field>
+				<label for="NextReviewDate">' . __('Next Review Due') . ':</label>
+				<input type="date" name="NextReviewDate" required="required" value="' . ($_POST['NextReviewDate'] ?? CreditDefaultNextReviewDate()) . '" />
+				<fieldhelp>' . __('Large or risky customers should be reviewed more often than once a year') . '</fieldhelp>
+			</field>
+			<field>
+				<label for="Comments">' . __('Comments') . ':</label>
+				<textarea name="Comments" rows="10" cols="80">' . ($_POST['Comments'] ?? '') . '</textarea>
+				<fieldhelp>' . __('Required when the limit or the status of the account changes. Quotes from the customer emails can be pasted here') . '</fieldhelp>
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="SaveReview" value="' . __('Save Review') . '" /></div>
+		</form>';
+} else {
+	prnMsg(__('You can look at the credit reviews but only the credit controller can record one'), 'info');
+}
+
+/* ---------- history, newest first ---------- */
+$SQL = "SELECT reviewid, reviewdate, reviewedby, outcome, oldlimit, newlimit, oldholdreason, newholdreason,
+			nextreviewdate, comments, voided, voidedby, voiddate, voidreason
+		FROM creditreviews
+		WHERE debtorno = '" . $DebtorNo . "'
+		ORDER BY reviewdate DESC, reviewid DESC";
+$Result = DB_query($SQL);
+if (DB_num_rows($Result) > 0) {
+	echo '<table class="selection">
+		<tr>
+			<th>' . __('Date') . '</th>
+			<th>' . __('Reviewed By') . '</th>
+			<th>' . __('Outcome') . '</th>
+			<th>' . __('Limit') . '</th>
+			<th>' . __('Next Review') . '</th>
+			<th>' . __('Comments') . '</th>
+			<th></th>
+		</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		$LimitText = locale_number_format($MyRow['oldlimit'], $Decimals);
+		if ($MyRow['oldlimit'] != $MyRow['newlimit']) {
+			$LimitText .= ' &rarr; ' . locale_number_format($MyRow['newlimit'], $Decimals);
+		}
+		echo '<tr class="striped_row">
+				<td>' . ConvertSQLDate($MyRow['reviewdate']) . '</td>
+				<td>' . $MyRow['reviewedby'] . '</td>
+				<td>' . ($Outcomes[$MyRow['outcome']] ?? $MyRow['outcome']) . '</td>
+				<td class="number">' . $LimitText . '</td>
+				<td>' . ($MyRow['nextreviewdate'] ? ConvertSQLDate($MyRow['nextreviewdate']) : '') . '</td>

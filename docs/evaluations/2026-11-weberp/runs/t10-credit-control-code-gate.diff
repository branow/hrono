+<?php
+
+/* Records a credit review of a customer. When the review changes the credit limit or the hold on the account
+the customer is changed in the same database transaction - if either part fails neither is saved. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Customer Credit Reviews');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditReviews';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . __('Credit Review') . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$DebtorNo = '';
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper(trim($_GET['DebtorNo']));
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper(trim($_POST['DebtorNo']));
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">

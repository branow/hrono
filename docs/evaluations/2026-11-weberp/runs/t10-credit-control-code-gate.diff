+<?php
+
+/* Customers who log in see their own reminders and late payment charges here, and nobody else's.
+The customer is taken from the logged in user in the database, never from the request or the session variable
+that the customer search pages change. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('My Reminders and Charges');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CustomerCreditNotices';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$DebtorNo = CreditCustomerLoginDebtorNo();
+if ($DebtorNo == '') {
+	prnMsg(__('This page is for customers who log in to see their own account'), 'info');
+	include('includes/footer.php');
+	exit();
+}
+
+$Result = DB_query("SELECT debtorsmaster.name, currencies.decimalplaces, currencies.currabrev
+					FROM debtorsmaster
+					INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+					WHERE debtorsmaster.debtorno = '" . DB_escape_string($DebtorNo) . "'");
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('Your customer account could not be found'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($Result);
+$Decimals = $Customer['decimalplaces'];
+$Levels = CreditReminderLevels();
+$Escaped = DB_escape_string($DebtorNo);
+
+echo '<h3>' . $DebtorNo . ' - ' . $Customer['name'] . '</h3>';
+
+echo '<h3>' . __('Reminders') . '</h3>';
+$Result = DB_query("SELECT creditreminders.sentdate,
+						creditreminders.level,
+						creditreminders.onhold,
+						debtortrans.transno,
+						debtortrans.trandate,
+						(debtortrans.ovamount + debtortrans.ovgst + debtortrans.ovfreight + debtortrans.ovdiscount) AS total
+					FROM creditreminders
+					INNER JOIN creditreminderitems ON creditreminderitems.reminderid = creditreminders.reminderid
+					INNER JOIN debtortrans ON debtortrans.id = creditreminderitems.debtortransid
+					WHERE creditreminders.debtorno = '" . $Escaped . "'
+					AND debtortrans.debtorno = '" . $Escaped . "'
+					ORDER BY creditreminders.sentdate DESC, creditreminders.reminderid DESC, debtortrans.transno");
+if (DB_num_rows($Result) == 0) {
+	echo '<div class="centre">' . __('You have not been sent any reminders') . '</div>';
+} else {
+	echo '<table class="selection"><tr><th>' . __('Sent') . '</th><th>' . __('Reminder') . '</th><th>' . __('Invoice') . '</th><th>' . __('Invoice Date') . '</th><th>' . __('Invoice Total') . '</th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . ConvertSQLDateTime($MyRow['sentdate']) . '</td>
+				<td>' . $Levels[$MyRow['level']] . '</td>
+				<td>' . $MyRow['transno'] . '</td>
+				<td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+				<td class="number">' . locale_number_format($MyRow['total'], $Decimals) . ' ' . $Customer['currabrev'] . '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+echo '<h3>' . __('Late Payment Charges') . '</h3>';
+$Result = DB_query("SELECT debtortrans.transno,
+						debtortrans.trandate,
+						debtortrans.reference,
+						debtortrans.invtext,
+						debtortrans.ovamount,
+						debtortrans.balance
+					FROM debtortrans
+					WHERE debtortrans.debtorno = '" . $Escaped . "'
+					AND debtortrans.type = " . CREDIT_TRANS_CHARGE . "
+					ORDER BY debtortrans.trandate DESC, debtortrans.id DESC");
+if (DB_num_rows($Result) == 0) {
+	echo '<div class="centre">' . __('You have not been charged any late payment charges') . '</div>';
+} else {
+	echo '<table class="selection"><tr><th>' . __('Number') . '</th><th>' . __('Date') . '</th><th>' . __('Charge') . '</th><th>' . __('Amount') . '</th><th>' . __('Left To Pay') . '</th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . $MyRow['transno'] . '</td>
+				<td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+				<td>' . $MyRow['reference'] . '<br />' . $MyRow['invtext'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['ovamount'], $Decimals) . ' ' . $Customer['currabrev'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['balance'], $Decimals) . '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');

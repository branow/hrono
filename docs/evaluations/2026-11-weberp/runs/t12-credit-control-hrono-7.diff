+
+/* ---------- reminder stages ---------- */
+echo '<div class="page_help_text">' . __('In the letters, {customer}, {company}, {amount}, {currency} and {invoices} are replaced by the customer name, your company name, the amount overdue, the currency and the list of overdue invoices.') . '</div>';
+$StageResult = DB_query("SELECT stage, daysoverdue, subject, body FROM dunningstages ORDER BY daysoverdue, stage");
+$Rows = array();
+while ($StageRow = DB_fetch_array($StageResult)) {
+	$Rows[] = $StageRow;
+}

+<?php
+
+/* The credit controller's weekly worklist: customers due or overdue a credit review, customers over their limit, customers on watch or on stop,
+and the orders that are held for credit control or taken for customers on watch. Totals are in the home currency. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Control Report');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlReport';
+include('includes/header.php');
+
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />
+		' . $Title . '
+	</p>';
+
+/* ---- release a held order (BR-10) or an order of a customer on stop (BR-06) ---- */
+if (isset($_POST['ReleaseOrder'])) {
+	$OrderNo = (int) $_POST['ReleaseOrder'];
+	$OrderResult = DB_query("SELECT debtorno FROM salesorders WHERE orderno = '" . $OrderNo . "'");
+	if (DB_num_rows($OrderResult) == 1) {
+		$OrderRow = DB_fetch_array($OrderResult);
+		DB_query("UPDATE salesorders SET creditheld = 2 WHERE orderno = '" . $OrderNo . "'");
+		CreditControlLog($OrderRow['debtorno'], 'ORDER_RELEASE', __('Sales order') . ' ' . $OrderNo . ' ' . __('released by credit control'));
+		prnMsg(__('Sales order') . ' ' . $OrderNo . ' ' . __('has been released and can now be dispatched and invoiced'), 'success');
+	}
+}
+
+$Salesman = '';
+if ($_SESSION['SalesmanLogin'] != '') {
+	$Salesman = $_SESSION['SalesmanLogin'];
+} elseif (isset($_POST['Salesman'])) {
+	$Salesman = $_POST['Salesman'];
+}
+$Currency = isset($_POST['Currency']) ? $_POST['Currency'] : '';
+
+echo '<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Filter') . '</legend>
+			<field>
+				<label for="Salesman">' . __('Sales person') . ':</label>';
+if ($_SESSION['SalesmanLogin'] != '') {
+	echo '<fieldtext>' . $_SESSION['UsersRealName'] . '</fieldtext>';
+} else {
+	echo '<select name="Salesman"><option value="">' . __('All sales people') . '</option>';
+	$SalesResult = DB_query("SELECT salesmancode, salesmanname FROM salesman ORDER BY salesmanname");
+	while ($SalesRow = DB_fetch_array($SalesResult)) {
+		echo '<option ' . ($Salesman == $SalesRow['salesmancode'] ? 'selected="selected" ' : '') . 'value="' . $SalesRow['salesmancode'] . '">' . htmlspecialchars($SalesRow['salesmanname'], ENT_QUOTES, 'UTF-8') . '</option>';
+	}
+	echo '</select>';
+}
+echo '	</field>
+			<field>
+				<label for="Currency">' . __('Currency') . ':</label>
+				<select name="Currency"><option value="">' . __('All currencies') . '</option>';
+$CurrencyResult = DB_query("SELECT currabrev, currency FROM currencies ORDER BY currabrev");
+while ($CurrencyRow = DB_fetch_array($CurrencyResult)) {
+	echo '<option ' . ($Currency == $CurrencyRow['currabrev'] ? 'selected="selected" ' : '') . 'value="' . $CurrencyRow['currabrev'] . '">' . $CurrencyRow['currabrev'] . ' - ' . htmlspecialchars($CurrencyRow['currency'], ENT_QUOTES, 'UTF-8') . '</option>';
+}
+echo '</select>
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Show" value="' . __('Show the report') . '" /></div>
+	</form>';
+
+$Where = '';
+if ($Salesman != '') {
+	$Where .= " AND EXISTS (SELECT 1 FROM custbranch WHERE custbranch.debtorno = debtorsmaster.debtorno AND custbranch.salesman = '" . $Salesman . "')";
+}
+if ($Currency != '') {
+	$Where .= " AND debtorsmaster.currcode = '" . $Currency . "'";
+}
+
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				debtorsmaster.creditlimit,
+				debtorsmaster.nextcreditreview,
+				holdreasons.dissallowinvoices,
+				holdreasons.reasondescription,
+				currencies.rate,
+				currencies.decimalplaces,
+				(SELECT custbranch.salesman FROM custbranch WHERE custbranch.debtorno = debtorsmaster.debtorno ORDER BY custbranch.branchcode LIMIT 1) AS salesman,
+				COALESCE((SELECT SUM(debtortrans.balance) FROM debtortrans WHERE debtortrans.debtorno = debtorsmaster.debtorno), 0) AS balance
+		FROM debtorsmaster
+		INNER JOIN holdreasons
+			ON debtorsmaster.holdreason = holdreasons.reasoncode
+		INNER JOIN currencies
+			ON debtorsmaster.currcode = currencies.currabrev
+		WHERE 1 = 1 " . $Where . "
+		ORDER BY debtorsmaster.name";
+$Result = DB_query($SQL, __('The customers could not be retrieved because'));
+
+$Review = array();
+$OverLimit = array();
+$Watched = array();
+$Stopped = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	$MyRow['homebalance'] = ($MyRow['rate'] != 0) ? $MyRow['balance'] / $MyRow['rate'] : 0;
+	$MyRow['homeover'] = ($MyRow['rate'] != 0) ? ($MyRow['balance'] - $MyRow['creditlimit']) / $MyRow['rate'] : 0;
+	if ($MyRow['nextcreditreview'] <= date('Y-m-d')) {
+		$Review[] = $MyRow;
+	}
+	if ($MyRow['balance'] > $MyRow['creditlimit']) {
+		$OverLimit[] = $MyRow;
+	}
+	if ($MyRow['dissallowinvoices'] == 2) {
+		$Watched[] = $MyRow;
+	} elseif ($MyRow['dissallowinvoices'] == 1) {
+		$Stopped[] = $MyRow;
+	}
+}
+
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$HomeDecimals = $_SESSION['CompanyRecord']['decimalplaces'];
+
+function CreditReportTable($Title, $Rows, $Columns, $HomeCurrency, $HomeDecimals) {
+	global $RootPath;
+	echo '<table class="selection">
+			<tr><th colspan="9">' . $Title . ' (' . count($Rows) . ')</th></tr>
+			<tr><th>' . __('Customer') . '</th><th>' . __('Name') . '</th><th>' . __('Sales person') . '</th><th>' . __('Currency') . '</th><th>' . __('Credit limit') . '</th><th>' . __('Balance') . '</th><th>' . $Columns . '</th><th>' . __('Balance') . ' ' . $HomeCurrency . '</th></tr>';
+	$Total = 0;
+	foreach ($Rows as $Row) {
+		switch ($Columns) {
+			case __('Review due'):
+				$Extra = ($Row['nextcreditreview'] == '1000-01-01') ? __('Never reviewed') : ConvertSQLDate($Row['nextcreditreview']);
+				break;
+			case __('Over limit by'):
+				$Extra = locale_number_format($Row['balance'] - $Row['creditlimit'], $Row['decimalplaces']);
+				break;
+			default:
+				$Extra = htmlspecialchars($Row['reasondescription'], ENT_QUOTES, 'UTF-8');
+		}
+		$Total += $Row['homebalance'];
+		echo '<tr class="striped_row">
+				<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($Row['debtorno']) . '">' . $Row['debtorno'] . '</a></td>
+				<td>' . htmlspecialchars($Row['name'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td>' . $Row['salesman'] . '</td>
+				<td>' . $Row['currcode'] . '</td>
+				<td class="number">' . locale_number_format($Row['creditlimit'], $Row['decimalplaces']) . '</td>
+				<td class="number">' . locale_number_format($Row['balance'], $Row['decimalplaces']) . '</td>
+				<td>' . $Extra . '</td>
+				<td class="number">' . locale_number_format($Row['homebalance'], $HomeDecimals) . '</td>
+			</tr>';
+	}
+	echo '<tr><td colspan="7"><b>' . __('Total in') . ' ' . $HomeCurrency . '</b></td><td class="number"><b>' . locale_number_format($Total, $HomeDecimals) . '</b></td></tr>
+		</table><br />';
+}
+
+CreditReportTable(__('Customers due or overdue a credit review'), $Review, __('Review due'), $HomeCurrency, $HomeDecimals);
+CreditReportTable(__('Customers over their credit limit'), $OverLimit, __('Over limit by'), $HomeCurrency, $HomeDecimals);
+CreditReportTable(__('Customers on watch'), $Watched, __('Credit status'), $HomeCurrency, $HomeDecimals);
+CreditReportTable(__('Customers on stop'), $Stopped, __('Credit status'), $HomeCurrency, $HomeDecimals);
+
+/* ---- orders credit control has to look at ---- */
+$OrderWhere = '';
+if ($Salesman != '') {
+	$OrderWhere .= " AND salesorders.salesperson = '" . $Salesman . "'";
+}
+if ($Currency != '') {
+	$OrderWhere .= " AND debtorsmaster.currcode = '" . $Currency . "'";
+}
+$SQL = "SELECT salesorders.orderno,
+				salesorders.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				salesorders.orddate,
+				salesorders.creditheld,
+				holdreasons.dissallowinvoices,
+				SUM(salesorderdetails.unitprice * (salesorderdetails.quantity - salesorderdetails.qtyinvoiced) * (1 - salesorderdetails.discountpercent)) AS ordervalue
+		FROM salesorders
+		INNER JOIN salesorderdetails
+			ON salesorders.orderno = salesorderdetails.orderno
+		INNER JOIN debtorsmaster
+			ON salesorders.debtorno = debtorsmaster.debtorno
+		INNER JOIN holdreasons
+			ON debtorsmaster.holdreason = holdreasons.reasoncode
+		WHERE salesorderdetails.completed = 0
+		AND salesorders.quotation = 0
+		AND (salesorders.creditheld = 1
+			OR holdreasons.dissallowinvoices IN (1, 2))
+		" . $OrderWhere . "
+		GROUP BY salesorders.orderno,
+				salesorders.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				salesorders.orddate,
+				salesorders.creditheld,
+				holdreasons.dissallowinvoices
+		ORDER BY salesorders.orddate";
+$Result = DB_query($SQL, __('The orders could not be retrieved because'));
+
+echo '<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="Salesman" value="' . $Salesman . '" />
+		<input type="hidden" name="Currency" value="' . $Currency . '" />
+		<table class="selection">
+			<tr><th colspan="7">' . __('Open orders held for credit control, or taken for customers on watch or on stop') . '</th></tr>
+			<tr><th>' . __('Order') . '</th><th>' . __('Customer') . '</th><th>' . __('Order date') . '</th><th>' . __('Value') . '</th><th>' . __('Why it is listed') . '</th><th></th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	if ($MyRow['creditheld'] == 1) {
+		$Why = __('Held - over the credit limit');
+	} elseif ($MyRow['dissallowinvoices'] == 1) {
+		$Why = ($MyRow['creditheld'] == 2) ? __('Customer on stop - released') : __('Customer on stop - cannot be dispatched');
+	} else {
+		$Why = __('Customer on watch');
+	}
+	$CanRelease = ($MyRow['creditheld'] == 1 OR ($MyRow['dissallowinvoices'] == 1 AND $MyRow['creditheld'] != 2));
+	echo '<tr class="striped_row">
+			<td><a href="' . $RootPath . '/OrderDetails.php?OrderNumber=' . $MyRow['orderno'] . '">' . $MyRow['orderno'] . '</a></td>
+			<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . $MyRow['debtorno'] . '</a> ' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td>' . ConvertSQLDate($MyRow['orddate']) . '</td>
+			<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['ordervalue'], 2) . '</td>
+			<td>' . $Why . '</td>
+			<td>' . ($CanRelease ? '<button type="submit" name="ReleaseOrder" value="' . $MyRow['orderno'] . '">' . __('Release') . '</button>' : '') . '</td>
+		</tr>';
+}
+echo '</table>
+	</form>';
+
+include('includes/footer.php');
diff --git a/CreditControlWriteOffs.php b/CreditControlWriteOffs.php
new file mode 100644
index 0000000..0f7e7a2
--- /dev/null
+++ b/CreditControlWriteOffs.php
@@ -0,0 +1,204 @@
+<?php
+
+/* Bad debt write-offs: credit control asks for all or part of a customer's unpaid balance to be written off, with a reason.
+A write-off up to the approval limit Finance set is posted at once. A larger one waits for the finance director on CreditControlApprovals.php.
+The same page reports the write-offs over a period. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Bad Debt Write-offs');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlWriteOffs';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_delete.png" title="' . $Title . '" alt="" />
+		' . $Title . '
+	</p>';
+
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$HomeDecimals = $_SESSION['CompanyRecord']['decimalplaces'];
+$Limit = (float) CreditControlParam('CreditWriteOffApprovalLimit', 1000);
+$FormAction = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+
+if (isset($_GET['DebtorNo'])) {
+	$_POST['DebtorNo'] = $_GET['DebtorNo'];
+}
+
+/* ---------- ask for a write-off ---------- */
+if (isset($_POST['RequestWriteOff'])) {
+	$Customer = GetCreditStatus($_POST['DebtorNo']);
+	$Amount = filter_number_format($_POST['Amount']);
+	$InputError = 0;
+	if ($Customer === false) {
+		$InputError = 1;
+		prnMsg(__('There is no such customer'), 'error');
+	} else {
+		$CurrResult = DB_query("SELECT decimalplaces, rate FROM currencies WHERE currabrev = '" . $Customer['currcode'] . "'");
+		$CurrRow = DB_fetch_array($CurrResult);
+		$OwedResult = DB_query("SELECT COALESCE(SUM(balance), 0) FROM debtortrans WHERE debtorno = '" . $_POST['DebtorNo'] . "' AND type IN (10, 15) AND balance > 0.005");
+		$OwedRow = DB_fetch_row($OwedResult);
+		$PendingResult = DB_query("SELECT COALESCE(SUM(amount), 0) FROM writeoffs WHERE debtorno = '" . $_POST['DebtorNo'] . "' AND status = 'pending'");
+		$PendingRow = DB_fetch_row($PendingResult);
+		if (!is_numeric($Amount) OR $Amount <= 0) {
+			$InputError = 1;
+			prnMsg(__('The amount to write off must be a number greater than zero'), 'error');
+		} elseif ($Amount + $PendingRow[0] > $OwedRow[0] + 0.005) {
+			$InputError = 1;
+			prnMsg(__('The customer owes') . ' ' . locale_number_format($OwedRow[0], $CurrRow['decimalplaces']) . ' ' . __('in unpaid invoices and charges, of which') . ' ' . locale_number_format($PendingRow[0], $CurrRow['decimalplaces']) . ' ' . __('is already waiting to be written off. The write-off is too large.'), 'error');
+		}
+		if (trim($_POST['Reason']) == '') {
+			$InputError = 1;
+			prnMsg(__('The reason for the write-off must be entered'), 'error');
+		}
+	}
+	if ($InputError == 0) {
+		$Amount = round($Amount, $CurrRow['decimalplaces']);
+		$HomeAmount = ($CurrRow['rate'] != 0) ? round($Amount / $CurrRow['rate'], $HomeDecimals) : 0;
+		$StopCustomer = isset($_POST['StopCustomer']) ? 1 : 0;
+		$SQL = "INSERT INTO writeoffs (debtorno,
+										amount,
+										currcode,
+										homeamount,
+										reason,
+										requestedby,
+										requesteddate,
+										status,
+										stopcustomer)
+				VALUES ('" . $_POST['DebtorNo'] . "',
+						'" . $Amount . "',
+						'" . $Customer['currcode'] . "',
+						'" . $HomeAmount . "',
+						'" . $_POST['Reason'] . "',
+						'" . $_SESSION['UserID'] . "',
+						NOW(),
+						'pending',
+						'" . $StopCustomer . "')";
+		DB_query($SQL, __('The write-off could not be saved because'));
+		$WriteOffID = DB_Last_Insert_ID('writeoffs', 'id');
+		CreditControlLog($_POST['DebtorNo'], 'WRITEOFF_REQ', __('Write-off') . ' ' . $WriteOffID . ' ' . __('requested') . ': ' . $_POST['Reason'], $Amount, $Customer['currcode']);
+		if ($HomeAmount > $Limit) {
+			prnMsg(__('The write-off is above the approval limit of') . ' ' . $HomeCurrency . ' ' . locale_number_format($Limit, $HomeDecimals) . '. ' . __('It has been sent to the finance director and has no effect until it is approved.'), 'info');
+		} else {
+			$Problem = CreditControlPostWriteOff($WriteOffID, $_SESSION['UserID'], __('Within the approval limit'));
+			if ($Problem == '') {
+				prnMsg(__('The write-off has been posted'), 'success');
+			} else {
+				prnMsg($Problem, 'error');
+			}
+		}
+	}
+}
+
+/* ---------- the form ---------- */
+if (isset($_POST['DebtorNo']) AND $_POST['DebtorNo'] != '') {
+	$Customer = GetCreditStatus($_POST['DebtorNo']);
+	if ($Customer !== false) {
+		$CurrResult = DB_query("SELECT decimalplaces FROM currencies WHERE currabrev = '" . $Customer['currcode'] . "'");
+		$CurrRow = DB_fetch_row($CurrResult);
+		$OwedResult = DB_query("SELECT COALESCE(SUM(balance), 0) FROM debtortrans WHERE debtorno = '" . $_POST['DebtorNo'] . "' AND type IN (10, 15) AND balance > 0.005");
+		$OwedRow = DB_fetch_row($OwedResult);
+		echo '<form action="' . $FormAction . '" method="post">
+				<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+				<input type="hidden" name="DebtorNo" value="' . $_POST['DebtorNo'] . '" />
+				<fieldset>
+					<legend>' . htmlspecialchars($Customer['name'], ENT_QUOTES, 'UTF-8') . ' (' . $_POST['DebtorNo'] . ') - ' . CreditStatusText($Customer['status']) . '</legend>
+					<field><label>' . __('Unpaid invoices and charges') . ':</label><fieldtext>' . $Customer['currcode'] . ' ' . locale_number_format($OwedRow[0], $CurrRow[0]) . '</fieldtext></field>
+					<field>
+						<label for="Amount">' . __('Amount to write off') . ' (' . $Customer['currcode'] . '):</label>
+						<input type="text" class="number" name="Amount" size="14" maxlength="14" value="' . locale_number_format($OwedRow[0], $CurrRow[0]) . '" />
+					</field>
+					<field>
+						<label for="Reason">' . __('Reason') . ':</label>
+						<input type="text" name="Reason" size="60" maxlength="150" />
+					</field>
+					<field>
+						<label for="StopCustomer">' . __('Put the customer on stop') . ':</label>
+						<input type="checkbox" name="StopCustomer" ' . (CreditControlParam('CreditWriteOffAutoStop', 1) == 1 ? 'checked="checked"' : '') . ' />
+					</field>
+				</fieldset>
+				<div class="centre"><input type="submit" name="RequestWriteOff" value="' . __('Write off') . '" onclick="return confirm(\'' . __('Write off this bad debt? It cannot be undone.') . '\');" /></div>
+			</form>';
+	}
+} else {
+	echo '<div class="centre">' . __('Choose the customer on the credit control page, then use its link to write off a bad debt.') . '
+			<a href="' . $RootPath . '/CreditControl.php">' . __('Credit control') . '</a></div><br />';
+}
+
+/* ---------- the write-off report (BR-29) ---------- */
+$From = isset($_POST['FromDate']) ? $_POST['FromDate'] : date($_SESSION['DefaultDateFormat'], strtotime('-1 month'));
+$To = isset($_POST['ToDate']) ? $_POST['ToDate'] : date($_SESSION['DefaultDateFormat']);
+if (!Is_Date($From)) {
+	$From = date($_SESSION['DefaultDateFormat'], strtotime('-1 month'));
+}
+if (!Is_Date($To)) {

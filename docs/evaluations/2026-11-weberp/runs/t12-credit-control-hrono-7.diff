diff --git a/CreditControl.php b/CreditControl.php
new file mode 100644
index 0000000..31d3b8d
--- /dev/null
+++ b/CreditControl.php
@@ -0,0 +1,507 @@
+<?php
+
+/* The credit controller's page for one customer: credit status, credit reviews, stop and watch, disputed invoices,
+exemptions from interest and fees, waiving a charge, and the full credit history that the auditors read. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Control');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControl';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . __('Credit Control') . '" alt="" />
+		' . __('Credit Control') . '
+	</p>';
+
+echo '<div class="centre">
+		<a href="' . $RootPath . '/CreditControlReport.php">' . __('Credit control report') . '</a> |
+		<a href="' . $RootPath . '/CreditControlDunning.php">' . __('Reminder run') . '</a> |
+		<a href="' . $RootPath . '/CreditControlCharges.php">' . __('Month end interest and late fees') . '</a> |
+		<a href="' . $RootPath . '/CreditControlWriteOffs.php">' . __('Write-offs') . '</a> |
+		<a href="' . $RootPath . '/CreditControlParameters.php">' . __('Settings') . '</a>
+	</div><br />';
+
+if (isset($_GET['DebtorNo'])) {
+	$_POST['DebtorNo'] = $_GET['DebtorNo'];
+}
+
+/* ---------- choose a customer ---------- */
+if (!isset($_POST['DebtorNo']) OR $_POST['DebtorNo'] == '') {
+
+	echo '<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<fieldset>
+				<legend>' . __('Find a customer') . '</legend>
+				<field>
+					<label for="Keywords">' . __('Part of the customer name') . ':</label>
+					<input type="text" name="Keywords" size="20" maxlength="25" />
+				</field>
+				<field>
+					<label for="CustCode">' . __('Or part of the customer code') . ':</label>
+					<input type="text" name="CustCode" size="15" maxlength="18" />
+				</field>
+			</fieldset>
+			<div class="centre"><input type="submit" name="Search" value="' . __('Search Now') . '" /></div>
+		</form>';
+
+	if (isset($_POST['Search'])) {
+		$Where = "WHERE 1=1";
+		if (mb_strlen($_POST['Keywords']) > 0) {
+			$Where .= " AND debtorsmaster.name LIKE '%" . str_replace(' ', '%', $_POST['Keywords']) . "%'";
+		}
+		if (mb_strlen($_POST['CustCode']) > 0) {
+			$Where .= " AND debtorsmaster.debtorno LIKE '%" . $_POST['CustCode'] . "%'";
+		}
+		$SQL = "SELECT debtorsmaster.debtorno,
+						debtorsmaster.name,
+						holdreasons.dissallowinvoices
+				FROM debtorsmaster
+				INNER JOIN holdreasons
+					ON debtorsmaster.holdreason = holdreasons.reasoncode
+				" . $Where . "
+				ORDER BY debtorsmaster.name
+				LIMIT 100";
+		$Result = DB_query($SQL);
+		echo '<table class="selection"><tr><th>' . __('Code') . '</th><th>' . __('Name') . '</th><th>' . __('Credit status') . '</th></tr>';
+		while ($MyRow = DB_fetch_array($Result)) {
+			$RowStatus = ($MyRow['dissallowinvoices'] == 1) ? 'stop' : (($MyRow['dissallowinvoices'] == 2) ? 'watch' : 'normal');
+			echo '<tr class="striped_row">
+					<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . $MyRow['debtorno'] . '</a></td>
+					<td>' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+					<td>' . CreditStatusText($RowStatus) . '</td>
+				</tr>';
+		}
+		echo '</table>';
+	}
+	include('includes/footer.php');
+	exit();
+}
+
+/* ---------- a customer is chosen ---------- */
+$DebtorNo = $_POST['DebtorNo'];
+$Customer = GetCreditStatus($DebtorNo);
+if ($Customer === false) {
+	prnMsg(__('There is no customer') . ' ' . $DebtorNo, 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$CurrResult = DB_query("SELECT decimalplaces, rate FROM currencies WHERE currabrev = '" . $Customer['currcode'] . "'");
+$CurrRow = DB_fetch_array($CurrResult);
+$DecimalPlaces = $CurrRow['decimalplaces'];
+$Accounts = CreditControlAccounts();
+$Today = date('Y-m-d');
+
+/* ---- record a credit review (BR-01, BR-03, BR-04): the review row, the new limit and the next review date are saved together ---- */
+if (isset($_POST['RecordReview'])) {
+	$InputError = 0;
+	$Outcomes = array('confirmed' => __('Limit confirmed'),
+					'raised' => __('Limit raised'),
+					'reduced' => __('Limit reduced'),
+					'watch' => __('Put on watch'),
+					'stop' => __('Put on stop'));
+	$NewLimit = filter_number_format($_POST['NewLimit']);
+	if (!isset($Outcomes[$_POST['Outcome']])) {
+		$InputError = 1;
+		prnMsg(__('Choose the outcome of the review'), 'error');
+	}
+	if (!is_numeric($NewLimit) OR $NewLimit < 0) {
+		$InputError = 1;
+		prnMsg(__('The credit limit must be a number that is not negative'), 'error');
+	}
+	if (!Is_Date($_POST['NextReview']) OR FormatDateForSQL($_POST['NextReview']) <= $Today) {
+		$InputError = 1;
+		prnMsg(__('The next review date must be a date in the future in the format') . ' ' . $_SESSION['DefaultDateFormat'], 'error');
+	}
+	if (trim($_POST['Notes']) == '') {
+		$InputError = 1;
+		prnMsg(__('The notes of the review must be entered'), 'error');
+	}
+	if ($InputError == 0) {
+		if ($_POST['Outcome'] == 'raised' AND $NewLimit <= $Customer['creditlimit']) {
+			$InputError = 1;
+			prnMsg(__('A raised limit must be higher than the current limit of') . ' ' . locale_number_format($Customer['creditlimit'], $DecimalPlaces), 'error');
+		} elseif ($_POST['Outcome'] == 'reduced' AND $NewLimit >= $Customer['creditlimit']) {
+			$InputError = 1;
+			prnMsg(__('A reduced limit must be lower than the current limit of') . ' ' . locale_number_format($Customer['creditlimit'], $DecimalPlaces), 'error');
+		} elseif (($_POST['Outcome'] == 'watch' OR $_POST['Outcome'] == 'stop') AND !isset($_POST['ReviewReason'])) {
+			$InputError = 1;
+			prnMsg(__('Choose the credit status reason'), 'error');
+		}
+	}
+	if ($InputError == 0) {
+		if (in_array($_POST['Outcome'], array('confirmed', 'watch', 'stop'))) {
+			$NewLimit = $Customer['creditlimit'];
+		}
+		DB_Txn_Begin();
+		$SQL = "INSERT INTO creditreviews (debtorno,
+											reviewdate,
+											userid,
+											outcome,
+											oldlimit,
+											newlimit,
+											notes,
+											nextreview)
+				VALUES ('" . $DebtorNo . "',
+						'" . $Today . "',
+						'" . $_SESSION['UserID'] . "',
+						'" . $_POST['Outcome'] . "',
+						'" . $Customer['creditlimit'] . "',
+						'" . $NewLimit . "',
+						'" . $_POST['Notes'] . "',
+						'" . FormatDateForSQL($_POST['NextReview']) . "')";
+		DB_query($SQL, __('The credit review could not be saved because'), '', true);
+		DB_query("UPDATE debtorsmaster
+					SET creditlimit = '" . $NewLimit . "',
+						nextcreditreview = '" . FormatDateForSQL($_POST['NextReview']) . "'
+					WHERE debtorno = '" . $DebtorNo . "'",
+				__('The credit limit could not be updated because'), '', true);
+		CreditControlLog($DebtorNo, 'REVIEW', $Outcomes[$_POST['Outcome']] . ': ' . $_POST['Notes'], $NewLimit, $Customer['currcode']);
+		if ($NewLimit != $Customer['creditlimit']) {
+			CreditControlLog($DebtorNo, 'LIMIT', __('Credit limit changed from') . ' ' . $Customer['creditlimit'] . ' ' . __('to') . ' ' . $NewLimit, $NewLimit, $Customer['currcode']);
+		}
+		if ($_POST['Outcome'] == 'watch' OR $_POST['Outcome'] == 'stop') {
+			CreditControlSetStatus($DebtorNo, $_POST['ReviewReason'], $_POST['Notes']);
+		}
+		DB_Txn_Commit();
+		prnMsg(__('The credit review has been recorded'), 'success');
+		$Customer = GetCreditStatus($DebtorNo);
+	}
+}
+
+/* ---- put on stop, on watch, or back to normal (BR-05, BR-08) ---- */
+if (isset($_POST['ChangeStatus'])) {
+	if (trim($_POST['StatusNote']) == '') {
+		prnMsg(__('A reason must be entered for a change of credit status'), 'error');
+	} elseif (CreditControlSetStatus($DebtorNo, $_POST['StatusReason'], $_POST['StatusNote'])) {
+		prnMsg(__('The credit status has been changed'), 'success');
+		$Customer = GetCreditStatus($DebtorNo);
+	} else {
+		prnMsg(__('The credit status could not be changed'), 'error');
+	}
+}
+
+/* ---- disputed invoices (BR-18) ---- */
+if (isset($_POST['SaveDisputes'])) {
+	$Result = DB_query("SELECT id, type, transno, disputed
+						FROM debtortrans
+						WHERE debtorno = '" . $DebtorNo . "'
+						AND type IN (10, 15)
+						AND balance > 0.005");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$NewValue = isset($_POST['Disputed_' . $MyRow['id']]) ? 1 : 0;
+		if ($NewValue != $MyRow['disputed']) {
+			DB_query("UPDATE debtortrans SET disputed = '" . $NewValue . "' WHERE id = '" . $MyRow['id'] . "'");
+			CreditControlLog($DebtorNo,
+							'DISPUTE',
+							($NewValue == 1 ? __('Marked as disputed') : __('Dispute settled')) . ': ' . __('transaction type') . ' ' . $MyRow['type'] . ' ' . __('number') . ' ' . $MyRow['transno']);
+		}
+	}
+	prnMsg(__('The disputed invoices have been saved'), 'success');
+}
+
+/* ---- exemptions from interest and fees (BR-20) ---- */
+if (isset($_POST['SaveExemptions'])) {
+	$InterestExempt = isset($_POST['InterestExempt']) ? 1 : 0;
+	$FeeExempt = isset($_POST['FeeExempt']) ? 1 : 0;
+	DB_query("UPDATE debtorsmaster SET interestexempt = '" . $InterestExempt . "', feeexempt = '" . $FeeExempt . "' WHERE debtorno = '" . $DebtorNo . "'");
+	CreditControlLog($DebtorNo, 'EXEMPT', __('Exempt from interest') . ': ' . ($InterestExempt ? __('Yes') : __('No')) . ', ' . __('exempt from late fees') . ': ' . ($FeeExempt ? __('Yes') : __('No')));
+	prnMsg(__('The exemptions have been saved'), 'success');
+}
+
+/* ---- waive (reverse) a charge, with a reason, and reverse it in the ledger as well (BR-24) ---- */
+if (isset($_POST['WaiveCharge'])) {
+	$ChargeResult = DB_query("SELECT latecharges.id,
+									latecharges.chargetype,
+									latecharges.chargemonth,
+									latecharges.debtortransid,
+									latecharges.rate,
+									latecharges.currcode,
+									debtortrans.balance
+							FROM latecharges
+							INNER JOIN debtortrans
+								ON latecharges.debtortransid = debtortrans.id
+							WHERE latecharges.id = '" . (int) $_POST['ChargeID'] . "'
+							AND latecharges.debtorno = '" . $DebtorNo . "'
+							AND latecharges.waived = 0");
+	if (trim($_POST['WaiveReason']) == '') {
+		prnMsg(__('A reason must be entered to waive a charge'), 'error');
+	} elseif (DB_num_rows($ChargeResult) == 0) {
+		prnMsg(__('That charge cannot be waived. It does not exist or has been waived already'), 'error');
+	} else {
+		$Charge = DB_fetch_array($ChargeResult);
+		$WaiveAmount = round($Charge['balance'], $DecimalPlaces);
+		if ($WaiveAmount <= 0 OR $Charge['rate'] == 0) {
+			prnMsg(__('The charge has been paid already, so there is nothing left to waive'), 'error');
+		} else {
+			$LocalAmount = round($WaiveAmount / $Charge['rate'], $_SESSION['CompanyRecord']['decimalplaces']);
+			$IncomeAccount = ($Charge['chargetype'] == 'I') ? $Accounts['latechargeinterestact'] : $Accounts['latechargefeeact'];
+			$Narrative = __('Waiver of late payment charge') . ' ' . $Charge['chargemonth'] . ' ' . $DebtorNo;
+			DB_Txn_Begin();
+			$Posted = CreditControlPostDebtorJournal($DebtorNo,
+													-$WaiveAmount,
+													$Charge['rate'],
+													$Today,
+													__('Waiver') . ' ' . $Charge['chargemonth'],
+													$Narrative . ': ' . $_POST['WaiveReason'],
+													array(array('account' => $IncomeAccount, 'amount' => $LocalAmount),
+														array('account' => $_SESSION['CompanyRecord']['debtorsact'], 'amount' => -$LocalAmount)));
+			CreditControlAllocate($Posted['id'], $Charge['debtortransid'], $WaiveAmount, $Today);
+			DB_query("UPDATE latecharges
+						SET waived = 1,
+							waivedtransno = '" . $Posted['transno'] . "',
+							waivedreason = '" . rtrim(mb_substr($_POST['WaiveReason'], 0, 190), '\\') . "'
+						WHERE id = '" . $Charge['id'] . "'",
+					__('The charge could not be marked as waived because'), '', true);
+			CreditControlLog($DebtorNo, 'WAIVE', $Narrative . ': ' . $_POST['WaiveReason'], $WaiveAmount, $Customer['currcode']);
+			EnsureGLEntriesBalance(15, $Posted['transno']);
+			DB_Txn_Commit();
+			prnMsg(__('The charge has been waived by journal number') . ' ' . $Posted['transno'], 'success');
+		}
+	}
+}
+
+/* ---------- the customer ---------- */
+$Customer = GetCreditStatus($DebtorNo);
+$Summary = CreditOverdueSummary($DebtorNo);
+$BalanceResult = DB_query("SELECT COALESCE(SUM(balance), 0) FROM debtortrans WHERE debtorno = '" . $DebtorNo . "'");
+$BalanceRow = DB_fetch_row($BalanceResult);
+$Balance = $BalanceRow[0];
+$CreditAvailable = GetCreditAvailable($DebtorNo);
+$ExemptResult = DB_query("SELECT interestexempt, feeexempt FROM debtorsmaster WHERE debtorno = '" . $DebtorNo . "'");
+$Exempt = DB_fetch_array($ExemptResult);
+$LastLetterResult = DB_query("SELECT stage, sentdate FROM dunningletters WHERE debtorno = '" . $DebtorNo . "' ORDER BY sentdate DESC, id DESC LIMIT 1");
+
+echo '<table class="selection">
+		<tr><th colspan="2">' . htmlspecialchars($Customer['name'], ENT_QUOTES, 'UTF-8') . ' (' . $DebtorNo . ')</th></tr>
+		<tr><td>' . __('Credit status') . '</td><td><b>' . CreditStatusText($Customer['status']) . '</b> - ' . htmlspecialchars($Customer['reasondescription'], ENT_QUOTES, 'UTF-8') . '</td></tr>
+		<tr><td>' . __('Currency') . '</td><td>' . $Customer['currcode'] . '</td></tr>
+		<tr><td>' . __('Credit limit') . '</td><td class="number">' . locale_number_format($Customer['creditlimit'], $DecimalPlaces) . '</td></tr>
+		<tr><td>' . __('Balance') . '</td><td class="number">' . locale_number_format($Balance, $DecimalPlaces) . '</td></tr>
+		<tr><td>' . __('Credit available (after open orders)') . '</td><td class="number">' . locale_number_format($CreditAvailable, $DecimalPlaces) . '</td></tr>
+		<tr><td>' . __('Overdue (chased and charged)') . '</td><td class="number">' . locale_number_format($Summary['overdue'], $DecimalPlaces) . '</td></tr>
+		<tr><td>' . __('Overdue but disputed') . '</td><td class="number">' . locale_number_format($Summary['disputed'], $DecimalPlaces) . '</td></tr>
+		<tr><td>' . __('Next credit review') . '</td><td>' . ($Customer['nextcreditreview'] == '1000-01-01' ? __('Never reviewed - due now') : ConvertSQLDate($Customer['nextcreditreview'])) . '</td></tr>';
+if (DB_num_rows($LastLetterResult) > 0) {
+	$LastLetter = DB_fetch_array($LastLetterResult);
+	echo '<tr><td>' . __('Last reminder sent') . '</td><td>' . __('Stage') . ' ' . $LastLetter['stage'] . ' - ' . ConvertSQLDate(mb_substr($LastLetter['sentdate'], 0, 10)) . '</td></tr>';
+}
+echo '</table>
+	<div class="centre">
+		<a href="' . $RootPath . '/CustomerInquiry.php?CustomerID=' . urlencode($DebtorNo) . '">' . __('Account inquiry') . '</a> |
+		<a href="' . $RootPath . '/CustomerCreditHistory.php?DebtorNo=' . urlencode($DebtorNo) . '">' . __('Reminders and charges as the customer sees them') . '</a> |
+		<a href="' . $RootPath . '/CreditControlWriteOffs.php?DebtorNo=' . urlencode($DebtorNo) . '">' . __('Write off a bad debt') . '</a> |
+		<a href="' . $RootPath . '/AddCustomerNotes.php?DebtorNo=' . urlencode($DebtorNo) . '">' . __('Add a note (collection agency or legal action, promised payments)') . '</a>
+	</div><br />';
+
+$FormAction = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+
+/* record a review */
+echo '<form action="' . $FormAction . '" method="post">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+		<fieldset>
+			<legend>' . __('Record a credit review') . '</legend>
+			<field>
+				<label for="Outcome">' . __('Outcome') . ':</label>
+				<select name="Outcome">
+					<option value="confirmed">' . __('Limit confirmed') . '</option>
+					<option value="raised">' . __('Limit raised') . '</option>
+					<option value="reduced">' . __('Limit reduced') . '</option>
+					<option value="watch">' . __('Put on watch') . '</option>
+					<option value="stop">' . __('Put on stop') . '</option>
+				</select>
+			</field>
+			<field>
+				<label for="NewLimit">' . __('New credit limit (for raised or reduced)') . ':</label>
+				<input type="text" class="number" name="NewLimit" size="14" maxlength="14" value="' . locale_number_format($Customer['creditlimit'], $DecimalPlaces) . '" />
+			</field>
+			<field>
+				<label for="ReviewReason">' . __('Status reason (for watch or stop)') . ':</label>
+				<select name="ReviewReason">
+					<optgroup label="' . __('On watch') . '">' . CreditReasonOptions('watch') . '</optgroup>
+					<optgroup label="' . __('On stop') . '">' . CreditReasonOptions('stop') . '</optgroup>
+				</select>
+			</field>
+			<field>
+				<label for="NextReview">' . __('Next review date') . ':</label>
+				<input type="text" class="date" name="NextReview" size="11" maxlength="10" alt="' . $_SESSION['DefaultDateFormat'] . '" value="' . date($_SESSION['DefaultDateFormat'], strtotime('+' . (int) CreditControlParam('CreditReviewMonths', 12) . ' months')) . '" />
+			</field>
+			<field>
+				<label for="Notes">' . __('Notes') . ':</label>
+				<textarea name="Notes" rows="3" cols="50"></textarea>
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="RecordReview" value="' . __('Record the review') . '" /></div>
+	</form>';
+
+/* stop, watch or normal */
+$ReasonResult = DB_query("SELECT reasoncode, reasondescription, dissallowinvoices FROM holdreasons ORDER BY dissallowinvoices DESC, reasoncode");
+echo '<form action="' . $FormAction . '" method="post">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+		<fieldset>
+			<legend>' . __('Change the credit status') . '</legend>
+			<field>
+				<label for="StatusReason">' . __('New status and reason') . ':</label>
+				<select name="StatusReason">';
+while ($ReasonRow = DB_fetch_array($ReasonResult)) {
+	$ReasonKind = ($ReasonRow['dissallowinvoices'] == 1) ? 'stop' : (($ReasonRow['dissallowinvoices'] == 2) ? 'watch' : 'normal');
+	echo '<option ' . ($ReasonRow['reasoncode'] == $Customer['holdreason'] ? 'selected="selected" ' : '') . 'value="' . $ReasonRow['reasoncode'] . '">' . CreditStatusText($ReasonKind) . ' - ' . htmlspecialchars($ReasonRow['reasondescription'], ENT_QUOTES, 'UTF-8') . '</option>';
+}
+echo '</select>
+			</field>
+			<field>
+				<label for="StatusNote">' . __('Reason for the change') . ':</label>
+				<textarea name="StatusNote" rows="2" cols="50"></textarea>
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="ChangeStatus" value="' . __('Change the status') . '" /></div>
+	</form>';
+
+/* disputed invoices */
+$OpenResult = DB_query("SELECT id, type, transno, trandate, reference, balance, disputed
+						FROM debtortrans
+						WHERE debtorno = '" . $DebtorNo . "'
+						AND type IN (10, 15)
+						AND balance > 0.005
+						ORDER BY trandate, id");
+if (DB_num_rows($OpenResult) > 0) {
+	echo '<form action="' . $FormAction . '" method="post">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+			<table class="selection">

+				<tr><th>' . __('Month') . '</th><th>' . __('Charge') . '</th><th>' . __('Journal') . '</th><th>' . __('Amount') . '</th><th>' . __('Outstanding') . '</th><th>' . __('Waive') . '</th></tr>';
+	$WaivableOptions = '';
+	while ($ChargeRow = DB_fetch_array($ChargesResult)) {

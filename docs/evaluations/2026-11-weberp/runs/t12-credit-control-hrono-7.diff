+					<label for="Stage">' . __('Stage number') . ':</label>
+					<input type="text" class="integer" name="Stage" size="3" maxlength="1" value="' . $StageRow['stage'] . '" ' . ($StageRow['stage'] != '' ? 'readonly="readonly"' : '') . ' />

+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="SaveExemptions" value="' . __('Save the exemptions') . '" /></div>
+	</form>';
+
+/* waive a charge */
+$ChargesResult = DB_query("SELECT latecharges.id,
+								latecharges.chargetype,
+								latecharges.chargemonth,
+								latecharges.amount,
+								latecharges.waived,
+								latecharges.waivedreason,
+								latecharges.transno,
+								debtortrans.balance
+						FROM latecharges
+						INNER JOIN debtortrans
+							ON latecharges.debtortransid = debtortrans.id
+						WHERE latecharges.debtorno = '" . $DebtorNo . "'
+						ORDER BY latecharges.chargemonth DESC, latecharges.chargetype");
+if (DB_num_rows($ChargesResult) > 0) {
+	echo '<form action="' . $FormAction . '" method="post">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />

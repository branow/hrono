+<?php
+
+/* The finance director approves, or rejects, the write-offs that are above the approval limit. Nothing happens to the customer's account until
+a write-off is approved here. The person who asked for a write-off cannot approve it. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Approve Bad Debt Write-offs');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlApprovals';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_delete.png" title="' . $Title . '" alt="" />
+		' . $Title . '
+	</p>';
+
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$HomeDecimals = $_SESSION['CompanyRecord']['decimalplaces'];
+
+if (isset($_POST['Decide'])) {
+	$WriteOffID = (int) $_POST['WriteOffID'];
+	$Result = DB_query("SELECT debtorno, requestedby, amount, currcode FROM writeoffs WHERE id = '" . $WriteOffID . "' AND status = 'pending'");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('That write-off is not waiting for approval'), 'error');
+	} else {
+		$WriteOff = DB_fetch_array($Result);
+		if ($WriteOff['requestedby'] == $_SESSION['UserID']) {
+			prnMsg(__('You asked for this write-off, so someone else has to approve it'), 'error');
+		} elseif ($_POST['Decide'] == 'approve') {
+			$Problem = CreditControlPostWriteOff($WriteOffID, $_SESSION['UserID'], $_POST['Note']);
+			if ($Problem == '') {
+				prnMsg(__('Write-off') . ' ' . $WriteOffID . ' ' . __('has been approved and posted'), 'success');
+			} else {
+				prnMsg($Problem, 'error');
+			}
+		} else {
+			DB_query("UPDATE writeoffs
+						SET status = 'rejected',
+							approvedby = '" . $_SESSION['UserID'] . "',
+							approveddate = NOW(),
+							approvalnote = '" . rtrim(mb_substr($_POST['Note'], 0, 190), '\\') . "'
+						WHERE id = '" . $WriteOffID . "'");
+			CreditControlLog($WriteOff['debtorno'], 'WRITEOFF_REJ', __('Write-off') . ' ' . $WriteOffID . ' ' . __('rejected') . ': ' . $_POST['Note'], $WriteOff['amount'], $WriteOff['currcode']);
+			prnMsg(__('Write-off') . ' ' . $WriteOffID . ' ' . __('has been rejected'), 'success');
+		}
+	}
+}
+
+$Result = DB_query("SELECT writeoffs.*,
+						debtorsmaster.name,
+						currencies.decimalplaces
+					FROM writeoffs
+					INNER JOIN debtorsmaster
+						ON writeoffs.debtorno = debtorsmaster.debtorno
+					INNER JOIN currencies
+						ON debtorsmaster.currcode = currencies.currabrev
+					WHERE writeoffs.status = 'pending'
+					ORDER BY writeoffs.requesteddate");
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('There are no write-offs waiting for approval'), 'info');
+} else {
+	echo '<table class="selection">
+			<tr><th>' . __('Requested') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . $HomeCurrency . '</th><th>' . __('Reason') . '</th><th>' . __('Asked by') . '</th><th>' . __('Decision') . '</th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post">
+				<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+				<input type="hidden" name="WriteOffID" value="' . $MyRow['id'] . '" />
+				<td>' . ConvertSQLDate(mb_substr($MyRow['requesteddate'], 0, 10)) . '</td>
+				<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . $MyRow['debtorno'] . '</a> ' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], $MyRow['decimalplaces']) . '</td>
+				<td class="number">' . locale_number_format($MyRow['homeamount'], $HomeDecimals) . '</td>
+				<td>' . htmlspecialchars($MyRow['reason'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td>' . $MyRow['requestedby'] . '</td>
+				<td>
+					<input type="text" name="Note" size="25" maxlength="150" placeholder="' . __('Note') . '" />
+					<button type="submit" name="Decide" value="approve">' . __('Approve') . '</button>
+					<button type="submit" name="Decide" value="reject">' . __('Reject') . '</button>
+				</td>
+				</form>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/CreditControlCharges.php b/CreditControlCharges.php
new file mode 100644
index 0000000..d2aa453
--- /dev/null
+++ b/CreditControlCharges.php
@@ -0,0 +1,230 @@
+<?php
+
+/* Month end interest and late fees on overdue balances. Credit control sees what would be charged to whom, confirms it, and the charges are
+posted to each customer's account (as separate, described items) and to the general ledger income accounts Finance chose.
+A customer is never charged twice for the same month: the table of charges has a unique key on customer, month and kind of charge. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Month End Interest and Late Fees');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlCharges';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_add.png" title="' . $Title . '" alt="" />
+		' . $Title . '
+	</p>';
+
+$Rate = (float) CreditControlParam('CreditInterestRate', 0);
+$FeeHome = (float) CreditControlParam('CreditLateFee', 0);
+$ChargeDays = (int) CreditControlParam('CreditChargeDays', 14);
+$OnCharges = (int) CreditControlParam('CreditChargeOnCharges', 0);
+$Accounts = CreditControlAccounts();
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$HomeDecimals = $_SESSION['CompanyRecord']['decimalplaces'];
+
+if ($Rate <= 0 AND $FeeHome <= 0) {
+	prnMsg(__('Neither an interest rate nor a late fee has been set, so nothing will be charged. Set them in the credit control settings.'), 'warn');
+}
+
+/* the months that can be charged: this month and the two before it */
+$Months = array();
+for ($i = 0; $i < 3; $i++) {
+	$Months[] = date('Y-m', strtotime('first day of -' . $i . ' months'));
+}
+$ChargeMonth = (isset($_POST['ChargeMonth']) AND in_array($_POST['ChargeMonth'], $Months)) ? $_POST['ChargeMonth'] : $Months[0];
+$MonthEnd = date('Y-m-t', strtotime($ChargeMonth . '-01'));
+$ChargeDate = ($MonthEnd > date('Y-m-d')) ? date('Y-m-d') : $MonthEnd;
+
+/* Works out what one customer would be charged for the month. Returns null if nothing is to be charged.
+ Interest is the annual rate divided by 12 on the overdue balance, that is the undisputed overdue invoices that are at least the set number of
+ days overdue, less credits on the account that are not allocated. Interest on interest and fees is charged only if Finance has switched that on.
+ The late fee is a fixed amount, set in the home currency, charged once a month to a customer who has an overdue balance. */
+function CreditChargeCandidate($Customer, $Rate, $FeeHome, $ChargeDays, $OnCharges, $ChargeMonth) {
+	$Summary = CreditOverdueSummary($Customer['debtorno']);
+	$Base = 0;
+	foreach ($Summary['documents'] as $Document) {
+		if ($Document['disputed'] == 1 OR $Document['daysoverdue'] < $ChargeDays) {
+			continue;
+		}
+		if ($Document['type'] == 15 AND $OnCharges == 0) {
+			continue;
+		}
+		$Base += $Document['balance'];
+	}
+	$Base = max(0, $Base - $Summary['credits']);
+	if ($Base < 0.005) {
+		return null;
+	}
+	$Result = array('base' => $Base, 'interest' => 0, 'fee' => 0, 'interestdone' => false, 'feedone' => false);
+	$DoneResult = DB_query("SELECT chargetype FROM latecharges WHERE debtorno = '" . $Customer['debtorno'] . "' AND chargemonth = '" . $ChargeMonth . "'");
+	while ($DoneRow = DB_fetch_array($DoneResult)) {
+		if ($DoneRow['chargetype'] == 'I') {
+			$Result['interestdone'] = true;
+		} else {
+			$Result['feedone'] = true;
+		}
+	}
+	if ($Customer['interestexempt'] == 0 AND $Rate > 0 AND !$Result['interestdone']) {
+		$Result['interest'] = round($Base * $Rate / 100 / 12, $Customer['decimalplaces']);
+	}
+	if ($Customer['feeexempt'] == 0 AND $FeeHome > 0 AND $Customer['rate'] > 0 AND !$Result['feedone']) {
+		$Result['fee'] = round($FeeHome * $Customer['rate'], $Customer['decimalplaces']);
+	}
+	if ($Result['interest'] <= 0 AND $Result['fee'] <= 0) {
+		return null;
+	}
+	return $Result;
+}
+
+function CreditChargeCustomers() {
+	return DB_query("SELECT debtorsmaster.debtorno,
+							debtorsmaster.name,
+							debtorsmaster.currcode,
+							debtorsmaster.interestexempt,
+							debtorsmaster.feeexempt,
+							currencies.rate,
+							currencies.decimalplaces
+					FROM debtorsmaster
+					INNER JOIN currencies
+						ON debtorsmaster.currcode = currencies.currabrev
+					WHERE EXISTS (SELECT 1 FROM debtortrans
+									WHERE debtortrans.debtorno = debtorsmaster.debtorno
+									AND debtortrans.type IN (10, 15)
+									AND debtortrans.balance > 0.005)
+					ORDER BY debtorsmaster.name");
+}
+
+/* ---------- confirm: post the ticked charges ---------- */
+if (isset($_POST['PostCharges'])) {
+	$AccountsOK = true;
+	foreach (array('latechargeinterestact' => $Rate, 'latechargefeeact' => $FeeHome) as $Column => $Value) {
+		if ($Value > 0) {
+			$AccountResult = DB_query("SELECT accountcode FROM chartmaster WHERE accountcode = '" . $Accounts[$Column] . "'");
+			if (DB_num_rows($AccountResult) == 0) {
+				$AccountsOK = false;
+			}
+		}
+	}
+	if (!$AccountsOK) {
+		prnMsg(__('The general ledger income accounts for interest and late fees have not been set up. Set them in the credit control settings first.'), 'error');
+	} else {
+		$Posted = 0;
+		$CustomerResult = CreditChargeCustomers();
+		while ($Customer = DB_fetch_array($CustomerResult)) {
+			if (!isset($_POST['Charge_' . $Customer['debtorno']])) {
+				continue;
+			}
+			/* worked out again now, so a customer who paid since the preview, or was charged by someone else, is not charged */
+			$Candidate = CreditChargeCandidate($Customer, $Rate, $FeeHome, $ChargeDays, $OnCharges, $ChargeMonth);
+			if ($Candidate === null) {
+				prnMsg($Customer['debtorno'] . ' ' . __('has nothing to be charged for') . ' ' . $ChargeMonth, 'info');
+				continue;
+			}
+			DB_Txn_Begin();
+			$Items = array();
+			if ($Candidate['interest'] > 0) {
+				$Items[] = array('I', $Candidate['interest'], $Accounts['latechargeinterestact'], __('Interest') . ' ' . $ChargeMonth,
+					__('Interest on overdue balance') . ' ' . $Customer['currcode'] . ' ' . locale_number_format($Candidate['base'], $Customer['decimalplaces']) . ' ' . __('at') . ' ' . $Rate . '% ' . __('a year for') . ' ' . $ChargeMonth);
+			}
+			if ($Candidate['fee'] > 0) {
+				$Items[] = array('F', $Candidate['fee'], $Accounts['latechargefeeact'], __('Late fee') . ' ' . $ChargeMonth,
+					__('Late payment fee for') . ' ' . $ChargeMonth);
+			}
+			foreach ($Items as $Item) {
+				$Local = round($Item[1] / $Customer['rate'], $HomeDecimals);
+				$Posted_ = CreditControlPostDebtorJournal($Customer['debtorno'],
+														$Item[1],
+														$Customer['rate'],
+														$ChargeDate,
+														$Item[3],
+														$Item[4],
+														array(array('account' => $_SESSION['CompanyRecord']['debtorsact'], 'amount' => $Local),
+															array('account' => $Item[2], 'amount' => -$Local)));
+				$SQL = "INSERT INTO latecharges (debtorno,
+												chargemonth,
+												chargetype,
+												amount,
+												currcode,
+												rate,
+												basebalance,
+												debtortransid,
+												transno,
+												userid,
+												chargedate)
+						VALUES ('" . $Customer['debtorno'] . "',
+								'" . $ChargeMonth . "',
+								'" . $Item[0] . "',
+								'" . $Item[1] . "',
+								'" . $Customer['currcode'] . "',
+								'" . $Customer['rate'] . "',
+								'" . $Candidate['base'] . "',
+								'" . $Posted_['id'] . "',
+								'" . $Posted_['transno'] . "',
+								'" . $_SESSION['UserID'] . "',
+								NOW())";
+				DB_query($SQL, __('The charge could not be recorded because'), '', true);
+				CreditControlLog($Customer['debtorno'], 'CHARGE', $Item[4], $Item[1], $Customer['currcode']);
+				EnsureGLEntriesBalance(15, $Posted_['transno']);
+				$Posted++;
+			}
+			DB_Txn_Commit();
+		}
+		prnMsg($Posted . ' ' . __('charges were posted for') . ' ' . $ChargeMonth, 'success');
+	}
+}
+
+/* ---------- the preview (BR-22) ---------- */
+echo '<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Charge month') . '</legend>
+			<field>
+				<label for="ChargeMonth">' . __('Month') . ':</label>
+				<select name="ChargeMonth" onchange="this.form.submit();">';
+foreach ($Months as $Month) {
+	echo '<option ' . ($Month == $ChargeMonth ? 'selected="selected" ' : '') . 'value="' . $Month . '">' . $Month . '</option>';
+}
+echo '		</select>
+			</field>
+			<field><label>' . __('Charges are dated') . ':</label><fieldtext>' . ConvertSQLDate($ChargeDate) . '</fieldtext></field>
+			<field><label>' . __('Interest rate a year') . ':</label><fieldtext>' . $Rate . '%</fieldtext></field>
+			<field><label>' . __('Late fee') . ':</label><fieldtext>' . $HomeCurrency . ' ' . locale_number_format($FeeHome, $HomeDecimals) . ' ' . __('converted to the customer currency') . '</fieldtext></field>
+			<field><label>' . __('Days overdue before charging') . ':</label><fieldtext>' . $ChargeDays . '</fieldtext></field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Preview" value="' . __('Show what will be charged') . '" /></div>';
+
+$CustomerResult = CreditChargeCustomers();
+$Rows = array();
+while ($Customer = DB_fetch_array($CustomerResult)) {
+	$Candidate = CreditChargeCandidate($Customer, $Rate, $FeeHome, $ChargeDays, $OnCharges, $ChargeMonth);
+	if ($Candidate !== null) {
+		$Rows[] = array_merge($Customer, $Candidate);
+	}
+}
+
+echo '<table class="selection">
+		<tr><th colspan="6">' . __('To be charged for') . ' ' . $ChargeMonth . ' (' . count($Rows) . ')</th></tr>
+		<tr><th>' . __('Charge') . '</th><th>' . __('Customer') . '</th><th>' . __('Overdue balance charged on') . '</th><th>' . __('Interest') . '</th><th>' . __('Late fee') . '</th><th>' . __('Currency') . '</th></tr>';
+foreach ($Rows as $Row) {
+	echo '<tr class="striped_row">
+			<td><input type="checkbox" name="Charge_' . $Row['debtorno'] . '" checked="checked" /></td>
+			<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($Row['debtorno']) . '">' . $Row['debtorno'] . '</a> ' . htmlspecialchars($Row['name'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td class="number">' . locale_number_format($Row['base'], $Row['decimalplaces']) . '</td>
+			<td class="number">' . ($Row['interest'] > 0 ? locale_number_format($Row['interest'], $Row['decimalplaces']) : '') . '</td>
+			<td class="number">' . ($Row['fee'] > 0 ? locale_number_format($Row['fee'], $Row['decimalplaces']) : '') . '</td>
+			<td>' . $Row['currcode'] . '</td>
+		</tr>';
+}
+echo '</table>';
+
+if (count($Rows) > 0) {
+	echo '<br /><div class="centre"><input type="submit" name="PostCharges" value="' . __('Post the ticked charges') . '" onclick="return confirm(\'' . __('Post the ticked charges to the customer accounts and the general ledger?') . '\');" /></div>';
+}
+echo '</form>';
+
+include('includes/footer.php');
diff --git a/CreditControlDunning.php b/CreditControlDunning.php
new file mode 100644
index 0000000..3f81542
--- /dev/null
+++ b/CreditControlDunning.php
@@ -0,0 +1,258 @@
+<?php
+
+/* The overdue reminder run (dunning). Credit control starts it (weekly is expected), sees who would get which letter,
+takes out the customers they do not want to chase this week, and only then are the letters emailed.
+Customers with no email address are listed so the letter can be posted, and recorded as posted. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Overdue Reminder Run');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlDunning';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />
+		' . $Title . '
+	</p>';
+
+$Stages = array();
+$StageResult = DB_query("SELECT stage, daysoverdue, subject, body FROM dunningstages ORDER BY daysoverdue, stage");
+while ($StageRow = DB_fetch_array($StageResult)) {
+	$Stages[$StageRow['stage']] = $StageRow;
+}
+if (count($Stages) == 0) {
+	prnMsg(__('No reminder stages have been set up. Set them up in the credit control settings first.'), 'warn');
+	echo '<div class="centre"><a href="' . $RootPath . '/CreditControlParameters.php">' . __('Credit control settings') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+$FinalStage = max(array_keys($Stages));
+$MinDays = (int) CreditControlParam('CreditDunningMinDays', 14);
+$ResetDays = (int) CreditControlParam('CreditDunningResetDays', 90);
+
+/* Works out whether a customer is due a reminder now, and which one.
+ A customer moves up a stage only while still overdue, and is not sent a stage again within the minimum number of days, nor a stage at or below
+ the one they have had recently - a customer who pays and later goes overdue again starts at the first stage once the reset period has passed. */
+function CreditDunningCandidate($DebtorNo, $Stages, $MinDays, $ResetDays) {
+	$Summary = CreditOverdueSummary($DebtorNo);
+	if ($Summary['net'] < 0.005 OR $Summary['maxdays'] <= 0) {
+		return null;
+	}
+	$Eligible = 0;
+	foreach ($Stages as $Stage) {
+		if ($Stage['daysoverdue'] <= $Summary['maxdays']) {
+			$Eligible = $Stage['stage'];
+		}
+	}
+	$LastResult = DB_query("SELECT stage, sentdate, DATEDIFF(CURRENT_DATE, sentdate) AS dayssince
+							FROM dunningletters
+							WHERE debtorno = '" . $DebtorNo . "'
+							ORDER BY sentdate DESC, id DESC
+							LIMIT 1");
+	$LastStage = 0;
+	if (DB_num_rows($LastResult) > 0) {
+		$Last = DB_fetch_array($LastResult);
+		if ($Last['dayssince'] < $MinDays) {
+			return null;
+		}
+		if ($Last['dayssince'] < $ResetDays) {
+			$LastStage = $Last['stage'];
+		}
+	}
+	$Result = array('summary' => $Summary, 'stage' => $Eligible, 'laststage' => $LastStage, 'due' => false);
+	if ($Eligible > 0 AND $Eligible > $LastStage) {
+		$Result['due'] = true;
+	}
+	return $Result;
+}
+
+function CreditDunningRecipients($DebtorNo) {
+	$Recipients = array();
+	$Result = DB_query("SELECT email FROM custcontacts WHERE debtorno = '" . $DebtorNo . "' AND statement = 1 AND email <> ''");
+	while ($MyRow = DB_fetch_array($Result)) {
+		if (IsEmailAddress($MyRow['email'])) {
+			$Recipients[$MyRow['email']] = $MyRow['email'];
+		}
+	}
+	return array_values($Recipients);
+}
+
+function CreditDunningInvoiceText($Summary, $Currency, $Decimals) {
+	$Text = '';
+	foreach ($Summary['documents'] as $Document) {
+		if ($Document['disputed'] == 1) {
+			continue;
+		}
+		$Text .= ($Document['type'] == 10 ? __('Invoice') : __('Charge')) . ' ' . $Document['transno'] . '   ' . __('dated') . ' ' . ConvertSQLDate($Document['trandate']) . '   ' . __('due') . ' ' . ConvertSQLDate($Document['duedate']) . '   ' . $Currency . ' ' . locale_number_format($Document['balance'], $Decimals) . '   (' . $Document['daysoverdue'] . ' ' . __('days overdue') . ")\n";
+	}
+	if ($Summary['credits'] > 0.005) {
+		$Text .= __('Less payments and credits on account') . '   ' . $Currency . ' -' . locale_number_format(min($Summary['credits'], $Summary['overdue']), $Decimals) . "\n";
+	}
+	return $Text;
+}
+
+/* ---------- the run: only customers ticked on the preview, and only if they are still due now ---------- */
+if (isset($_POST['SendReminders'])) {
+	$Sent = 0;
+	$Posted = 0;
+	$Skipped = 0;
+	$From = $_SESSION['CompanyRecord']['email'];
+	$CustomerResult = DB_query("SELECT debtorno, name, currcode FROM debtorsmaster ORDER BY debtorno");
+	while ($Customer = DB_fetch_array($CustomerResult)) {
+		if (!isset($_POST['Send_' . $Customer['debtorno']])) {
+			continue;
+		}
+		$Candidate = CreditDunningCandidate($Customer['debtorno'], $Stages, $MinDays, $ResetDays);
+		if ($Candidate === null OR !$Candidate['due']) {
+			prnMsg($Customer['debtorno'] . ' ' . __('is not sent a reminder because they are no longer due one (paid, disputed or already reminded)'), 'info');
+			$Skipped++;
+			continue;
+		}
+		$DecimalResult = DB_query("SELECT decimalplaces FROM currencies WHERE currabrev = '" . $Customer['currcode'] . "'");
+		$DecimalRow = DB_fetch_row($DecimalResult);
+		$Stage = $Stages[$Candidate['stage']];
+		$Invoices = CreditDunningInvoiceText($Candidate['summary'], $Customer['currcode'], $DecimalRow[0]);
+		$Recipients = CreditDunningRecipients($Customer['debtorno']);
+		$Method = (count($Recipients) > 0) ? 'email' : 'post';
+		if ($Method == 'email') {
+			$Body = str_replace(array('{customer}', '{company}', '{amount}', '{currency}', '{invoices}'),
+								array($Customer['name'], $_SESSION['CompanyRecord']['coyname'], locale_number_format($Candidate['summary']['net'], $DecimalRow[0]), $Customer['currcode'], $Invoices),
+								$Stage['body']);
+			$Subject = str_replace('{customer}', $Customer['name'], $Stage['subject']);
+			$EmailResult = SendEmailFromWebERP($From, $Recipients, $Subject, $Body, '', true);
+			if ($EmailResult !== true) {
+				prnMsg(__('The reminder to') . ' ' . $Customer['debtorno'] . ' ' . __('could not be sent') . ': ' . $EmailResult, 'error');
+				continue;
+			}
+			$Sent++;
+		} else {
+			/* the credit controller posts the letter, and ticks it as posted here */
+			$Posted++;
+		}
+		$SQL = "INSERT INTO dunningletters (debtorno,
+											stage,
+											sentdate,
+											userid,
+											method,
+											sentto,
+											amount,
+											currcode,
+											invoices)
+				VALUES ('" . $Customer['debtorno'] . "',
+						'" . $Stage['stage'] . "',
+						NOW(),
+						'" . $_SESSION['UserID'] . "',
+						'" . $Method . "',
+						'" . DB_escape_string(implode(', ', $Recipients)) . "',
+						'" . $Candidate['summary']['net'] . "',
+						'" . $Customer['currcode'] . "',
+						'" . DB_escape_string($Invoices) . "')";
+		DB_query($SQL, __('The reminder could not be recorded because'));
+		CreditControlLog($Customer['debtorno'],
+						'REMINDER',
+						__('Stage') . ' ' . $Stage['stage'] . ' ' . ($Method == 'email' ? __('emailed to') . ' ' . DB_escape_string(implode(', ', $Recipients)) : __('recorded as posted')),
+						$Candidate['summary']['net'],
+						$Customer['currcode']);
+		if ($Stage['stage'] == $FinalStage AND CreditControlParam('CreditStopAfterFinal', 0) == 1) {
+			$StopReason = DB_query("SELECT reasoncode FROM holdreasons WHERE dissallowinvoices = 1 ORDER BY reasoncode LIMIT 1");
+			if (DB_num_rows($StopReason) > 0) {
+				$StopRow = DB_fetch_row($StopReason);
+				CreditControlSetStatus($Customer['debtorno'], $StopRow[0], __('Automatically put on stop after the final reminder'));
+				prnMsg($Customer['debtorno'] . ' ' . __('has been put on stop after the final reminder'), 'warn');
+			}
+		}
+	}
+	prnMsg($Sent . ' ' . __('reminders were emailed') . ', ' . $Posted . ' ' . __('were recorded as posted') . ', ' . $Skipped . ' ' . __('were skipped because they were no longer due'), 'success');
+}
+
+/* ---------- the preview (BR-14) ---------- */
+$CustomerResult = DB_query("SELECT debtorsmaster.debtorno,
+								debtorsmaster.name,
+								debtorsmaster.currcode,
+								holdreasons.dissallowinvoices,
+								currencies.decimalplaces
+						FROM debtorsmaster
+						INNER JOIN holdreasons
+							ON debtorsmaster.holdreason = holdreasons.reasoncode
+						INNER JOIN currencies
+							ON debtorsmaster.currcode = currencies.currabrev
+						WHERE EXISTS (SELECT 1 FROM debtortrans
+										WHERE debtortrans.debtorno = debtorsmaster.debtorno
+										AND debtortrans.type IN (10, 15)
+										AND debtortrans.balance > 0.005)
+						ORDER BY debtorsmaster.name");
+$Email = array();
+$Post = array();
+$FinalNoticeGiven = array();
+while ($Customer = DB_fetch_array($CustomerResult)) {
+	$Candidate = CreditDunningCandidate($Customer['debtorno'], $Stages, $MinDays, $ResetDays);
+	if ($Candidate === null) {
+		continue;
+	}
+	if ($Candidate['laststage'] == $FinalStage AND $Customer['dissallowinvoices'] != 1) {
+		$FinalNoticeGiven[] = array_merge($Customer, $Candidate);
+	}
+	if (!$Candidate['due']) {
+		continue;
+	}
+	$Customer['candidate'] = $Candidate;
+	$Customer['recipients'] = CreditDunningRecipients($Customer['debtorno']);
+	if (count($Customer['recipients']) > 0) {
+		$Email[] = $Customer;
+	} else {
+		$Post[] = $Customer;
+	}
+}
+
+echo '<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+
+function CreditDunningTable($Title, $Rows, $Stages, $MethodText) {
+	global $RootPath;
+	echo '<table class="selection">
+			<tr><th colspan="7">' . $Title . ' (' . count($Rows) . ')</th></tr>
+			<tr><th>' . __('Send') . '</th><th>' . __('Customer') . '</th><th>' . __('Days overdue') . '</th><th>' . __('Letter') . '</th><th>' . __('Amount') . '</th><th>' . $MethodText . '</th><th>' . __('Disputed (not chased)') . '</th></tr>';
+	foreach ($Rows as $Row) {
+		$Summary = $Row['candidate']['summary'];
+		echo '<tr class="striped_row">
+				<td><input type="checkbox" name="Send_' . $Row['debtorno'] . '" checked="checked" /></td>
+				<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($Row['debtorno']) . '">' . $Row['debtorno'] . '</a> ' . htmlspecialchars($Row['name'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td class="number">' . $Summary['maxdays'] . '</td>
+				<td>' . __('Stage') . ' ' . $Row['candidate']['stage'] . ' - ' . htmlspecialchars($Stages[$Row['candidate']['stage']]['subject'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td class="number">' . $Row['currcode'] . ' ' . locale_number_format($Summary['net'], $Row['decimalplaces']) . '</td>
+				<td>' . ($MethodText == __('Email to') ? htmlspecialchars(implode(', ', $Row['recipients']), ENT_QUOTES, 'UTF-8') : __('No email address - post the letter, then tick to record it')) . '</td>
+				<td class="number">' . ($Summary['disputed'] > 0 ? locale_number_format($Summary['disputed'], $Row['decimalplaces']) : '') . '</td>
+			</tr>';
+	}
+	echo '</table><br />';
+}
+
+CreditDunningTable(__('Customers who will be emailed a reminder - untick those to leave out this week'), $Email, $Stages, __('Email to'));
+CreditDunningTable(__('Customers with no email address for their statements - these letters have to be posted'), $Post, $Stages, __('Posting'));
+
+if (count($Email) + count($Post) > 0) {
+	echo '<div class="centre"><input type="submit" name="SendReminders" value="' . __('Send the ticked reminders') . '" onclick="return confirm(\'' . __('Send the ticked reminders now?') . '\');" /></div><br />';
+} else {
+	prnMsg(__('No customer is due a reminder at the moment'), 'info');
+}
+echo '</form>';
+
+if (count($FinalNoticeGiven) > 0) {
+	echo '<table class="selection">
+			<tr><th colspan="4">' . __('Customers who have had the final notice, are still overdue and are not on stop - for credit control to decide') . '</th></tr>
+			<tr><th>' . __('Customer') . '</th><th>' . __('Days overdue') . '</th><th>' . __('Amount') . '</th></tr>';
+	foreach ($FinalNoticeGiven as $Row) {
+		echo '<tr class="striped_row">
+				<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($Row['debtorno']) . '">' . $Row['debtorno'] . '</a> ' . htmlspecialchars($Row['name'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td class="number">' . $Row['summary']['maxdays'] . '</td>
+				<td class="number">' . $Row['currcode'] . ' ' . locale_number_format($Row['summary']['net'], $Row['decimalplaces']) . '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/CreditControlParameters.php b/CreditControlParameters.php
new file mode 100644
index 0000000..6ab9d1c
--- /dev/null
+++ b/CreditControlParameters.php
@@ -0,0 +1,220 @@
+<?php
+
+/* Finance's settings for credit control: the standard review period, the interest rate, the late fee and when charging starts, the write-off approval
+limit, the general ledger accounts, and the reminder stages with the wording of each letter. It also loads the starting credit status of customers
+from the credit controller's spreadsheet when credit control goes live. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Control Settings');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlParameters';
+include('includes/header.php');
+
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/company.png" title="' . $Title . '" alt="" />
+		' . $Title . '
+	</p>';
+
+$FormAction = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+
+/* name => array(label, lowest, highest) */
+$Settings = array(
+	'CreditReviewMonths' => array(__('Standard credit review period in months'), 1, 60),
+	'CreditHoldOverLimitOrders' => array(__('Hold orders that take a customer over their credit limit for credit control (1 = yes, 0 = no). Works with the Check Credit Limits system parameter, which must not be 0'), 0, 1),
+	'CreditInterestRate' => array(__('Interest rate a year on overdue balances, in percent (0 = no interest)'), 0, 100),
+	'CreditLateFee' => array(__('Late fee a month in the home currency (0 = no fee)'), 0, 1000000),
+	'CreditChargeDays' => array(__('Days overdue before an invoice is charged interest or a fee'), 0, 365),
+	'CreditChargeOnCharges' => array(__('Charge interest on interest and fees that are themselves overdue (1 = yes, 0 = no)'), 0, 1),
+	'CreditDunningMinDays' => array(__('Days before a customer can be sent another reminder'), 1, 365),
+	'CreditDunningResetDays' => array(__('Days after which reminders start again from the first stage'), 1, 730),
+	'CreditStopAfterFinal' => array(__('Put the customer on stop automatically when the final reminder is sent (1 = yes, 0 = only list them for credit control to decide)'), 0, 1),
+	'CreditWriteOffApprovalLimit' => array(__('Write-offs above this amount in the home currency need the finance director'), 0, 1000000000),
+	'CreditWriteOffAutoStop' => array(__('Put a customer on stop when a debt is written off, unless credit control decides otherwise (1 = yes, 0 = no)'), 0, 1)
+);
+
+if (isset($_POST['SaveSettings'])) {
+	$InputError = 0;
+	foreach ($Settings as $Name => $Setting) {
+		$Value = filter_number_format($_POST[$Name]);
+		if (!is_numeric($Value) OR $Value < $Setting[1] OR $Value > $Setting[2]) {
+			$InputError = 1;
+			prnMsg($Setting[0] . ': ' . __('must be a number from') . ' ' . $Setting[1] . ' ' . __('to') . ' ' . $Setting[2], 'error');
+		}
+	}
+	if ($InputError == 0) {
+		foreach ($Settings as $Name => $Setting) {
+			$Value = filter_number_format($_POST[$Name]);
+			DB_query("UPDATE config SET confvalue = '" . $Value . "' WHERE confname = '" . $Name . "'");
+			$_SESSION[$Name] = $Value;
+		}
+		foreach (array('InterestAccount' => 'latechargeinterestact', 'FeeAccount' => 'latechargefeeact', 'BadDebtAccount' => 'baddebtact') as $Field => $Column) {
+			$AccountResult = DB_query("SELECT accountcode FROM chartmaster WHERE accountcode = '" . $_POST[$Field] . "'");
+			if (DB_num_rows($AccountResult) == 1) {
+				DB_query("UPDATE companies SET " . $Column . " = '" . $_POST[$Field] . "' WHERE coycode = 1");
+			}
+		}
+		prnMsg(__('The credit control settings have been saved'), 'success');
+	}
+}
+
+/* ---- reminder stages ---- */
+if (isset($_POST['SaveStage'])) {
+	$Stage = (int) $_POST['Stage'];
+	$Days = (int) $_POST['DaysOverdue'];
+	if ($Stage < 1 OR $Stage > 9 OR $Days < 1 OR trim($_POST['Subject']) == '' OR trim($_POST['Body']) == '') {
+		prnMsg(__('A reminder stage needs a number from 1 to 9, the days overdue, a subject and the wording of the letter'), 'error');
+	} else {
+		$ExistsResult = DB_query("SELECT stage FROM dunningstages WHERE stage = '" . $Stage . "'");
+		if (DB_num_rows($ExistsResult) == 1) {
+			DB_query("UPDATE dunningstages SET daysoverdue = '" . $Days . "', subject = '" . $_POST['Subject'] . "', body = '" . $_POST['Body'] . "' WHERE stage = '" . $Stage . "'");
+		} else {
+			DB_query("INSERT INTO dunningstages (stage, daysoverdue, subject, body) VALUES ('" . $Stage . "', '" . $Days . "', '" . $_POST['Subject'] . "', '" . $_POST['Body'] . "')");
+		}
+		prnMsg(__('Reminder stage') . ' ' . $Stage . ' ' . __('has been saved'), 'success');
+	}
+}
+if (isset($_POST['DeleteStage'])) {
+	$Stage = (int) $_POST['Stage'];
+	DB_query("DELETE FROM dunningstages WHERE stage = '" . $Stage . "'");
+	prnMsg(__('Reminder stage') . ' ' . $Stage . ' ' . __('has been deleted. Letters already sent stay in the history of the customers'), 'success');
+}
+
+/* ---- go live: load the credit controller's spreadsheet ---- */
+if (isset($_POST['LoadStatus']) AND isset($_FILES['CSVFile']) AND $_FILES['CSVFile']['name'] != '') {
+	$FileHandle = fopen($_FILES['CSVFile']['tmp_name'], 'r');
+	$Loaded = 0;
+	$Rejected = 0;
+	$FirstReason = array();
+	foreach (array('stop' => 1, 'watch' => 2, 'normal' => 0) as $Kind => $Value) {
+		$Operator = ($Kind == 'normal') ? 'NOT IN (1, 2)' : '= ' . $Value;
+		$ReasonResult = DB_query("SELECT reasoncode FROM holdreasons WHERE dissallowinvoices " . $Operator . " ORDER BY reasoncode LIMIT 1");
+		if (DB_num_rows($ReasonResult) == 1) {
+			$ReasonRow = DB_fetch_row($ReasonResult);
+			$FirstReason[$Kind] = $ReasonRow[0];
+		}
+	}
+	while (($Row = fgetcsv($FileHandle, 1000, ',')) !== false) {
+		$DebtorNo = isset($Row[0]) ? trim(DB_escape_string(htmlspecialchars($Row[0]))) : '';
+		$Kind = isset($Row[1]) ? mb_strtolower(trim($Row[1])) : '';
+		if ($DebtorNo == '' OR !isset($FirstReason[$Kind])) {
+			if ($DebtorNo != '' AND mb_strtolower($DebtorNo) != 'debtorno') {
+				prnMsg(__('Line skipped, the status must be stop, watch or normal') . ': ' . htmlspecialchars($DebtorNo), 'warn');
+				$Rejected++;
+			}
+			continue;
+		}
+		$Customer = GetCreditStatus($DebtorNo);
+		if ($Customer === false) {
+			prnMsg(__('Line skipped, there is no customer') . ' ' . htmlspecialchars($DebtorNo), 'warn');
+			$Rejected++;
+			continue;
+		}
+		if ($Customer['status'] != $Kind) {
+			CreditControlSetStatus($DebtorNo, $FirstReason[$Kind], __('Loaded from the credit control spreadsheet'));
+		}
+		if (isset($Row[2]) AND is_numeric($Row[2]) AND $Row[2] >= 0 AND $Row[2] != $Customer['creditlimit']) {
+			DB_query("UPDATE debtorsmaster SET creditlimit = '" . (float) $Row[2] . "' WHERE debtorno = '" . $DebtorNo . "'");
+			CreditControlLog($DebtorNo, 'LIMIT', __('Credit limit loaded from the credit control spreadsheet, from') . ' ' . $Customer['creditlimit'] . ' ' . __('to') . ' ' . (float) $Row[2], (float) $Row[2], $Customer['currcode']);
+		}
+		if (isset($Row[3]) AND preg_match('/^\d{4}-\d{2}-\d{2}$/', trim($Row[3]))) {
+			DB_query("UPDATE debtorsmaster SET nextcreditreview = '" . trim($Row[3]) . "' WHERE debtorno = '" . $DebtorNo . "'");
+		}
+		$Loaded++;
+	}
+	fclose($FileHandle);
+	prnMsg($Loaded . ' ' . __('customers were loaded') . ', ' . $Rejected . ' ' . __('lines were skipped'), 'success');
+}
+
+/* ---------- the settings form ---------- */
+$CompanyResult = DB_query("SELECT latechargeinterestact, latechargefeeact, baddebtact FROM companies WHERE coycode = 1");
+$Company = DB_fetch_array($CompanyResult);
+
+echo '<form action="' . $FormAction . '" method="post">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Settings') . '</legend>';
+$Defaults = array('CreditReviewMonths' => 12, 'CreditHoldOverLimitOrders' => 1, 'CreditInterestRate' => 0, 'CreditLateFee' => 0, 'CreditChargeDays' => 14, 'CreditChargeOnCharges' => 0,
+				'CreditDunningMinDays' => 14, 'CreditDunningResetDays' => 90, 'CreditStopAfterFinal' => 0, 'CreditWriteOffApprovalLimit' => 1000, 'CreditWriteOffAutoStop' => 1);
+foreach ($Settings as $Name => $Setting) {
+	echo '<field>
+			<label for="' . $Name . '">' . $Setting[0] . ':</label>
+			<input type="text" class="number" name="' . $Name . '" size="12" maxlength="14" value="' . CreditControlParam($Name, $Defaults[$Name]) . '" />
+		</field>';
+}
+$AccountSelects = array('InterestAccount' => array(__('Income account for interest'), 'latechargeinterestact'),
+						'FeeAccount' => array(__('Income account for late fees'), 'latechargefeeact'),
+						'BadDebtAccount' => array(__('Bad debts account'), 'baddebtact'));
+foreach ($AccountSelects as $Field => $Account) {
+	echo '<field>
+			<label for="' . $Field . '">' . $Account[0] . ':</label>
+			<select name="' . $Field . '">';

+	}
+	echo '</form>';
+}
+
+/* ---------- the history (BR-03, BR-32) ---------- */
+$ReviewResult = DB_query("SELECT creditreviews.*
+						FROM creditreviews
+						WHERE debtorno = '" . $DebtorNo . "'
+						ORDER BY reviewdate DESC, id DESC");
+echo '<table class="selection">
+		<tr><th colspan="7">' . __('Credit reviews - these cannot be changed or deleted') . '</th></tr>
+		<tr><th>' . __('Date') . '</th><th>' . __('By') . '</th><th>' . __('Outcome') . '</th><th>' . __('Old limit') . '</th><th>' . __('New limit') . '</th><th>' . __('Next review') . '</th><th>' . __('Notes') . '</th></tr>';
+while ($ReviewRow = DB_fetch_array($ReviewResult)) {
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate($ReviewRow['reviewdate']) . '</td>
+			<td>' . $ReviewRow['userid'] . '</td>
+			<td>' . $ReviewRow['outcome'] . '</td>
+			<td class="number">' . locale_number_format($ReviewRow['oldlimit'], $DecimalPlaces) . '</td>
+			<td class="number">' . locale_number_format($ReviewRow['newlimit'], $DecimalPlaces) . '</td>
+			<td>' . ConvertSQLDate($ReviewRow['nextreview']) . '</td>
+			<td>' . htmlspecialchars($ReviewRow['notes'], ENT_QUOTES, 'UTF-8') . '</td>
+		</tr>';
+}
+echo '</table>';
+
+$LogResult = DB_query("SELECT logdate, userid, action, detail, amount, currcode
+						FROM creditlog
+						WHERE debtorno = '" . $DebtorNo . "'
+						ORDER BY logdate DESC, id DESC
+						LIMIT 500");
+echo '<table class="selection">
+		<tr><th colspan="5">' . __('Everything credit control has done for this customer (reviews, stop and watch, limits, reminders, charges, waivers, write-offs)') . '</th></tr>
+		<tr><th>' . __('When') . '</th><th>' . __('By') . '</th><th>' . __('Action') . '</th><th>' . __('Detail') . '</th><th>' . __('Amount') . '</th></tr>';
+while ($LogRow = DB_fetch_array($LogResult)) {
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDateTime($LogRow['logdate']) . '</td>
+			<td>' . $LogRow['userid'] . '</td>

@@ -0,0 +1,278 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+
+/* Security token that allows the user to UPDATE contacts that already exist. Users who can run
+ * this page without it can only add new contacts. Grant it in Setup -> Security Roles. */
+define('CUSTCONTACTS_UPDATE_TOKEN', 21);
+
+// the csv columns, in order, with the maximum length of the matching custcontacts column
+$FieldHeadings = array(
+	'debtorno',//0
+	'contactname',//1
+	'role',//2
+	'phoneno',//3
+	'email',//4
+	'notes',//5
+	'statement',//6
+);
+$FieldLengths = array(
+	'debtorno' => 10,
+	'contactname' => 40,
+	'role' => 40,
+	'phoneno' => 20,
+	'email' => 55,
+	'notes' => 255,
+);
+
+// If this script is called with the gettemplate flag, then a template file is served
+if (isset($_POST['gettemplate']) or isset($_GET['gettemplate'])) {
+	header('Content-Type: text/csv; charset=utf-8');
+	header('Content-Disposition: attachment; filename="CustomerContactsTemplate.csv"');
+	echo '"' . implode('","', $FieldHeadings) . '"' . "\r\n";
+	exit();
+}
+
+$Title = __('Import Customer Contacts');
+$ViewTopic = 'SpecialUtilities';
+$BookMark = basename(__FILE__, '.php');
+include('includes/header.php');
+
+$CanUpdate = in_array(CUSTCONTACTS_UPDATE_TOKEN, $_SESSION['AllowedPageSecurityTokens']);
+
+if (isset($_FILES['userfile']) and $_FILES['userfile']['name']) { //start file processing
+
+	if ($_FILES['userfile']['error'] != UPLOAD_ERR_OK) {
+		prnMsg(__('The file could not be uploaded'), 'error');
+		include('includes/footer.php');
+		exit();
+	}
+
+	$FileHandle = fopen($_FILES['userfile']['tmp_name'], 'r');
+	$HeadRow = fgetcsv($FileHandle, 10000, ',');
+	if ($HeadRow === false or $HeadRow === array(null)) {
+		prnMsg(__('The file is empty'), 'error');
+		fclose($FileHandle);
+		include('includes/footer.php');
+		exit();
+	}
+	// Remove UTF-8 BOM if present
+	if (substr($HeadRow[0], 0, 3) === "\xef\xbb\xbf") {
+		$HeadRow[0] = substr($HeadRow[0], 3);
+	}
+
+	$HeadersOK = count($HeadRow) == count($FieldHeadings);
+	if ($HeadersOK) {
+		foreach ($HeadRow as $Index => $HeadField) {
+			if (mb_strtoupper(trim($HeadField)) != mb_strtoupper($FieldHeadings[$Index])) {
+				$HeadersOK = false;
+			}
+		}
+	}
+	if (!$HeadersOK) {
+		prnMsg(__('The file does not have the expected columns') . ': ' . implode(', ', $FieldHeadings) . '. ' . __('Try downloading a new template.'), 'error');
+		fclose($FileHandle);
+		include('includes/footer.php');
+		exit();
+	}
+
+	$AddedNum = 0;
+	$UpdatedNum = 0;
+	$UnchangedNum = 0;
+	$Skipped = array(); // array of array(file line, debtorno, contactname, reason)
+	$AddedThisRun = array(); // keys of contacts inserted by this run
+	$Line = 1;
+
+	DB_Txn_Begin();
+	$Failed = false;
+
+	while (($FileRow = fgetcsv($FileHandle, 10000, ',')) !== false) {
+		$Line++;
+		if ($FileRow === array(null)) { // blank line
+			continue;
+		}
+		foreach ($FileRow as &$Value) {
+			$Value = trim((string) $Value);
+		}
+		unset($Value);
+
+		if (count($FileRow) != count($FieldHeadings)) {
+			$Skipped[] = array($Line, $FileRow[0], $FileRow[1] ?? '', __('wrong number of columns') . ' (' . count($FileRow) . ' ' . __('instead of') . ' ' . count($FieldHeadings) . ')');
+			continue;
+		}
+
+		$Contact = array_combine($FieldHeadings, $FileRow);
+
+		if ($Contact['contactname'] === '') {
+			$Skipped[] = array($Line, $Contact['debtorno'], $Contact['contactname'], __('missing name'));
+			continue;
+		}
+
+		$TooLong = array();
+		foreach ($FieldLengths as $Field => $MaxLength) {
+			if (mb_strlen($Contact[$Field]) > $MaxLength) {
+				$TooLong[] = $Field . ' (' . __('maximum') . ' ' . $MaxLength . ')';
+			}
+		}
+		if (count($TooLong) > 0) {
+			$Skipped[] = array($Line, $Contact['debtorno'], $Contact['contactname'], __('value too long') . ': ' . implode(', ', $TooLong));
+			continue;
+		}
+
+		$StatementFlag = mb_strtolower($Contact['statement']);
+		if (in_array($StatementFlag, array('1', 'y', 'yes', 'true'), true)) {
+			$Statement = 1;
+		} elseif (in_array($StatementFlag, array('', '0', 'n', 'no', 'false'), true)) {
+			$Statement = 0;
+		} else {
+			$Skipped[] = array($Line, $Contact['debtorno'], $Contact['contactname'], __('statement must be 1 or 0'));
+			continue;
+		}
+
+		if ($Contact['email'] !== '' and !filter_var($Contact['email'], FILTER_VALIDATE_EMAIL)) {
+			$Skipped[] = array($Line, $Contact['debtorno'], $Contact['contactname'], __('invalid e-mail'));
+			continue;
+		}
+		if ($Statement == 1 and $Contact['email'] === '') {
+			$Skipped[] = array($Line, $Contact['debtorno'], $Contact['contactname'], __('invalid e-mail') . ' (' . __('an e-mail address is needed to send statements') . ')');
+			continue;
+		}
+
+		// the customer must exist; use the code exactly as it is stored
+		$SQL = "SELECT debtorno FROM debtorsmaster WHERE debtorno = '" . DB_escape_string($Contact['debtorno']) . "'";
+		$Result = DB_query($SQL);
+		if ($Contact['debtorno'] === '' or DB_num_rows($Result) == 0) {
+			$Skipped[] = array($Line, $Contact['debtorno'], $Contact['contactname'], __('unknown customer'));
+			continue;
+		}
+		$MyRow = DB_fetch_array($Result);
+		$DebtorNo = $MyRow['debtorno'];
+
+		$Key = mb_strtolower($DebtorNo . "\n" . $Contact['contactname']);
+
+		$SQL = "SELECT contid, role, phoneno, email, notes, statement
+				FROM custcontacts
+				WHERE debtorno = '" . DB_escape_string($DebtorNo) . "'
+				AND contactname = '" . DB_escape_string($Contact['contactname']) . "'";
+		$Result = DB_query($SQL);
+
+		if (DB_num_rows($Result) == 0) {
+			$SQL = "INSERT INTO custcontacts (debtorno,
+											contactname,
+											role,
+											phoneno,
+											notes,
+											email,
+											statement)
+					VALUES ('" . DB_escape_string($DebtorNo) . "',
+							'" . DB_escape_string($Contact['contactname']) . "',
+							'" . DB_escape_string($Contact['role']) . "',
+							'" . DB_escape_string($Contact['phoneno']) . "',
+							'" . DB_escape_string($Contact['notes']) . "',
+							'" . DB_escape_string($Contact['email']) . "',
+							" . $Statement . ")";
+			DB_query($SQL, __('The contact could not be added because'));
+			if (DB_error_no() != 0) {
+				$Failed = true;
+				break;
+			}
+			$AddedThisRun[$Key] = true;
+			$AddedNum++;
+			continue;
+		}
+
+		// the contact exists - find out whether this row would change anything
+		$Changes = false;
+		$ContIDs = array();
+		while ($MyRow = DB_fetch_array($Result)) {
+			$ContIDs[] = (int) $MyRow['contid'];
+			if ($MyRow['role'] !== $Contact['role'] or
+				$MyRow['phoneno'] !== $Contact['phoneno'] or
+				$MyRow['email'] !== $Contact['email'] or
+				$MyRow['notes'] !== $Contact['notes'] or
+				(int) $MyRow['statement'] !== $Statement) {
+				$Changes = true;
+			}
+		}
+		if (!$Changes) {
+			$UnchangedNum++;
+			continue;
+		}
+		if (!$CanUpdate) {
+			$Skipped[] = array($Line, $DebtorNo, $Contact['contactname'], __('not allowed to update existing contacts'));
+			continue;
+		}
+
+		$SQL = "UPDATE custcontacts SET role = '" . DB_escape_string($Contact['role']) . "',
+										phoneno = '" . DB_escape_string($Contact['phoneno']) . "',
+										notes = '" . DB_escape_string($Contact['notes']) . "',
+										email = '" . DB_escape_string($Contact['email']) . "',
+										statement = " . $Statement . "
+				WHERE contid IN (" . implode(',', $ContIDs) . ")";
+		DB_query($SQL, __('The contact could not be updated because'));
+		if (DB_error_no() != 0) {
+			$Failed = true;
+			break;
+		}
+		$UpdatedNum++;
+	}
+	fclose($FileHandle);
+
+	if ($Failed) {
+		DB_Txn_Rollback();
+		prnMsg(__('The import failed on line') . ' ' . $Line . '. ' . __('Nothing has been imported.'), 'error');
+	} else {
+		DB_Txn_Commit();
+		prnMsg(__('Import finished'), 'success');
+		echo '<table class="selection">
+				<tr><th>' . __('Contacts added') . '</th><td class="number">' . $AddedNum . '</td></tr>
+				<tr><th>' . __('Contacts updated') . '</th><td class="number">' . $UpdatedNum . '</td></tr>
+				<tr><th>' . __('Contacts already up to date') . '</th><td class="number">' . $UnchangedNum . '</td></tr>
+				<tr><th>' . __('Rows skipped') . '</th><td class="number">' . count($Skipped) . '</td></tr>
+			</table>';
+		if (count($Skipped) > 0) {
+			echo '<br />
+				<table class="selection">
+				<tr>
+					<th>' . __('Line') . '</th>
+					<th>' . __('Customer Code') . '</th>
+					<th>' . __('Contact Name') . '</th>
+					<th>' . __('Reason skipped') . '</th>
+				</tr>';
+			foreach ($Skipped as $SkippedRow) {
+				echo '<tr class="striped_row">
+						<td class="number">' . $SkippedRow[0] . '</td>
+						<td>' . htmlspecialchars($SkippedRow[1], ENT_QUOTES, 'UTF-8') . '</td>
+						<td>' . htmlspecialchars($SkippedRow[2], ENT_QUOTES, 'UTF-8') . '</td>
+						<td>' . htmlspecialchars($SkippedRow[3], ENT_QUOTES, 'UTF-8') . '</td>
+					</tr>';
+			}
+			echo '</table>';
+		}
+	}
+	echo '<br /><div class="centre"><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">' . __('Import another file') . '</a></div>';
+
+} else { //show file upload form
+
+	prnMsg(__('Please ensure that your csv file is encoded in UTF-8, otherwise the input data will not store correctly in database'), 'warn');
+	if ($CanUpdate) {
+		prnMsg(__('Contacts that already exist for the same customer and name will be updated.'), 'info');
+	} else {
+		prnMsg(__('You are not allowed to update existing contacts. Rows that would change an existing contact will be skipped and reported.'), 'info');
+	}
+
+	echo '<br />
+		<a href="' . $RootPath . '/Z_ImportCustContacts.php?gettemplate=1">' . __('Get Import Template') . '</a>
+		<br />
+		<br />';
+	echo '<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post" enctype="multipart/form-data">
+		<div class="centre">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="MAX_FILE_SIZE" value="1000000" />' .
+		__('Upload file') . ': <input name="userfile" type="file" />
+		<input type="submit" value="' . __('Send File') . '" />
+		</div>
+		</form>';
+}
+
+include('includes/footer.php');

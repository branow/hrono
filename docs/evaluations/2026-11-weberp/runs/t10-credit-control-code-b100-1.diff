diff --git a/includes/CreditControlFunctions.php b/includes/CreditControlFunctions.php
new file mode 100644
index 0000000..fe8c955
--- /dev/null
+++ b/includes/CreditControlFunctions.php
@@ -0,0 +1,321 @@
+<?php
+
+/* Shared functions for customer credit control: reviews, holds, reminders, late payment charges and write-offs */
+
+/* Security token held by the credit controller and deputy only. It allows credit limits and holds to be changed, reminders
+ * to be sent, late payment charges to be run and bad debts to be written off */
+define('CREDIT_CONTROL_TOKEN', 21);
+
+/* Transaction types of the customer transactions created by credit control */
+define('CREDIT_CONTROL_TYPE_CHARGE', 70);
+define('CREDIT_CONTROL_TYPE_WRITEOFF', 71);
+
+/**
+ * True if the logged in user is a credit controller
+ */
+function CreditControlIsController() {
+	return isset($_SESSION['AllowedPageSecurityTokens'])
+		and is_array($_SESSION['AllowedPageSecurityTokens'])
+		and in_array(CREDIT_CONTROL_TOKEN, $_SESSION['AllowedPageSecurityTokens']);
+}
+
+/**
+ * For a customer login (only tokens 0 and 1) returns the debtor code the user is tied to, else null
+ */
+function CreditControlCustomerLoginDebtor() {
+	if (isset($_SESSION['AllowedPageSecurityTokens'])
+		and in_array(1, $_SESSION['AllowedPageSecurityTokens'])
+		and count($_SESSION['AllowedPageSecurityTokens']) == 2) {
+		$Result = DB_query("SELECT customerid FROM www_users WHERE userid='" . $_SESSION['UserID'] . "'");
+		$MyRow = DB_fetch_row($Result);
+		return ($MyRow and $MyRow[0] != '') ? $MyRow[0] : '';
+	}
+	return null;
+}
+
+/**
+ * SQL to append to a WHERE clause so that only the customers the logged in user may see are listed:
+ * sales people see their own customers (those with a branch of theirs), customers see only themselves
+ * @param string $DebtorColumn the column holding the debtor code e.g. debtorsmaster.debtorno
+ */
+function CreditControlCustomerScopeSQL($DebtorColumn = 'debtorsmaster.debtorno') {
+	$SQL = '';
+	if (isset($_SESSION['SalesmanLogin']) and $_SESSION['SalesmanLogin'] != '') {
+		$SQL .= " AND " . $DebtorColumn . " IN (SELECT DISTINCT debtorno FROM custbranch WHERE salesman='" . $_SESSION['SalesmanLogin'] . "') ";
+	}
+	$CustomerLogin = CreditControlCustomerLoginDebtor();
+	if ($CustomerLogin !== null) {
+		$SQL .= " AND " . $DebtorColumn . "='" . $CustomerLogin . "' ";
+	}
+	return $SQL;
+}
+
+/**
+ * SQL to append to a WHERE clause so that sales people only see their own transactions
+ * @param string $TransColumn the column holding the sales person of the transaction e.g. debtortrans.salesperson
+ */
+function CreditControlTransactionScopeSQL($TransColumn = 'debtortrans.salesperson') {
+	if (isset($_SESSION['SalesmanLogin']) and $_SESSION['SalesmanLogin'] != '') {
+		return " AND " . $TransColumn . "='" . $_SESSION['SalesmanLogin'] . "' ";
+	}
+	return '';
+}
+
+/**
+ * True if the logged in user may see credit information for this customer
+ */
+function CreditControlCanSeeCustomer($DebtorNo) {
+	$Result = DB_query("SELECT debtorsmaster.debtorno FROM debtorsmaster
+						WHERE debtorsmaster.debtorno='" . $DebtorNo . "' " . CreditControlCustomerScopeSQL());
+	return (DB_num_rows($Result) == 1);
+}
+
+/**
+ * The hold state of a customer account from its credit status code:
+ * 0 = invoicing allowed, 1 = on hold (no new invoices by any route), 2 = watch (staff warned, may carry on)
+ */
+function CreditHoldState($DebtorNo) {
+	$Result = DB_query("SELECT holdreasons.dissallowinvoices
+						FROM debtorsmaster INNER JOIN holdreasons
+							ON debtorsmaster.holdreason=holdreasons.reasoncode
+						WHERE debtorsmaster.debtorno='" . $DebtorNo . "'");
+	$MyRow = DB_fetch_row($Result);
+	return $MyRow ? (int) $MyRow[0] : 0;
+}
+
+/**
+ * Standard message when a held customer is refused
+ */
+function CreditHoldMessage($DebtorNo) {
+	return __('Customer account') . ' ' . $DebtorNo . ' ' . __('is on credit hold, so no new orders or invoices can be created for it. Please contact the credit control personnel to discuss');
+}
+
+/**
+ * SQL expression for the number of days an open transaction is past its due date. It is the same test used by the
+ * aged debtors report, the customer inquiry and the statements: a transaction is past due when this is 0 or more.
+ */
+function CreditDaysPastDueSQL($Trans = 'debtortrans', $Terms = 'paymentterms', $AsOf = 'Now()') {
+	return "(CASE WHEN " . $Terms . ".daysbeforedue > 0
+			THEN TO_DAYS(" . $AsOf . ") - TO_DAYS(" . $Trans . ".trandate) - " . $Terms . ".daysbeforedue
+			ELSE TO_DAYS(" . $AsOf . ") - TO_DAYS(ADDDATE(last_day(" . $Trans . ".trandate), " . $Terms . ".dayinfollowingmonth))
+			END)";
+}
+
+/**
+ * SQL expression for the reminder level of a transaction: 0 = not past due, 1 = past due (friendly reminder),
+ * 2 = in the first overdue band (firm reminder), 3 = in the second overdue band (final notice). The bands are
+ * the PastDueDays1 and PastDueDays2 company settings used by the ageing, with the same tests as the aged debtors report
+ */
+function CreditReminderLevelSQL($Trans = 'debtortrans', $Terms = 'paymentterms') {
+	$Days = CreditDaysPastDueSQL($Trans, $Terms);
+	$Band1 = (int) $_SESSION['PastDueDays1'];
+	$Band2 = (int) $_SESSION['PastDueDays2'];
+	return "(CASE WHEN " . $Days . " >= " . $Band2 . " AND (" . $Terms . ".daysbeforedue = 0 OR " . $Days . " > 0) THEN 3
+				WHEN " . $Days . " >= " . $Band1 . " AND (" . $Terms . ".daysbeforedue = 0 OR " . $Days . " > 0) THEN 2
+				WHEN " . $Days . " >= 0 THEN 1
+				ELSE 0 END)";
+}
+
+/**
+ * The names of the three reminder levels
+ */
+function CreditReminderLevelName($Level) {
+	if ($Level == 3) {
+		return __('Final notice');
+	} elseif ($Level == 2) {
+		return __('Firm reminder');
+	}
+	return __('Friendly reminder');
+}
+
+/**
+ * Companies record fields added for credit control, read directly as the session copy is loaded before upgrades run
+ */
+function CreditControlGetAccounts() {
+	$Result = DB_query("SELECT latechargeact, baddebtact, debtorsact, creditorsact, payrollact, grnact,
+							commissionsact, retainedearnings, freightact
+						FROM companies WHERE coycode=1");
+	return DB_fetch_array($Result);
+}
+
+/**
+ * Checks that an account chosen in the company setup can be posted to by credit control: it must be set, exist,
+ * and must not be one of the control accounts. Returns an error message, or '' when it is fine
+ */
+function CreditControlCheckAccount($Account, $Accounts, $Name) {
+	if ($Account == '' or $Account == '0') {
+		return __('The') . ' ' . $Name . ' ' . __('has not been set up in the company preferences');
+	}
+	foreach (array('debtorsact', 'creditorsact', 'payrollact', 'grnact', 'commissionsact', 'retainedearnings', 'freightact') as $Control) {
+		if ($Accounts[$Control] == $Account) {
+			return __('The') . ' ' . $Name . ' ' . __('is a control account and cannot be used');
+		}
+	}
+	$Result = DB_query("SELECT accountcode FROM chartmaster WHERE accountcode='" . $Account . "'");
+	if (DB_num_rows($Result) == 0) {
+		return __('The') . ' ' . $Name . ' ' . __('does not exist in the chart of accounts');
+	}
+	return '';
+}
+
+/**
+ * Text as stored (HTML escaped on input) turned back into plain text, for use in PDF letters
+ */
+function CreditControlPlainText($Text) {
+	return html_entity_decode((string) $Text, ENT_QUOTES, 'UTF-8');
+}
+
+/**
+ * The first branch of a customer, used for the branch and sales person on transactions created by credit control
+ */
+function CreditControlFirstBranch($DebtorNo) {
+	$Result = DB_query("SELECT branchcode, salesman FROM custbranch WHERE debtorno='" . $DebtorNo . "' ORDER BY branchcode LIMIT 1");
+	return DB_fetch_array($Result);
+}
+
+/**
+ * The company letterhead block used at the top of the credit control PDF documents
+ */
+function CreditControlLetterhead() {
+	$Company = $_SESSION['CompanyRecord'];
+	$HTML = '<div class="company">';
+	if (!empty($_SESSION['LogoFile'])) {
+		$HTML .= '<img class="logo" src="' . $_SESSION['LogoFile'] . '" /><br />';
+	}
+	$HTML .= $Company['coyname'] . '</div><div class="small">';
+	foreach (array('regoffice1', 'regoffice2', 'regoffice3', 'regoffice4', 'regoffice5', 'regoffice6') as $Line) {
+		if ($Company[$Line] != '') {
+			$HTML .= $Company[$Line] . '<br />';
+		}
+	}
+	if ($Company['telephone'] != '') {
+		$HTML .= __('Telephone') . ': ' . $Company['telephone'] . '<br />';
+	}
+	if ($Company['email'] != '') {
+		$HTML .= __('Email') . ': ' . $Company['email'];
+	}
+	return $HTML . '</div>';
+}
+
+/**
+ * Stylesheet for the credit control PDF documents
+ */
+function CreditControlPDFStyle() {
+	return '<style>
+		body { font-family: DejaVu Sans, Arial, Helvetica, sans-serif; font-size: 11px; }
+		.header { font-size: 16px; font-weight: bold; margin: 16px 0 10px 0; }
+		.company { font-size: 13px; font-weight: bold; }
+		.small { font-size: 10px; }
+		table { border-collapse: collapse; width: 100%; margin: 12px 0; }
+		th, td { border: 1px solid #333; padding: 4px; vertical-align: top; }
+		.right { text-align: right; }
+	</style>';
+}
+
+/**
+ * Builds the HTML of a reminder letter on the company letterhead
+ * @param array $Debtor debtorno, name, address1..address6
+ * @param int $Wording 1, 2 or 3 as the letter level wording
+ * @param string $Text the body of the letter, as stored
+ * @param array $Lines rows with transno, trandate, balance, dayspastdue
+ */
+function CreditControlReminderHTML($Debtor, $Wording, $Text, $Lines, $CurrCode, $DecimalPlaces, $SentDate) {
+	$HTML = '<!DOCTYPE html><html><head><meta charset="utf-8" />' . CreditControlPDFStyle() . '</head><body>';
+	$HTML .= CreditControlLetterhead();
+	$HTML .= '<p>' . ConvertSQLDate(mb_substr($SentDate, 0, 10)) . '</p>';
+	$HTML .= '<p>' . $Debtor['name'] . '<br />';
+	foreach (array('address1', 'address2', 'address3', 'address4', 'address5', 'address6') as $Line) {
+		if ($Debtor[$Line] != '') {
+			$HTML .= $Debtor[$Line] . '<br />';
+		}
+	}
+	$HTML .= '</p>';
+	$HTML .= '<div class="header">' . CreditReminderLevelName($Wording) . ' - ' . __('Account') . ' ' . $Debtor['debtorno'] . '</div>';
+	$HTML .= '<p>' . nl2br($Text) . '</p>';
+	$HTML .= '<table><tr><th>' . __('Invoice') . '</th><th>' . __('Date') . '</th><th>' . __('Days Past Due') . '</th><th class="right">' . __('Amount Outstanding') . ' (' . $CurrCode . ')</th></tr>';
+	$Total = 0;
+	foreach ($Lines as $Line) {
+		$Total += $Line['balance'];
+		$HTML .= '<tr><td>' . $Line['transno'] . '</td><td>' . ConvertSQLDate($Line['trandate']) . '</td><td>' . $Line['dayspastdue'] . '</td><td class="right">' . locale_number_format($Line['balance'], $DecimalPlaces) . '</td></tr>';
+	}
+	$HTML .= '<tr><th colspan="3">' . __('Total') . '</th><th class="right">' . locale_number_format($Total, $DecimalPlaces) . '</th></tr></table>';
+	$HTML .= '<p class="small">' . __('Quoting your account reference') . ' ' . $Debtor['debtorno'] . '</p>';
+	return $HTML . '</body></html>';
+}
+
+/**
+ * Shows the reminders sent to a customer: date, level and the invoices included. Sales people only see the invoices
+ * that are their own
+ */
+function CreditControlShowReminders($DebtorNo, $DecimalPlaces) {
+	global $RootPath;
+	echo '<table class="selection">
+			<tr><th colspan="6">' . __('Reminders Sent') . '</th></tr>
+			<tr><th>' . __('Date Sent') . '</th><th>' . __('Level') . '</th><th>' . __('Invoices Included') . '</th><th>' . __('Amount') . '</th><th>' . __('Sent To') . '</th><th></th></tr>';
+	$Result = DB_query("SELECT custreminders.id, custreminders.sentdate, custreminders.level, custreminders.wording,
+							custreminders.sentto, custreminders.currcode,
+							GROUP_CONCAT(debtortrans.transno ORDER BY debtortrans.transno SEPARATOR ', ') AS invoices,
+							SUM(custreminderlines.balance) AS amount
+						FROM custreminders
+						INNER JOIN custreminderlines ON custreminderlines.reminderid=custreminders.id
+						INNER JOIN debtortrans ON custreminderlines.debtortransid=debtortrans.id
+						WHERE custreminders.debtorno='" . $DebtorNo . "' " . CreditControlTransactionScopeSQL() . "
+						GROUP BY custreminders.id, custreminders.sentdate, custreminders.level, custreminders.wording, custreminders.sentto, custreminders.currcode
+						ORDER BY custreminders.sentdate DESC, custreminders.id DESC");
+	if (DB_num_rows($Result) == 0) {
+		echo '<tr><td colspan="6">' . __('No reminders have been sent') . '</td></tr>';
+	}
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . ConvertSQLDate(mb_substr($MyRow['sentdate'], 0, 10)) . '</td>
+				<td>' . CreditReminderLevelName($MyRow['level']) . ($MyRow['wording'] != $MyRow['level'] ? ' (' . CreditReminderLevelName($MyRow['wording']) . ' ' . __('wording') . ')' : '') . '</td>
+				<td>' . $MyRow['invoices'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['amount'], $DecimalPlaces) . ' ' . $MyRow['currcode'] . '</td>
+				<td>' . $MyRow['sentto'] . '</td>
+				<td><a target="_blank" href="' . $RootPath . '/PrintCreditReminder.php?ReminderID=' . $MyRow['id'] . '">' . __('Letter (PDF)') . '</a></td>
+			</tr>';
+	}
+	echo '</table><br />';
+}
+
+/**
+ * Shows the late payment charges and bad debt write-offs of a customer. Sales people only see their own transactions
+ */
+function CreditControlShowCharges($DebtorNo, $DecimalPlaces) {
+	global $RootPath;
+	echo '<table class="selection">
+			<tr><th colspan="6">' . __('Late Payment Charges and Write-offs') . '</th></tr>
+			<tr><th>' . __('Date') . '</th><th>' . __('Type') . '</th><th>' . __('Number') . '</th><th>' . __('Amount') . '</th><th>' . __('Details') . '</th><th></th></tr>';
+	$Result = DB_query("SELECT debtortrans.id, debtortrans.type, debtortrans.transno, debtortrans.trandate, debtortrans.invtext,
+							debtortrans.ovamount + debtortrans.ovgst AS amount, systypes.typename
+						FROM debtortrans INNER JOIN systypes ON debtortrans.type=systypes.typeid
+						WHERE debtortrans.debtorno='" . $DebtorNo . "'
+							AND debtortrans.type IN (" . CREDIT_CONTROL_TYPE_CHARGE . ", " . CREDIT_CONTROL_TYPE_WRITEOFF . ") " . CreditControlTransactionScopeSQL() . "
+						ORDER BY debtortrans.trandate DESC, debtortrans.id DESC");
+	if (DB_num_rows($Result) == 0) {
+		echo '<tr><td colspan="6">' . __('No late payment charges or write-offs') . '</td></tr>';
+	}
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+				<td>' . __($MyRow['typename']) . '</td>
+				<td>' . $MyRow['transno'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['amount'], $DecimalPlaces) . '</td>
+				<td>' . nl2br((string) $MyRow['invtext']) . '</td>
+				<td><a target="_blank" href="' . $RootPath . '/PrintCustCharge.php?Type=' . $MyRow['type'] . '&amp;TransNo=' . $MyRow['transno'] . '">' . __('Print (PDF)') . '</a></td>
+			</tr>';
+	}
+	echo '</table><br />';
+}
+
+/**
+ * Returns the PDF bytes for HTML, using the standard DomPDF options
+ */
+function CreditControlRenderPDF($HTML, $Orientation = 'portrait') {
+	global $DomPDFOptions;
+	$DomPDF = new Dompdf\Dompdf($DomPDFOptions);
+	$DomPDF->loadHtml($HTML);
+	$DomPDF->setPaper($_SESSION['PageSize'], $Orientation);
+	$DomPDF->render();
+	return $DomPDF;
+}

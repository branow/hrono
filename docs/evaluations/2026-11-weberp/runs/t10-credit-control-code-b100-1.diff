+<?php
+
+/* Month end late payment charges: interest on overdue invoices at the rate set in the company settings and a fixed
+ * reminder fee for each final notice sent in the month. Nothing is charged unless the credit controller runs it,
+ * and a customer can only be charged once for a month. The charges are customer transactions (type 70) in the
+ * currency of the customer posted to the income account chosen in the company preferences */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/SQL_CommonFunctions.php');
+include('includes/GLFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$ViewTopic = 'CreditControl';
+$BookMark = 'LateCharges';
+$Title = __('Late Payment Charges');
+
+$Rate = (float) ($_SESSION['LateInterestRate'] ?? 0);
+$Fee = (float) ($_SESSION['ReminderFee'] ?? 0);
+
+$ChargeMonth = (isset($_POST['ChargeMonth']) and preg_match('/^\d{4}-(0[1-9]|1[0-2])$/', $_POST['ChargeMonth'])) ? $_POST['ChargeMonth'] : date('Y-m', strtotime('first day of last month'));
+$MonthStart = $ChargeMonth . '-01';
+$MonthEnd = date('Y-m-t', strtotime($MonthStart));
+$DaysInMonth = (int) date('t', strtotime($MonthStart));
+$NextMonthStart = date('Y-m-d', strtotime($MonthEnd . ' +1 day'));
+
+/**
+ * What each customer would be charged for the month: interest per invoice and the fee for the final notices sent in
+ * the month that have not been charged yet. Customers already charged for the month are not listed
+ */
+function LateChargesDue($MonthStart, $MonthEnd, $NextMonthStart, $ChargeMonth, $DaysInMonth, $Rate, $Fee) {
+	$Due = array();
+	if ($Rate > 0) {
+		$Days = CreditDaysPastDueSQL('debtortrans', 'paymentterms', "'" . $MonthEnd . "'");
+		$Result = DB_query("SELECT debtortrans.debtorno, debtortrans.transno, debtortrans.balance, " . $Days . " AS days,
+								debtorsmaster.name, debtorsmaster.currcode, debtorsmaster.salestype, currencies.decimalplaces, currencies.rate
+							FROM debtortrans
+							INNER JOIN debtorsmaster ON debtortrans.debtorno=debtorsmaster.debtorno
+							INNER JOIN paymentterms ON debtorsmaster.paymentterms=paymentterms.termsindicator
+							INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+							WHERE debtortrans.type=10
+								AND debtortrans.trandate <= '" . $MonthEnd . "'
+								AND debtortrans.balance > " . CurrencyTolerance($_SESSION['CompanyRecord']['currencydefault']) . "
+								AND " . $Days . " > 0
+								AND NOT EXISTS (SELECT 1 FROM custlatecharges WHERE custlatecharges.debtorno=debtortrans.debtorno
+												AND custlatecharges.chargemonth='" . $ChargeMonth . "')
+							ORDER BY debtortrans.debtorno, debtortrans.transno");
+		while ($MyRow = DB_fetch_array($Result)) {
+			$No = $MyRow['debtorno'];
+			if (!isset($Due[$No])) {
+				$Due[$No] = array('name' => $MyRow['name'], 'currcode' => $MyRow['currcode'], 'salestype' => $MyRow['salestype'],
+					'decimalplaces' => $MyRow['decimalplaces'], 'rate' => $MyRow['rate'], 'interest' => 0, 'fee' => 0, 'notices' => 0, 'lines' => array());
+			}
+			/* the days of the month the invoice was past due, on its balance, at the yearly rate */
+			$OverdueDays = min((int) $MyRow['days'], $DaysInMonth);
+			$Interest = round($MyRow['balance'] * $Rate / 100 * $OverdueDays / 365, $MyRow['decimalplaces']);
+			if ($Interest > 0) {
+				$Due[$No]['interest'] += $Interest;
+				$Due[$No]['lines'][] = __('Invoice') . ' ' . $MyRow['transno'] . ': ' . $OverdueDays . ' ' . __('days at') . ' ' . $Rate . '% ' . __('on') . ' ' . locale_number_format($MyRow['balance'], $MyRow['decimalplaces']) . ' = ' . locale_number_format($Interest, $MyRow['decimalplaces']);
+			}
+		}
+	}
+	if ($Fee > 0) {
+		$Result = DB_query("SELECT custreminders.debtorno, COUNT(*) AS notices, debtorsmaster.name, debtorsmaster.currcode, debtorsmaster.salestype,
+								currencies.decimalplaces, currencies.rate
+							FROM custreminders
+							INNER JOIN debtorsmaster ON custreminders.debtorno=debtorsmaster.debtorno
+							INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+							WHERE custreminders.wording=3
+								AND custreminders.latechargeid IS NULL
+								AND custreminders.sentdate >= '" . $MonthStart . " 00:00:00'
+								AND custreminders.sentdate < '" . $NextMonthStart . " 00:00:00'
+								AND NOT EXISTS (SELECT 1 FROM custlatecharges WHERE custlatecharges.debtorno=custreminders.debtorno
+												AND custlatecharges.chargemonth='" . $ChargeMonth . "')
+							GROUP BY custreminders.debtorno, debtorsmaster.name, debtorsmaster.currcode, debtorsmaster.salestype, currencies.decimalplaces, currencies.rate");
+		while ($MyRow = DB_fetch_array($Result)) {
+			$No = $MyRow['debtorno'];
+			if (!isset($Due[$No])) {
+				$Due[$No] = array('name' => $MyRow['name'], 'currcode' => $MyRow['currcode'], 'salestype' => $MyRow['salestype'],
+					'decimalplaces' => $MyRow['decimalplaces'], 'rate' => $MyRow['rate'], 'interest' => 0, 'fee' => 0, 'notices' => 0, 'lines' => array());
+			}
+			$Due[$No]['notices'] = (int) $MyRow['notices'];
+			$Due[$No]['fee'] = round($MyRow['notices'] * $Fee, $MyRow['decimalplaces']);
+			$Due[$No]['lines'][] = __('Reminder fee for') . ' ' . $MyRow['notices'] . ' ' . __('final notice(s)') . ' = ' . locale_number_format($Due[$No]['fee'], $MyRow['decimalplaces']);
+		}
+	}
+	foreach ($Due as $No => $Customer) {
+		$Due[$No]['total'] = $Customer['interest'] + $Customer['fee'];
+		if ($Due[$No]['total'] <= 0) {
+			unset($Due[$No]);
+		}
+	}
+	ksort($Due);
+	return $Due;
+}
+
+$AccountError = '';
+$Accounts = CreditControlGetAccounts();
+if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+	$AccountError = CreditControlCheckAccount($Accounts['latechargeact'], $Accounts, __('late payment charges income account'));
+}
+
+$Done = array();
+$Refused = array();
+
+if (isset($_POST['Run'])) {
+	if ($AccountError != '') {
+		prnMsg($AccountError, 'error');
+	} elseif ($MonthEnd > date('Y-m-d')) {
+		prnMsg(__('The charges for a month can only be run once the month has ended'), 'error');
+	} else {
+		$Tags = (isset($_POST['tag']) and is_array($_POST['tag'])) ? $_POST['tag'] : array();
+		$Include = (isset($_POST['Include']) and is_array($_POST['Include'])) ? $_POST['Include'] : array();
+		$TransDate = ConvertSQLDate($MonthEnd);
+		foreach (LateChargesDue($MonthStart, $MonthEnd, $NextMonthStart, $ChargeMonth, $DaysInMonth, $Rate, $Fee) as $No => $Customer) {
+			if (!in_array($No, $Include)) {
+				continue;
+			}
+			DB_Txn_Begin();
+			/* the period is found once and used for the customer transaction and the ledger entries alike */
+			$PeriodNo = GetPeriod($TransDate);
+			$TransNo = GetNextTransNo(CREDIT_CONTROL_TYPE_CHARGE);
+			$Branch = CreditControlFirstBranch($No);
+			$Details = __('Late payment charges for') . ' ' . $ChargeMonth . "\n" . implode("\n", $Customer['lines']);
+			DB_query("INSERT INTO debtortrans (transno, type, debtorno, branchcode, trandate, inputdate, prd, settled, reference, tpe, order_, rate,
+								ovamount, ovgst, ovfreight, ovdiscount, diffonexch, alloc, invtext, shipvia, edisent, consignment, packages, salesperson)
+					VALUES ('" . $TransNo . "', '" . CREDIT_CONTROL_TYPE_CHARGE . "', '" . $No . "', '" . ($Branch['branchcode'] ?? '') . "', '" . $MonthEnd . "',
+							'" . date('Y-m-d H:i:s') . "', '" . $PeriodNo . "', 0, 'LATE-" . $ChargeMonth . "', '" . $Customer['salestype'] . "', 0, '" . $Customer['rate'] . "',
+							'" . $Customer['total'] . "', 0, 0, 0, 0, 0, '" . DB_escape_string($Details) . "', 0, 0, '', 1, '" . ($Branch['salesman'] ?? '') . "')",
+				__('The late payment charge could not be saved because'), '', true);
+			$DebtorTransID = DB_Last_Insert_ID('debtortrans', 'id');
+
+			/* the unique key on customer and month refuses a second charge for the same month */
+			DB_query("INSERT INTO custlatecharges (debtorno, chargemonth, debtortransid, interestamount, feeamount, createdby, createddate)
+					VALUES ('" . $No . "', '" . $ChargeMonth . "', '" . $DebtorTransID . "', '" . $Customer['interest'] . "', '" . $Customer['fee'] . "',
+							'" . $_SESSION['UserID'] . "', '" . date('Y-m-d H:i:s') . "')",
+				__('The charge for this customer and month already exists'), '', true);
+			$ChargeID = DB_Last_Insert_ID('custlatecharges', 'id');
+			if ($Customer['notices'] > 0) {
+				/* the final notices of the month that are now charged for */
+				DB_query("UPDATE custreminders SET latechargeid='" . $ChargeID . "'
+						WHERE debtorno='" . $No . "' AND wording=3 AND latechargeid IS NULL
+							AND sentdate >= '" . $MonthStart . " 00:00:00' AND sentdate < '" . $NextMonthStart . " 00:00:00'", '', '', true);
+			}
+
+			if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+				$HomeAmount = $Customer['total'] / $Customer['rate'];
+				$Narrative = mb_substr($No . ' ' . __('Late payment charges') . ' ' . $ChargeMonth, 0, 200);
+				DB_query("INSERT INTO gltrans (type, typeno, trandate, periodno, account, narrative, amount)
+						VALUES ('" . CREDIT_CONTROL_TYPE_CHARGE . "', '" . $TransNo . "', '" . $MonthEnd . "', '" . $PeriodNo . "',
+								'" . $Accounts['debtorsact'] . "', '" . $Narrative . "', '" . $HomeAmount . "')", __('Cannot insert a GL entry for the charge because'), '', true);
+				DB_query("INSERT INTO gltrans (type, typeno, trandate, periodno, account, narrative, amount)
+						VALUES ('" . CREDIT_CONTROL_TYPE_CHARGE . "', '" . $TransNo . "', '" . $MonthEnd . "', '" . $PeriodNo . "',
+								'" . $Accounts['latechargeact'] . "', '" . $Narrative . "', '" . -$HomeAmount . "')", __('Cannot insert a GL entry for the charge because'), '', true);
+				InsertGLTags($Tags);
+			}
+			DB_Txn_Commit();
+			$Done[] = array($No, $Customer['name'], $TransNo, locale_number_format($Customer['total'], $Customer['decimalplaces']) . ' ' . $Customer['currcode']);
+		}
+	}
+}
+
+include('includes/header.php');
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/money_add.png" title="" alt="" /> ' . $Title . '</p>';
+
+if (count($Done) > 0) {
+	echo '<table class="selection"><tr><th colspan="4">' . __('Charges Made') . '</th></tr>';
+	foreach ($Done as $Row) {
+		echo '<tr class="striped_row"><td>' . $Row[0] . '</td><td>' . $Row[1] . '</td><td><a target="_blank" href="' . $RootPath . '/PrintCustCharge.php?Type=' . CREDIT_CONTROL_TYPE_CHARGE . '&amp;TransNo=' . $Row[2] . '">' . $Row[2] . '</a></td><td class="number">' . $Row[3] . '</td></tr>';
+	}
+	echo '</table><br />';
+}
+
+if ($AccountError != '') {
+	prnMsg($AccountError, 'error');
+}
+if ($Rate == 0 and $Fee == 0) {
+	prnMsg(__('The interest rate and the reminder fee are both zero in the system parameters, so there is nothing to charge'), 'info');
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Month to Charge') . '</legend>
+		<field>
+			<label for="ChargeMonth">' . __('Month') . ' (YYYY-MM):</label>
+			<input type="month" name="ChargeMonth" value="' . $ChargeMonth . '" required="required" />
+			<fieldhelp>' . __('The charges are dated the last day of the month and posted in that period. Interest is the yearly rate for the days of the month each invoice was past due, on its balance when this is run') . '</fieldhelp>
+		</field>
+		<field>
+			<label for="tag[]">' . __('Select Tag(s)') . ':</label>
+			<select multiple="multiple" name="tag[]">';
+$Result = DB_query("SELECT tagref, tagdescription FROM tags ORDER BY tagref");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option value="' . $MyRow['tagref'] . '">' . $MyRow['tagref'] . ' - ' . $MyRow['tagdescription'] . '</option>';
+}
+echo '</select>
+			<fieldhelp>' . __('Ledger tags to put on the income entries - use the ctrl button to pick several') . '</fieldhelp>
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Preview" value="' . __('Show What Would Be Charged') . '" /></div>';
+
+$Due = LateChargesDue($MonthStart, $MonthEnd, $NextMonthStart, $ChargeMonth, $DaysInMonth, $Rate, $Fee);
+if (count($Due) == 0) {
+	prnMsg(__('Nothing is left to charge for') . ' ' . $ChargeMonth, 'info');
+} else {
+	echo '<br /><table class="selection">
+			<tr><th>' . __('Charge') . '</th><th>' . __('Customer') . '</th><th>' . __('Interest') . '</th><th>' . __('Reminder Fees') . '</th><th>' . __('Total') . '</th><th>' . __('How It Was Worked Out') . '</th></tr>';
+	foreach ($Due as $No => $Customer) {
+		echo '<tr class="striped_row">
+				<td><input type="checkbox" name="Include[]" value="' . $No . '" checked="checked" /></td>
+				<td>' . $No . ' ' . $Customer['name'] . '</td>
+				<td class="number">' . locale_number_format($Customer['interest'], $Customer['decimalplaces']) . '</td>
+				<td class="number">' . locale_number_format($Customer['fee'], $Customer['decimalplaces']) . '</td>
+				<td class="number">' . locale_number_format($Customer['total'], $Customer['decimalplaces']) . ' ' . $Customer['currcode'] . '</td>
+				<td>' . implode('<br />', $Customer['lines']) . '</td>
+			</tr>';
+	}
+	echo '</table>
+		<br /><div class="centre"><input type="submit" name="Run" value="' . __('Charge the Selected Customers') . '" onclick="return confirm(\'' . __('Post these charges to the customer accounts and the ledger now?') . '\');" /></div>';
+}
+echo '</form>';
+
+include('includes/footer.php');

diff --git a/CreditReminders.php b/CreditReminders.php
new file mode 100644
index 0000000..290e45d
--- /dev/null
+++ b/CreditReminders.php
@@ -0,0 +1,195 @@
+<?php
+
+/* The credit controller's overdue reminders screen: shows who would get which level of reminder, lets customers be left
+ * out and then sends the letters as PDF by email to the contacts that receive statements. A customer never gets the
+ * same level twice for the same invoices - each invoice is recorded against the level it was reminded at */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+include('includes/SetDomPDFOptions.php');
+
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditReminders';
+$Title = __('Overdue Reminders');
+
+/**
+ * The reminders that are due: for each customer the open invoices that are past due and have not already been reminded at
+ * their level (or a higher one). The letter level is the highest level of those invoices. The past due and the bands are
+ * those of the aged debtors report. Customers on hold get the final notice wording.
+ */
+function CreditRemindersDue() {
+	$LevelSQL = CreditReminderLevelSQL();
+	$SQL = "SELECT debtortrans.id,
+					debtortrans.debtorno,
+					debtortrans.transno,
+					debtortrans.trandate,
+					debtortrans.balance,
+					" . CreditDaysPastDueSQL() . " AS dayspastdue,
+					" . $LevelSQL . " AS lvl,
+					debtorsmaster.name,
+					debtorsmaster.address1,
+					debtorsmaster.address2,
+					debtorsmaster.address3,
+					debtorsmaster.address4,
+					debtorsmaster.address5,
+					debtorsmaster.address6,
+					debtorsmaster.currcode,
+					currencies.decimalplaces,
+					holdreasons.dissallowinvoices
+			FROM debtortrans
+			INNER JOIN debtorsmaster ON debtortrans.debtorno=debtorsmaster.debtorno
+			INNER JOIN paymentterms ON debtorsmaster.paymentterms=paymentterms.termsindicator
+			INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+			INNER JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+			WHERE debtortrans.type=10
+				AND debtortrans.balance > " . CurrencyTolerance($_SESSION['CompanyRecord']['currencydefault']) . "
+				AND " . $LevelSQL . " > 0
+				AND NOT EXISTS (SELECT 1 FROM custreminderlines
+								WHERE custreminderlines.debtortransid=debtortrans.id
+									AND custreminderlines.level >= " . $LevelSQL . ")
+			ORDER BY debtortrans.debtorno, debtortrans.transno";
+	$Result = DB_query($SQL);
+	$Due = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$No = $MyRow['debtorno'];
+		if (!isset($Due[$No])) {
+			$Due[$No] = array('debtor' => $MyRow, 'level' => 0, 'lines' => array());
+			$Recipients = array();
+			$ContactResult = DB_query("SELECT email FROM custcontacts WHERE statement=1 AND debtorno='" . $No . "'");
+			while ($Contact = DB_fetch_row($ContactResult)) {
+				if (IsEmailAddress($Contact[0])) {
+					$Recipients[$Contact[0]] = '';
+				}
+			}
+			$Due[$No]['recipients'] = $Recipients;
+		}
+		$Due[$No]['level'] = max($Due[$No]['level'], (int) $MyRow['lvl']);
+		$Due[$No]['lines'][] = $MyRow;
+	}
+	foreach ($Due as $No => $Customer) {
+		$Due[$No]['wording'] = ($Customer['debtor']['dissallowinvoices'] == 1) ? 3 : $Customer['level'];
+	}
+	return $Due;
+}
+
+$Sent = array();
+$Failed = array();
+
+if (isset($_POST['Send'])) {
+
+	$Include = (isset($_POST['Include']) and is_array($_POST['Include'])) ? $_POST['Include'] : array();
+	foreach (CreditRemindersDue() as $No => $Customer) {
+		if (!in_array($No, $Include)) {
+			continue; // left out by the credit controller
+		}
+		if (count($Customer['recipients']) == 0) {
+			$Failed[] = array($No, $Customer['debtor']['name'], __('There is no contact that receives statements with an email address'));
+			continue;
+		}
+
+		DB_Txn_Begin();
+		$Level = $Customer['level'];
+		$Wording = $Customer['wording'];
+		$Text = $_SESSION['ReminderText' . $Wording] ?? '';
+		$Total = 0;
+		foreach ($Customer['lines'] as $Line) {
+			$Total += $Line['balance'];
+		}
+		$SQL = "INSERT INTO custreminders (debtorno, level, wording, sentdate, sentby, sentto, currcode, totalamount, lettertext)
+				VALUES ('" . $No . "', '" . $Level . "', '" . $Wording . "', '" . date('Y-m-d H:i:s') . "', '" . $_SESSION['UserID'] . "',
+						'" . implode(', ', array_keys($Customer['recipients'])) . "', '" . $Customer['debtor']['currcode'] . "', '" . $Total . "', '" . DB_escape_string($Text) . "')";
+		DB_query($SQL, '', '', false, false);
+		$Error = DB_error_no();
+		if ($Error == 0) {
+			$ReminderID = DB_Last_Insert_ID('custreminders', 'id');
+			foreach ($Customer['lines'] as $Line) {
+				/* the unique key on invoice and level refuses an invoice that has already been reminded at this level */
+				DB_query("INSERT INTO custreminderlines (reminderid, debtortransid, level, balance, dayspastdue)
+						VALUES ('" . $ReminderID . "', '" . $Line['id'] . "', '" . $Level . "', '" . $Line['balance'] . "', '" . $Line['dayspastdue'] . "')", '', '', false, false);
+				if (DB_error_no() != 0) {
+					$Error = DB_error_no();
+					break;
+				}
+			}
+		}
+		if ($Error != 0) {
+			DB_Txn_Rollback();
+			$Failed[] = array($No, $Customer['debtor']['name'], __('A reminder of this level has already been recorded for these invoices'));
+			continue;
+		}
+
+		$HTML = CreditControlReminderHTML($Customer['debtor'], $Wording, $Text, $Customer['lines'], $Customer['debtor']['currcode'], $Customer['debtor']['decimalplaces'], date('Y-m-d'));
+		$DomPDF = CreditControlRenderPDF($HTML);
+		$PdfFileName = sys_get_temp_dir() . '/' . $_SESSION['DatabaseName'] . '_' . CreditReminderLevelName($Wording) . '_' . $No . '_' . date('Y-m-d') . '_' . uniqid() . '.pdf';
+		$PdfFileName = str_replace(' ', '_', $PdfFileName);
+		file_put_contents($PdfFileName, $DomPDF->output());
+
+		$EmailResult = SendEmailFromWebERP($_SESSION['CompanyRecord']['email'],
+											$Customer['recipients'],
+											CreditReminderLevelName($Wording) . ' - ' . $_SESSION['CompanyRecord']['coyname'] . ' - ' . $No,
+											CreditControlPlainText($Text),
+											array($PdfFileName),
+											true);
+		@unlink($PdfFileName);
+
+		if ($EmailResult === true) {
+			DB_Txn_Commit();
+			$Sent[] = array($No, $Customer['debtor']['name'], CreditReminderLevelName($Level), implode(', ', array_keys($Customer['recipients'])));
+		} else {
+			/* the email failed so the letter is not counted as sent: the record is taken back out */
+			DB_Txn_Rollback();
+			$Failed[] = array($No, $Customer['debtor']['name'], __('The email could not be sent') . (is_string($EmailResult) ? ': ' . $EmailResult : ''));
+		}
+	}
+}
+
+include('includes/header.php');
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/email.png" title="" alt="" /> ' . $Title . '</p>';
+
+if (isset($_POST['Send'])) {
+	if (count($Sent) > 0) {
+		echo '<table class="selection"><tr><th colspan="4">' . __('Reminders Sent') . '</th></tr>';
+		foreach ($Sent as $Row) {
+			echo '<tr class="striped_row"><td>' . $Row[0] . '</td><td>' . $Row[1] . '</td><td>' . $Row[2] . '</td><td>' . $Row[3] . '</td></tr>';
+		}
+		echo '</table><br />';
+	}
+	if (count($Failed) > 0) {
+		echo '<table class="selection"><tr><th colspan="3">' . __('NOT sent - these were not counted as sent') . '</th></tr>';
+		foreach ($Failed as $Row) {
+			echo '<tr class="striped_row"><td>' . $Row[0] . '</td><td>' . $Row[1] . '</td><td>' . $Row[2] . '</td></tr>';
+		}
+		echo '</table><br />';
+	}
+}
+
+$Due = CreditRemindersDue();
+if (count($Due) == 0) {
+	prnMsg(__('There are no reminders due: no invoices are past due without a reminder of their level already sent'), 'info');
+} else {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<table class="selection">
+			<tr><th>' . __('Send') . '</th><th>' . __('Customer') . '</th><th>' . __('Reminder') . '</th><th>' . __('Emailed To') . '</th><th>' . __('Invoices') . '</th><th>' . __('Amount') . '</th></tr>';
+	foreach ($Due as $No => $Customer) {
+		$Names = array();
+		foreach ($Customer['lines'] as $Line) {
+			$Names[] = $Line['transno'] . ' (' . $Line['dayspastdue'] . ' ' . __('days') . ')';
+		}
+		$Total = array_sum(array_column($Customer['lines'], 'balance'));
+		echo '<tr class="striped_row">
+				<td><input type="checkbox" name="Include[]" value="' . $No . '"' . (count($Customer['recipients']) > 0 ? ' checked="checked"' : '') . ' /></td>
+				<td>' . $No . ' ' . $Customer['debtor']['name'] . '</td>
+				<td>' . CreditReminderLevelName($Customer['wording']) . ($Customer['wording'] != $Customer['level'] ? ' (' . __('account on hold') . ')' : '') . '</td>
+				<td>' . (count($Customer['recipients']) > 0 ? implode(', ', array_keys($Customer['recipients'])) : '<b>' . __('No contact receives statements - cannot be sent') . '</b>') . '</td>
+				<td>' . implode(', ', $Names) . '</td>
+				<td class="number">' . locale_number_format($Total, $Customer['debtor']['decimalplaces']) . ' ' . $Customer['debtor']['currcode'] . '</td>
+			</tr>';
+	}
+	echo '</table>
+		<br /><div class="centre"><input type="submit" name="Send" value="' . __('Send the Selected Reminders') . '" onclick="return confirm(\'' . __('Send the selected reminders now?') . '\');" /></div>
+	</form>';
+}
+
+include('includes/footer.php');
diff --git a/CreditReviewReport.php b/CreditReviewReport.php
new file mode 100644
index 0000000..46adace
--- /dev/null
+++ b/CreditReviewReport.php
@@ -0,0 +1,107 @@
+<?php
+
+/* Customers whose credit review is overdue or due within a number of days, with their balance, overdue amount, credit
+ * limit, credit still available and the date they last paid. Can be printed as PDF */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+include('includes/SetDomPDFOptions.php');
+
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditReviewReport';
+$Title = __('Credit Reviews Due Report');
+
+$Days = isset($_POST['Days']) ? (int) $_POST['Days'] : 30;
+if ($Days < 0 or $Days > 3650) {
+	$Days = 30;
+}
+$Cutoff = date('Y-m-d', strtotime('+' . $Days . ' days'));
+
+/* Rows of the report. The balance and overdue amounts use the same past due test as the aged debtors report */
+function CreditReviewReportRows($Cutoff) {
+	$SQL = "SELECT debtorsmaster.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					debtorsmaster.creditlimit,
+					debtorsmaster.nextreviewdate,
+					debtorsmaster.lastpaiddate,
+					currencies.decimalplaces,
+					COALESCE(SUM(debtortrans.balance), 0) AS balance,
+					COALESCE(SUM(CASE WHEN " . CreditDaysPastDueSQL() . " >= 0 THEN debtortrans.balance ELSE 0 END), 0) AS overdue
+			FROM debtorsmaster
+			INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+			INNER JOIN paymentterms ON debtorsmaster.paymentterms=paymentterms.termsindicator
+			LEFT JOIN debtortrans ON debtortrans.debtorno=debtorsmaster.debtorno " . CreditControlTransactionScopeSQL() . "
+			WHERE (debtorsmaster.nextreviewdate IS NULL OR debtorsmaster.nextreviewdate <= '" . $Cutoff . "') " . CreditControlCustomerScopeSQL() . "
+			GROUP BY debtorsmaster.debtorno, debtorsmaster.name, debtorsmaster.currcode, debtorsmaster.creditlimit,
+					debtorsmaster.nextreviewdate, debtorsmaster.lastpaiddate, currencies.decimalplaces
+			ORDER BY debtorsmaster.nextreviewdate, debtorsmaster.debtorno";
+	return DB_query($SQL);
+}
+
+if (isset($_POST['PrintPDF'])) {
+
+	$Result = CreditReviewReportRows($Cutoff);
+	$HTML = '<!DOCTYPE html><html><head><meta charset="utf-8" />' . CreditControlPDFStyle() . '</head><body>';
+	$HTML .= CreditControlLetterhead();
+	$HTML .= '<div class="header">' . $Title . ' - ' . __('overdue or due by') . ' ' . ConvertSQLDate($Cutoff) . '</div>';
+	$HTML .= '<table><tr><th>' . __('Customer') . '</th><th>' . __('Review Due') . '</th><th>' . __('Currency') . '</th><th class="right">' . __('Balance') . '</th>
+				<th class="right">' . __('Overdue') . '</th><th class="right">' . __('Credit Limit') . '</th><th class="right">' . __('Credit Available') . '</th><th>' . __('Last Paid') . '</th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		$HTML .= '<tr><td>' . $MyRow['debtorno'] . ' ' . $MyRow['name'] . '</td>
+				<td>' . ($MyRow['nextreviewdate'] ? ConvertSQLDate($MyRow['nextreviewdate']) : __('Never reviewed')) . '</td>
+				<td>' . $MyRow['currcode'] . '</td>
+				<td class="right">' . locale_number_format($MyRow['balance'], $MyRow['decimalplaces']) . '</td>
+				<td class="right">' . locale_number_format($MyRow['overdue'], $MyRow['decimalplaces']) . '</td>
+				<td class="right">' . locale_number_format($MyRow['creditlimit'], $MyRow['decimalplaces']) . '</td>
+				<td class="right">' . locale_number_format(GetCreditAvailable($MyRow['debtorno']), $MyRow['decimalplaces']) . '</td>
+				<td>' . ($MyRow['lastpaiddate'] ? ConvertSQLDate(mb_substr($MyRow['lastpaiddate'], 0, 10)) : '') . '</td></tr>';
+	}
+	$HTML .= '</table></body></html>';
+	$DomPDF = CreditControlRenderPDF($HTML, 'landscape');
+	$DomPDF->stream($_SESSION['DatabaseName'] . '_CreditReviewsDue_' . date('Y-m-d') . '.pdf', array('Attachment' => false));
+	exit();
+}
+
+include('includes/header.php');
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="" alt="" /> ' . $Title . '</p>';
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Reviews overdue, or due within') . '</legend>
+		<field>
+			<label for="Days">' . __('Number of Days') . ':</label>
+			<input type="text" class="integer" name="Days" size="5" maxlength="4" value="' . $Days . '" />
+		</field>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="Show" value="' . __('Show') . '" />
+		<input type="submit" name="PrintPDF" value="' . __('Print as PDF') . '" />
+	</div>
+</form>';
+
+$Result = CreditReviewReportRows($Cutoff);
+echo '<br /><table class="selection">
+		<tr><th>' . __('Customer') . '</th><th>' . __('Review Due') . '</th><th>' . __('Currency') . '</th><th>' . __('Balance') . '</th>
+			<th>' . __('Overdue') . '</th><th>' . __('Credit Limit') . '</th><th>' . __('Credit Available') . '</th><th>' . __('Last Paid') . '</th></tr>';
+if (DB_num_rows($Result) == 0) {
+	echo '<tr><td colspan="8">' . __('No customers have a review overdue or due in this period') . '</td></tr>';
+}
+while ($MyRow = DB_fetch_array($Result)) {
+	$Overdue = ($MyRow['nextreviewdate'] === null or $MyRow['nextreviewdate'] < date('Y-m-d'));
+	echo '<tr class="striped_row">
+			<td><a href="' . $RootPath . '/CreditReviews.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . $MyRow['debtorno'] . '</a> ' . $MyRow['name'] . '</td>
+			<td>' . ($MyRow['nextreviewdate'] ? ConvertSQLDate($MyRow['nextreviewdate']) : __('Never reviewed')) . ($Overdue ? ' <b>(' . __('overdue') . ')</b>' : '') . '</td>
+			<td>' . $MyRow['currcode'] . '</td>
+			<td class="number">' . locale_number_format($MyRow['balance'], $MyRow['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($MyRow['overdue'], $MyRow['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($MyRow['creditlimit'], $MyRow['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format(GetCreditAvailable($MyRow['debtorno']), $MyRow['decimalplaces']) . '</td>
+			<td>' . ($MyRow['lastpaiddate'] ? ConvertSQLDate(mb_substr($MyRow['lastpaiddate'], 0, 10)) : '') . '</td>
+		</tr>';
+}
+echo '</table>';
+
+include('includes/footer.php');
diff --git a/CreditReviews.php b/CreditReviews.php
new file mode 100644
index 0000000..e316b27
--- /dev/null
+++ b/CreditReviews.php
@@ -0,0 +1,323 @@
+<?php
+
+/* Credit reviews of a customer: the history of reviews newest first and, for the credit controller, entering a review
+ * (which can change the credit limit and the credit status of the account at the same moment) or correcting a review
+ * entered by mistake */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Customer Credit Reviews');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditReviews';
+include('includes/header.php');
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+} elseif (isset($_SESSION['CustomerID'])) {
+	$DebtorNo = $_SESSION['CustomerID'];
+} else {
+	$DebtorNo = '';
+}
+
+if ($DebtorNo == '' or !CreditControlCanSeeCustomer($DebtorNo)) {
+	prnMsg(__('To see credit reviews a customer must first be selected from the customer selection screen'), 'info');
+	echo '<br /><div class="centre"><a href="', $RootPath, '/SelectCustomer.php">', __('Select a Customer'), '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+$_SESSION['CustomerID'] = $DebtorNo;
+$IsController = CreditControlIsController();
+
+$SQL = "SELECT debtorsmaster.name,
+				debtorsmaster.creditlimit,
+				debtorsmaster.holdreason,
+				debtorsmaster.nextreviewdate,
+				debtorsmaster.currcode,
+				currencies.decimalplaces,
+				holdreasons.reasondescription,
+				holdreasons.dissallowinvoices
+		FROM debtorsmaster
+		INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+		INNER JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+		WHERE debtorsmaster.debtorno='" . $DebtorNo . "'";
+$Result = DB_query($SQL);
+$Customer = DB_fetch_array($Result);
+
+$Interval = (int) ($_SESSION['CreditReviewInterval'] ?? 12);
+$InputError = 0;
+
+function CreditReviewIsDate($Date) {
+	return (preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $Date, $Parts) and checkdate((int) $Parts[2], (int) $Parts[3], (int) $Parts[1]));
+}
+
+if ($IsController and isset($_POST['SaveReview'])) {
+
+	$ReviewDate = $_POST['ReviewDate'];
+	$Outcome = $_POST['Outcome'];
+	$NewLimit = filter_number_format($_POST['NewLimit']);
+	$NewHold = (int) $_POST['NewHold'];
+	$NextReview = $_POST['NextReviewDate'];
+	$Comments = trim($_POST['Comments']);
+
+	if (!CreditReviewIsDate($ReviewDate)) {
+		$InputError = 1;
+		prnMsg(__('The review date must be a valid date'), 'error');
+	}
+	if (!in_array($Outcome, array('keep', 'raise', 'lower', 'hold', 'watch', 'release'))) {
+		$InputError = 1;
+		prnMsg(__('The outcome of the review must be selected'), 'error');
+	}
+	if (!is_numeric($NewLimit) or $NewLimit < 0) {
+		$InputError = 1;
+		prnMsg(__('The credit limit must be a number that is not negative'), 'error');
+	}
+	if (!CreditReviewIsDate($NextReview) or (CreditReviewIsDate($ReviewDate) and $NextReview <= $ReviewDate)) {
+		$InputError = 1;
+		prnMsg(__('The date the next review is due must be a valid date after the date of this review'), 'error');
+	}
+	if ($Comments == '') {
+		$InputError = 1;
+		prnMsg(__('Comments must be entered - they record why the decision was made'), 'error');
+	}
+	if (mb_strlen($Comments) > 60000) {
+		$InputError = 1;
+		prnMsg(__('The comments are too long'), 'error');
+	}
+
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+		/* lock the account so that the old values recorded are the ones that are replaced */
+		$Result = DB_query("SELECT creditlimit, holdreason, nextreviewdate FROM debtorsmaster WHERE debtorno='" . $DebtorNo . "' FOR UPDATE", '', '', true);
+		$Old = DB_fetch_array($Result);
+
+		$HoldState = null;
+		if (in_array($Outcome, array('hold', 'watch', 'release'))) {
+			$Result = DB_query("SELECT dissallowinvoices FROM holdreasons WHERE reasoncode='" . $NewHold . "'", '', '', true);
+			$Row = DB_fetch_row($Result);
+			$Wanted = array('hold' => 1, 'watch' => 2, 'release' => 0);
+			if (!$Row or $Row[0] != $Wanted[$Outcome]) {
+				$InputError = 1;
+				prnMsg(__('The credit status chosen does not match the outcome of the review'), 'error');
+			}
+		} else {
+			$NewHold = (int) $Old['holdreason']; // keep, raise and lower leave the credit status as it is
+		}
+		if ($Outcome == 'raise' and $NewLimit <= $Old['creditlimit']) {
+			$InputError = 1;
+			prnMsg(__('To raise the limit the new limit must be higher than the current limit'), 'error');
+		}
+		if ($Outcome == 'lower' and $NewLimit >= $Old['creditlimit']) {
+			$InputError = 1;
+			prnMsg(__('To lower the limit the new limit must be lower than the current limit'), 'error');
+		}
+		if ($Outcome == 'keep') {
+			$NewLimit = $Old['creditlimit'];
+		}
+
+		if ($InputError == 0) {
+			$SQL = "INSERT INTO custcreditreviews (debtorno, reviewdate, reviewedby, outcome, oldcreditlimit, newcreditlimit,
+								oldholdreason, newholdreason, oldnextreviewdate, nextreviewdate, comments, inputdate)
+					VALUES ('" . $DebtorNo . "',
+							'" . $ReviewDate . "',
+							'" . $_SESSION['UserID'] . "',
+							'" . $Outcome . "',
+							'" . $Old['creditlimit'] . "',
+							'" . $NewLimit . "',
+							'" . $Old['holdreason'] . "',
+							'" . $NewHold . "',
+							" . ($Old['nextreviewdate'] ? "'" . $Old['nextreviewdate'] . "'" : 'NULL') . ",
+							'" . $NextReview . "',
+							'" . $Comments . "',
+							'" . date('Y-m-d H:i:s') . "')";
+			DB_query($SQL, __('The credit review could not be saved because'), '', true);
+
+			$SQL = "UPDATE debtorsmaster SET creditlimit='" . $NewLimit . "',
+											holdreason='" . $NewHold . "',
+											nextreviewdate='" . $NextReview . "'
+					WHERE debtorno='" . $DebtorNo . "'";
+			DB_query($SQL, __('The customer account could not be updated because'), '', true);
+			DB_Txn_Commit();
+			prnMsg(__('The credit review has been saved and the customer account updated'), 'success');
+			unset($_POST['Comments']);
+		} else {
+			DB_Txn_Rollback();
+		}
+	}
+
+} elseif ($IsController and isset($_POST['VoidReview'])) {
+
+	$ReviewID = (int) $_POST['ReviewID'];
+	$VoidReason = trim($_POST['VoidReason']);
+	if ($VoidReason == '') {
+		prnMsg(__('A reason for correcting the review must be entered'), 'error');
+	} else {
+		DB_Txn_Begin();
+		$Result = DB_query("SELECT * FROM custcreditreviews WHERE id='" . $ReviewID . "' AND debtorno='" . $DebtorNo . "' FOR UPDATE", '', '', true);
+		$Review = DB_fetch_array($Result);
+		$Result = DB_query("SELECT creditlimit, holdreason, nextreviewdate FROM debtorsmaster WHERE debtorno='" . $DebtorNo . "' FOR UPDATE", '', '', true);
+		$Now = DB_fetch_array($Result);
+		$Result = DB_query("SELECT MAX(id) FROM custcreditreviews WHERE debtorno='" . $DebtorNo . "' AND voided=0", '', '', true);
+		$Latest = DB_fetch_row($Result);
+
+		if (!$Review or $Review['voided'] == 1) {
+			DB_Txn_Rollback();
+			prnMsg(__('That review does not exist or has already been corrected'), 'error');
+		} elseif ($Latest[0] == $Review['id'] and ($Now['creditlimit'] != $Review['newcreditlimit'] or $Now['holdreason'] != $Review['newholdreason'])) {
+			DB_Txn_Rollback();
+			prnMsg(__('The limit or credit status of the account has been changed since this review, so it cannot be corrected here. Enter a new review instead'), 'error');
+		} else {
+			DB_query("UPDATE custcreditreviews SET voided=1,
+												voidedby='" . $_SESSION['UserID'] . "',
+												voideddate='" . date('Y-m-d H:i:s') . "',
+												voidreason='" . mb_substr($VoidReason, 0, 255) . "'
+					WHERE id='" . $ReviewID . "'", '', '', true);
+			if ($Latest[0] == $Review['id']) {
+				/* the latest review is withdrawn so the account goes back to how it was before it */
+				DB_query("UPDATE debtorsmaster SET creditlimit='" . $Review['oldcreditlimit'] . "',
+												holdreason='" . $Review['oldholdreason'] . "',
+												nextreviewdate=" . ($Review['oldnextreviewdate'] ? "'" . $Review['oldnextreviewdate'] . "'" : 'NULL') . "
+						WHERE debtorno='" . $DebtorNo . "'", '', '', true);
+			}
+			DB_Txn_Commit();
+			prnMsg(__('The review has been marked as entered by mistake') . ($Latest[0] == $Review['id'] ? ' ' . __('and the account is back to how it was before it') : ''), 'success');
+		}
+	}
+}
+
+/* reload the account as it may just have changed */
+$Result = DB_query($SQL = "SELECT debtorsmaster.creditlimit, debtorsmaster.holdreason, debtorsmaster.nextreviewdate,
+								holdreasons.reasondescription, holdreasons.dissallowinvoices
+							FROM debtorsmaster INNER JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+							WHERE debtorsmaster.debtorno='" . $DebtorNo . "'");
+$Customer = array_merge($Customer, DB_fetch_array($Result));
+$DecimalPlaces = $Customer['decimalplaces'];
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="" alt="" /> ' . $Title . ' - ' . $DebtorNo . ' ' . $Customer['name'] . '</p>';
+
+$StateText = array(0 => __('Invoicing allowed'), 1 => __('ON HOLD - no invoicing'), 2 => __('Watch - staff are warned'));
+echo '<table class="selection">
+		<tr><th>' . __('Credit Limit') . '</th><th>' . __('Credit Status') . '</th><th>' . __('Next Review Due') . '</th></tr>
+		<tr><td class="number">' . locale_number_format($Customer['creditlimit'], $DecimalPlaces) . ' ' . $Customer['currcode'] . '</td>
+			<td>' . $Customer['reasondescription'] . ' (' . $StateText[$Customer['dissallowinvoices']] . ')</td>
+			<td>' . ($Customer['nextreviewdate'] ? ConvertSQLDate($Customer['nextreviewdate']) : __('Never reviewed')) . '</td></tr>
+	</table><br />';
+
+if ($IsController) {
+	$StatusOptions = array(0 => '', 1 => '', 2 => '');

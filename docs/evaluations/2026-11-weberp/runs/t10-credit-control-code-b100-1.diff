+<?php
+
+/* Prints, as PDF, a reminder letter that was sent to a customer, as it was sent */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/CreditControlFunctions.php');
+include('includes/SetDomPDFOptions.php');
+
+$ReminderID = isset($_GET['ReminderID']) ? (int) $_GET['ReminderID'] : 0;
+
+$Result = DB_query("SELECT custreminders.*, debtorsmaster.name, debtorsmaster.address1, debtorsmaster.address2, debtorsmaster.address3,
+						debtorsmaster.address4, debtorsmaster.address5, debtorsmaster.address6, currencies.decimalplaces
+					FROM custreminders
+					INNER JOIN debtorsmaster ON custreminders.debtorno=debtorsmaster.debtorno
+					INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+					WHERE custreminders.id='" . $ReminderID . "' " . CreditControlCustomerScopeSQL());
+$Reminder = DB_fetch_array($Result);
+
+if (!$Reminder) {
+	$Title = __('Reminder Letter');
+	include('includes/header.php');
+	prnMsg(__('That reminder does not exist or you are not permitted to see it'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$Lines = array();
+$Result = DB_query("SELECT debtortrans.transno, debtortrans.trandate, custreminderlines.balance, custreminderlines.dayspastdue
+					FROM custreminderlines INNER JOIN debtortrans ON custreminderlines.debtortransid=debtortrans.id
+					WHERE custreminderlines.reminderid='" . $ReminderID . "' " . CreditControlTransactionScopeSQL() . "
+					ORDER BY debtortrans.transno");
+while ($MyRow = DB_fetch_array($Result)) {
+	$Lines[] = $MyRow;
+}
+
+$Debtor = array('debtorno' => $Reminder['debtorno'], 'name' => $Reminder['name']);
+foreach (array('address1', 'address2', 'address3', 'address4', 'address5', 'address6') as $Line) {
+	$Debtor[$Line] = $Reminder[$Line];
+}
+$HTML = CreditControlReminderHTML($Debtor, $Reminder['wording'], $Reminder['lettertext'], $Lines, $Reminder['currcode'], $Reminder['decimalplaces'], $Reminder['sentdate']);
+$DomPDF = CreditControlRenderPDF($HTML);
+$DomPDF->stream($_SESSION['DatabaseName'] . '_Reminder_' . $Reminder['debtorno'] . '_' . mb_substr($Reminder['sentdate'], 0, 10) . '.pdf', array('Attachment' => false));
diff --git a/PrintCustCharge.php b/PrintCustCharge.php
new file mode 100644
index 0000000..942a1a7
--- /dev/null
+++ b/PrintCustCharge.php
@@ -0,0 +1,70 @@
+<?php
+
+/* Prints as PDF, or emails to the customer contacts that receive statements, a late payment charge or a bad debt
+ * write-off, like an invoice */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/CreditControlFunctions.php');
+include('includes/SetDomPDFOptions.php');
+
+$Type = isset($_GET['Type']) ? (int) $_GET['Type'] : 0;
+$TransNo = isset($_GET['TransNo']) ? (int) $_GET['TransNo'] : 0;
+
+$Result = DB_query("SELECT debtortrans.*, systypes.typename, debtorsmaster.name, debtorsmaster.address1, debtorsmaster.address2, debtorsmaster.address3,
+						debtorsmaster.address4, debtorsmaster.address5, debtorsmaster.address6, debtorsmaster.currcode, currencies.decimalplaces
+					FROM debtortrans
+					INNER JOIN systypes ON debtortrans.type=systypes.typeid
+					INNER JOIN debtorsmaster ON debtortrans.debtorno=debtorsmaster.debtorno
+					INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+					WHERE debtortrans.type='" . $Type . "'
+						AND debtortrans.type IN (" . CREDIT_CONTROL_TYPE_CHARGE . ", " . CREDIT_CONTROL_TYPE_WRITEOFF . ")
+						AND debtortrans.transno='" . $TransNo . "' " . CreditControlCustomerScopeSQL() . CreditControlTransactionScopeSQL());
+$Trans = DB_fetch_array($Result);
+
+if (!$Trans) {
+	$Title = __('Print');
+	include('includes/header.php');
+	prnMsg(__('That transaction does not exist or you are not permitted to see it'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$HTML = '<!DOCTYPE html><html><head><meta charset="utf-8" />' . CreditControlPDFStyle() . '</head><body>';
+$HTML .= CreditControlLetterhead();
+$HTML .= '<p>' . ConvertSQLDate($Trans['trandate']) . '</p><p>' . $Trans['name'] . '<br />';
+foreach (array('address1', 'address2', 'address3', 'address4', 'address5', 'address6') as $Line) {
+	if ($Trans[$Line] != '') {
+		$HTML .= $Trans[$Line] . '<br />';
+	}
+}
+$Title = ($Type == CREDIT_CONTROL_TYPE_CHARGE) ? __('Late Payment Charge') : __('Bad Debt Write-off');
+$HTML .= '</p><div class="header">' . $Title . ' ' . __('Number') . ' ' . $Trans['transno'] . ' - ' . __('Account') . ' ' . $Trans['debtorno'] . '</div>';
+$HTML .= '<p>' . nl2br((string) $Trans['invtext']) . '</p>';
+$HTML .= '<table><tr><th>' . __('Description') . '</th><th class="right">' . __('Amount') . ' (' . $Trans['currcode'] . ')</th></tr>
+		<tr><td>' . $Title . '</td><td class="right">' . locale_number_format($Trans['ovamount'] + $Trans['ovgst'], $Trans['decimalplaces']) . '</td></tr></table>';
+$HTML .= '<p class="small">' . __('Quoting your account reference') . ' ' . $Trans['debtorno'] . '</p></body></html>';
+$DomPDF = CreditControlRenderPDF($HTML);
+$PdfFileName = $_SESSION['DatabaseName'] . '_' . str_replace(' ', '_', $Title) . '_' . $Trans['transno'] . '_' . date('Y-m-d') . '.pdf';
+
+if (isset($_GET['Email']) and CreditControlCustomerLoginDebtor() === null) {
+	$Recipients = array();
+	$ContactResult = DB_query("SELECT email FROM custcontacts WHERE statement=1 AND debtorno='" . $Trans['debtorno'] . "'");
+	while ($Contact = DB_fetch_row($ContactResult)) {
+		if (IsEmailAddress($Contact[0])) {
+			$Recipients[$Contact[0]] = '';
+		}
+	}
+	include('includes/header.php');
+	if (count($Recipients) == 0) {
+		prnMsg(__('There is no contact that receives statements with an email address, so nothing was sent'), 'error');
+	} else {
+		$TempFile = sys_get_temp_dir() . '/' . uniqid() . '_' . $PdfFileName;
+		file_put_contents($TempFile, $DomPDF->output());
+		$Sent = SendEmailFromWebERP($_SESSION['CompanyRecord']['email'], $Recipients, $Title . ' ' . $Trans['transno'],
+			__('Please find attached the') . ' ' . $Title . ' ' . $Trans['transno'], array($TempFile));
+		@unlink($TempFile);
+	}
+	include('includes/footer.php');
+} else {
+	$DomPDF->stream($PdfFileName, array('Attachment' => false));
+}

diff --git a/BadDebtWriteOff.php b/BadDebtWriteOff.php
new file mode 100644
index 0000000..cf9de03
--- /dev/null
+++ b/BadDebtWriteOff.php
@@ -0,0 +1,197 @@
+<?php
+
+/* Bad debt write-off: writes off what is left on chosen invoices of a customer, or the whole balance, with a reason.
+ * The write-off is a customer transaction (type 71) allocated to the invoices it clears, and posts to the bad debt
+ * expense account chosen in the company preferences with the debtors control account on the other side. For a foreign
+ * currency customer the difference between the rate of the invoice and the rate of the write-off is posted to the sales
+ * exchange variances account, as it is for receipts */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/SQL_CommonFunctions.php');
+include('includes/GLFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$ViewTopic = 'CreditControl';
+$BookMark = 'BadDebtWriteOff';
+$Title = __('Bad Debt Write-off');
+
+$DebtorNo = $_POST['DebtorNo'] ?? ($_GET['DebtorNo'] ?? ($_SESSION['CustomerID'] ?? ''));
+
+$Accounts = CreditControlGetAccounts();
+$AccountError = '';
+if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+	$AccountError = CreditControlCheckAccount($Accounts['baddebtact'], $Accounts, __('bad debt expense account'));
+}
+
+$Customer = false;
+if ($DebtorNo != '') {
+	$Result = DB_query("SELECT debtorsmaster.debtorno, debtorsmaster.name, debtorsmaster.currcode, debtorsmaster.salestype,
+							currencies.decimalplaces, currencies.rate
+						FROM debtorsmaster INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+						WHERE debtorsmaster.debtorno='" . $DebtorNo . "'");
+	$Customer = DB_fetch_array($Result);
+}
+
+$Done = '';
+if ($Customer and isset($_POST['WriteOff'])) {
+
+	$Reason = trim($_POST['Reason']);
+	$Selected = (isset($_POST['Invoice']) and is_array($_POST['Invoice'])) ? array_map('intval', $_POST['Invoice']) : array();
+	if ($AccountError != '') {
+		prnMsg($AccountError, 'error');
+	} elseif ($Reason == '') {
+		prnMsg(__('A reason for the write-off must be entered'), 'error');
+	} elseif (count($Selected) == 0 and !isset($_POST['WholeBalance'])) {
+		prnMsg(__('Choose the invoices to write off, or write off the whole balance'), 'error');
+	} else {
+		DB_Txn_Begin();
+		DB_query("SELECT debtorno FROM debtorsmaster WHERE debtorno='" . $DebtorNo . "' FOR UPDATE", '', '', true);
+		/* the invoices are read again, locked, so that what is written off is what is left on them now */
+		$SQL = "SELECT id, type, transno, rate, balance
+				FROM debtortrans
+				WHERE debtorno='" . $DebtorNo . "'
+					AND type IN (10, " . CREDIT_CONTROL_TYPE_CHARGE . ")
+					AND balance > " . CurrencyTolerance($Customer['currcode']);
+		if (!isset($_POST['WholeBalance'])) {
+			$SQL .= " AND id IN (" . implode(',', $Selected) . ")";
+		}
+		$SQL .= " ORDER BY trandate, id FOR UPDATE";
+		$Result = DB_query($SQL, '', '', true);
+		$Invoices = array();
+		$Total = 0;
+		while ($MyRow = DB_fetch_array($Result)) {
+			$MyRow['balance'] = round($MyRow['balance'], $Customer['decimalplaces']);
+			$Invoices[] = $MyRow;
+			$Total += $MyRow['balance'];
+		}
+		if (count($Invoices) == 0) {
+			DB_Txn_Rollback();
+			prnMsg(__('There is nothing left to write off on the invoices chosen'), 'error');
+		} else {
+			$PeriodNo = GetPeriod(date($_SESSION['DefaultDateFormat']));
+			$TransNo = GetNextTransNo(CREDIT_CONTROL_TYPE_WRITEOFF);
+			$Branch = CreditControlFirstBranch($DebtorNo);
+			$WriteOffRate = $Customer['rate'];
+			$Today = date('Y-m-d');
+			DB_query("INSERT INTO debtortrans (transno, type, debtorno, branchcode, trandate, inputdate, prd, settled, reference, tpe, order_, rate,
+								ovamount, ovgst, ovfreight, ovdiscount, diffonexch, alloc, invtext, shipvia, edisent, consignment, packages, salesperson)
+					VALUES ('" . $TransNo . "', '" . CREDIT_CONTROL_TYPE_WRITEOFF . "', '" . $DebtorNo . "', '" . ($Branch['branchcode'] ?? '') . "', '" . $Today . "',
+							'" . date('Y-m-d H:i:s') . "', '" . $PeriodNo . "', 1, 'WRITEOFF', '" . $Customer['salestype'] . "', 0, '" . $WriteOffRate . "',
+							'" . -$Total . "', 0, 0, 0, 0, '" . -$Total . "', '" . $Reason . "', 0, 0, '', 1, '" . ($Branch['salesman'] ?? '') . "')",
+				__('The write-off could not be saved because'), '', true);
+			$WriteOffID = DB_Last_Insert_ID('debtortrans', 'id');
+
+			$TotalDiffOnExch = 0;
+			foreach ($Invoices as $Invoice) {
+				/* difference on exchange is worked out as the allocation of a receipt does: a gain is positive */
+				$Diff = $Invoice['balance'] / $WriteOffRate - $Invoice['balance'] / $Invoice['rate'];
+				$TotalDiffOnExch += $Diff;
+				DB_query("INSERT INTO custallocns (datealloc, amt, transid_allocfrom, transid_allocto)
+						VALUES ('" . $Today . "', '" . $Invoice['balance'] . "', '" . $WriteOffID . "', '" . $Invoice['id'] . "')", '', '', true);
+				DB_query("UPDATE debtortrans SET alloc = alloc + " . $Invoice['balance'] . ",
+												diffonexch = diffonexch + " . $Diff . ",
+												settled = 1
+						WHERE id='" . $Invoice['id'] . "'", '', '', true);
+			}
+			DB_query("UPDATE debtortrans SET diffonexch='" . -$TotalDiffOnExch . "' WHERE id='" . $WriteOffID . "'", '', '', true);
+			DB_query("INSERT INTO custwriteoffs (debtorno, debtortransid, amount, reason, writtenoffby, writeoffdate)
+					VALUES ('" . $DebtorNo . "', '" . $WriteOffID . "', '" . $Total . "', '" . $Reason . "', '" . $_SESSION['UserID'] . "', '" . date('Y-m-d H:i:s') . "')", '', '', true);
+
+			if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+				$Tags = (isset($_POST['tag']) and is_array($_POST['tag'])) ? $_POST['tag'] : array();
+				$HomeAmount = $Total / $WriteOffRate;
+				$Narrative = mb_substr($DebtorNo . ' ' . __('Bad debt write-off') . ' ' . $Reason, 0, 200);
+				$ErrMsg = __('Cannot insert a GL entry for the write-off because');
+				DB_query("INSERT INTO gltrans (type, typeno, trandate, periodno, account, narrative, amount)
+						VALUES ('" . CREDIT_CONTROL_TYPE_WRITEOFF . "', '" . $TransNo . "', '" . $Today . "', '" . $PeriodNo . "',
+								'" . $Accounts['baddebtact'] . "', '" . $Narrative . "', '" . $HomeAmount . "')", $ErrMsg, '', true);
+				InsertGLTags($Tags);
+				DB_query("INSERT INTO gltrans (type, typeno, trandate, periodno, account, narrative, amount)
+						VALUES ('" . CREDIT_CONTROL_TYPE_WRITEOFF . "', '" . $TransNo . "', '" . $Today . "', '" . $PeriodNo . "',
+								'" . $Accounts['debtorsact'] . "', '" . $Narrative . "', '" . -$HomeAmount . "')", $ErrMsg, '', true);
+				$MovtInDiffOnExch = -$TotalDiffOnExch;
+				if (abs($MovtInDiffOnExch) > 0.00001) {
+					DB_query("INSERT INTO gltrans (type, typeno, trandate, periodno, account, narrative, amount)
+							VALUES ('" . CREDIT_CONTROL_TYPE_WRITEOFF . "', '" . $TransNo . "', '" . $Today . "', '" . $PeriodNo . "',
+									'" . $_SESSION['CompanyRecord']['salesexchangediffact'] . "', '', '" . $MovtInDiffOnExch . "')", $ErrMsg, '', true);
+					DB_query("INSERT INTO gltrans (type, typeno, trandate, periodno, account, narrative, amount)
+							VALUES ('" . CREDIT_CONTROL_TYPE_WRITEOFF . "', '" . $TransNo . "', '" . $Today . "', '" . $PeriodNo . "',
+									'" . $Accounts['debtorsact'] . "', '', '" . -$MovtInDiffOnExch . "')", $ErrMsg, '', true);
+				}
+			}
+			DB_Txn_Commit();
+			$Done = __('Write-off number') . ' <a target="_blank" href="' . $RootPath . '/PrintCustCharge.php?Type=' . CREDIT_CONTROL_TYPE_WRITEOFF . '&amp;TransNo=' . $TransNo . '">' . $TransNo . '</a> '
+				. __('has been posted for') . ' ' . locale_number_format($Total, $Customer['decimalplaces']) . ' ' . $Customer['currcode'] . ' ' . __('and the invoices have been cleared');
+		}
+	}
+}
+
+include('includes/header.php');
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/money_delete.png" title="" alt="" /> ' . $Title . '</p>';
+if ($Done != '') {
+	prnMsg($Done, 'success');
+}
+if ($AccountError != '') {
+	prnMsg($AccountError, 'error');
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Customer') . '</legend>
+		<field>
+			<label for="DebtorNo">' . __('Customer Code') . ':</label>
+			<input type="text" name="DebtorNo" value="' . $DebtorNo . '" size="12" maxlength="10" required="required" />
+			<a href="' . $RootPath . '/SelectCustomer.php">' . __('Find a customer') . '</a>
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Show" value="' . __('Show Open Invoices') . '" /></div>';
+
+if ($DebtorNo != '' and !$Customer) {
+	prnMsg(__('That customer does not exist'), 'error');
+} elseif ($Customer) {
+	echo '<p>' . $Customer['debtorno'] . ' ' . $Customer['name'] . ' (' . $Customer['currcode'] . ')</p>';
+	$Result = DB_query("SELECT debtortrans.id, debtortrans.type, debtortrans.transno, debtortrans.trandate, debtortrans.balance, systypes.typename
+						FROM debtortrans INNER JOIN systypes ON debtortrans.type=systypes.typeid
+						WHERE debtortrans.debtorno='" . $DebtorNo . "'
+							AND debtortrans.type IN (10, " . CREDIT_CONTROL_TYPE_CHARGE . ")
+							AND debtortrans.balance > " . CurrencyTolerance($Customer['currcode']) . "
+						ORDER BY debtortrans.trandate, debtortrans.id");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('This customer has no open invoices to write off'), 'info');
+	} else {
+		echo '<table class="selection"><tr><th>' . __('Write Off') . '</th><th>' . __('Type') . '</th><th>' . __('Number') . '</th><th>' . __('Date') . '</th><th>' . __('Left to Pay') . '</th></tr>';
+		$Total = 0;
+		while ($MyRow = DB_fetch_array($Result)) {
+			$Total += $MyRow['balance'];
+			echo '<tr class="striped_row"><td><input type="checkbox" name="Invoice[]" value="' . $MyRow['id'] . '" /></td>
+					<td>' . __($MyRow['typename']) . '</td><td>' . $MyRow['transno'] . '</td><td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+					<td class="number">' . locale_number_format($MyRow['balance'], $Customer['decimalplaces']) . '</td></tr>';
+		}
+		echo '<tr><th colspan="4">' . __('Total of open invoices') . '</th><th class="number">' . locale_number_format($Total, $Customer['decimalplaces']) . '</th></tr></table>
+			<fieldset>
+				<field>
+					<label for="WholeBalance">' . __('Write off the whole balance') . ':</label>
+					<input type="checkbox" name="WholeBalance" />
+					<fieldhelp>' . __('Writes off everything left on all the open invoices above, whatever is ticked. Unallocated receipts and credit notes are not touched: allocate them first') . '</fieldhelp>
+				</field>
+				<field>
+					<label for="Reason">' . __('Reason') . ':</label>
+					<textarea name="Reason" required="required" rows="4" cols="60"></textarea>
+				</field>
+				<field>
+					<label for="tag[]">' . __('Select Tag(s)') . ':</label>
+					<select multiple="multiple" name="tag[]">';
+		$TagResult = DB_query("SELECT tagref, tagdescription FROM tags ORDER BY tagref");
+		while ($MyRow = DB_fetch_array($TagResult)) {
+			echo '<option value="' . $MyRow['tagref'] . '">' . $MyRow['tagref'] . ' - ' . $MyRow['tagdescription'] . '</option>';
+		}
+		echo '</select>
+				</field>
+			</fieldset>
+			<div class="centre"><input type="submit" name="WriteOff" value="' . __('Write Off as Bad Debt') . '" onclick="return confirm(\'' . __('Write off the amounts chosen as bad debt? This cannot be undone') . '\');" /></div>';
+	}
+}
+echo '</form>';
+
+include('includes/footer.php');

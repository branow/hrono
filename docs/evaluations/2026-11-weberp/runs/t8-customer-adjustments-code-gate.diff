diff --git a/CustomerSmallBalanceWriteOff.php b/CustomerSmallBalanceWriteOff.php
new file mode 100644
index 0000000..87549d0
--- /dev/null
+++ b/CustomerSmallBalanceWriteOff.php
@@ -0,0 +1,211 @@
+<?php
+
+/* Clean-up of small balances: every customer invoice left open with less than the amount chosen is written off.
+The amount is in the functional (home) currency - the balance of an invoice in a customer's currency is converted at the rate of the invoice.
+The invoices are listed first, nothing is written off until the list is confirmed. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CustomerAdjustmentFunctions.php');
+
+$Title = __('Write Off Small Customer Balances');
+$ViewTopic = 'ARTransactions';
+$BookMark = 'CustomerSmallBalanceWriteOff';
+
+if (isset($_POST['AdjDate'])) {
+	$_POST['AdjDate'] = ConvertSQLDate($_POST['AdjDate']);
+}
+
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/transactions.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+if (!isset($_POST['AdjDate']) or !Is_Date($_POST['AdjDate'])) {
+	$_POST['AdjDate'] = date($_SESSION['DefaultDateFormat']);
+}
+
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$HomeDecimalPlaces = $_SESSION['CompanyRecord']['decimalplaces'];
+
+/* Invoices open with less than the amount (in functional currency) */
+function SmallBalanceInvoices($Threshold) {
+	$SQL = "SELECT debtortrans.id,
+					debtortrans.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					currencies.decimalplaces,
+					debtortrans.transno,
+					debtortrans.trandate,
+					debtortrans.balance,
+					debtortrans.balance / debtortrans.rate AS localbalance
+			FROM debtortrans
+			INNER JOIN debtorsmaster
+				ON debtortrans.debtorno = debtorsmaster.debtorno
+			INNER JOIN currencies
+				ON debtorsmaster.currcode = currencies.currabrev
+			WHERE debtortrans.type = 10
+			AND debtortrans.settled = 0
+			AND debtortrans.balance > 0
+			AND debtortrans.balance / debtortrans.rate < '" . $Threshold . "'
+			ORDER BY debtortrans.debtorno, debtortrans.trandate, debtortrans.transno";
+	return DB_query($SQL);
+}
+
+$InputError = 0;
+if (isset($_POST['Preview']) or isset($_POST['WriteOff'])) {
+
+	$Threshold = filter_number_format($_POST['Threshold']);
+	if (!is_numeric($Threshold) or $Threshold <= 0) {
+		prnMsg(__('The amount must be a number greater than zero'), 'error');
+		$InputError = 1;
+	}
+	if (!Is_Date($_POST['AdjDate'])) {
+		prnMsg(__('The date of the adjustment is not a valid date'), 'error');
+		$InputError = 1;
+	}
+	$Reason = trim($_POST['Reason']);
+	if ($Reason == '') {
+		prnMsg(__('A reason for the write off must be entered'), 'error');
+		$InputError = 1;
+	}
+	$GLAccount = isset($_POST['GLAccount']) ? $_POST['GLAccount'] : '';
+	$GLError = CustomerAdjustmentCheckGLAccount($GLAccount);
+	if ($GLError != '') {
+		prnMsg($GLError, 'error');
+		$InputError = 1;
+	}
+}
+
+if (isset($_POST['WriteOff']) and $InputError == 0) {
+
+	DB_Txn_Begin();
+	$Result = SmallBalanceInvoices($Threshold);
+	$Count = 0;
+	$Total = 0;
+	$Failed = '';
+	while ($MyRow = DB_fetch_array($Result)) {
+		$WriteOff = WriteOffCustomerInvoice($MyRow['id'], $_POST['AdjDate'], $Reason, $GLAccount);
+		if (isset($WriteOff['error'])) {
+			$Failed = $WriteOff['error'];
+			break;
+		}
+		$Count++;
+		$Total += $MyRow['localbalance'];
+	}
+	if ($Failed != '') {
+		DB_Txn_Rollback();
+		prnMsg($Failed . ' - ' . __('nothing has been written off'), 'error');
+	} else {
+		DB_Txn_Commit();
+		prnMsg($Count . ' ' . __('invoices have been written off for a total of') . ' ' . locale_number_format($Total, $HomeDecimalPlaces) . ' ' . $HomeCurrency, 'success');
+	}
+	unset($_POST['Threshold'], $_POST['Reason'], $_POST['Preview']);
+	$InputError = 1; // do not show the list again
+}
+
+if (isset($_POST['Preview']) and $InputError == 0) {
+
+	$Result = SmallBalanceInvoices($Threshold);
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('There are no open invoices with a balance less than') . ' ' . locale_number_format($Threshold, $HomeDecimalPlaces) . ' ' . $HomeCurrency, 'info');
+	} else {
+		echo '<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<input type="hidden" name="Threshold" value="' . $_POST['Threshold'] . '" />
+			<input type="hidden" name="AdjDate" value="' . FormatDateForSQL($_POST['AdjDate']) . '" />
+			<input type="hidden" name="Reason" value="' . $_POST['Reason'] . '" />
+			<input type="hidden" name="GLAccount" value="' . $GLAccount . '" />
+			<table class="selection">
+			<tr><th colspan="7">' . __('Invoices to be written off') . '</th></tr>
+			<tr>
+				<th>' . __('Customer') . '</th>
+				<th>' . __('Name') . '</th>
+				<th>' . __('Invoice') . '</th>
+				<th>' . __('Date') . '</th>
+				<th>' . __('Balance') . '</th>
+				<th>' . __('Currency') . '</th>
+				<th>' . $HomeCurrency . '</th>
+			</tr>';
+		$Total = 0;
+		while ($MyRow = DB_fetch_array($Result)) {
+			echo '<tr class="striped_row">
+					<td>' . $MyRow['debtorno'] . '</td>
+					<td>' . $MyRow['name'] . '</td>
+					<td class="number">' . $MyRow['transno'] . '</td>
+					<td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+					<td class="number">' . locale_number_format($MyRow['balance'], $MyRow['decimalplaces']) . '</td>
+					<td>' . $MyRow['currcode'] . '</td>
+					<td class="number">' . locale_number_format($MyRow['localbalance'], $HomeDecimalPlaces) . '</td>
+				</tr>';
+			$Total += $MyRow['localbalance'];
+		}
+		echo '<tr>
+				<td colspan="6" class="number"><b>' . __('Total') . '</b></td>
+				<td class="number"><b>' . locale_number_format($Total, $HomeDecimalPlaces) . '</b></td>
+			</tr>
+			</table>
+			<br />
+			<div class="centre">
+				<input type="submit" name="WriteOff" value="' . __('Write Off All These Invoices') . '" />
+				<input type="submit" name="Cancel" value="' . __('Cancel') . '" />
+			</div>
+			</form>';
+		include('includes/footer.php');
+		exit();
+	}
+}
+
+/* GL accounts the write offs can be posted to */
+$GLSelect = '';
+if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+	$GLSelect = '<field>
+			<label for="GLAccount">' . __('GL Account') . ':</label>
+			<select required="required" name="GLAccount">
+				<option value=""></option>';
+	$SQL = "SELECT chartmaster.accountcode,
+					chartmaster.accountname
+			FROM chartmaster
+			INNER JOIN glaccountusers
+				ON glaccountusers.accountcode = chartmaster.accountcode
+				AND glaccountusers.userid = '" . $_SESSION['UserID'] . "'
+				AND glaccountusers.canupd = 1
+			LEFT JOIN bankaccounts
+				ON bankaccounts.accountcode = chartmaster.accountcode
+			WHERE bankaccounts.accountcode IS NULL
+			AND chartmaster.accountcode <> '" . $_SESSION['CompanyRecord']['debtorsact'] . "'
+			ORDER BY chartmaster.accountcode";
+	$GLResult = DB_query($SQL);
+	while ($GLRow = DB_fetch_array($GLResult)) {
+		$GLSelect .= '<option ' . ((isset($_POST['GLAccount']) and $_POST['GLAccount'] == $GLRow['accountcode']) ? 'selected="selected" ' : '') . 'value="' . $GLRow['accountcode'] . '">' . $GLRow['accountcode'] . ' - ' . $GLRow['accountname'] . '</option>';
+	}
+	$GLSelect .= '</select>
+			<fieldhelp>' . __('The general ledger account the write offs are posted to, for example bad debts') . '</fieldhelp>
+		</field>';
+}
+
+echo '<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post">

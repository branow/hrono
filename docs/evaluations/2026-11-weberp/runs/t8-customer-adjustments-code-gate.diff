+<?php
+
+// CUSTOMER BALANCE ADJUSTMENTS AND WRITE-OFFS
+// Adjustments are posted as transaction type 15 (Journal - Debtors), which is already in systypes
+// but is not guaranteed to be in databases created long ago.
+
+NewSysType(15, 'Journal - Debtors');
+
+// Only the roles given this token can adjust or write off customer balances.
+// It is granted to the System Administrator role, others can be given it in Security Roles.
+NewSecurityToken(21, 'Customer balance adjustments and write-offs');
+
+NewScript('CustomerAdjustment.php', 21);
+NewScript('CustomerSmallBalanceWriteOff.php', 21);
+
+$Result = DB_query("SELECT secroleid FROM securityroles WHERE secroleid = 8");
+if (DB_num_rows($Result) > 0) {
+	InsertRecord('securitygroups', array('secroleid', 'tokenid'), array(8, 21), array('secroleid', 'tokenid'), array(8, 21));
+
+	// menu items are only added for the roles holding the token, so not with NewMenuItem() that adds them for all roles
+	InsertRecord('menuitems',
+		array('secroleid', 'modulelink', 'menusection', 'caption'),
+		array(8, 'AR', 'Transactions', 'Adjust or Write Off a Customer Balance'),
+		array('secroleid', 'modulelink', 'menusection', 'caption', 'url', 'sequence'),
+		array(8, 'AR', 'Transactions', 'Adjust or Write Off a Customer Balance', '/CustomerAdjustment.php', 5));
+	InsertRecord('menuitems',
+		array('secroleid', 'modulelink', 'menusection', 'caption'),
+		array(8, 'AR', 'Transactions', 'Write Off Small Customer Balances'),
+		array('secroleid', 'modulelink', 'menusection', 'caption', 'url', 'sequence'),
+		array(8, 'AR', 'Transactions', 'Write Off Small Customer Balances', '/CustomerSmallBalanceWriteOff.php', 6));
+}
+
+UpdateDBNo(basename(__FILE__, '.php'), __('Customer balance adjustments and write-offs'));

+<?php
+
+/* Functions to post customer balance adjustments (transaction type 15) and to write off what is left on customer invoices.
+
+An adjustment is a debtortrans of type 15 in the customer's currency. A positive amount increases what the customer
+owes (it behaves like an invoice), a negative amount decreases it (it behaves like a credit note and can be allocated
+to invoices in CustomerAllocations.php). When the debtors ledger is integrated with the GL the adjustment is posted
+between the debtors control account and the GL account chosen by the user.
+
+None of these functions starts or commits a database transaction - the caller must wrap them in DB_Txn_Begin() and
+DB_Txn_Commit() so that a batch is posted as a whole or not at all. */
+
+define('CUSTOMER_ADJUSTMENT_TYPE', 15);
+
+/* Truncate text already escaped for SQL without leaving a dangling backslash that would break the SQL string */
+function CustomerAdjustmentTruncate($Text, $Length) {
+	return rtrim(mb_substr($Text, 0, $Length), '\\');
+}
+
+/* Returns an empty string if the GL account can receive the adjustment, otherwise the reason it can't */
+function CustomerAdjustmentCheckGLAccount($GLAccount) {
+
+	if ($_SESSION['CompanyRecord']['gllink_debtors'] != 1) {
+		return '';
+	}
+	if ($GLAccount == '') {
+		return __('A general ledger account must be selected for the adjustment');
+	}
+	if ($GLAccount == $_SESSION['CompanyRecord']['debtorsact']) {
+		return __('The adjustment cannot be posted to the debtors control account');
+	}
+	$SQL = "SELECT chartmaster.accountcode
+			FROM chartmaster
+			INNER JOIN glaccountusers
+				ON glaccountusers.accountcode = chartmaster.accountcode
+				AND glaccountusers.userid = '" . $_SESSION['UserID'] . "'
+				AND glaccountusers.canupd = 1
+			WHERE chartmaster.accountcode = '" . $GLAccount . "'";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) == 0) {
+		return __('The general ledger account selected does not exist or you are not allowed to post to it');
+	}
+	$SQL = "SELECT accountcode FROM bankaccounts WHERE accountcode = '" . $GLAccount . "'";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) > 0) {
+		return __('The adjustment cannot be posted to a bank account') . ' - ' . __('use a receipt for money received');
+	}
+	return '';
+}
+
+/* Post a balance adjustment.
+$Amount is in the customer's currency, positive to increase the balance, negative to decrease it.
+$TranDate is in the default date format. $Rate is the exchange rate of the customer currency (functional currency = 1).
+Returns array('id' => debtortrans id, 'transno' => adjustment number, 'period' => period number) */
+function PostCustomerAdjustment($DebtorNo, $Amount, $TranDate, $Reason, $GLAccount, $Rate, $BranchCode = '', $SalesPerson = '', $Reference = '') {
+
+	$PeriodNo = GetPeriod($TranDate);
+	$SQLDate = FormatDateForSQL($TranDate);
+	$TransNo = GetNextTransNo(CUSTOMER_ADJUSTMENT_TYPE);
+
+	if ($Reference == '') {
+		$Reference = __('Adjustment');
+	}
+
+	$SQL = "INSERT INTO debtortrans (transno,
+									type,
+									debtorno,
+									branchcode,
+									trandate,
+									inputdate,
+									prd,
+									reference,
+									tpe,
+									rate,
+									ovamount,
+									invtext,
+									salesperson)
+				VALUES (
+					'" . $TransNo . "',
+					" . CUSTOMER_ADJUSTMENT_TYPE . ",
+					'" . $DebtorNo . "',
+					'" . $BranchCode . "',
+					'" . $SQLDate . "',
+					'" . date('Y-m-d H-i-s') . "',
+					'" . $PeriodNo . "',
+					'" . CustomerAdjustmentTruncate(DB_escape_string($Reference), 50) . "',
+					'',
+					'" . $Rate . "',
+					'" . $Amount . "',
+					'" . $Reason . "',
+					'" . $SalesPerson . "'
+				)";
+	$ErrMsg = __('Cannot insert the balance adjustment against the customer because');
+	DB_query($SQL, $ErrMsg, '', true);
+	$ID = DB_Last_Insert_ID('debtortrans', 'id');
+
+	if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+		$LocalAmount = $Amount / $Rate;
+		$Narrative = CustomerAdjustmentTruncate($DebtorNo . ' - ' . $Reason, 200);
+
+		/* Debit (or credit if the balance is reduced) the debtors control account */
+		$SQL = "INSERT INTO gltrans (type,
+									typeno,
+									trandate,
+									periodno,
+									account,
+									narrative,
+									amount)
+				VALUES (
+					" . CUSTOMER_ADJUSTMENT_TYPE . ",
+					'" . $TransNo . "',
+					'" . $SQLDate . "',
+					'" . $PeriodNo . "',
+					'" . $_SESSION['CompanyRecord']['debtorsact'] . "',
+					'" . $Narrative . "',
+					'" . $LocalAmount . "'
+				)";
+		$ErrMsg = __('Cannot insert a GL transaction for the debtors account');
+		DB_query($SQL, $ErrMsg, '', true);
+
+		/* and the opposite entry to the account chosen */
+		$SQL = "INSERT INTO gltrans (type,
+									typeno,
+									trandate,
+									periodno,
+									account,
+									narrative,
+									amount)
+				VALUES (
+					" . CUSTOMER_ADJUSTMENT_TYPE . ",
+					'" . $TransNo . "',
+					'" . $SQLDate . "',
+					'" . $PeriodNo . "',
+					'" . $GLAccount . "',
+					'" . $Narrative . "',
+					'" . -$LocalAmount . "'
+				)";
+		$ErrMsg = __('Cannot insert a GL transaction for the adjustment account');
+		DB_query($SQL, $ErrMsg, '', true);
+
+		EnsureGLEntriesBalance(CUSTOMER_ADJUSTMENT_TYPE, $TransNo);
+	}
+
+	return array('id' => $ID, 'transno' => $TransNo, 'period' => $PeriodNo);
+}
+
+/* Write off what is left on an invoice. The write off is a negative adjustment for the amount outstanding,
+posted at the exchange rate of the invoice so there is no exchange difference, and allocated to the invoice
+which is then settled.
+Returns array('transno' => adjustment number, 'amount' => amount written off) or array('error' => message) */
+function WriteOffCustomerInvoice($InvoiceID, $TranDate, $Reason, $GLAccount) {
+
+	/* lock the invoice so it can't be allocated by someone else while it is written off */
+	$SQL = "SELECT debtortrans.id,
+					debtortrans.transno,
+					debtortrans.type,
+					debtortrans.debtorno,
+					debtortrans.branchcode,
+					debtortrans.rate,
+					debtortrans.salesperson,
+					debtortrans.ovamount + debtortrans.ovgst + debtortrans.ovfreight + debtortrans.ovdiscount AS total,
+					debtortrans.alloc
+			FROM debtortrans
+			WHERE debtortrans.id = '" . $InvoiceID . "'
+			FOR UPDATE";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) == 0) {
+		return array('error' => __('The invoice to be written off could not be found'));
+	}
+	$Invoice = DB_fetch_array($Result);
+
+	if ($Invoice['type'] != 10) {
+		return array('error' => __('Only invoices can be written off'));
+	}
+	$Balance = $Invoice['total'] - $Invoice['alloc'];
+	if ($Balance <= 0) {
+		return array('error' => __('Invoice') . ' ' . $Invoice['transno'] . ' ' . __('has nothing left to write off'));
+	}
+
+	$Adjustment = PostCustomerAdjustment($Invoice['debtorno'],
+										-$Balance,
+										$TranDate,
+										$Reason,
+										$GLAccount,
+										$Invoice['rate'],
+										$Invoice['branchcode'],
+										$Invoice['salesperson'],
+										__('Write off invoice') . ' ' . $Invoice['transno']);
+
+	/* allocate the write off to the invoice - the same as an allocation made in CustomerAllocations.php */
+	$SQL = "INSERT INTO custallocns (datealloc,
+									amt,
+									transid_allocfrom,
+									transid_allocto)
+			VALUES (CURRENT_DATE,
+					'" . $Balance . "',
+					'" . $Adjustment['id'] . "',
+					'" . $Invoice['id'] . "')";
+	$ErrMsg = __('Could not insert the allocation of the write off to the invoice');
+	DB_query($SQL, $ErrMsg, '', true);
+
+	$SQL = "UPDATE debtortrans
+			SET alloc = '" . ($Invoice['alloc'] + $Balance) . "',
+				settled = 1
+			WHERE id = '" . $Invoice['id'] . "'";
+	$ErrMsg = __('Could not update the invoice written off');
+	DB_query($SQL, $ErrMsg, '', true);
+
+	$SQL = "UPDATE debtortrans
+			SET alloc = '" . -$Balance . "',
+				settled = 1
+			WHERE id = '" . $Adjustment['id'] . "'";
+	$ErrMsg = __('Could not update the write off adjustment');
+	DB_query($SQL, $ErrMsg, '', true);
+
+	return array('transno' => $Adjustment['transno'], 'amount' => $Balance);
+}

diff --git a/CustomerAdjustment.php b/CustomerAdjustment.php
new file mode 100644
index 0000000..35a6e11
--- /dev/null
+++ b/CustomerAdjustment.php
@@ -0,0 +1,290 @@
+<?php
+
+/* Adjust a customer's balance up or down, or write off what is left on one of the customer's invoices.
+Called with:
+	DebtorNo - the customer (defaults to the customer selected on the customer screen)
+	WriteOff - optional, the id of the invoice to write off the balance of
+*/
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CustomerAdjustmentFunctions.php');
+
+$Title = __('Customer Balance Adjustment');
+$ViewTopic = 'ARTransactions';
+$BookMark = 'CustomerAdjustment';
+
+if (isset($_POST['AdjDate'])) {
+	$_POST['AdjDate'] = ConvertSQLDate($_POST['AdjDate']);
+}
+
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/transactions.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+if (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+} elseif (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_SESSION['CustomerID'])) {
+	$DebtorNo = $_SESSION['CustomerID'];
+} else {
+	$DebtorNo = '';
+}
+
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				currencies.currency,
+				currencies.rate,
+				currencies.decimalplaces
+		FROM debtorsmaster
+		INNER JOIN currencies
+			ON debtorsmaster.currcode = currencies.currabrev
+		WHERE debtorsmaster.debtorno = '" . $DebtorNo . "'";
+$Result = DB_query($SQL);
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('To adjust a customer balance a customer must first be selected from the customer selection screen'), 'info');
+	echo '<br /><div class="centre"><a href="' . $RootPath . '/SelectCustomer.php">' . __('Select a Customer Account') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($Result);
+$DecimalPlaces = $Customer['decimalplaces'];
+
+if (!isset($_POST['AdjDate']) or !Is_Date($_POST['AdjDate'])) {
+	$_POST['AdjDate'] = date($_SESSION['DefaultDateFormat']);
+}
+
+/* The invoice being written off, if any */
+$WriteOffID = '';
+if (isset($_POST['WriteOffID'])) {
+	$WriteOffID = (int) $_POST['WriteOffID'];
+} elseif (isset($_GET['WriteOff'])) {
+	$WriteOffID = (int) $_GET['WriteOff'];
+}
+
+if (isset($_POST['Cancel'])) {
+	$WriteOffID = '';
+	unset($_POST['Amount'], $_POST['Reason']);
+}
+
+if (isset($_POST['PostAdjustment']) or isset($_POST['ConfirmWriteOff'])) {
+
+	$InputError = 0;
+
+	if (!Is_Date($_POST['AdjDate'])) {
+		prnMsg(__('The date of the adjustment is not a valid date'), 'error');
+		$InputError = 1;
+	}
+	$Reason = trim($_POST['Reason']);
+	if ($Reason == '') {
+		prnMsg(__('A reason for the adjustment must be entered'), 'error');
+		$InputError = 1;
+	}
+	$GLAccount = isset($_POST['GLAccount']) ? $_POST['GLAccount'] : '';
+	$GLError = CustomerAdjustmentCheckGLAccount($GLAccount);
+	if ($GLError != '') {
+		prnMsg($GLError, 'error');
+		$InputError = 1;
+	}
+
+	if (isset($_POST['PostAdjustment'])) {
+		$Amount = filter_number_format($_POST['Amount']);
+		if (!is_numeric($Amount) or round($Amount, $DecimalPlaces) <= 0) {
+			prnMsg(__('The amount of the adjustment must be a number greater than zero') . ' - ' . __('use the increase or decrease choice to set the direction'), 'error');
+			$InputError = 1;
+		} elseif ($_POST['Direction'] != 'Increase' and $_POST['Direction'] != 'Decrease') {
+			prnMsg(__('Select whether the adjustment increases or decreases the customer balance'), 'error');
+			$InputError = 1;
+		}
+	}
+
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+		if (isset($_POST['PostAdjustment'])) {
+			$SignedAmount = round($Amount, $DecimalPlaces);
+			if ($_POST['Direction'] == 'Decrease') {
+				$SignedAmount = -$SignedAmount;
+			}
+			$Adjustment = PostCustomerAdjustment($DebtorNo, $SignedAmount, $_POST['AdjDate'], $Reason, $GLAccount, $Customer['rate'], '', $_SESSION['SalesmanLogin']);
+			DB_Txn_Commit();
+			prnMsg(__('Balance adjustment number') . ' ' . $Adjustment['transno'] . ' ' . __('of') . ' ' . locale_number_format($SignedAmount, $DecimalPlaces) . ' ' . $Customer['currcode'] . ' ' . __('has been posted to the account of') . ' ' . $DebtorNo, 'success');
+			if ($SignedAmount < 0) {
+				echo '<div class="centre"><a href="' . $RootPath . '/CustomerAllocations.php?AllocTrans=' . $Adjustment['id'] . '">' . __('Allocate this adjustment to invoices') . '</a></div><br />';
+			}
+			unset($_POST['Amount'], $_POST['Reason'], $_POST['Direction']);
+		} else {
+			$WriteOff = WriteOffCustomerInvoice($WriteOffID, $_POST['AdjDate'], $Reason, $GLAccount);
+			if (isset($WriteOff['error'])) {
+				DB_Txn_Rollback();
+				prnMsg($WriteOff['error'], 'error');
+			} else {
+				DB_Txn_Commit();
+				prnMsg(locale_number_format($WriteOff['amount'], $DecimalPlaces) . ' ' . $Customer['currcode'] . ' ' . __('has been written off by adjustment number') . ' ' . $WriteOff['transno'], 'success');
+				$WriteOffID = '';
+				unset($_POST['Reason']);
+			}
+		}
+	}
+}
+
+echo '<table class="selection">
+		<tr><th colspan="2">' . $Customer['debtorno'] . ' - ' . $Customer['name'] . '</th></tr>';
+
+$SQL = "SELECT SUM(balance) AS balance FROM debtortrans WHERE debtorno = '" . $DebtorNo . "'";
+$BalanceResult = DB_query($SQL);
+$BalanceRow = DB_fetch_array($BalanceResult);
+echo '<tr><td>' . __('Current balance') . '</td><td class="number">' . locale_number_format($BalanceRow['balance'], $DecimalPlaces) . ' ' . $Customer['currcode'] . '</td></tr>
+	</table><br />';
+
+/* The GL accounts the adjustment can be posted to */
+$GLSelect = '';
+if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+	$GLSelect = '<field>
+			<label for="GLAccount">' . __('GL Account') . ':</label>
+			<select required="required" name="GLAccount">
+				<option value=""></option>';
+	$SQL = "SELECT chartmaster.accountcode,
+					chartmaster.accountname
+			FROM chartmaster
+			INNER JOIN glaccountusers
+				ON glaccountusers.accountcode = chartmaster.accountcode
+				AND glaccountusers.userid = '" . $_SESSION['UserID'] . "'
+				AND glaccountusers.canupd = 1
+			LEFT JOIN bankaccounts
+				ON bankaccounts.accountcode = chartmaster.accountcode
+			WHERE bankaccounts.accountcode IS NULL
+			AND chartmaster.accountcode <> '" . $_SESSION['CompanyRecord']['debtorsact'] . "'
+			ORDER BY chartmaster.accountcode";
+	$GLResult = DB_query($SQL);
+	while ($GLRow = DB_fetch_array($GLResult)) {
+		$GLSelect .= '<option ' . ((isset($_POST['GLAccount']) and $_POST['GLAccount'] == $GLRow['accountcode']) ? 'selected="selected" ' : '') . 'value="' . $GLRow['accountcode'] . '">' . $GLRow['accountcode'] . ' - ' . $GLRow['accountname'] . '</option>';
+	}
+	$GLSelect .= '</select>
+			<fieldhelp>' . __('The general ledger account the other side of the adjustment is posted to, for example bad debts') . '</fieldhelp>
+		</field>';
+}
+
+$ReasonValue = isset($_POST['Reason']) ? $_POST['Reason'] : '';
+$DateField = '<field>
+		<label for="AdjDate">' . __('Date') . ':</label>
+		<input type="date" name="AdjDate" required="required" value="' . FormatDateForSQL($_POST['AdjDate']) . '" />
+	</field>';
+$ReasonField = '<field>
+		<label for="Reason">' . __('Reason') . ':</label>
+		<input type="text" name="Reason" required="required" size="60" maxlength="100" value="' . $ReasonValue . '" />
+	</field>';
+
+if ($WriteOffID != '') {
+
+	/* confirm the write off of an invoice */
+	$SQL = "SELECT transno,
+					trandate,
+					ovamount + ovgst + ovfreight + ovdiscount AS total,
+					alloc
+			FROM debtortrans
+			WHERE id = '" . $WriteOffID . "'
+			AND type = 10
+			AND debtorno = '" . $DebtorNo . "'";
+	$Result = DB_query($SQL);
+	$Invoice = DB_fetch_array($Result);
+	if (!$Invoice or $Invoice['total'] - $Invoice['alloc'] <= 0) {
+		prnMsg(__('The invoice selected has nothing left to write off'), 'warn');
+	} else {
+		echo '<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+			<input type="hidden" name="WriteOffID" value="' . $WriteOffID . '" />
+			<fieldset>
+				<legend>' . __('Write off the balance of invoice') . ' ' . $Invoice['transno'] . '</legend>
+				<field>
+					<label>' . __('Invoice Date') . ':</label>
+					<fieldtext>' . ConvertSQLDate($Invoice['trandate']) . '</fieldtext>
+				</field>
+				<field>
+					<label>' . __('Amount to write off') . ':</label>
+					<fieldtext>' . locale_number_format($Invoice['total'] - $Invoice['alloc'], $DecimalPlaces) . ' ' . $Customer['currcode'] . '</fieldtext>
+				</field>
+				' . $DateField . '
+				' . $ReasonField . '
+				' . $GLSelect . '
+			</fieldset>
+			<div class="centre">
+				<input type="submit" name="ConfirmWriteOff" value="' . __('Write Off This Balance') . '" />
+				<input type="submit" name="Cancel" value="' . __('Cancel') . '" />
+			</div>
+		</form>';
+		include('includes/footer.php');
+		exit();
+	}
+}
+
+echo '<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+	<fieldset>
+		<legend>' . __('Adjust the balance') . '</legend>
+		<field>
+			<label for="Direction">' . __('Adjustment') . ':</label>
+			<select name="Direction" required="required">
+				<option value=""></option>
+				<option ' . ((isset($_POST['Direction']) and $_POST['Direction'] == 'Increase') ? 'selected="selected" ' : '') . 'value="Increase">' . __('Increase the balance owed by the customer') . '</option>
+				<option ' . ((isset($_POST['Direction']) and $_POST['Direction'] == 'Decrease') ? 'selected="selected" ' : '') . 'value="Decrease">' . __('Decrease the balance owed by the customer') . '</option>
+			</select>
+		</field>
+		<field>
+			<label for="Amount">' . __('Amount') . ' (' . $Customer['currcode'] . '):</label>
+			<input type="text" class="number" name="Amount" required="required" size="14" maxlength="14" value="' . (isset($_POST['Amount']) ? $_POST['Amount'] : '') . '" />
+		</field>
+		' . $DateField . '
+		' . $ReasonField . '
+		' . $GLSelect . '
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="PostAdjustment" value="' . __('Post Adjustment') . '" />
+	</div>
+</form>';
+
+/* Invoices with something left that can be written off */
+$SQL = "SELECT id,
+				transno,
+				trandate,
+				ovamount + ovgst + ovfreight + ovdiscount AS total,
+				alloc,
+				balance
+		FROM debtortrans
+		WHERE debtorno = '" . $DebtorNo . "'
+		AND type = 10
+		AND settled = 0
+		AND balance > 0
+		ORDER BY trandate, transno";
+$Result = DB_query($SQL);
+if (DB_num_rows($Result) > 0) {
+	echo '<br /><table class="selection">
+			<tr><th colspan="6">' . __('Open invoices') . '</th></tr>
+			<tr>
+				<th>' . __('Invoice') . '</th>
+				<th>' . __('Date') . '</th>
+				<th>' . __('Total') . '</th>
+				<th>' . __('Allocated') . '</th>
+				<th>' . __('Balance') . '</th>
+				<th>&nbsp;</th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td class="number">' . $MyRow['transno'] . '</td>
+				<td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+				<td class="number">' . locale_number_format($MyRow['total'], $DecimalPlaces) . '</td>
+				<td class="number">' . locale_number_format($MyRow['alloc'], $DecimalPlaces) . '</td>
+				<td class="number">' . locale_number_format($MyRow['balance'], $DecimalPlaces) . '</td>
+				<td><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '?DebtorNo=' . urlencode($DebtorNo) . '&amp;WriteOff=' . $MyRow['id'] . '">' . __('Write off balance') . '</a></td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+echo '<br /><div class="centre"><a href="' . $RootPath . '/CustomerAccount.php?CustomerID=' . urlencode($DebtorNo) . '">' . __('Show the customer account') . '</a></div>';
+
+include('includes/footer.php');

diff --git a/CreditControlReport.php b/CreditControlReport.php
new file mode 100644
index 0000000..a4b3d7d
--- /dev/null
+++ b/CreditControlReport.php
@@ -0,0 +1,154 @@
+<?php
+
+/* Credit control report: customers due or overdue for a credit review, customers over their credit limit and
+ * customers on watch or on stop. Filterable by sales rep and currency; totals in the home currency.
+ * Sales reps (users with a SalesmanLogin) only ever see the customers of their own sales area. */
+
+$PageSecurity = 2;
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Control Report');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlReport';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$RepLogin = (isset($_SESSION['SalesmanLogin']) and $_SESSION['SalesmanLogin'] != '') ? $_SESSION['SalesmanLogin'] : '';
+
+$SelectedRep = '';
+if ($RepLogin != '') {
+	$SelectedRep = $RepLogin; // a rep cannot look at anybody else's customers
+} elseif (!empty($_POST['Salesman'])) {
+	$SelectedRep = $_POST['Salesman'];
+}
+$SelectedCurrency = !empty($_POST['Currency']) ? $_POST['Currency'] : '';
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset><legend>' . __('Report options') . '</legend>';
+if ($RepLogin == '') {
+	echo '<field><label for="Salesman">' . __('Sales rep') . ':</label><select name="Salesman" id="Salesman"><option value="">' . __('All') . '</option>';
+	$RepResult = DB_query("SELECT salesmancode, salesmanname FROM salesman ORDER BY salesmanname");
+	while ($Rep = DB_fetch_array($RepResult)) {
+		echo '<option value="' . htmlspecialchars($Rep['salesmancode'], ENT_QUOTES, 'UTF-8') . '"' . ($SelectedRep == $Rep['salesmancode'] ? ' selected="selected"' : '') . '>' . htmlspecialchars($Rep['salesmanname'], ENT_QUOTES, 'UTF-8') . '</option>';
+	}
+	echo '</select></field>';
+}
+echo '<field><label for="Currency">' . __('Currency') . ':</label><select name="Currency" id="Currency"><option value="">' . __('All') . '</option>';
+$CurrResult = DB_query("SELECT currabrev, currency FROM currencies ORDER BY currabrev");
+while ($Curr = DB_fetch_array($CurrResult)) {
+	echo '<option value="' . $Curr['currabrev'] . '"' . ($SelectedCurrency == $Curr['currabrev'] ? ' selected="selected"' : '') . '>' . $Curr['currabrev'] . ' - ' . htmlspecialchars($Curr['currency'], ENT_QUOTES, 'UTF-8') . '</option>';
+}
+echo '</select></field></fieldset>
+	<div class="centre"><input type="submit" name="Show" value="' . __('Show Report') . '" /></div></form>';
+
+if (!isset($_POST['Show']) and $RepLogin == '') {
+	include('includes/footer.php');
+	exit();
+}
+
+$Where = '1=1';
+if ($SelectedRep != '') {
+	/* a customer is "the rep's" if any of its branches is assigned to the rep */
+	$Where .= " AND EXISTS (SELECT 1 FROM custbranch WHERE custbranch.debtorno=debtorsmaster.debtorno AND custbranch.salesman='" . DB_escape_string($SelectedRep) . "')";
+}
+if ($SelectedCurrency != '') {
+	$Where .= " AND debtorsmaster.currcode='" . DB_escape_string($SelectedCurrency) . "'";
+}
+
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				debtorsmaster.creditlimit,
+				debtorsmaster.nextreviewdate,
+				holdreasons.dissallowinvoices,
+				holdreasons.reasondescription,
+				currencies.rate,
+				currencies.decimalplaces,
+				COALESCE((SELECT SUM(debtortrans.balance) FROM debtortrans WHERE debtortrans.debtorno=debtorsmaster.debtorno), 0) AS balance
+		FROM debtorsmaster
+		INNER JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+		INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+		WHERE " . $Where . "
+		ORDER BY debtorsmaster.name";
+$Result = DB_query($SQL);
+
+$Due = array();
+$OverLimit = array();
+$Flagged = array();
+$Today = date('Y-m-d');
+while ($Row = DB_fetch_array($Result)) {
+	$Rate = ($Row['rate'] == 0) ? 1 : $Row['rate'];
+	$Row['balancehome'] = $Row['balance'] / $Rate;
+	if ($Row['nextreviewdate'] <= $Today) {
+		$Due[] = $Row;
+	}
+	if ($Row['balance'] > $Row['creditlimit']) {
+		$Row['over'] = $Row['balance'] - $Row['creditlimit'];
+		$Row['overhome'] = $Row['over'] / $Rate;
+		$OverLimit[] = $Row;
+	}
+	if ($Row['dissallowinvoices'] == 1 or $Row['dissallowinvoices'] == 2) {
+		$Flagged[] = $Row;
+	}
+}
+
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$HomeDecimals = $_SESSION['CompanyRecord']['decimalplaces'];
+
+function CreditReportTable($Title, $Rows, $Columns, $HomeCurrency, $HomeDecimals, $TotalKey, $TotalLabel) {
+	echo '<br /><table class="selection"><tr><th colspan="' . (count($Columns) + 3) . '">' . $Title . ' (' . count($Rows) . ')</th></tr>
+		<tr><th>' . __('Code') . '</th><th>' . __('Name') . '</th><th>' . __('Currency') . '</th>';
+	foreach ($Columns as $Heading) {
+		echo '<th>' . $Heading[0] . '</th>';
+	}
+	echo '</tr>';
+	$Total = 0;
+	foreach ($Rows as $Row) {
+		echo '<tr class="striped_row"><td>' . htmlspecialchars($Row['debtorno'], ENT_QUOTES, 'UTF-8') . '</td><td>' . htmlspecialchars($Row['name'], ENT_QUOTES, 'UTF-8') . '</td><td>' . $Row['currcode'] . '</td>';
+		foreach ($Columns as $Heading) {
+			echo '<td' . ($Heading[2] ? ' class="number"' : '') . '>' . call_user_func($Heading[1], $Row) . '</td>';
+		}
+		echo '</tr>';
+		$Total += $Row[$TotalKey];
+	}
+	echo '<tr><th colspan="' . (count($Columns) + 2) . '">' . $TotalLabel . ' (' . $HomeCurrency . ')</th><th class="number">' . locale_number_format($Total, $HomeDecimals) . '</th></tr></table>';
+}
+
+$StatusText = function ($Row) {
+	if ($Row['dissallowinvoices'] == 1) {
+		return CreditStatusLabel(CREDIT_STOP);
+	} elseif ($Row['dissallowinvoices'] == 2) {
+		return CreditStatusLabel(CREDIT_WATCH);
+	}
+	return CreditStatusLabel(CREDIT_NORMAL);
+};
+$Num = function ($Field) {
+	return function ($Row) use ($Field) {
+		return locale_number_format($Row[$Field], $Row['decimalplaces']);
+	};
+};
+
+CreditReportTable(__('Due or overdue for credit review'), $Due, array(
+		array(__('Next review'), function ($Row) { return ConvertSQLDate($Row['nextreviewdate']); }, false),
+		array(__('Status'), $StatusText, false),
+		array(__('Balance'), $Num('balance'), true)),
+	$HomeCurrency, $HomeDecimals, 'balancehome', __('Total balance'));
+
+CreditReportTable(__('Over credit limit'), $OverLimit, array(
+		array(__('Credit limit'), $Num('creditlimit'), true),
+		array(__('Balance'), $Num('balance'), true),
+		array(__('Over by'), $Num('over'), true)),
+	$HomeCurrency, $HomeDecimals, 'overhome', __('Total over limit'));
+
+CreditReportTable(__('On watch or on stop'), $Flagged, array(
+		array(__('Status'), $StatusText, false),
+		array(__('Reason'), function ($Row) { return htmlspecialchars($Row['reasondescription'], ENT_QUOTES, 'UTF-8'); }, false),
+		array(__('Balance'), $Num('balance'), true)),
+	$HomeCurrency, $HomeDecimals, 'balancehome', __('Total balance'));
+
+include('includes/footer.php');
diff --git a/CreditHeldOrders.php b/CreditHeldOrders.php
new file mode 100644
index 0000000..e51f673
--- /dev/null
+++ b/CreditHeldOrders.php
@@ -0,0 +1,94 @@
+<?php
+
+/* Orders held for credit control approval (over credit limit), open orders for customers on stop that credit
+ * control may release, and orders taken for customers on watch. Credit control staff only (security token 21). */
+
+$PageSecurity = 21;
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Orders Held for Credit Control');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditHeldOrders';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+if (!CanChangeCreditControl()) {
+	prnMsg(__('You are not authorised to release orders held for credit control'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+if (isset($_POST['Release']) and isset($_POST['OrderNo'])) {
+	$OrderNo = (int) $_POST['OrderNo'];
+	$Reason = isset($_POST['Reason']) ? trim($_POST['Reason']) : '';
+	$Result = DB_query("SELECT debtorno, creditheld FROM salesorders WHERE orderno='" . $OrderNo . "'");
+	$Order = DB_fetch_array($Result);
+	if (!$Order) {
+		prnMsg(__('The order could not be found'), 'error');
+	} elseif ($Reason == '') {
+		prnMsg(__('A reason for releasing the order must be entered'), 'error');
+	} else {
+		DB_Txn_Begin();
+		DB_query("UPDATE salesorders SET creditheld=2 WHERE orderno='" . $OrderNo . "'");
+		LogCreditEvent($Order['debtorno'], 'order released', (string) $OrderNo, 'released', $Reason);
+		DB_Txn_Commit();
+		prnMsg(__('Order') . ' ' . $OrderNo . ' ' . __('has been released'), 'success');
+	}
+}
+
+function CreditOrderTable($Title, $Result, $ShowRelease) {
+	echo '<br /><table class="selection"><tr><th colspan="7">' . $Title . '</th></tr>
+		<tr><th>' . __('Order') . '</th><th>' . __('Customer') . '</th><th>' . __('Name') . '</th><th>' . __('Order date') . '</th><th>' . __('Value') . '</th><th>' . __('Credit available') . '</th><th></th></tr>';
+	if (DB_num_rows($Result) == 0) {
+		echo '<tr><td colspan="7">' . __('None') . '</td></tr>';
+	}
+	while ($Row = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . $Row['orderno'] . '</td>
+				<td>' . htmlspecialchars($Row['debtorno'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td>' . htmlspecialchars($Row['name'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td>' . ConvertSQLDate($Row['orddate']) . '</td>
+				<td class="number">' . locale_number_format($Row['ordervalue'], $Row['decimalplaces']) . ' ' . $Row['currcode'] . '</td>
+				<td class="number">' . locale_number_format(GetCreditAvailable($Row['debtorno']), $Row['decimalplaces']) . '</td>
+				<td>';
+		if ($ShowRelease) {
+			echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+					<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+					<input type="hidden" name="OrderNo" value="' . $Row['orderno'] . '" />
+					<input type="text" name="Reason" size="25" maxlength="200" placeholder="' . __('Reason') . '" required="required" />
+					<input type="submit" name="Release" value="' . __('Release') . '" />
+				</form>';
+		}
+		echo '</td></tr>';
+	}
+	echo '</table>';
+}
+
+$BaseSQL = "SELECT salesorders.orderno,
+					salesorders.debtorno,
+					salesorders.orddate,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					currencies.decimalplaces,
+					SUM(salesorderdetails.unitprice * (salesorderdetails.quantity - salesorderdetails.qtyinvoiced) * (1 - salesorderdetails.discountpercent)) AS ordervalue
+			FROM salesorders
+			INNER JOIN salesorderdetails ON salesorders.orderno=salesorderdetails.orderno
+			INNER JOIN debtorsmaster ON salesorders.debtorno=debtorsmaster.debtorno
+			INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+			INNER JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+			WHERE salesorders.quotation=0
+				AND salesorderdetails.completed=0
+				AND ";
+$GroupSQL = " GROUP BY salesorders.orderno, salesorders.debtorno, salesorders.orddate, debtorsmaster.name, debtorsmaster.currcode, currencies.decimalplaces
+			ORDER BY salesorders.orddate";
+
+CreditOrderTable(__('Held for approval - over credit limit'), DB_query($BaseSQL . "salesorders.creditheld=1" . $GroupSQL), true);
+CreditOrderTable(__('Open orders for customers on stop (not released)'), DB_query($BaseSQL . "salesorders.creditheld<>2 AND salesorders.creditheld<>1 AND holdreasons.dissallowinvoices=1" . $GroupSQL), true);
+CreditOrderTable(__('Open orders for customers on watch'), DB_query($BaseSQL . "holdreasons.dissallowinvoices=2" . $GroupSQL), false);
+
+include('includes/footer.php');
diff --git a/CreditReview.php b/CreditReview.php
new file mode 100644
index 0000000..196605a
--- /dev/null
+++ b/CreditReview.php
@@ -0,0 +1,298 @@
+<?php
+
+/* Credit reviews, stop and watch. Only credit control staff (security token 21) can open this page, so sales reps
+ * and the sales office cannot change credit limits or credit status. Every change is recorded in creditreviews
+ * and creditcontrollog, which are insert-only. */
+
+$PageSecurity = 21;
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Review, Stop and Watch');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditReview';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . __('Credit Review') . '" alt="" />' . ' ' . $Title . '</p>';
+
+/* Defence in depth: the page security above already limits this page to credit control */
+if (!CanChangeCreditControl()) {
+	prnMsg(__('You are not authorised to change credit limits or credit status'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$DebtorNo = '';
+if (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+} elseif (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+}
+$DebtorNo = trim($DebtorNo);
+
+$Outcomes = array('confirmed' => __('Limit confirmed'),
+				'raised' => __('Limit raised'),
+				'reduced' => __('Limit reduced'),
+				'watch' => __('Put on watch'),
+				'stop' => __('Put on stop'),
+				'normal' => __('Take off watch / stop'));
+
+/* ---- Record a review ---- */
+if (isset($_POST['RecordReview']) and $DebtorNo != '') {
+
+	$InputError = 0;
+	$CustResult = DB_query("SELECT creditlimit FROM debtorsmaster WHERE debtorno='" . DB_escape_string($DebtorNo) . "'");
+	if (DB_num_rows($CustResult) == 0) {
+		prnMsg(__('The customer could not be found'), 'error');
+		$InputError = 1;
+	} else {
+		$CustRow = DB_fetch_array($CustResult);
+		$OldLimit = (float) $CustRow['creditlimit'];
+	}
+
+	$Outcome = isset($_POST['Outcome']) ? $_POST['Outcome'] : '';
+	if (!isset($Outcomes[$Outcome])) {
+		prnMsg(__('Select the outcome of the review'), 'error');
+		$InputError = 1;
+	}
+
+	$Notes = isset($_POST['Notes']) ? trim($_POST['Notes']) : '';
+	if ($Notes == '') {
+		prnMsg(__('Notes (the reason for the decision) must be entered'), 'error');
+		$InputError = 1;
+	}
+
+	$NextReview = isset($_POST['NextReviewDate']) ? $_POST['NextReviewDate'] : '';
+	$NextReviewParts = explode('-', $NextReview);
+	if (count($NextReviewParts) != 3 or !checkdate((int) $NextReviewParts[1], (int) $NextReviewParts[2], (int) $NextReviewParts[0])
+		or $NextReview <= date('Y-m-d')) {
+		prnMsg(__('The next review date must be a valid date in the future'), 'error');
+		$InputError = 1;
+	}
+
+	if ($InputError == 0) {
+		/* The limit only changes for the limit outcomes; for the others the current limit is kept */
+		$NewLimit = $OldLimit;
+		if (in_array($Outcome, array('confirmed', 'raised', 'reduced'))) {
+			$NewLimit = filter_number_format($_POST['NewLimit']);
+			if (!is_numeric($NewLimit) or $NewLimit < 0) {
+				prnMsg(__('The new credit limit must be a number of zero or more'), 'error');
+				$InputError = 1;
+			} elseif ($Outcome == 'raised' and $NewLimit <= $OldLimit) {
+				prnMsg(__('A raised limit must be higher than the current limit'), 'error');
+				$InputError = 1;
+			} elseif ($Outcome == 'reduced' and $NewLimit >= $OldLimit) {
+				prnMsg(__('A reduced limit must be lower than the current limit'), 'error');
+				$InputError = 1;
+			} elseif ($Outcome == 'confirmed' and $NewLimit != $OldLimit) {
+				prnMsg(__('To change the limit choose raised or reduced as the outcome'), 'error');
+				$InputError = 1;
+			}
+		}
+	}
+
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+
+		DB_query("INSERT INTO creditreviews (debtorno,
+											reviewdate,
+											reviewedby,
+											outcome,
+											oldlimit,
+											newlimit,
+											notes,
+											nextreviewdate)
+										VALUES (
+											'" . DB_escape_string($DebtorNo) . "',
+											CURRENT_TIMESTAMP,
+											'" . DB_escape_string($_SESSION['UserID']) . "',
+											'" . DB_escape_string($Outcome) . "',
+											'" . $OldLimit . "',
+											'" . $NewLimit . "',
+											'" . DB_escape_string($Notes) . "',
+											'" . DB_escape_string($NextReview) . "')",
+				__('The credit review could not be recorded because'));
+
+		/* the limit changes in the same transaction as the review that explains it */
+		if ($NewLimit != $OldLimit) {
+			DB_query("UPDATE debtorsmaster SET creditlimit='" . $NewLimit . "' WHERE debtorno='" . DB_escape_string($DebtorNo) . "'",
+					__('The credit limit could not be updated because'));
+			LogCreditEvent($DebtorNo, 'credit limit', (string) $OldLimit, (string) $NewLimit, $Notes);
+		}
+		DB_query("UPDATE debtorsmaster SET nextreviewdate='" . DB_escape_string($NextReview) . "' WHERE debtorno='" . DB_escape_string($DebtorNo) . "'",
+				__('The next review date could not be updated because'));
+		LogCreditEvent($DebtorNo, 'review', '', $Outcomes[$Outcome], $Notes);
+
+		if ($Outcome == 'watch') {
+			SetCreditStatus($DebtorNo, CREDIT_WATCH, $Notes);
+		} elseif ($Outcome == 'stop') {
+			SetCreditStatus($DebtorNo, CREDIT_STOP, $Notes);
+		} elseif ($Outcome == 'normal') {
+			SetCreditStatus($DebtorNo, CREDIT_NORMAL, $Notes);
+		}
+
+		DB_Txn_Commit();
+		prnMsg(__('The credit review has been recorded'), 'success');
+		unset($_POST['Notes']);
+	}
+}
+
+/* ---- Release orders held for credit control from this customer's page is done in CreditHeldOrders.php ---- */
+
+/* ---- Customer search ---- */
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset><legend>' . __('Select a customer') . '</legend>
+		<field>
+			<label for="Keywords">' . __('Part of the name') . ':</label>
+			<input type="text" name="Keywords" id="Keywords" size="20" maxlength="25" value="' . (isset($_POST['Keywords']) ? htmlspecialchars($_POST['Keywords'], ENT_QUOTES, 'UTF-8') : '') . '" />
+		</field>
+		<field>
+			<label for="CustCode">' . __('Part of the code') . ':</label>
+			<input type="text" name="CustCode" id="CustCode" size="15" maxlength="18" value="' . (isset($_POST['CustCode']) ? htmlspecialchars($_POST['CustCode'], ENT_QUOTES, 'UTF-8') : '') . '" />
+		</field>
+		<field>
+			<label for="DueOnly">' . __('Only customers due or overdue for review') . ':</label>
+			<input type="checkbox" name="DueOnly" id="DueOnly" value="1"' . (isset($_POST['DueOnly']) ? ' checked="checked"' : '') . ' />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Search" value="' . __('Search') . '" /></div>
+	</form>';
+
+if (isset($_POST['Search'])) {
+	$Where = '1=1';
+	if (!empty($_POST['Keywords'])) {
+		$Where .= " AND debtorsmaster.name LIKE '%" . DB_escape_string(trim($_POST['Keywords'])) . "%'";
+	}
+	if (!empty($_POST['CustCode'])) {
+		$Where .= " AND debtorsmaster.debtorno LIKE '%" . DB_escape_string(trim($_POST['CustCode'])) . "%'";
+	}
+	if (!empty($_POST['DueOnly'])) {
+		$Where .= " AND debtorsmaster.nextreviewdate <= CURDATE()";
+	}
+	$SearchResult = DB_query("SELECT debtorsmaster.debtorno,
+									debtorsmaster.name,
+									debtorsmaster.nextreviewdate,
+									holdreasons.dissallowinvoices
+							FROM debtorsmaster
+							INNER JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+							WHERE " . $Where . "
+							ORDER BY debtorsmaster.nextreviewdate, debtorsmaster.name
+							LIMIT 100");
+	if (DB_num_rows($SearchResult) == 0) {
+		prnMsg(__('No customers match the search'), 'info');
+	} else {
+		echo '<table class="selection"><tr><th>' . __('Code') . '</th><th>' . __('Name') . '</th><th>' . __('Next review') . '</th><th>' . __('Status') . '</th></tr>';
+		while ($Row = DB_fetch_array($SearchResult)) {
+			$StatusText = $Row['dissallowinvoices'] == 1 ? CreditStatusLabel(CREDIT_STOP) : ($Row['dissallowinvoices'] == 2 ? CreditStatusLabel(CREDIT_WATCH) : CreditStatusLabel(CREDIT_NORMAL));
+			echo '<tr class="striped_row">
+					<td><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '?DebtorNo=' . urlencode($Row['debtorno']) . '">' . htmlspecialchars($Row['debtorno'], ENT_QUOTES, 'UTF-8') . '</a></td>
+					<td>' . htmlspecialchars($Row['name'], ENT_QUOTES, 'UTF-8') . '</td>
+					<td>' . ConvertSQLDate($Row['nextreviewdate']) . '</td>
+					<td>' . $StatusText . '</td>
+				</tr>';
+		}
+		echo '</table>';
+	}
+}
+
+/* ---- Selected customer ---- */
+if ($DebtorNo != '') {
+	$CustResult = DB_query("SELECT debtorsmaster.name,
+									debtorsmaster.creditlimit,
+									debtorsmaster.nextreviewdate,
+									debtorsmaster.currcode,
+									currencies.decimalplaces
+							FROM debtorsmaster
+							INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+							WHERE debtorsmaster.debtorno='" . DB_escape_string($DebtorNo) . "'");
+	if (DB_num_rows($CustResult) == 0) {
+		prnMsg(__('The customer could not be found'), 'error');
+		include('includes/footer.php');
+		exit();
+	}
+	$Cust = DB_fetch_array($CustResult);
+	$Status = GetCreditStatus($DebtorNo);
+	$Available = GetCreditAvailable($DebtorNo);
+
+	echo '<table class="selection">
+			<tr><th colspan="2">' . htmlspecialchars($DebtorNo, ENT_QUOTES, 'UTF-8') . ' - ' . htmlspecialchars($Cust['name'], ENT_QUOTES, 'UTF-8') . '</th></tr>
+			<tr><td>' . __('Credit status') . '</td><td><b>' . CreditStatusLabel($Status['status']) . '</b> (' . htmlspecialchars($Status['reasondescription'], ENT_QUOTES, 'UTF-8') . ')</td></tr>
+			<tr><td>' . __('Credit limit') . '</td><td class="number">' . locale_number_format($Cust['creditlimit'], $Cust['decimalplaces']) . ' ' . $Cust['currcode'] . '</td></tr>
+			<tr><td>' . __('Credit available (after open orders)') . '</td><td class="number">' . locale_number_format($Available, $Cust['decimalplaces']) . ' ' . $Cust['currcode'] . '</td></tr>
+			<tr><td>' . __('Next review date') . '</td><td>' . ConvertSQLDate($Cust['nextreviewdate']) . '</td></tr>
+		</table><br />';
+
+	$DefaultNext = DefaultNextReviewDate();
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+	echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+	echo '<input type="hidden" name="DebtorNo" value="' . htmlspecialchars($DebtorNo, ENT_QUOTES, 'UTF-8') . '" />';
+	echo '<fieldset><legend>' . __('Record a credit review') . '</legend>
+			<field>
+				<label for="Outcome">' . __('Outcome') . ':</label>
+				<select name="Outcome" id="Outcome">';
+	foreach ($Outcomes as $Key => $Text) {
+		echo '<option value="' . $Key . '"' . ((isset($_POST['Outcome']) and $_POST['Outcome'] == $Key) ? ' selected="selected"' : '') . '>' . $Text . '</option>';
+	}
+	echo '</select>
+			</field>
+			<field>
+				<label for="NewLimit">' . __('Credit limit (for confirmed, raised or reduced)') . ':</label>
+				<input type="text" class="number" name="NewLimit" id="NewLimit" size="12" value="' . locale_number_format($Cust['creditlimit'], $Cust['decimalplaces']) . '" />
+			</field>
+			<field>
+				<label for="NextReviewDate">' . __('Next review date') . ':</label>
+				<input type="date" name="NextReviewDate" id="NextReviewDate" required="required" value="' . htmlspecialchars(isset($_POST['NextReviewDate']) ? $_POST['NextReviewDate'] : $DefaultNext, ENT_QUOTES, 'UTF-8') . '" />
+			</field>
+			<field>
+				<label for="Notes">' . __('Notes / reason') . ':</label>
+				<textarea name="Notes" id="Notes" rows="4" cols="50" required="required">' . htmlspecialchars(isset($_POST['Notes']) ? $_POST['Notes'] : '', ENT_QUOTES, 'UTF-8') . '</textarea>
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="RecordReview" value="' . __('Record Review') . '" /></div>
+		</form>';
+
+	/* ---- History: reviews (immutable) ---- */
+	$HistResult = DB_query("SELECT reviewdate, reviewedby, outcome, oldlimit, newlimit, notes, nextreviewdate
+							FROM creditreviews
+							WHERE debtorno='" . DB_escape_string($DebtorNo) . "'
+							ORDER BY reviewid DESC");
+	echo '<br /><table class="selection"><tr><th colspan="7">' . __('Review history') . '</th></tr>
+			<tr><th>' . __('Date') . '</th><th>' . __('By') . '</th><th>' . __('Outcome') . '</th><th>' . __('Old limit') . '</th><th>' . __('New limit') . '</th><th>' . __('Next review') . '</th><th>' . __('Notes') . '</th></tr>';
+	while ($Row = DB_fetch_array($HistResult)) {
+		echo '<tr class="striped_row">
+				<td>' . $Row['reviewdate'] . '</td>
+				<td>' . htmlspecialchars($Row['reviewedby'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td>' . (isset($Outcomes[$Row['outcome']]) ? $Outcomes[$Row['outcome']] : htmlspecialchars($Row['outcome'], ENT_QUOTES, 'UTF-8')) . '</td>
+				<td class="number">' . locale_number_format($Row['oldlimit'], $Cust['decimalplaces']) . '</td>
+				<td class="number">' . locale_number_format($Row['newlimit'], $Cust['decimalplaces']) . '</td>
+				<td>' . ConvertSQLDate($Row['nextreviewdate']) . '</td>
+				<td>' . nl2br(htmlspecialchars($Row['notes'], ENT_QUOTES, 'UTF-8')) . '</td>
+			</tr>';
+	}
+	echo '</table>';
+
+	/* ---- History: full credit control audit log ---- */
+	$LogResult = DB_query("SELECT eventdate, userid, eventtype, oldvalue, newvalue, reason

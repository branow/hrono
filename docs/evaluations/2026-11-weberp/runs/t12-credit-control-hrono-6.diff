diff --git a/CreditCharges.php b/CreditCharges.php
new file mode 100644
index 0000000..2f55b45
--- /dev/null
+++ b/CreditCharges.php
@@ -0,0 +1,180 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Month End Interest and Late Fees');
+$ViewTopic = 'CreditControl';
+$BookMark = 'InterestFees';
+include('includes/header.php');
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_add.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Company = $_SESSION['CompanyRecord'];
+$Problems = 0;
+if ($_SESSION['CreditInterestRate'] <= 0 and $_SESSION['CreditLateFee'] <= 0) {
+	prnMsg(__('Neither an interest rate nor a late fee has been set up. Set them in the credit control setup first'), 'warn');
+	$Problems++;
+}
+if ($Company['gllink_debtors'] == 1) {
+	if ($_SESSION['CreditInterestRate'] > 0 and ($Company['creditinterestact'] == '0' or $Company['creditinterestact'] == '')) {
+		prnMsg(__('The interest income GL account has not been chosen. Set it in Company Preferences first'), 'error');
+		$Problems++;
+	}
+	if ($_SESSION['CreditLateFee'] > 0 and ($Company['creditfeeact'] == '0' or $Company['creditfeeact'] == '')) {
+		prnMsg(__('The late fee income GL account has not been chosen. Set it in Company Preferences first'), 'error');
+		$Problems++;
+	}
+}
+
+/* ---- waive charges ---- */
+if (isset($_POST['WaiveCharges']) and CreditControlCanAct()) {
+	if (mb_strlen(trim($_POST['WaiveReason'])) < 3) {
+		prnMsg(__('A reason must be entered to waive a charge'), 'error');
+	} else {
+		$Waived = 0;
+		if (isset($_POST['Waive'])) {
+			foreach ($_POST['Waive'] as $ChargeID => $Value) {
+				if (CreditWaiveCharge((int) $ChargeID, $_POST['WaiveReason'], date('Y-m-d')) !== false) {
+					$Waived++;
+				} else {
+					prnMsg(__('Charge') . ' ' . (int) $ChargeID . ' ' . __('could not be waived. It may be waived already or paid'), 'warn');
+				}
+			}
+		}
+		prnMsg($Waived . ' ' . __('charges have been waived and reversed in the general ledger'), 'success');
+	}
+}
+
+/* ---- the month and date to charge ---- */
+$ChargeMonth = (isset($_POST['ChargeMonth']) and preg_match('/^\d{4}-\d{2}$/', $_POST['ChargeMonth'])) ? $_POST['ChargeMonth'] : date('Y-m');
+$ChargeDate = (isset($_POST['ChargeDate']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['ChargeDate'])) ? $_POST['ChargeDate'] : date('Y-m-d');
+
+if (isset($_POST['PostCharges']) and CreditControlCanAct() and $Problems == 0) {
+
+	/* worked out again now, a customer already charged for the month is never charged again */
+	$Candidates = CreditChargeCandidates($ChargeDate, $ChargeMonth);
+	$Posted = 0;
+	if (!isset($_POST['Include'])) {
+		$_POST['Include'] = array();
+	}
+	foreach ($_POST['Include'] as $DebtorNo => $Value) {
+		if (!isset($Candidates[$DebtorNo])) {
+			continue;
+		}
+		$Customer = $Candidates[$DebtorNo];
+		if ($Customer['interest'] > 0) {
+			CreditPostCharge($Customer, 'interest', $Customer['interest'], $ChargeMonth, $ChargeDate);
+			$Posted++;
+		}
+		if ($Customer['fee'] > 0) {
+			CreditPostCharge($Customer, 'fee', $Customer['fee'], $ChargeMonth, $ChargeDate);
+			$Posted++;
+		}
+	}
+	prnMsg($Posted . ' ' . __('charges have been posted for') . ' ' . $ChargeMonth, 'success');
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Charge') . '</legend>
+			<field>
+				<label for="ChargeMonth">' . __('Month being charged') . ':</label>
+				<input type="month" name="ChargeMonth" value="' . $ChargeMonth . '" required="required" />
+			</field>
+			<field>
+				<label for="ChargeDate">' . __('Charges are dated and overdue is worked out at') . ':</label>
+				<input type="date" name="ChargeDate" value="' . $ChargeDate . '" required="required" />
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Preview" value="' . __('Show What Will Be Charged') . '" /></div>';
+
+if ($Problems == 0) {
+	$Candidates = CreditChargeCandidates($ChargeDate, $ChargeMonth);
+	if (count($Candidates) == 0) {
+		prnMsg(__('Nobody is due interest or a late fee for') . ' ' . $ChargeMonth, 'info');
+	} else {
+		echo '<div class="page_help_text">' . __('Interest is charged on invoices overdue by more than the grace days. Customers who are exempt, and invoices that are disputed, are left out. A customer already charged for the month is shown but never charged again.') . '</div>';
+		echo '<table class="selection">
+				<tr><th>' . __('Charge') . '</th><th>' . __('Customer') . '</th><th>' . __('Name') . '</th><th>' . __('Overdue balance charged on') . '</th><th>' . __('Interest') . '</th><th>' . __('Late fee') . '</th><th>' . __('Note') . '</th></tr>';
+		$TotalInterest = 0;
+		$TotalFee = 0;
+		foreach ($Candidates as $DebtorNo => $Customer) {
+			$Note = '';
+			if ($Customer['alreadycharged']) {
+				$Note = __('Already charged for this month');
+			}
+			if ($Customer['interestexempt'] == 1 or $Customer['feeexempt'] == 1) {
+				$Note .= ' ' . __('Exempt') . ': ' . ($Customer['interestexempt'] == 1 ? __('interest') . ' ' : '') . ($Customer['feeexempt'] == 1 ? __('late fee') : '');
+			}
+			$TotalInterest += $Customer['interest'] / $Customer['rate'];
+			$TotalFee += $Customer['fee'] / $Customer['rate'];
+			echo '<tr class="striped_row">
+					<td>' . (($Customer['interest'] > 0 or $Customer['fee'] > 0) ? '<input type="checkbox" name="Include[' . $DebtorNo . ']" checked="checked" />' : '') . '</td>
+					<td><a href="' . $RootPath . '/CreditReview.php?DebtorNo=' . urlencode($DebtorNo) . '">' . $DebtorNo . '</a></td>
+					<td>' . $Customer['name'] . '</td>
+					<td class="number">' . $Customer['currcode'] . ' ' . locale_number_format($Customer['base'], $Customer['decimalplaces']) . '</td>
+					<td class="number">' . locale_number_format($Customer['interest'], $Customer['decimalplaces']) . '</td>
+					<td class="number">' . locale_number_format($Customer['fee'], $Customer['decimalplaces']) . '</td>
+					<td>' . $Note . '</td>
+				</tr>';
+		}
+		echo '<tr><td colspan="4"><b>' . __('Totals in') . ' ' . $Company['currencydefault'] . '</b></td><td class="number"><b>' . locale_number_format($TotalInterest, 2) . '</b></td><td class="number"><b>' . locale_number_format($TotalFee, 2) . '</b></td><td></td></tr>
+			</table>';
+		if (CreditControlCanAct()) {
+			echo '<div class="centre"><input type="submit" name="PostCharges" value="' . __('Confirm and Post the Ticked Charges') . '" onclick="return confirm(\'' . __('Post these charges to the customer accounts and the general ledger?') . '\');" /></div>';
+		}
+	}
+}
+echo '</form>';
+
+/* ---- recent charges, with the means to waive them ---- */
+$Result = DB_query("SELECT creditcharges.chargeid,
+							creditcharges.debtorno,
+							creditcharges.chargemonth,
+							creditcharges.chargetype,
+							creditcharges.transno,
+							creditcharges.amount,
+							creditcharges.currabrev,
+							creditcharges.waived,
+							creditcharges.waivereason,
+							debtorsmaster.name,
+							currencies.decimalplaces,
+							COALESCE(debtortrans.balance, 0) AS balance
+					FROM creditcharges
+					INNER JOIN debtorsmaster ON creditcharges.debtorno = debtorsmaster.debtorno
+					INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+					LEFT JOIN debtortrans ON debtortrans.type = 51 AND debtortrans.transno = creditcharges.transno AND debtortrans.debtorno = creditcharges.debtorno
+					ORDER BY creditcharges.chargeid DESC
+					LIMIT 200");
+if (DB_num_rows($Result) > 0) {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<table class="selection">
+			<tr><th colspan="8">' . __('Charges posted - the latest 200') . '</th></tr>
+			<tr><th>' . __('Month') . '</th><th>' . __('Customer') . '</th><th>' . __('Name') . '</th><th>' . __('Charge') . '</th><th>' . __('Number') . '</th><th>' . __('Amount') . '</th><th>' . __('Still owing') . '</th><th>' . __('Waive') . '</th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . $MyRow['chargemonth'] . '</td>
+				<td><a href="' . $RootPath . '/CreditReview.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . $MyRow['debtorno'] . '</a></td>
+				<td>' . $MyRow['name'] . '</td>
+				<td>' . ($MyRow['chargetype'] == 'interest' ? __('Interest') : __('Late fee')) . '</td>
+				<td class="number">' . $MyRow['transno'] . '</td>
+				<td class="number">' . $MyRow['currabrev'] . ' ' . locale_number_format($MyRow['amount'], $MyRow['decimalplaces']) . '</td>
+				<td class="number">' . locale_number_format($MyRow['balance'], $MyRow['decimalplaces']) . '</td>
+				<td>' . ($MyRow['waived'] ? __('Waived') . ': ' . $MyRow['waivereason'] : ((CreditControlCanAct() and $MyRow['balance'] > 0.00001) ? '<input type="checkbox" name="Waive[' . $MyRow['chargeid'] . ']" />' : '')) . '</td>
+			</tr>';
+	}
+	echo '</table>';
+	if (CreditControlCanAct()) {
+		echo '<div class="centre">' . __('Reason for waiving') . ': <input type="text" name="WaiveReason" size="50" maxlength="150" />
+				<input type="submit" name="WaiveCharges" value="' . __('Waive the Ticked Charges') . '" /></div>';
+	}
+	echo '</form>';
+}
+
+include('includes/footer.php');
diff --git a/CreditControlReport.php b/CreditControlReport.php
new file mode 100644
index 0000000..0f31e0c
--- /dev/null
+++ b/CreditControlReport.php
@@ -0,0 +1,245 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Control Report');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditControlReport';
+include('includes/header.php');
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/reports.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$CanAct = CreditControlCanAct();
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$IsRep = (isset($_SESSION['SalesmanLogin']) and $_SESSION['SalesmanLogin'] != '');
+
+/* Credit control releases an order held for credit, or an order taken before the customer was put on stop */
+if ($CanAct and isset($_POST['ReleaseOrder'])) {
+	foreach ($_POST['ReleaseOrder'] as $OrderNo => $Value) {
+		$Result = DB_query("SELECT debtorno FROM salesorders WHERE orderno='" . (int) $OrderNo . "'");
+		if (DB_num_rows($Result) == 1) {
+			$MyRow = DB_fetch_row($Result);
+			DB_query("UPDATE salesorders SET creditstatus = 2 WHERE orderno='" . (int) $OrderNo . "'");
+			CreditControlLog($MyRow[0], 'orderreleased', __('Order released by credit control') . ': ' . $_POST['ReleaseNotes'], 0, '', (int) $OrderNo);
+			prnMsg(__('Order') . ' ' . (int) $OrderNo . ' ' . __('has been released'), 'success');
+		}
+	}
+}
+
+if (isset($_POST['Salesman']) and !$IsRep) {
+	$Salesman = $_POST['Salesman'];
+} elseif ($IsRep) {
+	$Salesman = $_SESSION['SalesmanLogin'];
+} else {
+	$Salesman = '';
+}
+$Currency = isset($_POST['Currency']) ? $_POST['Currency'] : '';
+$ReviewDays = isset($_POST['ReviewDays']) ? (int) $_POST['ReviewDays'] : 14;
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Selection') . '</legend>';
+if ($IsRep) {
+	echo '<field><label>' . __('Sales person') . ':</label><fieldtext>' . $_SESSION['UsersRealName'] . '</fieldtext></field>';
+} else {
+	echo '<field><label for="Salesman">' . __('Sales person') . ':</label><select name="Salesman"><option value="">' . __('All sales people') . '</option>';
+	$Result = DB_query("SELECT salesmancode, salesmanname FROM salesman ORDER BY salesmanname");
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<option value="' . $MyRow['salesmancode'] . '"' . ($Salesman == $MyRow['salesmancode'] ? ' selected="selected"' : '') . '>' . $MyRow['salesmanname'] . '</option>';
+	}
+	echo '</select></field>';
+}
+echo '<field><label for="Currency">' . __('Currency') . ':</label><select name="Currency"><option value="">' . __('All currencies') . '</option>';
+$Result = DB_query("SELECT currabrev, currency FROM currencies ORDER BY currency");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option value="' . $MyRow['currabrev'] . '"' . ($Currency == $MyRow['currabrev'] ? ' selected="selected"' : '') . '>' . $MyRow['currabrev'] . ' - ' . $MyRow['currency'] . '</option>';
+}
+echo '</select></field>
+		<field>
+			<label for="ReviewDays">' . __('Include reviews falling due within (days)') . ':</label>
+			<input type="text" class="integer" name="ReviewDays" size="4" maxlength="3" value="' . $ReviewDays . '" />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Show" value="' . __('Show Report') . '" /></div>';
+
+$Where = "";
+if ($Salesman != '') {
+	$Where .= " AND EXISTS (SELECT 1 FROM custbranch WHERE custbranch.debtorno = debtorsmaster.debtorno AND custbranch.salesman = '" . $Salesman . "')";
+}
+if ($Currency != '') {
+	$Where .= " AND debtorsmaster.currcode = '" . $Currency . "'";
+}
+
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				debtorsmaster.creditlimit,
+				debtorsmaster.nextreviewdate,
+				holdreasons.reasondescription,
+				holdreasons.dissallowinvoices,
+				currencies.rate,
+				currencies.decimalplaces,
+				COALESCE((SELECT SUM(balance) FROM debtortrans WHERE debtortrans.debtorno = debtorsmaster.debtorno), 0) AS balance
+		FROM debtorsmaster
+		INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+		LEFT JOIN holdreasons ON debtorsmaster.holdreason = holdreasons.reasoncode
+		WHERE 1 = 1" . $Where . "
+		ORDER BY debtorsmaster.name";
+$Result = DB_query($SQL, __('The customers could not be retrieved because'));
+$Customers = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	$MyRow['rate'] = ($MyRow['rate'] > 0) ? $MyRow['rate'] : 1;
+	$MyRow['effect'] = ($MyRow['dissallowinvoices'] == 1) ? 1 : (($MyRow['dissallowinvoices'] == 2) ? 2 : 0);
+	$Customers[$MyRow['debtorno']] = $MyRow;
+}
+$LastLetters = CreditLastLetters();
+$Today = date('Y-m-d');
+$ReviewCutoff = date('Y-m-d', strtotime('+' . $ReviewDays . ' days'));
+
+function CreditReportTableHead($Heading, $Columns) {
+	echo '<br /><table class="selection"><tr><th colspan="' . count($Columns) . '">' . $Heading . '</th></tr><tr>';
+	foreach ($Columns as $Column) {
+		echo '<th>' . $Column . '</th>';
+	}
+	echo '</tr>';
+}
+
+/* 1. reviews due or overdue */
+CreditReportTableHead(__('Customers due or overdue for a credit review'), array(__('Customer'), __('Name'), __('Status'), __('Next review'), __('Overdue by (days)'), __('Credit limit'), __('Balance'), ''));
+$Total = 0;
+$Count = 0;

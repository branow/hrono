diff --git a/CreditDebtorsReconciliation.php b/CreditDebtorsReconciliation.php
new file mode 100644
index 0000000..97d4ed4
--- /dev/null
+++ b/CreditDebtorsReconciliation.php
@@ -0,0 +1,167 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Debtors Control Reconciliation');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditReconciliation';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/reports.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$DebtorsAct = $_SESSION['CompanyRecord']['debtorsact'];
+$Decimals = $_SESSION['CompanyRecord']['decimalplaces'];
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+
+$Result = DB_query("SELECT MAX(periodno) FROM periods");
+$MyRow = DB_fetch_row($Result);
+$LatestPeriod = $MyRow[0];
+$ToPeriod = isset($_POST['ToPeriod']) ? (int) $_POST['ToPeriod'] : (int) GetPeriod(date($_SESSION['DefaultDateFormat']));
+
+echo '<div class="page_help_text">' . __('This compares the customer accounts with the debtors control account in the general ledger, transaction type by transaction type, so a difference can be traced to the kind of posting that caused it. Customer transactions are converted at the rate they were posted at, which is the value the ledger holds.') . '</div>';
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Reconcile up to the end of') . '</legend>
+			<field><label for="ToPeriod">' . __('Period') . ':</label><select name="ToPeriod">';
+$Result = DB_query("SELECT periodno, lastdate_in_period FROM periods ORDER BY periodno DESC");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option value="' . $MyRow['periodno'] . '"' . ($MyRow['periodno'] == $ToPeriod ? ' selected="selected"' : '') . '>' . MonthAndYearFromSQLDate($MyRow['lastdate_in_period']) . '</option>';
+}
+echo '</select></field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Show" value="' . __('Reconcile') . '" /></div>
+	</form>';
+
+if ($_SESSION['CompanyRecord']['gllink_debtors'] != 1) {
+	prnMsg(__('General ledger entries are not created for accounts receivable transactions so there is nothing to reconcile'), 'info');
+	include('includes/footer.php');
+	exit();
+}
+
+/* the customer ledger by type, at the rate each transaction was posted at */
+$Types = array();
+$Result = DB_query("SELECT debtortrans.type,
+							systypes.typename,
+							SUM((debtortrans.ovamount + debtortrans.ovgst + debtortrans.ovfreight + debtortrans.ovdiscount) / IF(debtortrans.rate = 0, 1, debtortrans.rate)) AS homeamount
+					FROM debtortrans
+					INNER JOIN systypes ON debtortrans.type = systypes.typeid
+					WHERE debtortrans.prd <= '" . $ToPeriod . "'
+					GROUP BY debtortrans.type, systypes.typename");
+while ($MyRow = DB_fetch_array($Result)) {
+	$Types[$MyRow['type']] = array('name' => $MyRow['typename'], 'customers' => $MyRow['homeamount'], 'gl' => 0);
+}
+/* what the ledger holds on the debtors control account for each type */
+$Result = DB_query("SELECT gltrans.type,
+							systypes.typename,
+							SUM(gltrans.amount) AS amount
+					FROM gltrans
+					INNER JOIN systypes ON gltrans.type = systypes.typeid
+					WHERE gltrans.account = '" . $DebtorsAct . "'
+						AND gltrans.periodno <= '" . $ToPeriod . "'
+					GROUP BY gltrans.type, systypes.typename");
+while ($MyRow = DB_fetch_array($Result)) {
+	if (!isset($Types[$MyRow['type']])) {
+		$Types[$MyRow['type']] = array('name' => $MyRow['typename'], 'customers' => 0, 'gl' => 0);
+	}
+	$Types[$MyRow['type']]['gl'] = $MyRow['amount'];
+}
+ksort($Types);
+
+echo '<table class="selection">
+		<tr><th>' . __('Type') . '</th><th>' . __('Description') . '</th><th>' . __('Customer accounts') . ' (' . $HomeCurrency . ')</th><th>' . __('Debtors control in the ledger') . '</th><th>' . __('Difference') . '</th></tr>';
+$TotalCustomers = 0;
+$TotalGL = 0;
+foreach ($Types as $Type => $Row) {
+	$Difference = round($Row['customers'] - $Row['gl'], $Decimals);
+	$TotalCustomers += $Row['customers'];
+	$TotalGL += $Row['gl'];
+	echo '<tr class="striped_row">
+			<td class="number">' . $Type . '</td>
+			<td>' . __($Row['name']) . '</td>
+			<td class="number">' . locale_number_format($Row['customers'], $Decimals) . '</td>
+			<td class="number">' . locale_number_format($Row['gl'], $Decimals) . '</td>
+			<td class="number" style="color:' . ($Difference == 0 ? 'green' : 'red') . '">' . locale_number_format($Difference, $Decimals) . '</td>
+		</tr>';
+}
+$TotalDifference = round($TotalCustomers - $TotalGL, $Decimals);
+echo '<tr><td colspan="2"><b>' . __('Total') . '</b></td>
+		<td class="number"><b>' . locale_number_format($TotalCustomers, $Decimals) . '</b></td>
+		<td class="number"><b>' . locale_number_format($TotalGL, $Decimals) . '</b></td>
+		<td class="number" style="color:' . ($TotalDifference == 0 ? 'green' : 'red') . '"><b>' . locale_number_format($TotalDifference, $Decimals) . '</b></td></tr>
+	</table>';
+
+if ($TotalDifference == 0) {
+	prnMsg(__('The customer accounts agree with the debtors control account'), 'success');
+} else {
+	prnMsg(__('The customer accounts and the debtors control account do not agree. The types with a difference above, and the transactions listed below, show where to look'), 'warn');
+}
+
+/* what the customers owe now, at today's rates, for comparison when this is the latest period */
+if ($ToPeriod == $LatestPeriod) {
+	$Result = DB_query("SELECT SUM(debtortrans.balance / IF(currencies.rate = 0, 1, currencies.rate))
+						FROM debtortrans
+						INNER JOIN debtorsmaster ON debtortrans.debtorno = debtorsmaster.debtorno
+						INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev");
+	$MyRow = DB_fetch_row($Result);
+	echo '<div class="page_help_text">' . __('The customer balances revalued at todays exchange rates are') . ' ' . $HomeCurrency . ' ' . locale_number_format($MyRow[0], $Decimals) . '. '
+		. __('A difference between this and the ledger is exchange rate movement on foreign currency balances that has not been posted to the ledger.') . '</div>';
+}
+
+/* ledger entries on the control account that no customer transaction explains, such as manual journals */
+$Result = DB_query("SELECT gltrans.type, gltrans.typeno, gltrans.trandate, gltrans.narrative, gltrans.amount
+					FROM gltrans
+					WHERE gltrans.account = '" . $DebtorsAct . "'
+						AND gltrans.periodno <= '" . $ToPeriod . "'
+						AND NOT EXISTS (SELECT 1 FROM debtortrans WHERE debtortrans.type = gltrans.type AND debtortrans.transno = gltrans.typeno)
+					ORDER BY gltrans.trandate DESC
+					LIMIT 50");
+echo '<br /><table class="selection">
+		<tr><th colspan="5">' . __('Entries on the debtors control account with no customer transaction behind them (the latest 50)') . '</th></tr>
+		<tr><th>' . __('Type') . '</th><th>' . __('Number') . '</th><th>' . __('Date') . '</th><th>' . __('Narrative') . '</th><th>' . __('Amount') . '</th></tr>';
+if (DB_num_rows($Result) == 0) {
+	echo '<tr><td colspan="5">' . __('None') . '</td></tr>';
+}
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td class="number">' . $MyRow['type'] . '</td>
+			<td class="number"><a href="' . $RootPath . '/GLTransInquiry.php?TypeID=' . $MyRow['type'] . '&amp;TransNo=' . $MyRow['typeno'] . '">' . $MyRow['typeno'] . '</a></td>
+			<td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+			<td>' . $MyRow['narrative'] . '</td>
+			<td class="number">' . locale_number_format($MyRow['amount'], $Decimals) . '</td>
+		</tr>';
+}
+echo '</table>';
+
+/* customer transactions that put nothing on the control account */
+$Result = DB_query("SELECT debtortrans.type, debtortrans.transno, debtortrans.debtorno, debtortrans.trandate,
+							(debtortrans.ovamount + debtortrans.ovgst + debtortrans.ovfreight + debtortrans.ovdiscount) / IF(debtortrans.rate = 0, 1, debtortrans.rate) AS homeamount
+					FROM debtortrans
+					WHERE debtortrans.prd <= '" . $ToPeriod . "'
+						AND (debtortrans.ovamount + debtortrans.ovgst + debtortrans.ovfreight + debtortrans.ovdiscount) <> 0
+						AND NOT EXISTS (SELECT 1 FROM gltrans
+										WHERE gltrans.type = debtortrans.type
+											AND gltrans.typeno = debtortrans.transno
+											AND gltrans.account = '" . $DebtorsAct . "')
+					ORDER BY debtortrans.trandate DESC
+					LIMIT 50");
+echo '<br /><table class="selection">
+		<tr><th colspan="5">' . __('Customer transactions with no entry on the debtors control account (the latest 50)') . '</th></tr>
+		<tr><th>' . __('Type') . '</th><th>' . __('Number') . '</th><th>' . __('Customer') . '</th><th>' . __('Date') . '</th><th>' . __('Amount') . '</th></tr>';
+if (DB_num_rows($Result) == 0) {
+	echo '<tr><td colspan="5">' . __('None') . '</td></tr>';
+}
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td class="number">' . $MyRow['type'] . '</td>
+			<td class="number">' . $MyRow['transno'] . '</td>
+			<td>' . $MyRow['debtorno'] . '</td>
+			<td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+			<td class="number">' . locale_number_format($MyRow['homeamount'], $Decimals) . '</td>
+		</tr>';
+}
+echo '</table>';
+
+include('includes/footer.php');
diff --git a/CreditDunningRun.php b/CreditDunningRun.php
new file mode 100644
index 0000000..8763aec
--- /dev/null
+++ b/CreditDunningRun.php
@@ -0,0 +1,119 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Overdue Reminder Run');
+$ViewTopic = 'CreditControl';
+$BookMark = 'DunningLetters';
+include('includes/header.php');
+include('includes/SQL_CommonFunctions.php');
+require_once('includes/MiscFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/email.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$AsAt = date('Y-m-d');
+$Stages = CreditDunningStages();
+
+if (count($Stages) == 0) {
+	prnMsg(__('There are no reminder letter stages set up. Set them up in the credit control setup first'), 'error');
+	echo '<div class="centre"><a href="' . $RootPath . '/CreditControlSetup.php">' . __('Credit Control Setup') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+if (isset($_POST['SendLetters'])) {
+
+	/* What goes out is worked out again now, not taken from the screen. A customer who has paid since the preview gets nothing,
+	and a customer who has moved to another stage in the meantime is left for the next run. */
+	$Candidates = CreditDunningCandidates($AsAt);
+	$From = $_SESSION['CompanyRecord']['email'];
+	$Sent = 0;
+	$ToPost = array();
+	if (!isset($_POST['Include'])) {
+		$_POST['Include'] = array();
+	}
+	foreach ($_POST['Include'] as $DebtorNo => $Value) {
+		if (!isset($Candidates[$DebtorNo])) {
+			prnMsg($DebtorNo . ': ' . __('no letter was sent, the customer is no longer due one'), 'info');
+			continue;
+		}
+		$Customer = $Candidates[$DebtorNo];
+		if ($Customer['stage'] != $_POST['Stage'][$DebtorNo]) {
+			prnMsg($DebtorNo . ': ' . __('no letter was sent, the stage due has changed since the list was shown'), 'info');
+			continue;
+		}
+		$Letter = CreditLetterText($Stages[$Customer['stage']], $Customer);
+		$To = CreditAccountsContacts($DebtorNo);
+		$InvoiceList = $Letter['invoices'];
+		if (count($To) > 0) {
+			$Response = SendEmailFromWebERP($From, $To, $Letter['subject'], $Letter['body'], '', true);
+			if ($Response === true) {
+				$Method = 'email';
+				$SentTo = implode(', ', array_keys($To));
+			} else {
+				prnMsg($DebtorNo . ': ' . __('the email could not be sent') . ' - ' . (is_string($Response) ? $Response : ''), 'error');
+				continue;
+			}
+		} else {
+			$Method = 'post';
+			$SentTo = '';
+			$ToPost[$DebtorNo] = $Letter;
+		}
+		DB_query("INSERT INTO dunningletters (debtorno, stage, sentdate, userid, method, sentto, amount, currabrev, invoices)
+					VALUES ('" . $DebtorNo . "', '" . $Customer['stage'] . "', NOW(), '" . $_SESSION['UserID'] . "', '" . $Method . "', '" . DB_escape_string($SentTo) . "',
+							'" . $Customer['overdue'] . "', '" . $Customer['currcode'] . "', '" . DB_escape_string($InvoiceList) . "')",
+				__('The reminder could not be recorded because'));
+		CreditControlLog($DebtorNo, 'reminder', __('Reminder stage') . ' ' . $Customer['stage'] . ' ' . ($Method == 'email' ? __('emailed to') . ' ' . $SentTo : __('to be posted')), $Customer['overdue'], $Customer['currcode'], $Customer['stage']);
+		$Sent++;
+		if ($Customer['stage'] == max(array_keys($Stages)) and $_SESSION['DunningAutoStop'] == 1) {
+			CreditChangeStatus($DebtorNo, 1, __('Put on stop automatically when the final notice was sent'));
+		}
+	}
+	prnMsg($Sent . ' ' . __('reminder letters have been sent or are ready to post'), 'success');
+
+	if (count($ToPost) > 0) {
+		echo '<h3>' . __('These customers have no email address for their accounts contact. Print and post these letters') . '</h3>';
+		foreach ($ToPost as $DebtorNo => $Letter) {
+			echo '<div class="page_help_text"><b>' . $DebtorNo . '</b> - ' . htmlspecialchars($Letter['subject'], ENT_QUOTES, 'UTF-8') . '<br />' . nl2br(htmlspecialchars($Letter['body'], ENT_QUOTES, 'UTF-8')) . '</div>';
+		}
+	}
+	echo '<div class="centre"><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">' . __('Back to the reminder run') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* the preview: who would get which letter */
+$Candidates = CreditDunningCandidates($AsAt);
+echo '<div class="page_help_text">' . __('This is who gets which letter now. A customer moves up one stage at a time and only while still overdue. Untick the customers you do not want to write to this time, for example where a payment has been promised or there is a dispute.') . '</div>';
+
+if (count($Candidates) == 0) {
+	prnMsg(__('No customers are due a reminder letter at the moment'), 'info');
+	include('includes/footer.php');
+	exit();
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<table class="selection">
+		<tr><th>' . __('Send') . '</th><th>' . __('Customer') . '</th><th>' . __('Name') . '</th><th>' . __('Stage') . '</th><th>' . __('Days overdue') . '</th><th>' . __('Overdue') . '</th><th>' . __('Goes to') . '</th></tr>';
+foreach ($Candidates as $DebtorNo => $Customer) {
+	$To = CreditAccountsContacts($DebtorNo);
+	echo '<tr class="striped_row">
+			<td><input type="checkbox" name="Include[' . $DebtorNo . ']" checked="checked" />
+				<input type="hidden" name="Stage[' . $DebtorNo . ']" value="' . $Customer['stage'] . '" /></td>
+			<td><a href="' . $RootPath . '/CreditReview.php?DebtorNo=' . urlencode($DebtorNo) . '">' . $DebtorNo . '</a></td>
+			<td>' . $Customer['name'] . '</td>
+			<td class="number">' . $Customer['stage'] . ' / ' . count($Stages) . '</td>
+			<td class="number">' . $Customer['maxdays'] . '</td>
+			<td class="number">' . $Customer['currcode'] . ' ' . locale_number_format($Customer['overdue'], $Customer['decimalplaces']) . '</td>
+			<td>' . (count($To) > 0 ? implode(', ', array_keys($To)) : '<b>' . __('No email address - letter to be posted') . '</b>') . '</td>
+		</tr>';
+}
+echo '</table>
+		<div class="centre"><input type="submit" name="SendLetters" value="' . __('Send the Ticked Letters') . '" onclick="return confirm(\'' . __('Send the reminder letters to the ticked customers?') . '\');" /></div>
+	</form>';
+
+include('includes/footer.php');
diff --git a/CreditReview.php b/CreditReview.php
new file mode 100644
index 0000000..c0fbba8
--- /dev/null
+++ b/CreditReview.php
@@ -0,0 +1,377 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Customer Credit Review');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditReviews';
+include('includes/header.php');
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper($_GET['DebtorNo']);
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper($_POST['DebtorNo']);
+} elseif (isset($_SESSION['CustomerID']) and $_SESSION['CustomerID'] != '') {
+	$DebtorNo = $_SESSION['CustomerID'];
+} else {
+	$DebtorNo = '';
+}
+
+if ($DebtorNo == '' or GetCreditStatus($DebtorNo) === false) {
+	if ($DebtorNo != '') {
+		prnMsg(__('There is no customer with the code') . ' ' . $DebtorNo, 'error');
+	}
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<fieldset>
+				<legend>' . __('Select the customer') . '</legend>
+				<field>
+					<label for="DebtorNo">' . __('Customer code') . ':</label>
+					<input type="text" name="DebtorNo" size="12" maxlength="10" autofocus="autofocus" />
+				</field>
+			</fieldset>
+			<div class="centre">
+				<input type="submit" name="Select" value="' . __('Show') . '" />
+				<a href="' . $RootPath . '/SelectCustomer.php">' . __('Search for a customer') . '</a>
+			</div>
+		</form>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* A sales rep sees only their own customers */
+if (!CreditControlCanSee($DebtorNo)) {
+	prnMsg(__('You have no authority to review the credit information of this customer'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$CanAct = CreditControlCanAct();
+$Customer = GetCreditStatus($DebtorNo);
+$CurrDecimalPlaces = 2;
+$Result = DB_query("SELECT decimalplaces FROM currencies WHERE currabrev='" . $Customer['currcode'] . "'");
+if (DB_num_rows($Result) == 1) {
+	$MyRow = DB_fetch_row($Result);
+	$CurrDecimalPlaces = $MyRow[0];
+}
+
+if ($CanAct and isset($_POST['RecordReview'])) {
+
+	$InputError = 0;
+	$Outcome = $_POST['Outcome'];
+	if (!in_array($Outcome, array('confirmed', 'raised', 'reduced', 'watch', 'stop', 'normal'))) {
+		$InputError = 1;
+		prnMsg(__('Select the outcome of the review'), 'error');
+	}
+	$NewLimit = filter_number_format($_POST['NewLimit']);
+	if (!is_numeric($NewLimit) or $NewLimit < 0) {
+		$InputError = 1;
+		prnMsg(__('The new credit limit must be a number that is not negative'), 'error');
+	} elseif ($Outcome == 'confirmed' and abs($NewLimit - $Customer['creditlimit']) > 0.001) {
+		$InputError = 1;
+		prnMsg(__('The outcome is limit confirmed but the limit entered is different. Choose raised or reduced to change the limit'), 'error');
+	} elseif ($Outcome == 'raised' and $NewLimit <= $Customer['creditlimit']) {
+		$InputError = 1;
+		prnMsg(__('The outcome is limit raised but the new limit is not higher than the present limit'), 'error');
+	} elseif ($Outcome == 'reduced' and $NewLimit >= $Customer['creditlimit']) {
+		$InputError = 1;
+		prnMsg(__('The outcome is limit reduced but the new limit is not lower than the present limit'), 'error');
+	}
+	if (in_array($Outcome, array('watch', 'stop', 'normal')) and mb_strlen(trim($_POST['Notes'])) < 3) {
+		$InputError = 1;
+		prnMsg(__('A reason must be entered in the notes when a customer is put on watch, put on stop or taken off'), 'error');
+	}
+	if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['NextReviewDate']) or !checkdate(substr($_POST['NextReviewDate'], 5, 2), substr($_POST['NextReviewDate'], 8, 2), substr($_POST['NextReviewDate'], 0, 4))) {
+		$InputError = 1;
+		prnMsg(__('The next review date is not a valid date'), 'error');
+	} elseif ($_POST['NextReviewDate'] < date('Y-m-d')) {
+		$InputError = 1;
+		prnMsg(__('The next review date cannot be in the past'), 'error');
+	}
+	$StatusEffect = array('watch' => 2, 'stop' => 1, 'normal' => 0);
+	if (isset($StatusEffect[$Outcome]) and CreditReasonCode($StatusEffect[$Outcome]) === false) {
+		$InputError = 1;
+		prnMsg(__('There is no credit status defined for this outcome. Set one up in the credit status maintenance first'), 'error');
+	}
+
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+		$OldHoldReason = $Customer['holdreason'];
+		if (isset($StatusEffect[$Outcome])) {
+			CreditChangeStatus($DebtorNo, $StatusEffect[$Outcome], $_POST['Notes']);
+		}
+		$After = GetCreditStatus($DebtorNo);
+		DB_query("UPDATE debtorsmaster SET creditlimit = '" . $NewLimit . "',
+											lastreviewdate = CURRENT_DATE,
+											nextreviewdate = '" . $_POST['NextReviewDate'] . "'
+					WHERE debtorno = '" . $DebtorNo . "'",
+				__('The customer could not be updated because'), '', true);
+		DB_query("INSERT INTO creditreviews (debtorno,
+											reviewdate,
+											userid,
+											outcome,
+											oldcreditlimit,
+											newcreditlimit,
+											oldholdreason,
+											newholdreason,
+											notes,
+											nextreviewdate)
+									VALUES ('" . $DebtorNo . "',
+											CURRENT_DATE,
+											'" . $_SESSION['UserID'] . "',
+											'" . $Outcome . "',
+											'" . $Customer['creditlimit'] . "',
+											'" . $NewLimit . "',
+											'" . $OldHoldReason . "',
+											'" . $After['holdreason'] . "',
+											'" . $_POST['Notes'] . "',
+											'" . $_POST['NextReviewDate'] . "')",
+				__('The review could not be recorded because'), '', true);
+		CreditControlLog($DebtorNo, 'review', __('Credit review') . ': ' . $Outcome . '. ' . $_POST['Notes'] . ' (' . __('next review') . ' ' . ConvertSQLDate($_POST['NextReviewDate']) . ')');
+		if (abs($NewLimit - $Customer['creditlimit']) > 0.001) {
+			CreditControlLog($DebtorNo, 'limit', __('Credit limit changed from') . ' ' . locale_number_format($Customer['creditlimit'], $CurrDecimalPlaces) . ' ' . __('to') . ' ' . locale_number_format($NewLimit, $CurrDecimalPlaces),
+				$NewLimit, $Customer['currcode']);
+		}
+		DB_Txn_Commit();
+		prnMsg(__('The credit review has been recorded'), 'success');
+		$Customer = GetCreditStatus($DebtorNo);
+	}
+}
+
+if ($CanAct and isset($_POST['SaveExemptions'])) {
+	$Interest = isset($_POST['InterestExempt']) ? 1 : 0;
+	$Fee = isset($_POST['FeeExempt']) ? 1 : 0;
+	$Dunning = isset($_POST['DunningExempt']) ? 1 : 0;
+	if ($Interest != $Customer['interestexempt'] or $Fee != $Customer['feeexempt'] or $Dunning != $Customer['dunningexempt']) {
+		DB_query("UPDATE debtorsmaster SET interestexempt = '" . $Interest . "', feeexempt = '" . $Fee . "', dunningexempt = '" . $Dunning . "'
+					WHERE debtorno = '" . $DebtorNo . "'");
+		CreditControlLog($DebtorNo, 'exemptions', __('Exempt from interest') . ': ' . ($Interest ? __('Yes') : __('No')) . ', ' . __('exempt from late fees') . ': ' . ($Fee ? __('Yes') : __('No')) . ', ' . __('exempt from reminders') . ': ' . ($Dunning ? __('Yes') : __('No')) . '. ' . $_POST['ExemptNotes']);
+		prnMsg(__('The exemptions have been saved'), 'success');
+		$Customer = GetCreditStatus($DebtorNo);
+	}
+}
+
+if ($CanAct and isset($_POST['SaveDisputes'])) {
+	$Changed = 0;
+	foreach ($_POST['ItemID'] as $ItemID) {
+		$Disputed = (isset($_POST['Disputed'][$ItemID])) ? 1 : 0;
+		$Result = DB_query("SELECT type, transno, disputed FROM debtortrans WHERE id='" . (int) $ItemID . "' AND debtorno='" . $DebtorNo . "'");
+		if (DB_num_rows($Result) == 1) {
+			$Item = DB_fetch_array($Result);
+			if ($Item['disputed'] != $Disputed) {
+				DB_query("UPDATE debtortrans SET disputed = '" . $Disputed . "' WHERE id='" . (int) $ItemID . "'");
+				CreditControlLog($DebtorNo, $Disputed ? 'disputed' : 'dispute settled', ($Disputed ? __('Marked as disputed') : __('Dispute settled')) . ': ' . $_POST['DisputeNotes'], 0, '', $Item['type'] . '/' . $Item['transno']);
+				$Changed++;
+			}
+		}
+	}
+	prnMsg($Changed . ' ' . __('invoices were updated'), 'success');
+}
+
+/* ---- the customer ---- */
+$Result = DB_query("SELECT SUM(balance) FROM debtortrans WHERE debtorno='" . $DebtorNo . "'");
+$MyRow = DB_fetch_row($Result);
+$Balance = (float) $MyRow[0];
+$OverdueData = CreditOverdueData(date('Y-m-d'), $DebtorNo);
+$Overdue = isset($OverdueData[$DebtorNo]) ? $OverdueData[$DebtorNo]['overdue'] : 0;
+$LastLetters = CreditLastLetters($DebtorNo);
+
+echo CreditStatusBanner($DebtorNo);
+echo '<table class="selection">
+		<tr><th colspan="2">' . htmlspecialchars($Customer['name'], ENT_QUOTES, 'UTF-8') . ' (' . $DebtorNo . ')</th></tr>
+		<tr><td>' . __('Credit status') . '</td><td>' . CreditStatusText($Customer['effect']) . ' - ' . htmlspecialchars($Customer['reasondescription'], ENT_QUOTES, 'UTF-8') . '</td></tr>
+		<tr><td>' . __('Credit limit') . '</td><td class="number">' . $Customer['currcode'] . ' ' . locale_number_format($Customer['creditlimit'], $CurrDecimalPlaces) . '</td></tr>
+		<tr><td>' . __('Balance') . '</td><td class="number">' . $Customer['currcode'] . ' ' . locale_number_format($Balance, $CurrDecimalPlaces) . '</td></tr>
+		<tr><td>' . __('Overdue') . '</td><td class="number">' . $Customer['currcode'] . ' ' . locale_number_format($Overdue, $CurrDecimalPlaces) . '</td></tr>
+		<tr><td>' . __('Last reminder stage sent') . '</td><td>' . (isset($LastLetters[$DebtorNo]) ? $LastLetters[$DebtorNo]['stage'] . ' (' . ConvertSQLDate(mb_substr($LastLetters[$DebtorNo]['sentdate'], 0, 10)) . ')' : __('None')) . '</td></tr>
+		<tr><td>' . __('Last review') . '</td><td>' . ($Customer['lastreviewdate'] > '1000-01-01' ? ConvertSQLDate($Customer['lastreviewdate']) : __('Never')) . '</td></tr>
+		<tr><td>' . __('Next review due') . '</td><td>' . ($Customer['nextreviewdate'] > '1000-01-01' ? ConvertSQLDate($Customer['nextreviewdate']) : __('Not set')) . '</td></tr>
+	</table>
+	<div class="centre">
+		<a href="' . $RootPath . '/CustomerInquiry.php?CustomerID=' . urlencode($DebtorNo) . '">' . __('Customer account') . '</a> |
+		<a href="' . $RootPath . '/SelectCustomer.php?Select=' . urlencode($DebtorNo) . '">' . __('Customer details') . '</a>';
+if ($CanAct) {
+	echo ' | <a href="' . $RootPath . '/CreditWriteOffs.php?DebtorNo=' . urlencode($DebtorNo) . '">' . __('Write off a bad debt') . '</a>';
+}
+echo '</div><br />';
+
+/* ---- record a review ---- */
+if ($CanAct) {
+	$DefaultNext = date('Y-m-d', strtotime('+' . (int) $_SESSION['CreditReviewMonths'] . ' months'));
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+			<fieldset>
+				<legend>' . __('Record a credit review') . '</legend>
+				<field>
+					<label for="Outcome">' . __('Outcome') . ':</label>
+					<select name="Outcome" required="required">
+						<option value="confirmed">' . __('Limit confirmed') . '</option>
+						<option value="raised">' . __('Limit raised') . '</option>
+						<option value="reduced">' . __('Limit reduced') . '</option>
+						<option value="watch">' . __('Put on watch') . '</option>
+						<option value="stop">' . __('Put on stop') . '</option>
+						<option value="normal">' . __('Take off watch or stop') . '</option>
+					</select>
+				</field>
+				<field>
+					<label for="NewLimit">' . __('Credit limit') . ' (' . $Customer['currcode'] . '):</label>
+					<input type="text" class="number" name="NewLimit" size="14" maxlength="14" value="' . locale_number_format($Customer['creditlimit'], $CurrDecimalPlaces) . '" />
+				</field>
+				<field>
+					<label for="Notes">' . __('Notes and reason') . ':</label>
+					<textarea name="Notes" rows="4" cols="60"></textarea>
+				</field>
+				<field>
+					<label for="NextReviewDate">' . __('Next review date') . ':</label>
+					<input type="date" name="NextReviewDate" value="' . $DefaultNext . '" required="required" />
+				</field>
+			</fieldset>
+			<div class="centre"><input type="submit" name="RecordReview" value="' . __('Record Review') . '" /></div>
+		</form>';
+}
+
+/* ---- exemptions ---- */
+if ($CanAct) {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+			<fieldset>
+				<legend>' . __('Exemptions from reminders, interest and late fees') . '</legend>
+				<field><label>' . __('Do not send reminder letters') . ':</label><input type="checkbox" name="DunningExempt"' . ($Customer['dunningexempt'] ? ' checked="checked"' : '') . ' /></field>
+				<field><label>' . __('Exempt from interest') . ':</label><input type="checkbox" name="InterestExempt"' . ($Customer['interestexempt'] ? ' checked="checked"' : '') . ' /></field>
+				<field><label>' . __('Exempt from late fees') . ':</label><input type="checkbox" name="FeeExempt"' . ($Customer['feeexempt'] ? ' checked="checked"' : '') . ' /></field>
+				<field><label>' . __('Reason') . ':</label><input type="text" name="ExemptNotes" size="60" maxlength="150" /></field>
+			</fieldset>
+			<div class="centre"><input type="submit" name="SaveExemptions" value="' . __('Save Exemptions') . '" /></div>
+		</form>';
+} else {
+	echo '<div class="page_help_text">' . __('Interest exempt') . ': ' . ($Customer['interestexempt'] ? __('Yes') : __('No')) . ', ' . __('late fees exempt') . ': ' . ($Customer['feeexempt'] ? __('Yes') : __('No')) . ', ' . __('reminders suppressed') . ': ' . ($Customer['dunningexempt'] ? __('Yes') : __('No')) . '</div>';
+}
+
+/* ---- disputed invoices ---- */
+$Result = DB_query("SELECT debtortrans.id,
+							debtortrans.type,
+							debtortrans.transno,
+							debtortrans.trandate,
+							debtortrans.balance,
+							debtortrans.disputed,
+							systypes.typename,
+							" . CreditDueDateSQL() . " AS duedate
+					FROM debtortrans
+					INNER JOIN systypes ON debtortrans.type = systypes.typeid
+					INNER JOIN debtorsmaster ON debtortrans.debtorno = debtorsmaster.debtorno
+					INNER JOIN paymentterms ON debtorsmaster.paymentterms = paymentterms.termsindicator
+					WHERE debtortrans.debtorno = '" . $DebtorNo . "'
+						AND debtortrans.type IN (10, 51)
+						AND debtortrans.settled = 0
+						AND debtortrans.balance > 0
+					ORDER BY debtortrans.trandate");
+if (DB_num_rows($Result) > 0) {
+	if ($CanAct) {
+		echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />';
+	}
+	echo '<table class="selection">
+			<tr><th colspan="6">' . __('Open invoices and charges. A disputed item is not chased and does not attract interest') . '</th></tr>
+			<tr><th>' . __('Type') . '</th><th>' . __('Number') . '</th><th>' . __('Date') . '</th><th>' . __('Due') . '</th><th>' . __('Balance') . '</th><th>' . __('Disputed') . '</th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . __($MyRow['typename']) . '</td>
+				<td class="number">' . $MyRow['transno'] . '</td>
+				<td>' . ConvertSQLDate($MyRow['trandate']) . '</td>
+				<td>' . ConvertSQLDate($MyRow['duedate']) . '</td>
+				<td class="number">' . locale_number_format($MyRow['balance'], $CurrDecimalPlaces) . '</td>
+				<td>';
+		if ($CanAct) {
+			echo '<input type="hidden" name="ItemID[]" value="' . $MyRow['id'] . '" />
+					<input type="checkbox" name="Disputed[' . $MyRow['id'] . ']"' . ($MyRow['disputed'] ? ' checked="checked"' : '') . ' />';
+		} else {
+			echo ($MyRow['disputed'] ? __('Yes') : '');
+		}
+		echo '</td></tr>';
+	}
+	echo '</table>';
+	if ($CanAct) {
+		echo '<div class="centre">' . __('Reason') . ': <input type="text" name="DisputeNotes" size="50" maxlength="150" />
+				<input type="submit" name="SaveDisputes" value="' . __('Save Disputed Invoices') . '" /></div></form>';
+	}
+}
+
+/* ---- the history ---- */
+$Result = DB_query("SELECT creditreviews.*, oldreason.reasondescription AS oldreason, newreason.reasondescription AS newreason
+					FROM creditreviews
+					LEFT JOIN holdreasons AS oldreason ON creditreviews.oldholdreason = oldreason.reasoncode
+					LEFT JOIN holdreasons AS newreason ON creditreviews.newholdreason = newreason.reasoncode
+					WHERE debtorno = '" . $DebtorNo . "'
+					ORDER BY reviewid DESC");
+echo '<br /><table class="selection">
+		<tr><th colspan="7">' . __('Credit review history') . '</th></tr>
+		<tr><th>' . __('Date') . '</th><th>' . __('By') . '</th><th>' . __('Outcome') . '</th><th>' . __('Limit') . '</th><th>' . __('Status') . '</th><th>' . __('Notes') . '</th><th>' . __('Next review') . '</th></tr>';
+if (DB_num_rows($Result) == 0) {
+	echo '<tr><td colspan="7">' . __('No credit reviews have been recorded for this customer') . '</td></tr>';
+}
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate($MyRow['reviewdate']) . '</td>
+			<td>' . $MyRow['userid'] . '</td>
+			<td>' . $MyRow['outcome'] . '</td>
+			<td class="number">' . locale_number_format($MyRow['oldcreditlimit'], $CurrDecimalPlaces) . ' &rarr; ' . locale_number_format($MyRow['newcreditlimit'], $CurrDecimalPlaces) . '</td>
+			<td>' . $MyRow['oldreason'] . ' &rarr; ' . $MyRow['newreason'] . '</td>
+			<td>' . $MyRow['notes'] . '</td>
+			<td>' . ConvertSQLDate($MyRow['nextreviewdate']) . '</td>
+		</tr>';
+}
+echo '</table>';
+
+$Result = DB_query("SELECT eventdate, userid, eventtype, detail, amount, currabrev, reference
+					FROM creditcontrollog
+					WHERE debtorno = '" . $DebtorNo . "'
+					ORDER BY logid DESC");
+echo '<br /><table class="selection">
+		<tr><th colspan="6">' . __('Everything credit control has done for this customer') . '</th></tr>
+		<tr><th>' . __('When') . '</th><th>' . __('By') . '</th><th>' . __('Event') . '</th><th>' . __('Detail') . '</th><th>' . __('Amount') . '</th><th>' . __('Reference') . '</th></tr>';
+if (DB_num_rows($Result) == 0) {
+	echo '<tr><td colspan="6">' . __('Nothing has been recorded yet') . '</td></tr>';
+}
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate(mb_substr($MyRow['eventdate'], 0, 10)) . ' ' . mb_substr($MyRow['eventdate'], 11, 5) . '</td>
+			<td>' . $MyRow['userid'] . '</td>
+			<td>' . $MyRow['eventtype'] . '</td>
+			<td>' . $MyRow['detail'] . '</td>
+			<td class="number">' . ($MyRow['amount'] != 0 ? $MyRow['currabrev'] . ' ' . locale_number_format($MyRow['amount'], $CurrDecimalPlaces) : '') . '</td>
+			<td>' . $MyRow['reference'] . '</td>
+		</tr>';
+}
+echo '</table>';
+
+$Result = DB_query("SELECT sentdate, stage, method, sentto, amount, currabrev, invoices
+					FROM dunningletters
+					WHERE debtorno = '" . $DebtorNo . "'
+					ORDER BY letterid DESC");
+echo '<br /><table class="selection">
+		<tr><th colspan="5">' . __('Reminder letters sent') . '</th></tr>
+		<tr><th>' . __('Date') . '</th><th>' . __('Stage') . '</th><th>' . __('Sent') . '</th><th>' . __('Amount overdue') . '</th><th>' . __('Invoices covered') . '</th></tr>';
+if (DB_num_rows($Result) == 0) {
+	echo '<tr><td colspan="5">' . __('No reminder letters have been sent to this customer') . '</td></tr>';
+}
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate(mb_substr($MyRow['sentdate'], 0, 10)) . '</td>
+			<td class="number">' . $MyRow['stage'] . '</td>
+			<td>' . ($MyRow['method'] == 'email' ? __('Email to') . ' ' . $MyRow['sentto'] : __('Posted')) . '</td>
+			<td class="number">' . $MyRow['currabrev'] . ' ' . locale_number_format($MyRow['amount'], $CurrDecimalPlaces) . '</td>
+			<td>' . nl2br($MyRow['invoices']) . '</td>
+		</tr>';
+}
+echo '</table>';
+
+include('includes/footer.php');

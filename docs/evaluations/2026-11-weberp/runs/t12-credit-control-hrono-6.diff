diff --git a/CreditWriteOffReport.php b/CreditWriteOffReport.php
new file mode 100644
index 0000000..3c20f21
--- /dev/null
+++ b/CreditWriteOffReport.php
@@ -0,0 +1,61 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Bad Debt Write-offs Report');
+$ViewTopic = 'CreditControl';
+$BookMark = 'WriteOffs';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/reports.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$IsRep = (isset($_SESSION['SalesmanLogin']) and $_SESSION['SalesmanLogin'] != '');
+$From = (isset($_POST['FromDate']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['FromDate'])) ? $_POST['FromDate'] : date('Y-m-01');
+$To = (isset($_POST['ToDate']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['ToDate'])) ? $_POST['ToDate'] : date('Y-m-d');
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Period') . '</legend>
+			<field><label for="FromDate">' . __('From') . ':</label><input type="date" name="FromDate" value="' . $From . '" /></field>
+			<field><label for="ToDate">' . __('To') . ':</label><input type="date" name="ToDate" value="' . $To . '" /></field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Show" value="' . __('Show Report') . '" /></div>
+	</form>';
+
+$SQL = "SELECT creditwriteoffs.*, debtorsmaster.name, currencies.decimalplaces
+		FROM creditwriteoffs
+		INNER JOIN debtorsmaster ON creditwriteoffs.debtorno = debtorsmaster.debtorno
+		INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+		WHERE creditwriteoffs.status = 1
+			AND DATE(creditwriteoffs.approveddate) >= '" . $From . "'
+			AND DATE(creditwriteoffs.approveddate) <= '" . $To . "'";
+if ($IsRep) {
+	$SQL .= " AND EXISTS (SELECT 1 FROM custbranch WHERE custbranch.debtorno = creditwriteoffs.debtorno AND custbranch.salesman = '" . $_SESSION['SalesmanLogin'] . "')";
+}
+$SQL .= " ORDER BY creditwriteoffs.approveddate";
+$Result = DB_query($SQL, __('The write-offs could not be retrieved because'));
+
+echo '<table class="selection">
+		<tr><th>' . __('Date') . '</th><th>' . __('Customer') . '</th><th>' . __('Name') . '</th><th>' . __('Amount') . '</th><th>' . __('In') . ' ' . $_SESSION['CompanyRecord']['currencydefault'] . '</th><th>' . __('Reason') . '</th><th>' . __('Written off by') . '</th><th>' . __('Approved by') . '</th><th>' . __('Transaction') . '</th></tr>';
+$Total = 0;
+while ($MyRow = DB_fetch_array($Result)) {
+	$Total += $MyRow['homeamount'];
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate(mb_substr($MyRow['approveddate'], 0, 10)) . '</td>
+			<td>' . $MyRow['debtorno'] . '</td>
+			<td>' . $MyRow['name'] . '</td>
+			<td class="number">' . $MyRow['currabrev'] . ' ' . locale_number_format($MyRow['amount'], $MyRow['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($MyRow['homeamount'], 2) . '</td>
+			<td>' . $MyRow['reason'] . '</td>
+			<td>' . $MyRow['requestedby'] . '</td>
+			<td>' . ($MyRow['approvedby'] != '' ? $MyRow['approvedby'] : __('Within the approval limit')) . '</td>
+			<td class="number"><a href="' . $RootPath . '/GLTransInquiry.php?TypeID=53&amp;TransNo=' . $MyRow['transno'] . '">' . $MyRow['transno'] . '</a></td>
+		</tr>';
+}
+echo '<tr><td colspan="4"><b>' . __('Total') . '</b></td><td class="number"><b>' . locale_number_format($Total, 2) . '</b></td><td colspan="4"></td></tr>
+	</table>';
+
+include('includes/footer.php');
diff --git a/CreditWriteOffs.php b/CreditWriteOffs.php
new file mode 100644
index 0000000..2369798
--- /dev/null
+++ b/CreditWriteOffs.php
@@ -0,0 +1,167 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Bad Debt Write-offs');
+$ViewTopic = 'CreditControl';
+$BookMark = 'WriteOffs';
+include('includes/header.php');
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/transactions.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Company = $_SESSION['CompanyRecord'];
+$CanApprove = CreditControlCanApprove();
+$ApprovalLimit = $_SESSION['CreditWriteOffApprovalLimit'];
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper($_GET['DebtorNo']);
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper($_POST['DebtorNo']);
+} else {
+	$DebtorNo = '';
+}
+
+/* ---- approve or reject a write-off awaiting the Finance Director ---- */
+if ($CanApprove and (isset($_POST['Approve']) or isset($_POST['Reject']))) {
+	$WriteOffID = isset($_POST['Approve']) ? (int) key($_POST['Approve']) : (int) key($_POST['Reject']);
+	$Result = DB_query("SELECT debtorno, amount, currabrev FROM creditwriteoffs WHERE writeoffid='" . $WriteOffID . "' AND status = 0");
+	if (DB_num_rows($Result) == 1) {
+		$WriteOff = DB_fetch_array($Result);
+		if (isset($_POST['Approve'])) {
+			if ($WriteOff['amount'] > CreditWriteOffable($WriteOff['debtorno']) + 0.005) {
+				prnMsg(__('The customer owes less than this write-off since it was requested. Reject it and enter a new one'), 'error');
+			} elseif (CreditPostWriteOff($WriteOffID, $_SESSION['UserID']) !== false) {
+				prnMsg(__('Write-off') . ' ' . $WriteOffID . ' ' . __('has been approved and posted'), 'success');
+			}
+		} else {
+			DB_query("UPDATE creditwriteoffs SET status = 2, approvedby = '" . $_SESSION['UserID'] . "', approveddate = NOW() WHERE writeoffid='" . $WriteOffID . "'");
+			CreditControlLog($WriteOff['debtorno'], 'writeoffrejected', __('Write-off request') . ' ' . $WriteOffID . ' ' . __('rejected'), $WriteOff['amount'], $WriteOff['currabrev'], $WriteOffID);
+			prnMsg(__('Write-off') . ' ' . $WriteOffID . ' ' . __('has been rejected'), 'info');
+		}
+	}
+}
+
+/* ---- request a write-off ---- */
+if (CreditControlCanAct() and isset($_POST['RequestWriteOff'])) {
+
+	$InputError = 0;
+	$Customer = GetCreditStatus($DebtorNo);
+	$Amount = filter_number_format($_POST['Amount']);
+	$Rate = 1;
+	if ($Customer === false) {
+		$InputError = 1;
+		prnMsg(__('Enter the code of a customer'), 'error');
+	} else {
+		$Result = DB_query("SELECT rate, decimalplaces FROM currencies WHERE currabrev='" . $Customer['currcode'] . "'");
+		$CurrRow = DB_fetch_array($Result);
+		$Rate = ($CurrRow['rate'] > 0) ? $CurrRow['rate'] : 1;
+		if (!is_numeric($Amount) or $Amount <= 0) {
+			$InputError = 1;
+			prnMsg(__('The amount to write off must be a number greater than zero'), 'error');
+		} elseif ($Amount > CreditWriteOffable($DebtorNo) + 0.005) {
+			$InputError = 1;
+			prnMsg(__('The amount is more than the customer owes in unpaid invoices and charges. Allocate any unallocated receipts and credits first'), 'error');
+		}
+	}
+	if (mb_strlen(trim($_POST['Reason'])) < 3) {
+		$InputError = 1;
+		prnMsg(__('A reason must be entered for a write-off'), 'error');
+	}
+	if ($Company['gllink_debtors'] == 1 and ($Company['baddebtact'] == '0' or $Company['baddebtact'] == '')) {
+		$InputError = 1;
+		prnMsg(__('The bad debts GL account has not been chosen. Set it in Company Preferences first'), 'error');
+	}
+	if ($InputError == 0) {
+		$PutOnStop = isset($_POST['PutOnStop']) ? 1 : 0;
+		$HomeAmount = $Amount / $Rate;
+		DB_query("INSERT INTO creditwriteoffs (debtorno, amount, currabrev, reason, status, putonstop, requestedby, requesteddate, homeamount)
+					VALUES ('" . $DebtorNo . "', '" . $Amount . "', '" . $Customer['currcode'] . "', '" . $_POST['Reason'] . "', 0, '" . $PutOnStop . "',
+							'" . $_SESSION['UserID'] . "', NOW(), '" . $HomeAmount . "')",
+				__('The write-off request could not be recorded because'));
+		$WriteOffID = DB_Last_Insert_ID('creditwriteoffs', 'writeoffid');
+		CreditControlLog($DebtorNo, 'writeoffrequest', __('Write-off requested') . ': ' . $_POST['Reason'], $Amount, $Customer['currcode'], $WriteOffID);
+		if ($HomeAmount <= $ApprovalLimit) {
+			if (CreditPostWriteOff($WriteOffID, '') !== false) {
+				prnMsg(__('The write-off is within the approval limit and has been posted'), 'success');
+			}
+		} else {
+			prnMsg(__('This write-off is above the approval limit of') . ' ' . $Company['currencydefault'] . ' ' . locale_number_format($ApprovalLimit, 2) . '. ' . __('It has no effect until the Finance Director approves it'), 'warn');

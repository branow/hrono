diff --git a/includes/CreditControlFunctions.php b/includes/CreditControlFunctions.php
new file mode 100644
index 0000000..d29094f
--- /dev/null
+++ b/includes/CreditControlFunctions.php
@@ -0,0 +1,701 @@
+<?php
+
+/* Shared credit control functions: credit status, order checks, overdue items, reminders, charges and write-offs.
+
+The credit status of a customer is the existing debtorsmaster.holdreason. What the status does is held in
+holdreasons.dissallowinvoices: 1 is "on stop" (no orders, no invoicing), 2 is "on watch" (supply but warn), anything else supplies normally.
+
+Debtortrans types used here are 51 interest and late fee charges, 52 charge waivers and 53 bad debt write-offs. */
+
+/* Credit control actions (reviews, stop and watch, reminders, charges, write-off requests) need token 21 */
+function CreditControlCanAct() {
+	return isset($_SESSION['PageSecurityArray']['CreditControlAction'])
+		and in_array($_SESSION['PageSecurityArray']['CreditControlAction'], $_SESSION['AllowedPageSecurityTokens']);
+}
+
+/* Approving a write-off over the limit needs token 22 */
+function CreditControlCanApprove() {
+	return isset($_SESSION['PageSecurityArray']['CreditControlApproval'])
+		and in_array($_SESSION['PageSecurityArray']['CreditControlApproval'], $_SESSION['AllowedPageSecurityTokens']);
+}
+
+/* A sales rep sees only the customers who have a branch assigned to them. Everyone else sees every customer */
+function CreditControlCanSee($DebtorNo) {
+	if (!isset($_SESSION['SalesmanLogin']) or $_SESSION['SalesmanLogin'] == '') {
+		return true;
+	}
+	$Result = DB_query("SELECT COUNT(*) FROM custbranch
+						WHERE debtorno='" . $DebtorNo . "'
+							AND salesman='" . $_SESSION['SalesmanLogin'] . "'");
+	$MyRow = DB_fetch_row($Result);
+	return $MyRow[0] > 0;
+}
+
+/* The credit status of a customer: effect is 0 normal, 1 on stop, 2 on watch */
+function GetCreditStatus($DebtorNo) {
+	$SQL = "SELECT debtorsmaster.name,
+					debtorsmaster.currcode,
+					debtorsmaster.holdreason,
+					debtorsmaster.creditlimit,
+					debtorsmaster.nextreviewdate,
+					debtorsmaster.lastreviewdate,
+					debtorsmaster.interestexempt,
+					debtorsmaster.feeexempt,
+					debtorsmaster.dunningexempt,
+					holdreasons.reasondescription,
+					holdreasons.dissallowinvoices
+				FROM debtorsmaster
+				LEFT JOIN holdreasons
+					ON debtorsmaster.holdreason = holdreasons.reasoncode
+				WHERE debtorsmaster.debtorno = '" . $DebtorNo . "'";
+	$Result = DB_query($SQL, __('The credit status of the customer could not be retrieved because'));
+	if (DB_num_rows($Result) == 0) {
+		return false;
+	}
+	$MyRow = DB_fetch_array($Result);
+	if ($MyRow['dissallowinvoices'] == 1) {
+		$MyRow['effect'] = 1;
+	} elseif ($MyRow['dissallowinvoices'] == 2) {
+		$MyRow['effect'] = 2;
+	} else {
+		$MyRow['effect'] = 0;
+	}
+	return $MyRow;
+}
+
+function CreditStatusText($Effect) {
+	if ($Effect == 1) {
+		return __('On Stop');
+	} elseif ($Effect == 2) {
+		return __('On Watch');
+	}
+	return __('Normal');
+}
+
+/* Marked up text of the status for pages that show the customer */
+function CreditStatusBanner($DebtorNo) {
+	$Status = GetCreditStatus($DebtorNo);
+	if ($Status === false or $Status['effect'] == 0) {
+		return '';
+	}
+	$Class = ($Status['effect'] == 1) ? 'error' : 'warn';
+	return '<div class="' . $Class . '"><b>' . CreditStatusText($Status['effect']) . '</b> - ' . htmlspecialchars($Status['reasondescription'], ENT_QUOTES, 'UTF-8') . '</div>';
+}
+
+/* The hold reason codes credit control uses when it puts a customer on stop or watch or takes them off */
+function CreditReasonCode($Effect) {
+	if ($Effect == 0) {
+		$SQL = "SELECT reasoncode FROM holdreasons
+				WHERE dissallowinvoices NOT IN (1,2)
+				ORDER BY (reasoncode=0) DESC, reasoncode LIMIT 1";
+	} else {
+		$SQL = "SELECT reasoncode FROM holdreasons
+				WHERE dissallowinvoices = " . (int) $Effect . "
+				ORDER BY (reasoncode=" . ($Effect == 1 ? 91 : 90) . ") DESC, reasoncode LIMIT 1";
+	}
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) == 0) {
+		return false;
+	}
+	$MyRow = DB_fetch_row($Result);
+	return $MyRow[0];
+}
+
+function CreditNormalReasonCode() {
+	$Code = CreditReasonCode(0);
+	return ($Code === false) ? 0 : $Code;
+}
+
+/* Every credit control action leaves a row here so the auditors can see what happened, who did it and when */
+function CreditControlLog($DebtorNo, $EventType, $Detail, $Amount = 0, $Currency = '', $Reference = '') {
+	$SQL = "INSERT INTO creditcontrollog (debtorno,
+										eventdate,
+										userid,
+										eventtype,
+										detail,
+										amount,
+										currabrev,
+										reference)
+								VALUES ('" . $DebtorNo . "',
+										NOW(),
+										'" . $_SESSION['UserID'] . "',
+										'" . $EventType . "',
+										'" . DB_escape_string($Detail) . "',
+										'" . $Amount . "',
+										'" . $Currency . "',
+										'" . $Reference . "')";
+	DB_query($SQL, __('The credit control history could not be written because'), '', true);
+}
+
+/* The value of the lines of an order that are still to be invoiced */
+function CreditControlOrderOutstanding($OrderNo) {
+	$Result = DB_query("SELECT SUM(unitprice * (quantity - qtyinvoiced) * (1 - discountpercent))
+						FROM salesorderdetails
+						WHERE orderno='" . $OrderNo . "'
+							AND completed = 0");
+	$MyRow = DB_fetch_row($Result);
+	return (float) $MyRow[0];
+}
+
+/* Decides what to do with a new or changed customer order whatever route it came in by.
+Returns result 'stop' (refuse it), 'hold' (accept it but hold it for credit control) or 'ok', and a message.
+$NewOrderValue is the value still to be invoiced on the order. $ExistingOrderNo is 0 for a new order. */
+function CreditControlOrderCheck($DebtorNo, $NewOrderValue, $ExistingOrderNo = 0) {
+	$Answer = array('result' => 'ok', 'message' => '', 'watch' => false);
+	$Status = GetCreditStatus($DebtorNo);
+	if ($Status === false) {
+		return $Answer;
+	}
+	$OrderCreditStatus = 0;
+	if ($ExistingOrderNo != 0) {
+		$Result = DB_query("SELECT creditstatus FROM salesorders WHERE orderno='" . $ExistingOrderNo . "'");
+		$MyRow = DB_fetch_row($Result);
+		$OrderCreditStatus = (int) $MyRow[0];
+	}
+	if ($Status['effect'] == 1 and $OrderCreditStatus != 2) {
+		$Answer['result'] = 'stop';
+		$Answer['message'] = __('This account is on stop') . ' (' . $Status['reasondescription'] . '). ' . __('No orders can be accepted until credit control takes the account off stop');
+		return $Answer;
+	}
+	if ($Status['effect'] == 2) {
+		$Answer['watch'] = true;
+	}
+	if (isset($_SESSION['CheckCreditLimits']) and $_SESSION['CheckCreditLimits'] > 0 and $NewOrderValue > 0 and $OrderCreditStatus != 2) {
+		$CreditAvailable = GetCreditAvailable($DebtorNo);
+		if ($ExistingOrderNo != 0) {
+			$CreditAvailable += CreditControlOrderOutstanding($ExistingOrderNo);
+		}
+		if ($CreditAvailable - $NewOrderValue < -0.005) {
+			$Answer['result'] = 'hold';
+			$Answer['message'] = __('This order takes the customer over their credit limit so it is held for credit control approval');
+		}
+	}
+	return $Answer;
+}
+
+/* Holds an order for credit control. Invoicing is refused until credit control releases it. */
+function CreditControlHoldOrder($OrderNo, $DebtorNo, $Detail) {
+	DB_query("UPDATE salesorders SET creditstatus = 1 WHERE orderno='" . $OrderNo . "' AND creditstatus = 0",
+		__('The order could not be held for credit control because'), '', true);
+	CreditControlLog($DebtorNo, 'orderheld', $Detail, 0, '', $OrderNo);
+}
+
+/* Whether an order may be invoiced or dispatched. Orders on a customer on stop, or held for credit control, must be released first. */
+function CreditControlInvoiceCheck($OrderNo, $DebtorNo) {
+	$Result = DB_query("SELECT creditstatus FROM salesorders WHERE orderno='" . $OrderNo . "'");
+	$MyRow = DB_fetch_row($Result);
+	$OrderCreditStatus = (int) $MyRow[0];
+	if ($OrderCreditStatus == 2) {
+		return array('result' => 'ok', 'message' => '');
+	}
+	if ($OrderCreditStatus == 1) {
+		return array('result' => 'held', 'message' => __('This order is held for credit control and cannot be dispatched or invoiced until credit control releases it'));
+	}
+	$Status = GetCreditStatus($DebtorNo);
+	if ($Status !== false and $Status['effect'] == 1) {
+		return array('result' => 'stop', 'message' => __('This account is on stop') . ' (' . $Status['reasondescription'] . '). ' . __('The order cannot be dispatched or invoiced until credit control takes the account off stop or releases this order'));
+	}
+	return array('result' => 'ok', 'message' => '');
+}
+
+/* SQL for the date an invoice falls due, following the payment terms the way the aged debtors report does. */
+function CreditDueDateSQL() {
+	return "IF(paymentterms.daysbeforedue > 0,
+				DATE_ADD(debtortrans.trandate, INTERVAL paymentterms.daysbeforedue DAY),
+				DATE_ADD(LAST_DAY(debtortrans.trandate), INTERVAL paymentterms.dayinfollowingmonth DAY))";
+}
+
+/* The open items of the customers, worked out as at $AsAt (Y-m-d). For each customer: the balance, the overdue
+invoices and charges that are not disputed, unallocated credits, and the oldest due date.
+Disputed items are never chased and never charged interest. */
+function CreditOverdueData($AsAt, $DebtorNo = '') {
+	$SQL = "SELECT debtortrans.id,
+					debtortrans.debtorno,
+					debtortrans.type,
+					debtortrans.transno,
+					debtortrans.trandate,
+					debtortrans.balance,
+					debtortrans.disputed,
+					" . CreditDueDateSQL() . " AS duedate,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					debtorsmaster.creditlimit,
+					debtorsmaster.holdreason,
+					debtorsmaster.interestexempt,
+					debtorsmaster.feeexempt,
+					debtorsmaster.dunningexempt,
+					currencies.rate,
+					currencies.decimalplaces
+				FROM debtortrans
+				INNER JOIN debtorsmaster
+					ON debtortrans.debtorno = debtorsmaster.debtorno
+				INNER JOIN paymentterms
+					ON debtorsmaster.paymentterms = paymentterms.termsindicator
+				INNER JOIN currencies
+					ON debtorsmaster.currcode = currencies.currabrev
+				WHERE debtortrans.settled = 0
+					AND ABS(debtortrans.balance) > 0.00001";
+	if ($DebtorNo != '') {
+		$SQL .= " AND debtortrans.debtorno = '" . $DebtorNo . "'";
+	}
+	$SQL .= " ORDER BY debtortrans.debtorno, debtortrans.trandate, debtortrans.id";
+	$Result = DB_query($SQL, __('The open customer transactions could not be retrieved because'));
+
+	$Customers = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$ID = $MyRow['debtorno'];
+		if (!isset($Customers[$ID])) {
+			$Customers[$ID] = array('debtorno' => $ID,
+									'name' => $MyRow['name'],
+									'currcode' => $MyRow['currcode'],
+									'rate' => ($MyRow['rate'] > 0 ? $MyRow['rate'] : 1),
+									'decimalplaces' => $MyRow['decimalplaces'],
+									'creditlimit' => $MyRow['creditlimit'],
+									'interestexempt' => $MyRow['interestexempt'],
+									'feeexempt' => $MyRow['feeexempt'],
+									'dunningexempt' => $MyRow['dunningexempt'],
+									'balance' => 0,
+									'credits' => 0,
+									'overdue' => 0,
+									'overdueinvoices' => 0,
+									'oldestdue' => '9999-12-31',
+									'maxdays' => 0,
+									'items' => array());
+		}
+		$Customers[$ID]['balance'] += $MyRow['balance'];
+		if ($MyRow['balance'] < 0) {
+			$Customers[$ID]['credits'] += $MyRow['balance'];
+		} elseif ($MyRow['disputed'] == 0 and ($MyRow['type'] == 10 or $MyRow['type'] == 51) and $MyRow['duedate'] < $AsAt) {
+			$DaysOverdue = (int) round((strtotime($AsAt) - strtotime($MyRow['duedate'])) / 86400);
+			$Customers[$ID]['items'][] = array('id' => $MyRow['id'],
+												'type' => $MyRow['type'],
+												'transno' => $MyRow['transno'],
+												'trandate' => $MyRow['trandate'],
+												'duedate' => $MyRow['duedate'],
+												'balance' => $MyRow['balance'],
+												'daysoverdue' => $DaysOverdue);
+			$Customers[$ID]['overdue'] += $MyRow['balance'];
+			if ($MyRow['type'] == 10) {
+				$Customers[$ID]['overdueinvoices'] += $MyRow['balance'];
+			}
+			if ($MyRow['duedate'] < $Customers[$ID]['oldestdue']) {
+				$Customers[$ID]['oldestdue'] = $MyRow['duedate'];
+			}
+			if ($DaysOverdue > $Customers[$ID]['maxdays']) {
+				$Customers[$ID]['maxdays'] = $DaysOverdue;
+			}
+		}
+	}
+	/* Credits and receipts not yet allocated reduce what is overdue. Nothing is overdue if the customer is in credit */
+	foreach ($Customers as $ID => $Customer) {
+		$Customers[$ID]['overdue'] = max(0, round($Customer['overdue'] + $Customer['credits'], $Customer['decimalplaces']));
+		$Customers[$ID]['overdueinvoices'] = max(0, round($Customer['overdueinvoices'] + $Customer['credits'], $Customer['decimalplaces']));
+	}
+	return $Customers;
+}
+
+/* The last reminder letter sent to each customer: debtorno => array(stage, sentdate) */
+function CreditLastLetters($DebtorNo = '') {
+	$SQL = "SELECT dunningletters.debtorno,
+					dunningletters.stage,
+					dunningletters.sentdate
+			FROM dunningletters
+			INNER JOIN (SELECT debtorno, MAX(letterid) AS lastid
+						FROM dunningletters
+						GROUP BY debtorno) AS lastletters
+				ON dunningletters.letterid = lastletters.lastid";
+	if ($DebtorNo != '') {
+		$SQL .= " WHERE dunningletters.debtorno = '" . $DebtorNo . "'";
+	}
+	$Result = DB_query($SQL);
+	$Letters = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Letters[$MyRow['debtorno']] = $MyRow;
+	}
+	return $Letters;
+}
+
+/* The reminder letter stages finance has set up, in order */
+function CreditDunningStages() {
+	$Result = DB_query("SELECT stage, daysoverdue, subject, body FROM dunningstages ORDER BY stage");
+	$Stages = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Stages[$MyRow['stage']] = $MyRow;
+	}
+	return $Stages;
+}
+
+/* Works out which customers get which reminder letter. A customer moves up one stage at a time, and only while still
+overdue by the days set for that stage. If everything they owed when the last letter went has been paid, they start again at stage 1.
+The same customer is not written to again inside DunningMinDaysBetween days. */
+function CreditDunningCandidates($AsAt, $DebtorNo = '') {
+	$Stages = CreditDunningStages();
+	$Customers = CreditOverdueData($AsAt, $DebtorNo);
+	$LastLetters = CreditLastLetters($DebtorNo);
+	$Candidates = array();
+	foreach ($Customers as $ID => $Customer) {
+		if ($Customer['overdue'] <= CurrencyTolerance($Customer['currcode']) or $Customer['dunningexempt'] == 1) {
+			continue;
+		}
+		$LastStage = 0;
+		$LastSent = '';
+		if (isset($LastLetters[$ID])) {
+			$LastSent = $LastLetters[$ID]['sentdate'];
+			/* if the oldest overdue item fell due after the last letter the customer has paid up since then */
+			if ($Customer['oldestdue'] <= mb_substr($LastSent, 0, 10)) {
+				$LastStage = $LastLetters[$ID]['stage'];
+			}
+		}
+		$NextStage = $LastStage + 1;
+		if (!isset($Stages[$NextStage])) {
+			continue; //the final notice has already gone
+		}
+		if ($Customer['maxdays'] < $Stages[$NextStage]['daysoverdue']) {
+			continue; //not overdue for long enough for the next letter
+		}
+		if ($LastSent != '' and $LastStage > 0 and (strtotime($AsAt) - strtotime(mb_substr($LastSent, 0, 10))) / 86400 < $_SESSION['DunningMinDaysBetween']) {
+			continue; //a letter went recently
+		}
+		$Customer['stage'] = $NextStage;
+		$Customer['laststage'] = $LastStage;
+		$Candidates[$ID] = $Customer;
+	}
+	return $Candidates;
+}
+
+/* The email addresses of the customer accounts contacts: the contacts flagged to receive statements */
+function CreditAccountsContacts($DebtorNo) {
+	$Result = DB_query("SELECT contactname, email FROM custcontacts
+						WHERE debtorno='" . $DebtorNo . "'
+							AND statement = 1
+							AND email <> ''");
+	$To = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		if (IsEmailAddress($MyRow['email'])) {
+			$To[$MyRow['email']] = $MyRow['contactname'];
+		}
+	}
+	return $To;
+}
+
+/* Fills in the letter wording for a customer */
+function CreditLetterText($Stage, $Customer) {
+	$Lines = '';
+	foreach ($Customer['items'] as $Item) {
+		$Lines .= ($Item['type'] == 10 ? __('Invoice') : __('Charge')) . ' ' . $Item['transno'] . '  ' . ConvertSQLDate($Item['trandate']) . '  '
+			. __('due') . ' ' . ConvertSQLDate($Item['duedate']) . '  ' . $Customer['currcode'] . ' ' . locale_number_format($Item['balance'], $Customer['decimalplaces']) . "\n";
+	}
+	$Replace = array('{name}' => html_entity_decode($Customer['name'], ENT_QUOTES, 'UTF-8'),
+					'{debtorno}' => $Customer['debtorno'],
+					'{company}' => html_entity_decode($_SESSION['CompanyRecord']['coyname'], ENT_QUOTES, 'UTF-8'),
+					'{currency}' => $Customer['currcode'],
+					'{amount}' => locale_number_format($Customer['overdue'], $Customer['decimalplaces']),
+					'{invoices}' => $Lines);
+	/* values typed into the setup page are stored with their HTML characters escaped, a letter needs the plain text */
+	return array('subject' => strtr(html_entity_decode($Stage['subject'], ENT_QUOTES, 'UTF-8'), $Replace),
+				'body' => strtr(html_entity_decode($Stage['body'], ENT_QUOTES, 'UTF-8'), $Replace),
+				'invoices' => $Lines);
+}
+
+/* Interest and fees due from each customer for a month. Interest is a simple annual rate divided by twelve on the overdue
+invoices past the grace days (charges themselves do not attract interest), and the fee is a flat amount in the home
+currency converted to the customer's currency. Exempt customers and disputed invoices are left out. */
+function CreditChargeCandidates($AsAt, $ChargeMonth) {
+	$GraceDays = (int) $_SESSION['CreditChargeGraceDays'];
+	$Customers = CreditOverdueData($AsAt);
+	$Done = array();
+	$Result = DB_query("SELECT debtorno, chargetype FROM creditcharges WHERE chargemonth='" . $ChargeMonth . "'");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Done[$MyRow['debtorno']][$MyRow['chargetype']] = true;
+	}
+	$Candidates = array();
+	foreach ($Customers as $ID => $Customer) {
+		$Base = 0;
+		foreach ($Customer['items'] as $Item) {
+			if ($Item['type'] == 10 and $Item['daysoverdue'] > $GraceDays) {
+				$Base += $Item['balance'];
+			}
+		}
+		$Base = max(0, round($Base + $Customer['credits'], $Customer['decimalplaces']));
+		if ($Base <= CurrencyTolerance($Customer['currcode'])) {
+			continue;
+		}
+		$Interest = 0;
+		$Fee = 0;
+		if ($Customer['interestexempt'] == 0 and $_SESSION['CreditInterestRate'] > 0 and !isset($Done[$ID]['interest'])) {
+			$Interest = round($Base * ($_SESSION['CreditInterestRate'] / 100) / 12, $Customer['decimalplaces']);
+		}
+		if ($Customer['feeexempt'] == 0 and $_SESSION['CreditLateFee'] > 0 and !isset($Done[$ID]['fee'])) {
+			$Fee = round($_SESSION['CreditLateFee'] * $Customer['rate'], $Customer['decimalplaces']);
+		}
+		$Customer['base'] = $Base;
+		$Customer['interest'] = $Interest;
+		$Customer['fee'] = $Fee;
+		$Customer['alreadycharged'] = isset($Done[$ID]);
+		if ($Interest > 0 or $Fee > 0 or isset($Done[$ID])) {
+			$Candidates[$ID] = $Customer;
+		}
+	}
+	return $Candidates;
+}
+
+/* Posts one customer account transaction (types 51, 52, 53) with its general ledger entries.
+$Amount is in the customer's currency, positive for a charge and negative for a credit. $GLLines are array(account, amount in customer currency)
+that are converted at $Rate, the debtors control account taking the opposite of their total. Returns the transaction number and the debtortrans id. */
+function CreditPostDebtorTrans($Type, $DebtorNo, $Amount, $Rate, $TranDate, $Text, $Reference, $GLLines) {
+	$Result = DB_query("SELECT debtorsmaster.salestype,
+								custbranch.branchcode,
+								custbranch.salesman
+						FROM debtorsmaster
+						LEFT JOIN custbranch
+							ON custbranch.debtorno = debtorsmaster.debtorno
+						WHERE debtorsmaster.debtorno='" . $DebtorNo . "'
+						ORDER BY custbranch.branchcode
+						LIMIT 1");
+	$Customer = DB_fetch_array($Result);
+	$PeriodNo = GetPeriod(ConvertSQLDate($TranDate));
+	$TransNo = GetNextTransNo($Type);
+	$Alloc = ($Amount < 0) ? $Amount : 0;
+	$SQL = "INSERT INTO debtortrans (transno,
+									type,
+									debtorno,
+									branchcode,
+									trandate,
+									inputdate,
+									prd,
+									settled,
+									reference,
+									tpe,
+									rate,
+									ovamount,
+									alloc,
+									invtext,
+									edisent,
+									salesperson)
+								VALUES ('" . $TransNo . "',
+									'" . $Type . "',
+									'" . $DebtorNo . "',
+									'" . $Customer['branchcode'] . "',
+									'" . $TranDate . "',
+									'" . date('Y-m-d H:i:s') . "',
+									'" . $PeriodNo . "',
+									'" . ($Amount < 0 ? 1 : 0) . "',
+									'" . DB_escape_string($Reference) . "',
+									'" . $Customer['salestype'] . "',
+									'" . $Rate . "',
+									'" . $Amount . "',
+									'" . $Alloc . "',
+									'" . DB_escape_string($Text) . "',
+									'1',
+									'" . $Customer['salesman'] . "')";
+	DB_query($SQL, __('The customer transaction could not be inserted because'), '', true);
+	$TransID = DB_Last_Insert_ID('debtortrans', 'id');
+
+	if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+		$Total = 0;
+		foreach ($GLLines as $Line) {
+			$HomeAmount = $Line[1] / $Rate;
+			$Total += $HomeAmount;
+			CreditPostGL($Type, $TransNo, $TranDate, $PeriodNo, $Line[0], $HomeAmount, $Text);
+		}
+		CreditPostGL($Type, $TransNo, $TranDate, $PeriodNo, $_SESSION['CompanyRecord']['debtorsact'], -$Total, $Text);
+	}
+	return array('transno' => $TransNo, 'id' => $TransID, 'period' => $PeriodNo);
+}
+
+function CreditPostGL($Type, $TransNo, $TranDate, $PeriodNo, $Account, $Amount, $Narrative) {
+	if (abs($Amount) < 0.000001) {
+		return;
+	}
+	$SQL = "INSERT INTO gltrans (type,
+								typeno,
+								trandate,
+								periodno,
+								account,
+								narrative,
+								amount)
+							VALUES ('" . $Type . "',
+								'" . $TransNo . "',
+								'" . $TranDate . "',
+								'" . $PeriodNo . "',
+								'" . $Account . "',
+								'" . mb_substr(DB_escape_string($Narrative), 0, 200) . "',
+								'" . round($Amount, 6) . "')";
+	DB_query($SQL, __('The general ledger entry could not be inserted because'), '', true);
+}
+
+/* Posts the interest or the late fee of one customer for a month. One row per customer, month and kind is all that is allowed,
+the unique key on creditcharges stops the same month being charged twice. */
+function CreditPostCharge($Customer, $ChargeType, $Amount, $ChargeMonth, $ChargeDate) {
+	if ($ChargeType == 'interest') {
+		$Account = $_SESSION['CompanyRecord']['creditinterestact'];
+		$Text = __('Interest on overdue balance') . ' ' . $ChargeMonth;
+	} else {
+		$Account = $_SESSION['CompanyRecord']['creditfeeact'];
+		$Text = __('Late payment fee') . ' ' . $ChargeMonth;
+	}
+	DB_Txn_Begin();
+	$Posted = CreditPostDebtorTrans(51, $Customer['debtorno'], $Amount, $Customer['rate'], $ChargeDate, $Text, $ChargeType . ' ' . $ChargeMonth, array(array($Account, -$Amount)));
+	$SQL = "INSERT INTO creditcharges (debtorno,
+										chargemonth,
+										chargetype,
+										transno,
+										amount,
+										currabrev,
+										overduebalance,
+										chargedate,
+										userid)
+									VALUES ('" . $Customer['debtorno'] . "',
+										'" . $ChargeMonth . "',
+										'" . $ChargeType . "',
+										'" . $Posted['transno'] . "',
+										'" . $Amount . "',
+										'" . $Customer['currcode'] . "',
+										'" . $Customer['base'] . "',
+										NOW(),
+										'" . $_SESSION['UserID'] . "')";
+	DB_query($SQL, __('The charge could not be recorded because'), '', true);
+	CreditControlLog($Customer['debtorno'], 'charge', $Text, $Amount, $Customer['currcode'], $Posted['transno']);
+	DB_Txn_Commit();
+	return $Posted['transno'];
+}
+
+/* Reverses a charge for a reason. The reversal is posted at the rate of the charge so the general ledger is exactly undone,
+and it is allocated to the charge so the customer account shows both lines settled. */
+function CreditWaiveCharge($ChargeID, $Reason, $WaiveDate) {
+	$Result = DB_query("SELECT creditcharges.*,
+								debtortrans.id AS transid,
+								debtortrans.rate,
+								debtortrans.balance
+						FROM creditcharges
+						INNER JOIN debtortrans
+							ON debtortrans.type = 51
+							AND debtortrans.transno = creditcharges.transno
+							AND debtortrans.debtorno = creditcharges.debtorno
+						WHERE creditcharges.chargeid = '" . $ChargeID . "'
+							AND creditcharges.waived = 0");
+	if (DB_num_rows($Result) != 1) {
+		return false;
+	}
+	$Charge = DB_fetch_array($Result);
+	if ($Charge['balance'] <= 0.00001) {
+		return false; //the customer has already paid it
+	}
+	$Waive = $Charge['balance'];
+	$Account = ($Charge['chargetype'] == 'interest') ? $_SESSION['CompanyRecord']['creditinterestact'] : $_SESSION['CompanyRecord']['creditfeeact'];
+	$Text = __('Waiver of') . ' ' . ($Charge['chargetype'] == 'interest' ? __('interest') : __('late fee')) . ' ' . $Charge['chargemonth'] . ': ' . $Reason;
+
+	DB_Txn_Begin();
+	$Posted = CreditPostDebtorTrans(52, $Charge['debtorno'], -$Waive, $Charge['rate'], $WaiveDate, $Text, 'waiver ' . $Charge['chargemonth'], array(array($Account, $Waive)));
+	DB_query("INSERT INTO custallocns (amt, datealloc, transid_allocfrom, transid_allocto)
+				VALUES ('" . $Waive . "', '" . $WaiveDate . "', '" . $Posted['id'] . "', '" . $Charge['transid'] . "')",
+			__('The allocation of the waiver could not be inserted because'), '', true);
+	DB_query("UPDATE debtortrans SET alloc = alloc + " . $Waive . ",
+									settled = IF(ABS(ovamount + ovgst + ovfreight + ovdiscount - alloc - " . $Waive . ") < 0.005, 1, 0)
+				WHERE id = '" . $Charge['transid'] . "'",
+			__('The charge could not be updated because'), '', true);
+	DB_query("UPDATE creditcharges SET waived = 1,
+										waivedby = '" . $_SESSION['UserID'] . "',
+										waiveddate = NOW(),
+										waivereason = '" . DB_escape_string(mb_substr($Reason, 0, 200)) . "',
+										waivetransno = '" . $Posted['transno'] . "'
+				WHERE chargeid = '" . $ChargeID . "'",
+			__('The charge could not be marked as waived because'), '', true);
+	CreditControlLog($Charge['debtorno'], 'waiver', $Text, -$Waive, $Charge['currabrev'], $Posted['transno']);
+	DB_Txn_Commit();
+	return $Posted['transno'];
+}
+
+/* The amount of the customer's debit items that can be written off */
+function CreditWriteOffable($DebtorNo) {
+	$Result = DB_query("SELECT SUM(balance) FROM debtortrans
+						WHERE debtorno='" . $DebtorNo . "'
+							AND settled = 0
+							AND balance > 0");
+	$MyRow = DB_fetch_row($Result);
+	return (float) $MyRow[0];
+}
+
+/* Posts an approved write-off: a credit on the customer account allocated against the oldest open items, Dr bad debts and Cr debtors control
+at the rates the items were posted at, with any difference in the exchange difference account. */
+function CreditPostWriteOff($WriteOffID, $ApprovedBy) {
+	$Result = DB_query("SELECT creditwriteoffs.*, currencies.rate
+						FROM creditwriteoffs
+						INNER JOIN debtorsmaster ON creditwriteoffs.debtorno = debtorsmaster.debtorno
+						INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+						WHERE writeoffid='" . $WriteOffID . "'
+							AND status = 0");
+	if (DB_num_rows($Result) != 1) {
+		return false;
+	}
+	$WriteOff = DB_fetch_array($Result);
+	$Rate = ($WriteOff['rate'] > 0) ? $WriteOff['rate'] : 1;
+	$TranDate = date('Y-m-d');
+	$Text = __('Bad debt written off') . ': ' . $WriteOff['reason'];
+
+	DB_Txn_Begin();
+	$Posted = CreditPostDebtorTrans(53, $WriteOff['debtorno'], -$WriteOff['amount'], $Rate, $TranDate, $Text, 'write-off ' . $WriteOffID, array(array($_SESSION['CompanyRecord']['baddebtact'], $WriteOff['amount'])));
+
+	/* settle the oldest items first and work out what the debtors control account was debited for them originally */
+	$Items = DB_query("SELECT id, balance, rate, ovamount + ovgst + ovfreight + ovdiscount AS gross
+						FROM debtortrans
+						WHERE debtorno='" . $WriteOff['debtorno'] . "'
+							AND settled = 0
+							AND balance > 0
+							AND id <> '" . $Posted['id'] . "'
+						ORDER BY trandate, id");
+	$Remaining = $WriteOff['amount'];
+	$DebtorsRelieved = 0;
+	while ($Item = DB_fetch_array($Items) and $Remaining > 0.00001) {
+		$Allocate = min($Item['balance'], $Remaining);
+		$ItemRate = ($Item['rate'] > 0) ? $Item['rate'] : $Rate;
+		$DebtorsRelieved += $Allocate / $ItemRate;
+		DB_query("INSERT INTO custallocns (amt, datealloc, transid_allocfrom, transid_allocto)
+					VALUES ('" . $Allocate . "', '" . $TranDate . "', '" . $Posted['id'] . "', '" . $Item['id'] . "')",
+				__('The allocation of the write-off could not be inserted because'), '', true);
+		DB_query("UPDATE debtortrans SET alloc = alloc + " . $Allocate . ",
+										settled = IF(ABS(ovamount + ovgst + ovfreight + ovdiscount - alloc - " . $Allocate . ") < 0.005, 1, 0)
+					WHERE id = '" . $Item['id'] . "'",
+				__('The invoice could not be updated because'), '', true);
+		$Remaining -= $Allocate;
+	}
+	/* CreditPostDebtorTrans credited debtors control at the write-off rate. If the items were posted at other rates correct it */
+	$ExchangeDiff = $DebtorsRelieved - ($WriteOff['amount'] / $Rate);
+	if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1 and abs($ExchangeDiff) > 0.000001) {
+		CreditPostGL(53, $Posted['transno'], $TranDate, $Posted['period'], $_SESSION['CompanyRecord']['debtorsact'], -$ExchangeDiff, $Text);
+		CreditPostGL(53, $Posted['transno'], $TranDate, $Posted['period'], $_SESSION['CompanyRecord']['salesexchangediffact'], $ExchangeDiff, __('Exchange difference on') . ' ' . $Text);
+		DB_query("UPDATE debtortrans SET diffonexch = '" . $ExchangeDiff . "' WHERE id = '" . $Posted['id'] . "'", '', '', true);
+	}
+	DB_query("UPDATE creditwriteoffs SET status = 1,
+										approvedby = '" . $ApprovedBy . "',
+										approveddate = NOW(),
+										transno = '" . $Posted['transno'] . "',
+										homeamount = '" . ($WriteOff['amount'] / $Rate) . "'
+				WHERE writeoffid = '" . $WriteOffID . "'",
+			__('The write-off could not be updated because'), '', true);
+	CreditControlLog($WriteOff['debtorno'], 'writeoff', $Text, $WriteOff['amount'], $WriteOff['currabrev'], $Posted['transno']);
+	if ($WriteOff['putonstop'] == 1) {
+		CreditChangeStatus($WriteOff['debtorno'], 1, __('Put on stop automatically after the bad debt write-off') . ' ' . $WriteOffID);
+	}
+	EnsureGLEntriesBalance(53, $Posted['transno']);
+	DB_Txn_Commit();
+	return $Posted['transno'];
+}
+
+/* Puts a customer on stop (1), on watch (2) or back to normal (0), recording who did it, when and why */
+function CreditChangeStatus($DebtorNo, $Effect, $Reason) {
+	$Code = CreditReasonCode($Effect);
+	if ($Code === false) {
+		return false;
+	}
+	$Old = GetCreditStatus($DebtorNo);
+	if ($Old === false or $Old['holdreason'] == $Code) {
+		return false;
+	}
+	DB_query("UPDATE debtorsmaster SET holdreason = '" . $Code . "' WHERE debtorno = '" . $DebtorNo . "'",
+		__('The credit status could not be changed because'), '', true);
+	$New = GetCreditStatus($DebtorNo);
+	$EventType = ($Effect == 1) ? 'stop' : (($Effect == 2) ? 'watch' : 'normal');
+	CreditControlLog($DebtorNo, $EventType, CreditStatusText($Old['effect']) . ' -> ' . CreditStatusText($New['effect']) . ' (' . $New['reasondescription'] . '): ' . $Reason);
+	return true;
+}

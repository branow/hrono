+}
+echo '<tr><td colspan="6"><b>' . $Count . ' ' . __('customers') . ' - ' . __('total balance in') . ' ' . $HomeCurrency . '</b></td><td class="number"><b>' . locale_number_format($Total, $_SESSION['CompanyRecord']['decimalplaces'] ?? 2) . '</b></td><td></td></tr></table>';
+
+/* 2. over the credit limit */
+CreditReportTableHead(__('Customers over their credit limit'), array(__('Customer'), __('Name'), __('Status'), __('Credit limit'), __('Balance'), __('Over by'), __('Over by in') . ' ' . $HomeCurrency));
+$Total = 0;
+$Count = 0;
+foreach ($Customers as $ID => $Customer) {

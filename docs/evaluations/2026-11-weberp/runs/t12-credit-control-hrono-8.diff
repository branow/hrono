diff --git a/DunningRun.php b/DunningRun.php
new file mode 100644
index 0000000..835822b
--- /dev/null
+++ b/DunningRun.php
@@ -0,0 +1,195 @@
+<?php
+
+/* Overdue reminder letters in escalating stages, sent by email.
+The run is started by credit control. It first shows who would get which letter so customers can be left out (a promised payment, a dispute),
+and only then sends. Every letter sent is recorded in dunninglog and in the customer's credit control history. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Control Reminder Run');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'DunningRun';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/email.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$MinDays = (int)CCSetting('CCMinDaysBetweenLetters', 14);
+
+$Stages = array();
+$StageResult = DB_query("SELECT stage, daysoverdue, subject, body, flagstop FROM dunningstages ORDER BY stage");
+while ($Row = DB_fetch_array($StageResult)) {
+	$Stages[$Row['stage']] = $Row;
+}
+if (sizeof($Stages) == 0) {
+	prnMsg(__('No reminder letter stages have been set up yet'), 'warn');
+	echo '<div class="centre"><a href="' . $RootPath . '/DunningStages.php">' . __('Set up the reminder letter stages') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* Works out what, if anything, a customer gets in a run. A customer who has paid has no overdue items so gets nothing, a disputed invoice
+is not counted, and the same stage is not sent twice in a short time. Returns an array describing the candidate. */
+function CCDunningCandidate($DebtorNo, $Stages, $MinDays) {
+	$Items = CCOverdueItems($DebtorNo, 1);
+	if (sizeof($Items) == 0) {
+		return false;
+	}
+	$MaxDays = 0;
+	$Amount = 0;
+	foreach ($Items as $Item) {
+		$MaxDays = max($MaxDays, $Item['daysoverdue']);
+		$Amount += $Item['balance'];
+	}
+	$Stage = 0;
+	foreach ($Stages as $StageRow) {
+		if ($StageRow['daysoverdue'] <= $MaxDays) {
+			$Stage = $StageRow['stage'];
+		}
+	}
+	if ($Stage == 0) {
+		return false; /*not overdue enough for the first letter*/
+	}
+	$Candidate = array('items' => $Items, 'maxdays' => $MaxDays, 'amount' => $Amount, 'stage' => $Stage, 'skip' => '', 'last' => false);
+	$LastResult = DB_query("SELECT stage, sentdate, DATEDIFF(CURRENT_DATE, sentdate) AS gap FROM dunninglog
+							WHERE debtorno = '" . $DebtorNo . "' ORDER BY sentdate DESC, dunningid DESC LIMIT 1");
+	if (DB_num_rows($LastResult) == 1) {
+		$Last = DB_fetch_array($LastResult);
+		$Candidate['last'] = $Last;
+		if ($Last['gap'] < $MinDays) {
+			$Candidate['skip'] = __('A letter was sent') . ' ' . $Last['gap'] . ' ' . __('days ago');
+		} elseif ($Stage <= $Last['stage'] AND $Last['gap'] < 90) {
+			$Candidate['skip'] = __('Stage') . ' ' . $Last['stage'] . ' ' . __('has already been sent');
+		}
+	}
+	return $Candidate;
+}
+
+function CCDunningLetter($DebtorRow, $Candidate, $StageRow) {
+	$Lines = array();
+	$Lines[] = __('Dear') . ' ' . html_entity_decode($DebtorRow['name'], ENT_QUOTES, 'UTF-8') . ',';
+	$Lines[] = '';
+	$Lines[] = html_entity_decode($StageRow['body'], ENT_QUOTES, 'UTF-8');
+	$Lines[] = '';
+	$Lines[] = __('Overdue invoices') . ' (' . $DebtorRow['currcode'] . '):';
+	foreach ($Candidate['items'] as $Item) {
+		$Lines[] = ($Item['type'] == 51 ? __('Charge') : __('Invoice')) . ' ' . $Item['transno'] . '  ' . ConvertSQLDate($Item['trandate']) . '  ' .
+			$Item['daysoverdue'] . ' ' . __('days overdue') . '  ' . locale_number_format($Item['balance'], $DebtorRow['decimalplaces']) . ' ' . $DebtorRow['currcode'];
+	}
+	$Lines[] = '';
+	$Lines[] = __('Total overdue') . ': ' . locale_number_format($Candidate['amount'], $DebtorRow['decimalplaces']) . ' ' . $DebtorRow['currcode'];
+	$Lines[] = '';
+	$Lines[] = $_SESSION['CompanyRecord']['coyname'];
+	return implode("\n", $Lines);
+}
+
+/* every customer with something open on the account is a possible candidate */
+$DebtorsResult = DB_query("SELECT DISTINCT debtorsmaster.debtorno
+							FROM debtorsmaster
+							INNER JOIN debtortrans ON debtortrans.debtorno = debtorsmaster.debtorno
+							WHERE debtortrans.settled = 0 AND debtortrans.type IN (10, 51) AND debtortrans.balance > 0
+							ORDER BY debtorsmaster.debtorno");
+$DebtorNos = array();
+while ($Row = DB_fetch_row($DebtorsResult)) {
+	$DebtorNos[] = $Row[0];
+}
+
+if (isset($_POST['Send'])) {
+	/*what is sent is worked out again here from the database, not taken from the preview, so a customer who paid in between gets nothing*/
+	$Sent = 0;
+	$ToPost = array();
+	foreach ($DebtorNos as $DebtorNo) {
+		if (!isset($_POST['Include_' . $DebtorNo])) {
+			continue;
+		}
+		$Candidate = CCDunningCandidate($DebtorNo, $Stages, $MinDays);
+		if ($Candidate === false OR $Candidate['skip'] != '') {
+			continue;
+		}
+		$Info = GetCreditStatus($DebtorNo);
+		$StageRow = $Stages[$Candidate['stage']];
+		$Letter = CCDunningLetter($Info, $Candidate, $StageRow);
+		$Emails = CCAccountsEmails($DebtorNo);
+		$InvoiceList = array();
+		foreach ($Candidate['items'] as $Item) {
+			$InvoiceList[] = $Item['transno'];
+		}
+		$Method = 'post';
+		if (sizeof($Emails) > 0) {
+			$From = $_SESSION['CompanyRecord']['coyname'] . '<' . $_SESSION['CompanyRecord']['email'] . '>';
+			$Result = SendEmailFromWebERP($From, $Emails, html_entity_decode($StageRow['subject'], ENT_QUOTES, 'UTF-8'), $Letter, '', true);
+			if ($Result !== true) {
+				prnMsg(__('The reminder to') . ' ' . $DebtorNo . ' ' . __('could not be emailed') . ': ' . $Result, 'error');
+				continue;
+			}
+			$Method = 'email';
+		} else {
+			$ToPost[] = array('debtorno' => $DebtorNo, 'name' => $Info['name'], 'letter' => $Letter);
+		}
+		DB_query("INSERT INTO dunninglog (debtorno, stage, sentdate, userid, method, sentto, currcode, amount, invoices)
+					VALUES ('" . $DebtorNo . "', '" . $Candidate['stage'] . "', '" . date('Y-m-d H:i:s') . "', '" . $_SESSION['UserID'] . "', '" . $Method . "',
+							'" . implode(',', $Emails) . "', '" . $Info['currcode'] . "', '" . $Candidate['amount'] . "', '" . implode(',', $InvoiceList) . "')",
+				__('The reminder could not be recorded because'));
+		CCWriteLog($DebtorNo, 'REMINDER', __('Reminder stage') . ' ' . $Candidate['stage'] . ' ' . ($Method == 'email' ? __('emailed to') . ' ' . implode(', ', $Emails) : __('to be posted')) . '. ' .
+			__('Invoices') . ' ' . implode(', ', $InvoiceList), $Candidate['amount']);
+		$Sent++;
+		if ($StageRow['flagstop']) {
+			prnMsg($DebtorNo . ' ' . htmlspecialchars($Info['name'], ENT_QUOTES, 'UTF-8') . ': ' . __('final notice sent - consider putting the customer on stop') .
+				' <a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($DebtorNo) . '">' . __('Credit control') . '</a>', 'warn');
+		}
+	}
+	prnMsg($Sent . ' ' . __('reminders have been recorded'), 'success');
+	if (sizeof($ToPost) > 0) {
+		echo '<h3>' . __('These customers have no email address for their accounts contact - post these letters') . '</h3>';
+		foreach ($ToPost as $Post) {
+			echo '<div style="page-break-after: always; border: 1px solid #ccc; margin: 10px; padding: 10px;"><b>' . $Post['debtorno'] . ' - ' . $Post['name'] . '</b><pre>' .
+				htmlspecialchars($Post['letter'], ENT_QUOTES, 'UTF-8') . '</pre></div>';
+		}
+	}
+	echo '<div class="centre"><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">' . __('Back to the reminder run') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* preview */
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<table class="selection"><tr><th colspan="9">' . __('Who will get which letter - untick the customers to leave out') . '</th></tr>
+		<tr><th>' . __('Send') . '</th><th>' . __('Customer') . '</th><th>' . __('Overdue') . '</th><th>' . __('Currency') . '</th><th>' . __('Oldest (days)') . '</th>
+		<th>' . __('Letter') . '</th><th>' . __('Last letter') . '</th><th>' . __('Sent by') . '</th><th>' . __('Note') . '</th></tr>';
+$Listed = 0;
+foreach ($DebtorNos as $DebtorNo) {
+	$Candidate = CCDunningCandidate($DebtorNo, $Stages, $MinDays);
+	if ($Candidate === false) {
+		continue;
+	}
+	$Info = GetCreditStatus($DebtorNo);
+	$Emails = CCAccountsEmails($DebtorNo);
+	$Listed++;
+	$Send = ($Candidate['skip'] == '');
+	echo '<tr class="striped_row">
+			<td>' . ($Send ? '<input type="checkbox" name="Include_' . $DebtorNo . '" checked="checked" />' : '') . '</td>
+			<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($DebtorNo) . '">' . $DebtorNo . '</a> ' . htmlspecialchars($Info['name'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td class="number">' . locale_number_format($Candidate['amount'], $Info['decimalplaces']) . '</td>
+			<td>' . $Info['currcode'] . '</td>
+			<td class="number">' . $Candidate['maxdays'] . '</td>
+			<td>' . __('Stage') . ' ' . $Candidate['stage'] . ($Stages[$Candidate['stage']]['flagstop'] ? ' (' . __('final notice') . ')' : '') . '</td>
+			<td>' . ($Candidate['last'] ? __('Stage') . ' ' . $Candidate['last']['stage'] . ' - ' . ConvertSQLDate(mb_substr($Candidate['last']['sentdate'], 0, 10)) : '') . '</td>
+			<td>' . (sizeof($Emails) > 0 ? __('Email') : '<b>' . __('Post - no email address') . '</b>') . '</td>
+			<td>' . $Candidate['skip'] . ($Info['status'] != 'normal' ? ' ' . CCStatusName($Info['status']) : '') . '</td>
+		</tr>';
+}
+if ($Listed == 0) {
+	echo '<tr><td colspan="9">' . __('No customer has overdue invoices that need a reminder') . '</td></tr>';
+}
+echo '</table>';
+if ($Listed > 0) {
+	echo '<div class="centre"><input type="submit" name="Send" value="' . __('Send the reminders') . '" onclick="return confirm(\'' . __('Send the reminder letters to the ticked customers?') . '\');" /></div>';
+}
+echo '</form>';
+
+include('includes/footer.php');

+				<td>' . $Row['currcode'] . '</td>
+				<td class="number">' . ($Over > 0 ? locale_number_format($Local, 2) : '') . '</td>
+			</tr>';
+	}
+	if ($Columns != 'review') {
+		echo '<tr><td colspan="6"><b>' . __('Total over limit in') . ' ' . $HomeCurrency . '</b></td><td class="number"><b>' . locale_number_format($Total, 2) . '</b></td></tr>';

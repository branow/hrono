+++ b/CreditControlSetup.php
@@ -0,0 +1,98 @@
+<?php
+
+/* The settings Finance owns for credit control: review period, interest, late fee, the GL accounts the charges and write-offs post to,
+the write-off approval amount and a few switches. They are stored in the config table like every other system setting. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Control Setup');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlSetup';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/maintenance.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$NumericSettings = array(
+	'CCReviewMonths' => array(__('Standard credit review period (months)'), 12, 1, 60),
+	'CCInterestRate' => array(__('Interest on overdue balances (% a year, 0 for none)'), 0, 0, 100),
+	'CCLateFee' => array(__('Late fee per customer per month (in the company currency, 0 for none)'), 0, 0, 1000000),
+	'CCChargeAfterDays' => array(__('Days overdue before interest or a fee is charged'), 30, 0, 365),
+	'CCWriteOffApprovalLimit' => array(__('Write-offs above this amount (company currency) need Finance Director approval'), 1000, 0, 1000000000),
+	'CCMinDaysBetweenLetters' => array(__('Minimum days between reminder letters to the same customer'), 14, 0, 365),
+);
+$AccountSettings = array(
+	'CCInterestAct' => __('Interest income account'),
+	'CCFeeAct' => __('Late fee income account'),
+	'CCBadDebtAct' => __('Bad debt expense account'),
+);
+$SwitchSettings = array(
+	'CCAutoStopOnWriteOff' => __('Put a customer on stop automatically when a debt is written off'),
+	'CCHoldOverLimitOrders' => __('Hold orders that take a customer over their credit limit for credit control approval'),
+	'CCInterestOnCharges' => __('Charge interest on interest and late fees that are themselves overdue'),
+);
+
+if (isset($_POST['Save'])) {
+	$InputError = 0;
+	$Updates = array();
+	foreach ($NumericSettings as $Name => $Def) {
+		$Value = filter_number_format($_POST[$Name]);
+		if (!is_numeric($Value) OR $Value < $Def[2] OR $Value > $Def[3]) {
+			$InputError = 1;
+			prnMsg($Def[0] . ': ' . __('must be a number from') . ' ' . $Def[2] . ' ' . __('to') . ' ' . $Def[3], 'error');
+		}
+		$Updates[$Name] = $Value;
+	}
+	foreach ($AccountSettings as $Name => $Label) {
+		$Result = DB_query("SELECT accountcode FROM chartmaster WHERE accountcode = '" . $_POST[$Name] . "'");
+		if (DB_num_rows($Result) == 0) {
+			if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1 AND ($_POST[$Name] != '' OR $Name == 'CCBadDebtAct')) {
+				$InputError = 1;
+				prnMsg($Label . ': ' . __('choose an account from the chart of accounts'), 'error');
+			}
+		}
+		$Updates[$Name] = $_POST[$Name];
+	}
+	foreach ($SwitchSettings as $Name => $Label) {
+		$Updates[$Name] = isset($_POST[$Name]) ? 1 : 0;
+	}
+	if ($InputError == 0) {
+		foreach ($Updates as $Name => $Value) {
+			DB_query("UPDATE config SET confvalue = '" . $Value . "' WHERE confname = '" . $Name . "'", __('The setting could not be saved because'));
+			$_SESSION[$Name] = $Value;
+		}
+		prnMsg(__('The credit control settings have been saved'), 'success');
+	}
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset><legend>' . __('Reviews, interest and fees') . '</legend>';
+foreach ($NumericSettings as $Name => $Def) {
+	echo '<field><label for="' . $Name . '">' . $Def[0] . ':</label>
+			<input type="text" class="number" name="' . $Name . '" size="12" value="' . CCSetting($Name, $Def[1]) . '" /></field>';
+}
+echo '</fieldset><fieldset><legend>' . __('General ledger accounts') . '</legend>';
+$Accounts = DB_query("SELECT accountcode, accountname FROM chartmaster ORDER BY accountcode");
+foreach ($AccountSettings as $Name => $Label) {
+	echo '<field><label for="' . $Name . '">' . $Label . ':</label><select name="' . $Name . '"><option value="">' . __('Not set') . '</option>';
+	DB_data_seek($Accounts, 0);
+	while ($Account = DB_fetch_array($Accounts)) {
+		echo '<option value="' . $Account['accountcode'] . '"' . (CCSetting($Name) == $Account['accountcode'] ? ' selected="selected"' : '') . '>' .
+			$Account['accountcode'] . ' - ' . htmlspecialchars($Account['accountname'], ENT_QUOTES, 'UTF-8') . '</option>';
+	}
+	echo '</select></field>';
+}
+echo '</fieldset><fieldset><legend>' . __('Rules') . '</legend>';
+foreach ($SwitchSettings as $Name => $Label) {
+	echo '<field><label for="' . $Name . '">' . $Label . ':</label>
+			<input type="checkbox" name="' . $Name . '" ' . (CCSetting($Name, 0) == 1 ? 'checked="checked"' : '') . ' /></field>';
+}
+echo '</fieldset>
+	<div class="centre"><input type="submit" name="Save" value="' . __('Save settings') . '" /></div>
+	</form>';
+
+include('includes/footer.php');
diff --git a/CreditWriteOff.php b/CreditWriteOff.php
new file mode 100644
index 0000000..5b1fee8
--- /dev/null
+++ b/CreditWriteOff.php
@@ -0,0 +1,178 @@
+<?php
+
+/* Bad debt write-off. Credit control requests a write-off of all or part of a customer's unpaid balance with a reason.
+Up to the amount Finance set it is posted straight away. Above that amount it waits for the Finance Director, and does nothing until approved.
+Posting reduces the customer's balance (a type 53 credit allocated to the oldest open invoices) and the debtors control account, and debits bad debt.
+A customer who has a debt written off is put on stop unless credit control decides otherwise. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Bad Debt Write-offs');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditWriteOff';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_delete.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Limit = CCSetting('CCWriteOffApprovalLimit', 1000);
+$BadDebtAct = CCSetting('CCBadDebtAct');
+$GLLink = ($_SESSION['CompanyRecord']['gllink_debtors'] == 1);
+if ($GLLink AND $BadDebtAct == '') {
+	prnMsg(__('The bad debt account must be chosen before debts can be written off'), 'error');
+	echo '<div class="centre"><a href="' . $RootPath . '/CreditControlSetup.php">' . __('Credit control setup') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* puts a customer on stop with the first hold reason that stops invoicing */
+function CCStopCustomer($DebtorNo, $Why) {
+	$Result = DB_query("SELECT reasoncode, reasondescription FROM holdreasons WHERE dissallowinvoices = 1 ORDER BY reasoncode LIMIT 1");
+	if (DB_num_rows($Result) == 1) {
+		$Row = DB_fetch_array($Result);
+		DB_query("UPDATE debtorsmaster SET holdreason = '" . $Row['reasoncode'] . "' WHERE debtorno = '" . $DebtorNo . "'", '', '', true);
+		CCWriteLog($DebtorNo, 'STOP', $Why . ' (' . $Row['reasondescription'] . ')');
+	}
+}
+
+/* posts a write-off that is allowed to go through. Called inside a transaction. */
+function CCCompleteWriteOff($WriteOff, $ApprovedBy) {
+	$Ceiling = CCWriteOffCeiling($WriteOff['debtorno']);
+	if ($WriteOff['amount'] > $Ceiling + 0.005) {
+		return false; /*the customer has paid in the meantime*/
+	}
+	$TransNo = CCPostWriteOff($WriteOff['writeoffid'], $WriteOff['debtorno'], $WriteOff['amount'], $WriteOff['reason']);
+	DB_query("UPDATE creditwriteoffs SET status = 1, transno = '" . $TransNo . "', approvedby = '" . $ApprovedBy . "', approvaldate = CURRENT_DATE
+				WHERE writeoffid = '" . $WriteOff['writeoffid'] . "'", '', '', true);
+	CCWriteLog($WriteOff['debtorno'], 'WRITEOFF', __('Bad debt written off') . ': ' . $WriteOff['reason'] . '. ' . __('Approved by') . ' ' . $ApprovedBy, -$WriteOff['amount'], 53, $TransNo);
+	if ($WriteOff['stopcustomer'] == 1) {
+		CCStopCustomer($WriteOff['debtorno'], __('Put on stop automatically after a bad debt write-off'));
+	}
+	return $TransNo;
+}
+
+/*------------------------------ Finance Director decisions ------------------------------*/
+if (isset($_POST['Approve']) OR isset($_POST['Reject'])) {
+	if (!CCIsFinanceDirector()) {
+		prnMsg(__('Only the Finance Director can approve or reject a write-off'), 'error');
+	} else {
+		$WriteOffID = (int)(isset($_POST['Approve']) ? $_POST['Approve'] : $_POST['Reject']);
+		$Result = DB_query("SELECT * FROM creditwriteoffs WHERE writeoffid = '" . $WriteOffID . "' AND status = 0");
+		if (DB_num_rows($Result) == 1) {
+			$WriteOff = DB_fetch_array($Result);
+			if (isset($_POST['Approve'])) {
+				DB_Txn_Begin();
+				$TransNo = CCCompleteWriteOff($WriteOff, $_SESSION['UserID']);
+				if ($TransNo === false) {
+					DB_Txn_Rollback();
+					prnMsg(__('The customer no longer owes this amount so the write-off cannot be approved'), 'error');
+				} else {
+					DB_Txn_Commit();
+					prnMsg(__('The write-off has been approved and posted. Number') . ' ' . $TransNo, 'success');
+				}
+			} else {
+				DB_query("UPDATE creditwriteoffs SET status = 2, approvedby = '" . $_SESSION['UserID'] . "', approvaldate = CURRENT_DATE WHERE writeoffid = '" . $WriteOffID . "'");
+				CCWriteLog($WriteOff['debtorno'], 'WOREJECT', __('Write-off request') . ' ' . $WriteOffID . ' ' . __('rejected'), $WriteOff['amount']);
+				prnMsg(__('The write-off has been rejected'), 'info');
+			}
+		}
+	}
+}
+
+/*------------------------------ a new write-off ------------------------------*/
+$DebtorNo = '';
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper($_GET['DebtorNo']);
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper(trim($_POST['DebtorNo']));
+}
+
+if (isset($_POST['Request']) AND CCIsCreditController()) {
+	$Info = GetCreditStatus($DebtorNo);
+	$Amount = filter_number_format($_POST['Amount']);
+	$Reason = trim($_POST['Reason']);
+	$Ceiling = ($Info === false) ? 0 : CCWriteOffCeiling($DebtorNo);
+	if ($Info === false) {
+		prnMsg(__('That customer does not exist'), 'error');
+	} elseif (!is_numeric($Amount) OR $Amount <= 0) {
+		prnMsg(__('The amount to write off must be a number greater than zero'), 'error');
+	} elseif ($Amount > $Ceiling + 0.005) {
+		prnMsg(__('The amount is more than the customer owes on open invoices and charges') . ' (' . locale_number_format($Ceiling, $Info['decimalplaces']) . ' ' . $Info['currcode'] . ')', 'error');
+	} elseif ($Reason == '') {
+		prnMsg(__('A reason is required for a write-off'), 'error');
+	} else {
+		$Stop = isset($_POST['StopCustomer']) ? 1 : 0;
+		DB_Txn_Begin();
+		DB_query("INSERT INTO creditwriteoffs (debtorno, currcode, amount, reason, requestdate, requestedby, status, stopcustomer)
+					VALUES ('" . $DebtorNo . "', '" . $Info['currcode'] . "', '" . $Amount . "', '" . $Reason . "', CURRENT_DATE, '" . $_SESSION['UserID'] . "', 0, '" . $Stop . "')",
+				__('The write-off could not be recorded because'), '', true);
+		$WriteOffID = DB_Last_Insert_ID('creditwriteoffs', 'writeoffid');
+		$HomeValue = CCToLocal($Amount, $Info['rate']);
+		if ($HomeValue <= $Limit) {
+			$WriteOff = DB_fetch_array(DB_query("SELECT * FROM creditwriteoffs WHERE writeoffid = '" . $WriteOffID . "'"));
+			$TransNo = CCCompleteWriteOff($WriteOff, $_SESSION['UserID']);
+			DB_Txn_Commit();
+			prnMsg(__('The write-off has been posted. Number') . ' ' . $TransNo, 'success');
+		} else {
+			CCWriteLog($DebtorNo, 'WOREQUEST', __('Write-off requested, waiting for the Finance Director') . ': ' . $Reason, $Amount);
+			DB_Txn_Commit();
+			prnMsg(__('This write-off is above') . ' ' . locale_number_format($Limit, 2) . ' ' . $_SESSION['CompanyRecord']['currencydefault'] . ' ' .
+				__('so it needs the approval of the Finance Director before it takes effect'), 'warn');
+		}
+	}
+}
+
+/*------------------------------ the form ------------------------------*/
+if (CCIsCreditController()) {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+	echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+	echo '<fieldset><legend>' . __('Write off a bad debt') . '</legend>
+			<field><label for="DebtorNo">' . __('Customer code') . ':</label><input type="text" name="DebtorNo" size="12" maxlength="10" required="required" value="' . htmlspecialchars($DebtorNo, ENT_QUOTES, 'UTF-8') . '" /></field>';
+	$Info = ($DebtorNo != '') ? GetCreditStatus($DebtorNo) : false;
+	if ($Info !== false) {
+		echo '<field><label>' . __('Customer') . ':</label><fieldtext>' . htmlspecialchars($Info['name'], ENT_QUOTES, 'UTF-8') . ' - ' . __('owes on open invoices and charges') . ' ' .
+			locale_number_format(CCWriteOffCeiling($DebtorNo), $Info['decimalplaces']) . ' ' . $Info['currcode'] . ' - ' . CCStatusName($Info['status']) . '</fieldtext></field>';
+	}
+	echo '<field><label for="Amount">' . __('Amount to write off (customer currency)') . ':</label><input type="text" class="number" name="Amount" size="14" required="required" /></field>
+			<field><label for="Reason">' . __('Reason') . ':</label><input type="text" name="Reason" size="60" maxlength="200" required="required" /></field>
+			<field><label for="StopCustomer">' . __('Put the customer on stop') . ':</label>
+				<input type="checkbox" name="StopCustomer" ' . (CCSetting('CCAutoStopOnWriteOff', 1) == 1 ? 'checked="checked"' : '') . ' /></field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Request" value="' . __('Write off') . '" onclick="return confirm(\'' . __('Write off this debt?') . '\');" /></div>
+		</form><br />';
+}
+
+/*------------------------------ waiting for approval ------------------------------*/
+$Pending = DB_query("SELECT creditwriteoffs.*, debtorsmaster.name FROM creditwriteoffs
+					INNER JOIN debtorsmaster ON creditwriteoffs.debtorno = debtorsmaster.debtorno
+					WHERE creditwriteoffs.status = 0 ORDER BY creditwriteoffs.writeoffid");
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<table class="selection"><tr><th colspan="7">' . __('Write-offs waiting for Finance Director approval') . '</th></tr>
+		<tr><th>' . __('Date') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . __('Reason') . '</th><th>' . __('Requested by') . '</th><th colspan="2"></th></tr>';
+if (DB_num_rows($Pending) == 0) {
+	echo '<tr><td colspan="7">' . __('None') . '</td></tr>';
+}
+while ($Row = DB_fetch_array($Pending)) {
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate($Row['requestdate']) . '</td>
+			<td>' . $Row['debtorno'] . ' ' . htmlspecialchars($Row['name'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td class="number">' . locale_number_format($Row['amount'], 2) . ' ' . $Row['currcode'] . '</td>
+			<td>' . $Row['reason'] . '</td>
+			<td>' . $Row['requestedby'] . '</td>';
+	if (CCIsFinanceDirector()) {
+		echo '<td><button type="submit" name="Approve" value="' . $Row['writeoffid'] . '">' . __('Approve') . '</button></td>
+				<td><button type="submit" name="Reject" value="' . $Row['writeoffid'] . '">' . __('Reject') . '</button></td>';
+	} else {
+		echo '<td colspan="2">' . __('Waiting') . '</td>';
+	}
+	echo '</tr>';
+}
+echo '</table></form>
+	<div class="centre"><a href="' . $RootPath . '/CreditWriteOffReport.php">' . __('Bad debt write-off report') . '</a></div>';
+
+include('includes/footer.php');
diff --git a/CreditWriteOffReport.php b/CreditWriteOffReport.php
new file mode 100644
index 0000000..acd4ed6
--- /dev/null
+++ b/CreditWriteOffReport.php
@@ -0,0 +1,60 @@
+<?php
+
+/* Bad debt write-offs over a period: customer, amount, reason, who requested, who approved. A receipt that arrives after a debt was written off is
+entered as a normal receipt, so the report also shows what the customer has paid since the write-off. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Bad Debt Write-off Report');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditWriteOffReport';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/reports.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$FromDate = (isset($_POST['FromDate']) AND preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['FromDate'])) ? $_POST['FromDate'] : date('Y-m-01', strtotime('-11 months'));
+$ToDate = (isset($_POST['ToDate']) AND preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['ToDate'])) ? $_POST['ToDate'] : date('Y-m-d');
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset><legend>' . __('Period') . '</legend>
+		<field><label for="FromDate">' . __('From') . ':</label><input type="date" name="FromDate" value="' . $FromDate . '" /></field>
+		<field><label for="ToDate">' . __('To') . ':</label><input type="date" name="ToDate" value="' . $ToDate . '" /></field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Show" value="' . __('Show') . '" /></div></form><br />';
+
+$Result = DB_query("SELECT creditwriteoffs.*, debtorsmaster.name, currencies.rate,
+						(SELECT COALESCE(-SUM(ovamount), 0) FROM debtortrans
+							WHERE debtortrans.debtorno = creditwriteoffs.debtorno AND debtortrans.type = 12 AND debtortrans.trandate >= creditwriteoffs.approvaldate) AS paidsince
+					FROM creditwriteoffs
+					INNER JOIN debtorsmaster ON creditwriteoffs.debtorno = debtorsmaster.debtorno
+					INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+					WHERE creditwriteoffs.requestdate >= '" . $FromDate . "' AND creditwriteoffs.requestdate <= '" . $ToDate . "'
+					ORDER BY creditwriteoffs.requestdate, creditwriteoffs.writeoffid");
+$Total = 0;
+echo '<table class="selection"><tr><th colspan="9">' . __('Write-offs') . '</th></tr>
+		<tr><th>' . __('Date') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . __('Currency') . '</th><th>' . __('In') . ' ' . $_SESSION['CompanyRecord']['currencydefault'] . '</th>
+		<th>' . __('Reason') . '</th><th>' . __('Requested by') . '</th><th>' . __('Approved by') . '</th><th>' . __('Paid since') . '</th></tr>';
+while ($Row = DB_fetch_array($Result)) {
+	$Status = ($Row['status'] == 1) ? $Row['approvedby'] : (($Row['status'] == 2) ? __('Rejected by') . ' ' . $Row['approvedby'] : __('Waiting for approval'));
+	$Local = ($Row['status'] == 1) ? CCToLocal($Row['amount'], $Row['rate']) : 0;
+	$Total += $Local;
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate($Row['requestdate']) . '</td>
+			<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($Row['debtorno']) . '">' . $Row['debtorno'] . '</a> ' . htmlspecialchars($Row['name'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td class="number">' . locale_number_format($Row['amount'], 2) . '</td>
+			<td>' . $Row['currcode'] . '</td>
+			<td class="number">' . ($Row['status'] == 1 ? locale_number_format($Local, 2) : '') . '</td>
+			<td>' . $Row['reason'] . '</td>

diff --git a/DebtorsReconciliation.php b/DebtorsReconciliation.php
new file mode 100644
index 0000000..3872b84
--- /dev/null
+++ b/DebtorsReconciliation.php
@@ -0,0 +1,108 @@
+<?php
+
+/* Month end agreement between the customer accounts (sales ledger) and the trade debtors control account in the general ledger.
+The total of customer balances is compared with the debtors control account balance. When they differ, the page lists the transactions
+where the two sides disagree so Finance can see why - after interest, fees, waivers and write-offs have been posted. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Debtors Ledger Reconciliation');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'DebtorsReconciliation';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/reports.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if ($_SESSION['CompanyRecord']['gllink_debtors'] != 1) {
+	prnMsg(__('The customer accounts are not linked to the general ledger, so there is nothing to reconcile'), 'info');
+	include('includes/footer.php');
+	exit();
+}
+
+$DebtorsAct = $_SESSION['CompanyRecord']['debtorsact'];
+$Tolerance = CurrencyTolerance($_SESSION['CompanyRecord']['currencydefault']);
+
+/* every transaction: what the customer ledger says in company currency (at the rate the transaction was posted at) against what the ledger holds on the control account */
+$SubLedger = "SELECT debtortrans.type, debtortrans.transno,
+					MIN(debtortrans.debtorno) AS debtorno,
+					SUM((debtortrans.ovamount + debtortrans.ovgst + debtortrans.ovfreight + debtortrans.ovdiscount) / IF(debtortrans.rate = 0, 1, debtortrans.rate)) AS subledger
+			FROM debtortrans
+			GROUP BY debtortrans.type, debtortrans.transno";
+
+/* total of the customer balances, in company currency, each at the rate of its own transaction */
+$BalanceRow = DB_fetch_array(DB_query("SELECT SUM(balance / IF(rate = 0, 1, rate)) AS total FROM debtortrans"));
+$SubTotal = $BalanceRow['total'] == '' ? 0 : $BalanceRow['total'];
+$GLRow = DB_fetch_array(DB_query("SELECT SUM(amount) AS total FROM gltotals WHERE account = '" . $DebtorsAct . "'"));
+$GLTotal = $GLRow['total'] == '' ? 0 : $GLRow['total'];
+$Difference = $SubTotal - $GLTotal;
+
+echo '<table class="selection">
+		<tr><th colspan="2">' . __('Customer accounts against the debtors control account') . '</th></tr>
+		<tr><td>' . __('Total of customer balances') . '</td><td class="number">' . locale_number_format($SubTotal, 2) . '</td></tr>
+		<tr><td>' . __('Debtors control account') . ' ' . $DebtorsAct . '</td><td class="number">' . locale_number_format($GLTotal, 2) . '</td></tr>
+		<tr><td><b>' . __('Difference') . '</b></td><td class="number"><b>' . locale_number_format($Difference, 2) . '</b></td></tr>
+	</table>';
+if (abs($Difference) <= $Tolerance) {
+	prnMsg(__('The customer accounts agree to the debtors control account'), 'success');
+} else {
+	prnMsg(__('The customer accounts do not agree to the debtors control account. The transactions below are where the two disagree'), 'warn');
+}
+
+/* the customer ledger is valued at transaction rates, the control account also carries exchange differences posted when receipts are allocated.
+Those are posted to the control account against the exchange difference account and show up here as ledger-only entries of their own type */
+$Result = DB_query("SELECT sub.type, sub.transno, sub.debtorno, sub.subledger, COALESCE(gl.glamount, 0) AS glamount, systypes.typename
+					FROM (" . $SubLedger . ") sub
+					LEFT JOIN (SELECT type, typeno, SUM(amount) AS glamount FROM gltrans WHERE account = '" . $DebtorsAct . "' GROUP BY type, typeno) gl
+						ON gl.type = sub.type AND gl.typeno = sub.transno
+					INNER JOIN systypes ON systypes.typeid = sub.type
+					WHERE ABS(sub.subledger - COALESCE(gl.glamount, 0)) > 0.01
+					ORDER BY ABS(sub.subledger - COALESCE(gl.glamount, 0)) DESC
+					LIMIT 200");
+echo '<br /><table class="selection"><tr><th colspan="6">' . __('Customer transactions that differ from the general ledger') . '</th></tr>
+		<tr><th>' . __('Type') . '</th><th>' . __('Number') . '</th><th>' . __('Customer') . '</th><th>' . __('Customer ledger') . '</th><th>' . __('General ledger') . '</th><th>' . __('Difference') . '</th></tr>';
+if (DB_num_rows($Result) == 0) {
+	echo '<tr><td colspan="6">' . __('None') . '</td></tr>';
+}
+while ($Row = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>' . $Row['typename'] . '</td>
+			<td class="number"><a href="' . $RootPath . '/GLTransInquiry.php?TypeID=' . $Row['type'] . '&amp;TransNo=' . $Row['transno'] . '">' . $Row['transno'] . '</a></td>
+			<td>' . $Row['debtorno'] . '</td>
+			<td class="number">' . locale_number_format($Row['subledger'], 2) . '</td>
+			<td class="number">' . locale_number_format($Row['glamount'], 2) . '</td>
+			<td class="number">' . locale_number_format($Row['subledger'] - $Row['glamount'], 2) . '</td>
+		</tr>';
+}
+echo '</table>';
+
+/* postings on the control account with no customer transaction behind them: journals to the control account, exchange differences */
+$Result = DB_query("SELECT gltrans.type, gltrans.typeno, systypes.typename, MIN(gltrans.trandate) AS trandate, SUM(gltrans.amount) AS amount
+					FROM gltrans
+					INNER JOIN systypes ON systypes.typeid = gltrans.type
+					WHERE gltrans.account = '" . $DebtorsAct . "'
+						AND NOT EXISTS (SELECT 1 FROM debtortrans WHERE debtortrans.type = gltrans.type AND debtortrans.transno = gltrans.typeno)
+					GROUP BY gltrans.type, gltrans.typeno, systypes.typename
+					HAVING ABS(SUM(gltrans.amount)) > 0.01
+					ORDER BY MIN(gltrans.trandate) DESC
+					LIMIT 100");
+echo '<br /><table class="selection"><tr><th colspan="4">' . __('Postings to the control account with no customer transaction (journals, exchange differences)') . '</th></tr>
+		<tr><th>' . __('Type') . '</th><th>' . __('Number') . '</th><th>' . __('Date') . '</th><th>' . __('Amount') . '</th></tr>';
+if (DB_num_rows($Result) == 0) {
+	echo '<tr><td colspan="4">' . __('None') . '</td></tr>';
+}
+while ($Row = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>' . $Row['typename'] . '</td>
+			<td class="number"><a href="' . $RootPath . '/GLTransInquiry.php?TypeID=' . $Row['type'] . '&amp;TransNo=' . $Row['typeno'] . '">' . $Row['typeno'] . '</a></td>
+			<td>' . ConvertSQLDate($Row['trandate']) . '</td>
+			<td class="number">' . locale_number_format($Row['amount'], 2) . '</td>
+		</tr>';
+}
+echo '</table>';
+
+include('includes/footer.php');

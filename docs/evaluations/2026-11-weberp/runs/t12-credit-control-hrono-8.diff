+
+CCReportTable(__('Customers on watch'),
+	CCFetchAll($BaseSQL . " HAVING holdreasons.dissallowinvoices = 2 ORDER BY debtorsmaster.name"), 'limit', $HomeCurrency);
+
+/* orders credit control has to look at: held for the limit, taken for customers on watch, and still open for customers on stop */
+$OrdersSQL = "SELECT salesorders.orderno,
+					salesorders.orddate,
+					salesorders.creditheld,
+					salesorders.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					holdreasons.dissallowinvoices,
+					currencies.decimalplaces,
+					SUM(salesorderdetails.unitprice * (salesorderdetails.quantity - salesorderdetails.qtyinvoiced) * (1 - salesorderdetails.discountpercent)) AS ordervalue
+				FROM salesorders
+				INNER JOIN salesorderdetails ON salesorders.orderno = salesorderdetails.orderno AND salesorderdetails.completed = 0
+				INNER JOIN debtorsmaster ON salesorders.debtorno = debtorsmaster.debtorno
+				INNER JOIN holdreasons ON debtorsmaster.holdreason = holdreasons.reasoncode
+				INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+				WHERE salesorders.quotation = 0
+					AND (salesorders.creditheld = 1 OR (holdreasons.dissallowinvoices IN (1, 2) AND salesorders.creditheld <> 2))
+					" . $SalesmanFilter . $CurrencyFilter . "
+				GROUP BY salesorders.orderno, salesorders.orddate, salesorders.creditheld, salesorders.debtorno, debtorsmaster.name, debtorsmaster.currcode,
+						holdreasons.dissallowinvoices, currencies.decimalplaces
+				ORDER BY salesorders.orddate";
+$Orders = CCFetchAll($OrdersSQL);
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+if (isset($_POST['Salesman'])) {
+	echo '<input type="hidden" name="Salesman" value="' . $_POST['Salesman'] . '" />';
+}
+if (isset($_POST['Currency'])) {
+	echo '<input type="hidden" name="Currency" value="' . $_POST['Currency'] . '" />';
+}
+echo '<table class="selection"><tr><th colspan="7">' . __('Orders held, or taken for customers on watch or stop') . '</th></tr>
+		<tr><th>' . __('Order') . '</th><th>' . __('Date') . '</th><th>' . __('Customer') . '</th><th>' . __('Why it is listed') . '</th><th>' . __('Value') . '</th><th>' . __('Currency') . '</th><th></th></tr>';
+if (sizeof($Orders) == 0) {
+	echo '<tr><td colspan="7">' . __('None') . '</td></tr>';
+}
+foreach ($Orders as $Order) {
+	if ($Order['creditheld'] == 1) {
+		$Why = __('Held - over credit limit');
+	} elseif ($Order['dissallowinvoices'] == 1) {
+		$Why = __('Customer on stop');
+	} else {
+		$Why = __('Customer on watch');
+	}
+	echo '<tr class="striped_row">
+			<td class="number"><a href="' . $RootPath . '/OrderDetails.php?OrderNumber=' . $Order['orderno'] . '">' . $Order['orderno'] . '</a></td>
+			<td>' . ConvertSQLDate($Order['orddate']) . '</td>
+			<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($Order['debtorno']) . '">' . $Order['debtorno'] . '</a> ' . htmlspecialchars($Order['name'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td>' . $Why . '</td>
+			<td class="number">' . locale_number_format($Order['ordervalue'], $Order['decimalplaces']) . '</td>
+			<td>' . $Order['currcode'] . '</td>
+			<td>' . ($CanChange ? '<button type="submit" name="ReleaseOrder" value="' . $Order['orderno'] . '">' . __('Release') . '</button>' : '') . '</td>
+		</tr>';
+}
+echo '</table></form>';
+
+include('includes/footer.php');
diff --git a/CreditControlSetup.php b/CreditControlSetup.php
new file mode 100644
index 0000000..651e0ab

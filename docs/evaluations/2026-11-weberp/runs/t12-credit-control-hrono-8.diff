diff --git a/CreditCharges.php b/CreditCharges.php
new file mode 100644
index 0000000..2ecf70f
--- /dev/null
+++ b/CreditCharges.php
@@ -0,0 +1,259 @@
+<?php
+
+/* Month end interest and late fees on overdue balances, and the waiver of a charge.
+Charges are raised in the customer's own currency as separate debtortrans rows (type 51, one for interest and one for the fee) so they show on
+the customer account and on the next statement, and are posted to the general ledger: debtors control debited, the income account Finance chose credited.
+A customer is charged once per month per kind of charge - running it again for the same month charges nobody twice.
+A waiver (type 52) reverses a charge for the customer and in the ledger. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Month End Interest and Late Fees');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditCharges';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/money_add.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Rate = CCSetting('CCInterestRate', 0);
+$FeeHome = CCSetting('CCLateFee', 0);
+$AfterDays = (int)CCSetting('CCChargeAfterDays', 30);
+$InterestAct = CCSetting('CCInterestAct');
+$FeeAct = CCSetting('CCFeeAct');
+$GLLink = ($_SESSION['CompanyRecord']['gllink_debtors'] == 1);
+
+if ($Rate == 0 AND $FeeHome == 0) {
+	prnMsg(__('Neither an interest rate nor a late fee has been set up'), 'warn');
+	echo '<div class="centre"><a href="' . $RootPath . '/CreditControlSetup.php">' . __('Credit control setup') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+if ($GLLink AND (($Rate > 0 AND $InterestAct == '') OR ($FeeHome > 0 AND $FeeAct == ''))) {
+	prnMsg(__('The income accounts for interest and late fees must be chosen before charges can be posted'), 'error');
+	echo '<div class="centre"><a href="' . $RootPath . '/CreditControlSetup.php">' . __('Credit control setup') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* the month being charged: this month, or last month when the run is done in the first days of the next */
+$ThisMonth = date('Y-m');
+$LastMonth = date('Y-m', strtotime('first day of last month'));
+$ChargeMonth = (isset($_POST['ChargeMonth']) AND $_POST['ChargeMonth'] == $LastMonth) ? $LastMonth : $ThisMonth;
+$TranDate = ($ChargeMonth == $ThisMonth) ? date('Y-m-d') : date('Y-m-t', strtotime($ChargeMonth . '-01'));
+$DaysInMonth = (int)date('t', strtotime($ChargeMonth . '-01'));
+
+/* what a customer would be charged this month, in the customer's currency */
+function CCChargeCandidate($DebtorNo, $ChargeMonth, $DaysInMonth, $AfterDays, $Rate, $FeeHome) {
+	$Info = GetCreditStatus($DebtorNo);
+	if ($Info === false) {
+		return false;
+	}
+	$Types = (CCSetting('CCInterestOnCharges', 0) == 1) ? '10,51' : '10';
+	$Items = CCOverdueItems($DebtorNo, $AfterDays, false, $Types);
+	if (sizeof($Items) == 0) {
+		return false;
+	}
+	$Base = 0;
+	foreach ($Items as $Item) {
+		$Base += $Item['balance'];
+	}
+	$Interest = 0;
+	$Fee = 0;
+	if ($Rate > 0 AND $Info['exemptinterest'] == 0) {
+		$Interest = round($Base * ($Rate / 100) * $DaysInMonth / 365, $Info['decimalplaces']);
+	}
+	if ($FeeHome > 0 AND $Info['exemptfees'] == 0) {
+		$Fee = round($FeeHome * $Info['rate'], $Info['decimalplaces']);
+	}
+	$Done = array();
+	$DoneResult = DB_query("SELECT chargetype FROM creditcharges WHERE debtorno = '" . $DebtorNo . "' AND chargemonth = '" . $ChargeMonth . "'");
+	while ($DoneRow = DB_fetch_row($DoneResult)) {
+		$Done[$DoneRow[0]] = true;
+	}
+	if (isset($Done[1])) {
+		$Interest = 0;
+	}
+	if (isset($Done[2])) {
+		$Fee = 0;
+	}
+	if ($Interest <= 0 AND $Fee <= 0) {
+		return false;
+	}
+	return array('info' => $Info, 'base' => $Base, 'interest' => $Interest, 'fee' => $Fee, 'count' => sizeof($Items),
+		'exempt' => ($Info['exemptinterest'] ? __('Exempt from interest') . ' ' : '') . ($Info['exemptfees'] ? __('Exempt from fees') : ''));
+}
+
+/* posts one charge. Called inside a transaction. */
+function CCPostCharge($DebtorNo, $ChargeType, $Amount, $ChargeMonth, $TranDate, $Info) {
+	$PeriodNo = GetPeriod(date($_SESSION['DefaultDateFormat'], strtotime($TranDate)));
+	$TransNo = GetNextTransNo(51);
+	$Rate = ($Info['rate'] == 0) ? 1 : $Info['rate'];
+	$Label = ($ChargeType == 1) ? __('Interest on overdue balance') : __('Late payment fee');
+	$Text = $Label . ' ' . $ChargeMonth;
+	CCInsertDebtorTrans(51, $TransNo, $DebtorNo, $TranDate, $PeriodNo, $Rate, $Amount, $Text, $Text);
+	$Local = CCToLocal($Amount, $Rate);
+	if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1 AND $Local != 0) {
+		$Account = ($ChargeType == 1) ? CCSetting('CCInterestAct') : CCSetting('CCFeeAct');
+		CCGLEntry(51, $TransNo, $TranDate, $PeriodNo, $_SESSION['CompanyRecord']['debtorsact'], $DebtorNo . ' ' . $Text, $Local);
+		CCGLEntry(51, $TransNo, $TranDate, $PeriodNo, $Account, $DebtorNo . ' ' . $Text, -$Local);
+		EnsureGLEntriesBalance(51, $TransNo);
+	}
+	DB_query("INSERT INTO creditcharges (debtorno, chargemonth, chargetype, currcode, amount, transno, chargedate, userid)
+				VALUES ('" . $DebtorNo . "', '" . $ChargeMonth . "', '" . $ChargeType . "', '" . $Info['currcode'] . "', '" . $Amount . "', '" . $TransNo . "',
+						'" . $TranDate . "', '" . $_SESSION['UserID'] . "')",
+			__('The charge could not be recorded because'), '', true);
+	CCWriteLog($DebtorNo, 'CHARGE', $Text . ': ' . $Amount . ' ' . $Info['currcode'], $Amount, 51, $TransNo);
+	return $TransNo;
+}
+
+/*------------------------------ waive a charge ------------------------------*/
+if (isset($_POST['Waive'])) {
+	$ChargeID = (int)$_POST['Waive'];
+	$Reason = trim($_POST['WaiveReason' . $ChargeID]);
+	$ChargeResult = DB_query("SELECT creditcharges.*, debtortrans.id AS transid, debtortrans.balance, debtortrans.rate
+								FROM creditcharges
+								INNER JOIN debtortrans ON debtortrans.type = 51 AND debtortrans.transno = creditcharges.transno
+								WHERE creditcharges.chargeid = '" . $ChargeID . "' AND creditcharges.waivedtransno = 0");
+	if ($Reason == '') {
+		prnMsg(__('A reason is required to waive a charge'), 'error');
+	} elseif (DB_num_rows($ChargeResult) == 0) {
+		prnMsg(__('That charge cannot be found or has already been waived'), 'error');
+	} else {
+		$Charge = DB_fetch_array($ChargeResult);
+		$Info = GetCreditStatus($Charge['debtorno']);
+		if ($Charge['balance'] <= 0) {
+			prnMsg(__('That charge has already been paid or cleared, so there is nothing left to waive'), 'warn');
+		} else {
+			DB_Txn_Begin();
+			$PeriodNo = GetPeriod(date($_SESSION['DefaultDateFormat']));
+			$TransNo = GetNextTransNo(52);
+			$TranDate = date('Y-m-d');
+			$Waived = $Charge['balance']; /*the part still outstanding, a charge that was partly paid is waived for what is left*/
+			$Text = __('Waiver of charge') . ' ' . $Charge['transno'] . ': ' . $Reason;
+			$CreditID = CCInsertDebtorTrans(52, $TransNo, $Charge['debtorno'], $TranDate, $PeriodNo, $Charge['rate'], -$Waived, __('Waiver of charge') . ' ' . $Charge['transno'], $Text);
+			CCAllocateCredit($CreditID, $Charge['debtorno'], $Waived, $Charge['transid']);
+			$Local = CCToLocal($Waived, $Charge['rate']);
+			if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1 AND $Local != 0) {
+				$Account = ($Charge['chargetype'] == 1) ? CCSetting('CCInterestAct') : CCSetting('CCFeeAct');
+				CCGLEntry(52, $TransNo, $TranDate, $PeriodNo, $Account, $Charge['debtorno'] . ' ' . $Text, $Local);
+				CCGLEntry(52, $TransNo, $TranDate, $PeriodNo, $_SESSION['CompanyRecord']['debtorsact'], $Charge['debtorno'] . ' ' . $Text, -$Local);
+				EnsureGLEntriesBalance(52, $TransNo);
+			}
+			DB_query("UPDATE creditcharges SET waivedtransno = '" . $TransNo . "', waivedreason = '" . $Reason . "' WHERE chargeid = '" . $ChargeID . "'", '', '', true);
+			CCWriteLog($Charge['debtorno'], 'WAIVER', $Text, -$Waived, 52, $TransNo);
+			DB_Txn_Commit();
+			prnMsg(__('The charge has been waived. Credit note number') . ' ' . $TransNo, 'success');
+		}
+	}
+}
+
+/*------------------------------ post the charges ------------------------------*/
+$DebtorNos = array();
+$DebtorsResult = DB_query("SELECT DISTINCT debtorsmaster.debtorno
+							FROM debtorsmaster
+							INNER JOIN debtortrans ON debtortrans.debtorno = debtorsmaster.debtorno
+							WHERE debtortrans.settled = 0 AND debtortrans.type IN (10, 51) AND debtortrans.balance > 0
+							ORDER BY debtorsmaster.debtorno");
+while ($Row = DB_fetch_row($DebtorsResult)) {
+	$DebtorNos[] = $Row[0];
+}
+
+if (isset($_POST['Post'])) {
+	$Charged = 0;
+	foreach ($DebtorNos as $DebtorNo) {
+		if (!isset($_POST['Include_' . $DebtorNo])) {
+			continue;
+		}
+		/*worked out again from the database - the preview is not trusted, and a month already charged gives nothing*/
+		$Candidate = CCChargeCandidate($DebtorNo, $ChargeMonth, $DaysInMonth, $AfterDays, $Rate, $FeeHome);
+		if ($Candidate === false) {
+			continue;
+		}
+		DB_Txn_Begin();
+		if ($Candidate['interest'] > 0) {
+			CCPostCharge($DebtorNo, 1, $Candidate['interest'], $ChargeMonth, $TranDate, $Candidate['info']);
+		}
+		if ($Candidate['fee'] > 0) {
+			CCPostCharge($DebtorNo, 2, $Candidate['fee'], $ChargeMonth, $TranDate, $Candidate['info']);
+		}
+		DB_Txn_Commit();
+		$Charged++;
+	}
+	prnMsg($Charged . ' ' . __('customers have been charged for') . ' ' . $ChargeMonth, 'success');
+}
+
+/*------------------------------ preview ------------------------------*/
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset><legend>' . __('Month to charge') . '</legend>
+		<field><label for="ChargeMonth">' . __('Month') . ':</label>
+			<select name="ChargeMonth" onchange="this.form.submit();">
+				<option value="' . $ThisMonth . '"' . ($ChargeMonth == $ThisMonth ? ' selected="selected"' : '') . '>' . $ThisMonth . ' (' . __('dated today') . ')</option>
+				<option value="' . $LastMonth . '"' . ($ChargeMonth == $LastMonth ? ' selected="selected"' : '') . '>' . $LastMonth . ' (' . __('dated the last day of the month') . ')</option>
+			</select></field>
+		<field><label>' . __('Terms') . ':</label><fieldtext>' . locale_number_format($Rate, 2) . '% ' . __('a year, late fee') . ' ' . locale_number_format($FeeHome, 2) . ' ' . $_SESSION['CompanyRecord']['currencydefault'] .
+			', ' . __('charged on balances') . ' ' . $AfterDays . ' ' . __('days or more overdue') . '</fieldtext></field>
+	</fieldset>';
+
+echo '<table class="selection"><tr><th colspan="8">' . __('What will be charged to whom') . ' - ' . $ChargeMonth . '</th></tr>
+		<tr><th>' . __('Charge') . '</th><th>' . __('Customer') . '</th><th>' . __('Overdue balance') . '</th><th>' . __('Interest') . '</th><th>' . __('Late fee') . '</th><th>' . __('Currency') . '</th><th>' . __('Note') . '</th></tr>';
+$Listed = 0;
+foreach ($DebtorNos as $DebtorNo) {
+	$Candidate = CCChargeCandidate($DebtorNo, $ChargeMonth, $DaysInMonth, $AfterDays, $Rate, $FeeHome);
+	if ($Candidate === false) {
+		continue;
+	}
+	$Listed++;
+	$Info = $Candidate['info'];
+	echo '<tr class="striped_row">
+			<td><input type="checkbox" name="Include_' . $DebtorNo . '" checked="checked" /></td>
+			<td><a href="' . $RootPath . '/CreditControl.php?DebtorNo=' . urlencode($DebtorNo) . '">' . $DebtorNo . '</a> ' . htmlspecialchars($Info['name'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td class="number">' . locale_number_format($Candidate['base'], $Info['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($Candidate['interest'], $Info['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($Candidate['fee'], $Info['decimalplaces']) . '</td>
+			<td>' . $Info['currcode'] . '</td>
+			<td>' . $Candidate['exempt'] . '</td>
+		</tr>';
+}
+if ($Listed == 0) {
+	echo '<tr><td colspan="7">' . __('Nothing to charge for this month') . '</td></tr>';
+}
+echo '</table>';
+if ($Listed > 0) {
+	echo '<div class="centre"><input type="submit" name="Post" value="' . __('Confirm and post the charges') . '" onclick="return confirm(\'' . __('Post the interest and late fees to the ticked customers?') . '\');" /></div>';
+}
+
+/*------------------------------ recent charges and waivers ------------------------------*/
+$ChargesResult = DB_query("SELECT creditcharges.chargeid, creditcharges.debtorno, creditcharges.chargemonth, creditcharges.chargetype, creditcharges.currcode,
+								creditcharges.amount, creditcharges.transno, creditcharges.waivedtransno, creditcharges.waivedreason, debtorsmaster.name,
+								debtortrans.balance
+							FROM creditcharges
+							INNER JOIN debtorsmaster ON creditcharges.debtorno = debtorsmaster.debtorno
+							LEFT JOIN debtortrans ON debtortrans.type = 51 AND debtortrans.transno = creditcharges.transno
+							ORDER BY creditcharges.chargeid DESC LIMIT 100");
+echo '<br /><table class="selection"><tr><th colspan="7">' . __('Recent charges') . '</th></tr>
+		<tr><th>' . __('Month') . '</th><th>' . __('Customer') . '</th><th>' . __('Charge') . '</th><th>' . __('Amount') . '</th><th>' . __('Outstanding') . '</th><th>' . __('Waive') . '</th></tr>';
+while ($Charge = DB_fetch_array($ChargesResult)) {
+	echo '<tr class="striped_row">
+			<td>' . $Charge['chargemonth'] . '</td>
+			<td>' . $Charge['debtorno'] . ' ' . htmlspecialchars($Charge['name'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td>' . ($Charge['chargetype'] == 1 ? __('Interest') : __('Late fee')) . ' ' . $Charge['transno'] . '</td>
+			<td class="number">' . locale_number_format($Charge['amount'], 2) . ' ' . $Charge['currcode'] . '</td>
+			<td class="number">' . locale_number_format($Charge['balance'], 2) . '</td>
+			<td>';
+	if ($Charge['waivedtransno'] > 0) {
+		echo __('Waived') . ' (' . $Charge['waivedtransno'] . '): ' . $Charge['waivedreason'];
+	} elseif ($Charge['balance'] > 0) {
+		echo '<input type="text" name="WaiveReason' . $Charge['chargeid'] . '" size="30" maxlength="150" placeholder="' . __('Reason') . '" />
+				<button type="submit" name="Waive" value="' . $Charge['chargeid'] . '">' . __('Waive') . '</button>';
+	}
+	echo '</td></tr>';
+}
+echo '</table></form>';
+
+include('includes/footer.php');
diff --git a/CreditControl.php b/CreditControl.php
new file mode 100644
index 0000000..8943594
--- /dev/null
+++ b/CreditControl.php
@@ -0,0 +1,317 @@
+<?php
+
+/* Credit control for one customer: credit reviews, stop and watch, credit limit, disputed invoices, exemptions and the credit history.
+Anyone with the page token can look - sales reps only see their own customers. Changing anything needs the credit control token (21). */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Control');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControl';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . __('Credit Control') . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if (isset($_GET['DebtorNo'])) {
+	$_POST['DebtorNo'] = $_GET['DebtorNo'];
+} elseif (!isset($_POST['DebtorNo']) AND isset($_SESSION['CustomerID']) AND $_SESSION['CustomerID'] != '') {
+	$_POST['DebtorNo'] = $_SESSION['CustomerID'];
+}
+
+$CanChange = CCIsCreditController();
+
+if (!isset($_POST['DebtorNo']) OR $_POST['DebtorNo'] == '') {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+	echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+	echo '<fieldset>
+			<legend>' . __('Select a customer') . '</legend>
+			<field>
+				<label for="DebtorNo">' . __('Customer code') . ':</label>
+				<input type="text" name="DebtorNo" size="12" maxlength="10" autofocus="autofocus" />
+			</field>
+		</fieldset>
+		<div class="centre">
+			<input type="submit" name="Go" value="' . __('Show') . '" />
+			<a href="' . $RootPath . '/SelectCustomer.php">' . __('Search for a customer') . '</a>
+		</div>
+		</form>';
+	include('includes/footer.php');
+	exit();
+}
+
+$DebtorNo = mb_strtoupper(trim($_POST['DebtorNo']));
+$Info = GetCreditStatus($DebtorNo);
+if ($Info === false) {
+	prnMsg(__('Customer') . ' ' . htmlspecialchars($DebtorNo, ENT_QUOTES, 'UTF-8') . ' ' . __('does not exist'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+if (!CCUserMaySeeCustomer($DebtorNo)) {
+	prnMsg(__('You have no authority to review the credit details of this customer'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$_SESSION['CustomerID'] = $DebtorNo;
+
+/*---------------------------------------- actions, credit control only ----------------------------------------*/
+if ($CanChange AND isset($_POST['Review'])) {
+	$InputError = 0;
+	$NewLimit = filter_number_format($_POST['NewLimit']);
+	$Outcome = $_POST['Outcome'];
+	if (!in_array($Outcome, array('CONFIRMED', 'RAISED', 'REDUCED', 'WATCH', 'STOP'))) {
+		$InputError = 1;
+		prnMsg(__('Choose the outcome of the review'), 'error');
+	}
+	if (!is_numeric($NewLimit) OR $NewLimit < 0) {
+		$InputError = 1;
+		prnMsg(__('The credit limit must be a number of zero or more'), 'error');
+	}
+	if (($Outcome == 'RAISED' AND $NewLimit <= $Info['creditlimit']) OR ($Outcome == 'REDUCED' AND $NewLimit >= $Info['creditlimit'])) {
+		$InputError = 1;
+		prnMsg(__('The new credit limit does not agree with the outcome chosen'), 'error');
+	}
+	if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['NextReviewDate']) OR $_POST['NextReviewDate'] <= date('Y-m-d')) {
+		$InputError = 1;
+		prnMsg(__('The next review date must be a date in the future'), 'error');
+	}
+	if ($InputError == 0) {
+		if (in_array($Outcome, array('CONFIRMED', 'WATCH', 'STOP'))) {
+			$NewLimit = $Info['creditlimit']; /*these outcomes do not change the limit*/
+		}
+		DB_Txn_Begin();
+		DB_query("INSERT INTO creditreviews (debtorno, reviewdate, userid, outcome, oldlimit, newlimit, notes, nextreviewdate)
+					VALUES ('" . $DebtorNo . "', CURRENT_DATE, '" . $_SESSION['UserID'] . "', '" . $Outcome . "', '" . $Info['creditlimit'] . "',
+							'" . $NewLimit . "', '" . $_POST['Notes'] . "', '" . $_POST['NextReviewDate'] . "')",
+				__('The credit review could not be recorded because'), '', true);
+		/*the limit moves with the review so the limit and the reason for it are always recorded together*/

+function CCFetchAll($SQL) {
+	$Result = DB_query($SQL);
+	$Rows = array();
+	while ($Row = DB_fetch_array($Result)) {
+		$Rows[] = $Row;
+	}
+	return $Rows;
+}
+
+CCReportTable(__('Customers due or overdue for a credit review'),

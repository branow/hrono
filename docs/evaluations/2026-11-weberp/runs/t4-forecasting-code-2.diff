@@ -0,0 +1,75 @@
+<?php
+
+// Company-wide forecasting defaults, used whenever the user does not override them.
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Forecasting Parameters');
+$ViewTopic = 'Forecasting';
+$BookMark = 'ForecastParameters';
+include('includes/header.php');
+include('includes/ForecastFormFunctions.php');
+
+ForecastPageTitle($Title);
+ForecastNavigation();
+
+$Labels = array(
+	'alpha' => __('Smoothing constant alpha (0.1 to 0.9)'),
+	'beta' => __('Smoothing constant beta (0.1 to 0.9)'),
+	'gamma' => __('Smoothing constant gamma (0.1 to 0.9)'),
+	'seasonlength' => __('Season length in months (2 to 24)'),
+	'maperiods' => __('Moving average periods (2 to 24)'),
+	'holdout' => __('Months held out for best fit and accuracy tests (1 to 12)'),
+	'horizon' => __('Default horizon in monthly periods (1 to 36)')
+);
+
+if (isset($_POST['Save'])) {
+	$InputError = 0;
+	$New = array();
+	foreach ($Labels as $Name => $Label) {
+		$New[$Name] = isset($_POST[$Name]) ? trim($_POST[$Name]) : '';
+		if (!is_numeric($New[$Name])) {
+			prnMsg($Label . ': ' . __('a number is required'), 'error');
+			$InputError = 1;
+		}
+	}
+	if ($InputError == 0) {
+		foreach (array('alpha', 'beta', 'gamma') as $Name) {
+			if ($New[$Name] < 0.1 or $New[$Name] > 0.9) {
+				prnMsg($Labels[$Name] . ': ' . __('the value is out of range'), 'error');
+				$InputError = 1;
+			}
+		}
+		$Whole = array('seasonlength' => array(2, 24), 'maperiods' => array(2, 24), 'holdout' => array(1, 12), 'horizon' => array(1, 36));
+		foreach ($Whole as $Name => $Range) {
+			if ((int) $New[$Name] != $New[$Name] or $New[$Name] < $Range[0] or $New[$Name] > $Range[1]) {
+				prnMsg($Labels[$Name] . ': ' . __('a whole number within the range is required'), 'error');
+				$InputError = 1;
+			}
+		}
+	}
+	if ($InputError == 0) {
+		foreach ($New as $Name => $Value) {
+			DB_query("REPLACE INTO forecastparameters (paramname, paramvalue) VALUES ('" . $Name . "', '" . ($Value + 0) . "')");
+		}
+		prnMsg(__('The forecasting parameters have been saved'), 'success');
+	}
+}
+
+$Current = ForecastGetParameters();
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Company-wide defaults'), '</legend>';
+foreach ($Labels as $Name => $Label) {
+	$Value = (isset($_POST['Save']) and isset($_POST[$Name])) ? $_POST[$Name] : $Current[$Name];
+	echo '<field>
+			<label for="', $Name, '">', $Label, ':</label>
+			<input type="text" class="number" name="', $Name, '" id="', $Name, '" size="6" value="', $Value, '" />
+		</field>';
+}
+echo '</fieldset>
+	<div class="centre"><input type="submit" name="Save" value="', __('Save Parameters'), '" /></div>
+</form>';
+
+include('includes/footer.php');
diff --git a/ForecastReview.php b/ForecastReview.php

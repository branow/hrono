+<?php
+
+// Inquiry on forecasts by item, category, location and period (read only).
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Forecast Inquiry');
+$ViewTopic = 'Forecasting';
+$BookMark = 'ForecastInquiry';
+include('includes/header.php');
+include('includes/ForecastFormFunctions.php');
+
+ForecastPageTitle($Title);
+ForecastNavigation();
+
+$Methods = ForecastMethods();
+$Search = array(
+	'StockID' => isset($_GET['StockID']) ? $_GET['StockID'] : '',
+	'CategoryID' => '',
+	'Location' => '',
+	'FromMonth' => '',
+	'ToMonth' => '',
+	'ActiveOnly' => '1'
+);
+if (isset($_POST['Search'])) {
+	foreach ($Search as $Key => $Value) {
+		$Search[$Key] = isset($_POST[$Key]) ? $_POST[$Key] : '';
+	}
+}
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Select forecasts'), '</legend>
+		<field>
+			<label for="StockID">', __('Item code or part of it or of its description'), ':</label>
+			<input type="text" name="StockID" id="StockID" size="21" maxlength="64" value="', $Search['StockID'], '" />
+		</field>
+		<field>
+			<label for="CategoryID">', __('Stock category'), ':</label>';
+ForecastCategorySelect('CategoryID', $Search['CategoryID'], __('All categories'));
+echo '</field>
+		<field>
+			<label for="Location">', __('Location'), ':</label>';
+ForecastLocationSelect('Location', $Search['Location'], __('All locations'));
+echo '</field>
+		<field>
+			<label for="FromMonth">', __('From period'), ':</label>
+			<input type="month" name="FromMonth" id="FromMonth" value="', $Search['FromMonth'], '" />
+		</field>
+		<field>
+			<label for="ToMonth">', __('To period'), ':</label>
+			<input type="month" name="ToMonth" id="ToMonth" value="', $Search['ToMonth'], '" />
+		</field>
+		<field>
+			<label for="ActiveOnly">', __('Active forecasts only'), ':</label>
+			<input type="checkbox" name="ActiveOnly" id="ActiveOnly" value="1"', ($Search['ActiveOnly'] == '1' ? ' checked="checked"' : ''), ' />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Search" value="', __('Search'), '" /></div>
+</form>';
+
+if (isset($_POST['Search'])) {
+	$Where = '';
+	if ($Search['StockID'] != '') {
+		$Like = '%' . str_replace(' ', '%', $Search['StockID']) . '%';
+		$Where .= " AND (forecasts.stockid LIKE '" . $Like . "' OR stockmaster.description LIKE '" . $Like . "')";
+	}
+	if ($Search['CategoryID'] != '') {
+		$Where .= " AND stockmaster.categoryid = '" . $Search['CategoryID'] . "'";
+	}
+	if ($Search['Location'] != '') {
+		$Where .= " AND forecasts.loccode = '" . $Search['Location'] . "'";
+	}
+	if (preg_match('/^\d{4}-\d{2}$/', $Search['FromMonth'])) {
+		$Where .= " AND forecastdetails.periodstart >= '" . $Search['FromMonth'] . "-01'";
+	}
+	if (preg_match('/^\d{4}-\d{2}$/', $Search['ToMonth'])) {
+		$Where .= " AND forecastdetails.periodstart <= '" . $Search['ToMonth'] . "-01'";
+	}
+	if ($Search['ActiveOnly'] == '1') {
+		$Where .= " AND forecasts.activeflag = 1";
+	}
+	$Result = DB_query("SELECT forecasts.forecastid, forecasts.stockid, forecasts.loccode, forecasts.method, forecasts.activeflag,
+								stockmaster.description, stockmaster.decimalplaces, forecastdetails.periodstart,
+								forecastdetails.calcqty, forecastdetails.revisedqty
+						FROM forecasts
+						INNER JOIN forecastdetails ON forecastdetails.forecastid = forecasts.forecastid
+						INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+						WHERE 1 = 1 " . $Where . ForecastLocationAccessSQL() . "
+						ORDER BY forecasts.stockid, forecasts.loccode, forecasts.forecastid, forecastdetails.periodstart
+						LIMIT 1000");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('No forecasts match the selection'), 'info');
+	} else {
+		echo '<br /><table class="selection">
+				<tr><th>', __('Item'), '</th><th>', __('Description'), '</th><th>', __('Location'), '</th><th>', __('Period'), '</th>
+					<th>', __('Calculated'), '</th><th>', __('Revised'), '</th><th>', __('Quantity used'), '</th>
+					<th>', __('Method'), '</th><th>', __('Status'), '</th></tr>';
+		while ($MyRow = DB_fetch_array($Result)) {
+			$Places = (int) $MyRow['decimalplaces'];
+			$Used = $MyRow['revisedqty'] === null ? $MyRow['calcqty'] : $MyRow['revisedqty'];
+			echo '<tr class="striped_row">
+					<td><a href="', $RootPath, '/ForecastReview.php?ForecastID=', $MyRow['forecastid'], '">', $MyRow['stockid'], '</a></td>
+					<td>', $MyRow['description'], '</td>
+					<td>', ForecastLocationName($MyRow['loccode']), '</td>
+					<td>', ForecastMonthLabel($MyRow['periodstart']), '</td>
+					<td class="number">', locale_number_format($MyRow['calcqty'], $Places), '</td>
+					<td class="number">', ($MyRow['revisedqty'] === null ? '' : locale_number_format($MyRow['revisedqty'], $Places)), '</td>
+					<td class="number">', locale_number_format($Used, $Places), '</td>
+					<td>', $Methods[$MyRow['method']]['name'], '</td>
+					<td>', ($MyRow['activeflag'] == 1 ? __('Active') : __('Superseded')), '</td>
+				</tr>';
+		}
+		echo '</table>';
+		if (DB_num_rows($Result) == 1000) {
+			prnMsg(__('Only the first 1000 rows are shown - narrow the selection'), 'info');
+		}
+	}
+}
+
+include('includes/footer.php');
diff --git a/ForecastParameters.php b/ForecastParameters.php

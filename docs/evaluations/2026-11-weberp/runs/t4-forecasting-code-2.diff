+++ b/ForecastSummaryReview.php
@@ -0,0 +1,132 @@
+<?php
+
+// Review a summary forecast and the detail behind it: the aggregated history it was calculated from,
+// the items that contribute most to that history and, for categories, the item forecasts that add up to it.
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Summary Forecast Review');
+$ViewTopic = 'Forecasting';
+$BookMark = 'ForecastSummaryReview';
+include('includes/header.php');
+include('includes/ForecastFormFunctions.php');
+
+ForecastPageTitle($Title);
+ForecastNavigation();
+
+$Methods = ForecastMethods();
+$Dimensions = ForecastDimensions();
+$SummaryID = 0;
+if (isset($_GET['SummaryID'])) {
+	$SummaryID = (int) $_GET['SummaryID'];
+} elseif (isset($_POST['SummaryID'])) {
+	$SummaryID = (int) $_POST['SummaryID'];
+}
+
+if ($SummaryID > 0) {
+	$Result = DB_query("SELECT * FROM forecastsummaries WHERE summaryid = " . $SummaryID);
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('The summary forecast could not be found'), 'error');
+		$SummaryID = 0;
+	} else {
+		$Summary = DB_fetch_array($Result);
+	}
+}
+
+if ($SummaryID > 0) {
+	$Names = ForecastDimensionKeys($Summary['dimension']);
+	echo '<table class="selection">
+			<tr><th colspan="2">', $Dimensions[$Summary['dimension']], ': ', $Summary['dimkey'], (isset($Names[$Summary['dimkey']]) ? ' - ' . $Names[$Summary['dimkey']] : ''), '</th></tr>
+			<tr><td>', __('Method'), '</td><td>', $Summary['method'], ' - ', $Methods[$Summary['method']]['name'], '</td></tr>
+			<tr><td>', __('History used'), '</td><td>', ForecastMonthLabel($Summary['historyfrom']), ' - ', ForecastMonthLabel($Summary['historyto']), '</td></tr>
+			<tr><td>', __('Generated'), '</td><td>', $Summary['generated'], ' (', $Summary['userid'], ')</td></tr>
+			<tr><td>', __('Status'), '</td><td>', ($Summary['activeflag'] == 1 ? __('Active') : __('Superseded by a later summary forecast')), '</td></tr>
+		</table><br />';
+
+	$History = ForecastDimensionRows($Summary['dimension'], $Summary['dimkey']);
+
+	// for a category, the active item forecasts underneath, all locations combined or else the sum of locations
+	$ItemTotals = array();
+	if ($Summary['dimension'] == 'category') {
+		$Result = DB_query("SELECT forecasts.stockid, forecasts.loccode, forecastdetails.periodstart,
+									" . ForecastEffectiveQtySQL() . " AS qty
+							FROM forecasts
+							INNER JOIN forecastdetails ON forecastdetails.forecastid = forecasts.forecastid
+							INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+							WHERE forecasts.activeflag = 1 AND stockmaster.categoryid = '" . DB_escape_string($Summary['dimkey']) . "'");
+		$PerItem = array();
+		while ($MyRow = DB_fetch_array($Result)) {
+			$PerItem[$MyRow['stockid']][$MyRow['loccode'] == '' ? 'all' : 'loc'][$MyRow['periodstart']] =
+				(isset($PerItem[$MyRow['stockid']][$MyRow['loccode'] == '' ? 'all' : 'loc'][$MyRow['periodstart']]) ? $PerItem[$MyRow['stockid']][$MyRow['loccode'] == '' ? 'all' : 'loc'][$MyRow['periodstart']] : 0) + $MyRow['qty'];
+		}
+		foreach ($PerItem as $ItemPeriods) {
+			foreach ((isset($ItemPeriods['all']) ? $ItemPeriods['all'] : $ItemPeriods['loc']) as $Period => $Qty) {
+				$ItemTotals[$Period] = (isset($ItemTotals[$Period]) ? $ItemTotals[$Period] : 0) + $Qty;
+			}
+		}
+	}
+
+	echo '<table class="selection">
+			<tr><th>', __('Period'), '</th><th>', __('Summary forecast'), '</th><th>', __('Last year actual'), '</th><th>', __('Variance %'), '</th>',
+			($Summary['dimension'] == 'category' ? '<th>' . __('Sum of active item forecasts') . '</th>' : ''), '</tr>';
+	$Result = DB_query("SELECT periodstart, calcqty FROM forecastsummarydetails WHERE summaryid = " . $SummaryID . " ORDER BY periodstart");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$LastYearPeriod = ForecastAddMonths($MyRow['periodstart'], -12);
+		$LastYear = ($LastYearPeriod >= $Summary['historyfrom'] and $LastYearPeriod <= $Summary['historyto']) ? max(0, isset($History[$LastYearPeriod]) ? $History[$LastYearPeriod] : 0) : null;
+		echo '<tr class="striped_row">
+				<td>', ForecastMonthLabel($MyRow['periodstart']), '</td>
+				<td class="number">', locale_number_format($MyRow['calcqty'], 1), '</td>
+				<td class="number">', ($LastYear === null ? '-' : locale_number_format($LastYear, 1)), '</td>
+				<td class="number">', (($LastYear === null or $LastYear <= 0) ? '-' : locale_number_format(($MyRow['calcqty'] - $LastYear) / $LastYear * 100, 1)), '</td>',
+				($Summary['dimension'] == 'category' ? '<td class="number">' . (isset($ItemTotals[$MyRow['periodstart']]) ? locale_number_format($ItemTotals[$MyRow['periodstart']], 1) : '-') . '</td>' : ''), '
+			</tr>';
+	}
+	echo '</table><br />';
+
+	// the history behind the summary, month by month
+	ksort($History);
+	echo '<table class="selection"><tr><th colspan="2">', __('Sales history behind this summary'), '</th></tr>
+			<tr><th>', __('Month'), '</th><th>', __('Net quantity sold'), '</th></tr>';
+	foreach ($History as $Period => $Qty) {
+		echo '<tr class="striped_row"><td>', ForecastMonthLabel($Period), '</td><td class="number">', locale_number_format($Qty, 1), '</td></tr>';
+	}
+	echo '</table><br />';
+
+	// the items contributing most
+	list($Join, $Where) = ForecastDimensionFilter($Summary['dimension'], $Summary['dimkey']);
+	$Result = DB_query("SELECT forecasthistory.stockid, SUM(forecasthistory.qty) AS qty
+						FROM forecasthistory " . ($Join != '' ? $Join : '') . "
+						WHERE " . $Where . "
+						GROUP BY forecasthistory.stockid
+						ORDER BY qty DESC LIMIT 20");
+	echo '<table class="selection"><tr><th colspan="3">', __('Items contributing most to the history'), '</th></tr>
+			<tr><th>', __('Item'), '</th><th>', __('Net quantity sold'), '</th><th></th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row"><td>', $MyRow['stockid'], '</td><td class="number">', locale_number_format($MyRow['qty'], 1), '</td>
+				<td><a href="', $RootPath, '/ForecastInquiry.php?StockID=', urlencode($MyRow['stockid']), '">', __('Item forecasts'), '</a></td></tr>';
+	}
+	echo '</table><br />
+		<div class="centre"><a href="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">', __('Show all summary forecasts'), '</a></div>';
+} else {
+	$Result = DB_query("SELECT summaryid, dimension, dimkey, method, generated, activeflag FROM forecastsummaries
+						ORDER BY dimension, dimkey, summaryid DESC LIMIT 500");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('No summary forecasts have been generated yet'), 'info');
+	} else {
+		echo '<table class="selection">
+				<tr><th>', __('Summarised by'), '</th><th>', __('Value'), '</th><th>', __('Method'), '</th><th>', __('Generated'), '</th><th>', __('Status'), '</th><th></th></tr>';
+		while ($MyRow = DB_fetch_array($Result)) {
+			echo '<tr class="striped_row">
+					<td>', $Dimensions[$MyRow['dimension']], '</td>
+					<td>', $MyRow['dimkey'], '</td>
+					<td>', $Methods[$MyRow['method']]['name'], '</td>
+					<td>', $MyRow['generated'], '</td>
+					<td>', ($MyRow['activeflag'] == 1 ? __('Active') : __('Superseded')), '</td>
+					<td><a href="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '?SummaryID=', $MyRow['summaryid'], '">', __('Review'), '</a></td>
+				</tr>';
+		}
+		echo '</table>';
+	}
+}
+
+include('includes/footer.php');

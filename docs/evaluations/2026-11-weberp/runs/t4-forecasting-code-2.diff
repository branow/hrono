diff --git a/ForecastGenerate.php b/ForecastGenerate.php
new file mode 100644
index 0000000..e329bdd
--- /dev/null
+++ b/ForecastGenerate.php
@@ -0,0 +1,263 @@
+<?php
+
+// Generate forecasts for one item or for every active item of a stock category. Work is done in batches
+// of a few items per request, with progress shown, so that large categories do not run into time limits.
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Generate Forecasts');
+$ViewTopic = 'Forecasting';
+$BookMark = 'ForecastGenerate';
+include('includes/header.php');
+include('includes/ForecastFormFunctions.php');
+
+define('FORECAST_ITEMS_PER_STEP', 25);
+
+ForecastPageTitle($Title);
+ForecastNavigation();
+
+$Defaults = array_merge(ForecastGetParameters(), ForecastRunDefaults());
+$Methods = ForecastMethods();
+$BatchID = 0;
+
+if (isset($_POST['Generate'])) {
+	$InputError = 0;
+	$Scope = ($_POST['Scope'] == 'category') ? 'category' : 'item';
+	$Method = (int) $_POST['Method'];
+	$Horizon = (int) $_POST['Horizon'];
+	$LocCode = $_POST['Location'];
+	$P = ForecastParametersFromPost($_POST);
+	$Items = array();
+	$CategoryID = '';
+
+	if ($Horizon < 1 or $Horizon > 36) {
+		prnMsg(__('The horizon must be from 1 to 36 monthly periods'), 'error');
+		$InputError = 1;
+	}
+	if ($Method > 0) {
+		$Error = ForecastValidateParameters($Method, $P);
+		if ($Error != '') {
+			prnMsg($Error, 'error');
+			$InputError = 1;
+		}
+	} elseif ((int) $P['holdout'] != $P['holdout'] or $P['holdout'] < 1 or $P['holdout'] > 12) {
+		prnMsg(__('The months held out must be a whole number from 1 to 12'), 'error');
+		$InputError = 1;
+	}
+	if ($LocCode != '') {
+		$Result = DB_query("SELECT loccode FROM locationusers WHERE loccode = '" . $LocCode . "'
+							AND userid = '" . $_SESSION['UserID'] . "' AND canview = 1");
+		if (DB_num_rows($Result) == 0) {
+			prnMsg(__('The location is not valid or you may not use it'), 'error');
+			$InputError = 1;
+		}
+	}
+	if ($Scope == 'item') {
+		$StockID = trim(mb_strtoupper($_POST['StockID']));
+		if (ForecastItemDescription($StockID) === null) {
+			prnMsg(__('The item code entered is not a valid stock item'), 'error');
+			$InputError = 1;
+		} else {
+			$Items = array($StockID);
+		}
+	} else {
+		$CategoryID = $_POST['CategoryID'];
+		$Items = ForecastCategoryItems($CategoryID);
+		if (count($Items) == 0) {
+			prnMsg(__('The category has no active items'), 'error');
+			$InputError = 1;
+		}
+	}
+	$BestFit = ($Method == 0) ? 1 : 0;
+	$BatchParams = $P;
+	if ($InputError == 0 and $Scope == 'category' and $BestFit == 1) {
+		// one method for the whole category: the one that does best across its items
+		$Range = ForecastHistoryRange();
+		if ($Range['to'] === null) {
+			prnMsg(__('No sales history has been extracted yet'), 'error');
+			$InputError = 1;
+		} else {
+			set_time_limit(0);
+			$SeriesList = array();
+			foreach ($Items as $Item) {
+				$Series = ForecastBuildSeries(ForecastItemRows($Item, $LocCode), $Range['to']);
+				if (count($Series['values']) > 0) {
+					$SeriesList[] = $Series['values'];
+				}
+			}
+			$Evaluation = ForecastEvaluateCategory($SeriesList, (int) $P['holdout'], $P);
+			if ($Evaluation['best'] == 0) {
+				prnMsg(__('The sales history of the items in this category is too short to test any method'), 'error');
+				$InputError = 1;
+			} else {
+				$Method = $Evaluation['best'];
+				$BatchParams['_fit'] = $Evaluation;
+			}
+		}
+	}
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+		DB_query("INSERT INTO forecastbatches (created, userid, scope, categoryid, loccode, method, bestfit, params, horizon, status)
+					VALUES ('" . date('Y-m-d H:i:s') . "', '" . $_SESSION['UserID'] . "', '" . $Scope . "',
+							'" . $CategoryID . "', '" . $LocCode . "', " . $Method . ", " . $BestFit . ",
+							'" . DB_escape_string(json_encode($BatchParams)) . "', " . $Horizon . ", 'running')", '', '', true);
+		$BatchID = DB_Last_Insert_ID('forecastbatches', 'batchid');
+		foreach ($Items as $Item) {
+			DB_query("INSERT INTO forecastbatchitems (batchid, stockid, status) VALUES (" . $BatchID . ", '" . DB_escape_string($Item) . "', 'pending')", '', '', true);
+		}
+		DB_Txn_Commit();
+	}
+} elseif (isset($_POST['Continue'])) {
+	$BatchID = (int) $_POST['BatchID'];
+}
+
+if ($BatchID > 0) {
+	$Result = DB_query("SELECT * FROM forecastbatches WHERE batchid = " . $BatchID);
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('The batch could not be found'), 'error');
+	} else {
+		$Batch = DB_fetch_array($Result);
+		$BatchP = json_decode($Batch['params'], true);
+		$Fit = isset($BatchP['_fit']) ? $BatchP['_fit'] : null;
+		unset($BatchP['_fit']);
+
+		if ($Batch['status'] == 'running') {
+			$Result = DB_query("SELECT stockid FROM forecastbatchitems
+								WHERE batchid = " . $BatchID . " AND status = 'pending'
+								ORDER BY stockid LIMIT " . FORECAST_ITEMS_PER_STEP);
+			while ($MyRow = DB_fetch_array($Result)) {
+				$Outcome = ForecastGenerateItem($MyRow['stockid'], $Batch['loccode'], ($Batch['bestfit'] == 1 and $Batch['scope'] == 'item') ? 0 : (int) $Batch['method'], $BatchP, (int) $Batch['horizon'], $BatchID);
+				if ($Outcome['ok']) {
+					DB_query("UPDATE forecastbatchitems SET status = 'ok',
+										message = '" . DB_escape_string($Methods[$Outcome['method']]['name']) . "',
+										forecastid = " . (int) $Outcome['forecastid'] . "
+								WHERE batchid = " . $BatchID . " AND stockid = '" . DB_escape_string($MyRow['stockid']) . "'");
+				} else {
+					DB_query("UPDATE forecastbatchitems SET status = 'failed',
+										message = '" . DB_escape_string(mb_substr($Outcome['message'], 0, 255)) . "'
+								WHERE batchid = " . $BatchID . " AND stockid = '" . DB_escape_string($MyRow['stockid']) . "'");
+				}
+			}
+		}
+
+		$Result = DB_query("SELECT SUM(status = 'ok') AS succeeded,
+									SUM(status = 'failed') AS failed,
+									SUM(status = 'pending') AS pending,
+									COUNT(*) AS total
+							FROM forecastbatchitems WHERE batchid = " . $BatchID);
+		$Counts = DB_fetch_array($Result);
+		if ($Counts['pending'] == 0 and $Batch['status'] == 'running') {
+			DB_query("UPDATE forecastbatches SET status = 'done' WHERE batchid = " . $BatchID);
+			$Batch['status'] = 'done';
+		}
+
+		$DoneCount = $Counts['total'] - $Counts['pending'];
+		echo '<table class="selection">
+				<tr><th colspan="2">', __('Forecast batch'), ' ', $BatchID, '</th></tr>
+				<tr><td>', __('Method'), '</td><td>', ($Batch['bestfit'] and $Batch['scope'] == 'item') ? __('Best fit for the item') : $Methods[$Batch['method']]['name'], ($Batch['bestfit'] and $Batch['scope'] == 'category') ? ' (' . __('best fit for the category') . ')' : '', '</td></tr>
+				<tr><td>', __('Location'), '</td><td>', ForecastLocationName($Batch['loccode']), '</td></tr>
+				<tr><td>', __('Horizon'), '</td><td>', $Batch['horizon'], ' ', __('months'), '</td></tr>
+				<tr><td>', __('Progress'), '</td><td><progress value="', $DoneCount, '" max="', $Counts['total'], '"></progress> ', $DoneCount, ' / ', $Counts['total'], '</td></tr>
+			</table><br />';
+
+		if ($Counts['pending'] > 0) {
+			echo '<form method="post" id="ContinueForm" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+					<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+					<input type="hidden" name="BatchID" value="', $BatchID, '" />
+					<div class="centre"><input type="submit" name="Continue" value="', __('Continue'), '" /></div>
+				</form>
+				<script>setTimeout(function() { document.getElementById("ContinueForm").submit(); }, 300);</script>';
+		} else {
+			prnMsg(sprintf(__('%d successful, %d failed'), $Counts['succeeded'], $Counts['failed']), $Counts['failed'] > 0 ? 'warn' : 'success');
+		}
+
+		if ($Fit !== null and $Counts['pending'] == 0) {
+			echo '<table class="selection">
+					<tr><th colspan="5">', __('Best fit across the items of the category'), '</th></tr>
+					<tr><th>', __('Method'), '</th><th>', __('Items tested'), '</th><th>', __('MAD'), '</th><th>', __('POA %'), '</th><th></th></tr>';
+			foreach ($Fit['stats'] as $Number => $Stat) {
+				echo '<tr class="striped_row"><td>', $Number, ' - ', $Methods[$Number]['name'], '</td>
+						<td class="number">', $Stat['items'], '</td>
+						<td class="number">', ForecastNumber($Stat['mad'], 2), '</td>
+						<td class="number">', ($Stat['poa'] === null ? '-' : ForecastNumber($Stat['poa'], 1)), '</td>
+						<td>', ($Number == $Batch['method'] ? '<b>' . __('Recommended') . '</b>' : ''), '</td></tr>';
+			}
+			echo '</table><br />';
+		}
+
+		$Result = DB_query("SELECT stockid, status, message FROM forecastbatchitems
+							WHERE batchid = " . $BatchID . " AND status <> 'pending'
+							ORDER BY FIELD(status, 'failed', 'ok'), stockid LIMIT 500");
+		if (DB_num_rows($Result) > 0) {
+			echo '<table class="selection">
+					<tr><th>', __('Item'), '</th><th>', __('Result'), '</th><th>', __('Method used or reason for failure'), '</th></tr>';
+			while ($MyRow = DB_fetch_array($Result)) {
+				echo '<tr class="striped_row"><td>', $MyRow['stockid'], '</td>
+						<td>', ($MyRow['status'] == 'ok' ? __('Successful') : '<b>' . __('Failed') . '</b>'), '</td>
+						<td>', htmlspecialchars($MyRow['message'], ENT_QUOTES, 'UTF-8'), '</td></tr>';
+			}
+			echo '</table>';
+			if ($Counts['total'] > 500) {
+				echo '<p>', __('Only the first 500 results are listed, failures first'), '</p>';
+			}
+		}
+	}
+	echo '<br />';
+}
+
+// Entry form
+$Post = $_POST;
+foreach ($Defaults as $Name => $Value) {
+	if (!isset($Post[$Name])) {
+		$Post[$Name] = $Value;
+	}
+}
+$Post['Scope'] = $Post['Scope'] ?? 'item';
+$Post['Method'] = $Post['Method'] ?? 0;
+$Post['Horizon'] = $Post['Horizon'] ?? $Defaults['horizon'];
+$Post['StockID'] = $Post['StockID'] ?? (isset($_GET['StockID']) ? $_GET['StockID'] : '');
+$Post['Location'] = $Post['Location'] ?? '';
+$Post['CategoryID'] = $Post['CategoryID'] ?? '';
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Forecast to generate'), '</legend>
+		<field>
+			<label for="Scope">', __('Generate for'), ':</label>
+			<select name="Scope" id="Scope">
+				<option value="item"', ($Post['Scope'] == 'item' ? ' selected="selected"' : ''), '>', __('A single item'), '</option>
+				<option value="category"', ($Post['Scope'] == 'category' ? ' selected="selected"' : ''), '>', __('Every active item of a stock category'), '</option>
+			</select>
+		</field>
+		<field>
+			<label for="StockID">', __('Item code (single item)'), ':</label>
+			<input type="text" name="StockID" id="StockID" size="21" maxlength="64" value="', $Post['StockID'], '" />
+		</field>
+		<field>
+			<label for="CategoryID">', __('Stock category (batch)'), ':</label>';
+ForecastCategorySelect('CategoryID', $Post['CategoryID']);
+echo '</field>
+		<field>
+			<label for="Location">', __('Location'), ':</label>';
+ForecastLocationSelect('Location', $Post['Location'], __('All locations combined'));
+echo '</field>
+		<field>
+			<label for="Method">', __('Method'), ':</label>';
+ForecastMethodSelect('Method', $Post['Method']);
+echo '</field>
+		<field>
+			<label for="Horizon">', __('Horizon in monthly periods'), ':</label>
+			<input type="text" class="number" name="Horizon" id="Horizon" size="4" value="', $Post['Horizon'], '" />
+		</field>
+	</fieldset>
+	<fieldset>
+		<legend>', __('Method parameters'), '</legend>';
+ForecastParameterFields($Post);
+echo '</fieldset>
+	<div class="centre">
+		<input type="submit" name="Generate" value="', __('Generate Forecasts'), '" />
+	</div>
+</form>';
+
+include('includes/footer.php');
diff --git a/ForecastHistory.php b/ForecastHistory.php
new file mode 100644
index 0000000..b3772fe
--- /dev/null
+++ b/ForecastHistory.php
@@ -0,0 +1,89 @@
+<?php
+
+// Extract the monthly sales history (net of credits) that the forecasts are calculated from.
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Forecast Sales History');
+$ViewTopic = 'Forecasting';
+$BookMark = 'ForecastHistory';
+include('includes/header.php');
+include('includes/ForecastFormFunctions.php');
+
+ForecastPageTitle($Title);
+ForecastNavigation();
+
+$CurrentMonth = date('Y-m-01');
+$LastFullMonth = ForecastAddMonths($CurrentMonth, -1);
+
+if (isset($_POST['Extract'])) {
+	$InputError = 0;
+	if (!isset($_POST['FromMonth']) or !preg_match('/^\d{4}-\d{2}$/', $_POST['FromMonth']) or
+		!isset($_POST['ToMonth']) or !preg_match('/^\d{4}-\d{2}$/', $_POST['ToMonth'])) {
+		prnMsg(__('The first and last month must be entered as year and month'), 'error');
+		$InputError = 1;
+	} else {
+		$FromMonth = $_POST['FromMonth'] . '-01';
+		$ToMonth = $_POST['ToMonth'] . '-01';
+		if ($FromMonth > $ToMonth) {
+			prnMsg(__('The first month cannot be after the last month'), 'error');
+			$InputError = 1;
+		} elseif ($ToMonth >= $CurrentMonth) {
+			prnMsg(__('The current month is not complete yet, so the history can only run up to the end of last month'), 'error');
+			$InputError = 1;
+		} else {
+			// The series built from the history assume every month between its first and last is held, so no gaps
+			$Held = ForecastHistoryRange();
+			if ($Held['to'] !== null and ($FromMonth > ForecastAddMonths($Held['to'], 1) or $ToMonth < ForecastAddMonths($Held['from'], -1))) {
+				prnMsg(__('The range must overlap or follow on from the history already held') . ' (' .
+					ForecastMonthLabel($Held['from']) . ' - ' . ForecastMonthLabel($Held['to']) . '), ' .
+					__('otherwise the months in between would count as months without sales'), 'error');
+				$InputError = 1;
+			}
+		}
+	}
+	if ($InputError == 0) {
+		$Rows = ForecastExtractHistory($FromMonth, $ToMonth);
+		prnMsg(sprintf(__('Sales history for %s to %s has been extracted: %d item, location and month records written, replacing any history held for those months'),
+			ForecastMonthLabel($FromMonth), ForecastMonthLabel($ToMonth), $Rows), 'success');
+	}
+}
+
+$Held = ForecastHistoryRange();
+echo '<table class="selection">
+		<tr><th colspan="2">', __('History held'), '</th></tr>';
+if ($Held['to'] === null) {
+	echo '<tr><td colspan="2">', __('No sales history has been extracted yet'), '</td></tr>';
+} else {
+	echo '<tr><td>', __('From'), '</td><td>', ForecastMonthLabel($Held['from']), '</td></tr>
+		<tr><td>', __('To'), '</td><td>', ForecastMonthLabel($Held['to']), '</td></tr>
+		<tr><td>', __('Months'), '</td><td class="number">', $Held['months'], '</td></tr>
+		<tr><td>', __('Items with sales'), '</td><td class="number">', $Held['items'], '</td></tr>';
+}
+echo '</table><br />';
+
+if (!isset($_POST['ToMonth'])) {
+	$_POST['ToMonth'] = substr($LastFullMonth, 0, 7);
+	$_POST['FromMonth'] = substr(ForecastAddMonths($LastFullMonth, -23), 0, 7);
+}
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Extract Sales History'), '</legend>
+		<field>
+			<label for="FromMonth">', __('From month'), ':</label>
+			<input type="month" name="FromMonth" id="FromMonth" required="required" value="', $_POST['FromMonth'], '" />
+		</field>
+		<field>
+			<label for="ToMonth">', __('To month'), ':</label>
+			<input type="month" name="ToMonth" id="ToMonth" required="required" value="', $_POST['ToMonth'], '" />
+		</field>
+		<fieldhelp>', __('Net sales quantities (invoices less credit notes) by month, item and stock location. 24 months are recommended. Extracting a range again replaces that range.'), '</fieldhelp>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="Extract" value="', __('Extract Sales History'), '" />
+	</div>
+</form>';
+
+include('includes/footer.php');
diff --git a/ForecastInquiry.php b/ForecastInquiry.php

@@ -0,0 +1,118 @@
+<?php
+
+// Form and display helpers shared by the Forecast*.php pages.
+
+include_once(__DIR__ . '/ForecastFunctions.php');
+
+function ForecastPageTitle($Title) {
+	global $RootPath, $Theme;
+	echo '<p class="page_title_text"><img src="', $RootPath, '/css/', $Theme, '/images/inventory.png" title="', $Title, '" alt="" /> ', $Title, '</p>';
+}
+
+function ForecastNumber($Value, $Decimals = 1) {
+	return locale_number_format($Value, $Decimals);
+}
+
+/* Links to the other forecasting functions, shown at the top of each page */
+function ForecastNavigation() {
+	global $RootPath;
+	$Links = array(
+		'ForecastDashboard.php' => __('Dashboard'),
+		'ForecastHistory.php' => __('Sales History'),
+		'ForecastGenerate.php' => __('Generate'),
+		'ForecastReview.php' => __('Review and Revise'),
+		'ForecastSummary.php' => __('Summary Forecasts'),
+		'ForecastAccuracy.php' => __('Accuracy'),
+		'ForecastCompare.php' => __('Method Comparison'),
+		'ForecastInquiry.php' => __('Inquiry'),
+		'ForecastToMRP.php' => __('Convert to MRP'),
+		'ForecastParameters.php' => __('Parameters')
+	);
+	$Items = array();
+	foreach ($Links as $Script => $Caption) {
+		if (isset($_SESSION['PageSecurityArray'][$Script]) and in_array($_SESSION['PageSecurityArray'][$Script], $_SESSION['AllowedPageSecurityTokens'])) {
+			$Items[] = '<a href="' . $RootPath . '/' . $Script . '">' . $Caption . '</a>';
+		}
+	}
+	echo '<div class="centre">', implode(' | ', $Items), '</div><br />';
+}
+
+function ForecastCategorySelect($Name, $Selected, $AllLabel = '') {
+	echo '<select name="', $Name, '" id="', $Name, '">';
+	if ($AllLabel != '') {
+		echo '<option value="">', $AllLabel, '</option>';
+	}
+	$Result = DB_query("SELECT categoryid, categorydescription FROM stockcategory ORDER BY categorydescription");
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<option value="', $MyRow['categoryid'], '"', ($MyRow['categoryid'] == $Selected ? ' selected="selected"' : ''), '>',
+			$MyRow['categorydescription'], '</option>';
+	}
+	echo '</select>';
+}
+
+/* Location choice; the empty value means all locations combined (or no location filter on searches) */
+function ForecastLocationSelect($Name, $Selected, $AllLabel) {
+	echo '<select name="', $Name, '" id="', $Name, '">
+			<option value="">', $AllLabel, '</option>';
+	$Result = DB_query("SELECT locations.loccode, locations.locationname
+						FROM locations
+						INNER JOIN locationusers ON locationusers.loccode = locations.loccode
+							AND locationusers.userid = '" . $_SESSION['UserID'] . "'
+							AND locationusers.canview = 1
+						ORDER BY locations.locationname");
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<option value="', $MyRow['loccode'], '"', ($MyRow['loccode'] == $Selected ? ' selected="selected"' : ''), '>',
+			$MyRow['locationname'], '</option>';
+	}
+	echo '</select>';
+}
+
+/* Restrict forecasts to the all-locations ones and the locations the user may view */
+function ForecastLocationAccessSQL($Alias = 'forecasts') {
+	return " AND (" . $Alias . ".loccode = '' OR " . $Alias . ".loccode IN (SELECT loccode FROM locationusers
+				WHERE userid = '" . $_SESSION['UserID'] . "' AND canview = 1)) ";
+}
+
+function ForecastMethodSelect($Name, $Selected, $BestFit = true, $Id = '') {
+	echo '<select name="', $Name, '" id="', ($Id != '' ? $Id : $Name), '">';
+	if ($BestFit) {
+		echo '<option value="0"', ($Selected == 0 ? ' selected="selected"' : ''), '>', __('Best fit (let the system choose)'), '</option>';
+	}
+	foreach (ForecastMethods() as $Number => $Details) {
+		echo '<option value="', $Number, '"', ($Number == $Selected ? ' selected="selected"' : ''), '>',
+			$Number, ' - ', $Details['name'], ' (', sprintf(__('min %d months'), $Details['min']), ')</option>';
+	}
+	echo '</select>';
+}
+
+/* Input fields for every method parameter, prefilled from $P */
+function ForecastParameterFields($P) {
+	$Fields = array(
+		'pct' => array(__('Percent over last year (method 1)'), 8),
+		'maperiods' => array(__('Moving average periods (method 4)'), 4),
+		'pointsapart' => array(__('Months spanned by the two points (method 5)'), 4),
+		'flexweights' => array(__('Flexible method weights, most recent month first (method 8)'), 40),
+		'wmaweights' => array(__('Weighted moving average weights, most recent month first (method 9)'), 20),
+		'alpha' => array(__('Alpha, 0.1 to 0.9 (methods 10, 11, 12)'), 5),
+		'beta' => array(__('Beta, 0.1 to 0.9 (methods 11, 12)'), 5),
+		'gamma' => array(__('Gamma, 0.1 to 0.9 (method 12)'), 5),
+		'seasonlength' => array(__('Season length in months (method 12)'), 4),
+		'holdout' => array(__('Months held out for best fit and accuracy tests'), 4)
+	);
+	foreach ($Fields as $Name => $Details) {
+		echo '<field>
+				<label for="', $Name, '">', $Details[0], ':</label>
+				<input type="text" name="', $Name, '" id="', $Name, '" size="', $Details[1], '" value="', htmlspecialchars($P[$Name], ENT_QUOTES, 'UTF-8'), '" />
+			</field>';
+	}
+}
+
+/* Stock item code check, returns the item's description or null */
+function ForecastItemDescription($StockID) {
+	$Result = DB_query("SELECT description FROM stockmaster WHERE stockid = '" . DB_escape_string($StockID) . "'");
+	if (DB_num_rows($Result) == 0) {
+		return null;
+	}
+	$MyRow = DB_fetch_row($Result);
+	return $MyRow[0];
+}
diff --git a/includes/ForecastFunctions.php b/includes/ForecastFunctions.php
new file mode 100644

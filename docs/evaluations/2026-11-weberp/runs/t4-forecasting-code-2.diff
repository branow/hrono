+<?php
+
+// Convert active forecasts (revised quantity first) into MRP demands under the forecast demand type, so that the
+// existing MRP run plans purchases and work orders from them. Only demands written by this conversion are ever
+// replaced; demands entered by hand or from other sources are never touched.
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Convert Forecasts to MRP Demands');
+$ViewTopic = 'MRP';
+$BookMark = 'ForecastToMRP';
+include('includes/header.php');
+include('includes/ForecastFormFunctions.php');
+
+ForecastPageTitle($Title);
+ForecastNavigation();
+
+$Post = array(
+	'FromDate' => date('Y-m-01'),
+	'ToDate' => date('Y-m-t', strtotime(ForecastAddMonths(date('Y-m-01'), 5))),
+	'Mode' => 'replace',
+	'CategoryID' => ''
+);
+if (isset($_POST['Convert'])) {
+	foreach ($Post as $Key => $Value) {
+		$Post[$Key] = isset($_POST[$Key]) ? $_POST[$Key] : '';
+	}
+}
+
+if (isset($_POST['Convert'])) {
+	$InputError = 0;
+	if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $Post['FromDate']) or !preg_match('/^\d{4}-\d{2}-\d{2}$/', $Post['ToDate']) or $Post['FromDate'] > $Post['ToDate']) {
+		prnMsg(__('Enter a valid horizon, with the first date not after the last date'), 'error');
+		$InputError = 1;
+	}
+	if ($Post['Mode'] != 'replace' and $Post['Mode'] != 'incremental') {
+		prnMsg(__('Choose replace or incremental mode'), 'error');
+		$InputError = 1;
+	}
+	if ($InputError == 0) {
+		// The dedicated demand type must exist; recreate it if someone has deleted it
+		DB_query("INSERT IGNORE INTO mrpdemandtypes (mrpdemandtype, description) VALUES ('" . FORECAST_DEMAND_TYPE . "', 'Forecast (generated)')");
+
+		$Result = DB_query("SELECT forecasts.forecastid, forecasts.stockid, forecasts.loccode, forecastdetails.periodstart,
+									" . ForecastEffectiveQtySQL() . " AS qty, stockmaster.decimalplaces
+							FROM forecasts
+							INNER JOIN forecastdetails ON forecastdetails.forecastid = forecasts.forecastid
+							INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+							WHERE forecasts.activeflag = 1
+								AND stockmaster.discontinued = 0
+								AND forecastdetails.periodstart >= '" . $Post['FromDate'] . "'
+								AND forecastdetails.periodstart <= '" . $Post['ToDate'] . "'" .
+								($Post['CategoryID'] != '' ? " AND stockmaster.categoryid = '" . $Post['CategoryID'] . "'" : '') . "
+							ORDER BY forecasts.stockid, forecasts.forecastid, forecastdetails.periodstart");
+		// MRP demands carry no location. An item with an all-locations forecast uses that one alone; otherwise
+		// the active forecasts of its locations are added up, so no quantity is counted twice.
+		$PerItem = array();
+		while ($MyRow = DB_fetch_array($Result)) {
+			$Part = $MyRow['loccode'] == '' ? 'all' : 'loc';
+			if (!isset($PerItem[$MyRow['stockid']][$Part][$MyRow['periodstart']])) {
+				$PerItem[$MyRow['stockid']][$Part][$MyRow['periodstart']] = array('qty' => 0, 'forecastid' => $MyRow['forecastid'], 'places' => (int) $MyRow['decimalplaces']);
+			}
+			$PerItem[$MyRow['stockid']][$Part][$MyRow['periodstart']]['qty'] += $MyRow['qty'];
+		}
+		if (count($PerItem) == 0) {
+			prnMsg(__('There are no active forecasts with periods in this horizon'), 'info');
+		} else {
+			$Items = array_keys($PerItem);
+			$Removed = $Written = $Skipped = 0;
+
+			DB_Txn_Begin();
+			if ($Post['Mode'] == 'replace') {
+				foreach (array_chunk($Items, 200) as $Chunk) {
+					$Escaped = array();
+					foreach ($Chunk as $Item) {
+						$Escaped[] = DB_escape_string($Item);
+					}
+					$Deleted = DB_query("DELETE mrpdemands FROM mrpdemands
+											INNER JOIN forecastmrpdemands ON forecastmrpdemands.demandid = mrpdemands.demandid
+										WHERE mrpdemands.mrpdemandtype = '" . FORECAST_DEMAND_TYPE . "'
+											AND forecastmrpdemands.periodstart >= '" . $Post['FromDate'] . "'
+											AND forecastmrpdemands.periodstart <= '" . $Post['ToDate'] . "'
+											AND forecastmrpdemands.stockid IN ('" . implode("','", $Escaped) . "')", '', '', true);
+					$Removed += DB_affected_rows($Deleted);
+				}
+			}
+			$Present = array();
+			if ($Post['Mode'] == 'incremental') {
+				$Result = DB_query("SELECT stockid, periodstart FROM forecastmrpdemands
+									WHERE periodstart >= '" . $Post['FromDate'] . "' AND periodstart <= '" . $Post['ToDate'] . "'");
+				while ($MyRow = DB_fetch_array($Result)) {
+					$Present[$MyRow['stockid'] . '|' . $MyRow['periodstart']] = true;
+				}
+			}
+			foreach ($PerItem as $StockID => $Parts) {
+				foreach ((isset($Parts['all']) ? $Parts['all'] : $Parts['loc']) as $Period => $Demand) {
+					$Qty = round($Demand['qty'], $Demand['places']);
+					if ($Qty <= 0 or isset($Present[$StockID . '|' . $Period])) {
+						$Skipped++;
+						continue;
+					}
+					DB_query("INSERT INTO mrpdemands (stockid, mrpdemandtype, quantity, duedate)
+								VALUES ('" . DB_escape_string($StockID) . "', '" . FORECAST_DEMAND_TYPE . "', " . $Qty . ", '" . $Period . "')", '', '', true);
+					$DemandID = DB_Last_Insert_ID('mrpdemands', 'demandid');
+					DB_query("INSERT INTO forecastmrpdemands (demandid, forecastid, stockid, periodstart)
+								VALUES (" . (int) $DemandID . ", " . (int) $Demand['forecastid'] . ", '" . DB_escape_string($StockID) . "', '" . $Period . "')", '', '', true);
+					$Written++;
+				}
+			}
+			DB_Txn_Commit();
+			prnMsg(sprintf(__('%d items converted: %d MRP demands written, %d earlier forecast demands removed, %d periods skipped (no quantity, or already converted)'),
+				count($Items), $Written, $Removed, $Skipped), 'success');
+		}
+	}
+}
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Conversion to MRP demands'), '</legend>
+		<field>
+			<label for="FromDate">', __('Forecast periods from'), ':</label>
+			<input type="date" name="FromDate" id="FromDate" required="required" value="', $Post['FromDate'], '" />
+		</field>
+		<field>
+			<label for="ToDate">', __('Forecast periods to'), ':</label>
+			<input type="date" name="ToDate" id="ToDate" required="required" value="', $Post['ToDate'], '" />
+		</field>
+		<field>
+			<label for="CategoryID">', __('Stock category'), ':</label>';
+ForecastCategorySelect('CategoryID', $Post['CategoryID'], __('All categories'));
+echo '</field>
+		<field>
+			<label for="Mode">', __('Mode'), ':</label>
+			<select name="Mode" id="Mode">
+				<option value="replace"', ($Post['Mode'] == 'replace' ? ' selected="selected"' : ''), '>', __('Replace the forecast demands of these items and dates'), '</option>
+				<option value="incremental"', ($Post['Mode'] == 'incremental' ? ' selected="selected"' : ''), '>', __('Incremental - add only periods not yet converted'), '</option>
+			</select>
+		</field>
+		<fieldhelp>', sprintf(__('Demands are written under demand type %s, dated the first day of each forecast month, using the revised quantity where one was entered. Demands entered by hand are never changed.'), FORECAST_DEMAND_TYPE), '</fieldhelp>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Convert" value="', __('Convert to MRP Demands'), '" /></div>
+</form>
+<br />
+<div class="centre">
+	<a href="', $RootPath, '/MRPDemands.php">', __('Master Schedule'), '</a> |
+	<a href="', $RootPath, '/MRP.php">', __('MRP Calculation'), '</a> |
+	<a href="', $RootPath, '/MRPReport.php">', __('MRP'), '</a>
+</div>';
+
+include('includes/footer.php');

+<?php
+
+// Demand forecasting module: tables, scripts, menus, the Forecasting module and the MRP demand type for forecasts.
+
+CreateTable('forecastparameters',
+"CREATE TABLE `forecastparameters` (
+  `paramname` varchar(30) NOT NULL DEFAULT '',
+  `paramvalue` varchar(30) NOT NULL DEFAULT '',
+  PRIMARY KEY (`paramname`)
+)");
+
+CreateTable('forecasthistory',
+"CREATE TABLE `forecasthistory` (
+  `stockid` varchar(64) NOT NULL DEFAULT '',
+  `loccode` varchar(5) NOT NULL DEFAULT '',
+  `periodstart` date NOT NULL DEFAULT '1000-01-01',
+  `debtortype` tinyint NOT NULL DEFAULT '0',
+  `area` varchar(3) NOT NULL DEFAULT '',
+  `salesman` varchar(4) NOT NULL DEFAULT '',
+  `qty` double NOT NULL DEFAULT '0',
+  PRIMARY KEY (`stockid`,`loccode`,`periodstart`,`debtortype`,`area`,`salesman`),
+  KEY `periodstart` (`periodstart`),
+  KEY `loccode` (`loccode`)
+)");
+
+CreateTable('forecasts',
+"CREATE TABLE `forecasts` (
+  `forecastid` int NOT NULL AUTO_INCREMENT,
+  `stockid` varchar(64) NOT NULL DEFAULT '',
+  `loccode` varchar(5) NOT NULL DEFAULT '',
+  `method` tinyint NOT NULL DEFAULT '0',
+  `params` text,
+  `horizon` smallint NOT NULL DEFAULT '0',
+  `historyfrom` date NOT NULL DEFAULT '1000-01-01',
+  `historyto` date NOT NULL DEFAULT '1000-01-01',
+  `generated` datetime NOT NULL DEFAULT '1000-01-01 00:00:00',
+  `userid` varchar(20) NOT NULL DEFAULT '',
+  `activeflag` tinyint DEFAULT NULL,
+  `batchid` int DEFAULT NULL,
+  PRIMARY KEY (`forecastid`),
+  UNIQUE KEY `activeforecast` (`stockid`,`loccode`,`activeflag`),
+  KEY `loccode` (`loccode`),
+  KEY `batchid` (`batchid`)
+)");
+
+CreateTable('forecastdetails',
+"CREATE TABLE `forecastdetails` (
+  `forecastid` int NOT NULL DEFAULT '0',
+  `periodstart` date NOT NULL DEFAULT '1000-01-01',
+  `calcqty` double NOT NULL DEFAULT '0',
+  `revisedqty` double DEFAULT NULL,
+  PRIMARY KEY (`forecastid`,`periodstart`),
+  KEY `periodstart` (`periodstart`),
+  CONSTRAINT `forecastdetails_ibfk_1` FOREIGN KEY (`forecastid`) REFERENCES `forecasts` (`forecastid`) ON DELETE CASCADE
+)");
+
+CreateTable('forecastsummaries',
+"CREATE TABLE `forecastsummaries` (
+  `summaryid` int NOT NULL AUTO_INCREMENT,
+  `dimension` varchar(10) NOT NULL DEFAULT '',
+  `dimkey` varchar(10) NOT NULL DEFAULT '',
+  `method` tinyint NOT NULL DEFAULT '0',
+  `params` text,
+  `horizon` smallint NOT NULL DEFAULT '0',
+  `historyfrom` date NOT NULL DEFAULT '1000-01-01',
+  `historyto` date NOT NULL DEFAULT '1000-01-01',
+  `generated` datetime NOT NULL DEFAULT '1000-01-01 00:00:00',
+  `userid` varchar(20) NOT NULL DEFAULT '',
+  `activeflag` tinyint DEFAULT NULL,
+  PRIMARY KEY (`summaryid`),
+  UNIQUE KEY `activesummary` (`dimension`,`dimkey`,`activeflag`)
+)");
+
+CreateTable('forecastsummarydetails',
+"CREATE TABLE `forecastsummarydetails` (
+  `summaryid` int NOT NULL DEFAULT '0',
+  `periodstart` date NOT NULL DEFAULT '1000-01-01',
+  `calcqty` double NOT NULL DEFAULT '0',
+  PRIMARY KEY (`summaryid`,`periodstart`),
+  CONSTRAINT `forecastsummarydetails_ibfk_1` FOREIGN KEY (`summaryid`) REFERENCES `forecastsummaries` (`summaryid`) ON DELETE CASCADE
+)");
+
+CreateTable('forecastbatches',
+"CREATE TABLE `forecastbatches` (
+  `batchid` int NOT NULL AUTO_INCREMENT,
+  `created` datetime NOT NULL DEFAULT '1000-01-01 00:00:00',
+  `userid` varchar(20) NOT NULL DEFAULT '',
+  `scope` varchar(10) NOT NULL DEFAULT '',
+  `categoryid` varchar(6) NOT NULL DEFAULT '',
+  `loccode` varchar(5) NOT NULL DEFAULT '',
+  `method` tinyint NOT NULL DEFAULT '0',
+  `bestfit` tinyint NOT NULL DEFAULT '0',
+  `params` text,
+  `horizon` smallint NOT NULL DEFAULT '0',
+  `status` varchar(10) NOT NULL DEFAULT 'running',
+  PRIMARY KEY (`batchid`)
+)");
+
+CreateTable('forecastbatchitems',
+"CREATE TABLE `forecastbatchitems` (
+  `batchid` int NOT NULL DEFAULT '0',
+  `stockid` varchar(64) NOT NULL DEFAULT '',
+  `status` varchar(8) NOT NULL DEFAULT 'pending',
+  `message` varchar(255) NOT NULL DEFAULT '',
+  `forecastid` int DEFAULT NULL,
+  PRIMARY KEY (`batchid`,`stockid`),
+  KEY `status` (`status`),
+  CONSTRAINT `forecastbatchitems_ibfk_1` FOREIGN KEY (`batchid`) REFERENCES `forecastbatches` (`batchid`) ON DELETE CASCADE
+)");
+
+// Records which MRP demands were written by the forecast conversion, so that demands entered by hand
+// (even under the forecast demand type) are never removed or counted as already converted.
+CreateTable('forecastmrpdemands',
+"CREATE TABLE `forecastmrpdemands` (
+  `demandid` int NOT NULL DEFAULT '0',
+  `forecastid` int NOT NULL DEFAULT '0',
+  `stockid` varchar(64) NOT NULL DEFAULT '',
+  `periodstart` date NOT NULL DEFAULT '1000-01-01',
+  PRIMARY KEY (`demandid`),
+  UNIQUE KEY `stockperiod` (`stockid`,`periodstart`),
+  CONSTRAINT `forecastmrpdemands_ibfk_1` FOREIGN KEY (`demandid`) REFERENCES `mrpdemands` (`demandid`) ON DELETE CASCADE
+)");
+
+InsertRecord('forecastparameters', array('paramname'), array('alpha'), array('paramname', 'paramvalue'), array('alpha', '0.3'));
+InsertRecord('forecastparameters', array('paramname'), array('beta'), array('paramname', 'paramvalue'), array('beta', '0.2'));
+InsertRecord('forecastparameters', array('paramname'), array('gamma'), array('paramname', 'paramvalue'), array('gamma', '0.2'));
+InsertRecord('forecastparameters', array('paramname'), array('seasonlength'), array('paramname', 'paramvalue'), array('seasonlength', '12'));
+InsertRecord('forecastparameters', array('paramname'), array('maperiods'), array('paramname', 'paramvalue'), array('maperiods', '4'));
+InsertRecord('forecastparameters', array('paramname'), array('holdout'), array('paramname', 'paramvalue'), array('holdout', '3'));
+InsertRecord('forecastparameters', array('paramname'), array('horizon'), array('paramname', 'paramvalue'), array('horizon', '12'));
+
+// A dedicated MRP demand type, separate from the pre-existing manual 'FOR' type
+InsertRecord('mrpdemandtypes', array('mrpdemandtype'), array('FCST'), array('mrpdemandtype', 'description'), array('FCST', 'Forecast (generated)'));
+
+// Scripts and their page security tokens: 2 inquiries, 11 inventory management, 15 system administration
+NewScript('ForecastDashboard.php', 2);
+NewScript('ForecastInquiry.php', 2);
+NewScript('ForecastSummaryReview.php', 2);
+NewScript('ForecastAccuracy.php', 2);
+NewScript('ForecastCompare.php', 2);
+NewScript('ForecastHistory.php', 11);
+NewScript('ForecastGenerate.php', 11);
+NewScript('ForecastReview.php', 11);
+NewScript('ForecastSummary.php', 11);
+NewScript('ForecastToMRP.php', 11);
+NewScript('ForecastParameters.php', 15);
+
+// modulesallowed holds one flag per module in menu sequence order. Forecasting is inserted after Manufacturing
+// (position 7), so every existing user gets a "0" (no access) at that position and keeps the modules they had.
+// The column must also grow, as 12 modules no longer fit the old varchar(25) for an administrator.
+ChangeColumnSize('modulesallowed', 'www_users', 'VARCHAR(50)', ' NOT NULL ', '', '50');
+
+$ForecastModuleResult = DB_query("SELECT modulelink FROM modules WHERE modulelink='forecast'");
+if (DB_num_rows($ForecastModuleResult) == 0) {
+	executeSQL("UPDATE www_users
+				SET modulesallowed = CONCAT(SUBSTRING_INDEX(modulesallowed, ',', 6),
+											',0,',
+											SUBSTRING(modulesallowed, LENGTH(SUBSTRING_INDEX(modulesallowed, ',', 6)) + 2))
+				WHERE LENGTH(modulesallowed) - LENGTH(REPLACE(modulesallowed, ',', '')) >= 6", false);
+}
+NewModule('forecast', 'fcst', __('Forecasting'), 7);
+
+// Transactions
+NewMenuItem('forecast', 'Transactions', __('Extract Sales History'), '/ForecastHistory.php', 1);
+NewMenuItem('forecast', 'Transactions', __('Generate Forecasts'), '/ForecastGenerate.php', 2);
+NewMenuItem('forecast', 'Transactions', __('Review and Revise Forecasts'), '/ForecastReview.php', 3);
+NewMenuItem('forecast', 'Transactions', __('Generate Summary Forecasts'), '/ForecastSummary.php', 4);
+NewMenuItem('forecast', 'Transactions', __('Convert Forecasts to MRP Demands'), '/ForecastToMRP.php', 5);
+// Inquiries and reports

diff --git a/ForecastAccuracy.php b/ForecastAccuracy.php
new file mode 100644
index 0000000..4cd247d
--- /dev/null
+++ b/ForecastAccuracy.php
@@ -0,0 +1,151 @@
+<?php
+
+// Accuracy of past forecasts: forecast quantities (revised where entered) against the sales that followed.
+// MAD, POA, MSE and RMSE per item, per category or per method for a chosen range of months.
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Forecast Accuracy');
+$ViewTopic = 'Forecasting';
+$BookMark = 'ForecastAccuracy';
+include('includes/header.php');
+include('includes/ForecastFormFunctions.php');
+
+ForecastPageTitle($Title);
+ForecastNavigation();
+
+$Methods = ForecastMethods();
+$Held = ForecastHistoryRange();
+$Search = array(
+	'FromMonth' => $Held['from'] !== null ? substr($Held['from'], 0, 7) : '',
+	'ToMonth' => $Held['to'] !== null ? substr($Held['to'], 0, 7) : '',
+	'ViewBy' => 'item',
+	'CategoryID' => '',
+	'LowPOA' => '70',
+	'ActiveOnly' => ''
+);
+if (isset($_POST['Show'])) {
+	foreach ($Search as $Key => $Value) {
+		$Search[$Key] = isset($_POST[$Key]) ? $_POST[$Key] : '';
+	}
+}
+if (!in_array($Search['ViewBy'], array('item', 'category', 'method'))) {
+	$Search['ViewBy'] = 'item';
+}
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Accuracy report'), '</legend>
+		<field>
+			<label for="FromMonth">', __('From month'), ':</label>
+			<input type="month" name="FromMonth" id="FromMonth" required="required" value="', $Search['FromMonth'], '" />
+		</field>
+		<field>
+			<label for="ToMonth">', __('To month'), ':</label>
+			<input type="month" name="ToMonth" id="ToMonth" required="required" value="', $Search['ToMonth'], '" />
+		</field>
+		<field>
+			<label for="ViewBy">', __('Show accuracy per'), ':</label>
+			<select name="ViewBy" id="ViewBy">
+				<option value="item"', ($Search['ViewBy'] == 'item' ? ' selected="selected"' : ''), '>', __('Item and location'), '</option>
+				<option value="category"', ($Search['ViewBy'] == 'category' ? ' selected="selected"' : ''), '>', __('Stock category'), '</option>
+				<option value="method"', ($Search['ViewBy'] == 'method' ? ' selected="selected"' : ''), '>', __('Forecasting method'), '</option>
+			</select>
+		</field>
+		<field>
+			<label for="CategoryID">', __('Stock category'), ':</label>';
+ForecastCategorySelect('CategoryID', $Search['CategoryID'], __('All categories'));
+echo '</field>
+		<field>
+			<label for="LowPOA">', __('Flag accuracy below (POA %)'), ':</label>
+			<input type="text" class="number" name="LowPOA" id="LowPOA" size="4" value="', $Search['LowPOA'], '" />
+		</field>
+		<field>
+			<label for="ActiveOnly">', __('Active forecasts only'), ':</label>
+			<input type="checkbox" name="ActiveOnly" id="ActiveOnly" value="1"', ($Search['ActiveOnly'] == '1' ? ' checked="checked"' : ''), ' />
+		</field>
+		<fieldhelp>', __('Every forecast generated counts, including those later superseded, unless only active forecasts are chosen. POA = 100 - 100 x sum of absolute errors / sum of actual sales.'), '</fieldhelp>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Show" value="', __('Show Accuracy'), '" /></div>
+</form>';
+
+if (isset($_POST['Show'])) {
+	if (!preg_match('/^\d{4}-\d{2}$/', $Search['FromMonth']) or !preg_match('/^\d{4}-\d{2}$/', $Search['ToMonth']) or $Search['FromMonth'] > $Search['ToMonth']) {
+		prnMsg(__('Enter a valid range of months'), 'error');
+	} else {
+		$Low = is_numeric($Search['LowPOA']) ? (float) $Search['LowPOA'] : 70;
+		$Where = ForecastLocationAccessSQL();
+		if ($Search['CategoryID'] != '') {
+			$Where .= " AND stockmaster.categoryid = '" . $Search['CategoryID'] . "'";
+		}
+		if ($Search['ActiveOnly'] == '1') {
+			$Where .= " AND forecasts.activeflag = 1";
+		}
+		$Rows = ForecastActualsVsForecast($Search['FromMonth'] . '-01', $Search['ToMonth'] . '-01', $Where);
+		if (count($Rows) == 0) {
+			prnMsg(__('No forecast months in this range have sales history to compare with. Extract the sales history up to the latest month first.'), 'info');
+		} else {
+			$Groups = array();
+			$AllActual = $AllForecast = array();
+			foreach ($Rows as $Row) {
+				if ($Search['ViewBy'] == 'item') {
+					$Key = $Row['stockid'] . "\t" . $Row['loccode'];
+				} elseif ($Search['ViewBy'] == 'category') {
+					$Key = $Row['categoryid'];
+				} else {
+					$Key = sprintf('%02d', $Row['method']);
+				}
+				$Groups[$Key]['actual'][] = $Row['actualqty'];
+				$Groups[$Key]['forecast'][] = $Row['forecastqty'];
+				$AllActual[] = $Row['actualqty'];
+				$AllForecast[] = $Row['forecastqty'];
+			}
+			ksort($Groups);
+			$Names = array();
+			if ($Search['ViewBy'] == 'category') {
+				$Result = DB_query("SELECT categoryid, categorydescription FROM stockcategory");
+				while ($MyRow = DB_fetch_array($Result)) {
+					$Names[$MyRow['categoryid']] = $MyRow['categorydescription'];
+				}
+			}
+			echo '<br /><table class="selection">
+					<tr><th>', ($Search['ViewBy'] == 'item' ? __('Item and location') : ($Search['ViewBy'] == 'category' ? __('Stock category') : __('Method'))), '</th>
+						<th>', __('Months compared'), '</th><th>', __('Actual'), '</th><th>', __('Forecast'), '</th>
+						<th>', __('MAD'), '</th><th>', __('POA %'), '</th><th>', __('MSE'), '</th><th>', __('RMSE'), '</th><th></th></tr>';
+			$Flagged = 0;
+			foreach (($Groups + array('' => array('actual' => $AllActual, 'forecast' => $AllForecast, 'total' => true))) as $Key => $Group) {
+				$Measures = ForecastMeasures($Group['actual'], $Group['forecast']);
+				if (isset($Group['total'])) {
+					$Label = '<b>' . __('All forecasts selected') . '</b>';
+				} elseif ($Search['ViewBy'] == 'item') {
+					list($StockID, $LocCode) = explode("\t", $Key);
+					$Label = $StockID . ' - ' . ForecastLocationName($LocCode);
+				} elseif ($Search['ViewBy'] == 'category') {
+					$Label = $Key . (isset($Names[$Key]) ? ' - ' . $Names[$Key] : '');
+				} else {
+					$Label = (int) $Key . ' - ' . $Methods[(int) $Key]['name'];
+				}
+				$IsLow = (!isset($Group['total']) and $Measures['poa'] !== null and $Measures['poa'] < $Low);
+				if ($IsLow) {
+					$Flagged++;
+				}
+				echo '<tr class="striped_row">
+						<td>', $Label, '</td>
+						<td class="number">', $Measures['n'], '</td>
+						<td class="number">', ForecastNumber($Measures['sumactual'], 1), '</td>
+						<td class="number">', ForecastNumber($Measures['sumforecast'], 1), '</td>
+						<td class="number">', ForecastNumber($Measures['mad'], 2), '</td>
+						<td class="number"', ($IsLow ? ' style="background-color: #ffd2d2; font-weight: bold;"' : ''), '>', ($Measures['poa'] === null ? '-' : ForecastNumber($Measures['poa'], 1)), '</td>
+						<td class="number">', ForecastNumber($Measures['mse'], 2), '</td>
+						<td class="number">', ForecastNumber($Measures['rmse'], 2), '</td>
+						<td>', ($IsLow ? __('Low accuracy') : ''), '</td>
+					</tr>';
+			}
+			echo '</table>';
+			prnMsg(sprintf(__('%d of %d lines are below the accuracy threshold'), $Flagged, count($Groups)), $Flagged > 0 ? 'warn' : 'info');
+		}
+	}
+}
+
+include('includes/footer.php');
diff --git a/ForecastCompare.php b/ForecastCompare.php
new file mode 100644
index 0000000..282e3c5
--- /dev/null
+++ b/ForecastCompare.php
@@ -0,0 +1,119 @@
+<?php
+
+// Method comparison: one item's history is forecast with several methods, holding out its latest months,
+// and the forecasts are shown side by side with the actual sales and each method's accuracy.
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Forecast Method Comparison');
+$ViewTopic = 'Forecasting';
+$BookMark = 'ForecastCompare';
+include('includes/header.php');
+include('includes/ForecastFormFunctions.php');
+
+ForecastPageTitle($Title);
+ForecastNavigation();
+
+$Methods = ForecastMethods();
+$Post = array_merge(ForecastGetParameters(), ForecastRunDefaults(), $_POST);
+$Post['StockID'] = isset($_POST['StockID']) ? $_POST['StockID'] : (isset($_GET['StockID']) ? $_GET['StockID'] : '');
+$Post['Location'] = isset($_POST['Location']) ? $_POST['Location'] : '';
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Item to test'), '</legend>
+		<field>
+			<label for="StockID">', __('Item code'), ':</label>
+			<input type="text" name="StockID" id="StockID" size="21" maxlength="64" required="required" value="', $Post['StockID'], '" />
+		</field>
+		<field>
+			<label for="Location">', __('Location'), ':</label>';
+ForecastLocationSelect('Location', $Post['Location'], __('All locations combined'));
+echo '</field>
+	</fieldset>
+	<fieldset>
+		<legend>', __('Method parameters'), '</legend>';
+ForecastParameterFields($Post);
+echo '</fieldset>
+	<div class="centre"><input type="submit" name="Compare" value="', __('Compare Methods'), '" /></div>
+</form>';
+
+if (isset($_POST['Compare'])) {
+	$StockID = trim(mb_strtoupper($_POST['StockID']));
+	$LocCode = $_POST['Location'];
+	$P = ForecastParametersFromPost($_POST);
+	$HoldOut = (int) $P['holdout'];
+	$Description = ForecastItemDescription($StockID);
+	$Held = ForecastHistoryRange();
+	$Allowed = true;
+	if ($LocCode != '') {
+		$Result = DB_query("SELECT loccode FROM locationusers WHERE loccode = '" . $LocCode . "'
+							AND userid = '" . $_SESSION['UserID'] . "' AND canview = 1");
+		$Allowed = DB_num_rows($Result) > 0;
+	}
+	if ($Description === null) {
+		prnMsg(__('The item code entered is not a valid stock item'), 'error');
+	} elseif (!$Allowed) {
+		prnMsg(__('The location is not valid or you may not use it'), 'error');
+	} elseif ($HoldOut < 1 or $HoldOut > 12) {
+		prnMsg(__('The months held out must be a whole number from 1 to 12'), 'error');
+	} elseif ($Held['to'] === null) {
+		prnMsg(__('No sales history has been extracted yet'), 'error');
+	} else {
+		$Series = ForecastBuildSeries(ForecastItemRows($StockID, $LocCode), $Held['to']);
+		$X = $Series['values'];
+		if (count($X) <= $HoldOut) {
+			prnMsg(__('The item has too little sales history to hold out that many months'), 'error');
+		} else {
+			$Results = ForecastEvaluateMethods($X, $HoldOut, $P);
+			$TestStart = ForecastAddMonths($Held['to'], -($HoldOut - 1));
+			echo '<br /><p class="page_title_text">', $StockID, ' - ', $Description, ' (', ForecastLocationName($LocCode), '): ',
+				count($X), ' ', __('months of history,'), ' ', $HoldOut, ' ', __('held out'), '</p>';
+			if (count($Results) == 0) {
+				prnMsg(__('No method has enough history left to be tested'), 'warn');
+			} else {
+				echo '<table class="selection"><tr><th>', __('Method'), '</th>';
+				for ($i = 0; $i < $HoldOut; $i++) {
+					echo '<th>', ForecastMonthLabel(ForecastAddMonths($TestStart, $i)), '</th>';
+				}
+				echo '<th>', __('MAD'), '</th><th>', __('POA %'), '</th><th>', __('MSE'), '</th><th>', __('RMSE'), '</th></tr>
+					<tr><td><b>', __('Actual sales'), '</b></td>';
+				foreach (array_slice($X, count($X) - $HoldOut) as $Actual) {
+					echo '<td class="number"><b>', ForecastNumber($Actual, 1), '</b></td>';
+				}
+				echo '<td colspan="4"></td></tr>';
+				foreach ($Results as $Rank => $Result) {
+					echo '<tr class="striped_row"><td>', ($Rank == 0 ? '<b>' : ''), $Result['method'], ' - ', $Methods[$Result['method']]['name'],
+						($Rank == 0 ? ' (' . __('best fit') . ')</b>' : ''), '</td>';
+					foreach ($Result['forecast'] as $Value) {
+						echo '<td class="number">', ForecastNumber($Value, 1), '</td>';
+					}
+					echo '<td class="number">', ForecastNumber($Result['mad'], 2), '</td>
+						<td class="number">', ($Result['poa'] === null ? '-' : ForecastNumber($Result['poa'], 1)), '</td>
+						<td class="number">', ForecastNumber($Result['mse'], 2), '</td>
+						<td class="number">', ForecastNumber($Result['rmse'], 2), '</td></tr>';
+				}
+				echo '</table>';
+			}
+			// methods that could not be tested are reported with the reason
+			$Tested = array();
+			foreach ($Results as $Result) {
+				$Tested[] = $Result['method'];
+			}
+			$Reasons = '';
+			foreach ($Methods as $Number => $Details) {
+				if (!in_array($Number, $Tested)) {
+					$Outcome = ForecastCompute($Number, array_slice($X, 0, count($X) - $HoldOut), $HoldOut, $P);
+					$Reasons .= '<tr class="striped_row"><td>' . $Number . ' - ' . $Details['name'] . '</td><td>' .
+						htmlspecialchars($Outcome['ok'] ? '' : $Outcome['error'], ENT_QUOTES, 'UTF-8') . '</td></tr>';
+				}
+			}
+			if ($Reasons != '') {
+				echo '<br /><table class="selection"><tr><th colspan="2">', __('Methods that could not be tested'), '</th></tr>', $Reasons, '</table>';
+			}
+		}
+	}
+}
+
+include('includes/footer.php');

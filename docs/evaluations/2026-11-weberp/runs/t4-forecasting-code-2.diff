@@ -0,0 +1,208 @@
+<?php
+
+// Search forecasts and review them period by period; the planner may enter a revised quantity, which then
+// takes priority over the calculated one everywhere (reports, accuracy and MRP). Clearing it restores the
+// calculated quantity.
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Review and Revise Forecasts');
+$ViewTopic = 'Forecasting';
+$BookMark = 'ForecastReview';
+include('includes/header.php');
+include('includes/ForecastFormFunctions.php');
+
+ForecastPageTitle($Title);
+ForecastNavigation();
+
+$Methods = ForecastMethods();
+$ForecastID = 0;
+if (isset($_POST['ForecastID'])) {
+	$ForecastID = (int) $_POST['ForecastID'];
+} elseif (isset($_GET['ForecastID'])) {
+	$ForecastID = (int) $_GET['ForecastID'];
+}
+$Threshold = 25;
+if (isset($_POST['Threshold']) and is_numeric($_POST['Threshold']) and $_POST['Threshold'] > 0) {
+	$Threshold = (float) $_POST['Threshold'];
+}
+
+if ($ForecastID > 0) {
+	$Result = DB_query("SELECT forecasts.*, stockmaster.description, stockmaster.decimalplaces
+						FROM forecasts INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+						WHERE forecasts.forecastid = " . $ForecastID . ForecastLocationAccessSQL());
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('The forecast could not be found'), 'error');
+		$ForecastID = 0;
+	} else {
+		$Forecast = DB_fetch_array($Result);
+	}
+}
+
+if ($ForecastID > 0 and $Forecast['activeflag'] == 1 and (isset($_POST['SaveRevisions']) or isset($_POST['RestoreAll']))) {
+	$InputError = 0;
+	$Revised = array();
+	if (isset($_POST['SaveRevisions']) and isset($_POST['Revised']) and is_array($_POST['Revised'])) {
+		foreach ($_POST['Revised'] as $Period => $Value) {
+			if (!preg_match('/^\d{4}-\d{2}-01$/', $Period)) {
+				continue;
+			}
+			$Value = trim($Value);
+			if ($Value === '') {
+				$Revised[$Period] = null;
+			} elseif (!is_numeric(filter_number_format($Value)) or filter_number_format($Value) < 0) {
+				prnMsg(__('Revised quantities must be numbers of zero or more') . ': ' . ForecastMonthLabel($Period), 'error');
+				$InputError = 1;
+			} else {
+				$Revised[$Period] = (float) filter_number_format($Value);
+			}
+		}
+	} elseif (isset($_POST['RestoreAll'])) {
+		$Result = DB_query("SELECT periodstart FROM forecastdetails WHERE forecastid = " . $ForecastID);
+		while ($MyRow = DB_fetch_array($Result)) {
+			$Revised[$MyRow['periodstart']] = null;
+		}
+	}
+	if ($InputError == 0) {
+		foreach ($Revised as $Period => $Value) {
+			DB_query("UPDATE forecastdetails SET revisedqty = " . ($Value === null ? 'NULL' : $Value) . "
+						WHERE forecastid = " . $ForecastID . " AND periodstart = '" . $Period . "'");
+		}
+		prnMsg(__('The revised quantities have been saved'), 'success');
+	}
+}
+
+if ($ForecastID > 0) {
+	$Params = json_decode($Forecast['params'], true);
+	echo '<table class="selection">
+			<tr><th colspan="2">', $Forecast['stockid'], ' - ', $Forecast['description'], '</th></tr>
+			<tr><td>', __('Location'), '</td><td>', ForecastLocationName($Forecast['loccode']), '</td></tr>
+			<tr><td>', __('Method'), '</td><td>', $Forecast['method'], ' - ', $Methods[$Forecast['method']]['name'], '</td></tr>
+			<tr><td>', __('Generated'), '</td><td>', $Forecast['generated'], ' (', $Forecast['userid'], ')</td></tr>
+			<tr><td>', __('Status'), '</td><td>', ($Forecast['activeflag'] == 1 ? __('Active - used by MRP') : __('Superseded by a later forecast')), '</td></tr>
+		</table><br />';
+
+	// last year's actual for the same month, from the history held
+	$Range = ForecastHistoryRange();
+	$Actual = ForecastItemRows($Forecast['stockid'], $Forecast['loccode']);
+	$Places = (int) $Forecast['decimalplaces'];
+
+	echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+		<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+		<input type="hidden" name="ForecastID" value="', $ForecastID, '" />
+		<table class="selection">
+			<tr><th>', __('Period'), '</th><th>', __('Calculated'), '</th><th>', __('Revised'), '</th><th>', __('Quantity used'), '</th>
+				<th>', __('Last year actual'), '</th><th>', __('Variance %'), '</th></tr>';
+	$Result = DB_query("SELECT periodstart, calcqty, revisedqty FROM forecastdetails
+						WHERE forecastid = " . $ForecastID . " ORDER BY periodstart");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Used = $MyRow['revisedqty'] === null ? $MyRow['calcqty'] : $MyRow['revisedqty'];
+		$LastYearPeriod = ForecastAddMonths($MyRow['periodstart'], -12);
+		$LastYear = null;
+		if ($Range['to'] !== null and $LastYearPeriod >= $Range['from'] and $LastYearPeriod <= $Range['to']) {
+			$LastYear = max(0, isset($Actual[$LastYearPeriod]) ? $Actual[$LastYearPeriod] : 0);
+		}
+		$Variance = null;
+		if ($LastYear !== null and $LastYear > 0) {
+			$Variance = ($Used - $LastYear) / $LastYear * 100;
+		}
+		$Large = ($Variance !== null and abs($Variance) >= $Threshold);
+		echo '<tr class="striped_row">
+				<td>', ForecastMonthLabel($MyRow['periodstart']), '</td>
+				<td class="number">', locale_number_format($MyRow['calcqty'], $Places), '</td>
+				<td><input type="text" class="number" size="10" name="Revised[', $MyRow['periodstart'], ']" value="',
+					($MyRow['revisedqty'] === null ? '' : locale_number_format($MyRow['revisedqty'], $Places)), '"',
+					($Forecast['activeflag'] == 1 ? '' : ' readonly="readonly"'), ' /></td>
+				<td class="number">', locale_number_format($Used, $Places), '</td>
+				<td class="number">', ($LastYear === null ? '-' : locale_number_format($LastYear, $Places)), '</td>
+				<td class="number"', ($Large ? ' style="background-color: #ffd2d2; font-weight: bold;"' : ''), '>',
+					($Variance === null ? '-' : locale_number_format($Variance, 1)), '</td>
+			</tr>';
+	}
+	echo '</table>
+		<p class="centre">', __('Leave a revised quantity empty to use the calculated quantity.'), ' ',
+			__('Variances at or beyond this percentage are highlighted'), ':
+			<input type="text" class="number" size="4" name="Threshold" value="', $Threshold, '" /></p>';
+	if ($Forecast['activeflag'] == 1) {
+		echo '<div class="centre">
+				<input type="submit" name="SaveRevisions" value="', __('Save Revisions'), '" />
+				<input type="submit" name="RestoreAll" value="', __('Restore All Calculated Quantities'), '" />
+			</div>';
+	} else {
+		echo '<div class="centre"><input type="submit" name="Refresh" value="', __('Refresh'), '" /></div>';
+	}
+	echo '</form><br />
+		<div class="centre"><a href="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">', __('Search for another forecast'), '</a></div>';
+} else {
+	$Search = array('StockID' => '', 'CategoryID' => '', 'Location' => '');
+	foreach ($Search as $Key => $Value) {
+		if (isset($_POST[$Key])) {
+			$Search[$Key] = $_POST[$Key];
+		}
+	}
+	echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+		<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+		<fieldset>
+			<legend>', __('Search for active forecasts'), '</legend>
+			<field>
+				<label for="StockID">', __('Item code or part of it or of its description'), ':</label>
+				<input type="text" name="StockID" id="StockID" size="21" maxlength="64" value="', $Search['StockID'], '" />
+			</field>
+			<field>
+				<label for="CategoryID">', __('Stock category'), ':</label>';
+	ForecastCategorySelect('CategoryID', $Search['CategoryID'], __('All categories'));
+	echo '</field>
+			<field>
+				<label for="Location">', __('Location'), ':</label>';
+	ForecastLocationSelect('Location', $Search['Location'], __('All locations'));
+	echo '</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Search" value="', __('Search'), '" /></div>
+	</form>';
+
+	if (isset($_POST['Search'])) {
+		$Where = '';
+		if ($Search['StockID'] != '') {
+			$Like = '%' . str_replace(' ', '%', $Search['StockID']) . '%';
+			$Where .= " AND (forecasts.stockid LIKE '" . $Like . "' OR stockmaster.description LIKE '" . $Like . "')";
+		}
+		if ($Search['CategoryID'] != '') {
+			$Where .= " AND stockmaster.categoryid = '" . $Search['CategoryID'] . "'";
+		}
+		if ($Search['Location'] != '') {
+			$Where .= " AND forecasts.loccode = '" . $Search['Location'] . "'";
+		}
+		$Result = DB_query("SELECT forecasts.forecastid, forecasts.stockid, forecasts.loccode, forecasts.method,
+									forecasts.generated, stockmaster.description,
+									(SELECT COUNT(*) FROM forecastdetails
+										WHERE forecastdetails.forecastid = forecasts.forecastid
+											AND forecastdetails.revisedqty IS NOT NULL) AS revisions
+							FROM forecasts INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+							WHERE forecasts.activeflag = 1 " . $Where . ForecastLocationAccessSQL() . "
+							ORDER BY forecasts.stockid, forecasts.loccode LIMIT 300");
+		if (DB_num_rows($Result) == 0) {
+			prnMsg(__('No active forecasts match the search'), 'info');
+		} else {
+			echo '<br /><table class="selection">
+					<tr><th>', __('Item'), '</th><th>', __('Description'), '</th><th>', __('Location'), '</th><th>', __('Method'), '</th>
+						<th>', __('Generated'), '</th><th>', __('Revised periods'), '</th><th></th></tr>';
+			while ($MyRow = DB_fetch_array($Result)) {
+				echo '<tr class="striped_row">
+						<td>', $MyRow['stockid'], '</td>
+						<td>', $MyRow['description'], '</td>
+						<td>', ForecastLocationName($MyRow['loccode']), '</td>
+						<td>', $Methods[$MyRow['method']]['name'], '</td>
+						<td>', $MyRow['generated'], '</td>
+						<td class="number">', $MyRow['revisions'], '</td>
+						<td><a href="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '?ForecastID=', $MyRow['forecastid'], '">', __('Review'), '</a></td>
+					</tr>';
+			}
+			echo '</table>';
+			if (DB_num_rows($Result) == 300) {
+				prnMsg(__('Only the first 300 forecasts are listed - narrow the search'), 'info');
+			}
+		}
+	}
+}
+
+include('includes/footer.php');
diff --git a/ForecastSummary.php b/ForecastSummary.php
new file mode 100644
index 0000000..8dd9b14
--- /dev/null
+++ b/ForecastSummary.php
@@ -0,0 +1,143 @@
+<?php
+
+// Summary forecasts: aggregated by stock category, customer type, sales area or salesperson, calculated
+// from the same sales history as the item forecasts.
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Generate Summary Forecasts');
+$ViewTopic = 'Forecasting';
+$BookMark = 'ForecastSummary';
+include('includes/header.php');
+include('includes/ForecastFormFunctions.php');
+
+ForecastPageTitle($Title);
+ForecastNavigation();
+
+$Methods = ForecastMethods();
+$Dimensions = ForecastDimensions();
+$Defaults = array_merge(ForecastGetParameters(), ForecastRunDefaults());
+
+$Dimension = (isset($_POST['Dimension']) and isset($Dimensions[$_POST['Dimension']])) ? $_POST['Dimension'] : 'category';
+
+if (isset($_POST['Generate'])) {
+	$InputError = 0;
+	$Method = (int) $_POST['Method'];
+	$Horizon = (int) $_POST['Horizon'];
+	$P = ForecastParametersFromPost($_POST);
+	if ($Horizon < 1 or $Horizon > 36) {
+		prnMsg(__('The horizon must be from 1 to 36 monthly periods'), 'error');
+		$InputError = 1;
+	}
+	if ($Method > 0) {
+		$Error = ForecastValidateParameters($Method, $P);
+		if ($Error != '') {
+			prnMsg($Error, 'error');
+			$InputError = 1;
+		}
+	} elseif ((int) $P['holdout'] != $P['holdout'] or $P['holdout'] < 1 or $P['holdout'] > 12) {
+		prnMsg(__('The months held out must be a whole number from 1 to 12'), 'error');
+		$InputError = 1;
+	}
+	$AllKeys = ForecastDimensionKeys($Dimension);
+	if ($_POST['DimKey'] != '') {
+		if (!isset($AllKeys[$_POST['DimKey']])) {
+			prnMsg(__('The selection has no sales history'), 'error');
+			$InputError = 1;
+		}
+		$Keys = array($_POST['DimKey'] => isset($AllKeys[$_POST['DimKey']]) ? $AllKeys[$_POST['DimKey']] : '');
+	} else {
+		$Keys = $AllKeys;
+	}
+	if ($InputError == 0) {
+		set_time_limit(0);
+		$Succeeded = $Failed = 0;
+		$Lines = '';
+		foreach ($Keys as $Key => $Name) {
+			$Outcome = ForecastGenerateSummary($Dimension, $Key, $Method, $P, $Horizon);
+			if ($Outcome['ok']) {
+				$Succeeded++;
+				$Lines .= '<tr class="striped_row"><td>' . $Key . ' - ' . $Name . '</td><td>' . __('Successful') . '</td><td>' .
+					$Methods[$Outcome['method']]['name'] . ' - <a href="' . $RootPath . '/ForecastSummaryReview.php?SummaryID=' . $Outcome['summaryid'] . '">' . __('Review') . '</a></td></tr>';
+			} else {
+				$Failed++;
+				$Lines .= '<tr class="striped_row"><td>' . $Key . ' - ' . $Name . '</td><td><b>' . __('Failed') . '</b></td><td>' .
+					htmlspecialchars($Outcome['message'], ENT_QUOTES, 'UTF-8') . '</td></tr>';
+			}
+		}
+		prnMsg(sprintf(__('%d successful, %d failed'), $Succeeded, $Failed), $Failed > 0 ? 'warn' : 'success');
+		echo '<table class="selection"><tr><th>', $Dimensions[$Dimension], '</th><th>', __('Result'), '</th><th>', __('Method used or reason for failure'), '</th></tr>', $Lines, '</table><br />';
+	}
+}
+
+$Post = $_POST;
+foreach ($Defaults as $Name => $Value) {
+	if (!isset($Post[$Name])) {
+		$Post[$Name] = $Value;
+	}
+}
+$Post['Method'] = $Post['Method'] ?? 0;
+$Post['Horizon'] = $Post['Horizon'] ?? $Defaults['horizon'];
+$Post['DimKey'] = $Post['DimKey'] ?? '';
+
+echo '<form method="post" action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">
+	<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+	<fieldset>
+		<legend>', __('Summary forecast to generate'), '</legend>
+		<field>
+			<label for="Dimension">', __('Summarise by'), ':</label>
+			<select name="Dimension" id="Dimension">';
+foreach ($Dimensions as $Code => $Caption) {
+	echo '<option value="', $Code, '"', ($Code == $Dimension ? ' selected="selected"' : ''), '>', $Caption, '</option>';
+}
+echo '</select>
+			<fieldhelp>', __('After changing this, choose Refresh to list its values'), '</fieldhelp>
+		</field>
+		<field>
+			<label for="DimKey">', __('Value'), ':</label>
+			<select name="DimKey" id="DimKey">
+				<option value="">', __('Every value with sales history'), '</option>';
+foreach (ForecastDimensionKeys($Dimension) as $Key => $Name) {
+	echo '<option value="', $Key, '"', ($Key == $Post['DimKey'] ? ' selected="selected"' : ''), '>', $Key, ' - ', $Name, '</option>';
+}
+echo '</select>
+		</field>
+		<field>
+			<label for="Method">', __('Method'), ':</label>';
+ForecastMethodSelect('Method', $Post['Method']);
+echo '</field>
+		<field>
+			<label for="Horizon">', __('Horizon in monthly periods'), ':</label>
+			<input type="text" class="number" name="Horizon" id="Horizon" size="4" value="', $Post['Horizon'], '" />
+		</field>
+	</fieldset>
+	<fieldset>
+		<legend>', __('Method parameters'), '</legend>';
+ForecastParameterFields($Post);
+echo '</fieldset>
+	<div class="centre">
+		<input type="submit" name="Refresh" value="', __('Refresh'), '" />
+		<input type="submit" name="Generate" value="', __('Generate Summary Forecasts'), '" />
+	</div>
+</form>';
+
+// Active summaries on file
+$Result = DB_query("SELECT summaryid, dimension, dimkey, method, horizon, generated FROM forecastsummaries
+					WHERE activeflag = 1 ORDER BY dimension, dimkey");
+if (DB_num_rows($Result) > 0) {
+	echo '<br /><table class="selection">
+			<tr><th colspan="5">', __('Active summary forecasts'), '</th></tr>
+			<tr><th>', __('Summarised by'), '</th><th>', __('Value'), '</th><th>', __('Method'), '</th><th>', __('Generated'), '</th><th></th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>', $Dimensions[$MyRow['dimension']], '</td>
+				<td>', $MyRow['dimkey'], '</td>
+				<td>', $Methods[$MyRow['method']]['name'], '</td>
+				<td>', $MyRow['generated'], '</td>
+				<td><a href="', $RootPath, '/ForecastSummaryReview.php?SummaryID=', $MyRow['summaryid'], '">', __('Review'), '</a></td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/ForecastSummaryReview.php b/ForecastSummaryReview.php
new file mode 100644
index 0000000..6658b08

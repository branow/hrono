diff --git a/CreditControlCharges.php b/CreditControlCharges.php
new file mode 100644
index 0000000..55e1a65
--- /dev/null
+++ b/CreditControlCharges.php
@@ -0,0 +1,302 @@
+<?php
+
+/* Month end interest and late fees on overdue balances, and waivers of charges. Credit control see what will be charged to whom for the month and confirm it. A month cannot be charged twice: a customer is charged interest once and a late fee once for a month. Charges are customer transactions (type 60) in the customer's own currency that appear on the account and the statement, and post to the GL income accounts Finance chose. Waivers (type 61) reverse a charge, with a reason, and reach the GL too. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Month End Interest and Late Fees');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlCharges';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$PostTo = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$HomeDecimals = $_SESSION['CompanyRecord']['decimalplaces'];
+
+if ($_SESSION['CreditInterestRate'] <= 0 and $_SESSION['CreditLateFee'] <= 0) {
+	prnMsg(__('No interest rate and no late fee have been set') . '. ' . __('Finance sets them in Credit Control Settings'), 'warn');
+}
+if ($_SESSION['CompanyRecord']['interestincomeact'] == '0' or $_SESSION['CompanyRecord']['latefeeact'] == '0') {
+	prnMsg(__('The GL accounts for interest and late fee income have not been set') . '. ' . __('Finance sets them in Credit Control Settings'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+/* the months that can be charged: this month and the five before it */
+$Months = array();
+for ($i = 0; $i < 6; $i++) {
+	$Months[] = date('Y-m', mktime(0, 0, 0, date('n') - $i, 1, date('Y')));
+}
+$ChargeMonth = (isset($_POST['ChargeMonth']) and in_array($_POST['ChargeMonth'], $Months)) ? $_POST['ChargeMonth'] : $Months[0];
+/* charged as at the last day of the month, or today if the month is not over */
+$LastDay = date('Y-m-t', strtotime($ChargeMonth . '-01'));
+$ChargeDate = min($LastDay, date('Y-m-d'));
+
+/* what would be charged to whom for the month, leaving out what has already been charged */
+function ChargeProposals($ChargeMonth) {
+	$Rate = (float) $_SESSION['CreditInterestRate'];
+	$Fee = (float) $_SESSION['CreditLateFee'];
+	$MinDays = max(1, (int) $_SESSION['CreditChargeDaysOverdue']);
+	$Proposals = array();
+	$Result = DB_query("SELECT DISTINCT debtortrans.debtorno
+						FROM debtortrans
+						INNER JOIN debtorsmaster
+							ON debtortrans.debtorno = debtorsmaster.debtorno
+						INNER JOIN paymentterms
+							ON debtorsmaster.paymentterms = paymentterms.termsindicator
+						WHERE debtortrans.type = 10
+							AND debtortrans.settled = 0
+							AND debtortrans.disputed = 0
+							AND debtortrans.balance > " . CurrencyTolerance($_SESSION['CompanyRecord']['currencydefault']) . "
+							AND (" . OverdueDaysSQL() . ") >= " . $MinDays . "
+						ORDER BY debtortrans.debtorno");
+	while ($DebtorRow = DB_fetch_row($Result)) {
+		$Customer = GetCreditStatus($DebtorRow[0]);
+		$Currency = CustomerCurrencyDetails($Customer['currcode']);
+		if ($Currency['rate'] <= 0) {
+			prnMsg(__('Customer') . ' ' . $DebtorRow[0] . ': ' . __('the exchange rate of the currency') . ' ' . $Customer['currcode'] . ' ' . __('is not set so nothing can be charged'), 'warn');
+			continue;
+		}
+		/* interest and fees are charged on invoices only, never on earlier interest or fees */
+		$Items = GetOverdueItems($DebtorRow[0], $MinDays, false, '10');
+		$Base = 0;
+		foreach ($Items as $Item) {
+			$Base += $Item['balance'];
+		}
+		$Charged = array();
+		$ChargedResult = DB_query("SELECT chargetype FROM debtorcharges WHERE debtorno = '" . $DebtorRow[0] . "' AND chargemonth = '" . $ChargeMonth . "'");
+		while ($ChargedRow = DB_fetch_row($ChargedResult)) {
+			$Charged[$ChargedRow[0]] = true;
+		}
+		$Proposal = array('name' => $Customer['name'],
+						'currcode' => $Customer['currcode'],
+						'decimals' => $Currency['decimalplaces'],
+						'rate' => $Currency['rate'],
+						'base' => $Base,
+						'invoices' => count($Items),
+						'INT' => 0,
+						'FEE' => 0,
+						'note' => '');
+		if (isset($Charged['INT'])) {
+			$Proposal['note'] .= __('Interest already charged this month') . '. ';
+		} elseif ($Customer['exemptinterest']) {
+			$Proposal['note'] .= __('Exempt from interest') . '. ';
+		} elseif ($Rate > 0) {
+			$Proposal['INT'] = round($Base * $Rate / 100 / 12, $Currency['decimalplaces']);
+		}
+		if (isset($Charged['FEE'])) {
+			$Proposal['note'] .= __('Late fee already charged this month') . '. ';
+		} elseif ($Customer['exemptfees']) {
+			$Proposal['note'] .= __('Exempt from late fees') . '. ';
+		} elseif ($Fee > 0) {
+			$Proposal['FEE'] = round($Fee * $Currency['rate'], $Currency['decimalplaces']);
+		}
+		if ($Proposal['INT'] > 0 or $Proposal['FEE'] > 0 or $Proposal['note'] != '') {
+			$Proposals[$DebtorRow[0]] = $Proposal;
+		}
+	}
+	return $Proposals;
+}
+
+if (isset($_POST['PostCharges'])) {
+	$Proposals = ChargeProposals($ChargeMonth);
+	$Posted = 0;
+	foreach (array('INT' => 'Interest', 'FEE' => 'Fee') as $Type => $Field) {
+		if (!isset($_POST[$Field])) {
+			continue;
+		}
+		foreach ($_POST[$Field] as $DebtorNo => $Value) {
+			if (!isset($Proposals[$DebtorNo]) or $Proposals[$DebtorNo][$Type] <= 0) {
+				prnMsg(__('Customer') . ' ' . $DebtorNo . ': ' . __('nothing to charge') . ' ' . ($Type == 'INT' ? __('interest') : __('late fee')) . ' - ' . __('left out'), 'info');
+				continue;
+			}
+			$Proposal = $Proposals[$DebtorNo];
+			if ($Type == 'INT') {
+				$Text = __('Interest on overdue invoices') . ' ' . $ChargeMonth . ' (' . $_SESSION['CreditInterestRate'] . '% ' . __('a year') . ')';
+				$Counter = $_SESSION['CompanyRecord']['interestincomeact'];
+			} else {
+				$Text = __('Late payment fee') . ' ' . $ChargeMonth;
+				$Counter = $_SESSION['CompanyRecord']['latefeeact'];
+			}
+			DB_Txn_Begin();
+			list($TransNo, $TransID) = PostCreditControlTransaction(60, $DebtorNo, $ChargeDate, $Proposal[$Type], $Proposal['rate'], null, $Counter, $Type . '-' . $ChargeMonth, $Text);
+			DB_query("INSERT INTO debtorcharges (debtorno, chargemonth, chargetype, currcode, amount, transno, userid)
+						VALUES ('" . $DebtorNo . "',
+								'" . $ChargeMonth . "',
+								'" . $Type . "',
+								'" . $Proposal['currcode'] . "',
+								'" . $Proposal[$Type] . "',
+								'" . $TransNo . "',
+								'" . $_SESSION['UserID'] . "')", __('The charge could not be recorded because'), '', true);
+			CreditControlLog($DebtorNo, 'CHARGE', $Text, $Proposal[$Type], $Proposal['currcode'], 60, $TransNo);
+			DB_Txn_Commit();
+			$Posted++;
+		}
+	}
+	prnMsg($Posted . ' ' . __('charges have been posted'), 'success');
+}
+
+if (isset($_POST['WaiveCharges']) and isset($_POST['Waive'])) {
+	if (trim($_POST['WaiveReason']) == '') {
+		prnMsg(__('The reason for waiving the charge must be entered'), 'error');
+	} else {
+		$Waived = 0;
+		foreach ($_POST['Waive'] as $ChargeID => $Value) {
+			$Result = DB_query("SELECT debtorcharges.id,
+										debtorcharges.debtorno,
+										debtorcharges.chargemonth,
+										debtorcharges.chargetype,
+										debtorcharges.currcode,
+										debtortrans.id AS transid,
+										debtortrans.rate,
+										debtortrans.balance
+								FROM debtorcharges
+								INNER JOIN debtortrans
+									ON debtortrans.type = 60
+									AND debtortrans.transno = debtorcharges.transno
+								WHERE debtorcharges.id = '" . (int) $ChargeID . "'
+									AND debtorcharges.waived = 0");
+			if (DB_num_rows($Result) == 0) {
+				continue;
+			}
+			$Charge = DB_fetch_array($Result);
+			$Outstanding = round($Charge['balance'], 4);
+			if ($Outstanding <= 0) {
+				prnMsg(__('Customer') . ' ' . $Charge['debtorno'] . ': ' . __('the charge has been paid and cannot be waived'), 'warn');
+				continue;
+			}
+			$Counter = ($Charge['chargetype'] == 'INT') ? $_SESSION['CompanyRecord']['interestincomeact'] : $_SESSION['CompanyRecord']['latefeeact'];
+			$Text = __('Waiver of') . ' ' . ($Charge['chargetype'] == 'INT' ? __('interest') : __('late fee')) . ' ' . $Charge['chargemonth'] . ': ' . $_POST['WaiveReason'];
+			DB_Txn_Begin();
+			/* reversed at the rate the charge was booked at, so the GL income account is reversed by exactly what was posted */
+			list($TransNo, $TransID) = PostCreditControlTransaction(61, $Charge['debtorno'], date('Y-m-d'), -$Outstanding, $Charge['rate'], null, $Counter, 'WAIVE-' . $Charge['chargemonth'], $Text);
+			AllocateCreditControlTransaction($TransID, $Charge['transid'], $Outstanding, date('Y-m-d'));
+			DB_query("UPDATE debtorcharges
+						SET waived = 1,
+							waivedtransno = '" . $TransNo . "'
+						WHERE id = '" . $Charge['id'] . "'", __('The charge could not be marked as waived because'), '', true);
+			CreditControlLog($Charge['debtorno'], 'WAIVER', $Text, -$Outstanding, $Charge['currcode'], 61, $TransNo);
+			DB_Txn_Commit();
+			$Waived++;
+		}
+		prnMsg($Waived . ' ' . __('charges have been waived'), 'success');
+	}
+}
+
+/* ---- the month to charge ---- */
+
+echo '<form method="post" action="' . $PostTo . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<field>
+				<label for="ChargeMonth">' . __('Month to charge') . ':</label>
+				<select name="ChargeMonth">';
+foreach ($Months as $Month) {
+	echo '<option value="' . $Month . '"' . ($Month == $ChargeMonth ? ' selected="selected"' : '') . '>' . $Month . '</option>';
+}
+echo '</select>
+				<input type="submit" name="Show" value="' . __('Show') . '" />
+			</field>
+		</fieldset>
+	</form>';
+
+echo '<div class="page_help_text">' . __('Charged as at') . ' ' . ConvertSQLDate($ChargeDate) . '. ' .
+	__('Interest is one twelfth of the annual rate on the invoices overdue by at least') . ' ' . max(1, (int) $_SESSION['CreditChargeDaysOverdue']) . ' ' . __('days') . ', ' .
+	__('the late fee is charged once a month to each customer with such invoices. Disputed invoices and exempt customers are not charged.') . '</div>';
+
+$Proposals = ChargeProposals($ChargeMonth);
+$TotalInterest = 0;
+$TotalFees = 0;
+$Charging = 0;
+echo '<form method="post" action="' . $PostTo . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="ChargeMonth" value="' . $ChargeMonth . '" />
+		<table class="selection">
+			<tr>
+				<th>' . __('Customer') . '</th>
+				<th>' . __('Overdue invoices') . '</th>
+				<th>' . __('Overdue balance') . '</th>
+				<th>' . __('Interest') . '</th>
+				<th>' . __('Late fee') . '</th>
+				<th>' . __('Notes') . '</th>
+			</tr>';
+foreach ($Proposals as $DebtorNo => $Proposal) {
+	if ($Proposal['INT'] > 0 or $Proposal['FEE'] > 0) {
+		$Charging++;
+	}
+	$TotalInterest += $Proposal['INT'] / $Proposal['rate'];
+	$TotalFees += $Proposal['FEE'] / $Proposal['rate'];
+	echo '<tr class="striped_row">
+			<td><a href="' . $RootPath . '/CustomerCredit.php?DebtorNo=' . urlencode($DebtorNo) . '">' . $DebtorNo . '</a> ' . $Proposal['name'] . '</td>
+			<td class="number">' . $Proposal['invoices'] . '</td>
+			<td class="number">' . locale_number_format($Proposal['base'], $Proposal['decimals']) . ' ' . $Proposal['currcode'] . '</td>
+			<td class="number">' . ($Proposal['INT'] > 0 ? '<input type="checkbox" name="Interest[' . $DebtorNo . ']" checked="checked" /> ' . locale_number_format($Proposal['INT'], $Proposal['decimals']) : '') . '</td>
+			<td class="number">' . ($Proposal['FEE'] > 0 ? '<input type="checkbox" name="Fee[' . $DebtorNo . ']" checked="checked" /> ' . locale_number_format($Proposal['FEE'], $Proposal['decimals']) : '') . '</td>
+			<td>' . $Proposal['note'] . '</td>
+		</tr>';
+}
+echo '<tr><th colspan="3">' . __('Totals in') . ' ' . $HomeCurrency . '</th>
+		<th class="number">' . locale_number_format($TotalInterest, $HomeDecimals) . '</th>
+		<th class="number">' . locale_number_format($TotalFees, $HomeDecimals) . '</th>
+		<th></th></tr>
+	</table>';
+if ($Charging > 0) {
+	echo '<br /><div class="centre"><input type="submit" name="PostCharges" value="' . __('Confirm and Post These Charges') . '" onclick="return confirm(\'' . __('Post the charges ticked above to the customer accounts and the general ledger?') . '\');" /></div>';
+} else {
+	prnMsg(__('There is nothing to charge for') . ' ' . $ChargeMonth, 'info');
+}
+echo '</form>';
+
+/* ---- waivers ---- */
+$Result = DB_query("SELECT debtorcharges.id,
+							debtorcharges.debtorno,
+							debtorsmaster.name,
+							debtorcharges.chargemonth,
+							debtorcharges.chargetype,
+							debtorcharges.currcode,
+							debtorcharges.amount,
+							debtortrans.balance,
+							debtorcharges.waived
+					FROM debtorcharges
+					INNER JOIN debtorsmaster
+						ON debtorcharges.debtorno = debtorsmaster.debtorno
+					INNER JOIN debtortrans
+						ON debtortrans.type = 60
+						AND debtortrans.transno = debtorcharges.transno
+					WHERE debtorcharges.waived = 0
+					ORDER BY debtorcharges.id DESC
+					LIMIT 100");
+if (DB_num_rows($Result) > 0) {
+	echo '<br /><form method="post" action="' . $PostTo . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<input type="hidden" name="ChargeMonth" value="' . $ChargeMonth . '" />
+			<table class="selection">
+				<caption>' . __('Charges that can be waived (reversed)') . '</caption>
+				<tr><th>' . __('Customer') . '</th><th>' . __('Month') . '</th><th>' . __('Charge') . '</th><th>' . __('Amount') . '</th><th>' . __('Still unpaid') . '</th><th>' . __('Waive') . '</th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . $MyRow['debtorno'] . ' ' . $MyRow['name'] . '</td>
+				<td>' . $MyRow['chargemonth'] . '</td>
+				<td>' . ($MyRow['chargetype'] == 'INT' ? __('Interest') : __('Late fee')) . '</td>
+				<td class="number">' . locale_number_format($MyRow['amount'], 2) . ' ' . $MyRow['currcode'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['balance'], 2) . '</td>
+				<td>' . ($MyRow['balance'] > 0 ? '<input type="checkbox" name="Waive[' . $MyRow['id'] . ']" />' : __('Paid')) . '</td>
+			</tr>';
+	}
+	echo '</table>
+			<fieldset>
+				<field>
+					<label for="WaiveReason">' . __('Reason for waiving') . ':</label>
+					<input type="text" name="WaiveReason" size="60" maxlength="200" />
+				</field>
+			</fieldset>
+			<div class="centre"><input type="submit" name="WaiveCharges" value="' . __('Waive Ticked Charges') . '" /></div>
+		</form>';
+}
+
+include('includes/footer.php');
diff --git a/CreditControlDunning.php b/CreditControlDunning.php
new file mode 100644
index 0000000..b2f5c1f
--- /dev/null
+++ b/CreditControlDunning.php
@@ -0,0 +1,161 @@
+<?php
+
+/* The overdue reminder run. Credit control start it (we expect weekly), see who would get which letter, take out the customers they do not want to write to, and send. Customers with no e-mail address are listed so the letter can be posted. Every reminder is recorded against the customer. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+require_once('includes/MiscFunctions.php');
+
+$Title = __('Credit Control Reminder Run');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlDunning';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '</p>';
+
+$PostTo = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$Stages = GetDunningStages();
+
+if (count($Stages) == 0) {
+	prnMsg(__('No reminder stages have been set up') . '. ' . __('Finance sets them up in Credit Control Settings'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+/* the stop reason used when the final notice puts the customer on stop */
+$StopReason = '';
+$Result = DB_query("SELECT reasoncode FROM holdreasons WHERE dissallowinvoices = 1 ORDER BY reasoncode LIMIT 1");
+if (DB_num_rows($Result) > 0) {
+	$MyRow = DB_fetch_row($Result);
+	$StopReason = $MyRow[0];
+}
+$FinalStage = max(array_keys($Stages));
+
+if (isset($_POST['SendReminders'])) {
+
+	/* The candidates are worked out again now. A customer who has paid since the list was shown is no longer overdue and gets nothing, and the stage is the stage they are at now. */
+	$Candidates = GetDunningCandidates();
+	$Sent = 0;
+	$ToPost = array();
+	$Failed = array();
+
+	foreach ((isset($_POST['Include']) ? $_POST['Include'] : array()) as $DebtorNo => $Value) {
+		if (!isset($Candidates[$DebtorNo]) or $Candidates[$DebtorNo]['skip'] != '') {
+			prnMsg(__('Customer') . ' ' . $DebtorNo . ' ' . __('no longer needs a reminder and was left out'), 'info');
+			continue;
+		}
+		$Candidate = $Candidates[$DebtorNo];
+		$CurrDetails = CustomerCurrencyDetails($Candidate['currcode']);
+		$Customer = array('name' => $Candidate['name'], 'currcode' => $Candidate['currcode'], 'decimalplaces' => $CurrDetails['decimalplaces']);
+		$Stage = $Stages[$Candidate['stage']];
+		$Subject = html_entity_decode(MergeDunningText($Stage['subject'], $Customer, $Candidate['items'], $Candidate['total']), ENT_QUOTES, 'UTF-8');
+		$Body = html_entity_decode(MergeDunningText($Stage['body'], $Customer, $Candidate['items'], $Candidate['total']), ENT_QUOTES, 'UTF-8');
+		$ItemList = array();
+		foreach ($Candidate['items'] as $Item) {
+			$ItemList[] = $Item['type'] . '/' . $Item['transno'];
+		}
+
+		if (count($Candidate['emails']) > 0) {
+			$Method = 'email';
+			$SentTo = implode(', ', $Candidate['emails']);
+			$EmailResult = SendEmailFromWebERP($_SESSION['CompanyRecord']['email'], $Candidate['emails'], $Subject, $Body, array(), true);
+			if ($EmailResult !== true) {
+				$Failed[] = $DebtorNo . ' ' . $Candidate['name'];
+				continue;
+			}
+		} else {
+			$Method = 'post';
+			$SentTo = '';
+			$ToPost[$DebtorNo] = array('name' => $Candidate['name'], 'subject' => $Subject, 'body' => $Body);
+		}
+
+		DB_Txn_Begin();
+		DB_query("INSERT INTO dunninghistory (debtorno,
+											stage,
+											sentdate,
+											userid,
+											method,
+											sentto,
+											currcode,
+											amount,
+											items,
+											lettertext)
+									VALUES ('" . $DebtorNo . "',
+											'" . $Candidate['stage'] . "',
+											NOW(),
+											'" . $_SESSION['UserID'] . "',
+											'" . $Method . "',
+											'" . DB_escape_string($SentTo) . "',
+											'" . $Candidate['currcode'] . "',
+											'" . $Candidate['total'] . "',
+											'" . DB_escape_string(implode(',', $ItemList)) . "',
+											'" . DB_escape_string($Body) . "')", __('The reminder could not be recorded because'), '', true);
+		CreditControlLog($DebtorNo, 'REMINDER', __('Reminder stage') . ' ' . $Candidate['stage'] . ' ' . ($Method == 'email' ? __('e-mailed to') . ' ' . $SentTo : __('to be posted')) . '. ' . __('Items') . ': ' . implode(', ', $ItemList), $Candidate['total'], $Candidate['currcode']);
+		if ($Candidate['stage'] == $FinalStage and $_SESSION['CreditStopAfterFinalNotice'] == 1 and $Candidate['status'] != CREDIT_STATUS_STOP and $StopReason !== '') {
+			SetCreditStatus($DebtorNo, CREDIT_STATUS_STOP, $StopReason, __('Put on stop automatically after the final notice'));
+		}
+		DB_Txn_Commit();
+		$Sent++;
+	}
+
+	prnMsg($Sent . ' ' . __('reminders have been sent or recorded'), 'success');
+	if (count($Failed) > 0) {
+		prnMsg(__('The e-mail could not be sent to') . ': ' . implode(', ', $Failed) . '. ' . __('They have not been recorded as reminded and will be on the next list'), 'error');
+	}

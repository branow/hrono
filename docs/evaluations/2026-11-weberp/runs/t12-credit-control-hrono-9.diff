+	foreach ($Numeric as $Name => $Range) {
+		$Value = filter_number_format($_POST[$Name]);
+		if (!is_numeric($Value) or $Value < $Range[0] or $Value > $Range[1]) {
+			$InputError = 1;
+			prnMsg(__('The setting') . ' ' . $Name . ' ' . __('must be a number between') . ' ' . $Range[0] . ' ' . __('and') . ' ' . $Range[1], 'error');
+		}
+		$NewValues[$Name] = $Value;
+	}
+	if ($_POST['CreditControlEmail'] != '' and !IsEmailAddress($_POST['CreditControlEmail'])) {
+		$InputError = 1;
+		prnMsg(__('The credit control contact e-mail address is not a valid address'), 'error');
+	}
+	$NewValues['CreditControlEmail'] = $_POST['CreditControlEmail'];

+}
+
+if (isset($_POST['SaveStages'])) {
+	$InputError = 0;
+	$Stages = array();
+	foreach ($_POST['StageNo'] as $Key => $Stage) {
+		if (isset($_POST['DeleteStage'][$Key])) {
+			continue;
+		}
+		$Days = (int) $_POST['StageDays'][$Key];
+		if ($Days <= 0 or trim($_POST['StageSubject'][$Key]) == '' or trim($_POST['StageBody'][$Key]) == '') {
+			$InputError = 1;
+			prnMsg(__('Every reminder stage needs the number of days overdue, a subject and the wording of the letter'), 'error');
+			break;
+		}
+		$Stages[] = array('days' => $Days, 'subject' => $_POST['StageSubject'][$Key], 'body' => $_POST['StageBody'][$Key]);
+	}
+	if (isset($_POST['NewStageDays']) and trim($_POST['NewStageSubject']) != '') {
+		$Days = (int) $_POST['NewStageDays'];
+		if ($Days <= 0 or trim($_POST['NewStageBody']) == '') {

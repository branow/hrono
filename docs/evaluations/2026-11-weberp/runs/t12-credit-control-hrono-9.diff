+/* Go-live: credit status, limit and next review date from the credit controller's spreadsheet. CSV columns: customer code, status (N normal, W watch, S stop), credit limit (optional), next review date as YYYY-MM-DD (optional) */
+if (isset($_POST['LoadCSV']) and isset($_FILES['CSVFile']) and $_FILES['CSVFile']['name'] != '') {
+	$FileHandle = fopen($_FILES['CSVFile']['tmp_name'], 'r');
+	if ($FileHandle === false) {
+		prnMsg(__('The file could not be read'), 'error');
+	} else {
+		$LoadErrors = array();
+		$Loaded = 0;
+		$LineNo = 0;
+		$StatusMap = array('N' => CREDIT_STATUS_NORMAL, 'W' => CREDIT_STATUS_WATCH, 'S' => CREDIT_STATUS_STOP);
+		$ReasonFor = array(CREDIT_STATUS_NORMAL => (int) $_POST['LoadReasonNormal'],
+							CREDIT_STATUS_WATCH => (int) $_POST['LoadReasonWatch'],
+							CREDIT_STATUS_STOP => (int) $_POST['LoadReasonStop']);
+		DB_Txn_Begin();
+		while (($Row = fgetcsv($FileHandle, 10000, ',')) !== false) {
+			$LineNo++;
+			if (count($Row) < 2 or $LineNo == 1 and !isset($StatusMap[mb_strtoupper(trim($Row[1]))])) {
+				continue; // blank line or header line
+			}
+			$Code = mb_strtoupper(trim($Row[0]));
+			$Status = mb_strtoupper(trim($Row[1]));
+			$Customer = GetCreditStatus($Code);
+			if ($Customer === false) {
+				$LoadErrors[] = __('Line') . ' ' . $LineNo . ': ' . __('customer') . ' ' . $Code . ' ' . __('does not exist');
+				continue;
+			}
+			if (!isset($StatusMap[$Status])) {
+				$LoadErrors[] = __('Line') . ' ' . $LineNo . ': ' . __('the status must be N, W or S');
+				continue;
+			}
+			$Limit = (isset($Row[2]) and trim($Row[2]) != '') ? trim($Row[2]) : $Customer['creditlimit'];
+			$NextReview = (isset($Row[3]) and trim($Row[3]) != '') ? trim($Row[3]) : date('Y-m-d', strtotime(CreditNextReviewDate()));
+			if (!is_numeric($Limit) or $Limit < 0 or !preg_match('/^\d{4}-\d{2}-\d{2}$/', $NextReview)) {
+				$LoadErrors[] = __('Line') . ' ' . $LineNo . ': ' . __('the credit limit or the next review date is not valid');
+				continue;
+			}
+			DB_query("UPDATE debtorsmaster
+						SET creditlimit = '" . $Limit . "',
+							nextreviewdate = '" . $NextReview . "'
+						WHERE debtorno = '" . $Code . "'", __('The customer could not be updated because'), '', true);
+			if (abs($Limit - $Customer['creditlimit']) > 0.0001) {
+				CreditControlLog($Code, 'LIMIT', __('Credit limit loaded from the spreadsheet, was') . ' ' . $Customer['creditlimit'] . ' ' . __('now') . ' ' . $Limit, $Limit, $Customer['currcode']);
+			}
+			if ($StatusMap[$Status] != $Customer['status']) {
+				if (!SetCreditStatus($Code, $StatusMap[$Status], $ReasonFor[$StatusMap[$Status]], __('Loaded from the credit control spreadsheet'))) {
+					$LoadErrors[] = __('Line') . ' ' . $LineNo . ': ' . __('the reason chosen for status') . ' ' . $Status . ' ' . __('does not fit the status');
+					continue;
+				}
+			}
+			CreditControlLog($Code, 'LOAD', __('Credit details loaded from the credit control spreadsheet'));
+			$Loaded++;
+		}
+		fclose($FileHandle);
+		if (count($LoadErrors) > 0) {
+			DB_Txn_Rollback();
+			prnMsg(__('Nothing was loaded because of the following problems. Correct the file and load it again'), 'error');
+			foreach ($LoadErrors as $LoadError) {
+				echo '<br />' . $LoadError;
+			}
+		} else {
+			DB_Txn_Commit();
+			prnMsg($Loaded . ' ' . __('customers have been loaded'), 'success');
+		}
+	}
+}

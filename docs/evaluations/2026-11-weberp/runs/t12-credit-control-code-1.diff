+	$Days = (int)$_POST['CreditChargeDays'];
+	$WriteOffLimit = filter_number_format($_POST['CreditWriteOffLimit']);
+	$MinDays = (int)$_POST['CreditDunningMinDays'];
+	if ($Months < 1 or $Months > 60) {
+		$InputError = 1;
+		prnMsg(__('The standard review period must be between 1 and 60 months'), 'error');
+	}
+	if ($Rate < 0 or $Rate > 100 or $Fee < 0 or $WriteOffLimit < 0) {
+		$InputError = 1;
+		prnMsg(__('The interest rate must be between 0 and 100 and the fee and write-off limit cannot be negative'), 'error');
+	}
+	if ($Days < 0 or $MinDays < 0) {
+		$InputError = 1;
+		prnMsg(__('The number of days cannot be negative'), 'error');
+	}
+	foreach (array('CreditInterestAct', 'CreditLateFeeAct', 'CreditBadDebtAct') as $AccountConf) {
+		if ($_POST[$AccountConf] != '') {
+			$Result = DB_query("SELECT COUNT(*) FROM chartmaster WHERE accountcode = '" . $_POST[$AccountConf] . "'");
+			$MyRow = DB_fetch_row($Result);
+			if ($MyRow[0] != 1) {
+				$InputError = 1;
+				prnMsg(__('The GL account does not exist'), 'error');
+			}
+		}
+	}
+	foreach (array('CreditNormalHoldReason' => CREDIT_NORMAL, 'CreditWatchHoldReason' => CREDIT_WATCH, 'CreditStopHoldReason' => CREDIT_STOP) as $Conf => $Flag) {
+		$Result = DB_query("SELECT COUNT(*) FROM holdreasons WHERE reasoncode = '" . $_POST[$Conf] . "' AND dissallowinvoices = " . $Flag);
+		$MyRow = DB_fetch_row($Result);

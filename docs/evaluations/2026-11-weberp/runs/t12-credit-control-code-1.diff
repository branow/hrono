diff --git a/CreditCharges.php b/CreditCharges.php
new file mode 100644
index 0000000..0c0f515
--- /dev/null
+++ b/CreditCharges.php
@@ -0,0 +1,240 @@
+<?php
+
+/* Month end interest and late fees: preview what will be charged to whom, confirm, post to the customer accounts and the GL.
+ * A customer is never charged twice for the same month (enforced by a unique key as well as by this page).
+ * Also lets credit control waive (reverse) a charge, with a reason, with the reversal posted to the GL. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Month End Interest and Fees');
+$ViewTopic = 'ARTransactions';
+$BookMark = 'CreditCharges';
+include('includes/header.php');
+
+$Rate = (float)$_SESSION['CreditInterestRate'];
+$Fee = (float)$_SESSION['CreditLateFee'];
+$ChargeDays = (int)$_SESSION['CreditChargeDays'];
+$FeePerInvoice = ($_SESSION['CreditFeePerInvoice'] == 1);
+$InterestOnCharges = ($_SESSION['CreditInterestOnCharges'] == 1);
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+/* ---- Waive a charge ---- */
+if (isset($_POST['Waive'])) {
+	$ChargeID = (int)$_POST['Waive'];
+	$Reason = trim($_POST['WaiveReason' . $ChargeID]);
+	$Result = DB_query("SELECT creditcharges.*, debtortrans.id AS transid, debtortrans.balance, debtortrans.rate
+						FROM creditcharges
+						INNER JOIN debtortrans ON debtortrans.type = " . CREDIT_TYPE_CHARGE . " AND debtortrans.transno = creditcharges.transno
+						WHERE creditcharges.id = '" . $ChargeID . "' AND creditcharges.waived = 0");
+	if ($Reason == '') {
+		prnMsg(__('A reason is required to waive a charge'), 'error');
+	} elseif (DB_num_rows($Result) != 1) {
+		prnMsg(__('That charge cannot be found or has already been waived'), 'error');
+	} else {
+		$Charge = DB_fetch_array($Result);
+		if ($Charge['balance'] <= 0.005) {
+			prnMsg(__('That charge has already been paid, so there is nothing left to waive'), 'error');
+		} else {
+			/* reverse exactly what was posted: same GL account, the charge's own rate */
+			$GLLines = array();
+			$Result = DB_query("SELECT account FROM gltrans WHERE type = " . CREDIT_TYPE_CHARGE . " AND typeno = '" . $Charge['transno'] . "'
+								AND account <> '" . $_SESSION['CompanyRecord']['debtorsact'] . "' LIMIT 1");
+			if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+				$GLRow = DB_fetch_row($Result);
+				$GLLines[$GLRow[0]] = $Charge['balance'] / $Charge['rate'];
+			}
+			DB_Txn_Begin();
+			$Waiver = CreditPostTransaction(CREDIT_TYPE_WAIVER, $Charge['debtorno'], -$Charge['balance'], -$Charge['balance'] / $Charge['rate'],
+				__('Waiver of charge') . ' ' . $Charge['transno'], $GLLines, __('Waiver of') . ' ' . $Charge['chargetype'] . ' ' . $Charge['chargemonth'] . ': ' . $Reason);
+			CreditAllocate($Waiver['id'], $Charge['transid'], $Charge['balance']);
+			DB_query("UPDATE creditcharges SET waived = 1, waivedtransno = '" . $Waiver['transno'] . "', waiveddate = NOW(),
+						waivedby = '" . $_SESSION['UserID'] . "', waivereason = '" . $Reason . "'
+					WHERE id = '" . $ChargeID . "'");
+			LogCreditEvent($Charge['debtorno'], 'waive', $Charge['chargetype'] . ' ' . $Charge['chargemonth'] . ': ' . $Reason, $Charge['balance'], $Charge['currcode'], 'type 52/' . $Waiver['transno']);
+			DB_Txn_Commit();
+			prnMsg(__('The charge has been waived. Waiver number') . ' ' . $Waiver['transno'], 'success');
+		}
+	}
+}
+
+/* ---- Work out the charges for a month ---- */
+$Month = (isset($_POST['Month']) and preg_match('/^\d{4}-\d{2}$/', $_POST['Month'])) ? $_POST['Month'] : date('Y-m');
+$MonthEnd = date('Y-m-t', strtotime($Month . '-01'));
+$AsAt = min($MonthEnd, date('Y-m-d'));
+$DaysInMonth = (int)date('t', strtotime($Month . '-01'));
+
+function CreditCalculateCharges($Month, $AsAt, $DaysInMonth, $Rate, $Fee, $ChargeDays, $FeePerInvoice, $InterestOnCharges) {
+	$Charges = array();
+	$Result = DB_query("SELECT DISTINCT debtorsmaster.debtorno
+						FROM debtorsmaster INNER JOIN debtortrans ON debtorsmaster.debtorno = debtortrans.debtorno
+						WHERE debtortrans.balance > 0.005 AND debtorsmaster.chargeexempt = 0
+						ORDER BY debtorsmaster.debtorno");
+	while ($Row = DB_fetch_row($Result)) {
+		$DebtorNo = $Row[0];
+		$Customer = CreditCustomerRecord($DebtorNo);
+		$Position = CreditOverduePosition($DebtorNo, $AsAt, $ChargeDays, $InterestOnCharges);
+		if ($Position['net'] <= 0.005) {
+			continue;
+		}
+		$Done = array();
+		$DoneResult = DB_query("SELECT chargetype FROM creditcharges WHERE debtorno = '" . $DebtorNo . "' AND chargemonth = '" . $Month . "'");
+		while ($DoneRow = DB_fetch_row($DoneResult)) {
+			$Done[$DoneRow[0]] = true;
+		}
+		$Interest = round($Position['net'] * $Rate / 100 * $DaysInMonth / 365, $Customer['decimalplaces']);
+		$FeeAmount = round($Fee * $Customer['rate'] * ($FeePerInvoice ? count($Position['items']) : 1), $Customer['decimalplaces']);
+		$Charges[$DebtorNo] = array('customer' => $Customer,
+									'base' => $Position['net'],
+									'interest' => (($Rate > 0 && $Interest > 0) ? $Interest : 0),
+									'fee' => (($Fee > 0 && $FeeAmount > 0) ? $FeeAmount : 0),
+									'doneinterest' => isset($Done['interest']),
+									'donefee' => isset($Done['fee']));
+	}
+	return $Charges;
+}
+
+/* ---- Post the confirmed charges ---- */
+if (isset($_POST['PostCharges'])) {
+	if (($Rate > 0 and !CreditGLAccountReady('CreditInterestAct')) or ($Fee > 0 and !CreditGLAccountReady('CreditLateFeeAct'))) {
+		prnMsg(__('The GL accounts for interest and late fees must be chosen in the credit control settings before charges can be posted'), 'error');
+		echo '<div class="centre">' . CreditSettingsLink() . '</div>';
+		include('includes/footer.php');
+		exit();
+	}
+	$Charges = CreditCalculateCharges($Month, $AsAt, $DaysInMonth, $Rate, $Fee, $ChargeDays, $FeePerInvoice, $InterestOnCharges);
+	$Posted = 0;
+	if (isset($_POST['Charge']) and is_array($_POST['Charge'])) {
+		foreach ($_POST['Charge'] as $DebtorNo => $On) {
+			if (!isset($Charges[$DebtorNo])) {
+				continue;
+			}
+			$Customer = $Charges[$DebtorNo]['customer'];
+			$MonthLabel = MonthAndYearFromSQLDate($MonthEnd);
+			foreach (array('interest' => 'CreditInterestAct', 'fee' => 'CreditLateFeeAct') as $Type => $AccountConf) {
+				$Amount = $Charges[$DebtorNo][$Type];
+				if ($Amount <= 0 or $Charges[$DebtorNo]['done' . $Type]) {
+					continue;
+				}
+				$Home = $Amount / $Customer['rate'];
+				if ($Type == 'interest') {
+					$Text = __('Interest on overdue balance') . ' ' . $MonthLabel . ' ' . __('at') . ' ' . $Rate . '% ' . __('per annum on') . ' ' . $Customer['currcode'] . ' ' . locale_number_format($Charges[$DebtorNo]['base'], $Customer['decimalplaces']);
+					$Reference = __('Interest') . ' ' . $MonthLabel;
+				} else {
+					$Text = __('Late payment fee') . ' ' . $MonthLabel;
+					$Reference = $Text;
+				}
+				DB_Txn_Begin();
+				$Trans = CreditPostTransaction(CREDIT_TYPE_CHARGE, $DebtorNo, $Amount, $Home, $Reference, array($_SESSION[$AccountConf] => -$Home), $Text);
+				DB_query("INSERT INTO creditcharges (debtorno, chargemonth, chargetype, currcode, amount, transno, posteddate, postedby)
+						VALUES ('" . $DebtorNo . "', '" . $Month . "', '" . $Type . "', '" . $Customer['currcode'] . "', '" . $Amount . "',
+								'" . $Trans['transno'] . "', NOW(), '" . $_SESSION['UserID'] . "')");
+				LogCreditEvent($DebtorNo, 'charge', $Text, $Amount, $Customer['currcode'], 'type 51/' . $Trans['transno']);
+				DB_Txn_Commit();
+				$Posted++;
+			}
+		}
+	}
+	prnMsg(__('Charges posted') . ': ' . $Posted, 'success');
+}
+
+/* ---- Preview ---- */
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Charge month') . '</legend>
+			<field>
+				<label for="Month">' . __('Month') . ':</label>
+				<select name="Month">';
+for ($i = 0; $i < 12; $i++) {
+	$M = date('Y-m', strtotime('-' . $i . ' months', strtotime(date('Y-m-01'))));
+	echo '<option value="' . $M . '"' . ($M == $Month ? ' selected="selected"' : '') . '>' . MonthAndYearFromSQLDate($M . '-01') . '</option>';
+}
+echo '</select>
+			</field>
+			<field>
+				<label>' . __('Settings') . ':</label>
+				<fieldtext>' . __('Interest') . ' ' . $Rate . '% ' . __('per annum') . ', ' . __('late fee') . ' ' . locale_number_format($Fee, 2) . ' ' . $_SESSION['CompanyRecord']['currencydefault'] .
+					($FeePerInvoice ? ' ' . __('per overdue invoice') : ' ' . __('per customer')) . ', ' . __('charged on balances') . ' ' . $ChargeDays . ' ' . __('days or more overdue') . ' - ' . CreditSettingsLink() . '</fieldtext>
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Preview" value="' . __('Show Charges') . '" /></div>';
+
+if ($Rate <= 0 and $Fee <= 0) {
+	prnMsg(__('No interest rate or late fee is set. Finance sets them in the credit control settings'), 'warn');
+} else {
+	$Charges = CreditCalculateCharges($Month, $AsAt, $DaysInMonth, $Rate, $Fee, $ChargeDays, $FeePerInvoice, $InterestOnCharges);
+	echo '<br /><table class="selection">
+			<tr><th colspan="7">' . __('Charges for') . ' ' . MonthAndYearFromSQLDate($MonthEnd) . ' (' . __('overdue as at') . ' ' . ConvertSQLDate($AsAt) . ')</th></tr>
+			<tr><th>' . __('Charge') . '</th><th>' . __('Customer') . '</th><th>' . __('Currency') . '</th><th>' . __('Overdue balance') . '</th><th>' . __('Interest') . '</th><th>' . __('Late fee') . '</th><th></th></tr>';
+	$Any = false;
+	$TotalHome = 0;
+	foreach ($Charges as $DebtorNo => $Charge) {
+		$Customer = $Charge['customer'];
+		$Interest = ($Charge['doneinterest'] ? 0 : $Charge['interest']);
+		$FeeAmount = ($Charge['donefee'] ? 0 : $Charge['fee']);
+		$Already = ($Charge['doneinterest'] or $Charge['donefee']);
+		if ($Interest == 0 and $FeeAmount == 0 and !$Already) {
+			continue;
+		}
+		$DP = $Customer['decimalplaces'];
+		if ($Interest > 0 or $FeeAmount > 0) {
+			$Any = true;
+			$TotalHome += ($Interest + $FeeAmount) / $Customer['rate'];
+		}
+		echo '<tr class="striped_row">
+				<td>' . (($Interest > 0 or $FeeAmount > 0) ? '<input type="checkbox" name="Charge[' . $DebtorNo . ']" checked="checked" />' : '') . '</td>
+				<td><a href="' . $RootPath . '/CreditCustomer.php?DebtorNo=' . urlencode($DebtorNo) . '">' . $DebtorNo . ' - ' . $Customer['name'] . '</a></td>
+				<td>' . $Customer['currcode'] . '</td>
+				<td class="number">' . locale_number_format($Charge['base'], $DP) . '</td>
+				<td class="number">' . ($Charge['doneinterest'] ? __('already charged') : locale_number_format($Interest, $DP)) . '</td>
+				<td class="number">' . ($Charge['donefee'] ? __('already charged') : locale_number_format($FeeAmount, $DP)) . '</td>
+				<td></td>
+			</tr>';
+	}
+	echo '<tr><th colspan="4">' . __('Total to be charged in') . ' ' . $_SESSION['CompanyRecord']['currencydefault'] . '</th><th colspan="3" class="number">' . locale_number_format($TotalHome, $_SESSION['CompanyRecord']['decimalplaces']) . '</th></tr></table>';
+	if ($Any) {
+		echo '<br /><div class="centre"><input type="submit" name="PostCharges" value="' . __('Confirm and Post the Ticked Charges') . '" onclick="return confirm(\'' . __('Post these charges to the customer accounts and the general ledger?') . '\');" /></div>';
+	} else {
+		prnMsg(__('Nothing to charge for this month'), 'info');
+	}
+}
+
+/* ---- Charges that can be waived ---- */
+$Result = DB_query("SELECT creditcharges.id,
+						creditcharges.debtorno,
+						creditcharges.chargemonth,
+						creditcharges.chargetype,
+						creditcharges.currcode,
+						creditcharges.amount,
+						creditcharges.posteddate,
+						debtorsmaster.name,
+						debtortrans.balance,
+						currencies.decimalplaces
+					FROM creditcharges
+					INNER JOIN debtorsmaster ON creditcharges.debtorno = debtorsmaster.debtorno
+					INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+					INNER JOIN debtortrans ON debtortrans.type = " . CREDIT_TYPE_CHARGE . " AND debtortrans.transno = creditcharges.transno
+					WHERE creditcharges.waived = 0 AND debtortrans.balance > 0.005
+					ORDER BY creditcharges.posteddate DESC
+					LIMIT 100");
+echo '<br /><table class="selection">
+		<tr><th colspan="6">' . __('Unpaid charges that can be waived') . '</th></tr>
+		<tr><th>' . __('Customer') . '</th><th>' . __('Month') . '</th><th>' . __('Charge') . '</th><th>' . __('Unpaid') . '</th><th>' . __('Reason') . '</th><th></th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td><a href="' . $RootPath . '/CreditCustomer.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . $MyRow['debtorno'] . ' - ' . $MyRow['name'] . '</a></td>
+			<td>' . $MyRow['chargemonth'] . '</td>
+			<td>' . ($MyRow['chargetype'] == 'interest' ? __('Interest') : __('Late fee')) . '</td>
+			<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['balance'], $MyRow['decimalplaces']) . '</td>
+			<td><input type="text" name="WaiveReason' . $MyRow['id'] . '" size="30" maxlength="150" /></td>
+			<td><button type="submit" name="Waive" value="' . $MyRow['id'] . '">' . __('Waive') . '</button></td>
+		</tr>';
+}
+echo '</table>
+	</form>';
+
+include('includes/footer.php');
diff --git a/CreditControl.php b/CreditControl.php
new file mode 100644
index 0000000..f1c1403
--- /dev/null
+++ b/CreditControl.php
@@ -0,0 +1,303 @@
+<?php
+
+/* Credit control worklist and report: customers due a review, over their limit, on watch or on stop, orders held for
+ * approval, orders taken for customers on watch. Filterable by sales rep and currency, totals in the home currency.
+ * Sales reps only ever see their own customers and cannot release orders. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Control Worklist');
+$ViewTopic = 'ARInquiries';
+$BookMark = 'CreditControl';
+include('includes/header.php');
+
+if (CreditPortalCustomer() != '') {
+	prnMsg(__('You do not have access to this page'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$CanManage = CreditUserCanManage();
+$IsRep = (isset($_SESSION['SalesmanLogin']) and $_SESSION['SalesmanLogin'] != '');
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$HomeDP = $_SESSION['CompanyRecord']['decimalplaces'];
+
+if ($CanManage and isset($_POST['ReleaseOrder'])) {
+	$OrderNo = (int)$_POST['ReleaseOrder'];
+	$Result = DB_query("SELECT salesorders.debtorno, debtorsmaster.currcode
+						FROM salesorders INNER JOIN debtorsmaster ON salesorders.debtorno = debtorsmaster.debtorno
+						WHERE salesorders.orderno = '" . $OrderNo . "' AND salesorders.creditholdstate = 1");
+	if (DB_num_rows($Result) == 1) {
+		$Order = DB_fetch_array($Result);
+		DB_Txn_Begin();
+		DB_query("UPDATE salesorders SET creditholdstate = 2 WHERE orderno = '" . $OrderNo . "'");
+		LogCreditEvent($Order['debtorno'], 'release', __('Order released by credit control') . (trim($_POST['ReleaseNote' . $OrderNo]) != '' ? ': ' . trim($_POST['ReleaseNote' . $OrderNo]) : ''), 0, $Order['currcode'], 'order ' . $OrderNo);
+		DB_Txn_Commit();
+		prnMsg(__('Order') . ' ' . $OrderNo . ' ' . __('has been released and can now be dispatched and invoiced'), 'success');
+	}
+}
+
+/* Filters */
+$Salesman = ($IsRep ? $_SESSION['SalesmanLogin'] : (isset($_POST['Salesman']) ? $_POST['Salesman'] : ''));
+$Currency = (isset($_POST['Currency']) ? $_POST['Currency'] : '');
+$ReviewDays = (isset($_POST['ReviewDays']) ? (int)$_POST['ReviewDays'] : 7);
+
+$Filter = '';
+if ($Salesman != '') {
+	$Filter .= " AND debtorsmaster.debtorno IN (SELECT debtorno FROM custbranch WHERE salesman = '" . $Salesman . "') ";
+}
+if ($Currency != '') {
+	$Filter .= " AND debtorsmaster.currcode = '" . $Currency . "' ";
+}
+$Filter .= CreditRepFilterSQL();
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Filter') . '</legend>';
+if (!$IsRep) {
+	echo '<field>
+			<label for="Salesman">' . __('Sales person') . ':</label>
+			<select name="Salesman">
+				<option value="">' . __('All') . '</option>';
+	$Result = DB_query("SELECT salesmancode, salesmanname FROM salesman ORDER BY salesmanname");
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<option value="' . $MyRow['salesmancode'] . '"' . ($Salesman == $MyRow['salesmancode'] ? ' selected="selected"' : '') . '>' . $MyRow['salesmanname'] . '</option>';
+	}
+	echo '</select></field>';
+}
+echo '<field>
+		<label for="Currency">' . __('Currency') . ':</label>
+		<select name="Currency">
+			<option value="">' . __('All') . '</option>';
+$Result = DB_query("SELECT currabrev, currency FROM currencies ORDER BY currabrev");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option value="' . $MyRow['currabrev'] . '"' . ($Currency == $MyRow['currabrev'] ? ' selected="selected"' : '') . '>' . $MyRow['currabrev'] . ' - ' . $MyRow['currency'] . '</option>';
+}
+echo '</select></field>
+		<field>
+			<label for="ReviewDays">' . __('Show reviews due within (days)') . ':</label>
+			<input type="text" class="integer" name="ReviewDays" size="4" value="' . $ReviewDays . '" />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Show" value="' . __('Show') . '" /></div>';
+
+/* 1. Orders held for credit control approval */
+$SQL = "SELECT salesorders.orderno,
+				salesorders.orddate,
+				salesorders.debtorno,

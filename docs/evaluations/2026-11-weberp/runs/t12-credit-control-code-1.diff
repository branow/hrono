+function CreditSaveConfig($Name, $Value) {
+	$Result = DB_query("SELECT COUNT(*) FROM config WHERE confname = '" . $Name . "'");
+	$MyRow = DB_fetch_row($Result);
+	if ($MyRow[0] == 0) {
+		DB_query("INSERT INTO config (confname, confvalue) VALUES ('" . $Name . "', '" . $Value . "')");
+	} else {
+		DB_query("UPDATE config SET confvalue = '" . $Value . "' WHERE confname = '" . $Name . "'");
+	}
+	$_SESSION[$Name] = $Value;
+}

+		CreditSaveConfig('CreditDunningMinDays', $MinDays);
+		CreditSaveConfig('CreditNormalHoldReason', $_POST['CreditNormalHoldReason']);
+		CreditSaveConfig('CreditWatchHoldReason', $_POST['CreditWatchHoldReason']);
+		CreditSaveConfig('CreditStopHoldReason', $_POST['CreditStopHoldReason']);
+		prnMsg(__('The credit control settings have been saved'), 'success');
+	}

+			<td class="number">' . ($MyRow['amount'] != 0 ? $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], $DP) : '') . '</td>
+		</tr>';
+}
+echo '</table>';
+
+include('includes/footer.php');
diff --git a/CreditReminders.php b/CreditReminders.php
new file mode 100644
index 0000000..f7c5126
--- /dev/null
+++ b/CreditReminders.php
@@ -0,0 +1,149 @@
+<?php
+
+/* The overdue reminder (dunning) run. Credit control starts it, sees who would get which letter, takes out the customers
+ * it is already talking to, and then sends. Letters go by email to the customer's accounts contacts; customers with no
+ * email address are listed with the letter text so that it can be posted. Every letter is recorded against the customer. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Credit Reminder Run');
+$ViewTopic = 'ARTransactions';
+$BookMark = 'CreditReminders';
+include('includes/header.php');
+
+$Today = date('Y-m-d');
+$Stages = CreditDunningStages();
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+if (count($Stages) == 0) {
+	prnMsg(__('No reminder stages are defined yet'), 'warn');
+	echo '<div class="centre">' . CreditSettingsLink() . '</div>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* ---- Send ---- */
+if (isset($_POST['SendReminders'])) {
+	$Sent = 0;
+	$ToPost = array();
+	$Failed = 0;
+	if (isset($_POST['Send']) and is_array($_POST['Send'])) {
+		foreach ($_POST['Send'] as $DebtorNo => $On) {
+			$Customer = CreditCustomerRecord($DebtorNo);
+			if ($Customer === false) {
+				continue;
+			}
+			/* Decide again at the moment of sending: a customer who has paid in the meantime must not get the letter */
+			$Due = CreditReminderDue($DebtorNo, $Today, $Stages);
+			if ($Due['stage'] === null) {
+				prnMsg($DebtorNo . ' - ' . $Customer['name'] . ': ' . __('no letter sent') . ' (' . $Due['reason'] . ')', 'info');
+				continue;
+			}
+			$Stage = $Due['stage'];
+			$Items = CreditOverdueItemsForLetter($DebtorNo, $Today);
+			$Amount = $Due['position']['net'];
+			list($Subject, $Body) = CreditBuildLetter($Stage, $Customer, $Items, $Amount);
+
+			$InvoiceText = '';
+			foreach ($Items as $Item) {
+				$InvoiceText .= $Item['type'] . '/' . $Item['transno'] . ' ' . $Item['trandate'] . ' ' . locale_number_format($Item['balance'], $Customer['decimalplaces']) . '; ';
+			}
+			$Emails = CreditAccountsEmails($DebtorNo);
+			$Method = 'post';
+			if (count($Emails) > 0) {
+				$Result = SendEmailFromWebERP($_SESSION['CompanyRecord']['email'], $Emails, $Subject, $Body, array(), true);
+				if ($Result !== true) {
+					prnMsg($DebtorNo . ' - ' . $Customer['name'] . ': ' . __('the email could not be sent') . ' - ' . (is_string($Result) ? $Result : ''), 'error');
+					$Failed++;
+					continue;
+				}
+				$Method = 'email';
+			}
+			DB_Txn_Begin();
+			DB_query("INSERT INTO dunninglog (debtorno, stage, sentdate, userid, currcode, amount, invoices, method)
+					VALUES ('" . $DebtorNo . "', '" . $Stage['stage'] . "', NOW(), '" . $_SESSION['UserID'] . "', '" . $Customer['currcode'] . "',
+							'" . $Amount . "', '" . DB_escape_string($InvoiceText) . "', '" . $Method . "')",
+					__('The reminder could not be recorded because'));
+			LogCreditEvent($DebtorNo, 'reminder', __('Stage') . ' ' . $Stage['stage'] . ' ' . ($Method == 'email' ? __('emailed to') . ' ' . implode(', ', $Emails) : __('to be posted')), $Amount, $Customer['currcode']);
+			DB_Txn_Commit();
+			if ($Method == 'email') {
+				$Sent++;
+			} else {
+				$ToPost[] = array($DebtorNo . ' - ' . $Customer['name'], $Subject, $Body);
+			}
+		}
+	}
+	prnMsg(__('Reminders emailed') . ': ' . $Sent . '. ' . __('Letters to post') . ': ' . count($ToPost) . '. ' . __('Failed') . ': ' . $Failed, ($Failed > 0 ? 'warn' : 'success'));
+	foreach ($ToPost as $Letter) {
+		echo '<fieldset>
+				<legend>' . __('Letter to post') . ': ' . $Letter[0] . '</legend>
+				<b>' . htmlspecialchars($Letter[1], ENT_QUOTES, 'UTF-8') . '</b>
+				<pre>' . htmlspecialchars($Letter[2], ENT_QUOTES, 'UTF-8') . '</pre>
+			</fieldset>';
+	}
+	echo '<div class="centre"><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">' . __('Back to the reminder run') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* ---- Preview: who would get which letter ---- */
+$SQL = "SELECT DISTINCT debtorsmaster.debtorno
+		FROM debtorsmaster
+		INNER JOIN debtortrans ON debtorsmaster.debtorno = debtortrans.debtorno
+		WHERE debtortrans.balance > 0.005
+		ORDER BY debtorsmaster.debtorno";
+$Result = DB_query($SQL);
+$Send = array();
+$Skipped = array();
+while ($MyRow = DB_fetch_row($Result)) {
+	$Due = CreditReminderDue($MyRow[0], $Today, $Stages);
+	if ($Due['stage'] !== null) {
+		$Send[$MyRow[0]] = $Due;
+	} elseif ($Due['position']['net'] > 0.005 or $Due['position']['gross'] > 0.005) {
+		$Skipped[$MyRow[0]] = $Due['reason'];
+	}
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<div class="page_help_text">' . __('Untick the customers who should not be chased this time, for example where a payment has been promised or there is a dispute. Customers with no accounts contact email are listed so that the letter can be posted.') . '</div><br />';
+
+echo '<table class="selection">
+		<tr><th colspan="7">' . __('Reminders due') . ' - ' . ConvertSQLDate($Today) . '</th></tr>
+		<tr><th>' . __('Send') . '</th><th>' . __('Customer') . '</th><th>' . __('Status') . '</th><th>' . __('Stage') . '</th><th>' . __('Days overdue') . '</th><th>' . __('Overdue') . '</th><th>' . __('Delivery') . '</th></tr>';
+foreach ($Send as $DebtorNo => $Due) {
+	$Customer = CreditCustomerRecord($DebtorNo);
+	$Emails = CreditAccountsEmails($DebtorNo);
+	echo '<tr class="striped_row">
+			<td><input type="checkbox" name="Send[' . $DebtorNo . ']" checked="checked" /></td>
+			<td><a href="' . $RootPath . '/CreditCustomer.php?DebtorNo=' . urlencode($DebtorNo) . '">' . $DebtorNo . ' - ' . $Customer['name'] . '</a></td>
+			<td>' . CreditStatusLabel($Customer['dissallowinvoices']) . '</td>
+			<td class="number">' . $Due['stage']['stage'] . '</td>
+			<td class="number">' . $Due['position']['maxdays'] . '</td>
+			<td class="number">' . $Customer['currcode'] . ' ' . locale_number_format($Due['position']['net'], $Customer['decimalplaces']) . '</td>
+			<td>' . (count($Emails) > 0 ? implode(', ', $Emails) : '<b>' . __('No email - letter to post') . '</b>') . '</td>
+		</tr>';
+}
+echo '</table>';
+
+if (count($Send) > 0) {
+	echo '<br /><div class="centre"><input type="submit" name="SendReminders" value="' . __('Send Reminders to the Ticked Customers') . '" /></div>';
+} else {
+	prnMsg(__('No customer is due a reminder today'), 'info');
+}
+
+if (count($Skipped) > 0) {
+	echo '<br /><table class="selection">
+			<tr><th colspan="2">' . __('Overdue customers who get no letter this time') . '</th></tr>';
+	foreach ($Skipped as $DebtorNo => $Reason) {
+		echo '<tr class="striped_row"><td><a href="' . $RootPath . '/CreditCustomer.php?DebtorNo=' . urlencode($DebtorNo) . '">' . $DebtorNo . '</a></td><td>' . $Reason . '</td></tr>';
+	}
+	echo '</table>';
+}
+echo '</form>';
+
+include('includes/footer.php');
diff --git a/CreditWriteOffs.php b/CreditWriteOffs.php
new file mode 100644
index 0000000..07c4220
--- /dev/null
+++ b/CreditWriteOffs.php
@@ -0,0 +1,247 @@
+<?php
+
+/* Bad debt write-offs. Credit control requests a write-off of all or part of a customer's unpaid balance. Write-offs up to the
+ * limit Finance sets are posted at once; larger ones wait for the Finance Director (credit control authority, token 22).
+ * Posting reduces the customer's balance (the write-off is allocated to the oldest open invoices), debits the bad debt account
+ * and credits debtors control at the value the invoices were originally posted at, so no exchange difference arises and the
+ * ledger keeps agreeing with the customer accounts. The customer is put on stop unless credit control decides otherwise. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$Title = __('Bad Debt Write-offs');
+$ViewTopic = 'ARTransactions';
+$BookMark = 'CreditWriteOffs';
+include('includes/header.php');
+
+$HomeCurrency = $_SESSION['CompanyRecord']['currencydefault'];
+$HomeDP = $_SESSION['CompanyRecord']['decimalplaces'];
+$Limit = (float)$_SESSION['CreditWriteOffLimit'];
+
+/* Oldest-first allocation plan: which open invoices a write-off of $Amount would settle, and its value in home currency */
+function CreditWriteOffPlan($DebtorNo, $Amount) {
+	$Result = DB_query("SELECT id, balance, rate FROM debtortrans WHERE debtorno = '" . $DebtorNo . "' AND balance > 0.005 ORDER BY trandate, transno");
+	$Plan = array();
+	$Home = 0;
+	$Remaining = $Amount;
+	$Available = 0;
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Available += $MyRow['balance'];
+		if ($Remaining > 0.005) {
+			$Take = min($Remaining, $MyRow['balance']);
+			$Plan[$MyRow['id']] = $Take;
+			$Home += $Take / $MyRow['rate'];
+			$Remaining -= $Take;
+		}
+	}
+	return array('plan' => $Plan, 'home' => $Home, 'available' => $Available);
+}
+
+/* Post a requested write-off. Returns '' or an error message. */
+function CreditPostWriteOff($WriteOffID) {
+	$Result = DB_query("SELECT * FROM creditwriteoffs WHERE id = '" . (int)$WriteOffID . "' AND status IN ('pending', 'approved')");
+	if (DB_num_rows($Result) != 1) {
+		return __('That write-off cannot be posted');
+	}
+	$WriteOff = DB_fetch_array($Result);
+	if (!CreditGLAccountReady('CreditBadDebtAct')) {
+		return __('The bad debt GL account must be chosen in the credit control settings before write-offs can be posted');
+	}
+	$Plan = CreditWriteOffPlan($WriteOff['debtorno'], $WriteOff['amount']);
+	if ($WriteOff['amount'] > $Plan['available'] + 0.005) {
+		return __('The customer no longer owes this much') . ': ' . locale_number_format($Plan['available'], 2);
+	}
+	$Home = round($Plan['home'], $_SESSION['CompanyRecord']['decimalplaces']);
+	DB_Txn_Begin();
+	$GLLines = array();
+	if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+		$GLLines[$_SESSION['CreditBadDebtAct']] = $Home;
+	}
+	$Trans = CreditPostTransaction(CREDIT_TYPE_WRITEOFF, $WriteOff['debtorno'], -$WriteOff['amount'], -$Home,
+		__('Bad debt write-off') . ' ' . $WriteOff['id'], $GLLines, __('Bad debt write-off') . ': ' . $WriteOff['reason']);
+	foreach ($Plan['plan'] as $InvoiceID => $Part) {
+		CreditAllocate($Trans['id'], $InvoiceID, $Part);
+	}
+	DB_query("UPDATE creditwriteoffs SET status = 'posted', posteddate = NOW(), transno = '" . $Trans['transno'] . "', homeamount = '" . $Home . "'
+			WHERE id = '" . $WriteOff['id'] . "'");
+	LogCreditEvent($WriteOff['debtorno'], 'writeoff', $WriteOff['reason'], $WriteOff['amount'], $WriteOff['currcode'], 'type 53/' . $Trans['transno']);
+	if ($WriteOff['putonstop'] == 1) {
+		$StopError = CreditSetStatus($WriteOff['debtorno'], 'stop', __('Debt written off') . ': ' . $WriteOff['reason']);
+		if ($StopError != '') {
+			DB_Txn_Rollback();
+			return $StopError;
+		}
+	}
+	DB_Txn_Commit();
+	return '';
+}
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+/* ---- Approve / reject ---- */
+if (isset($_POST['Approve']) or isset($_POST['Reject'])) {
+	if (!CreditUserCanApprove()) {
+		prnMsg(__('Only the Finance Director can approve or reject write-offs'), 'error');
+	} else {
+		$ID = (int)(isset($_POST['Approve']) ? $_POST['Approve'] : $_POST['Reject']);
+		$Result = DB_query("SELECT debtorno, currcode, amount FROM creditwriteoffs WHERE id = '" . $ID . "' AND status = 'pending'");
+		if (DB_num_rows($Result) == 1) {
+			$Row = DB_fetch_array($Result);
+			if (isset($_POST['Approve'])) {
+				DB_query("UPDATE creditwriteoffs SET status = 'approved', approvedby = '" . $_SESSION['UserID'] . "', approvaldate = NOW() WHERE id = '" . $ID . "'");
+				$Error = CreditPostWriteOff($ID);
+				if ($Error == '') {
+					prnMsg(__('The write-off has been approved and posted'), 'success');
+				} else {
+					prnMsg($Error, 'error');
+				}
+			} else {
+				DB_query("UPDATE creditwriteoffs SET status = 'rejected', approvedby = '" . $_SESSION['UserID'] . "', approvaldate = NOW() WHERE id = '" . $ID . "'");
+				LogCreditEvent($Row['debtorno'], 'writeoffrejected', __('Write-off request rejected'), $Row['amount'], $Row['currcode']);
+				prnMsg(__('The write-off request has been rejected'), 'info');
+			}
+		}
+	}
+}
+
+/* ---- Request ---- */
+if (isset($_POST['RequestWriteOff'])) {
+	$InputError = 0;
+	$DebtorNo = trim($_POST['DebtorNo']);
+	$Customer = CreditCustomerRecord($DebtorNo);
+	$Reason = trim($_POST['Reason']);
+	if ($Customer === false) {
+		$InputError = 1;
+		prnMsg(__('The customer code does not exist'), 'error');
+	} else {
+		$Amount = round(filter_number_format($_POST['Amount']), $Customer['decimalplaces']);
+		$Plan = CreditWriteOffPlan($DebtorNo, $Amount);
+		if ($Amount <= 0) {
+			$InputError = 1;
+			prnMsg(__('The amount to write off must be greater than zero'), 'error');
+		} elseif ($Amount > $Plan['available'] + 0.005) {
+			$InputError = 1;
+			prnMsg(__('The customer only owes') . ' ' . $Customer['currcode'] . ' ' . locale_number_format($Plan['available'], $Customer['decimalplaces']) . ' ' . __('on open invoices and charges. If receipts have not been allocated yet, allocate them first'), 'error');
+		}
+	}
+	if ($Reason == '') {
+		$InputError = 1;
+		prnMsg(__('A reason is required for a write-off'), 'error');
+	}
+	if ($InputError == 0) {
+		$PutOnStop = (isset($_POST['PutOnStop']) ? 1 : 0);
+		DB_query("INSERT INTO creditwriteoffs (debtorno, requestdate, requestedby, currcode, amount, homeamount, reason, status, putonstop)
+				VALUES ('" . $DebtorNo . "', NOW(), '" . $_SESSION['UserID'] . "', '" . $Customer['currcode'] . "', '" . $Amount . "',
+						'" . round($Plan['home'], $HomeDP) . "', '" . $Reason . "', 'pending', '" . $PutOnStop . "')");
+		$ID = DB_Last_Insert_ID('creditwriteoffs', 'id');
+		LogCreditEvent($DebtorNo, 'writeoffreq', $Reason, $Amount, $Customer['currcode']);
+		if ($Plan['home'] <= $Limit) {
+			$Error = CreditPostWriteOff($ID);
+			if ($Error == '') {
+				prnMsg(__('The write-off is below the approval limit and has been posted'), 'success');
+			} else {
+				prnMsg($Error, 'error');
+			}
+		} else {
+			prnMsg(__('The write-off is above the approval limit of') . ' ' . $HomeCurrency . ' ' . locale_number_format($Limit, $HomeDP) . ' ' . __('and is waiting for the Finance Director to approve it. Nothing has been posted'), 'info');
+		}
+		unset($_POST['DebtorNo'], $_POST['Amount'], $_POST['Reason']);
+	}
+}
+
+$FormAction = htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8');
+$PreDebtor = (isset($_POST['DebtorNo']) ? $_POST['DebtorNo'] : (isset($_GET['DebtorNo']) ? $_GET['DebtorNo'] : ''));
+
+echo '<form method="post" action="' . $FormAction . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Request a write-off') . '</legend>
+			<field>
+				<label for="DebtorNo">' . __('Customer code') . ':</label>
+				<input type="text" name="DebtorNo" size="10" maxlength="10" required="required" value="' . $PreDebtor . '" />
+			</field>
+			<field>
+				<label for="Amount">' . __('Amount to write off (customer currency)') . ':</label>
+				<input type="text" class="number" name="Amount" size="12" required="required" value="' . (isset($_POST['Amount']) ? $_POST['Amount'] : '') . '" />
+			</field>
+			<field>
+				<label for="Reason">' . __('Reason') . ':</label>
+				<input type="text" name="Reason" size="60" maxlength="250" required="required" value="' . (isset($_POST['Reason']) ? $_POST['Reason'] : '') . '" />
+			</field>
+			<field>
+				<label for="PutOnStop">' . __('Put the customer on stop') . ':</label>
+				<input type="checkbox" name="PutOnStop"' . ($_SESSION['CreditStopOnWriteOff'] == 1 ? ' checked="checked"' : '') . ' />
+			</field>
+			<field>
+				<label>' . __('Approval limit') . ':</label>
+				<fieldtext>' . $HomeCurrency . ' ' . locale_number_format($Limit, $HomeDP) . ' - ' . __('write-offs above this wait for the Finance Director') . '</fieldtext>
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="RequestWriteOff" value="' . __('Request Write-off') . '" /></div>';
+
+/* ---- Waiting for approval ---- */
+$Result = DB_query("SELECT creditwriteoffs.*, debtorsmaster.name, currencies.decimalplaces
+					FROM creditwriteoffs
+					INNER JOIN debtorsmaster ON creditwriteoffs.debtorno = debtorsmaster.debtorno
+					INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+					WHERE creditwriteoffs.status = 'pending'
+					ORDER BY creditwriteoffs.requestdate");
+echo '<br /><table class="selection">
+		<tr><th colspan="7">' . __('Waiting for Finance Director approval') . '</th></tr>
+		<tr><th>' . __('Requested') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . $HomeCurrency . '</th><th>' . __('Reason') . '</th><th>' . __('Requested by') . '</th><th></th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate($MyRow['requestdate']) . '</td>
+			<td><a href="' . $RootPath . '/CreditCustomer.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . $MyRow['debtorno'] . ' - ' . $MyRow['name'] . '</a></td>
+			<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], $MyRow['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($MyRow['homeamount'], $HomeDP) . '</td>
+			<td>' . $MyRow['reason'] . '</td>
+			<td>' . $MyRow['requestedby'] . '</td>
+			<td>' . (CreditUserCanApprove() ? '<button type="submit" name="Approve" value="' . $MyRow['id'] . '">' . __('Approve and post') . '</button>
+				<button type="submit" name="Reject" value="' . $MyRow['id'] . '">' . __('Reject') . '</button>' : __('Awaiting approval')) . '</td>
+		</tr>';
+}
+echo '</table>';
+
+/* ---- Report ---- */
+$From = (isset($_POST['FromDate']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['FromDate'])) ? $_POST['FromDate'] : date('Y-m-d', strtotime('-3 months'));
+$To = (isset($_POST['ToDate']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['ToDate'])) ? $_POST['ToDate'] : date('Y-m-d');
+echo '<br /><fieldset>
+		<legend>' . __('Write-off report') . '</legend>
+		<field><label for="FromDate">' . __('From') . ':</label><input type="date" name="FromDate" value="' . $From . '" /></field>
+		<field><label for="ToDate">' . __('To') . ':</label><input type="date" name="ToDate" value="' . $To . '" /></field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Report" value="' . __('Show Write-offs') . '" /></div>
+	</form>';
+
+$Result = DB_query("SELECT creditwriteoffs.*, debtorsmaster.name, currencies.decimalplaces
+					FROM creditwriteoffs
+					INNER JOIN debtorsmaster ON creditwriteoffs.debtorno = debtorsmaster.debtorno
+					INNER JOIN currencies ON debtorsmaster.currcode = currencies.currabrev
+					WHERE DATE(creditwriteoffs.requestdate) BETWEEN '" . $From . "' AND '" . $To . "'
+					ORDER BY creditwriteoffs.requestdate");
+echo '<br /><table class="selection">
+		<tr><th colspan="9">' . __('Write-offs from') . ' ' . ConvertSQLDate($From) . ' ' . __('to') . ' ' . ConvertSQLDate($To) . '</th></tr>
+		<tr><th>' . __('Requested') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . $HomeCurrency . '</th><th>' . __('Reason') . '</th><th>' . __('Requested by') . '</th><th>' . __('Approved by') . '</th><th>' . __('Status') . '</th><th>' . __('Number') . '</th></tr>';
+$Total = 0;
+while ($MyRow = DB_fetch_array($Result)) {
+	if ($MyRow['status'] == 'posted') {
+		$Total += $MyRow['homeamount'];
+	}
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate($MyRow['requestdate']) . '</td>
+			<td>' . $MyRow['debtorno'] . ' - ' . $MyRow['name'] . '</td>
+			<td class="number">' . $MyRow['currcode'] . ' ' . locale_number_format($MyRow['amount'], $MyRow['decimalplaces']) . '</td>
+			<td class="number">' . locale_number_format($MyRow['homeamount'], $HomeDP) . '</td>
+			<td>' . $MyRow['reason'] . '</td>
+			<td>' . $MyRow['requestedby'] . '</td>
+			<td>' . ($MyRow['approvedby'] != '' ? $MyRow['approvedby'] : ($MyRow['status'] == 'posted' ? __('Below approval limit') : '')) . '</td>
+			<td>' . $MyRow['status'] . '</td>
+			<td class="number">' . ($MyRow['transno'] > 0 ? $MyRow['transno'] : '') . '</td>
+		</tr>';
+}
+echo '<tr><th colspan="3">' . __('Total posted') . '</th><th class="number">' . locale_number_format($Total, $HomeDP) . '</th><th colspan="5"></th></tr></table>';
+
+include('includes/footer.php');
diff --git a/CustomerCreditPortal.php b/CustomerCreditPortal.php
new file mode 100644
index 0000000..5284fcf
--- /dev/null
+++ b/CustomerCreditPortal.php
@@ -0,0 +1,70 @@
+<?php
+
+/* Customer portal: a customer sees their own balance, the reminder letters sent to them and the interest and fees charged
+ * to their account. The customer is always taken from the logged-in user's record, never from the URL or the form,
+ * so a customer can only ever see their own account. Watch status is internal and is not shown. */
+
+require(__DIR__ . '/includes/session.php');
+
+include('includes/SQL_CommonFunctions.php');

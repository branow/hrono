--- /dev/null
+++ b/CreditReviews.php
@@ -0,0 +1,364 @@
+<?php
+
+/* Records the credit reviews of one customer. A review that raises or lowers the credit limit, or puts the account on hold, also
+changes the customer's account (debtorsmaster.creditlimit / debtorsmaster.holdreason) in the same transaction. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Customer Credit Reviews');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditReviews';
+include('includes/header.php');
+
+if (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+} elseif (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+}
+
+if (!isset($DebtorNo) or $DebtorNo == '') {
+	prnMsg(__('A customer must be selected before credit reviews can be shown'), 'info');
+	echo '<br /><a href="' . $RootPath . '/SelectCustomer.php">' . __('Select a customer') . '</a>';
+	include('includes/footer.php');
+	exit();
+}
+
+$SQL = "SELECT name,
+				creditlimit,
+				currcode,
+				holdreason
+			FROM debtorsmaster
+			WHERE debtorno='" . $DebtorNo . "'";
+$Result = DB_query($SQL);
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('The customer') . ' ' . $DebtorNo . ' ' . __('does not exist'), 'error');
+	echo '<br /><a href="' . $RootPath . '/SelectCustomer.php">' . __('Select a customer') . '</a>';
+	include('includes/footer.php');
+	exit();
+}
+$Customer = DB_fetch_array($Result);
+
+$Outcomes = array(
+	0 => __('Limit kept'),
+	1 => __('Limit raised'),
+	2 => __('Limit lowered'),
+	3 => __('Account on hold')
+);
+
+function IsSQLDate($Date) {
+	$DateObject = DateTime::createFromFormat('Y-m-d', $Date);
+	return ($DateObject !== false and $DateObject->format('Y-m-d') == $Date);
+}
+
+if (isset($_POST['ReviewID'])) {
+	$ReviewID = (int)$_POST['ReviewID'];
+} elseif (isset($_GET['ReviewID'])) {
+	$ReviewID = (int)$_GET['ReviewID'];
+}
+
+if (isset($_POST['delete']) and isset($ReviewID)) {
+	/* Only the review record goes: the customer account keeps whatever limit or hold the review set. */
+	$SQL = "DELETE FROM creditreviews
+			WHERE reviewid='" . $ReviewID . "'
+				AND debtorno='" . $DebtorNo . "'";
+	$Result = DB_query($SQL, __('The credit review could not be deleted because'));
+	prnMsg(__('The credit review has been deleted. The credit limit and credit status of the customer account were not changed'), 'success');
+	unset($ReviewID);
+}
+
+if (isset($_POST['submit'])) {
+
+	$InputError = 0;
+
+	if (!IsSQLDate($_POST['ReviewDate'])) {
+		$InputError = 1;
+		prnMsg(__('The review date must be a valid date'), 'error');
+	} elseif ($_POST['ReviewDate'] > date('Y-m-d')) {
+		$InputError = 1;
+		prnMsg(__('The review date cannot be in the future'), 'error');
+	}
+	if (!IsSQLDate($_POST['NextReviewDate'])) {
+		$InputError = 1;
+		prnMsg(__('The date of the next review must be a valid date'), 'error');
+	} elseif ($_POST['NextReviewDate'] <= $_POST['ReviewDate']) {
+		$InputError = 1;
+		prnMsg(__('The date of the next review must be after the review date'), 'error');
+	}
+	if (trim($_POST['Comments']) == '') {
+		$InputError = 1;
+		prnMsg(__('The comments on the review must be entered'), 'error');
+	}
+
+	if ($InputError == 0 and isset($ReviewID)) {
+		/* Correcting an existing review: dates and comments only. The outcome and what it did to the account stay as recorded. */
+		$SQL = "UPDATE creditreviews SET reviewdate='" . $_POST['ReviewDate'] . "',
+										nextreviewdate='" . $_POST['NextReviewDate'] . "',
+										comments='" . $_POST['Comments'] . "'
+				WHERE reviewid='" . $ReviewID . "'
+					AND debtorno='" . $DebtorNo . "'";
+		$Result = DB_query($SQL, __('The credit review could not be updated because'));
+		prnMsg(__('The credit review has been updated'), 'success');
+		unset($ReviewID);
+		unset($_POST['ReviewDate'], $_POST['NextReviewDate'], $_POST['Comments']);
+
+	} elseif ($InputError == 0) {
+		$Outcome = isset($_POST['Outcome']) ? (int)$_POST['Outcome'] : -1;
+		$NewLimit = 'NULL';
+		$HoldReason = 'NULL';
+
+		if (!isset($Outcomes[$Outcome])) {
+			$InputError = 1;
+			prnMsg(__('The outcome of the review must be selected'), 'error');
+		} elseif ($Outcome == 1 or $Outcome == 2) {
+			if (!is_numeric(filter_number_format($_POST['NewLimit'])) or filter_number_format($_POST['NewLimit']) < 0) {
+				$InputError = 1;
+				prnMsg(__('The new credit limit must be a number of zero or more'), 'error');
+			} else {
+				$NewLimit = "'" . filter_number_format($_POST['NewLimit']) . "'";
+			}
+		} elseif ($Outcome == 3) {
+			$Result = DB_query("SELECT reasoncode FROM holdreasons
+								WHERE reasoncode='" . (int)$_POST['HoldReason'] . "'
+									AND dissallowinvoices=1");
+			if (DB_num_rows($Result) == 0) {
+				$InputError = 1;
+				prnMsg(__('A credit status that disallows invoicing must be selected to put the account on hold'), 'error');
+			} else {
+				$HoldReason = "'" . (int)$_POST['HoldReason'] . "'";
+			}
+		}
+	}
+
+	if ($InputError == 0 and !isset($ReviewID)) {
+		DB_Txn_Begin();
+		/* lock the customer row so the previous limit recorded is the one the account really had */
+		$Result = DB_query("SELECT creditlimit FROM debtorsmaster WHERE debtorno='" . $DebtorNo . "' FOR UPDATE",
+							__('The customer account could not be read because'), '', true);
+		$MyRow = DB_fetch_array($Result);
+		$PreviousLimit = $MyRow['creditlimit'];
+
+		if ($Outcome == 1 and filter_number_format($_POST['NewLimit']) <= $PreviousLimit) {
+			$InputError = 1;
+			prnMsg(__('To raise the limit the new credit limit must be more than the current limit of') . ' ' . locale_number_format($PreviousLimit, 0), 'error');
+		} elseif ($Outcome == 2 and filter_number_format($_POST['NewLimit']) >= $PreviousLimit) {
+			$InputError = 1;
+			prnMsg(__('To lower the limit the new credit limit must be less than the current limit of') . ' ' . locale_number_format($PreviousLimit, 0), 'error');
+		}
+
+		if ($InputError == 1) {
+			DB_Txn_Rollback();
+		} else {
+			$SQL = "INSERT INTO creditreviews (debtorno,
+												reviewdate,
+												reviewedby,
+												outcome,
+												previouslimit,
+												newlimit,
+												holdreason,
+												nextreviewdate,
+												comments)
+									VALUES ('" . $DebtorNo . "',
+											'" . $_POST['ReviewDate'] . "',
+											'" . $_SESSION['UserID'] . "',
+											'" . $Outcome . "',
+											'" . $PreviousLimit . "',
+											" . $NewLimit . ",
+											" . $HoldReason . ",
+											'" . $_POST['NextReviewDate'] . "',
+											'" . $_POST['Comments'] . "')";
+			$Result = DB_query($SQL, __('The credit review could not be saved because'), '', true);
+
+			if ($Outcome == 1 or $Outcome == 2) {
+				$SQL = "UPDATE debtorsmaster SET creditlimit=" . $NewLimit . "
+						WHERE debtorno='" . $DebtorNo . "'";
+				$Result = DB_query($SQL, __('The credit limit of the customer could not be changed because'), '', true);
+			} elseif ($Outcome == 3) {
+				$SQL = "UPDATE debtorsmaster SET holdreason=" . $HoldReason . "
+						WHERE debtorno='" . $DebtorNo . "'";
+				$Result = DB_query($SQL, __('The credit status of the customer could not be changed because'), '', true);
+			}
+			DB_Txn_Commit();
+
+			prnMsg(__('The credit review has been recorded'), 'success');
+			if ($Outcome == 1 or $Outcome == 2) {
+				prnMsg(__('The credit limit of the customer is now') . ' ' . locale_number_format(filter_number_format($_POST['NewLimit']), 0), 'info');
+				$Customer['creditlimit'] = filter_number_format($_POST['NewLimit']);
+			} elseif ($Outcome == 3) {
+				prnMsg(__('The customer account has been put on hold'), 'info');
+				$Customer['holdreason'] = (int)$_POST['HoldReason'];
+			}
+			unset($_POST['Outcome'], $_POST['NewLimit'], $_POST['HoldReason'], $_POST['ReviewDate'], $_POST['NextReviewDate'], $_POST['Comments']);
+		}
+	}
+}
+
+echo '<a class="toplink" href="' . $RootPath . '/SelectCustomer.php">' . __('Back to Select Customer') . '</a>';
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . __('Credit Reviews') . '" alt="" />' .
+	' ' . __('Credit Reviews for Customer') . ': <b>' . $DebtorNo . ' - ' . $Customer['name'] . '</b></p>';
+
+$Result = DB_query("SELECT reasondescription, dissallowinvoices FROM holdreasons WHERE reasoncode='" . $Customer['holdreason'] . "'");
+$StatusRow = DB_fetch_array($Result);
+
+echo '<table class="selection">
+		<tr>
+			<th>' . __('Current Credit Limit') . '</th>
+			<td class="number">' . locale_number_format($Customer['creditlimit'], 0) . ' ' . $Customer['currcode'] . '</td>
+			<th>' . __('Current Credit Status') . '</th>
+			<td>' . ($StatusRow ? $StatusRow['reasondescription'] : '') . '</td>
+		</tr>
+	</table>';
+
+/* The form first, so the controller does not have to scroll past a long history to record a review */
+if (isset($ReviewID)) {
+	$SQL = "SELECT reviewid, reviewdate, outcome, previouslimit, newlimit, holdreason, nextreviewdate, comments
+			FROM creditreviews
+			WHERE reviewid='" . $ReviewID . "'
+				AND debtorno='" . $DebtorNo . "'";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('That credit review does not exist for this customer'), 'error');
+		unset($ReviewID);
+	} else {
+		$Review = DB_fetch_array($Result);
+		if (!isset($_POST['submit'])) {
+			$_POST['ReviewDate'] = $Review['reviewdate'];
+			$_POST['NextReviewDate'] = $Review['nextreviewdate'];
+			$_POST['Comments'] = $Review['comments'];
+		}
+	}
+}
+
+if (!isset($_POST['ReviewDate'])) {
+	$_POST['ReviewDate'] = date('Y-m-d');
+	$_POST['NextReviewDate'] = '';
+	$_POST['Comments'] = '';
+	$_POST['NewLimit'] = '';
+	$_POST['Outcome'] = 0;
+} elseif (isset($_POST['submit'])) {
+	/* showing the entry again after an error: the posted text is escaped for SQL, undo that for the form */
+	$_POST['Comments'] = stripcslashes($_POST['Comments']);
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />';
+
+if (isset($ReviewID)) {
+	echo '<input type="hidden" name="ReviewID" value="' . $ReviewID . '" />
+		<fieldset>
+			<legend>' . __('Correct credit review') . '</legend>
+			<field>
+				<label>' . __('Outcome') . ':</label>
+				<fieldtext>' . $Outcomes[$Review['outcome']] . '</fieldtext>
+				<fieldhelp>' . __('The outcome and its effect on the account cannot be changed. Record a new review to change the account') . '</fieldhelp>
+			</field>';
+} else {
+	echo '<fieldset>
+			<legend>' . __('Record credit review') . '</legend>
+			<field>
+				<label for="Outcome">' . __('Outcome') . ':</label>
+				<select name="Outcome" id="Outcome">';
+	foreach ($Outcomes as $Code => $Description) {
+		echo '<option ' . ($_POST['Outcome'] == $Code ? 'selected="selected" ' : '') . 'value="' . $Code . '">' . $Description . '</option>';
+	}
+	echo '</select>
+			</field>
+			<field>
+				<label for="NewLimit">' . __('New Credit Limit') . ':</label>
+				<input type="text" class="integer" name="NewLimit" id="NewLimit" size="16" maxlength="14" value="' . $_POST['NewLimit'] . '" />
+				<fieldhelp>' . __('Required when the limit is raised or lowered. Left alone for the other outcomes') . '</fieldhelp>
+			</field>
+			<field>
+				<label for="HoldReason">' . __('Hold Credit Status') . ':</label>
+				<select name="HoldReason" id="HoldReason">';
+	$Result = DB_query("SELECT reasoncode, reasondescription FROM holdreasons WHERE dissallowinvoices=1 ORDER BY reasoncode");
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<option ' . ((isset($_POST['HoldReason']) and $_POST['HoldReason'] == $MyRow['reasoncode']) ? 'selected="selected" ' : '') . 'value="' . $MyRow['reasoncode'] . '">' . $MyRow['reasondescription'] . '</option>';
+	}
+	echo '</select>
+				<fieldhelp>' . __('Required when the account is put on hold. Only credit statuses that disallow invoicing are offered') . '</fieldhelp>
+			</field>';
+}
+
+echo '<field>
+			<label for="ReviewDate">' . __('Review Date') . ':</label>
+			<input type="date" required="required" name="ReviewDate" id="ReviewDate" value="' . $_POST['ReviewDate'] . '" />
+		</field>
+		<field>
+			<label for="NextReviewDate">' . __('Next Review Date') . ':</label>
+			<input type="date" required="required" name="NextReviewDate" id="NextReviewDate" value="' . $_POST['NextReviewDate'] . '" />
+		</field>
+		<field>
+			<label for="Comments">' . __('Comments') . ':</label>
+			<textarea name="Comments" id="Comments" required="required" rows="8" cols="60">' . $_POST['Comments'] . '</textarea>
+		</field>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="submit" value="' . __('Enter Information') . '" />';
+if (isset($ReviewID)) {
+	echo ' <a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '?DebtorNo=' . urlencode($DebtorNo) . '">' . __('Cancel the correction') . '</a>';
+}
+echo '</div>
+	</form>';
+
+/* History, newest first */
+$SQL = "SELECT creditreviews.reviewid,
+				creditreviews.reviewdate,
+				creditreviews.reviewedby,
+				www_users.realname,
+				creditreviews.outcome,
+				creditreviews.previouslimit,
+				creditreviews.newlimit,
+				holdreasons.reasondescription,
+				creditreviews.nextreviewdate,
+				creditreviews.comments
+			FROM creditreviews
+			LEFT JOIN www_users ON www_users.userid = creditreviews.reviewedby
+			LEFT JOIN holdreasons ON holdreasons.reasoncode = creditreviews.holdreason
+			WHERE creditreviews.debtorno='" . $DebtorNo . "'
+			ORDER BY creditreviews.reviewdate DESC, creditreviews.reviewid DESC";
+$Result = DB_query($SQL);
+
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('There are no credit reviews recorded for this customer'), 'info');
+} else {
+	echo '<table class="selection">
+			<tr>
+				<th>' . __('Review Date') . '</th>
+				<th>' . __('Reviewed By') . '</th>
+				<th>' . __('Outcome') . '</th>
+				<th>' . __('Previous Limit') . '</th>
+				<th>' . __('New Limit') . '</th>
+				<th>' . __('Next Review Date') . '</th>
+				<th>' . __('Comments') . '</th>
+				<th colspan="2"></th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Outcome = $Outcomes[$MyRow['outcome']] ?? '';
+		if ($MyRow['outcome'] == 3 and $MyRow['reasondescription'] != '') {
+			$Outcome .= ' (' . $MyRow['reasondescription'] . ')';
+		}
+		echo '<tr class="striped_row">
+				<td>' . ConvertSQLDate($MyRow['reviewdate']) . '</td>
+				<td>' . ($MyRow['realname'] ?? $MyRow['reviewedby']) . '</td>
+				<td>' . $Outcome . '</td>
+				<td class="number">' . locale_number_format($MyRow['previouslimit'], 0) . '</td>
+				<td class="number">' . ($MyRow['newlimit'] === null ? '' : locale_number_format($MyRow['newlimit'], 0)) . '</td>
+				<td>' . ConvertSQLDate($MyRow['nextreviewdate']) . '</td>
+				<td>' . nl2br($MyRow['comments']) . '</td>
+				<td><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '?DebtorNo=' . urlencode($DebtorNo) . '&amp;ReviewID=' . $MyRow['reviewid'] . '">' . __('Correct') . '</a></td>
+				<td>
+					<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" onsubmit="return confirm(\'' . __('Are you sure you wish to delete this credit review? The credit limit and credit status of the customer will not be changed') . '\');">
+						<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+						<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+						<input type="hidden" name="ReviewID" value="' . $MyRow['reviewid'] . '" />
+						<input type="submit" name="delete" value="' . __('Delete') . '" />
+					</form>
+				</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/CreditReviewsDue.php b/CreditReviewsDue.php
new file mode 100644
index 0000000..c71ea1d
--- /dev/null
+++ b/CreditReviewsDue.php
@@ -0,0 +1,66 @@
+<?php
+
+/* Customers whose next credit review date has passed. Only a customer's latest review counts: its next review date
+supersedes the dates set by the older reviews. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Customers Due For Credit Review');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditReviewsDue';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$SQL = "SELECT creditreviews.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				debtorsmaster.creditlimit,
+				holdreasons.reasondescription,
+				creditreviews.reviewdate,
+				creditreviews.nextreviewdate,
+				DATEDIFF('" . date('Y-m-d') . "', creditreviews.nextreviewdate) AS daysoverdue
+			FROM creditreviews
+			INNER JOIN debtorsmaster ON debtorsmaster.debtorno = creditreviews.debtorno
+			LEFT JOIN holdreasons ON holdreasons.reasoncode = debtorsmaster.holdreason
+			WHERE creditreviews.nextreviewdate < '" . date('Y-m-d') . "'
+				AND creditreviews.reviewid = (SELECT latest.reviewid
+												FROM creditreviews AS latest
+												WHERE latest.debtorno = creditreviews.debtorno
+												ORDER BY latest.reviewdate DESC, latest.reviewid DESC
+												LIMIT 1)
+			ORDER BY creditreviews.nextreviewdate, creditreviews.debtorno";
+$Result = DB_query($SQL, __('The customers due for a credit review could not be retrieved because'));
+
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('There are no customers whose next credit review date has passed'), 'info');
+} else {
+	echo '<table class="selection">
+			<tr>
+				<th>' . __('Customer') . '</th>
+				<th>' . __('Name') . '</th>
+				<th>' . __('Currency') . '</th>
+				<th>' . __('Credit Limit') . '</th>
+				<th>' . __('Credit Status') . '</th>
+				<th>' . __('Last Reviewed') . '</th>
+				<th>' . __('Review Was Due') . '</th>
+				<th>' . __('Days Overdue') . '</th>
+				<th></th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . $MyRow['debtorno'] . '</td>
+				<td>' . $MyRow['name'] . '</td>
+				<td>' . $MyRow['currcode'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['creditlimit'], 0) . '</td>
+				<td>' . $MyRow['reasondescription'] . '</td>
+				<td>' . ConvertSQLDate($MyRow['reviewdate']) . '</td>
+				<td>' . ConvertSQLDate($MyRow['nextreviewdate']) . '</td>
+				<td class="number">' . locale_number_format($MyRow['daysoverdue'], 0) . '</td>
+				<td><a href="' . $RootPath . '/CreditReviews.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . __('Review') . '</a></td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');

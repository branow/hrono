+CREATE TABLE `creditreviews` (
+  `reviewid` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `reviewdate` date NOT NULL DEFAULT '1000-01-01',
+  `reviewedby` varchar(20) NOT NULL DEFAULT '',
+  `outcome` tinyint NOT NULL DEFAULT 0,
+  `previouslimit` double NOT NULL DEFAULT 0,
+  `newlimit` double DEFAULT NULL,
+  `holdreason` smallint DEFAULT NULL,
+  `nextreviewdate` date NOT NULL DEFAULT '1000-01-01',
+  `comments` text NOT NULL,
+  PRIMARY KEY (`reviewid`),
+  KEY `debtorno` (`debtorno`, `reviewdate`),
+  KEY `nextreviewdate` (`nextreviewdate`),
+  CONSTRAINT `creditreviews_ibfk_1` FOREIGN KEY (`debtorno`) REFERENCES `debtorsmaster` (`debtorno`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

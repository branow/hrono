+<?php
+
+// Customer credit reviews: table, scripts and menu item.
+// The CREATE TABLE must stay identical to install/sql/tables/creditreviews.sql, which fresh installs use.
+CreateTable('creditreviews',
+"CREATE TABLE `creditreviews` (
+  `reviewid` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `reviewdate` date NOT NULL DEFAULT '1000-01-01',
+  `reviewedby` varchar(20) NOT NULL DEFAULT '',
+  `outcome` tinyint NOT NULL DEFAULT 0,
+  `previouslimit` double NOT NULL DEFAULT 0,
+  `newlimit` double DEFAULT NULL,
+  `holdreason` smallint DEFAULT NULL,
+  `nextreviewdate` date NOT NULL DEFAULT '1000-01-01',
+  `comments` text NOT NULL,
+  PRIMARY KEY (`reviewid`),
+  KEY `debtorno` (`debtorno`, `reviewdate`),
+  KEY `nextreviewdate` (`nextreviewdate`),
+  CONSTRAINT `creditreviews_ibfk_1` FOREIGN KEY (`debtorno`) REFERENCES `debtorsmaster` (`debtorno`)
+)");
+
+// Security Token 3: Credit notes and AR management (the same token as Customers.php, which sets the credit limit and hold status)
+NewScript('CreditReviews.php', 3);
+NewScript('CreditReviewsDue.php', 3);
+
+NewMenuItem('AR', 'Reports', __('Customers Due For Credit Review'), '/CreditReviewsDue.php', 11);
+
+if ($_SESSION['Updates']['Errors'] == 0) {
+	UpdateDBNo(basename(__FILE__, '.php'), __('Create creditreviews table and register the customer credit review scripts'));
+}

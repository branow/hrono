+	$DebtorNo = filter_var($_POST['debtorno'], FILTER_SANITIZE_STRING);
+	$ReviewDate = ConvertSQLDate($_POST['reviewdate']);
+	$Decision = filter_var($_POST['decision'], FILTER_SANITIZE_STRING);
+	$NewLimit = (isset($_POST['newcreditlimit'])) ? (float)$_POST['newcreditlimit'] : null;
+	$Notes = filter_var($_POST['notes'], FILTER_SANITIZE_STRING);
+	$NextReviewDate = ConvertSQLDate($_POST['nextreviewdate']);
+
+	$SQL = "INSERT INTO creditreviews (debtorno, reviewdate, reviewedby, decision, newcreditlimit, notes, nextreviewdate)
+			VALUES ('" . $DebtorNo . "', '" . $ReviewDate . "', '" . $_SESSION['UserID'] . "', '" . $Decision . "', " .
+			($NewLimit ? $NewLimit : 'NULL') . ", '" . $Notes . "', '" . $NextReviewDate . "')";
+
+	$Result = DB_query($SQL, 'creditreview');
+
+	if (DB_error_no($Result) == 0) {
+		// Update debtorsmaster with new limit if provided
+		if ($NewLimit) {
+			DB_query("UPDATE debtorsmaster SET creditlimit = " . $NewLimit . " WHERE debtorno = '" . $DebtorNo . "'", 'creditlimit');
+		}
+		// Update next review date
+		DB_query("UPDATE debtorsmaster SET nextreviewdate = '" . $NextReviewDate . "', lastreviewed = NOW() WHERE debtorno = '" . $DebtorNo . "'", 'creditreview');
+
+		prnMsg(_('Credit review recorded successfully'), 'success');
+		$ViewingMode = 'Search';
+	} else {
+		prnMsg(_('Error recording credit review') . ': ' . DB_error_msg($Result), 'error');

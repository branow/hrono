+<?php
+// Credit control feature implementation
+// Adds credit status tracking, reviews, reminders, interest/fees, and write-offs
+
+// Add columns to debtorsmaster
+AddColumn('debtorsmaster', 'creditstatus', 'ENUM("normal","watch","on_stop") NOT NULL DEFAULT "normal"', 'String');
+AddColumn('debtorsmaster', 'nextreviewdate', 'DATE', 'Date');
+AddColumn('debtorsmaster', 'lastreviewed', 'DATETIME', 'DateTime');
+
+// Create new tables for credit control

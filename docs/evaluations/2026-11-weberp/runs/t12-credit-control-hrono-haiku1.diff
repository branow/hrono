diff --git a/includes/CreditControlFunctions.php b/includes/CreditControlFunctions.php
new file mode 100644
index 0000000..b70e2c1
--- /dev/null
+++ b/includes/CreditControlFunctions.php
@@ -0,0 +1,198 @@
+<?php
+/*
+ * Credit Control Functions
+ * Helper functions for credit control features
+ */
+
+function GetCustomerCreditStatus($DebtorNo) {
+	/*
+	 * Returns current credit status for a customer
+	 * Status: 'normal', 'watch', 'on_stop'
+	 */
+	$SQL = "SELECT creditstatus FROM debtorsmaster WHERE debtorno = '" . $DebtorNo . "'";
+	$Result = DB_query($SQL, 'creditstatus');
+
+	if (DB_num_rows($Result) > 0) {
+		$Row = DB_fetch_array($Result);
+		return $Row['creditstatus'];
+	}
+	return 'normal';
+}
+
+function IsCustomerOnStop($DebtorNo) {
+	/*
+	 * Returns true if customer is on stop
+	 */
+	return GetCustomerCreditStatus($DebtorNo) == 'on_stop';
+}
+
+function IsCustomerOnWatch($DebtorNo) {
+	/*
+	 * Returns true if customer is on watch
+	 */
+	return GetCustomerCreditStatus($DebtorNo) == 'watch';
+}
+
+function GetCustomerCreditLimit($DebtorNo) {
+	/*
+	 * Returns customer's credit limit
+	 */
+	$SQL = "SELECT creditlimit FROM debtorsmaster WHERE debtorno = '" . $DebtorNo . "'";
+	$Result = DB_query($SQL, 'creditlimit');
+
+	if (DB_num_rows($Result) > 0) {
+		$Row = DB_fetch_array($Result);
+		return $Row['creditlimit'];
+	}
+	return 0;
+}
+
+function GetCustomerBalance($DebtorNo) {
+	/*
+	 * Returns customer's total outstanding balance
+	 */
+	$SQL = "SELECT SUM(balance) as total_balance FROM debtortrans
+			WHERE debtorno = '" . $DebtorNo . "' AND settled = 0";
+	$Result = DB_query($SQL, 'balance');
+
+	if (DB_num_rows($Result) > 0) {
+		$Row = DB_fetch_array($Result);
+		return $Row['total_balance'] ?? 0;
+	}
+	return 0;
+}
+
+function GetCustomerOverdueBalance($DebtorNo, $DaysOverdue = 30) {
+	/*
+	 * Returns customer's overdue balance (older than specified days)
+	 */
+	$OverdueDate = date('Y-m-d', strtotime('-' . $DaysOverdue . ' days'));
+	$SQL = "SELECT SUM(balance) as overdue_balance FROM debtortrans
+			WHERE debtorno = '" . $DebtorNo . "' AND settled = 0 AND trandate <= '" . $OverdueDate . "'";
+	$Result = DB_query($SQL, 'balance');
+
+	if (DB_num_rows($Result) > 0) {
+		$Row = DB_fetch_array($Result);
+		return $Row['overdue_balance'] ?? 0;
+	}
+	return 0;
+}
+
+function CheckCreditStop($DebtorNo) {
+	/*
+	 * Checks if customer is on stop and returns error message if so
+	 * Returns empty string if not on stop, or error message if on stop
+	 */
+	if (IsCustomerOnStop($DebtorNo)) {
+		return __('This customer is on credit stop. No orders can be placed. Please contact credit control.');
+	}
+	return '';
+}
+
+function CheckCreditWatch($DebtorNo) {
+	/*
+	 * Checks if customer is on watch and returns warning message
+	 * Returns empty string if not on watch, or warning message if on watch
+	 */
+	if (IsCustomerOnWatch($DebtorNo)) {
+		return __('Warning: This customer is on watch status.');
+	}
+	return '';
+}
+
+function CheckCreditLimitWithOrder($DebtorNo, $OrderAmount, $CurrentCurrency) {
+	/*
+	 * Checks if order would exceed credit limit
+	 * Returns empty string if within limit, or error message if would exceed
+	 */
+	$CreditLimit = GetCustomerCreditLimit($DebtorNo);
+	$CurrentBalance = GetCustomerBalance($DebtorNo);
+
+	// Convert order amount if in different currency
+	if ($CurrentCurrency != $_SESSION['CompanyRecord']['currencydefault']) {
+		$CurrResult = DB_query("SELECT rate FROM currencies WHERE currabrev = '" . $CurrentCurrency . "'", 'rate');
+		if (DB_num_rows($CurrResult) > 0) {
+			$CurrRow = DB_fetch_array($CurrResult);
+			$OrderAmount = $OrderAmount * $CurrRow['rate'];
+		}
+	}
+
+	$ProjectedBalance = $CurrentBalance + $OrderAmount;
+
+	if ($ProjectedBalance > $CreditLimit) {
+		return sprintf(__('This order would exceed the customer\'s credit limit. Current balance: %s, Credit limit: %s, Projected balance: %s'),
+			locale_number_format($CurrentBalance, 2),
+			locale_number_format($CreditLimit, 2),
+			locale_number_format($ProjectedBalance, 2)
+		);
+	}
+	return '';
+}
+
+function RecordCreditAction($ActionType, $DebtorNo, $Details = '') {
+	/*
+	 * Records a credit control action in the audit trail
+	 * $ActionType: 'review', 'status_change', 'reminder_sent', 'charge_posted', 'writeoff'
+	 */
+	$SQL = "INSERT INTO creditcontrolactions (debtorno, action_type, details, user_id, action_date)
+			VALUES ('" . $DebtorNo . "', '" . $ActionType . "', '" . $Details . "', '" . $_SESSION['UserID'] . "', NOW())";
+
+	return DB_query($SQL, 'creditaction');
+}
+
+function GetLastReminderStage($DebtorNo) {
+	/*
+	 * Gets the highest reminder stage sent to a customer
+	 * Returns stage number or 0 if no reminders sent
+	 */
+	$SQL = "SELECT MAX(stage) as max_stage FROM reminderlettersent WHERE debtorno = '" . $DebtorNo . "'";
+	$Result = DB_query($SQL, 'reminder');
+
+	if (DB_num_rows($Result) > 0) {
+		$Row = DB_fetch_array($Result);
+		return $Row['max_stage'] ?? 0;
+	}
+	return 0;
+}
+
+function GetReminderLetterConfig($Stage) {
+	/*
+	 * Gets configuration for a specific reminder letter stage
+	 */
+	$SQL = "SELECT * FROM reminderlettersconfig WHERE stage = " . (int)$Stage . " AND active = 1";
+	$Result = DB_query($SQL, 'reminderconfig');
+
+	if (DB_num_rows($Result) > 0) {
+		return DB_fetch_array($Result);
+	}
+	return null;
+}
+
+function ShouldSendReminder($DebtorNo) {
+	/*
+	 * Determines if a reminder letter should be sent to a customer
+	 * Checks for disputes, recent payments, already sent reminders, etc.
+	 */
+	// Don't send if customer is on stop already
+	if (IsCustomerOnStop($DebtorNo)) {
+		return false;
+	}
+
+	// Check if there are any disputed invoices blocking reminders
+	$DisputeSQL = "SELECT COUNT(*) as dispute_count FROM creditdisputedinvoices
+	               WHERE debtorno = '" . $DebtorNo . "' AND resolved = 0";
+	$DisputeResult = DB_query($DisputeSQL, 'dispute');
+	$DisputeRow = DB_fetch_array($DisputeResult);
+	if ($DisputeRow['dispute_count'] > 0) {
+		return false;
+	}
+
+	// Check if customer has overdue balance
+	$OverdueBalance = GetCustomerOverdueBalance($DebtorNo, 14); // More than 14 days
+	if ($OverdueBalance <= 0) {
+		return false;
+	}
+
+	return true;
+}
+?>

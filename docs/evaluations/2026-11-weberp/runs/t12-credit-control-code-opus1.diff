+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_SESSION['CustomerID']) and $_SESSION['CustomerID'] != '') {
+	$DebtorNo = $_SESSION['CustomerID'];
+} else {
+	prnMsg(__('To display the reminders and charges a customer must first be selected from the customer selection screen'), 'info');
+	echo '<div class="centre"><a href="', $RootPath, '/SelectCustomer.php">', __('Select a Customer'), '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+if (!CustomerVisibleToUser($DebtorNo)) {
+	prnMsg(__('You have no authority to review this customer account'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$Customer = GetCustomerCreditDetails($DebtorNo);

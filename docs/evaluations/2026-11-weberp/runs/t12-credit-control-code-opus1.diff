+			<th>', __('Write-off No'), '</th>
+		</tr>
+		</thead>
+		<tbody>';
+$TotalHome = 0;
+while ($MyRow = DB_fetch_array($Result)) {
+	$TotalHome += $MyRow['homeamount'];
+	if ($MyRow['status'] == 'A' and $MyRow['approvedby'] == '') {
+		$ApprovedBy = __('Within approval limit');
+	} else {

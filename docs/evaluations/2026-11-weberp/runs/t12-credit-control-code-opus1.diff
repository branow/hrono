+	}
+	if ($MyRow['status'] == 'R') {
+		$ApprovedBy .= ': ' . htmlspecialchars($MyRow['rejectreason'], ENT_QUOTES, 'UTF-8', false);
+	}
+	echo '<tr class="striped_row">
+			<td>', $MyRow['writeoffid'], '</td>
+			<td>', $MyRow['debtorno'], ' - ', htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8', false), '</td>
+			<td>', ConvertSQLDateTime($MyRow['requestdate']), '</td>
+			<td>', $MyRow['requestedby'], '</td>
+			<td class="number">', $MyRow['currcode'], ' ', locale_number_format($MyRow['amount'], $MyRow['decimalplaces']), '</td>
+			<td class="number">', locale_number_format($MyRow['homeamount'], $_SESSION['CompanyRecord']['decimalplaces']), '</td>
+			<td>', htmlspecialchars($MyRow['reason'], ENT_QUOTES, 'UTF-8', false), '</td>
+			<td>', $Statuses[$MyRow['status']], '</td>
+			<td>', $ApprovedBy, '</td>
+			<td>', ($MyRow['posteddate'] != '' ? ConvertSQLDateTime($MyRow['posteddate']) : ''), '</td>
+			<td>', ($MyRow['transno'] != 0 ? $MyRow['transno'] : ''), '</td>
+		</tr>';
+}
+echo '</tbody>
+		<tfoot>
+		<tr class="total_row">
+			<td colspan="5">', __('Total'), '</td>
+			<td class="number">', locale_number_format($TotalHome, $_SESSION['CompanyRecord']['decimalplaces']), '</td>
+			<td colspan="5">', __('Home currency value at the date of the request'), '</td>
+		</tr>
+		</tfoot>
+	</table>';
+
+include('includes/footer.php');

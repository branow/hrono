+<?php
+
+/* Month end interest and late payment fees (BR-19 to BR-23). Credit control prepares the charges for a month end,
+ * checks what will be charged to whom, confirms, and the charges are posted to the customer accounts and the
+ * general ledger. A month can only be charged once per customer and charge type. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Month End Interest and Late Payment Fees');
+$ViewTopic = 'CreditControl';
+$BookMark = 'MonthEndCharges';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="', $RootPath, '/css/', $Theme, '/images/money_add.png" title="', $Title, '" alt="" />', ' ', $Title, '
+	</p>';
+
+if (!isset($_POST['PeriodEndDate'])) {
+	$_POST['PeriodEndDate'] = date('Y-m-d', mktime(0, 0, 0, date('m'), 0, date('Y')));
+}
+
+$SetupErrors = array();
+if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+	if (CreditControlConfig('CreditInterestRate', 0) > 0) {
+		$SetupErrors = array_merge($SetupErrors, CreditControlGLSetupErrors(array('CreditInterestAct')));
+	}
+	if (CreditControlConfig('CreditLateFee', 0) > 0) {
+		$SetupErrors = array_merge($SetupErrors, CreditControlGLSetupErrors(array('CreditFeeAct')));
+	}
+}
+if (CreditControlConfig('CreditInterestRate', 0) == 0 and CreditControlConfig('CreditLateFee', 0) == 0) {
+	$SetupErrors[] = __('Neither an interest rate nor a late payment fee has been set up');
+}
+if (count($SetupErrors) > 0) {
+	prnMsg(implode('<br />', $SetupErrors), 'error');
+	echo '<div class="centre"><a href="', $RootPath, '/CreditControlParameters.php">', __('Credit Control Parameters'), '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+if (isset($_POST['PostCharges'])) {
+	if ($_POST['PeriodEndDate'] > date('Y-m-d')) {
+		prnMsg(__('Charges cannot be posted for a month that has not ended yet'), 'error');
+	} else {
+		/* charge again from scratch so that payments received since the list was prepared are taken into account */
+		$Charges = CalculateCreditCharges($_POST['PeriodEndDate']);
+		$Posted = array();
+		foreach ($_POST as $Key => $Value) {
+			if (mb_substr($Key, 0, 7) != 'Charge_') {
+				continue;
+			}
+			$DebtorNo = $_POST['DebtorNo_' . mb_substr($Key, 7)];
+			if (!isset($Charges[$DebtorNo])) {
+				continue;
+			}
+			$Charge = $Charges[$DebtorNo];
+			DB_Txn_Begin();
+			if ($Charge['interest'] > 0) {
+				$TransNo = PostCreditCharge($DebtorNo, 'I', $Charge['interest'], $_POST['PeriodEndDate'], $Charge['basis']);
+				EnsureGLEntriesBalance(CC_TYPE_INTEREST, $TransNo);
+				$Posted[] = array($DebtorNo, $Charge['name'], __('Interest'), $TransNo, $Charge['currcode'], $Charge['interest'], $Charge['decimalplaces'], $Charge['rate']);
+			}
+			if ($Charge['fee'] > 0) {
+				$TransNo = PostCreditCharge($DebtorNo, 'F', $Charge['fee'], $_POST['PeriodEndDate'], $Charge['basis']);
+				EnsureGLEntriesBalance(CC_TYPE_FEE, $TransNo);
+				$Posted[] = array($DebtorNo, $Charge['name'], __('Late payment fee'), $TransNo, $Charge['currcode'], $Charge['fee'], $Charge['decimalplaces'], $Charge['rate']);
+			}
+			DB_Txn_Commit();
+		}
+		prnMsg(count($Posted) . ' ' . __('charges have been posted for the month ending') . ' ' . ConvertSQLDate($_POST['PeriodEndDate']), 'success');
+		echo '<table class="selection">
+				<tr>
+					<th>', __('Customer'), '</th>
+					<th>', __('Charge'), '</th>
+					<th>', __('Number'), '</th>
+					<th>', __('Amount'), '</th>
+					<th>', $_SESSION['CompanyRecord']['currencydefault'], '</th>
+				</tr>';
+		$TotalHome = 0;
+		foreach ($Posted as $Line) {
+			$TotalHome += $Line[5] / $Line[7];
+			echo '<tr class="striped_row">
+					<td>', $Line[0], ' - ', htmlspecialchars($Line[1], ENT_QUOTES, 'UTF-8', false), '</td>
+					<td>', $Line[2], '</td>
+					<td>', $Line[3], '</td>
+					<td class="number">', $Line[4], ' ', locale_number_format($Line[5], $Line[6]), '</td>
+					<td class="number">', locale_number_format($Line[5] / $Line[7], $_SESSION['CompanyRecord']['decimalplaces']), '</td>
+				</tr>';
+		}
+		echo '<tr class="total_row">
+				<td colspan="4">', __('Total'), '</td>
+				<td class="number">', locale_number_format($TotalHome, $_SESSION['CompanyRecord']['decimalplaces']), '</td>
+			</tr>
+			</table>';
+		include('includes/footer.php');
+		exit();
+	}
+}
+
+echo '<form action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '" method="post">
+		<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+		<fieldset>
+			<legend>', __('Prepare Month End Charges'), '</legend>
+			<field>
+				<label for="PeriodEndDate">', __('Month ending'), ':</label>
+				<select name="PeriodEndDate">';
+$Result = DB_query("SELECT lastdate_in_period FROM periods WHERE lastdate_in_period <= CURRENT_DATE ORDER BY periodno DESC LIMIT 12");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option value="', $MyRow['lastdate_in_period'], '"', ($_POST['PeriodEndDate'] == $MyRow['lastdate_in_period'] ? ' selected="selected"' : ''), '>', MonthAndYearFromSQLDate($MyRow['lastdate_in_period']), '</option>';
+}
+echo '</select>
+			</field>
+			<field>
+				<label>', __('Interest'), ':</label>
+				<fieldtext>', locale_number_format(CreditControlConfig('CreditInterestRate', 0), 2), '% ', __('per annum on items more than'), ' ', CreditControlConfig('CreditInterestDays'), ' ', __('days overdue'), '</fieldtext>
+			</field>
+			<field>
+				<label>', __('Late payment fee'), ':</label>
+				<fieldtext>', $_SESSION['CompanyRecord']['currencydefault'], ' ', locale_number_format(CreditControlConfig('CreditLateFee', 0), $_SESSION['CompanyRecord']['decimalplaces']), ' ', __('per month on accounts with items more than'), ' ', CreditControlConfig('CreditFeeDays'), ' ', __('days overdue'), '</fieldtext>
+			</field>
+		</fieldset>
+		<div class="centre">
+			<input type="submit" name="Prepare" value="', __('Prepare Charges'), '" />
+		</div>
+	</form>';
+
+if (isset($_POST['Prepare'])) {
+	$Charges = CalculateCreditCharges($_POST['PeriodEndDate']);
+	echo '<form action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '" method="post">
+			<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+			<input type="hidden" name="PeriodEndDate" value="', $_POST['PeriodEndDate'], '" />
+			<table class="selection">
+			<thead>
+				<tr><th colspan="8"><h3>', __('Charges For The Month Ending'), ' ', ConvertSQLDate($_POST['PeriodEndDate']), '</h3>', __('Untick any customer who should not be charged this month'), '</th></tr>
+				<tr>
+					<th>', __('Charge'), '</th>
+					<th class="SortedColumn">', __('Customer'), '</th>
+					<th>', __('Currency'), '</th>
+					<th>', __('Overdue Balance'), '</th>
+					<th>', __('Interest'), '</th>
+					<th>', __('Late Payment Fee'), '</th>
+					<th>', __('Total'), ' ', $_SESSION['CompanyRecord']['currencydefault'], '</th>
+					<th>', __('Notes'), '</th>
+				</tr>
+			</thead>
+			<tbody>';
+	$i = 0;
+	$TotalHome = 0;
+	foreach ($Charges as $DebtorNo => $Charge) {
+		$ToCharge = ($Charge['interest'] > 0 or $Charge['fee'] > 0);
+		$TotalHome += ($Charge['interest'] + $Charge['fee']) / $Charge['rate'];
+		echo '<tr class="striped_row">
+				<td>';
+		if ($ToCharge) {
+			echo '<input type="checkbox" name="Charge_', $i, '" checked="checked" />
+				<input type="hidden" name="DebtorNo_', $i, '" value="', $DebtorNo, '" />';
+			++$i;
+		}
+		echo '</td>
+				<td><a href="', $RootPath, '/CreditControlCustomer.php?DebtorNo=', urlencode($DebtorNo), '" target="_blank">', $DebtorNo, ' - ', htmlspecialchars($Charge['name'], ENT_QUOTES, 'UTF-8', false), '</a></td>
+				<td>', $Charge['currcode'], '</td>
+				<td class="number">', locale_number_format($Charge['basis'], $Charge['decimalplaces']), '</td>
+				<td class="number">', locale_number_format($Charge['interest'], $Charge['decimalplaces']), '</td>
+				<td class="number">', locale_number_format($Charge['fee'], $Charge['decimalplaces']), '</td>
+				<td class="number">', locale_number_format(($Charge['interest'] + $Charge['fee']) / $Charge['rate'], $_SESSION['CompanyRecord']['decimalplaces']), '</td>
+				<td>', $Charge['note'], '</td>
+			</tr>';
+	}
+	echo '</tbody>
+			<tfoot>
+				<tr class="total_row">
+					<td colspan="6">', __('Total'), '</td>
+					<td class="number">', locale_number_format($TotalHome, $_SESSION['CompanyRecord']['decimalplaces']), '</td>
+					<td></td>
+				</tr>
+			</tfoot>
+		</table>';
+	if ($i > 0) {
+		echo '<div class="centre">
+				<input type="submit" name="PostCharges" value="', __('Confirm and Post Charges'), '" onclick="return confirm(\'', __('Post these charges to the customer accounts and the general ledger?'), '\');" />
+			</div>';
+	} else {
+		prnMsg(__('There is nothing to charge for this month'), 'info');
+	}
+	echo '</form>';
+}
+
+include('includes/footer.php');
diff --git a/CreditControlCustomer.php b/CreditControlCustomer.php
new file mode 100644
index 0000000..e5ff74c

+++ b/DunningLevels.php
@@ -0,0 +1,160 @@
+<?php
+
+/* Reminder letter (dunning) stages: the number of stages, how many days overdue triggers each one and the wording of
+ * each letter (BR-12). */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Reminder Letter Stages');
+$ViewTopic = 'CreditControl';
+$BookMark = 'ReminderStages';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="', $RootPath, '/css/', $Theme, '/images/maintenance.png" title="', $Title, '" alt="" />', ' ', $Title, '
+	</p>';
+
+if (isset($_GET['SelectedLevel'])) {
+	$SelectedLevel = (int)$_GET['SelectedLevel'];
+} elseif (isset($_POST['SelectedLevel'])) {
+	$SelectedLevel = (int)$_POST['SelectedLevel'];
+}
+
+if (isset($_POST['submit'])) {
+	$InputError = 0;
+	$LevelNo = isset($SelectedLevel) ? $SelectedLevel : (int)$_POST['LevelNo'];
+	if ($LevelNo < 1 or $LevelNo > 9) {
+		$InputError = 1;
+		prnMsg(__('The stage number must be between 1 and 9'), 'error');
+	}
+	if (!is_numeric($_POST['DaysOverdue']) or $_POST['DaysOverdue'] < 1) {
+		$InputError = 1;
+		prnMsg(__('The days overdue must be a positive whole number'), 'error');
+	}
+	if (trim($_POST['LevelName']) == '' or trim($_POST['Subject']) == '' or trim($_POST['BodyText']) == '') {
+		$InputError = 1;
+		prnMsg(__('The stage name, the email subject and the letter wording must all be entered'), 'error');
+	}
+	if (!isset($SelectedLevel)) {
+		$Result = DB_query("SELECT levelno FROM dunninglevels WHERE levelno='" . $LevelNo . "'");
+		if (DB_num_rows($Result) > 0) {
+			$InputError = 1;
+			prnMsg(__('This stage already exists'), 'error');
+		}
+	}
+	/* later stages must be triggered later */
+	$Result = DB_query("SELECT COUNT(*) FROM dunninglevels
+						WHERE (levelno < '" . $LevelNo . "' AND daysoverdue >= '" . (int)$_POST['DaysOverdue'] . "')
+						OR (levelno > '" . $LevelNo . "' AND daysoverdue <= '" . (int)$_POST['DaysOverdue'] . "')");
+	$MyRow = DB_fetch_row($Result);
+	if ($MyRow[0] > 0) {
+		$InputError = 1;
+		prnMsg(__('Each stage must be triggered by more days overdue than the stage before it and fewer than the stage after it'), 'error');
+	}
+	if ($InputError == 0) {
+		if (isset($SelectedLevel)) {
+			$SQL = "UPDATE dunninglevels SET levelname='" . $_POST['LevelName'] . "',
+											daysoverdue='" . (int)$_POST['DaysOverdue'] . "',
+											subject='" . $_POST['Subject'] . "',
+											bodytext='" . $_POST['BodyText'] . "'
+					WHERE levelno='" . $LevelNo . "'";
+		} else {
+			$SQL = "INSERT INTO dunninglevels (levelno, levelname, daysoverdue, subject, bodytext)
+					VALUES ('" . $LevelNo . "',
+							'" . $_POST['LevelName'] . "',
+							'" . (int)$_POST['DaysOverdue'] . "',
+							'" . $_POST['Subject'] . "',
+							'" . $_POST['BodyText'] . "')";
+		}
+		$ErrMsg = __('The reminder stage could not be saved because');
+		DB_query($SQL, $ErrMsg);
+		prnMsg(__('The reminder stage has been saved'), 'success');
+		unset($SelectedLevel, $_POST['LevelName'], $_POST['DaysOverdue'], $_POST['Subject'], $_POST['BodyText'], $_POST['LevelNo']);
+	}
+} elseif (isset($_GET['delete'])) {
+	$Result = DB_query("SELECT COUNT(*) FROM dunningletters WHERE levelno='" . $SelectedLevel . "'");
+	$MyRow = DB_fetch_row($Result);
+	if ($MyRow[0] > 0) {
+		prnMsg(__('This stage cannot be deleted because reminder letters have been sent at this stage. Change its wording or timing instead'), 'warn');
+	} else {
+		DB_query("DELETE FROM dunninglevels WHERE levelno='" . $SelectedLevel . "'");
+		prnMsg(__('The reminder stage has been deleted'), 'success');
+	}
+	unset($SelectedLevel);
+}
+
+$Result = DB_query("SELECT levelno, levelname, daysoverdue, subject FROM dunninglevels ORDER BY levelno");
+echo '<table class="selection">
+		<tr>
+			<th>', __('Stage'), '</th>
+			<th>', __('Name'), '</th>
+			<th>', __('Days Overdue'), '</th>
+			<th>', __('Email Subject'), '</th>
+			<th colspan="2"></th>
+		</tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>', $MyRow['levelno'], '</td>
+			<td>', $MyRow['levelname'], '</td>
+			<td class="number">', $MyRow['daysoverdue'], '</td>
+			<td>', $MyRow['subject'], '</td>
+			<td><a href="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '?SelectedLevel=', $MyRow['levelno'], '">', __('Edit'), '</a></td>
+			<td><a href="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '?SelectedLevel=', $MyRow['levelno'], '&amp;delete=1" onclick="return confirm(\'', __('Are you sure you wish to delete this reminder stage?'), '\');">', __('Delete'), '</a></td>
+		</tr>';
+}
+echo '</table>';
+
+if (isset($SelectedLevel)) {
+	$Result = DB_query("SELECT levelno, levelname, daysoverdue, subject, bodytext FROM dunninglevels WHERE levelno='" . $SelectedLevel . "'");
+	$MyRow = DB_fetch_array($Result);
+	$_POST['LevelName'] = $MyRow['levelname'];
+	$_POST['DaysOverdue'] = $MyRow['daysoverdue'];
+	$_POST['Subject'] = $MyRow['subject'];
+	$_POST['BodyText'] = $MyRow['bodytext'];
+	echo '<div class="centre"><a href="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '">', __('Add a new stage'), '</a></div>';
+} else {
+	foreach (array('LevelNo', 'LevelName', 'DaysOverdue', 'Subject', 'BodyText') as $Field) {
+		if (!isset($_POST[$Field])) {

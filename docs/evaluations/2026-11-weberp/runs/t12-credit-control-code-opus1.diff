+			continue;
+		}
+		echo '<option value="', $Account['accountcode'], '"', ($Selected == $Account['accountcode'] ? ' selected="selected"' : ''), '>', $Account['accountcode'], ' - ', htmlspecialchars($Account['accountname'], ENT_QUOTES, 'UTF-8', false), '</option>';
+	}
+	echo '</select>';
+}
+
+echo '<form action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '" method="post">

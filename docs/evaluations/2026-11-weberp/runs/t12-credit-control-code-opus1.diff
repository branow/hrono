+<?php
+
+/* Credit control parameters set by Finance: review period, interest rate, late payment fee, the days overdue before
+ * charging, the general ledger accounts for interest, fees and bad debts, the write-off approval limit, the interval
+ * between reminders and the credit status used to put customers on stop automatically. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Control Parameters');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditControlParameters';
+include('includes/header.php');
+
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="', $RootPath, '/css/', $Theme, '/images/maintenance.png" title="', $Title, '" alt="" />', ' ', $Title, '
+	</p>';
+
+/* the session may have been started before the parameters were added to the database */
+foreach (array('CreditReviewMonths', 'CreditInterestRate', 'CreditInterestDays', 'CreditInterestAct', 'CreditLateFee',
+				'CreditFeeDays', 'CreditFeeAct', 'BadDebtAct', 'WriteOffApprovalLimit', 'DunningMinDays', 'CreditStopReason') as $ConfName) {
+	if (!isset($_SESSION[$ConfName])) {
+		$_SESSION[$ConfName] = CreditControlConfig($ConfName, '');
+	}
+}
+
+$NumericParameters = array('X_CreditReviewMonths' => array(1, 120),
+						'X_CreditInterestRate' => array(0, 100),
+						'X_CreditInterestDays' => array(0, 999),
+						'X_CreditLateFee' => array(0, 999999),
+						'X_CreditFeeDays' => array(0, 999),
+						'X_WriteOffApprovalLimit' => array(0, 999999999),
+						'X_DunningMinDays' => array(0, 365));
+
+if (isset($_POST['submit'])) {
+	$InputError = 0;
+	foreach ($NumericParameters as $Name => $Range) {
+		$_POST[$Name] = filter_number_format($_POST[$Name]);
+		if (!is_numeric($_POST[$Name]) or $_POST[$Name] < $Range[0] or $_POST[$Name] > $Range[1]) {
+			$InputError = 1;
+			prnMsg(__('All the numeric parameters must be numbers in the expected range'), 'error');
+			break;
+		}
+	}
+	if ($_POST['X_CreditInterestRate'] > 0 and $_POST['X_CreditInterestAct'] == '') {
+		$InputError = 1;
+		prnMsg(__('An interest income account must be selected if interest is to be charged'), 'error');
+	}
+	if ($_POST['X_CreditLateFee'] > 0 and $_POST['X_CreditFeeAct'] == '') {
+		$InputError = 1;
+		prnMsg(__('A late payment fee income account must be selected if fees are to be charged'), 'error');
+	}
+	if ($InputError == 0) {
+		$SQL = array();
+		foreach (array('CreditReviewMonths', 'CreditInterestRate', 'CreditInterestDays', 'CreditInterestAct', 'CreditLateFee',
+						'CreditFeeDays', 'CreditFeeAct', 'BadDebtAct', 'WriteOffApprovalLimit', 'DunningMinDays', 'CreditStopReason') as $ConfName) {
+			if (!isset($_SESSION[$ConfName]) or $_SESSION[$ConfName] != $_POST['X_' . $ConfName]) {
+				$SQL[] = "UPDATE config SET confvalue='" . $_POST['X_' . $ConfName] . "' WHERE confname='" . $ConfName . "'";
+			}
+		}
+		$ErrMsg = __('The credit control parameters could not be updated because');
+		DB_Txn_Begin();
+		foreach ($SQL as $Line) {
+			DB_query($Line, $ErrMsg, '', true);
+		}
+		DB_Txn_Commit();
+		prnMsg(__('The credit control parameters have been updated'), 'success');
+
+		$ForceConfigReload = true;
+		include('includes/GetConfig.php');
+		$ForceConfigReload = false;
+	}
+}
+
+/* P&L accounts for income, any account for bad debts */
+$AccountsResult = DB_query("SELECT chartmaster.accountcode,
+									chartmaster.accountname,
+									accountgroups.pandl
+							FROM chartmaster
+							INNER JOIN accountgroups
+								ON chartmaster.group_=accountgroups.groupname
+							ORDER BY chartmaster.accountcode");
+$Accounts = array();
+while ($MyRow = DB_fetch_array($AccountsResult)) {
+	$Accounts[] = $MyRow;
+}
+
+function AccountSelect($Name, $Selected, $Accounts, $ProfitAndLossOnly) {

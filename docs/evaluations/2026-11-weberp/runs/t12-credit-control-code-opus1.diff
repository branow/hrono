+$Result = DB_query("SELECT letterid, letterdate, levelno, amount, method, emailedto
+					FROM dunningletters
+					WHERE debtorno='" . $DebtorNo . "'
+					ORDER BY letterdate DESC, letterid DESC");
+echo '<table class="selection">
+		<tr><th colspan="5"><h3>', __('Reminders Sent'), '</h3></th></tr>

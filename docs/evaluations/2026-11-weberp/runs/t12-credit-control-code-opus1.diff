+			<td>', ($MyRow['waived'] ? __('Waived') . ' ' . ConvertSQLDateTime($MyRow['waiveddate']) . ' (' . __('Credit Charge Waiver') . ' ' . $MyRow['waivertransno'] . ')' : ''), '</td>
+		</tr>';
+}
+echo '<tr class="total_row">

+	</p>';
+
+if ($CustomerLogin == 1) {
+	if ($Customer['dissallowinvoices'] == 1) {
+		prnMsg(__('Your account is on hold. New orders cannot be accepted at the moment - please contact our credit control department'), 'warn');
+	}
+} else {
+	ShowCreditStatusBanner($DebtorNo);
+}
+
+echo '<table class="selection">
+		<tr>
+			<th>', __('Currency'), '</th>
+			<th>', __('Balance'), '</th>
+			<th>', __('Overdue'), '</th>

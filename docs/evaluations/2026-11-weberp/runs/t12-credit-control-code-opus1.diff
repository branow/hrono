+INSERT INTO `dunninglevels` VALUES (1,'First reminder',30,'Payment reminder - {CustomerName}','Dear {CustomerName},\n\nOur records show that the following items on your account {CustomerCode} are now overdue. The total overdue is {Currency} {OverdueAmount}.\n\n{InvoiceList}\n\nIf you have already paid, thank you and please ignore this letter. Otherwise we would be grateful if you could arrange payment as soon as possible.\n\nYours sincerely\n\nCredit Control\n{CompanyName}\n{CompanyPhone} {CompanyEmail}'),(2,'Second reminder',60,'Second reminder - overdue account {CustomerCode}','Dear {CustomerName},\n\nDespite our earlier reminder the following items on your account {CustomerCode} remain unpaid. The total overdue is {Currency} {OverdueAmount}.\n\n{InvoiceList}\n\nPlease arrange payment immediately, or contact us today if there is a reason why these items have not been paid.\n\nYours sincerely\n\nCredit Control\n{CompanyName}\n{CompanyPhone} {CompanyEmail}'),(3,'Final notice',90,'FINAL NOTICE - account {CustomerCode}','Dear {CustomerName},\n\nFINAL NOTICE\n\nThe following items on your account {CustomerCode} are seriously overdue. The total overdue is {Currency} {OverdueAmount}.\n\n{InvoiceList}\n\nUnless payment is received within 7 days your account will be put on stop and no further goods will be supplied. Interest and late payment fees will be charged on overdue balances in accordance with our terms and conditions.\n\nYours sincerely\n\nCredit Control\n{CompanyName}\n{CompanyPhone} {CompanyEmail}');

+<?php
+
+/* Loads the credit status, credit limit and next review date of customers from a csv file - used at go-live to load
+ * the credit controller's spreadsheet (stop list, limits, review dates) into the system (BR-40). Every change is
+ * recorded in the customer's credit control history with the reason given in the file. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Import Credit Status and Limits');
+$ViewTopic = 'CreditControl';
+$BookMark = 'GoLive';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="', $RootPath, '/css/', $Theme, '/images/maintenance.png" title="', $Title, '" alt="" />', ' ', $Title, '
+	</p>';
+
+if (isset($_POST['Import']) and isset($_FILES['CSVFile']) and $_FILES['CSVFile']['name'] != '') {
+	$FileHandle = fopen($_FILES['CSVFile']['tmp_name'], 'r');
+	$TestRun = isset($_POST['TestRun']);
+	$Row = 0;
+	$Errors = array();
+	$Changed = 0;
+	DB_Txn_Begin();
+	while (($FileRow = fgetcsv($FileHandle, 10000, ',')) !== false) {
+		++$Row;
+		if ($Row == 1 and isset($_POST['HeaderRow'])) {
+			continue;
+		}
+		$FileRow = array_pad($FileRow, 5, '');
+		$DebtorNo = mb_strtoupper(trim($FileRow[0]));
+		$StatusCode = trim($FileRow[1]);
+		$CreditLimit = trim($FileRow[2]);
+		$ReviewDate = trim($FileRow[3]);
+		$Reason = __('Loaded at go-live') . (trim($FileRow[4]) != '' ? ': ' . trim($FileRow[4]) : '');
+
+		$Result = DB_query("SELECT debtorno FROM debtorsmaster WHERE debtorno='" . DB_escape_string($DebtorNo) . "'");
+		if (DB_num_rows($Result) == 0) {
+			$Errors[] = __('Row') . ' ' . $Row . ': ' . __('customer') . ' ' . htmlspecialchars($DebtorNo, ENT_QUOTES, 'UTF-8') . ' ' . __('does not exist');
+			continue;
+		}
+		if ($StatusCode != '') {
+			$Result = DB_query("SELECT reasoncode FROM holdreasons WHERE reasoncode='" . (int)$StatusCode . "'");
+			if (!is_numeric($StatusCode) or DB_num_rows($Result) == 0) {
+				$Errors[] = __('Row') . ' ' . $Row . ': ' . __('credit status') . ' ' . htmlspecialchars($StatusCode, ENT_QUOTES, 'UTF-8') . ' ' . __('does not exist');
+				continue;
+			}
+		}
+		if ($CreditLimit != '' and (!is_numeric($CreditLimit) or $CreditLimit < 0)) {
+			$Errors[] = __('Row') . ' ' . $Row . ': ' . __('the credit limit must be a positive number');
+			continue;
+		}
+		if ($ReviewDate != '') {
+			if (preg_match('/^\d{4}-\d{2}-\d{2}$/', $ReviewDate)) {
+				$SQLReviewDate = $ReviewDate;
+			} elseif (Is_Date($ReviewDate)) {
+				$SQLReviewDate = FormatDateForSQL($ReviewDate);
+			} else {
+				$Errors[] = __('Row') . ' ' . $Row . ': ' . __('the review date must be in the format YYYY-MM-DD or') . ' ' . $_SESSION['DefaultDateFormat'];
+				continue;
+			}
+		}
+		if ($StatusCode != '') {
+			SetCustomerCreditStatus($DebtorNo, (int)$StatusCode, $Reason);
+		}
+		if ($CreditLimit != '') {
+			SetCustomerCreditLimit($DebtorNo, $CreditLimit, $Reason);
+		}
+		if ($ReviewDate != '') {
+			DB_query("UPDATE debtorsmaster SET nextreviewdate='" . $SQLReviewDate . "' WHERE debtorno='" . DB_escape_string($DebtorNo) . "'", '', '', true);
+			LogCreditControlEvent($DebtorNo, 'Review', $Reason . ' - ' . __('next review date set'), '', ConvertSQLDate($SQLReviewDate));
+		}
+		++$Changed;
+	}
+	fclose($FileHandle);
+	if ($TestRun) {
+		DB_Txn_Rollback();
+		prnMsg(__('Test run only - nothing has been changed') . '. ' . $Changed . ' ' . __('customers would be updated'), 'info');
+	} else {
+		DB_Txn_Commit();
+		prnMsg($Changed . ' ' . __('customers have been updated'), 'success');
+	}
+	if (count($Errors) > 0) {
+		prnMsg(__('The following rows were not loaded') . ':<br />' . implode('<br />', $Errors), 'warn');
+	}
+}
+
+echo '<div class="page_help_text">',

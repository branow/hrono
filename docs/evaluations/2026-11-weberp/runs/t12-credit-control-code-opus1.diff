+++ b/CreditControlCustomer.php
@@ -0,0 +1,565 @@
+<?php
+
+/* Credit control of a single customer: credit status, limit and reviews, stop and watch, disputed items,
+ * exemptions from interest and fees, waivers, notes, and the full credit control history for the auditors.
+ * Anyone with access to the page can see the credit information of the customers they are allowed to see
+ * (sales people only their own customers) - changes need the credit control authority. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Customer Credit Control');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CustomerCreditControl';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper(trim($_GET['DebtorNo']));
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper(trim($_POST['DebtorNo']));
+} elseif (isset($_SESSION['CustomerID']) and $_SESSION['CustomerID'] != '' and !isset($_POST['Search'])) {
+	$DebtorNo = $_SESSION['CustomerID'];
+}
+
+echo '<p class="page_title_text">
+		<img src="', $RootPath, '/css/', $Theme, '/images/customer.png" title="', $Title, '" alt="" />', ' ', $Title, '
+	</p>';
+
+/* Customer selection */
+if (!isset($DebtorNo) or $DebtorNo == '') {
+	echo '<form action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8', false), '" method="post">
+			<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+			<fieldset>
+				<legend>', __('Select Customer'), '</legend>
+				<field>
+					<label for="Keywords">', __('Customer code or part of the name'), ':</label>
+					<input type="text" name="Keywords" autofocus="autofocus" size="20" maxlength="40" value="', (isset($_POST['Keywords']) ? htmlspecialchars($_POST['Keywords'], ENT_QUOTES, 'UTF-8', false) : ''), '" />
+				</field>
+			</fieldset>
+			<div class="centre">
+				<input type="submit" name="Search" value="', __('Search Now'), '" />
+			</div>
+		</form>';
+
+	if (isset($_POST['Search'])) {
+		$SearchString = '%' . str_replace(' ', '%', trim($_POST['Keywords'])) . '%';
+		$SQL = "SELECT debtorsmaster.debtorno,
+						debtorsmaster.name,
+						debtorsmaster.currcode,
+						debtorsmaster.creditlimit,
+						holdreasons.reasondescription,
+						holdreasons.dissallowinvoices
+				FROM debtorsmaster
+				INNER JOIN holdreasons
+					ON debtorsmaster.holdreason=holdreasons.reasoncode
+				WHERE (debtorsmaster.debtorno " . LIKE . " '" . $SearchString . "'
+					OR debtorsmaster.name " . LIKE . " '" . $SearchString . "')
+				" . SalesmanCustomerFilterSQL() . "
+				ORDER BY debtorsmaster.name";
+		$Result = DB_query($SQL);
+		echo '<table class="selection">
+				<thead>
+					<tr>
+						<th class="SortedColumn">', __('Code'), '</th>
+						<th class="SortedColumn">', __('Customer'), '</th>
+						<th>', __('Currency'), '</th>
+						<th>', __('Credit Limit'), '</th>
+						<th class="SortedColumn">', __('Credit Status'), '</th>
+					</tr>
+				</thead>
+				<tbody>';
+		while ($MyRow = DB_fetch_array($Result)) {
+			echo '<tr class="striped_row">
+					<td><a href="', $RootPath, '/CreditControlCustomer.php?DebtorNo=', urlencode($MyRow['debtorno']), '">', $MyRow['debtorno'], '</a></td>
+					<td>', htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8', false), '</td>
+					<td>', $MyRow['currcode'], '</td>
+					<td class="number">', locale_number_format($MyRow['creditlimit'], 0), '</td>
+					<td>', CreditStatusName($MyRow['dissallowinvoices']), ' - ', $MyRow['reasondescription'], '</td>
+				</tr>';
+		}
+		echo '</tbody>
+			</table>';
+	}
+	include('includes/footer.php');
+	exit();
+}
+
+$Customer = GetCustomerCreditDetails($DebtorNo);
+if ($Customer === false) {
+	prnMsg(__('The customer') . ' ' . $DebtorNo . ' ' . __('does not exist'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+if (!CustomerVisibleToUser($DebtorNo)) {
+	prnMsg(__('Your account is set up to see only the customers of a specific salesperson. You are not authorised to see the credit information of this customer'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$_SESSION['CustomerID'] = $DebtorNo;
+$Authorised = HasCreditControlAuthority();
+
+/* ------------------------------------------------------------------ actions ------------------------------- */
+
+if ((isset($_POST['RecordReview']) or isset($_POST['ChangeStatus']) or isset($_POST['SetExemptions']) or isset($_POST['AddNote'])
+	or isset($_POST['Dispute']) or isset($_POST['SettleDispute']) or isset($_POST['Waive'])) and !$Authorised) {
+	prnMsg(__('Only credit control can change the credit status, credit limit, disputes, exemptions and charges of a customer'), 'error');
+	unset($_POST['RecordReview'], $_POST['ChangeStatus'], $_POST['SetExemptions'], $_POST['AddNote'], $_POST['Dispute'], $_POST['SettleDispute'], $_POST['Waive']);
+}
+
+if (isset($_POST['RecordReview'])) {
+	$InputError = 0;
+	$NewLimit = filter_number_format($_POST['NewCreditLimit']);
+	$Outcomes = CreditReviewOutcomes();

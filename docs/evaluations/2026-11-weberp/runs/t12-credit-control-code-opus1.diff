diff --git a/BadDebtWriteOff.php b/BadDebtWriteOff.php
new file mode 100644
index 0000000..3296a75
--- /dev/null
+++ b/BadDebtWriteOff.php
@@ -0,0 +1,325 @@
+<?php
+
+/* Bad debt write-offs (BR-25 to BR-28). Credit control writes off all or part of a customer's unpaid items with a
+ * reason. Write-offs above the approval limit wait for approval by someone with the write-off approval authority
+ * (the Finance Director) who is not the person who asked for it. Approved write-offs post to the bad debt account,
+ * with any difference on exchange, and put the customer on stop unless credit control decided otherwise.
+ * A written-off debt that is later paid is reinstated with a bad debt recovery before the receipt is allocated. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Bad Debt Write-off');
+$ViewTopic = 'CreditControl';
+$BookMark = 'WriteOffs';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="', $RootPath, '/css/', $Theme, '/images/money_delete.png" title="', $Title, '" alt="" />', ' ', $Title, '
+	</p>';
+
+if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+	$SetupErrors = CreditControlGLSetupErrors(array('BadDebtAct'));
+	if (count($SetupErrors) > 0) {
+		prnMsg(implode('<br />', $SetupErrors), 'error');
+		echo '<div class="centre"><a href="', $RootPath, '/CreditControlParameters.php">', __('Credit Control Parameters'), '</a></div>';
+		include('includes/footer.php');
+		exit();
+	}
+}
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper(trim($_GET['DebtorNo']));
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = mb_strtoupper(trim($_POST['DebtorNo']));
+}
+
+/* ------------------------------------------------------------------ approvals ----------------------------- */
+
+if (isset($_POST['Approve']) or isset($_POST['Reject'])) {
+	$WriteOffID = isset($_POST['Approve']) ? (int)$_POST['Approve'] : (int)$_POST['Reject'];
+	$Result = DB_query("SELECT requestedby FROM writeoffs WHERE writeoffid='" . $WriteOffID . "' AND status='P'");
+	$MyRow = DB_fetch_array($Result);
+	if (!HasWriteOffApprovalAuthority()) {
+		prnMsg(__('You do not have the authority to approve or reject write-offs'), 'error');
+	} elseif ($MyRow === null) {
+		prnMsg(__('This write-off is no longer waiting for approval'), 'warn');
+	} elseif ($MyRow['requestedby'] == $_SESSION['UserID']) {
+		prnMsg(__('A write-off must be approved by someone other than the person who requested it'), 'error');
+	} elseif (isset($_POST['Reject'])) {
+		if (trim($_POST['ApprovalNote' . $WriteOffID]) == '') {
+			prnMsg(__('Please give the reason for rejecting the write-off'), 'error');
+		} else {
+			DB_Txn_Begin();
+			RejectWriteOff($WriteOffID, CCInput($_POST['ApprovalNote' . $WriteOffID]));
+			DB_Txn_Commit();
+			prnMsg(__('Write-off') . ' ' . $WriteOffID . ' ' . __('has been rejected'), 'success');
+		}
+	} else {
+		$Problem = ValidateWriteOffItems($WriteOffID);
+		if ($Problem != '') {
+			prnMsg($Problem . '. ' . __('Reject this request and ask for a new one'), 'error');
+		} else {
+			DB_Txn_Begin();
+			$TransNo = PostWriteOff($WriteOffID, true);
+			EnsureGLEntriesBalance(CC_TYPE_WRITEOFF, $TransNo);
+			DB_Txn_Commit();
+			prnMsg(__('Write-off') . ' ' . $WriteOffID . ' ' . __('has been approved and posted as bad debt write-off') . ' ' . $TransNo, 'success');
+		}
+	}
+}
+
+$Result = DB_query("SELECT writeoffs.writeoffid,
+							writeoffs.debtorno,
+							writeoffs.requestdate,
+							writeoffs.requestedby,
+							writeoffs.amount,
+							writeoffs.currcode,
+							writeoffs.homeamount,
+							writeoffs.reason,
+							writeoffs.stopcustomer,
+							debtorsmaster.name,
+							currencies.decimalplaces
+					FROM writeoffs
+					INNER JOIN debtorsmaster
+						ON writeoffs.debtorno=debtorsmaster.debtorno
+					INNER JOIN currencies
+						ON writeoffs.currcode=currencies.currabrev
+					WHERE writeoffs.status='P'
+					ORDER BY writeoffs.requestdate");
+if (DB_num_rows($Result) > 0) {
+	$CanApprove = HasWriteOffApprovalAuthority();
+	echo '<form action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '" method="post">
+			<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+			<table class="selection">
+			<tr><th colspan="9"><h3>', __('Write-offs Waiting For Approval'), '</h3></th></tr>
+			<tr>
+				<th>', __('No'), '</th>
+				<th>', __('Requested'), '</th>
+				<th>', __('Customer'), '</th>
+				<th>', __('Amount'), '</th>
+				<th>', $_SESSION['CompanyRecord']['currencydefault'], '</th>
+				<th>', __('Reason'), '</th>
+				<th>', __('Stop'), '</th>
+				<th>', __('Note'), '</th>
+				<th></th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>', $MyRow['writeoffid'], '</td>
+				<td>', ConvertSQLDateTime($MyRow['requestdate']), ' ', $MyRow['requestedby'], '</td>
+				<td><a href="', $RootPath, '/CreditControlCustomer.php?DebtorNo=', urlencode($MyRow['debtorno']), '" target="_blank">', $MyRow['debtorno'], ' - ', htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8', false), '</a></td>
+				<td class="number">', $MyRow['currcode'], ' ', locale_number_format($MyRow['amount'], $MyRow['decimalplaces']), '</td>
+				<td class="number">', locale_number_format($MyRow['homeamount'], $_SESSION['CompanyRecord']['decimalplaces']), '</td>
+				<td>', htmlspecialchars($MyRow['reason'], ENT_QUOTES, 'UTF-8', false), '</td>
+				<td>', ($MyRow['stopcustomer'] ? __('Yes') : __('No')), '</td>';
+		if ($CanApprove and $MyRow['requestedby'] != $_SESSION['UserID']) {
+			echo '<td><input type="text" name="ApprovalNote', $MyRow['writeoffid'], '" size="25" maxlength="200" /></td>
+				<td>
+					<button type="submit" name="Approve" value="', $MyRow['writeoffid'], '" onclick="return confirm(\'', __('Approve and post this write-off?'), '\');">', __('Approve'), '</button>
+					<button type="submit" name="Reject" value="', $MyRow['writeoffid'], '">', __('Reject'), '</button>
+				</td>';
+		} else {
+			echo '<td colspan="2">', __('Waiting for approval'), '</td>';
+		}
+		echo '</tr>';
+	}
+	echo '</table>
+		</form>';
+}
+
+/* ------------------------------------------------------------------ customer selection --------------------- */
+
+if (!isset($DebtorNo) or $DebtorNo == '') {
+	echo '<form action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '" method="post">
+			<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+			<fieldset>
+				<legend>', __('Write Off A Customer Debt'), '</legend>
+				<field>
+					<label for="DebtorNo">', __('Customer Code'), ':</label>
+					<input type="text" name="DebtorNo" size="11" maxlength="10" required="required" />
+				</field>
+			</fieldset>
+			<div class="centre"><input type="submit" name="SelectCustomer" value="', __('Select'), '" /></div>
+		</form>';
+	include('includes/footer.php');
+	exit();
+}
+
+$Customer = GetCustomerCreditDetails($DebtorNo);
+if ($Customer === false) {
+	prnMsg(__('The customer') . ' ' . $DebtorNo . ' ' . __('does not exist'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+/* ------------------------------------------------------------------ request a write-off -------------------- */
+
+if (isset($_POST['RequestWriteOff'])) {
+	$InputError = 0;
+	$Items = array();
+	foreach ($_POST as $Key => $Value) {
+		if (mb_substr($Key, 0, 8) == 'WriteOff' and is_numeric(mb_substr($Key, 8))) {
+			$DebtorTransID = (int)mb_substr($Key, 8);
+			$Amount = round(filter_number_format($_POST['Amount' . $DebtorTransID]), $Customer['decimalplaces']);
+			$Result = DB_query("SELECT balance FROM debtortrans WHERE id='" . $DebtorTransID . "' AND debtorno='" . $DebtorNo . "'");
+			$MyRow = DB_fetch_row($Result);
+			if ($MyRow === null or !is_numeric($Amount) or $Amount <= 0 or $Amount > round($MyRow[0], $Customer['decimalplaces'])) {
+				$InputError = 1;
+				prnMsg(__('The amount to write off each item must be more than zero and no more than its outstanding balance'), 'error');
+				break;
+			}
+			$Items[$DebtorTransID] = $Amount;
+		}
+	}
+	if (count($Items) == 0 and $InputError == 0) {
+		$InputError = 1;
+		prnMsg(__('Select the items to write off'), 'error');
+	}
+	if (trim($_POST['Reason']) == '') {
+		$InputError = 1;
+		prnMsg(__('A reason must be given for writing off a debt'), 'error');
+	}
+	if ($InputError == 0) {
+		DB_Txn_Begin();
+		$WriteOffID = RequestWriteOff($DebtorNo, $Items, CCInput($_POST['Reason']), isset($_POST['StopCustomer']));
+		$Result = DB_query("SELECT status, transno FROM writeoffs WHERE writeoffid='" . $WriteOffID . "'");
+		$MyRow = DB_fetch_array($Result);
+		if ($MyRow['status'] == 'A') {
+			EnsureGLEntriesBalance(CC_TYPE_WRITEOFF, $MyRow['transno']);
+		}
+		DB_Txn_Commit();
+		if ($MyRow['status'] == 'A') {
+			prnMsg(__('The debt has been written off as bad debt write-off') . ' ' . $MyRow['transno'], 'success');
+		} else {
+			prnMsg(__('Write-off') . ' ' . $WriteOffID . ' ' . __('is above the approval limit and is waiting for approval. Nothing has been posted yet'), 'warn');
+		}
+		$Customer = GetCustomerCreditDetails($DebtorNo);
+	}
+}
+
+if (isset($_POST['RecordRecovery'])) {
+	$Amount = round(filter_number_format($_POST['RecoveryAmount']), $Customer['decimalplaces']);
+	$Result = DB_query("SELECT COALESCE(SUM(amount),0) FROM writeoffs WHERE debtorno='" . $DebtorNo . "' AND status='A'");
+	$WrittenOff = DB_fetch_row($Result);
+	$Result = DB_query("SELECT COALESCE(SUM(ovamount),0) FROM debtortrans WHERE debtorno='" . $DebtorNo . "' AND type='" . CC_TYPE_RECOVERY . "'");
+	$Recovered = DB_fetch_row($Result);
+	if (!is_numeric($Amount) or $Amount <= 0 or $Amount > round($WrittenOff[0] - $Recovered[0], $Customer['decimalplaces'])) {
+		prnMsg(__('The amount recovered must be more than zero and no more than the amount written off and not yet recovered'), 'error');
+	} elseif (trim($_POST['RecoveryReason']) == '') {
+		prnMsg(__('Please give details of the recovery'), 'error');
+	} else {
+		DB_Txn_Begin();
+		$TransNo = PostBadDebtRecovery($DebtorNo, $Amount, CCInput($_POST['RecoveryReason']));
+		EnsureGLEntriesBalance(CC_TYPE_RECOVERY, $TransNo);
+		DB_Txn_Commit();
+		prnMsg(__('Bad debt recovery') . ' ' . $TransNo . ' ' . __('has been posted. Now enter the receipt and allocate it against the recovery'), 'success');
+		$Customer = GetCustomerCreditDetails($DebtorNo);
+	}
+}
+
+echo '<div class="centre noPrint">
+		<a href="', $RootPath, '/CreditControlCustomer.php?DebtorNo=', urlencode($DebtorNo), '">', __('Customer Credit Control'), '</a> |
+		<a href="', $RootPath, '/BadDebtWriteOff.php">', __('Select Another Customer'), '</a>
+	</div>';
+ShowCreditStatusBanner($DebtorNo);
+
+$Result = DB_query("SELECT COALESCE(SUM(balance),0) FROM debtortrans WHERE debtorno='" . $DebtorNo . "' AND balance < 0");
+$MyRow = DB_fetch_row($Result);
+if (round($MyRow[0], $Customer['decimalplaces']) < 0) {
+	prnMsg(__('This customer has unallocated receipts or credits of') . ' ' . $Customer['currcode'] . ' ' . locale_number_format(-$MyRow[0], $Customer['decimalplaces']) . '. ' . __('Allocate these before writing off the remaining debt'), 'warn');
+}
+
+$SQL = "SELECT debtortrans.id,
+				debtortrans.transno,
+				debtortrans.trandate,
+				debtortrans.reference,
+				debtortrans.rate,
+				debtortrans.balance,
+				systypes.typename,
+				" . DueDateSQL() . " AS duedate
+		FROM debtortrans
+		INNER JOIN debtorsmaster
+			ON debtortrans.debtorno=debtorsmaster.debtorno
+		INNER JOIN paymentterms
+			ON debtorsmaster.paymentterms=paymentterms.termsindicator
+		INNER JOIN systypes
+			ON debtortrans.type=systypes.typeid
+		WHERE debtortrans.debtorno='" . $DebtorNo . "'
+		AND ROUND(debtortrans.balance, " . $Customer['decimalplaces'] . ") > 0
+		ORDER BY debtortrans.trandate, debtortrans.id";
+$Result = DB_query($SQL);
+
+echo '<form action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '" method="post">
+		<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+		<input type="hidden" name="DebtorNo" value="', $DebtorNo, '" />
+		<table class="selection">
+		<tr><th colspan="7"><h3>', __('Write Off Unpaid Items For'), ' ', $DebtorNo, ' - ', htmlspecialchars($Customer['name'], ENT_QUOTES, 'UTF-8', false), '</h3></th></tr>
+		<tr>
+			<th>', __('Write Off'), '</th>
+			<th>', __('Type'), '</th>
+			<th>', __('Number'), '</th>
+			<th>', __('Date'), '</th>
+			<th>', __('Due'), '</th>
+			<th>', __('Outstanding'), ' ', $Customer['currcode'], '</th>
+			<th>', __('Amount To Write Off'), '</th>
+		</tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td><input type="checkbox" name="WriteOff', $MyRow['id'], '" /></td>
+			<td>', __($MyRow['typename']), '</td>
+			<td>', $MyRow['transno'], '</td>
+			<td>', ConvertSQLDate($MyRow['trandate']), '</td>
+			<td>', ConvertSQLDate($MyRow['duedate']), '</td>
+			<td class="number">', locale_number_format($MyRow['balance'], $Customer['decimalplaces']), '</td>
+			<td><input type="text" class="number" name="Amount', $MyRow['id'], '" size="12" value="', locale_number_format($MyRow['balance'], $Customer['decimalplaces']), '" /></td>
+		</tr>';
+}
+echo '</table>
+		<fieldset>
+			<legend>', __('Write-off Details'), '</legend>
+			<field>
+				<label for="Reason">', __('Reason'), ':</label>
+				<textarea name="Reason" rows="3" cols="60" required="required"></textarea>
+			</field>
+			<field>
+				<label for="StopCustomer">', __('Put the customer on stop'), ':</label>
+				<input type="checkbox" name="StopCustomer" checked="checked" />
+				<fieldhelp>', __('Customers are normally put on stop when a debt is written off - untick only if credit control has decided otherwise'), '</fieldhelp>
+			</field>
+			<field>
+				<label>', __('Approval'), ':</label>
+				<fieldtext>', __('Write-offs worth more than'), ' ', $_SESSION['CompanyRecord']['currencydefault'], ' ', locale_number_format(CreditControlConfig('WriteOffApprovalLimit', 0), $_SESSION['CompanyRecord']['decimalplaces']), ' ', __('wait for approval before anything is posted'), '</fieldtext>
+			</field>
+		</fieldset>
+		<div class="centre">
+			<input type="submit" name="RequestWriteOff" value="', __('Write Off Selected Items'), '" onclick="return confirm(\'', __('Write off the selected items as bad debt?'), '\');" />
+		</div>
+	</form>';
+
+/* Recovery of a debt written off earlier */
+$Result = DB_query("SELECT COALESCE(SUM(amount),0) FROM writeoffs WHERE debtorno='" . $DebtorNo . "' AND status='A'");
+$WrittenOff = DB_fetch_row($Result);
+if ($WrittenOff[0] > 0) {
+	echo '<form action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '" method="post">
+			<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+			<input type="hidden" name="DebtorNo" value="', $DebtorNo, '" />
+			<fieldset>
+				<legend>', __('Written-off Debt Paid After All'), '</legend>
+				<field>
+					<label for="RecoveryAmount">', __('Amount recovered'), ' (', $Customer['currcode'], '):</label>
+					<input type="text" class="number" name="RecoveryAmount" size="12" />
+					<fieldhelp>', __('Reinstates this much of the written-off debt by crediting the bad debt account. Then enter the receipt in the usual way and allocate it to the recovery'), '</fieldhelp>
+				</field>
+				<field>
+					<label for="RecoveryReason">', __('Details'), ':</label>
+					<input type="text" name="RecoveryReason" size="60" maxlength="200" />
+				</field>
+			</fieldset>
+			<div class="centre"><input type="submit" name="RecordRecovery" value="', __('Record Recovery'), '" /></div>
+		</form>';
+}
+
+include('includes/footer.php');
diff --git a/BadDebtWriteOffReport.php b/BadDebtWriteOffReport.php
new file mode 100644
index 0000000..ade86fe
--- /dev/null
+++ b/BadDebtWriteOffReport.php
@@ -0,0 +1,133 @@
+<?php
+
+/* Report of bad debt write-offs over a period (BR-29): customer, amount, reason, who asked for it and who approved it */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Bad Debt Write-off Report');
+$ViewTopic = 'CreditControl';
+$BookMark = 'WriteOffReport';
+include('includes/header.php');
+
+echo '<p class="page_title_text">
+		<img src="', $RootPath, '/css/', $Theme, '/images/reports.png" title="', $Title, '" alt="" />', ' ', $Title, '
+	</p>';
+
+if (!isset($_POST['FromDate'])) {
+	$_POST['FromDate'] = date('Y-m-d', mktime(0, 0, 0, 1, 1, date('Y')));
+}
+if (!isset($_POST['ToDate'])) {
+	$_POST['ToDate'] = date('Y-m-d');
+}
+if (!isset($_POST['Status'])) {
+	$_POST['Status'] = 'A';
+}
+$Statuses = array('A' => __('Posted'), 'P' => __('Waiting for approval'), 'R' => __('Rejected'), '' => __('All'));
+
+echo '<form action="', htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8'), '" method="post" class="noPrint">
+		<input type="hidden" name="FormID" value="', $_SESSION['FormID'], '" />
+		<fieldset>
+			<legend>', __('Report Criteria'), '</legend>
+			<field>
+				<label for="FromDate">', __('Requested from'), ':</label>
+				<input type="date" name="FromDate" value="', $_POST['FromDate'], '" />
+			</field>
+			<field>
+				<label for="ToDate">', __('Requested to'), ':</label>
+				<input type="date" name="ToDate" value="', $_POST['ToDate'], '" />
+			</field>
+			<field>
+				<label for="Status">', __('Status'), ':</label>
+				<select name="Status">';
+foreach ($Statuses as $Code => $Description) {
+	echo '<option value="', $Code, '"', ($_POST['Status'] == $Code ? ' selected="selected"' : ''), '>', $Description, '</option>';
+}
+echo '</select>
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Show" value="', __('Show Report'), '" /></div>
+	</form>';
+
+$SQL = "SELECT writeoffs.writeoffid,
+				writeoffs.debtorno,
+				writeoffs.requestdate,
+				writeoffs.requestedby,
+				writeoffs.amount,
+				writeoffs.currcode,
+				writeoffs.homeamount,
+				writeoffs.reason,
+				writeoffs.stopcustomer,
+				writeoffs.status,
+				writeoffs.approvedby,
+				writeoffs.approveddate,
+				writeoffs.rejectreason,
+				writeoffs.posteddate,
+				writeoffs.transno,
+				debtorsmaster.name,
+				currencies.decimalplaces
+		FROM writeoffs
+		INNER JOIN debtorsmaster
+			ON writeoffs.debtorno=debtorsmaster.debtorno
+		INNER JOIN currencies
+			ON writeoffs.currcode=currencies.currabrev
+		WHERE writeoffs.requestdate >= '" . $_POST['FromDate'] . "'
+		AND writeoffs.requestdate < DATE_ADD('" . $_POST['ToDate'] . "', INTERVAL 1 DAY)";
+if ($_POST['Status'] != '') {
+	$SQL .= " AND writeoffs.status='" . $_POST['Status'] . "'";
+}
+$SQL .= " ORDER BY writeoffs.requestdate";
+$Result = DB_query($SQL);
+

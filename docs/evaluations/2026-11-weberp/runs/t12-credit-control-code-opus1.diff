+				<label for="HeaderRow">', __('First row is a header'), ':</label>
+				<input type="checkbox" name="HeaderRow" checked="checked" />
+			</field>
+			<field>
+				<label for="TestRun">', __('Test run only'), ':</label>
+				<input type="checkbox" name="TestRun" checked="checked" />
+				<fieldhelp>', __('Check the file without changing anything'), '</fieldhelp>
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Import" value="', __('Import'), '" /></div>
+	</form>';
+
+include('includes/footer.php');

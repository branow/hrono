+					WHERE debtorno='" . $DebtorNo . "'
+					ORDER BY chargemonth DESC, chargetype");
+echo '<table class="selection">
+		<tr><th colspan="6"><h3>', __('Interest and Late Payment Fees'), '</h3></th></tr>
+		<tr>
+			<th>', __('Month'), '</th>
+			<th>', __('Charge'), '</th>
+			<th>', __('Number'), '</th>

+			<td class="number">', $Customer['currcode'], ' ', locale_number_format($MyRow['amount'], $Customer['decimalplaces']), '</td>
+			<td>', ($MyRow['method'] == 'E' ? __('By email to') . ' ' . $MyRow['emailedto'] : __('By post')), '</td>
+			<td><a href="', $RootPath, '/PDFDunningLetter.php?LetterID=', $MyRow['letterid'], '" target="_blank">', __('View letter'), '</a></td>
+		</tr>';
+}
+echo '</table>';
+
+$Result = DB_query("SELECT chargemonth, chargetype, transno, amount, basisamount, rate, waived, waivertransno, waiveddate

+				<fieldhelp>', __('New customers get a next review date this many months after the account is opened'), '</fieldhelp>
+			</field>
+			<field>
+				<label for="X_CreditStopReason">', __('Credit status used for automatic stop'), ':</label>
+				<select name="X_CreditStopReason">';
+$Result = DB_query("SELECT reasoncode, reasondescription FROM holdreasons WHERE dissallowinvoices=1 ORDER BY reasoncode");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option value="', $MyRow['reasoncode'], '"', ($_SESSION['CreditStopReason'] == $MyRow['reasoncode'] ? ' selected="selected"' : ''), '>', $MyRow['reasoncode'], ' - ', $MyRow['reasondescription'], '</option>';
+}
+echo '</select>
+				<fieldhelp>', __('Customers are put on stop with this credit status when a bad debt is written off'), '</fieldhelp>
+			</field>
+			<field>
+				<label>', __('Orders over the credit limit'), ':</label>
+				<fieldtext>';
+switch ($_SESSION['CheckCreditLimits']) {
+	case 0:
+		echo __('Not checked');
+		break;
+	case 1:
+		echo __('Warn on breach');
+		break;
+	case 2:
+		echo __('Prohibit sales');
+		break;
+	case 3:
+		echo __('Hold for credit control approval');
+		break;
+}
+echo ' (<a href="', $RootPath, '/SystemParameters.php">', __('System Parameters'), '</a>)</fieldtext>
+			</field>
+		</fieldset>
+		<fieldset>
+			<legend>', __('Reminder Letters'), '</legend>
+			<field>
+				<label for="X_DunningMinDays">', __('Minimum days between reminders'), ':</label>
+				<input type="text" class="integer" name="X_DunningMinDays" size="4" value="', $_SESSION['DunningMinDays'], '" />
+				<fieldhelp>', __('A customer does not receive another reminder until this many days after the last one'), '</fieldhelp>
+			</field>
+			<field>
+				<label>', __('Stages and wording'), ':</label>
+				<fieldtext><a href="', $RootPath, '/DunningLevels.php">', __('Reminder Letter Stages'), '</a></fieldtext>
+			</field>
+		</fieldset>
+		<fieldset>
+			<legend>', __('Month End Interest and Late Payment Fees'), '</legend>
+			<field>
+				<label for="X_CreditInterestRate">', __('Interest rate (% per annum)'), ':</label>
+				<input type="text" class="number" name="X_CreditInterestRate" size="6" value="', locale_number_format($_SESSION['CreditInterestRate'], 2), '" />
+				<fieldhelp>', __('Simple interest on overdue balances, charged for the days of the month they were overdue. Zero for no interest'), '</fieldhelp>
+			</field>
+			<field>
+				<label for="X_CreditInterestDays">', __('Days overdue before interest is charged'), ':</label>
+				<input type="text" class="integer" name="X_CreditInterestDays" size="4" value="', $_SESSION['CreditInterestDays'], '" />
+			</field>
+			<field>
+				<label for="X_CreditInterestAct">', __('Interest income account'), ':</label>';
+AccountSelect('X_CreditInterestAct', $_SESSION['CreditInterestAct'], $Accounts, true);
+echo '</field>
+			<field>
+				<label for="X_CreditLateFee">', __('Late payment fee per month'), ' (', $_SESSION['CompanyRecord']['currencydefault'], '):</label>
+				<input type="text" class="number" name="X_CreditLateFee" size="10" value="', locale_number_format($_SESSION['CreditLateFee'], $_SESSION['CompanyRecord']['decimalplaces']), '" />
+				<fieldhelp>', __('One flat fee per customer per month, converted to the customer currency at the current exchange rate. Zero for no fees'), '</fieldhelp>
+			</field>
+			<field>
+				<label for="X_CreditFeeDays">', __('Days overdue before the fee is charged'), ':</label>
+				<input type="text" class="integer" name="X_CreditFeeDays" size="4" value="', $_SESSION['CreditFeeDays'], '" />
+			</field>
+			<field>
+				<label for="X_CreditFeeAct">', __('Late payment fee income account'), ':</label>';
+AccountSelect('X_CreditFeeAct', $_SESSION['CreditFeeAct'], $Accounts, true);
+echo '</field>
+		</fieldset>
+		<fieldset>
+			<legend>', __('Bad Debt Write-off'), '</legend>
+			<field>
+				<label for="X_BadDebtAct">', __('Bad debt account'), ':</label>';
+AccountSelect('X_BadDebtAct', $_SESSION['BadDebtAct'], $Accounts, false);
+echo '</field>
+			<field>
+				<label for="X_WriteOffApprovalLimit">', __('Write-offs above this need approval'), ' (', $_SESSION['CompanyRecord']['currencydefault'], '):</label>
+				<input type="text" class="number" name="X_WriteOffApprovalLimit" size="12" value="', locale_number_format($_SESSION['WriteOffApprovalLimit'], $_SESSION['CompanyRecord']['decimalplaces']), '" />

diff --git a/sql/updates/44.php b/sql/updates/44.php
new file mode 100644
index 0000000..dd3548a
--- /dev/null
+++ b/sql/updates/44.php
@@ -0,0 +1,252 @@
+<?php
+
+/* Credit control: credit reviews, stop and watch, order credit holds, reminder letters, month end interest and
+ * late payment fees, bad debt write-offs and the credit control audit trail. See doc/Manual/ManualCreditControl.html */
+
+// Customer: date of next credit review and exemptions from interest and fees
+AddColumn('nextreviewdate', 'debtorsmaster', 'date', 'NULL', '', 'language_id');
+AddColumn('interestexempt', 'debtorsmaster', 'tinyint(1)', 'NOT NULL', '0', 'nextreviewdate');
+AddColumn('feeexempt', 'debtorsmaster', 'tinyint(1)', 'NOT NULL', '0', 'interestexempt');
+AddIndex(array('nextreviewdate'), 'debtorsmaster', 'NextReviewDate');
+
+// Sales order: 0 = not held, 1 = held because the customer is on stop, 2 = held because over the credit limit
+AddColumn('credithold', 'salesorders', 'tinyint(1)', 'NOT NULL', '0', 'poplaced');
+AddIndex(array('credithold'), 'salesorders', 'CreditHold');
+
+CreateTable('creditcontrollog', "CREATE TABLE `creditcontrollog` (
+  `id` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `eventdate` datetime NOT NULL,
+  `userid` varchar(20) NOT NULL DEFAULT '',
+  `eventtype` varchar(20) NOT NULL DEFAULT '',
+  `narrative` text,
+  `oldvalue` varchar(100) NOT NULL DEFAULT '',
+  `newvalue` varchar(100) NOT NULL DEFAULT '',
+  `transtype` smallint NOT NULL DEFAULT 0,
+  `transno` int NOT NULL DEFAULT 0,
+  `orderno` int NOT NULL DEFAULT 0,
+  PRIMARY KEY (`id`),
+  KEY `DebtorNo` (`debtorno`, `eventdate`),
+  KEY `EventType` (`eventtype`),
+  KEY `OrderNo` (`orderno`)
+)");
+
+CreateTable('creditreviews', "CREATE TABLE `creditreviews` (
+  `reviewid` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `reviewdate` datetime NOT NULL,
+  `reviewedby` varchar(20) NOT NULL DEFAULT '',
+  `outcome` varchar(20) NOT NULL DEFAULT '',
+  `oldcreditlimit` double NOT NULL DEFAULT 0,
+  `newcreditlimit` double NOT NULL DEFAULT 0,
+  `oldholdreason` smallint NOT NULL DEFAULT 0,
+  `newholdreason` smallint NOT NULL DEFAULT 0,
+  `notes` text,
+  `nextreviewdate` date NOT NULL,
+  PRIMARY KEY (`reviewid`),
+  KEY `DebtorNo` (`debtorno`, `reviewdate`)
+)");
+
+CreateTable('debtortransdisputes', "CREATE TABLE `debtortransdisputes` (
+  `debtortransid` int NOT NULL,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `raiseddate` datetime NOT NULL,
+  `raisedby` varchar(20) NOT NULL DEFAULT '',
+  `reason` text,
+  PRIMARY KEY (`debtortransid`),
+  KEY `DebtorNo` (`debtorno`),
+  CONSTRAINT `debtortransdisputes_ibfk_1` FOREIGN KEY (`debtortransid`) REFERENCES `debtortrans` (`id`)
+)");
+
+CreateTable('dunninglevels', "CREATE TABLE `dunninglevels` (
+  `levelno` tinyint NOT NULL,
+  `levelname` varchar(40) NOT NULL DEFAULT '',
+  `daysoverdue` int NOT NULL DEFAULT 0,
+  `subject` varchar(100) NOT NULL DEFAULT '',
+  `bodytext` text,
+  PRIMARY KEY (`levelno`)
+)");
+
+CreateTable('dunningletters', "CREATE TABLE `dunningletters` (
+  `letterid` int NOT NULL AUTO_INCREMENT,
+  `debtorno` varchar(10) NOT NULL DEFAULT '',
+  `letterdate` date NOT NULL,
+  `levelno` tinyint NOT NULL DEFAULT 0,
+  `currcode` char(3) NOT NULL DEFAULT '',
+  `amount` double NOT NULL DEFAULT 0,
+  `method` char(1) NOT NULL DEFAULT 'E',
+  `emailedto` varchar(255) NOT NULL DEFAULT '',
+  `subject` varchar(100) NOT NULL DEFAULT '',
+  `lettertext` text,
+  `sentby` varchar(20) NOT NULL DEFAULT '',
+  PRIMARY KEY (`letterid`),
+  KEY `DebtorNo` (`debtorno`, `letterdate`)
+)");
+
+CreateTable('dunningletteritems', "CREATE TABLE `dunningletteritems` (

+		if ($Amount > $Threshold) {
+			$ApprovalStatus = 1;
+			$Msg = __('Write-off created and awaiting Finance Director approval');
+		} else {
+			$ApprovalStatus = 0;
+			$Msg = __('Write-off has been recorded and applied');
+		}
+
+		$SQL = "INSERT INTO creditwriteoffs (
+					debtorno,
+					writeoffdate,
+					userid,
+					amount,
+					currcode,
+					reason,
+					approvalstatus
+				) VALUES (
+					'" . $_POST['DebtorNo'] . "',
+					NOW(),
+					'" . $_SESSION['UserID'] . "',
+					'" . $Amount . "',
+					'" . $CurrCode . "',
+					'" . $_POST['Reason'] . "',
+					'" . $ApprovalStatus . "'
+				)";
+
+		DB_query($SQL);
+
+		if ($ApprovalStatus == 0) {
+			$SQL = "UPDATE debtorsmaster SET creditstatus=2 WHERE debtorno='" . $_POST['DebtorNo'] . "'";
+			DB_query($SQL);
+		}
+
+		prnMsg($Msg, 'success');
+		unset($_POST);
+		unset($DebtorNo);
+	}
+}
+
+if (isset($_POST['DebtorNo']) && !isset($_POST['submit'])) {
+
+	$SQL = "SELECT name, currcode FROM debtorsmaster WHERE debtorno='" . $_POST['DebtorNo'] . "'";
+	$Result = DB_query($SQL);
+
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('Customer not found'), 'error');
+	} else {
+		$MyRow = DB_fetch_array($Result);
+
+		echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<input type="hidden" name="DebtorNo" value="' . $_POST['DebtorNo'] . '" />
+			<fieldset>
+				<legend>' . __('Write-Off for') . ' ' . $_POST['DebtorNo'] . ' - ' . $MyRow['name'] . '</legend>
+				<field>
+					<label for="Amount">' . __('Amount to Write-Off') . ' (' . $MyRow['currcode'] . '):</label>
+					<input type="text" name="Amount" size="15" required="required" />
+				</field>
+				<field>
+					<label for="Reason">' . __('Reason for Write-Off') . ':</label>
+					<textarea name="Reason" rows="4" required="required"></textarea>
+				</field>
+			</fieldset>
+			<div class="centre">
+				<input type="submit" name="submit" value="' . __('Create Write-Off') . '" />
+			</div>
+		</form>';
+
+		echo '<br /><h3>' . __('Write-Off History') . '</h3>';
+
+		$SQL = "SELECT
+					writeoffdate,
+					userid,
+					amount,
+					currcode,
+					reason,
+					approvalstatus,
+					approvedby,
+					approvaldate
+				FROM creditwriteoffs
+				WHERE debtorno='" . $_POST['DebtorNo'] . "'
+				ORDER BY writeoffdate DESC";
+
+		$Result = DB_query($SQL);
+
+		if (DB_num_rows($Result) > 0) {
+			echo '<table class="selection">
+				<tr>
+					<th>' . __('Date') . '</th>
+					<th>' . __('User') . '</th>
+					<th>' . __('Amount') . '</th>
+					<th>' . __('Reason') . '</th>

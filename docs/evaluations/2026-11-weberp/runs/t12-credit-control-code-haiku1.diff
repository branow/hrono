+<?php
+
+function GetCustomerCreditStatus($DebtorNo) {
+	$SQL = "SELECT creditstatus FROM debtorsmaster WHERE debtorno='" . $DebtorNo . "'";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) > 0) {
+		$MyRow = DB_fetch_array($Result);
+		return $MyRow['creditstatus'];
+	}
+	return 0;
+}
+
+function IsCustomerOnStop($DebtorNo) {
+	return GetCustomerCreditStatus($DebtorNo) == 2;
+}
+
+function IsCustomerOnWatch($DebtorNo) {
+	return GetCustomerCreditStatus($DebtorNo) == 1;
+}
+
+function GetOutstandingBalance($DebtorNo) {
+	$SQL = "SELECT COALESCE(SUM(ovamount), 0) as balance FROM debtortrans WHERE debtorno='" . $DebtorNo . "' AND settled=0";
+	$Result = DB_query($SQL);
+	$MyRow = DB_fetch_array($Result);
+	return $MyRow['balance'];
+}
+
+function GetOverdueBalance($DebtorNo, $DaysOverdue = 0) {
+	if ($DaysOverdue > 0) {
+		$SQL = "SELECT COALESCE(SUM(ovamount), 0) as balance FROM debtortrans
+				WHERE debtorno='" . $DebtorNo . "'
+				AND settled=0
+				AND duedate <= DATE_SUB(CURDATE(), INTERVAL " . $DaysOverdue . " DAY)";
+	} else {
+		$SQL = "SELECT COALESCE(SUM(ovamount), 0) as balance FROM debtortrans WHERE debtorno='" . $DebtorNo . "' AND settled=0 AND duedate < CURDATE()";
+	}
+	$Result = DB_query($SQL);
+	$MyRow = DB_fetch_array($Result);
+	return $MyRow['balance'];
+}
+
+function GetCreditLimit($DebtorNo) {
+	$SQL = "SELECT creditlimit FROM debtorsmaster WHERE debtorno='" . $DebtorNo . "'";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) > 0) {
+		$MyRow = DB_fetch_array($Result);
+		return $MyRow['creditlimit'];
+	}
+	return 0;
+}
+
+function GetConfigSetting($Key, $Default = '') {
+	$SQL = "SELECT configvalue FROM creditconfig WHERE configkey='" . $Key . "'";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) > 0) {
+		$MyRow = DB_fetch_array($Result);
+		return $MyRow['configvalue'];
+	}
+	return $Default;
+}
+
+function GetLastReminderStage($DebtorNo) {
+	$SQL = "SELECT MAX(stage) as stage FROM creditreminders WHERE debtorno='" . $DebtorNo . "'";
+	$Result = DB_query($SQL);
+	$MyRow = DB_fetch_array($Result);
+	return isset($MyRow['stage']) ? $MyRow['stage'] : 0;
+}
+
+function GetLastReminderDate($DebtorNo, $Stage) {
+	$SQL = "SELECT MAX(sentdate) as sentdate FROM creditreminders
+			WHERE debtorno='" . $DebtorNo . "' AND stage=" . $Stage;
+	$Result = DB_query($SQL);
+	$MyRow = DB_fetch_array($Result);
+	return isset($MyRow['sentdate']) ? $MyRow['sentdate'] : NULL;
+}
+
+function CalculateInterest($OutstandingAmount, $DaysOverdue) {
+	$AnnualRate = GetConfigSetting('InterestRate', 8);
+	$DailyRate = $AnnualRate / 365;
+	return ($OutstandingAmount * $DailyRate * $DaysOverdue) / 100;
+}
+
+function GetOverdueInvoices($DebtorNo, $MaxDaysOverdue = NULL) {
+	if ($MaxDaysOverdue !== NULL) {
+		$SQL = "SELECT tranno, ovamount, duedate, reference, currcode
+				FROM debtortrans
+				WHERE debtorno='" . $DebtorNo . "'
+				AND settled=0
+				AND type IN (10, 11)
+				AND duedate < CURDATE()
+				AND duedate >= DATE_SUB(CURDATE(), INTERVAL " . $MaxDaysOverdue . " DAY)
+				AND disputed=0
+				ORDER BY duedate ASC";
+	} else {
+		$SQL = "SELECT tranno, ovamount, duedate, reference, currcode
+				FROM debtortrans
+				WHERE debtorno='" . $DebtorNo . "'
+				AND settled=0
+				AND type IN (10, 11)
+				AND duedate < CURDATE()
+				AND disputed=0
+				ORDER BY duedate ASC";
+	}
+	$Result = DB_query($SQL);
+	return $Result;
+}
+
+function UpdateCustomerStatusFromWriteOff($DebtorNo) {
+	$SQL = "UPDATE debtorsmaster SET creditstatus=2 WHERE debtorno='" . $DebtorNo . "'";
+	DB_query($SQL);
+}
+
+function GetDaysOverdue($DueDate) {
+	if ($DueDate == '1000-01-01 00:00:00' || $DueDate == '1000-01-01') {
+		return 0;
+	}
+	$Today = new DateTime();
+	$Due = new DateTime($DueDate);
+	if ($Due < $Today) {
+		$Interval = $Today->diff($Due);
+		return $Interval->days;
+	}
+	return 0;
+}
+
+?>

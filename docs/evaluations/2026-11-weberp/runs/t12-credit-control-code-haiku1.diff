diff --git a/CreditControlReport.php b/CreditControlReport.php
new file mode 100644
index 0000000..cab6be4
--- /dev/null
+++ b/CreditControlReport.php
@@ -0,0 +1,172 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Control Report');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlReport';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="'.$RootPath.'/css/'.$Theme.'/images/report.png" title="' . __('Report') . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Errors = array();
+
+if (isset($_POST['Report'])) {
+	$Report = $_POST['Report'];
+} else {
+	$Report = 'due_for_review';
+}
+
+if ($Report == 'due_for_review') {
+	echo '<h3>' . __('Customers Due for Credit Review') . '</h3>';
+
+	$SQL = "SELECT
+				debtorno,
+				name,
+				creditlimit,
+				creditstatus,
+				nextreviewdate
+			FROM debtorsmaster
+			WHERE nextreviewdate <= CURDATE()
+			ORDER BY nextreviewdate ASC";
+
+	$Result = DB_query($SQL);
+
+	if (DB_num_rows($Result) > 0) {
+		echo '<table class="selection">
+			<tr>
+				<th>' . __('Customer Code') . '</th>
+				<th>' . __('Customer Name') . '</th>
+				<th>' . __('Credit Limit') . '</th>
+				<th>' . __('Status') . '</th>
+				<th>' . __('Due Date') . '</th>
+				<th>' . __('Action') . '</th>
+			</tr>';
+
+		$StatusText = array(0 => __('Normal'), 1 => __('Watch'), 2 => __('Stop'));
+
+		while ($MyRow = DB_fetch_array($Result)) {
+			echo '<tr>
+				<td><a href="' . $RootPath . '/CreditReviews.php?DebtorNo=' . $MyRow['debtorno'] . '">' . $MyRow['debtorno'] . '</a></td>
+				<td>' . $MyRow['name'] . '</td>
+				<td>' . $MyRow['creditlimit'] . '</td>
+				<td>' . $StatusText[$MyRow['creditstatus']] . '</td>
+				<td>' . ConvertSQLDate($MyRow['nextreviewdate']) . '</td>
+				<td><a href="' . $RootPath . '/CreditReviews.php?DebtorNo=' . $MyRow['debtorno'] . '">' . __('Review') . '</a></td>
+			</tr>';
+		}
+		echo '</table>';
+	} else {
+		prnMsg(__('No customers are currently due for review'), 'info');
+	}
+} elseif ($Report == 'over_limit') {
+	echo '<h3>' . __('Customers Over Credit Limit') . '</h3>';
+
+	$SQL = "SELECT
+				dm.debtorno,
+				dm.name,
+				dm.creditlimit,
+				dm.creditstatus,
+				COALESCE(SUM(dt.ovamount), 0) as outstanding
+			FROM debtorsmaster dm
+			LEFT JOIN debtortrans dt ON dm.debtorno = dt.debtorno AND dt.settled = 0
+			GROUP BY dm.debtorno, dm.name, dm.creditlimit, dm.creditstatus
+			HAVING outstanding > dm.creditlimit
+			ORDER BY outstanding DESC";
+
+	$Result = DB_query($SQL);
+
+	if (DB_num_rows($Result) > 0) {
+		echo '<table class="selection">
+			<tr>
+				<th>' . __('Customer Code') . '</th>
+				<th>' . __('Customer Name') . '</th>
+				<th>' . __('Credit Limit') . '</th>
+				<th>' . __('Outstanding') . '</th>
+				<th>' . __('Over By') . '</th>
+				<th>' . __('Status') . '</th>
+				<th>' . __('Action') . '</th>
+			</tr>';
+
+		$StatusText = array(0 => __('Normal'), 1 => __('Watch'), 2 => __('Stop'));
+
+		while ($MyRow = DB_fetch_array($Result)) {
+			$OverBy = $MyRow['outstanding'] - $MyRow['creditlimit'];
+			echo '<tr>
+				<td><a href="' . $RootPath . '/CreditCustomerStatus.php?DebtorNo=' . $MyRow['debtorno'] . '">' . $MyRow['debtorno'] . '</a></td>
+				<td>' . $MyRow['name'] . '</td>
+				<td>' . $MyRow['creditlimit'] . '</td>
+				<td>' . $MyRow['outstanding'] . '</td>
+				<td>' . $OverBy . '</td>
+				<td>' . $StatusText[$MyRow['creditstatus']] . '</td>
+				<td><a href="' . $RootPath . '/CreditCustomerStatus.php?DebtorNo=' . $MyRow['debtorno'] . '">' . __('Manage') . '</a></td>
+			</tr>';
+		}
+		echo '</table>';
+	} else {
+		prnMsg(__('No customers are currently over their credit limit'), 'info');
+	}
+} elseif ($Report == 'on_watch_stop') {
+	echo '<h3>' . __('Customers on Watch or Stop') . '</h3>';
+
+	$SQL = "SELECT
+				debtorno,
+				name,
+				creditlimit,
+				creditstatus
+			FROM debtorsmaster
+			WHERE creditstatus > 0
+			ORDER BY creditstatus DESC, name ASC";
+
+	$Result = DB_query($SQL);
+
+	if (DB_num_rows($Result) > 0) {
+		echo '<table class="selection">
+			<tr>
+				<th>' . __('Customer Code') . '</th>
+				<th>' . __('Customer Name') . '</th>
+				<th>' . __('Credit Limit') . '</th>
+				<th>' . __('Status') . '</th>
+				<th>' . __('Action') . '</th>
+			</tr>';
+
+		$StatusText = array(0 => __('Normal'), 1 => __('Watch'), 2 => __('Stop'));
+
+		while ($MyRow = DB_fetch_array($Result)) {
+			echo '<tr>
+				<td><a href="' . $RootPath . '/CreditCustomerStatus.php?DebtorNo=' . $MyRow['debtorno'] . '">' . $MyRow['debtorno'] . '</a></td>
+				<td>' . $MyRow['name'] . '</td>
+				<td>' . $MyRow['creditlimit'] . '</td>
+				<td>' . $StatusText[$MyRow['creditstatus']] . '</td>
+				<td><a href="' . $RootPath . '/CreditCustomerStatus.php?DebtorNo=' . $MyRow['debtorno'] . '">' . __('Manage') . '</a></td>
+			</tr>';
+		}
+		echo '</table>';
+	} else {
+		prnMsg(__('No customers are currently on watch or stop'), 'info');
+	}
+}
+
+echo '<br /><form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Report Options') . '</legend>
+		<field>
+			<label for="Report">' . __('Select Report') . ':</label>
+			<select name="Report" id="Report">
+				<option value="due_for_review"' . ($Report == 'due_for_review' ? ' selected="selected"' : '') . '>' . __('Due for Review') . '</option>
+				<option value="over_limit"' . ($Report == 'over_limit' ? ' selected="selected"' : '') . '>' . __('Over Credit Limit') . '</option>
+				<option value="on_watch_stop"' . ($Report == 'on_watch_stop' ? ' selected="selected"' : '') . '>' . __('On Watch or Stop') . '</option>
+			</select>
+		</field>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" value="' . __('Generate Report') . '" />
+	</div>
+</form>';
+
+include('includes/footer.php');
diff --git a/CreditControlSettings.php b/CreditControlSettings.php
new file mode 100644
index 0000000..11d0dac
--- /dev/null
+++ b/CreditControlSettings.php
@@ -0,0 +1,157 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Control Settings');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditControlSettings';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="'.$RootPath.'/css/'.$Theme.'/images/maintenance.png" title="' . __('Settings') . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Errors = array();
+
+if (isset($_POST['submit'])) {
+	$InputError = 0;
+
+	if (!is_numeric(filter_number_format($_POST['InterestRate']))) {
+		$InputError = 1;
+		prnMsg(__('The interest rate must be numeric'), 'error');
+	} elseif (!is_numeric(filter_number_format($_POST['LateFee']))) {
+		$InputError = 1;
+		prnMsg(__('The late fee must be numeric'), 'error');
+	} elseif (!is_numeric($_POST['DaysBeforeCharge'])) {
+		$InputError = 1;
+		prnMsg(__('Days before charge must be numeric'), 'error');
+	} elseif (!is_numeric($_POST['DefaultReviewPeriod'])) {
+		$InputError = 1;
+		prnMsg(__('Default review period must be numeric'), 'error');
+	} elseif (!is_numeric($_POST['WriteOffThreshold'])) {
+		$InputError = 1;
+		prnMsg(__('Write-off threshold must be numeric'), 'error');
+	}
+
+	if ($InputError == 0) {
+		$Settings = array(
+			'InterestRate' => $_POST['InterestRate'],
+			'LateFee' => $_POST['LateFee'],
+			'DaysBeforeCharge' => $_POST['DaysBeforeCharge'],
+			'DefaultReviewPeriod' => $_POST['DefaultReviewPeriod'],
+			'WriteOffThreshold' => $_POST['WriteOffThreshold'],
+			'InterestGLCode' => $_POST['InterestGLCode'],
+			'FeeGLCode' => $_POST['FeeGLCode'],
+			'BadDebtGLCode' => $_POST['BadDebtGLCode'],
+			'ReminderStage1Days' => $_POST['ReminderStage1Days'],
+			'ReminderStage2Days' => $_POST['ReminderStage2Days'],
+			'ReminderStage3Days' => $_POST['ReminderStage3Days'],
+			'ReminderStage1Text' => $_POST['ReminderStage1Text'],
+			'ReminderStage2Text' => $_POST['ReminderStage2Text'],
+			'ReminderStage3Text' => $_POST['ReminderStage3Text']
+		);
+
+		foreach ($Settings as $Key => $Value) {
+			$SQL = "SELECT COUNT(*) FROM creditconfig WHERE configkey='" . $Key . "'";
+			$Result = DB_query($SQL);
+			$MyRow = DB_fetch_row($Result);
+
+			if ($MyRow[0] > 0) {
+				$SQL = "UPDATE creditconfig SET configvalue='" . $Value . "' WHERE configkey='" . $Key . "'";
+			} else {
+				$SQL = "INSERT INTO creditconfig (configkey, configvalue) VALUES ('" . $Key . "', '" . $Value . "')";
+			}
+			DB_query($SQL);
+		}
+
+		prnMsg(__('Credit control settings have been saved'), 'success');
+	}
+}
+
+$SQL = "SELECT configkey, configvalue FROM creditconfig";
+$Result = DB_query($SQL);
+$Settings = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	$Settings[$MyRow['configkey']] = $MyRow['configvalue'];
+}
+
+function GetSetting($Key, $Default = '') {
+	global $Settings;
+	return isset($Settings[$Key]) ? $Settings[$Key] : $Default;
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Reminder Settings') . '</legend>
+		<field>
+			<label for="ReminderStage1Days">' . __('Stage 1 Days Overdue') . ':</label>
+			<input type="text" name="ReminderStage1Days" value="' . GetSetting('ReminderStage1Days', '14') . '" size="5" />
+		</field>
+		<field>
+			<label for="ReminderStage1Text">' . __('Stage 1 Letter Text') . ':</label>
+			<textarea name="ReminderStage1Text" rows="4">' . GetSetting('ReminderStage1Text', 'We note that the following invoices remain outstanding...') . '</textarea>
+		</field>
+		<field>
+			<label for="ReminderStage2Days">' . __('Stage 2 Days Overdue') . ':</label>
+			<input type="text" name="ReminderStage2Days" value="' . GetSetting('ReminderStage2Days', '30') . '" size="5" />
+		</field>
+		<field>
+			<label for="ReminderStage2Text">' . __('Stage 2 Letter Text') . ':</label>
+			<textarea name="ReminderStage2Text" rows="4">' . GetSetting('ReminderStage2Text', 'We regret that despite our previous reminders, your account remains outstanding...') . '</textarea>
+		</field>
+		<field>
+			<label for="ReminderStage3Days">' . __('Stage 3 Days Overdue') . ':</label>
+			<input type="text" name="ReminderStage3Days" value="' . GetSetting('ReminderStage3Days', '45') . '" size="5" />
+		</field>
+		<field>
+			<label for="ReminderStage3Text">' . __('Stage 3 Letter Text') . ':</label>
+			<textarea name="ReminderStage3Text" rows="4">' . GetSetting('ReminderStage3Text', 'Final notice: If payment is not received within 7 days, we will place your account on stop...') . '</textarea>
+		</field>
+	</fieldset>
+	<fieldset>
+		<legend>' . __('Interest and Fees') . '</legend>
+		<field>
+			<label for="InterestRate">' . __('Annual Interest Rate (%)') . ':</label>
+			<input type="text" name="InterestRate" value="' . GetSetting('InterestRate', '8') . '" size="10" />
+		</field>
+		<field>
+			<label for="LateFee">' . __('Monthly Late Fee') . ':</label>
+			<input type="text" name="LateFee" value="' . GetSetting('LateFee', '25') . '" size="10" />
+		</field>
+		<field>
+			<label for="DaysBeforeCharge">' . __('Days Before Charging Interest') . ':</label>
+			<input type="text" name="DaysBeforeCharge" value="' . GetSetting('DaysBeforeCharge', '30') . '" size="10" />
+		</field>
+		<field>
+			<label for="InterestGLCode">' . __('Interest Income GL Code') . ':</label>
+			<input type="text" name="InterestGLCode" value="' . GetSetting('InterestGLCode') . '" size="20" />
+		</field>
+		<field>
+			<label for="FeeGLCode">' . __('Late Fee Income GL Code') . ':</label>
+			<input type="text" name="FeeGLCode" value="' . GetSetting('FeeGLCode') . '" size="20" />
+		</field>
+	</fieldset>
+	<fieldset>
+		<legend>' . __('Credit Control Settings') . '</legend>
+		<field>
+			<label for="DefaultReviewPeriod">' . __('Default Credit Review Period (months)') . ':</label>
+			<input type="text" name="DefaultReviewPeriod" value="' . GetSetting('DefaultReviewPeriod', '12') . '" size="10" />
+		</field>
+		<field>
+			<label for="WriteOffThreshold">' . __('Write-off Approval Threshold') . ':</label>
+			<input type="text" name="WriteOffThreshold" value="' . GetSetting('WriteOffThreshold', '1000') . '" size="10" />
+		</field>
+		<field>
+			<label for="BadDebtGLCode">' . __('Bad Debt GL Code') . ':</label>
+			<input type="text" name="BadDebtGLCode" value="' . GetSetting('BadDebtGLCode') . '" size="20" />
+		</field>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="submit" value="' . __('Save Settings') . '" />
+	</div>
+</form>';
+
+include('includes/footer.php');
diff --git a/CreditCustomerHistory.php b/CreditCustomerHistory.php
new file mode 100644
index 0000000..8eccc82
--- /dev/null
+++ b/CreditCustomerHistory.php
@@ -0,0 +1,251 @@
+<?php
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Customer Credit History');
+$ViewTopic = 'AccountsReceivable';
+$BookMark = 'CreditCustomerHistory';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="'.$RootPath.'/css/'.$Theme.'/images/history.png" title="' . __('History') . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+}
+
+if (isset($DebtorNo)) {
+
+	$SQL = "SELECT name FROM debtorsmaster WHERE debtorno='" . $DebtorNo . "'";
+	$Result = DB_query($SQL);
+
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('Customer not found'), 'error');
+	} else {
+		$MyRow = DB_fetch_array($Result);
+
+		echo '<h2>' . $DebtorNo . ' - ' . $MyRow['name'] . '</h2>';
+
+		echo '<h3>' . __('Reviews') . '</h3>';
+
+		$SQL = "SELECT
+					reviewdate,
+					userid,
+					outcome,
+					creditlimit,
+					nextreviewdate,
+					notes
+				FROM creditreviews
+				WHERE debtorno='" . $DebtorNo . "'
+				ORDER BY reviewdate DESC";
+
+		$Result = DB_query($SQL);
+
+		if (DB_num_rows($Result) > 0) {
+			echo '<table class="selection">
+				<tr>
+					<th>' . __('Date') . '</th>
+					<th>' . __('User') . '</th>
+					<th>' . __('Outcome') . '</th>
+					<th>' . __('Limit') . '</th>
+					<th>' . __('Next Review') . '</th>
+				</tr>';
+
+			while ($MyRow = DB_fetch_array($Result)) {
+				echo '<tr>
+					<td>' . ConvertSQLDate($MyRow['reviewdate']) . '</td>
+					<td>' . $MyRow['userid'] . '</td>
+					<td>' . $MyRow['outcome'] . '</td>
+					<td>' . $MyRow['creditlimit'] . '</td>
+					<td>' . ConvertSQLDate($MyRow['nextreviewdate']) . '</td>
+				</tr>';
+			}
+			echo '</table>';
+		} else {
+			prnMsg(__('No reviews for this customer'), 'info');
+		}
+
+		echo '<br /><h3>' . __('Status Changes') . '</h3>';
+
+		$SQL = "SELECT
+					actiondate,
+					userid,
+					actiontype,
+					reason,
+					oldstatus,
+					newstatus
+				FROM creditactions
+				WHERE debtorno='" . $DebtorNo . "'
+				ORDER BY actiondate DESC";
+
+		$StatusText = array(0 => __('Normal'), 1 => __('Watch'), 2 => __('Stop'));
+
+		$Result = DB_query($SQL);
+
+		if (DB_num_rows($Result) > 0) {
+			echo '<table class="selection">
+				<tr>
+					<th>' . __('Date') . '</th>
+					<th>' . __('User') . '</th>
+					<th>' . __('From') . '</th>
+					<th>' . __('To') . '</th>
+					<th>' . __('Reason') . '</th>
+				</tr>';
+
+			while ($MyRow = DB_fetch_array($Result)) {
+				echo '<tr>
+					<td>' . ConvertSQLDate($MyRow['actiondate']) . '</td>
+					<td>' . $MyRow['userid'] . '</td>
+					<td>' . $StatusText[$MyRow['oldstatus']] . '</td>
+					<td>' . $StatusText[$MyRow['newstatus']] . '</td>
+					<td>' . substr($MyRow['reason'], 0, 50) . '...</td>
+				</tr>';
+			}
+			echo '</table>';
+		} else {
+			prnMsg(__('No status changes for this customer'), 'info');
+		}
+
+		echo '<br /><h3>' . __('Write-Offs') . '</h3>';
+
+		$SQL = "SELECT
+					writeoffdate,
+					userid,
+					amount,
+					currcode,
+					reason,
+					approvalstatus,
+					approvedby
+				FROM creditwriteoffs
+				WHERE debtorno='" . $DebtorNo . "'
+				ORDER BY writeoffdate DESC";
+
+		$Result = DB_query($SQL);
+
+		if (DB_num_rows($Result) > 0) {
+			echo '<table class="selection">
+				<tr>
+					<th>' . __('Date') . '</th>
+					<th>' . __('User') . '</th>
+					<th>' . __('Amount') . '</th>
+					<th>' . __('Status') . '</th>
+					<th>' . __('Reason') . '</th>
+				</tr>';
+
+			while ($MyRow = DB_fetch_array($Result)) {
+				$Status = ($MyRow['approvalstatus'] == 0) ? __('Approved') : __('Pending');
+				echo '<tr>
+					<td>' . ConvertSQLDate($MyRow['writeoffdate']) . '</td>
+					<td>' . $MyRow['userid'] . '</td>
+					<td>' . $MyRow['amount'] . ' ' . $MyRow['currcode'] . '</td>
+					<td>' . $Status . '</td>
+					<td>' . substr($MyRow['reason'], 0, 50) . '...</td>
+				</tr>';
+			}
+			echo '</table>';
+		} else {
+			prnMsg(__('No write-offs for this customer'), 'info');
+		}
+
+		echo '<br /><h3>' . __('Reminders Sent') . '</h3>';
+
+		$SQL = "SELECT
+					sentdate,
+					stage,
+					amountincluded,
+					currcode,
+					emailaddress,
+					emailsent
+				FROM creditreminders
+				WHERE debtorno='" . $DebtorNo . "'
+				ORDER BY sentdate DESC";
+
+		$Result = DB_query($SQL);
+
+		if (DB_num_rows($Result) > 0) {
+			echo '<table class="selection">
+				<tr>
+					<th>' . __('Date') . '</th>
+					<th>' . __('Stage') . '</th>
+					<th>' . __('Amount') . '</th>
+					<th>' . __('Email') . '</th>
+					<th>' . __('Sent') . '</th>
+				</tr>';
+
+			while ($MyRow = DB_fetch_array($Result)) {
+				$Sent = $MyRow['emailsent'] ? __('Yes') : __('No');
+				echo '<tr>
+					<td>' . ConvertSQLDate($MyRow['sentdate']) . '</td>
+					<td>' . __('Stage') . ' ' . $MyRow['stage'] . '</td>
+					<td>' . $MyRow['amountincluded'] . ' ' . $MyRow['currcode'] . '</td>
+					<td>' . $MyRow['emailaddress'] . '</td>
+					<td>' . $Sent . '</td>
+				</tr>';
+			}
+			echo '</table>';
+		} else {

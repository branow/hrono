+-- Add credit control fields to debtorsmaster table
+ALTER TABLE `debtorsmaster` ADD COLUMN `creditstatus` INT NOT NULL DEFAULT '0' COMMENT '0=normal, 1=watch, 2=stop' AFTER `creditlimit`;
+ALTER TABLE `debtorsmaster` ADD COLUMN `nextreviewdate` DATE NOT NULL DEFAULT '1000-01-01' AFTER `creditstatus`;

diff --git a/includes/EarlyPaymentDiscount.php b/includes/EarlyPaymentDiscount.php
new file mode 100644
index 0000000..fe4e665
--- /dev/null
+++ b/includes/EarlyPaymentDiscount.php
@@ -0,0 +1,124 @@
+<?php
+
+/* Helpers for early payment discount terms ("2% 10, net 30").
+ * paymentterms.discountpercent is a percentage (2 = 2%), paymentterms.discountdays
+ * counts days from the invoice date. 0 percent or 0 days means no discount.
+ * All amounts are in the invoice currency. */
+
+/* Last date (Y-m-d) the discount can be taken, or '' when the terms carry no discount */
+function EarlyPaymentDiscountDate($TranDate, $DiscountPercent, $DiscountDays) {
+	if ($DiscountPercent <= 0 OR $DiscountDays <= 0) {
+		return '';
+	}
+	return date('Y-m-d', strtotime($TranDate . ' +' . (int) $DiscountDays . ' days'));
+}
+
+/* Discount on an open balance, rounded to the currency decimal places */
+function EarlyPaymentDiscountAmount($Balance, $DiscountPercent, $DecimalPlaces) {
+	if ($DiscountPercent <= 0 OR $Balance <= 0) {
+		return 0;
+	}
+	return round($Balance * $DiscountPercent / 100, $DecimalPlaces);
+}
+
+/* HTML table of a customer's open invoices that can still be paid with an early payment discount today
+ * (balance, discount, last date, amount to pay), or '' when there are none. */
+function EarlyPaymentDiscountOpenInvoicesHTML($DebtorNo, $DecimalPlaces) {
+	$SQL = "SELECT debtortrans.transno,
+					debtortrans.trandate,
+					debtortrans.balance,
+					paymentterms.discountpercent,
+					paymentterms.discountdays
+				FROM debtortrans
+				INNER JOIN debtorsmaster ON debtortrans.debtorno = debtorsmaster.debtorno
+				INNER JOIN paymentterms ON debtorsmaster.paymentterms = paymentterms.termsindicator
+				WHERE debtortrans.debtorno = '" . $DebtorNo . "'
+				AND debtortrans.type = 10
+				AND debtortrans.settled = 0
+				AND debtortrans.balance > 0
+				AND paymentterms.discountpercent > 0
+				AND paymentterms.discountdays > 0
+				AND DATE_ADD(debtortrans.trandate, INTERVAL paymentterms.discountdays DAY) >= CURRENT_DATE
+				ORDER BY debtortrans.trandate, debtortrans.transno";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) == 0) {
+		return '';
+	}
+	$HTML = '<table class="selection">
+			<tr>
+				<th colspan="5">' . __('Open invoices that can still be paid with an early payment discount') . '</th>
+			</tr>
+			<tr>
+				<th>' . __('Invoice') . '</th>
+				<th>' . __('Balance') . '</th>
+				<th>' . __('Discount') . '</th>
+				<th>' . __('Discount Date') . '</th>
+				<th>' . __('Amount To Pay By Discount Date') . '</th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Discount = EarlyPaymentDiscountAmount($MyRow['balance'], $MyRow['discountpercent'], $DecimalPlaces);
+		$HTML .= '<tr class="striped_row">
+				<td>' . $MyRow['transno'] . '</td>
+				<td class="number">' . locale_number_format($MyRow['balance'], $DecimalPlaces) . '</td>
+				<td class="number">' . locale_number_format($MyRow['discountpercent'], 2) . '% (' . locale_number_format($Discount, $DecimalPlaces) . ')</td>
+				<td class="date">' . ConvertSQLDate(EarlyPaymentDiscountDate($MyRow['trandate'], $MyRow['discountpercent'], $MyRow['discountdays'])) . '</td>
+				<td class="number">' . locale_number_format($MyRow['balance'] - $Discount, $DecimalPlaces) . '</td>
+			</tr>';
+	}
+	return $HTML . '</table><br />';
+}
+
+/* HTML table of what we owe a supplier on open invoices that can still be paid with an early payment
+ * discount today (balance, discount, last date, amount to pay), or '' when there are none. */
+function EarlyPaymentDiscountSupplierInvoicesHTML($SupplierID, $DecimalPlaces) {
+	$SQL = "SELECT supptrans.transno,
+					supptrans.suppreference,
+					supptrans.trandate,
+					supptrans.balance,
+					paymentterms.discountpercent,
+					paymentterms.discountdays
+				FROM supptrans
+				INNER JOIN suppliers ON supptrans.supplierno = suppliers.supplierid
+				INNER JOIN paymentterms ON suppliers.paymentterms = paymentterms.termsindicator
+				WHERE supptrans.supplierno = '" . $SupplierID . "'
+				AND supptrans.type = 20
+				AND supptrans.settled = 0
+				AND supptrans.balance > 0
+				AND paymentterms.discountpercent > 0
+				AND paymentterms.discountdays > 0
+				AND DATE_ADD(supptrans.trandate, INTERVAL paymentterms.discountdays DAY) >= CURRENT_DATE
+				ORDER BY supptrans.trandate, supptrans.transno";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) == 0) {
+		return '';
+	}
+	$HTML = '<table class="selection">
+			<tr>
+				<th colspan="6">' . __('Open invoices that can still be paid with an early payment discount') . '</th>
+			</tr>
+			<tr>
+				<th>' . __('Invoice') . '</th>
+				<th>' . __('Reference') . '</th>
+				<th>' . __('Balance') . '</th>
+				<th>' . __('Discount') . '</th>
+				<th>' . __('Discount Date') . '</th>
+				<th>' . __('Amount To Pay By Discount Date') . '</th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Discount = EarlyPaymentDiscountAmount($MyRow['balance'], $MyRow['discountpercent'], $DecimalPlaces);
+		$HTML .= '<tr class="striped_row">
+				<td>' . $MyRow['transno'] . '</td>
+				<td>' . htmlspecialchars($MyRow['suppreference']) . '</td>
+				<td class="number">' . locale_number_format($MyRow['balance'], $DecimalPlaces) . '</td>
+				<td class="number">' . locale_number_format($MyRow['discountpercent'], 2) . '% (' . locale_number_format($Discount, $DecimalPlaces) . ')</td>
+				<td class="date">' . ConvertSQLDate(EarlyPaymentDiscountDate($MyRow['trandate'], $MyRow['discountpercent'], $MyRow['discountdays'])) . '</td>
+				<td class="number">' . locale_number_format($MyRow['balance'] - $Discount, $DecimalPlaces) . '</td>
+			</tr>';
+	}
+	return $HTML . '</table><br />';
+}
+
+/* True if the discount can still be taken on $AsAtDate (both Y-m-d); the discount date itself is inside the period */
+function EarlyPaymentDiscountOpen($DiscountDate, $AsAtDate) {
+	return $DiscountDate != '' AND $AsAtDate <= $DiscountDate;
+}

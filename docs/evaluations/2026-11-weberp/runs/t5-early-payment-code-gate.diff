diff --git a/sql/updates/44.php b/sql/updates/44.php
new file mode 100644
index 0000000..19fbf3f
--- /dev/null
+++ b/sql/updates/44.php
@@ -0,0 +1,11 @@
+<?php
+
+// Early payment discount on payment terms, e.g. "2% 10, net 30".
+// Existing terms get 0% / 0 days, i.e. no early payment discount.
+// discountpercent is a percentage (2 = 2%), discountdays counts from the invoice date.
+
+// AddColumn($Column, $Table, $Type, $Null, $Default, $After)
+AddColumn('discountpercent', 'paymentterms', 'double', ' NOT NULL ', '0', 'dayinfollowingmonth');
+AddColumn('discountdays', 'paymentterms', 'smallint', ' NOT NULL ', '0', 'discountpercent');
+
+UpdateDBNo(basename(__FILE__, '.php'), __('Early payment discount on payment terms'));

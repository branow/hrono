diff --git a/CreditCharges.php b/CreditCharges.php
new file mode 100644
index 0000000..233f7d2
--- /dev/null
+++ b/CreditCharges.php
@@ -0,0 +1,242 @@
+<?php
+
+/* Month end late payment interest and fees, and waivers of charges.
+Credit control sees what will be charged to whom, can leave customers out, and confirms. The same month is never charged twice to a
+customer. Charges are customer account entries (types 51 interest, 52 fee) in the customer's currency, posted to the income
+accounts Finance chose; a waiver (type 53) reverses a charge in the account and in the ledger. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Month End Interest and Late Fees');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditCharges';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Rate = (float) CreditControlSetting('CreditInterestRate', 0);
+$Fee = (float) CreditControlSetting('CreditLateFee', 0);
+$ChargeDays = (int) CreditControlSetting('CreditChargeDays', 30);
+$InterestAccount = CreditControlSetting('CreditInterestAccount', '');
+$FeeAccount = CreditControlSetting('CreditFeeAccount', '');
+
+if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+	if (($Rate > 0 and $InterestAccount == '') or ($Fee > 0 and $FeeAccount == '')) {
+		prnMsg(__('The general ledger accounts for interest and fees have not been set in the credit control settings'), 'error');
+		echo '<div class="centre"><a href="' . $RootPath . '/CreditControlSettings.php">' . __('Credit Control Settings') . '</a></div>';
+		include('includes/footer.php');
+		exit();
+	}
+}
+if ($Rate <= 0 and $Fee <= 0) {
+	prnMsg(__('Neither an interest rate nor a late fee has been set in the credit control settings'), 'warn');
+}
+
+/* ---------- Waive a charge ---------- */
+if (isset($_POST['Waive'])) {
+	$ChargeID = (int) $_POST['ChargeID'];
+	$Result = DB_query("SELECT * FROM creditcharges WHERE chargeid='" . $ChargeID . "' AND waived=0");
+	if (trim($_POST['WaiveReason']) == '') {
+		prnMsg(__('A reason for the waiver must be entered'), 'error');
+	} elseif (DB_num_rows($Result) == 0) {
+		prnMsg(__('That charge does not exist or has already been waived'), 'error');
+	} else {
+		$Charge = DB_fetch_array($Result);
+		$Status = CreditGetStatus($Charge['debtorno']);
+		$Type = ($Charge['chargetype'] == 'interest') ? CREDIT_TYPE_INTEREST : CREDIT_TYPE_FEE;
+		$IncomeAccount = ($Charge['chargetype'] == 'interest') ? $InterestAccount : $FeeAccount;
+		$Original = DB_query("SELECT id, balance FROM debtortrans WHERE debtorno='" . $Charge['debtorno'] . "' AND type='" . $Type . "' AND transno='" . $Charge['transno'] . "'");
+		$OriginalRow = DB_fetch_array($Original);
+		$WaiveDate = date('Y-m-d');
+		DB_Txn_Begin();
+		$Waiver = CreditInsertDebtorTrans($Status, CREDIT_TYPE_WAIVER, -$Charge['amount'], $WaiveDate,
+			__('Waiver') . ' ' . $Charge['chargemonth'], $IncomeAccount,
+			__('Late charge waived') . ' ' . $Charge['chargemonth'] . ': ' . $_POST['WaiveReason']);
+		/* net the waiver against the charge; anything the customer already paid stays as a credit on the account */
+		$Allocate = min($OriginalRow['balance'], $Charge['amount']);
+		if ($Allocate > 0) {
+			CreditAllocate($Waiver['id'], CREDIT_TYPE_WAIVER, $Waiver['transno'], $Waiver['rate'], $WaiveDate,
+				array(array('id' => $OriginalRow['id'], 'amount' => $Allocate)), $Status['currcode']);
+		}
+		DB_query("UPDATE creditcharges SET waived=1,
+											waivetransno='" . $Waiver['transno'] . "',
+											waivedby='" . $_SESSION['UserID'] . "',
+											waivedate='" . $WaiveDate . "',
+											waivereason='" . $_POST['WaiveReason'] . "'
+					WHERE chargeid='" . $ChargeID . "'",
+				__('The charge could not be marked as waived because'), '', true);
+		CreditLog($Charge['debtorno'], 'WAIVER', $Charge['chargetype'] . ' ' . $Charge['chargemonth'] . ': ' . $_POST['WaiveReason'], $Charge['amount'], $Charge['currcode'], CREDIT_TYPE_WAIVER . '/' . $Waiver['transno']);
+		DB_Txn_Commit();
+		prnMsg(__('The charge has been waived and reversed in the general ledger'), 'success');
+	}
+}
+
+/* ---------- Month and charge date ---------- */
+$Month = (isset($_POST['Month']) and preg_match('/^\d{4}-\d{2}$/', $_POST['Month'])) ? $_POST['Month'] : date('Y-m');
+$MonthEnd = date('Y-m-t', strtotime($Month . '-01'));
+$AsAt = ($MonthEnd > date('Y-m-d')) ? date('Y-m-d') : $MonthEnd;
+$DaysInMonth = (int) date('t', strtotime($Month . '-01'));
+
+/* What each customer would be charged for the month (BR-19, BR-20, BR-22) */
+function CreditChargeProposal($DebtorNo, $Month, $AsAt, $DaysInMonth, $Rate, $Fee, $ChargeDays) {
+	$Status = CreditGetStatus($DebtorNo);
+	if ($Status === false) {
+		return false;
+	}
+	/* items past the grace period; late charges themselves do not attract interest (no interest on interest) */
+	$Base = 0;
+	$Count = 0;
+	foreach (CreditOverdueItems($DebtorNo, $AsAt, true, true) as $Item) {
+		if ($Item['daysoverdue'] >= $ChargeDays) {
+			$Base += $Item['balance'];
+			$Count++;
+		}
+	}
+	/* unallocated receipts and credits reduce what the customer is really overdue with */
+	$Result = DB_query("SELECT SUM(balance) FROM debtortrans WHERE debtorno='" . $DebtorNo . "' AND balance < 0");
+	$MyRow = DB_fetch_row($Result);
+	$Base = max(0, $Base + (float) $MyRow[0]);
+	$Proposal = array('status' => $Status, 'base' => $Base, 'interest' => 0, 'fee' => 0, 'done' => array());
+	if ($Base <= 0) {
+		return $Proposal;
+	}
+	$Result = DB_query("SELECT chargetype FROM creditcharges WHERE debtorno='" . $DebtorNo . "' AND chargemonth='" . $Month . "'");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Proposal['done'][$MyRow['chargetype']] = true;
+	}
+	if ($Rate > 0 and !$Status['interestexempt'] and !isset($Proposal['done']['interest'])) {
+		$Proposal['interest'] = round($Base * $Rate / 100 * $DaysInMonth / 365, $Status['decimalplaces']);
+	}
+	if ($Fee > 0 and !$Status['feeexempt'] and !isset($Proposal['done']['fee'])) {
+		$Proposal['fee'] = round($Fee * $Status['rate'], $Status['decimalplaces']);
+	}
+	return $Proposal;
+}
+
+/* ---------- Post the confirmed charges ---------- */
+if (isset($_POST['Post']) and isset($_POST['Include'])) {
+	$Posted = 0;
+	foreach ($_POST['Include'] as $DebtorNo => $On) {
+		$DebtorNo = DB_escape_string($DebtorNo); /* array keys are not escaped by session.php */
+		$Proposal = CreditChargeProposal($DebtorNo, $Month, $AsAt, $DaysInMonth, $Rate, $Fee, $ChargeDays);
+		if ($Proposal === false) {
+			continue;
+		}
+		$Status = $Proposal['status'];
+		DB_Txn_Begin();
+		foreach (array('interest' => array(CREDIT_TYPE_INTEREST, $InterestAccount, __('Late payment interest')),
+						'fee' => array(CREDIT_TYPE_FEE, $FeeAccount, __('Late payment fee'))) as $ChargeType => $Details) {
+			$Amount = $Proposal[$ChargeType];
+			if ($Amount <= 0) {
+				continue; /* nothing to charge, exempt or already charged for this month */
+			}
+			if ($ChargeType == 'interest') {
+				$Basis = $Rate . '% ' . __('per year on overdue balance') . ' ' . locale_number_format($Proposal['base'], $Status['decimalplaces']) . ' ' . __('for') . ' ' . $Month;
+			} else {
+				$Basis = __('Late fee for') . ' ' . $Month;
+			}
+			$Trans = CreditInsertDebtorTrans($Status, $Details[0], $Amount, $AsAt, $Details[2] . ' ' . $Month, $Details[1], $Details[2] . ' ' . $Month . ' - ' . $Basis);
+			DB_query("INSERT INTO creditcharges (debtorno, chargemonth, chargetype, amount, currcode, basis, transno, trandate, userid)
+						VALUES ('" . $DebtorNo . "', '" . $Month . "', '" . $ChargeType . "', '" . $Amount . "', '" . $Status['currcode'] . "',
+								'" . DB_escape_string($Basis) . "', '" . $Trans['transno'] . "', '" . $AsAt . "', '" . $_SESSION['UserID'] . "')",
+					__('The charge could not be recorded because'), '', true);
+			CreditLog($DebtorNo, 'CHARGE', DB_escape_string($Details[2] . ' ' . $Month . ' - ' . $Basis), $Amount, $Status['currcode'], $Details[0] . '/' . $Trans['transno']);
+			$Posted++;
+		}
+		DB_Txn_Commit();
+	}
+	prnMsg($Posted . ' ' . __('charges have been posted for') . ' ' . $Month, 'success');
+}
+
+/* ---------- Preview ---------- */
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Month to charge') . '</legend>
+		<field>
+			<label for="Month">' . __('Month') . ':</label>
+			<input type="month" name="Month" value="' . $Month . '" />
+			<fieldhelp>' . __('Overdue is measured at') . ' ' . ConvertSQLDate($AsAt) . ', ' . __('the charges are dated the same') . '</fieldhelp>
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Preview" value="' . __('Show What Will Be Charged') . '" /></div>
+</form><br />';
+
+$Result = DB_query("SELECT DISTINCT debtorno FROM debtortrans WHERE settled=0 AND balance > 0");
+$Proposals = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	$Proposal = CreditChargeProposal($MyRow['debtorno'], $Month, $AsAt, $DaysInMonth, $Rate, $Fee, $ChargeDays);
+	if ($Proposal !== false and ($Proposal['interest'] > 0 or $Proposal['fee'] > 0)) {
+		$Proposals[$MyRow['debtorno']] = $Proposal;
+	}
+}
+
+if (count($Proposals) == 0) {
+	prnMsg(__('Nothing to charge for') . ' ' . $Month, 'info');
+} else {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="Month" value="' . $Month . '" />
+		<table class="selection">
+			<tr><th>' . __('Charge') . '</th><th>' . __('Customer') . '</th><th>' . __('Overdue balance') . '</th><th>' . __('Interest') . '</th><th>' . __('Late fee') . '</th></tr>';
+	foreach ($Proposals as $DebtorNo => $Proposal) {
+		$Status = $Proposal['status'];
+		echo '<tr class="striped_row">
+				<td><input type="checkbox" name="Include[' . $DebtorNo . ']" checked="checked" /></td>
+				<td>' . htmlspecialchars($Status['name'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td class="number">' . locale_number_format($Proposal['base'], $Status['decimalplaces']) . ' ' . $Status['currcode'] . '</td>
+				<td class="number">' . locale_number_format($Proposal['interest'], $Status['decimalplaces']) . '</td>
+				<td class="number">' . locale_number_format($Proposal['fee'], $Status['decimalplaces']) . '</td>
+			</tr>';
+	}
+	echo '</table>
+		<div class="centre"><input type="submit" name="Post" value="' . __('Confirm and Post These Charges') . '" onclick="return confirm(\'' . __('Post these charges to the customer accounts and the general ledger?') . '\');" /></div>
+	</form><br />';
+}
+
+/* ---------- Charges of the month, with the waiver ---------- */
+$Result = DB_query("SELECT creditcharges.chargeid,
+							creditcharges.debtorno,
+							debtorsmaster.name,
+							creditcharges.chargetype,
+							creditcharges.amount,
+							creditcharges.currcode,
+							creditcharges.waived,
+							creditcharges.waivereason
+					FROM creditcharges
+					INNER JOIN debtorsmaster ON creditcharges.debtorno=debtorsmaster.debtorno
+					WHERE creditcharges.chargemonth='" . $Month . "'
+					ORDER BY debtorsmaster.name, creditcharges.chargetype");
+if (DB_num_rows($Result) > 0) {
+	echo '<table class="selection">
+			<tr><th colspan="5">' . __('Charges posted for') . ' ' . $Month . '</th></tr>
+			<tr><th>' . __('Customer') . '</th><th>' . __('Type') . '</th><th>' . __('Amount') . '</th><th colspan="2">' . __('Waive') . '</th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td>' . ($MyRow['chargetype'] == 'interest' ? __('Interest') : __('Late fee')) . '</td>
+				<td class="number">' . locale_number_format($MyRow['amount'], 2) . ' ' . $MyRow['currcode'] . '</td>';
+		if ($MyRow['waived']) {
+			echo '<td colspan="2">' . __('Waived') . ': ' . $MyRow['waivereason'] . '</td>';
+		} else {
+			echo '<td colspan="2">
+					<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+						<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+						<input type="hidden" name="Month" value="' . $Month . '" />
+						<input type="hidden" name="ChargeID" value="' . $MyRow['chargeid'] . '" />
+						<input type="text" name="WaiveReason" size="30" maxlength="200" placeholder="' . __('Reason') . '" />
+						<input type="submit" name="Waive" value="' . __('Waive') . '" />
+					</form>
+				</td>';
+		}
+		echo '</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/CreditControlReport.php b/CreditControlReport.php

diff --git a/CreditHeldOrders.php b/CreditHeldOrders.php
new file mode 100644
index 0000000..8c99a98
--- /dev/null
+++ b/CreditHeldOrders.php
@@ -0,0 +1,97 @@
+<?php
+
+/* Orders credit control has to look at:
+- orders held because they take the customer over the credit limit: released here before they can be dispatched or invoiced
+- open orders of customers on stop: dispatch is blocked until credit control releases the order
+- open orders of customers on watch: still supplied, listed so that credit control can follow them */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Orders Held or On Watch for Credit Control');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditHeldOrders';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if (isset($_POST['Release']) or isset($_POST['Hold'])) {
+	$OrderNo = (int) $_POST['OrderNo'];
+	$Result = DB_query("SELECT debtorno, creditheld FROM salesorders WHERE orderno='" . $OrderNo . "'");
+	if ($MyRow = DB_fetch_array($Result)) {
+		DB_Txn_Begin();
+		if (isset($_POST['Release'])) {
+			DB_query("UPDATE salesorders SET creditheld=2 WHERE orderno='" . $OrderNo . "'", '', '', true);
+			CreditLog($MyRow['debtorno'], 'ORDERRELEASE', __('Order') . ' ' . $OrderNo . ' ' . __('released by credit control'), 0, '', 'SO/' . $OrderNo);
+			prnMsg(__('Order') . ' ' . $OrderNo . ' ' . __('has been released'), 'success');
+		} else {
+			DB_query("UPDATE salesorders SET creditheld=1 WHERE orderno='" . $OrderNo . "'", '', '', true);
+			CreditLog($MyRow['debtorno'], 'ORDERHOLD', __('Order') . ' ' . $OrderNo . ' ' . __('put back on credit hold'), 0, '', 'SO/' . $OrderNo);
+			prnMsg(__('Order') . ' ' . $OrderNo . ' ' . __('is held again'), 'success');
+		}
+		DB_Txn_Commit();
+	}
+}
+
+function CreditOrderTable($Heading, $Where, $Buttons) {
+	global $RootPath;
+	$SQL = "SELECT salesorders.orderno,
+					salesorders.debtorno,
+					salesorders.orddate,
+					salesorders.creditheld,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					currencies.decimalplaces,
+					holdreasons.reasondescription,
+					SUM(salesorderdetails.unitprice * (salesorderdetails.quantity - salesorderdetails.qtyinvoiced) * (1 - salesorderdetails.discountpercent)) AS ordervalue
+			FROM salesorders
+			INNER JOIN salesorderdetails ON salesorders.orderno=salesorderdetails.orderno
+			INNER JOIN debtorsmaster ON salesorders.debtorno=debtorsmaster.debtorno
+			INNER JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+			INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+			WHERE salesorders.quotation=0
+				AND salesorderdetails.completed=0
+				AND " . $Where . "
+			GROUP BY salesorders.orderno, salesorders.debtorno, salesorders.orddate, salesorders.creditheld, debtorsmaster.name, debtorsmaster.currcode, currencies.decimalplaces, holdreasons.reasondescription
+			ORDER BY salesorders.orddate";
+	$Result = DB_query($SQL);
+	echo '<table class="selection">
+			<tr><th colspan="6">' . $Heading . '</th></tr>';
+	if (DB_num_rows($Result) == 0) {
+		echo '<tr><td colspan="6">' . __('None') . '</td></tr></table><br />';
+		return;
+	}
+	echo '<tr><th>' . __('Order') . '</th><th>' . __('Date') . '</th><th>' . __('Customer') . '</th><th>' . __('Credit status') . '</th><th>' . __('Value outstanding') . '</th><th></th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td><a href="' . $RootPath . '/OrderDetails.php?OrderNumber=' . $MyRow['orderno'] . '">' . $MyRow['orderno'] . '</a></td>
+				<td>' . ConvertSQLDate($MyRow['orddate']) . '</td>
+				<td><a href="' . $RootPath . '/CreditReview.php?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</a></td>
+				<td>' . htmlspecialchars($MyRow['reasondescription'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td class="number">' . locale_number_format($MyRow['ordervalue'], $MyRow['decimalplaces']) . ' ' . $MyRow['currcode'] . '</td>
+				<td>';
+		if ($Buttons) {
+			echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+					<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+					<input type="hidden" name="OrderNo" value="' . $MyRow['orderno'] . '" />';
+			if ($MyRow['creditheld'] == 2) {
+				echo __('Released') . ' <input type="submit" name="Hold" value="' . __('Hold Again') . '" />';
+			} else {
+				echo '<input type="submit" name="Release" value="' . __('Release') . '" />';
+			}
+			echo '</form>';
+		}
+		echo '</td></tr>';
+	}
+	echo '</table><br />';
+}
+
+CreditOrderTable(__('Held for credit control approval (over credit limit)'), "salesorders.creditheld=1", true);
+CreditOrderTable(__('Open orders of customers on stop'), "holdreasons.dissallowinvoices=1", true);
+CreditOrderTable(__('Open orders of customers on watch'), "holdreasons.dissallowinvoices=2", false);
+
+include('includes/footer.php');
diff --git a/CreditHistory.php b/CreditHistory.php

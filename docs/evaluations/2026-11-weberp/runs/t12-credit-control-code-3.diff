+}
+echo '<br />';
+
+/* Interest and fees */
+$Result = DB_query("SELECT chargemonth, chargetype, amount, currcode, trandate, waived, waivedate, waivereason
+					FROM creditcharges
+					WHERE debtorno='" . $DebtorNo . "'
+					ORDER BY chargeid DESC");
+echo '<table class="selection">

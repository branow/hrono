+	</fieldset>
+	<fieldset>
+		<legend>' . __('Interest and late fees, charged at month end') . '</legend>
+		<field>
+			<label for="CreditInterestRate">' . __('Interest rate per year (%), simple interest, 0 for none') . ':</label>
+			<input type="text" class="number" name="CreditInterestRate" size="7" maxlength="7" value="' . locale_number_format(CreditControlSetting('CreditInterestRate', 0), 2) . '" />
+		</field>
+		<field>
+			<label for="CreditLateFee">' . __('Late fee per customer per month in home currency, 0 for none') . ':</label>
+			<input type="text" class="number" name="CreditLateFee" size="10" maxlength="10" value="' . locale_number_format(CreditControlSetting('CreditLateFee', 0), 2) . '" />
+		</field>
+		<field>
+			<label for="CreditChargeDays">' . __('Days overdue before a balance is charged') . ':</label>
+			<input type="text" class="integer" name="CreditChargeDays" size="4" maxlength="4" value="' . CreditControlSetting('CreditChargeDays', 30) . '" />
+		</field>
+		<field>
+			<label for="CreditInterestAccount">' . __('Interest income account') . ':</label>' . CreditAccountSelect('CreditInterestAccount', CreditControlSetting('CreditInterestAccount', '')) . '
+		</field>
+		<field>
+			<label for="CreditFeeAccount">' . __('Late fee income account') . ':</label>' . CreditAccountSelect('CreditFeeAccount', CreditControlSetting('CreditFeeAccount', '')) . '
+		</field>
+	</fieldset>
+	<fieldset>
+		<legend>' . __('Reminder letters') . '</legend>
+		<field>
+			<label for="CreditReminderGapDays">' . __('Minimum days between two reminders to the same customer') . ':</label>
+			<input type="text" class="integer" name="CreditReminderGapDays" size="4" maxlength="3" value="' . CreditControlSetting('CreditReminderGapDays', 14) . '" />
+		</field>
+		<field>
+			<label for="CreditAutoStopAfterFinal">' . __('Put the customer on stop automatically after the final notice') . ':</label>
+			<input type="checkbox" name="CreditAutoStopAfterFinal"' . (CreditControlSetting('CreditAutoStopAfterFinal', 0) == 1 ? ' checked="checked"' : '') . ' />
+		</field>
+		<field>
+			<label for="CreditStopHoldReason">' . __('Credit status used for automatic stops (after a final notice or a write-off)') . ':</label>
+			<select name="CreditStopHoldReason">';
+$Result = DB_query("SELECT reasoncode, reasondescription FROM holdreasons WHERE dissallowinvoices=1 ORDER BY reasoncode");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option value="' . $MyRow['reasoncode'] . '"' . ($MyRow['reasoncode'] == CreditControlSetting('CreditStopHoldReason', '') ? ' selected="selected"' : '') . '>' . htmlspecialchars($MyRow['reasondescription'], ENT_QUOTES, 'UTF-8') . '</option>';

+++ b/CreditReview.php
@@ -0,0 +1,350 @@
+<?php
+
+/* Credit review of a customer: limit, status (normal, watch, stop), next review date, interest/fee exemptions, disputed
+invoices and notes. The only place where a credit limit or credit status is changed, every change is recorded. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Review');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditReview';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+}
+
+if (!isset($DebtorNo) or $DebtorNo == '') {
+	/* No customer yet - search for one */
+	if (isset($_POST['Search'])) {
+		$SQL = "SELECT debtorno, name, nextreviewdate
+				FROM debtorsmaster
+				WHERE (debtorno LIKE '%" . $_POST['Keywords'] . "%'
+					OR name LIKE '%" . $_POST['Keywords'] . "%')
+				ORDER BY name
+				LIMIT 50";
+		$Result = DB_query($SQL);
+		echo '<table class="selection">
+				<tr><th>' . __('Code') . '</th><th>' . __('Name') . '</th><th>' . __('Next Review') . '</th></tr>';
+		while ($MyRow = DB_fetch_array($Result)) {
+			echo '<tr class="striped_row">
+					<td><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '?DebtorNo=' . urlencode($MyRow['debtorno']) . '">' . $MyRow['debtorno'] . '</a></td>
+					<td>' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+					<td>' . ConvertSQLDate($MyRow['nextreviewdate']) . '</td>
+				</tr>';
+		}
+		echo '</table><br />';
+	}
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<fieldset>
+				<legend>' . __('Select a customer') . '</legend>
+				<field>
+					<label for="Keywords">' . __('Customer code or part of the name') . ':</label>
+					<input type="text" name="Keywords" size="20" maxlength="25" />
+				</field>
+			</fieldset>
+			<div class="centre"><input type="submit" name="Search" value="' . __('Search Now') . '" /></div>
+		</form>';
+	include('includes/footer.php');
+	exit();
+}
+
+$Status = CreditGetStatus($DebtorNo);
+if ($Status === false) {
+	prnMsg(__('The customer does not exist'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$CurrDecimalPlaces = $Status['decimalplaces'];
+
+/* ---------- Record a review ---------- */
+if (isset($_POST['RecordReview'])) {
+	$InputError = 0;
+	$NewLimit = filter_number_format($_POST['NewLimit']);
+	$NewReason = (int) $_POST['NewHoldReason'];
+	$NextReview = $_POST['NextReviewDate'];
+	$InterestExempt = isset($_POST['InterestExempt']) ? 1 : 0;
+	$FeeExempt = isset($_POST['FeeExempt']) ? 1 : 0;
+
+	if (!is_numeric($NewLimit) or $NewLimit < 0) {
+		$InputError = 1;
+		prnMsg(__('The credit limit must be a number that is not negative'), 'error');
+	}
+	if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $NextReview) or $NextReview <= date('Y-m-d')) {
+		$InputError = 1;
+		prnMsg(__('The next review date must be entered and must be in the future'), 'error');
+	}
+	if (trim($_POST['Notes']) == '') {
+		$InputError = 1;
+		prnMsg(__('The reason or notes for the review must be entered'), 'error');
+	}
+	$Result = DB_query("SELECT reasondescription, dissallowinvoices FROM holdreasons WHERE reasoncode='" . $NewReason . "'");
+	if (DB_num_rows($Result) == 0) {
+		$InputError = 1;
+		prnMsg(__('The credit status selected does not exist'), 'error');
+	} else {
+		$ReasonRow = DB_fetch_array($Result);
+	}
+
+	if ($InputError == 0) {
+		if ($ReasonRow['dissallowinvoices'] == 1 and $Status['level'] != 1) {
+			$Outcome = 'STOP';
+		} elseif ($ReasonRow['dissallowinvoices'] == 2 and $Status['level'] != 2) {
+			$Outcome = 'WATCH';
+		} elseif ($NewReason != $Status['holdreason'] and $ReasonRow['dissallowinvoices'] != 1 and $ReasonRow['dissallowinvoices'] != 2) {
+			$Outcome = 'NORMAL';
+		} elseif ($NewLimit > $Status['creditlimit']) {
+			$Outcome = 'RAISE';
+		} elseif ($NewLimit < $Status['creditlimit']) {
+			$Outcome = 'REDUCE';
+		} else {
+			$Outcome = 'CONFIRM';
+		}
+
+		DB_Txn_Begin();
+		/* BR-04: the limit changes as part of the review, so the limit and the reason are always recorded together */
+		DB_query("UPDATE debtorsmaster SET creditlimit='" . $NewLimit . "',
+											nextreviewdate='" . $NextReview . "',
+											interestexempt='" . $InterestExempt . "',
+											feeexempt='" . $FeeExempt . "'
+					WHERE debtorno='" . $DebtorNo . "'",
+				__('The customer could not be updated because'), '', true);
+		if ($NewLimit != $Status['creditlimit']) {
+			CreditLog($DebtorNo, 'LIMIT', $Status['creditlimit'] . ' -> ' . $NewLimit . ': ' . $_POST['Notes'], $NewLimit, $Status['currcode']);
+		}
+		if ($InterestExempt != $Status['interestexempt'] or $FeeExempt != $Status['feeexempt']) {
+			CreditLog($DebtorNo, 'EXEMPT', __('Interest exempt') . ': ' . $InterestExempt . ' ' . __('Fee exempt') . ': ' . $FeeExempt . ' - ' . $_POST['Notes']);
+		}
+		CreditSetHoldReason($DebtorNo, $NewReason, $_POST['Notes']);
+
+		DB_query("INSERT INTO creditreviews (debtorno,
+											reviewdate,
+											userid,
+											outcome,
+											oldlimit,
+											newlimit,
+											oldholdreason,
+											newholdreason,
+											notes,
+											nextreviewdate,
+											entered)
+					VALUES ('" . $DebtorNo . "',
+							CURRENT_DATE,
+							'" . $_SESSION['UserID'] . "',
+							'" . $Outcome . "',
+							'" . $Status['creditlimit'] . "',
+							'" . $NewLimit . "',
+							'" . $Status['holdreason'] . "',
+							'" . $NewReason . "',
+							'" . $_POST['Notes'] . "',
+							'" . $NextReview . "',
+							'" . date('Y-m-d H:i:s') . "')",
+				__('The review could not be recorded because'), '', true);
+		CreditLog($DebtorNo, 'REVIEW', $Outcome . ': ' . $_POST['Notes'] . ' (' . __('next review') . ' ' . $NextReview . ')', $NewLimit, $Status['currcode']);
+		DB_Txn_Commit();
+
+		prnMsg(__('The credit review has been recorded'), 'success');
+		$Status = CreditGetStatus($DebtorNo);
+	}
+}
+
+/* ---------- Disputed invoices ---------- */
+if (isset($_POST['SaveDisputes'])) {
+	if (trim($_POST['DisputeNote']) == '') {
+		prnMsg(__('A note about the dispute must be entered'), 'error');
+	} else {
+		DB_Txn_Begin();
+		$Result = DB_query("SELECT id, type, transno, disputed FROM debtortrans
+							WHERE debtorno='" . $DebtorNo . "' AND settled=0 AND balance > 0");
+		while ($MyRow = DB_fetch_array($Result)) {
+			$NewValue = isset($_POST['Disputed' . $MyRow['id']]) ? 1 : 0;
+			if ($NewValue != $MyRow['disputed']) {
+				DB_query("UPDATE debtortrans SET disputed='" . $NewValue . "' WHERE id='" . $MyRow['id'] . "'",
+						__('The invoice could not be updated because'), '', true);
+				CreditLog($DebtorNo, 'DISPUTE', ($NewValue ? __('Marked as disputed') : __('Dispute settled')) . ': ' . $MyRow['transno'] . ' - ' . $_POST['DisputeNote'], 0, $Status['currcode'], $MyRow['type'] . '/' . $MyRow['transno']);
+			}
+		}
+		DB_Txn_Commit();
+		prnMsg(__('The disputed invoices have been saved'), 'success');
+	}
+}
+
+/* ---------- Free note ---------- */
+if (isset($_POST['AddNote'])) {
+	if (trim($_POST['Note']) == '') {
+		prnMsg(__('The note must be entered'), 'error');

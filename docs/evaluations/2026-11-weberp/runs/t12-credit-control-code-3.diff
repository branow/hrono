+		<tr><td>' . __('Overdue') . '</td><td class="number">' . locale_number_format($Overdue, $CurrDecimalPlaces) . ' ' . $Status['currcode'] . '</td></tr>
+		<tr><td>' . __('Next review due') . '</td><td>' . ConvertSQLDate($Status['nextreviewdate']) . '</td></tr>
+	</table>
+	<div class="centre">
+		<a href="' . $RootPath . '/CreditHistory.php?DebtorNo=' . urlencode($DebtorNo) . '">' . __('Full credit control history') . '</a> |
+		<a href="' . $RootPath . '/CustomerInquiry.php?CustomerID=' . urlencode($DebtorNo) . '">' . __('Customer account inquiry') . '</a> |
+		<a href="' . $RootPath . '/CreditWriteOffs.php?DebtorNo=' . urlencode($DebtorNo) . '">' . __('Write off bad debt') . '</a>
+	</div>
+	<br />';
+
+/* ---------- Review form ---------- */
+if (isset($_POST['RecordReview']) and $InputError == 1) {

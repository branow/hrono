+++ b/CreditControlReport.php
@@ -0,0 +1,142 @@
+<?php
+
+/* Credit control report: customers due or overdue for a credit review, customers over their credit limit and by how much,
+customers on watch or on stop. Filter by sales rep and currency, totals in home currency. Sales reps only see their own customers. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Control Report');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditControlReport';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Salesman = isset($_POST['Salesman']) ? $_POST['Salesman'] : '';
+$Currency = isset($_POST['Currency']) ? $_POST['Currency'] : '';
+$ReviewDays = isset($_POST['ReviewDays']) ? (int) $_POST['ReviewDays'] : 0;
+if ($_SESSION['SalesmanLogin'] != '') {
+	$Salesman = $_SESSION['SalesmanLogin'];
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Selection') . '</legend>
+		<field>
+			<label for="ReviewDays">' . __('Include reviews due within the next days') . ':</label>
+			<input type="text" class="integer" name="ReviewDays" size="4" maxlength="4" value="' . $ReviewDays . '" />
+		</field>';
+if ($_SESSION['SalesmanLogin'] == '') {
+	echo '<field>
+			<label for="Salesman">' . __('Sales rep') . ':</label>
+			<select name="Salesman"><option value="">' . __('All') . '</option>';
+	$Result = DB_query("SELECT salesmancode, salesmanname FROM salesman ORDER BY salesmanname");
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<option value="' . $MyRow['salesmancode'] . '"' . ($MyRow['salesmancode'] == $Salesman ? ' selected="selected"' : '') . '>' . htmlspecialchars($MyRow['salesmanname'], ENT_QUOTES, 'UTF-8') . '</option>';
+	}
+	echo '</select>
+		</field>';
+}
+echo '<field>
+			<label for="Currency">' . __('Currency') . ':</label>
+			<select name="Currency"><option value="">' . __('All') . '</option>';
+$Result = DB_query("SELECT currabrev, currency FROM currencies ORDER BY currabrev");
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<option value="' . $MyRow['currabrev'] . '"' . ($MyRow['currabrev'] == $Currency ? ' selected="selected"' : '') . '>' . $MyRow['currabrev'] . '</option>';
+}
+echo '</select>
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Show" value="' . __('Show the Report') . '" /></div>
+</form><br />';
+
+$SQL = "SELECT debtorsmaster.debtorno,
+				debtorsmaster.name,
+				debtorsmaster.currcode,
+				debtorsmaster.creditlimit,
+				debtorsmaster.nextreviewdate,
+				holdreasons.reasondescription,
+				holdreasons.dissallowinvoices,
+				currencies.decimalplaces,
+				currencies.rate,
+				COALESCE(SUM(debtortrans.balance), 0) AS balance
+		FROM debtorsmaster
+		INNER JOIN holdreasons ON debtorsmaster.holdreason=holdreasons.reasoncode
+		INNER JOIN currencies ON debtorsmaster.currcode=currencies.currabrev
+		LEFT JOIN debtortrans ON debtorsmaster.debtorno=debtortrans.debtorno
+		WHERE 1=1 " . CreditVisibleCustomersSQL();
+if ($Salesman != '') {
+	$SQL .= " AND debtorsmaster.debtorno IN (SELECT debtorno FROM custbranch WHERE salesman='" . $Salesman . "')";
+}
+if ($Currency != '') {
+	$SQL .= " AND debtorsmaster.currcode='" . $Currency . "'";
+}
+$SQL .= " GROUP BY debtorsmaster.debtorno, debtorsmaster.name, debtorsmaster.currcode, debtorsmaster.creditlimit, debtorsmaster.nextreviewdate,
+					holdreasons.reasondescription, holdreasons.dissallowinvoices, currencies.decimalplaces, currencies.rate
+		ORDER BY debtorsmaster.name";
+$Result = DB_query($SQL);
+
+$Customers = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	$Customers[] = $MyRow;
+}
+
+$Decimals = $_SESSION['CompanyRecord']['decimalplaces'];
+$ReviewLimit = date('Y-m-d', strtotime('+' . $ReviewDays . ' days'));
+
+function CreditReportTable($Heading, $Rows, $Columns, $Decimals) {
+	global $RootPath;
+	echo '<table class="selection"><tr><th colspan="' . count($Columns) . '">' . $Heading . ' (' . count($Rows) . ')</th></tr><tr>';
+	foreach ($Columns as $Column) {
+		echo '<th>' . $Column . '</th>';
+	}
+	echo '</tr>';
+	$Total = 0;
+	foreach ($Rows as $Row) {
+		echo '<tr class="striped_row">';
+		foreach ($Row['cells'] as $Cell) {
+			echo '<td' . (is_array($Cell) ? ' class="number"' : '') . '>' . (is_array($Cell) ? $Cell[0] : $Cell) . '</td>';
+		}
+		echo '</tr>';
+		$Total += $Row['home'];
+	}
+	echo '<tr><th colspan="' . (count($Columns) - 1) . '">' . __('Total in home currency') . '</th><th class="number">' . locale_number_format($Total, $Decimals) . '</th></tr></table><br />';
+}
+
+$Due = array();
+$Over = array();
+$Flagged = array();
+foreach ($Customers as $Customer) {
+	$Name = '<a href="' . $RootPath . '/CreditReview.php?DebtorNo=' . urlencode($Customer['debtorno']) . '">' . htmlspecialchars($Customer['name'], ENT_QUOTES, 'UTF-8') . '</a>';
+	if ($Customer['nextreviewdate'] <= $ReviewLimit) {
+		$Late = ($Customer['nextreviewdate'] < date('Y-m-d')) ? ' (' . __('overdue') . ')' : '';
+		$Due[] = array('cells' => array($Name, ConvertSQLDate($Customer['nextreviewdate']) . $Late, array(locale_number_format($Customer['creditlimit'], $Customer['decimalplaces']) . ' ' . $Customer['currcode']),
+						array(locale_number_format($Customer['balance'] / $Customer['rate'], $Decimals))),
+						'home' => $Customer['balance'] / $Customer['rate']);
+	}
+	if ($Customer['balance'] > $Customer['creditlimit']) {
+		$By = $Customer['balance'] - $Customer['creditlimit'];
+		$Over[] = array('cells' => array($Name, array(locale_number_format($Customer['creditlimit'], $Customer['decimalplaces']) . ' ' . $Customer['currcode']),
+						array(locale_number_format($Customer['balance'], $Customer['decimalplaces']) . ' ' . $Customer['currcode']),
+						array(locale_number_format($By, $Customer['decimalplaces']) . ' ' . $Customer['currcode']),
+						array(locale_number_format($By / $Customer['rate'], $Decimals))),
+						'home' => $By / $Customer['rate']);
+	}
+	if ($Customer['dissallowinvoices'] == 1 or $Customer['dissallowinvoices'] == 2) {
+		$Flagged[] = array('cells' => array($Name, ($Customer['dissallowinvoices'] == 1 ? __('On stop') : __('On watch')), htmlspecialchars($Customer['reasondescription'], ENT_QUOTES, 'UTF-8'),
+						array(locale_number_format($Customer['balance'] / $Customer['rate'], $Decimals))),
+						'home' => $Customer['balance'] / $Customer['rate']);
+	}
+}
+
+CreditReportTable(__('Due or overdue for a credit review'), $Due, array(__('Customer'), __('Next review'), __('Credit limit'), __('Balance in home currency')), $Decimals);
+CreditReportTable(__('Over their credit limit'), $Over, array(__('Customer'), __('Credit limit'), __('Balance'), __('Over limit by'), __('Over limit by in home currency')), $Decimals);
+CreditReportTable(__('On watch or on stop'), $Flagged, array(__('Customer'), __('Status'), __('Reason'), __('Balance in home currency')), $Decimals);
+
+include('includes/footer.php');

+	foreach (array('CreditReviewMonths', 'CreditChargeDays', 'CreditReminderGapDays') as $Name) {
+		if (!ctype_digit((string) $_POST[$Name]) or $_POST[$Name] < 0) {
+			$InputError = 1;

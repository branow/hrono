+			$InputError = 1;
+			prnMsg(__('The interest rate, late fee and write-off approval amount must be numbers that are not negative'), 'error');
+			break;
+		}
+	}
+	foreach (array('CreditInterestAccount', 'CreditFeeAccount', 'CreditBadDebtAccount') as $Name) {
+		if ($_POST[$Name] != '') {
+			$Result = DB_query("SELECT accountcode FROM chartmaster WHERE accountcode='" . $_POST[$Name] . "'");
+			if (DB_num_rows($Result) == 0) {
+				$InputError = 1;
+				prnMsg(__('The general ledger account does not exist') . ': ' . $_POST[$Name], 'error');
+			}
+		}
+	}
+	if ($InputError == 0) {
+		$Names = array('CreditReviewMonths', 'CreditInterestRate', 'CreditLateFee', 'CreditChargeDays', 'CreditInterestAccount', 'CreditFeeAccount',
+						'CreditBadDebtAccount', 'CreditWriteOffThreshold', 'CreditReminderGapDays', 'CreditStopHoldReason');
+		$_POST['CreditAutoStopAfterFinal'] = isset($_POST['CreditAutoStopAfterFinal']) ? 1 : 0;
+		$Names[] = 'CreditAutoStopAfterFinal';
+		foreach ($Names as $Name) {
+			DB_query("INSERT INTO config (confname, confvalue) VALUES ('" . $Name . "', '" . $_POST[$Name] . "')
+						ON DUPLICATE KEY UPDATE confvalue='" . $_POST[$Name] . "'");
+			$_SESSION[$Name] = is_numeric($_POST[$Name]) ? (float) $_POST[$Name] : $_POST[$Name];
+		}
+		prnMsg(__('The credit control settings have been saved'), 'success');
+	}
+}
+
+function CreditAccountSelect($Name, $Selected) {

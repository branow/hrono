@@ -0,0 +1,152 @@
+<?php
+
+/* Credit control history of a customer.
+- credit controllers and auditors (token 21 or 8) see everything: reviews, status and limit changes, reminders, charges, waivers, write-offs
+- sales reps only see their own customers, and customers in the portal only themselves: status, limit, balance, reminders and charges
+- customers in the portal do not see their watch status or internal notes */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Credit Control History');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditHistory';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+$IsPortalUser = CreditIsPortalUser();
+$SeesEverything = !$IsPortalUser and (CreditUserIsController() or in_array(8, $_SESSION['AllowedPageSecurityTokens']));
+
+if ($IsPortalUser) {
+	$DebtorNo = CreditPortalCustomer();
+} elseif (isset($_GET['DebtorNo'])) {
+	$DebtorNo = $_GET['DebtorNo'];
+} elseif (isset($_POST['DebtorNo'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+}
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+if (!isset($DebtorNo) or $DebtorNo == '') {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+			<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+			<fieldset>
+				<legend>' . __('Select a customer') . '</legend>
+				<field>
+					<label for="DebtorNo">' . __('Customer code') . ':</label>
+					<input type="text" name="DebtorNo" size="12" maxlength="10" />
+				</field>
+			</fieldset>
+			<div class="centre"><input type="submit" name="Show" value="' . __('Show') . '" /></div>
+		</form>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* BR-33, BR-36: a rep sees their own customers only, a customer only itself - no hint whether the code exists */
+$Status = CreditGetStatus($DebtorNo);
+if ($Status === false or !CreditCustomerVisible($DebtorNo)) {
+	prnMsg(__('No credit information is available for this customer'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$Dec = $Status['decimalplaces'];
+$Balance = CreditCustomerBalance($DebtorNo);
+$Overdue = 0;
+foreach (CreditOverdueItems($DebtorNo, '', false) as $Item) {
+	$Overdue += $Item['balance'];
+}
+$Result = DB_query("SELECT MAX(stageno) FROM dunninglog WHERE debtorno='" . $DebtorNo . "'");
+$LastStage = DB_fetch_row($Result);
+
+echo '<table class="selection">
+		<tr><th colspan="2">' . htmlspecialchars($Status['name'], ENT_QUOTES, 'UTF-8') . ' (' . $DebtorNo . ')</th></tr>';
+if (!$IsPortalUser) {
+	/* the watch status and the reason are for staff only; customers are not told they are on watch */
+	echo '<tr><td>' . __('Credit status') . '</td><td>' . $Status['statustext'] . ' - ' . htmlspecialchars($Status['reasondescription'], ENT_QUOTES, 'UTF-8') . '</td></tr>
+		<tr><td>' . __('Credit limit') . '</td><td class="number">' . locale_number_format($Status['creditlimit'], $Dec) . ' ' . $Status['currcode'] . '</td></tr>
+		<tr><td>' . __('Next review due') . '</td><td>' . ConvertSQLDate($Status['nextreviewdate']) . '</td></tr>';
+} elseif ($Status['level'] == 1) {
+	echo '<tr><td colspan="2"><div class="error">' . __('Your account is on hold, please contact us') . '</div></td></tr>';
+}
+echo '<tr><td>' . __('Balance') . '</td><td class="number">' . locale_number_format($Balance, $Dec) . ' ' . $Status['currcode'] . '</td></tr>
+		<tr><td>' . __('Overdue') . '</td><td class="number">' . locale_number_format($Overdue, $Dec) . ' ' . $Status['currcode'] . '</td></tr>';
+if (!$IsPortalUser) {
+	echo '<tr><td>' . __('Last reminder stage sent') . '</td><td>' . ($LastStage[0] === null ? '-' : $LastStage[0]) . '</td></tr>';
+}
+echo '</table><br />';
+
+/* Reminders sent */
+$Result = DB_query("SELECT senddate, stageno, amount, currcode, invoices, method, letter
+					FROM dunninglog
+					WHERE debtorno='" . $DebtorNo . "'
+					ORDER BY dunningid DESC");
+echo '<table class="selection">
+		<tr><th colspan="5">' . __('Reminder letters') . '</th></tr>
+		<tr><th>' . __('Date') . '</th><th>' . __('Stage') . '</th><th>' . __('Amount') . '</th><th>' . __('Invoices') . '</th><th>' . __('Sent by') . '</th></tr>';
+while ($MyRow = DB_fetch_array($Result)) {
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDateTime($MyRow['senddate']) . '</td>
+			<td class="number">' . $MyRow['stageno'] . '</td>
+			<td class="number">' . locale_number_format($MyRow['amount'], $Dec) . ' ' . $MyRow['currcode'] . '</td>
+			<td>' . htmlspecialchars($MyRow['invoices'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td>' . ($MyRow['method'] == 'email' ? __('Email') : __('Post')) . '</td>
+		</tr>';
+	if ($IsPortalUser or isset($_GET['ShowLetters'])) {
+		echo '<tr><td colspan="5"><pre>' . htmlspecialchars($MyRow['letter'], ENT_QUOTES, 'UTF-8') . '</pre></td></tr>';
+	}
+}
+echo '</table>';

@@ -0,0 +1,94 @@
+<?php
+
+/* Go-live utility: loads the credit status, credit limit and next review date of customers from a csv file, for example the
+credit controller's spreadsheet with the stop list. Columns: customer code, status (normal, watch or stop), credit limit (optional),
+next review date as YYYY-MM-DD (optional), note (optional). The first line is a heading line. Everything loaded is recorded in the
+credit control history of the customer. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Import Customer Credit Status');
+$ViewTopic = 'SpecialUtilities';
+$BookMark = 'ImportCreditStatus';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/maintenance.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+/* the credit status to use for normal, watch and stop is the first hold reason of that kind */
+function CreditReasonOfKind($Kind) {
+	if ($Kind == 'stop') {
+		return CreditStopReasonCode();
+	}
+	$Where = ($Kind == 'watch') ? 'dissallowinvoices=2' : 'dissallowinvoices=0';
+	$Result = DB_query("SELECT MIN(reasoncode) FROM holdreasons WHERE " . $Where);
+	$MyRow = DB_fetch_row($Result);
+	return ($MyRow[0] === null) ? false : (int) $MyRow[0];
+}
+
+if (isset($_POST['Import']) and isset($_FILES['CSVFile']) and $_FILES['CSVFile']['name'] != '') {
+	$Handle = fopen($_FILES['CSVFile']['tmp_name'], 'r');
+	$Line = 0;
+	$Loaded = 0;
+	$Dry = !isset($_POST['Confirm']);
+	DB_Txn_Begin();
+	while (($Fields = fgetcsv($Handle, 1000, ',')) !== false) {
+		$Line++;
+		if ($Line == 1 or count($Fields) < 2 or trim($Fields[0]) == '') {
+			continue;
+		}
+		$DebtorNo = DB_escape_string(trim($Fields[0]));
+		$Kind = mb_strtolower(trim($Fields[1]));
+		$Status = CreditGetStatus($DebtorNo);
+		$Reason = in_array($Kind, array('normal', 'watch', 'stop')) ? CreditReasonOfKind($Kind) : false;
+		if ($Status === false) {
+			prnMsg(__('Line') . ' ' . $Line . ': ' . __('customer does not exist') . ' ' . htmlspecialchars($DebtorNo, ENT_QUOTES, 'UTF-8'), 'error');
+			continue;
+		}
+		if ($Reason === false) {
+			prnMsg(__('Line') . ' ' . $Line . ': ' . __('the status must be normal, watch or stop and a credit status of that kind must exist'), 'error');
+			continue;
+		}
+		$Limit = (isset($Fields[2]) and trim($Fields[2]) != '' and is_numeric(trim($Fields[2]))) ? (float) trim($Fields[2]) : $Status['creditlimit'];
+		$NextReview = (isset($Fields[3]) and preg_match('/^\d{4}-\d{2}-\d{2}$/', trim($Fields[3]))) ? trim($Fields[3]) : $Status['nextreviewdate'];
+		$Note = isset($Fields[4]) ? DB_escape_string(trim($Fields[4])) : '';
+		DB_query("UPDATE debtorsmaster SET creditlimit='" . $Limit . "', nextreviewdate='" . $NextReview . "' WHERE debtorno='" . $DebtorNo . "'", '', '', true);
+		if ($Limit != $Status['creditlimit']) {
+			CreditLog($DebtorNo, 'LIMIT', $Status['creditlimit'] . ' -> ' . $Limit . ': ' . __('loaded at go-live'), $Limit, $Status['currcode']);
+		}
+		CreditSetHoldReason($DebtorNo, $Reason, __('Loaded at go-live') . ' ' . $Note);
+		CreditLog($DebtorNo, 'IMPORT', __('Credit status loaded from file') . ' (' . $Kind . ') ' . $Note);
+		$Loaded++;
+	}
+	fclose($Handle);
+	if ($Dry) {
+		DB_Txn_Rollback();
+		prnMsg($Loaded . ' ' . __('lines are valid. Nothing has been changed, tick the confirm box to load them'), 'info');
+	} else {
+		DB_Txn_Commit();
+		prnMsg($Loaded . ' ' . __('customers have been updated'), 'success');
+	}
+}
+
+echo '<form method="post" enctype="multipart/form-data" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Credit status file') . '</legend>
+		<field>
+			<label for="CSVFile">' . __('csv file') . ':</label>
+			<input type="file" name="CSVFile" />
+			<fieldhelp>' . __('Columns: customer code, status (normal, watch or stop), credit limit, next review date YYYY-MM-DD, note') . '</fieldhelp>
+		</field>
+		<field>
+			<label for="Confirm">' . __('Confirm: load the file (otherwise it is only checked)') . ':</label>
+			<input type="checkbox" name="Confirm" />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Import" value="' . __('Check or Load the File') . '" /></div>
+</form>';
+
+include('includes/footer.php');

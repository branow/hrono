+INSERT INTO `dunningtexts` (`stageno`, `language_id`, `subject`, `body`) VALUES (1,'en_GB.utf8','Reminder: overdue account','Dear {name},\n\nOur records show that the following invoices on your account are overdue. This may be an oversight, if you have already paid please ignore this reminder.\n\n{invoices}\nTotal overdue: {currency} {amount}\n\nPlease arrange payment at your earliest convenience.\n\nKind regards,\n{company}'),(2,'en_GB.utf8','Second reminder: overdue account','Dear {name},\n\nWe wrote to you recently about overdue invoices on your account and have not yet received payment. The following invoices remain unpaid.\n\n{invoices}\nTotal overdue: {currency} {amount}\n\nPlease pay immediately or contact us to discuss.\n\nKind regards,\n{company}'),(3,'en_GB.utf8','FINAL NOTICE: overdue account','Dear {name},\n\nDespite our earlier reminders the following invoices remain unpaid.\n\n{invoices}\nTotal overdue: {currency} {amount}\n\nUnless payment is received within 7 days your account will be put on stop, no further orders will be supplied and late payment interest and fees will be charged.\n\nKind regards,\n{company}');

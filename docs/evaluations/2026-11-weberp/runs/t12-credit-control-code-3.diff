diff --git a/CreditWriteOffs.php b/CreditWriteOffs.php
new file mode 100644
index 0000000..57d2e7f
--- /dev/null
+++ b/CreditWriteOffs.php
@@ -0,0 +1,259 @@
+<?php
+
+/* Bad debt write-offs. A write-off is a credit (type 54) in the customer account, allocated against the oldest open items,
+posted to debtors control and the bad debt account with any exchange difference. Write-offs above the amount set by Finance
+wait for approval by someone holding the write-off approval token, who cannot be the person who asked for it. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Bad Debt Write-offs');
+$ViewTopic = 'CreditControl';
+$BookMark = 'CreditWriteOffs';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Threshold = (float) CreditControlSetting('CreditWriteOffThreshold', 1000);
+$BadDebtAccount = CreditControlSetting('CreditBadDebtAccount', '');
+
+/* Posts an approved write-off. Returns an error text or '' */
+function CreditPostWriteOff($WriteOffID, $ApprovedBy, $BadDebtAccount) {
+	$Result = DB_query("SELECT * FROM creditwriteoffs WHERE writeoffid='" . $WriteOffID . "' AND status='pending'");
+	if (DB_num_rows($Result) == 0) {
+		return __('The write-off is not waiting to be posted');
+	}
+	$WriteOff = DB_fetch_array($Result);
+	$Status = CreditGetStatus($WriteOff['debtorno']);
+	if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1 and $BadDebtAccount == '') {
+		return __('The bad debt account has not been set in the credit control settings');
+	}
+	if ($WriteOff['amount'] > CreditCustomerBalance($WriteOff['debtorno']) + CurrencyTolerance($Status['currcode'])) {
+		return __('The write-off is more than the customer balance now');
+	}
+	$Targets = CreditAllocationTargets($WriteOff['debtorno'], $WriteOff['amount'], $Status['currcode']);
+	if ($Targets === false) {
+		return __('The open invoices of the customer do not cover the write-off, allocate receipts and credits first');
+	}
+	$Today = date('Y-m-d');
+	DB_Txn_Begin();
+	$Trans = CreditInsertDebtorTrans($Status, CREDIT_TYPE_WRITEOFF, -$WriteOff['amount'], $Today,
+		__('Bad debt write-off') . ' ' . $WriteOffID, $BadDebtAccount,
+		__('Bad debt write-off') . ' ' . $WriteOffID . ': ' . $WriteOff['reason']);
+	CreditAllocate($Trans['id'], CREDIT_TYPE_WRITEOFF, $Trans['transno'], $Trans['rate'], $Today, $Targets, $Status['currcode']);
+	DB_query("UPDATE creditwriteoffs SET status='posted',
+										transno='" . $Trans['transno'] . "',
+										approvedby='" . $ApprovedBy . "',
+										approvedate='" . date('Y-m-d H:i:s') . "'
+				WHERE writeoffid='" . $WriteOffID . "'",
+			__('The write-off could not be updated because'), '', true);
+	CreditLog($WriteOff['debtorno'], 'WRITEOFF', __('Bad debt written off') . ': ' . $WriteOff['reason'], $WriteOff['amount'], $Status['currcode'], CREDIT_TYPE_WRITEOFF . '/' . $Trans['transno']);
+	/* BR-28: a customer with a bad debt goes on stop unless credit control decided otherwise */
+	if ($WriteOff['stopcustomer'] == 1 and $Status['level'] != 1) {
+		$StopReason = CreditStopReasonCode();
+		if ($StopReason !== false) {
+			CreditSetHoldReason($WriteOff['debtorno'], $StopReason, __('Automatic stop after a bad debt write-off'));
+		}
+	}
+	DB_Txn_Commit();
+	return '';
+}
+
+/* ---------- Approve or reject ---------- */
+if (isset($_POST['Approve']) or isset($_POST['Reject'])) {
+	$WriteOffID = (int) $_POST['WriteOffID'];
+	$Result = DB_query("SELECT requestedby FROM creditwriteoffs WHERE writeoffid='" . $WriteOffID . "' AND status='pending'");
+	$MyRow = DB_fetch_array($Result);
+	if (!CreditUserIsApprover()) {
+		prnMsg(__('You are not authorised to approve write-offs'), 'error');
+	} elseif ($MyRow === false or $MyRow === null) {
+		prnMsg(__('The write-off is not waiting for approval'), 'error');
+	} elseif ($MyRow['requestedby'] == $_SESSION['UserID']) {
+		prnMsg(__('You cannot approve a write-off you requested yourself'), 'error');
+	} elseif (isset($_POST['Approve'])) {
+		$Error = CreditPostWriteOff($WriteOffID, $_SESSION['UserID'], $BadDebtAccount);
+		if ($Error == '') {
+			prnMsg(__('The write-off has been approved and posted'), 'success');
+		} else {
+			prnMsg($Error, 'error');
+		}
+	} else {
+		DB_query("UPDATE creditwriteoffs SET status='rejected', approvedby='" . $_SESSION['UserID'] . "', approvedate='" . date('Y-m-d H:i:s') . "'
+					WHERE writeoffid='" . $WriteOffID . "'");
+		$Result = DB_query("SELECT debtorno, amount, currcode FROM creditwriteoffs WHERE writeoffid='" . $WriteOffID . "'");
+		$WriteOff = DB_fetch_array($Result);
+		DB_Txn_Begin();
+		CreditLog($WriteOff['debtorno'], 'WRITEOFFREJECT', __('Write-off rejected'), $WriteOff['amount'], $WriteOff['currcode']);
+		DB_Txn_Commit();
+		prnMsg(__('The write-off has been rejected'), 'success');
+	}
+}
+
+/* ---------- Request ---------- */
+if (isset($_POST['Request'])) {
+	$DebtorNo = $_POST['DebtorNo'];
+	$Status = CreditGetStatus($DebtorNo);
+	$Amount = filter_number_format($_POST['Amount']);
+	$InputError = 0;
+	if ($Status === false) {
+		$InputError = 1;
+		prnMsg(__('The customer does not exist'), 'error');
+	} else {
+		if (!is_numeric($Amount) or $Amount <= 0) {
+			$InputError = 1;
+			prnMsg(__('The amount to write off must be a number greater than zero'), 'error');
+		} elseif ($Amount > CreditCustomerBalance($DebtorNo) + CurrencyTolerance($Status['currcode'])) {
+			$InputError = 1;
+			prnMsg(__('The amount is more than the customer balance'), 'error');
+		} elseif (CreditAllocationTargets($DebtorNo, $Amount, $Status['currcode']) === false) {
+			$InputError = 1;
+			prnMsg(__('The open invoices of the customer do not cover this amount, allocate receipts and credits first'), 'error');
+		}
+		if (trim($_POST['Reason']) == '') {
+			$InputError = 1;
+			prnMsg(__('The reason for the write-off must be entered'), 'error');
+		}
+	}
+	if ($InputError == 0) {
+		DB_query("INSERT INTO creditwriteoffs (debtorno, amount, currcode, reason, requestedby, requestdate, status, stopcustomer)
+					VALUES ('" . $DebtorNo . "', '" . $Amount . "', '" . $Status['currcode'] . "', '" . $_POST['Reason'] . "',
+							'" . $_SESSION['UserID'] . "', '" . date('Y-m-d H:i:s') . "', 'pending', '" . (isset($_POST['StopCustomer']) ? 1 : 0) . "')");
+		$WriteOffID = DB_Last_Insert_ID('creditwriteoffs', 'writeoffid');
+		$HomeAmount = $Amount / $Status['rate'];
+		if ($HomeAmount > $Threshold) {
+			DB_Txn_Begin();
+			CreditLog($DebtorNo, 'WRITEOFFREQ', __('Write-off waiting for approval') . ': ' . $_POST['Reason'], $Amount, $Status['currcode']);
+			DB_Txn_Commit();
+			prnMsg(__('The write-off is above the approval amount and waits for approval, nothing has been posted yet'), 'info');
+		} else {
+			$Error = CreditPostWriteOff($WriteOffID, '', $BadDebtAccount);
+			if ($Error == '') {
+				prnMsg(__('The write-off has been posted'), 'success');
+			} else {
+				DB_query("DELETE FROM creditwriteoffs WHERE writeoffid='" . $WriteOffID . "'");
+				prnMsg($Error, 'error');
+			}
+		}
+	}
+}
+
+/* ---------- Request form for a customer ---------- */
+$DebtorNo = isset($_GET['DebtorNo']) ? $_GET['DebtorNo'] : (isset($_POST['DebtorNo']) ? $_POST['DebtorNo'] : '');
+if ($DebtorNo != '' and ($Status = CreditGetStatus($DebtorNo)) !== false) {
+	echo CreditStatusBanner($Status);
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="DebtorNo" value="' . $DebtorNo . '" />
+		<fieldset>
+			<legend>' . __('Write off bad debt') . ' - ' . htmlspecialchars($Status['name'], ENT_QUOTES, 'UTF-8') . '</legend>
+			<field>
+				<label>' . __('Customer balance') . ':</label>
+				<fieldtext>' . locale_number_format(CreditCustomerBalance($DebtorNo), $Status['decimalplaces']) . ' ' . $Status['currcode'] . '</fieldtext>
+			</field>
+			<field>
+				<label for="Amount">' . __('Amount to write off') . ' (' . $Status['currcode'] . '):</label>
+				<input type="text" class="number" name="Amount" size="14" maxlength="14" />
+				<fieldhelp>' . __('Write-offs above') . ' ' . locale_number_format($Threshold, 2) . ' ' . $_SESSION['CompanyRecord']['currencydefault'] . ' ' . __('need approval') . '</fieldhelp>
+			</field>
+			<field>
+				<label for="Reason">' . __('Reason') . ':</label>
+				<input type="text" name="Reason" size="60" maxlength="200" />
+			</field>
+			<field>
+				<label for="StopCustomer">' . __('Put the customer on stop') . ':</label>
+				<input type="checkbox" name="StopCustomer" checked="checked" />
+			</field>
+		</fieldset>
+		<div class="centre"><input type="submit" name="Request" value="' . __('Write Off') . '" /></div>
+	</form><br />';
+} elseif ($DebtorNo == '') {
+	echo '<form method="get" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<fieldset><legend>' . __('Customer to write off') . '</legend>
+			<field><label for="DebtorNo">' . __('Customer code') . ':</label><input type="text" name="DebtorNo" size="12" maxlength="10" /></field>
+		</fieldset>
+		<div class="centre"><input type="submit" value="' . __('Select') . '" /></div>
+	</form><br />';
+}
+
+/* ---------- Waiting for approval ---------- */
+$Result = DB_query("SELECT creditwriteoffs.*, debtorsmaster.name
+					FROM creditwriteoffs INNER JOIN debtorsmaster ON creditwriteoffs.debtorno=debtorsmaster.debtorno
+					WHERE creditwriteoffs.status='pending'
+					ORDER BY creditwriteoffs.writeoffid");
+if (DB_num_rows($Result) > 0) {
+	echo '<table class="selection">
+			<tr><th colspan="6">' . __('Waiting for approval') . '</th></tr>
+			<tr><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . __('Reason') . '</th><th>' . __('Requested by') . '</th><th>' . __('Date') . '</th><th></th></tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td class="number">' . locale_number_format($MyRow['amount'], 2) . ' ' . $MyRow['currcode'] . '</td>
+				<td>' . $MyRow['reason'] . '</td>
+				<td>' . $MyRow['requestedby'] . '</td>
+				<td>' . ConvertSQLDateTime($MyRow['requestdate']) . '</td>
+				<td>';
+		if (CreditUserIsApprover() and $MyRow['requestedby'] != $_SESSION['UserID']) {
+			echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+					<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+					<input type="hidden" name="WriteOffID" value="' . $MyRow['writeoffid'] . '" />
+					<input type="submit" name="Approve" value="' . __('Approve') . '" />
+					<input type="submit" name="Reject" value="' . __('Reject') . '" />
+				</form>';
+		}
+		echo '</td></tr>';
+	}
+	echo '</table><br />';
+}
+
+/* ---------- Report of write-offs in a period (BR-29) ---------- */
+$From = (isset($_POST['From']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['From'])) ? $_POST['From'] : date('Y-m-01', strtotime('-11 months'));
+$To = (isset($_POST['To']) and preg_match('/^\d{4}-\d{2}-\d{2}$/', $_POST['To'])) ? $_POST['To'] : date('Y-m-d');
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Write-offs in a period') . '</legend>
+		<field><label for="From">' . __('From') . ':</label><input type="date" name="From" value="' . $From . '" /></field>
+		<field><label for="To">' . __('To') . ':</label><input type="date" name="To" value="' . $To . '" /></field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Report" value="' . __('Show') . '" /></div>
+</form>';
+
+$Result = DB_query("SELECT creditwriteoffs.*,
+							debtorsmaster.name,
+							COALESCE(debtortrans.rate, currencies.rate) AS rate
+					FROM creditwriteoffs
+					INNER JOIN debtorsmaster ON creditwriteoffs.debtorno=debtorsmaster.debtorno
+					INNER JOIN currencies ON creditwriteoffs.currcode=currencies.currabrev
+					LEFT JOIN debtortrans ON debtortrans.type=" . CREDIT_TYPE_WRITEOFF . "
+						AND debtortrans.transno=creditwriteoffs.transno
+						AND debtortrans.debtorno=creditwriteoffs.debtorno
+					WHERE DATE(creditwriteoffs.requestdate) >= '" . $From . "'
+						AND DATE(creditwriteoffs.requestdate) <= '" . $To . "'
+					ORDER BY creditwriteoffs.writeoffid");
+echo '<table class="selection">
+		<tr><th>' . __('Date') . '</th><th>' . __('Customer') . '</th><th>' . __('Amount') . '</th><th>' . __('Home currency') . '</th><th>' . __('Reason') . '</th><th>' . __('Requested by') . '</th><th>' . __('Approved by') . '</th><th>' . __('Status') . '</th></tr>';
+$Total = 0;
+while ($MyRow = DB_fetch_array($Result)) {
+	$Home = $MyRow['amount'] / $MyRow['rate'];
+	if ($MyRow['status'] == 'posted') {
+		$Total += $Home;
+	}
+	echo '<tr class="striped_row">
+			<td>' . ConvertSQLDate(mb_substr($MyRow['requestdate'], 0, 10)) . '</td>
+			<td>' . htmlspecialchars($MyRow['name'], ENT_QUOTES, 'UTF-8') . '</td>
+			<td class="number">' . locale_number_format($MyRow['amount'], 2) . ' ' . $MyRow['currcode'] . '</td>
+			<td class="number">' . locale_number_format($Home, $_SESSION['CompanyRecord']['decimalplaces']) . '</td>
+			<td>' . $MyRow['reason'] . '</td>
+			<td>' . $MyRow['requestedby'] . '</td>
+			<td>' . ($MyRow['approvedby'] == '' && $MyRow['status'] == 'posted' ? __('Below approval amount') : $MyRow['approvedby']) . '</td>
+			<td>' . $MyRow['status'] . '</td>
+		</tr>';
+}
+echo '<tr><th colspan="3">' . __('Total posted in home currency') . '</th><th class="number">' . locale_number_format($Total, $_SESSION['CompanyRecord']['decimalplaces']) . '</th><th colspan="4"></th></tr>
+	</table>';
+
+include('includes/footer.php');

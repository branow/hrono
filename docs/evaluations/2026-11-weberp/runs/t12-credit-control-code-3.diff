diff --git a/includes/CreditControlFunctions.php b/includes/CreditControlFunctions.php
new file mode 100644
index 0000000..35e4103
--- /dev/null
+++ b/includes/CreditControlFunctions.php
@@ -0,0 +1,392 @@
+<?php
+
+/* Shared functions for credit control: status, enforcement of stop/hold, history log, ledger postings for late charges, waivers and write-offs.
+
+Credit status is the existing debtorsmaster.holdreason -> holdreasons record:
+	holdreasons.dissallowinvoices = 1 : ON STOP - no orders accepted or released, nothing dispatched or invoiced
+	holdreasons.dissallowinvoices = 2 : ON WATCH - supplied, but a warning is given to anybody taking an order
+	anything else                     : NORMAL
+*/
+
+/* debtortrans types used by credit control - see sql/updates/44.php */
+define('CREDIT_TYPE_INTEREST', 51);
+define('CREDIT_TYPE_FEE', 52);
+define('CREDIT_TYPE_WAIVER', 53);
+define('CREDIT_TYPE_WRITEOFF', 54);
+
+/* security tokens - see sql/updates/44.php */
+define('CREDIT_TOKEN_CONTROL', 21);
+define('CREDIT_TOKEN_APPROVE', 22);
+
+function CreditControlSetting($Name, $Default = '') {
+	if (isset($_SESSION[$Name]) and $_SESSION[$Name] !== '') {
+		return $_SESSION[$Name];
+	}
+	return $Default;
+}
+
+function CreditUserIsController() {
+	return in_array(CREDIT_TOKEN_CONTROL, $_SESSION['AllowedPageSecurityTokens']);
+}
+
+function CreditUserIsApprover() {
+	return in_array(CREDIT_TOKEN_APPROVE, $_SESSION['AllowedPageSecurityTokens']);
+}
+
+/* A customer portal user is one who only has the "customer log on" tokens 0 and 1, same rule as $CustomerLogin in session.php.
+$_SESSION['CustomerID'] cannot be used to tell, staff use it for the customer they have selected. */
+function CreditIsPortalUser() {
+	return (in_array(1, $_SESSION['AllowedPageSecurityTokens']) and count($_SESSION['AllowedPageSecurityTokens']) == 2);
+}
+
+/* The only customer a portal user may see */
+function CreditPortalCustomer() {
+	return isset($_SESSION['LoginCustomerID']) ? $_SESSION['LoginCustomerID'] : '';
+}
+
+/* Can the logged in user see credit information for this customer?
+Sales reps (users with a salesman login) only see their own customers, customer portal users only themselves */
+function CreditCustomerVisible($DebtorNo) {
+	if (CreditIsPortalUser()) {
+		return (CreditPortalCustomer() != '' and CreditPortalCustomer() == $DebtorNo);
+	}
+	if (isset($_SESSION['SalesmanLogin']) and $_SESSION['SalesmanLogin'] != '') {
+		$Result = DB_query("SELECT debtorno FROM custbranch
+							WHERE debtorno='" . $DebtorNo . "'
+							AND salesman='" . $_SESSION['SalesmanLogin'] . "'");
+		return (DB_num_rows($Result) > 0);
+	}
+	return true;
+}
+
+/* SQL fragment limiting a debtorsmaster query to the customers the user may see */
+function CreditVisibleCustomersSQL($DebtorField = 'debtorsmaster.debtorno') {
+	if (CreditIsPortalUser()) {
+		return " AND " . $DebtorField . "='" . CreditPortalCustomer() . "' ";
+	}
+	if (isset($_SESSION['SalesmanLogin']) and $_SESSION['SalesmanLogin'] != '') {
+		return " AND " . $DebtorField . " IN (SELECT debtorno FROM custbranch WHERE salesman='" . $_SESSION['SalesmanLogin'] . "') ";
+	}
+	return '';
+}
+
+/* Returns the credit position of a customer or false if the customer does not exist */
+function CreditGetStatus($DebtorNo) {
+	$SQL = "SELECT debtorsmaster.debtorno,
+					debtorsmaster.name,
+					debtorsmaster.currcode,
+					debtorsmaster.creditlimit,
+					debtorsmaster.holdreason,
+					debtorsmaster.nextreviewdate,
+					debtorsmaster.interestexempt,
+					debtorsmaster.feeexempt,
+					debtorsmaster.language_id,
+					holdreasons.reasondescription,
+					holdreasons.dissallowinvoices,
+					currencies.decimalplaces,
+					currencies.rate
+			FROM debtorsmaster
+			INNER JOIN holdreasons
+				ON debtorsmaster.holdreason=holdreasons.reasoncode
+			INNER JOIN currencies
+				ON debtorsmaster.currcode=currencies.currabrev
+			WHERE debtorsmaster.debtorno='" . $DebtorNo . "'";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) == 0) {
+		return false;
+	}
+	$MyRow = DB_fetch_array($Result);
+	if ($MyRow['dissallowinvoices'] == 1) {
+		$MyRow['level'] = 1;
+		$MyRow['statustext'] = __('On stop');
+	} elseif ($MyRow['dissallowinvoices'] == 2) {
+		$MyRow['level'] = 2;
+		$MyRow['statustext'] = __('On watch');
+	} else {
+		$MyRow['level'] = 0;
+		$MyRow['statustext'] = __('Normal');
+	}
+	return $MyRow;
+}
+
+/* HTML banner for the credit status of a customer, empty string when normal */
+function CreditStatusBanner($Status) {
+	if ($Status === false or $Status['level'] == 0) {
+		return '';
+	}
+	$Class = ($Status['level'] == 1) ? 'error' : 'warn';
+	return '<div class="' . $Class . '"><b>' . $Status['statustext'] . '</b>: ' . htmlspecialchars($Status['reasondescription'], ENT_QUOTES, 'UTF-8') . ' - ' . __('please contact credit control') . '</div>';
+}
+
+/* Add an entry to the credit control history of a customer (BR-32).
+Like everywhere else in webERP, texts passed to these functions are expected to be SQL-safe already: values from $_POST are escaped
+by session.php, values read from the database must go through DB_escape_string by the caller. */
+function CreditLog($DebtorNo, $EventType, $Description, $Amount = 0, $CurrCode = '', $Reference = '') {
+	$SQL = "INSERT INTO creditlog (debtorno,
+									logdate,
+									userid,
+									eventtype,
+									description,
+									amount,
+									currcode,
+									reference)
+				VALUES ('" . $DebtorNo . "',
+						'" . date('Y-m-d H:i:s') . "',
+						'" . $_SESSION['UserID'] . "',
+						'" . $EventType . "',
+						'" . $Description . "',
+						'" . $Amount . "',
+						'" . $CurrCode . "',
+						'" . $Reference . "')";
+	DB_query($SQL, __('The credit control history could not be updated because'), '', true);
+}
+
+/* Date for the next review of a customer, Finance sets the standard period in months */
+function CreditNextReviewDate($Months = 0) {
+	if ($Months <= 0) {
+		$Months = CreditControlSetting('CreditReviewMonths', 12);
+	}
+	return date('Y-m-d', mktime(0, 0, 0, date('n') + (int) $Months, date('j'), date('Y')));
+}
+
+/* The hold reason to use for an automatic stop, falls back to the first reason that disallows invoices */
+function CreditStopReasonCode() {
+	$Code = CreditControlSetting('CreditStopHoldReason', '');
+	if ($Code !== '') {
+		$Result = DB_query("SELECT reasoncode FROM holdreasons WHERE reasoncode='" . $Code . "' AND dissallowinvoices=1");
+		if (DB_num_rows($Result) > 0) {
+			return (int) $Code;
+		}
+	}
+	$Result = DB_query("SELECT MIN(reasoncode) FROM holdreasons WHERE dissallowinvoices=1");
+	$MyRow = DB_fetch_row($Result);
+	return ($MyRow[0] === null) ? false : (int) $MyRow[0];
+}
+
+/* Changes the credit status of a customer and logs it. The caller must have checked the authority of the user */
+function CreditSetHoldReason($DebtorNo, $NewReason, $Why) {
+	$Status = CreditGetStatus($DebtorNo);
+	if ($Status === false or $Status['holdreason'] == $NewReason) {
+		return;
+	}
+	DB_query("UPDATE debtorsmaster SET holdreason='" . $NewReason . "' WHERE debtorno='" . $DebtorNo . "'",
+			__('The credit status could not be updated because'), '', true);
+	$Result = DB_query("SELECT reasondescription, dissallowinvoices FROM holdreasons WHERE reasoncode='" . $NewReason . "'");
+	$NewRow = DB_fetch_array($Result);
+	$Type = ($NewRow['dissallowinvoices'] == 1) ? 'STOP' : (($NewRow['dissallowinvoices'] == 2) ? 'WATCH' : 'NORMAL');
+	CreditLog($DebtorNo, $Type, DB_escape_string($Status['reasondescription'] . ' -> ' . $NewRow['reasondescription']) . ': ' . $Why);
+}
+
+/* Checks whether an order may be accepted for a customer, whichever route the order comes by (sales office, web shop,
+EDI, standing orders, API). Returns an array:
+	block   - the customer is on stop, the order must not be accepted
+	hold    - the order is accepted but must be held for credit control approval (over credit limit)
+	watch   - the customer is on watch, warn the person taking the order
+	message - text to show/log */
+function CreditOrderCheck($DebtorNo, $OrderValue = 0) {
+	$Check = array('block' => false, 'hold' => false, 'watch' => false, 'message' => '');
+	$Status = CreditGetStatus($DebtorNo);
+	if ($Status === false) {
+		return $Check;
+	}
+	if ($Status['level'] == 1) {
+		$Check['block'] = true;
+		$Check['message'] = __('The account') . ' ' . htmlspecialchars($Status['name'], ENT_QUOTES, 'UTF-8') . ' ' . __('is on stop') . ' (' . htmlspecialchars($Status['reasondescription'], ENT_QUOTES, 'UTF-8') . '). ' . __('No orders can be accepted - please contact credit control');
+		return $Check;
+	}
+	if ($Status['level'] == 2) {
+		$Check['watch'] = true;
+		$Check['message'] = __('The account') . ' ' . htmlspecialchars($Status['name'], ENT_QUOTES, 'UTF-8') . ' ' . __('is on watch') . ' (' . htmlspecialchars($Status['reasondescription'], ENT_QUOTES, 'UTF-8') . '). ' . __('Please contact credit control to discuss');
+	}
+	if (isset($_SESSION['CheckCreditLimits']) and $_SESSION['CheckCreditLimits'] == 3) {
+		if (!function_exists('GetCreditAvailable')) {
+			include_once(__DIR__ . '/SQL_CommonFunctions.php');
+		}
+		if (GetCreditAvailable($DebtorNo) - $OrderValue < 0) {
+			$Check['hold'] = true;
+			$Check['message'] .= ' ' . __('This order takes the account over its credit limit and is held for credit control approval');
+		}
+	}
+	return $Check;
+}
+
+/* Number of days an item is past its due date, as at the date given (SQL date). Due date follows the payment terms
+the same way the aged debtors report does. Needs debtortrans and paymentterms in the query. */
+function CreditDaysOverdueSQL($AsAt = '') {
+	$AsAt = ($AsAt == '') ? 'CURRENT_DATE' : "'" . $AsAt . "'";
+	return "(CASE WHEN paymentterms.daysbeforedue > 0
+				THEN TO_DAYS(" . $AsAt . ") - TO_DAYS(debtortrans.trandate) - paymentterms.daysbeforedue
+				ELSE TO_DAYS(" . $AsAt . ") - TO_DAYS(ADDDATE(LAST_DAY(debtortrans.trandate), paymentterms.dayinfollowingmonth))
+			END)";
+}
+
+/* Overdue items of a customer: unsettled debits, optionally excluding disputed ones. Each row has daysoverdue. */
+function CreditOverdueItems($DebtorNo, $AsAt = '', $ExcludeDisputed = true, $ExcludeCharges = false) {
+	$SQL = "SELECT debtortrans.id,
+					debtortrans.type,
+					debtortrans.transno,
+					debtortrans.trandate,
+					debtortrans.balance,
+					debtortrans.disputed,
+					debtortrans.rate,
+					" . CreditDaysOverdueSQL($AsAt) . " AS daysoverdue
+			FROM debtortrans
+			INNER JOIN debtorsmaster
+				ON debtortrans.debtorno=debtorsmaster.debtorno
+			INNER JOIN paymentterms
+				ON debtorsmaster.paymentterms=paymentterms.termsindicator
+			WHERE debtortrans.debtorno='" . $DebtorNo . "'
+				AND debtortrans.settled=0
+				AND debtortrans.balance > 0";
+	if ($ExcludeDisputed) {
+		$SQL .= " AND debtortrans.disputed=0";
+	}
+	if ($ExcludeCharges) {
+		$SQL .= " AND debtortrans.type NOT IN (" . CREDIT_TYPE_INTEREST . ", " . CREDIT_TYPE_FEE . ")";
+	}
+	$SQL .= " HAVING daysoverdue > 0
+			ORDER BY debtortrans.trandate, debtortrans.transno";
+	$Result = DB_query($SQL);
+	$Items = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Items[] = $MyRow;
+	}
+	return $Items;
+}
+
+/* Customer balance in customer currency, negative amounts are unallocated receipts and credits */
+function CreditCustomerBalance($DebtorNo) {
+	$Result = DB_query("SELECT SUM(balance) FROM debtortrans WHERE debtorno='" . $DebtorNo . "'");
+	$MyRow = DB_fetch_row($Result);
+	return (float) $MyRow[0];
+}
+
+/* Inserts a debit or credit in the customer account with the matching general ledger entries.
+Positive amounts increase what the customer owes (late charges), negative amounts reduce it (waivers, write-offs).
+$LedgerAccount is the income account for charges and waivers, or the bad debt account for write-offs.
+Must be called inside a transaction. Returns array(id, transno, rate, period). */
+function CreditInsertDebtorTrans($Status, $Type, $Amount, $TransDate, $Text, $LedgerAccount, $Narrative) {
+	$PeriodNo = GetPeriod(ConvertSQLDate($TransDate));
+	$TransNo = GetNextTransNo($Type);
+	$Rate = $Status['rate'];
+
+	$SQL = "INSERT INTO debtortrans (transno,
+									type,
+									debtorno,
+									branchcode,
+									trandate,
+									inputdate,
+									prd,
+									reference,
+									tpe,
+									rate,
+									ovamount,
+									invtext)
+			VALUES ('" . $TransNo . "',
+					'" . $Type . "',
+					'" . $Status['debtorno'] . "',
+					'',
+					'" . $TransDate . "',
+					'" . date('Y-m-d H:i:s') . "',
+					'" . $PeriodNo . "',
+					'" . mb_substr($Text, 0, 50) . "',
+					'',
+					'" . $Rate . "',
+					'" . $Amount . "',
+					'" . $Narrative . "')";
+	DB_query($SQL, __('The customer transaction could not be inserted because'), '', true);
+	$ID = DB_Last_Insert_ID('debtortrans', 'id');
+
+	if ($_SESSION['CompanyRecord']['gllink_debtors'] == 1 and $Amount != 0) {
+		$HomeAmount = $Amount / $Rate;
+		/* debtors control takes the debit/credit, the income or bad debt account takes the opposite */
+		CreditInsertGL($Type, $TransNo, $TransDate, $PeriodNo, $_SESSION['CompanyRecord']['debtorsact'], $Narrative, $HomeAmount);
+		CreditInsertGL($Type, $TransNo, $TransDate, $PeriodNo, $LedgerAccount, $Narrative, -$HomeAmount);
+	}
+	return array('id' => $ID, 'transno' => $TransNo, 'rate' => $Rate, 'period' => $PeriodNo);
+}
+
+function CreditInsertGL($Type, $TransNo, $TransDate, $PeriodNo, $Account, $Narrative, $Amount) {
+	$SQL = "INSERT INTO gltrans (type,
+								typeno,
+								trandate,
+								periodno,
+								account,
+								narrative,
+								amount)
+			VALUES ('" . $Type . "',
+					'" . $TransNo . "',
+					'" . $TransDate . "',
+					'" . $PeriodNo . "',
+					'" . $Account . "',
+					'" . $Narrative . "',
+					'" . round($Amount, $_SESSION['CompanyRecord']['decimalplaces']) . "')";
+	DB_query($SQL, __('The general ledger posting could not be inserted because'), '', true);
+}
+
+/* Allocates a credit (waiver or write-off) in the customer account against debit items, adjusting settled flags and
+posting any exchange difference between the rate of the debit item and the rate of the credit, the way
+CustomerAllocations.php does. $Targets is an array of array('id', 'amount'), amounts positive. Returns the total exchange difference
+(positive is a gain). Must be called inside a transaction. */
+function CreditAllocate($CreditID, $CreditType, $CreditTransNo, $CreditRate, $TransDate, $Targets, $Currency) {
+	$Tolerance = CurrencyTolerance($Currency);
+	$TotalAllocated = 0;
+	$TotalDiff = 0;
+	foreach ($Targets as $Target) {
+		$Result = DB_query("SELECT ovamount+ovgst+ovfreight+ovdiscount AS total, alloc, rate, diffonexch
+							FROM debtortrans WHERE id='" . $Target['id'] . "'");
+		$Item = DB_fetch_array($Result);
+		$Diff = ($Target['amount'] / $CreditRate) - ($Target['amount'] / $Item['rate']);
+		$NewAlloc = $Item['alloc'] + $Target['amount'];
+		$Settled = (abs($NewAlloc - $Item['total']) < $Tolerance) ? 1 : 0;
+		DB_query("INSERT INTO custallocns (datealloc, amt, transid_allocfrom, transid_allocto)
+					VALUES ('" . $TransDate . "', '" . $Target['amount'] . "', '" . $CreditID . "', '" . $Target['id'] . "')",
+				__('The allocation could not be inserted because'), '', true);
+		DB_query("UPDATE debtortrans SET alloc='" . $NewAlloc . "',
+										diffonexch='" . ($Item['diffonexch'] + $Diff) . "',
+										settled='" . $Settled . "'
+					WHERE id='" . $Target['id'] . "'",
+				__('The allocated transaction could not be updated because'), '', true);
+		$TotalAllocated += $Target['amount'];
+		$TotalDiff += $Diff;
+	}
+	$Result = DB_query("SELECT ovamount+ovgst+ovfreight+ovdiscount AS total FROM debtortrans WHERE id='" . $CreditID . "'");
+	$Credit = DB_fetch_array($Result);
+	$Settled = (abs($TotalAllocated + $Credit['total']) < $Tolerance) ? 1 : 0;
+	DB_query("UPDATE debtortrans SET alloc='" . -$TotalAllocated . "',
+									diffonexch='" . -$TotalDiff . "',
+									settled='" . $Settled . "'
+				WHERE id='" . $CreditID . "'",
+			__('The credit transaction could not be updated because'), '', true);
+
+	if ($TotalDiff != 0 and $_SESSION['CompanyRecord']['gllink_debtors'] == 1) {
+		$PeriodNo = GetPeriod(ConvertSQLDate($TransDate));
+		CreditInsertGL($CreditType, $CreditTransNo, $TransDate, $PeriodNo, $_SESSION['CompanyRecord']['salesexchangediffact'], __('Exchange difference'), -$TotalDiff);
+		CreditInsertGL($CreditType, $CreditTransNo, $TransDate, $PeriodNo, $_SESSION['CompanyRecord']['debtorsact'], __('Exchange difference'), $TotalDiff);
+	}
+	return $TotalDiff;
+}
+
+/* Spread an amount over the oldest unsettled debit items of a customer. Returns array of array('id', 'amount'), or false
+if the debit items do not cover the amount. */
+function CreditAllocationTargets($DebtorNo, $Amount, $Currency) {
+	$Result = DB_query("SELECT id, balance FROM debtortrans
+						WHERE debtorno='" . $DebtorNo . "'
+						AND settled=0
+						AND balance > 0
+						ORDER BY trandate, transno, id");
+	$Targets = array();
+	$Remaining = $Amount;
+	while ($MyRow = DB_fetch_array($Result)) {
+		if ($Remaining <= 0) {
+			break;
+		}
+		$Take = min($Remaining, $MyRow['balance']);
+		$Targets[] = array('id' => $MyRow['id'], 'amount' => $Take);
+		$Remaining -= $Take;
+	}
+	if ($Remaining > CurrencyTolerance($Currency)) {
+		return false;
+	}
+	return $Targets;
+}

diff --git a/DunningRun.php b/DunningRun.php
new file mode 100644
index 0000000..b7e2d5f
--- /dev/null
+++ b/DunningRun.php
@@ -0,0 +1,215 @@
+<?php
+
+/* Overdue reminder run. Credit control first sees who would get which letter, takes out the customers they do not want
+to chase (promise to pay, dispute, ...) and then sends. Letters go by email to the customer's statement contacts, customers
+without an email address are listed with the letter text so that it can be posted. Every letter is recorded against the customer. */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Overdue Reminder Run');
+$ViewTopic = 'CreditControl';
+$BookMark = 'DunningRun';
+include('includes/header.php');
+
+include('includes/SQL_CommonFunctions.php');
+include('includes/CreditControlFunctions.php');
+
+echo '<p class="page_title_text">
+		<img src="' . $RootPath . '/css/' . $Theme . '/images/customer.png" title="' . $Title . '" alt="" />' . ' ' . $Title . '
+	</p>';
+
+$Stages = array();
+$Result = DB_query("SELECT stageno, daysoverdue, finalnotice FROM dunningstages ORDER BY stageno");
+while ($MyRow = DB_fetch_array($Result)) {
+	$Stages[$MyRow['stageno']] = $MyRow;
+}
+if (count($Stages) == 0) {
+	prnMsg(__('No reminder stages are defined, set them up first'), 'error');
+	echo '<div class="centre"><a href="' . $RootPath . '/DunningStages.php">' . __('Reminder Letter Stages') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* The customers to be chased, the stage of the letter and what it covers. Disputed items are not chased (BR-18); a customer
+only moves up a stage if there is still an overdue item (BR-15). */
+function DunningCandidate($DebtorNo, $Stages) {
+	$Status = CreditGetStatus($DebtorNo);
+	$Items = CreditOverdueItems($DebtorNo, '', true);
+	if ($Status === false or count($Items) == 0) {
+		return false;
+	}
+	$MaxDays = 0;
+	$Amount = 0;
+	foreach ($Items as $Item) {
+		$MaxDays = max($MaxDays, $Item['daysoverdue']);
+		$Amount += $Item['balance'];
+	}
+	/* the highest stage whose threshold has been reached */
+	$Stage = 0;
+	foreach ($Stages as $StageNo => $StageRow) {
+		if ($StageRow['daysoverdue'] <= $MaxDays) {
+			$Stage = $StageNo;
+		}
+	}
+	if ($Stage == 0) {
+		return false;
+	}
+	/* letters already sent for this overdue episode: since the oldest overdue item became due */
+	$OldestDue = date('Y-m-d', strtotime('-' . $MaxDays . ' days'));
+	$Result = DB_query("SELECT MAX(stageno) FROM dunninglog WHERE debtorno='" . $DebtorNo . "' AND senddate >= '" . $OldestDue . "'");
+	$MyRow = DB_fetch_row($Result);
+	$LastStage = (int) $MyRow[0];
+	if ($Stage <= $LastStage) {
+		return false;
+	}
+	/* not twice in a short time */
+	$Gap = (int) CreditControlSetting('CreditReminderGapDays', 14);
+	$Result = DB_query("SELECT COUNT(*) FROM dunninglog WHERE debtorno='" . $DebtorNo . "' AND senddate >= DATE_SUB(NOW(), INTERVAL " . $Gap . " DAY)");
+	$MyRow = DB_fetch_row($Result);
+	if ($MyRow[0] > 0) {
+		return false;
+	}
+	$Emails = array();
+	$Result = DB_query("SELECT email FROM custcontacts WHERE statement=1 AND debtorno='" . $DebtorNo . "' AND email<>''");
+	while ($MyRow = DB_fetch_array($Result)) {
+		if (IsEmailAddress($MyRow['email'])) {
+			$Emails[$MyRow['email']] = '';
+		}
+	}
+	return array('status' => $Status, 'items' => $Items, 'amount' => $Amount, 'maxdays' => $MaxDays, 'stage' => $Stage, 'emails' => $Emails);
+}
+
+function DunningLetter($Candidate, $DebtorNo) {
+	$Status = $Candidate['status'];
+	$Language = $Status['language_id'];
+	$Result = DB_query("SELECT subject, body FROM dunningtexts
+						WHERE stageno='" . $Candidate['stage'] . "'
+						AND language_id IN ('" . $Language . "', 'en_GB.utf8')
+						ORDER BY (language_id='" . $Language . "') DESC
+						LIMIT 1");
+	if (DB_num_rows($Result) == 0) {
+		return false;
+	}
+	$Text = DB_fetch_array($Result);
+	$InvoiceLines = '';
+	foreach ($Candidate['items'] as $Item) {
+		$InvoiceLines .= $Item['transno'] . '  ' . ConvertSQLDate($Item['trandate']) . '  ' . $Status['currcode'] . ' ' . locale_number_format($Item['balance'], $Status['decimalplaces']) . '  (' . $Item['daysoverdue'] . ' ' . __('days overdue') . ")\n";
+	}
+	$Replace = array('{name}' => $Status['name'],
+					'{invoices}' => $InvoiceLines,
+					'{currency}' => $Status['currcode'],
+					'{amount}' => locale_number_format($Candidate['amount'], $Status['decimalplaces']),
+					'{company}' => $_SESSION['CompanyRecord']['coyname'],
+					'{date}' => date($_SESSION['DefaultDateFormat']));
+	return array('subject' => strtr($Text['subject'], $Replace),
+				'body' => strtr($Text['body'], $Replace),
+				'invoices' => trim(preg_replace('/\s+/', ' ', implode(', ', array_map(function ($Item) {
+					return $Item['transno'];
+				}, $Candidate['items'])))));
+}
+
+/* ---------- Send ---------- */
+if (isset($_POST['Send']) and isset($_POST['Include'])) {
+	$Sent = 0;
+	$Posted = array();
+	$Failed = array();
+	foreach ($_POST['Include'] as $DebtorNo => $On) {
+		$DebtorNo = DB_escape_string($DebtorNo); /* array keys are not escaped by session.php */
+		$Candidate = DunningCandidate($DebtorNo, $Stages);
+		if ($Candidate === false) {
+			continue; /* paid, disputed or already chased since the preview */
+		}
+		$Letter = DunningLetter($Candidate, $DebtorNo);
+		if ($Letter === false) {
+			$Failed[] = $Candidate['status']['name'] . ': ' . __('no wording for this stage');
+			continue;
+		}
+		$Method = 'post';
+		$EmailTo = '';
+		if (count($Candidate['emails']) > 0) {
+			$Method = 'email';
+			$EmailTo = implode(', ', array_keys($Candidate['emails']));
+			$EmailSent = SendEmailFromWebERP($_SESSION['CompanyRecord']['email'], $Candidate['emails'], $Letter['subject'], $Letter['body'], array(), true);
+			if ($EmailSent !== true) {
+				$Failed[] = $Candidate['status']['name'] . ': ' . (is_string($EmailSent) ? $EmailSent : __('the email could not be sent'));
+				continue;
+			}
+		}
+		DB_Txn_Begin();
+		DB_query("INSERT INTO dunninglog (debtorno, stageno, senddate, userid, amount, currcode, invoices, method, emailto, letter)
+					VALUES ('" . $DebtorNo . "',
+							'" . $Candidate['stage'] . "',
+							'" . date('Y-m-d H:i:s') . "',
+							'" . $_SESSION['UserID'] . "',
+							'" . $Candidate['amount'] . "',
+							'" . $Candidate['status']['currcode'] . "',
+							'" . DB_escape_string($Letter['invoices']) . "',
+							'" . $Method . "',
+							'" . DB_escape_string($EmailTo) . "',
+							'" . DB_escape_string($Letter['subject'] . "\n\n" . $Letter['body']) . "')",
+				__('The reminder could not be recorded because'), '', true);
+		CreditLog($DebtorNo, 'REMINDER', __('Stage') . ' ' . $Candidate['stage'] . ' ' . ($Method == 'email' ? __('emailed to') . ' ' . DB_escape_string($EmailTo) : __('to be posted')) . ': ' . DB_escape_string($Letter['invoices']), $Candidate['amount'], $Candidate['status']['currcode']);
+		if ($Stages[$Candidate['stage']]['finalnotice'] == 1 and CreditControlSetting('CreditAutoStopAfterFinal', 0) == 1 and $Candidate['status']['level'] != 1) {
+			$StopReason = CreditStopReasonCode();
+			if ($StopReason !== false) {
+				CreditSetHoldReason($DebtorNo, $StopReason, __('Automatic stop after the final notice'));
+			}
+		}
+		DB_Txn_Commit();
+		$Sent++;
+		if ($Method == 'post') {
+			$Posted[] = array('name' => $Candidate['status']['name'], 'letter' => $Letter['subject'] . "\n\n" . $Letter['body']);
+		}
+	}
+	prnMsg($Sent . ' ' . __('reminders have been recorded'), 'success');
+	foreach ($Failed as $Message) {
+		prnMsg(htmlspecialchars($Message, ENT_QUOTES, 'UTF-8'), 'error');
+	}
+	if (count($Posted) > 0) {
+		echo '<h3>' . __('No email address - these letters must be posted') . '</h3>';
+		foreach ($Posted as $PostLetter) {
+			echo '<h4>' . htmlspecialchars($PostLetter['name'], ENT_QUOTES, 'UTF-8') . '</h4><pre>' . htmlspecialchars($PostLetter['letter'], ENT_QUOTES, 'UTF-8') . '</pre><hr />';
+		}
+	}
+	echo '<div class="centre"><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">' . __('Back to the reminder run') . '</a></div>';
+	include('includes/footer.php');
+	exit();
+}
+
+/* ---------- Preview ---------- */
+$Result = DB_query("SELECT DISTINCT debtorno FROM debtortrans WHERE settled=0 AND balance > 0");
+$Candidates = array();
+while ($MyRow = DB_fetch_array($Result)) {
+	$Candidate = DunningCandidate($MyRow['debtorno'], $Stages);
+	if ($Candidate !== false) {
+		$Candidates[$MyRow['debtorno']] = $Candidate;
+	}
+}
+
+if (count($Candidates) == 0) {
+	prnMsg(__('No customer is due a reminder'), 'info');
+	include('includes/footer.php');
+	exit();
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<p>' . __('Untick the customers who must not get a letter in this run, for example where a payment has been promised, then send.') . '</p>
+	<table class="selection">
+		<tr><th>' . __('Send') . '</th><th>' . __('Customer') . '</th><th>' . __('Stage') . '</th><th>' . __('Days overdue') . '</th><th>' . __('Overdue amount') . '</th><th>' . __('Sent to') . '</th></tr>';
+foreach ($Candidates as $DebtorNo => $Candidate) {
+	$Status = $Candidate['status'];
+	echo '<tr class="striped_row">
+			<td><input type="checkbox" name="Include[' . $DebtorNo . ']" checked="checked" /></td>
+			<td><a href="' . $RootPath . '/CreditReview.php?DebtorNo=' . urlencode($DebtorNo) . '">' . htmlspecialchars($Status['name'], ENT_QUOTES, 'UTF-8') . '</a></td>
+			<td class="number">' . $Candidate['stage'] . ($Stages[$Candidate['stage']]['finalnotice'] ? ' (' . __('final notice') . ')' : '') . '</td>
+			<td class="number">' . $Candidate['maxdays'] . '</td>
+			<td class="number">' . locale_number_format($Candidate['amount'], $Status['decimalplaces']) . ' ' . $Status['currcode'] . '</td>
+			<td>' . (count($Candidate['emails']) > 0 ? htmlspecialchars(implode(', ', array_keys($Candidate['emails'])), ENT_QUOTES, 'UTF-8') : '<b>' . __('No email address - letter to be posted') . '</b>') . '</td>
+		</tr>';
+}
+echo '</table>
+	<div class="centre"><input type="submit" name="Send" value="' . __('Send the Reminders') . '" /></div>
+</form>';
+
+include('includes/footer.php');

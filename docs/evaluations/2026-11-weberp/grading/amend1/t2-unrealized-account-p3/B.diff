diff --git a/sql/updates/41.php b/sql/updates/41.php
new file mode 100644
index 0000000..5f7ee53
--- /dev/null
+++ b/sql/updates/41.php
@@ -0,0 +1,15 @@
+<?php
+
+// Separate GL account for the unrealized exchange differences posted when
+// the rate of a currency is updated (revaluation of foreign currency bank accounts).
+// Existing installations start with the account they already used for it
+// (exchangediffact), so postings do not change until the preference is edited.
+
+AddColumn('unrealizedexchangediffact', 'companies', 'varchar(20)', 'NOT NULL', '0', 'freightact');
+
+if ($_SESSION['Updates']['Errors'] == 0) {
+	DB_query("UPDATE companies
+				SET unrealizedexchangediffact = exchangediffact
+				WHERE unrealizedexchangediffact = '0'");
+	UpdateDBNo(basename(__FILE__, '.php'), __('Add company preference for the unrealized exchange differences GL account'));
+}

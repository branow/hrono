+<?php
+
+/* Convert the active forecasts (revised quantity first) into MRP demands under the forecast demand type, so
+   that the normal MRP run plans purchases and work orders from them.
+
+   Replace mode removes the forecast demands of the same items and horizon that an earlier conversion wrote,
+   then writes the new ones. Incremental mode only adds the periods that have no forecast demand yet.
+   Either way converting twice gives the same demand. Demands entered by hand or created by other
+   functions are never touched: only demands recorded in forecastmrpdemands are ever removed. */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Convert Forecasts to MRP Demands');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastToMRP';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Parameters = ForecastGetParameters();
+
+if (isset($_POST['Convert'])) {
+	$InputError = false;
+	$Scope = ForecastRequest('Scope');
+	$Mode = ForecastRequest('Mode') == 'incremental' ? 'incremental' : 'replace';
+	$FromDate = ForecastRequest('FromDate');
+	$ToDate = ForecastRequest('ToDate');
+	$Filter = '1 = 1';
+
+	if (!ForecastIsDate($FromDate) or !ForecastIsDate($ToDate)) {
+		prnMsg(__('The dates must be entered as valid dates'), 'error');
+		$InputError = true;
+	} elseif (ForecastMonthIndex($FromDate) > ForecastMonthIndex($ToDate)) {
+		prnMsg(__('The date from must be before the date to'), 'error');
+		$InputError = true;
+	}
+	if ($Scope == 'item') {
+		$Item = ForecastFindItem(ForecastRequest('StockID'));
+		if (!$Item) {
+			prnMsg(__('The item code entered does not exist'), 'error');
+			$InputError = true;
+		} else {
+			$Filter = "forecasts.stockid = '" . DB_escape_string($Item['stockid']) . "'";
+		}
+	} elseif ($Scope == 'category') {
+		$Result = DB_query("SELECT categoryid FROM stockcategory WHERE categoryid = '" . DB_escape_string(ForecastRequest('CategoryID')) . "'");
+		$MyRow = DB_fetch_row($Result);
+		if (!$MyRow) {
+			prnMsg(__('Select a stock category'), 'error');
+			$InputError = true;
+		} else {
+			$Filter = "forecasts.stockid IN (SELECT stockid FROM stockmaster WHERE categoryid = '" . DB_escape_string($MyRow[0]) . "')";
+		}
+	} else {
+		$Scope = 'all';
+	}
+	if (!$InputError) {
+		$Done = ForecastConvertToMRP($Filter, $FromDate, $ToDate, $Mode);
+		prnMsg(sprintf(__('%s items converted: %s MRP demands created, %s earlier forecast demands removed, %s periods already present and left alone'), $Done['items'], $Done['created'], $Done['removed'], $Done['skipped']), 'success');
+		if ($Done['items'] == 0) {
+			prnMsg(__('There are no active forecasts for the selection - generate forecasts first'), 'info');
+		}
+	}
+}
+
+$Result = DB_query("SELECT COUNT(*), COUNT(DISTINCT forecastmrpdemands.stockid), MIN(forecastmrpdemands.periodstart), MAX(forecastmrpdemands.periodstart)
+					FROM forecastmrpdemands
+					INNER JOIN mrpdemands ON mrpdemands.demandid = forecastmrpdemands.demandid");
+$Present = DB_fetch_row($Result);
+echo '<fieldset>
+		<legend>' . __('Forecast demands in the master schedule') . '</legend>
+		<field><label>' . __('Demand type') . ':</label><fieldtext>' . FORECAST_DEMAND_TYPE . ' - ' . __('Statistical Forecast') . '</fieldtext></field>
+		<field><label>' . __('MRP demands from forecasts') . ':</label><fieldtext>' . $Present[0] . ' ' . __('for') . ' ' . $Present[1] . ' ' . __('items') . ($Present[0] > 0 ? ', ' . MonthAndYearFromSQLDate($Present[2]) . ' - ' . MonthAndYearFromSQLDate($Present[3]) : '') . '</fieldtext></field>
+	</fieldset>';
+
+$Scope = ForecastRequest('Scope');
+$FromValue = ForecastIsDate(ForecastRequest('FromDate')) ? ForecastRequest('FromDate') : date('Y-m-01');
+$ToValue = ForecastIsDate(ForecastRequest('ToDate')) ? ForecastRequest('ToDate') : ForecastLastDayOfMonth(ForecastAddMonths(date('Y-m-01'), (int) $Parameters['DefaultHorizon'] - 1));
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Convert active forecasts') . '</legend>
+		<field>
+			<label for="Scope">' . __('Items') . ':</label>
+			<select name="Scope" id="Scope">
+				<option value="all"' . ($Scope == 'all' || $Scope == '' ? ' selected="selected"' : '') . '>' . __('All items with an active forecast') . '</option>
+				<option value="category"' . ($Scope == 'category' ? ' selected="selected"' : '') . '>' . __('A stock category') . '</option>
+				<option value="item"' . ($Scope == 'item' ? ' selected="selected"' : '') . '>' . __('A single item') . '</option>
+			</select>
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category') . ':</label>
+			<select name="CategoryID" id="CategoryID">' . ForecastCategoryOptions(ForecastRequest('CategoryID')) . '</select>
+		</field>
+		<field>
+			<label for="StockID">' . __('Item code') . ':</label>
+			<input type="text" name="StockID" id="StockID" size="21" maxlength="64" value="' . ForecastHtml(ForecastRequest('StockID')) . '" />
+		</field>
+		<field>
+			<label for="FromDate">' . __('Horizon from') . ':</label>
+			<input type="date" name="FromDate" id="FromDate" required="required" value="' . $FromValue . '" />
+		</field>
+		<field>
+			<label for="ToDate">' . __('Horizon to') . ':</label>
+			<input type="date" name="ToDate" id="ToDate" required="required" value="' . $ToValue . '" />
+		</field>
+		<field>
+			<label for="Mode">' . __('Mode') . ':</label>
+			<select name="Mode" id="Mode">
+				<option value="replace"' . (ForecastRequest('Mode') != 'incremental' ? ' selected="selected"' : '') . '>' . __('Replace the forecast demands for these items and horizon') . '</option>
+				<option value="incremental"' . (ForecastRequest('Mode') == 'incremental' ? ' selected="selected"' : '') . '>' . __('Incremental - only add periods not yet present') . '</option>
+			</select>
+		</field>
+	</fieldset>
+	<div class="page_help_text">' .
+		__('One demand is written for each forecast month, due on the first day of the month, using the revised quantity where there is one. Where an item has forecasts for single locations only, the location forecasts are added together; a forecast for all locations combined is used on its own. Demands entered by hand are never changed.') . '
+	</div>
+	<div class="centre"><input type="submit" name="Convert" value="' . __('Convert to MRP Demands') . '" /></div>
+	</form>';
+
+echo '<div class="centre">
+		<a href="' . $RootPath . '/MRPDemands.php">' . __('Master Schedule') . '</a> |
+		<a href="' . $RootPath . '/MRP.php">' . __('MRP Calculation') . '</a> |
+		<a href="' . $RootPath . '/MRPReport.php">' . __('MRP') . '</a> |
+		<a href="' . $RootPath . '/ForecastDashboard.php">' . __('Forecasting Dashboard') . '</a>
+	</div>';
+
+include('includes/footer.php');

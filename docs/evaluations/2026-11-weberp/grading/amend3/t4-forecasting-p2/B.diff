+/* ------------------------------------------------------------------ page helpers */
+
+/* "All locations" plus every location, as <option> elements */
+function ForecastLocationOptions($Selected) {
+	$HTML = '<option value=""' . ($Selected === '' ? ' selected="selected"' : '') . '>' . __('All locations combined') . '</option>';
+	$Result = DB_query("SELECT loccode, locationname FROM locations ORDER BY locationname");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$HTML .= '<option value="' . htmlspecialchars($MyRow['loccode'], ENT_QUOTES, 'UTF-8') . '"' . ($Selected === $MyRow['loccode'] ? ' selected="selected"' : '') . '>' . htmlspecialchars($MyRow['locationname'], ENT_QUOTES, 'UTF-8') . '</option>';
+	}
+	return $HTML;
+}
+
+function ForecastCategoryOptions($Selected, $AllowBlank = true) {
+	$HTML = $AllowBlank ? '<option value="">' . __('Any category') . '</option>' : '';
+	$Result = DB_query("SELECT categoryid, categorydescription FROM stockcategory ORDER BY categorydescription");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$HTML .= '<option value="' . htmlspecialchars($MyRow['categoryid'], ENT_QUOTES, 'UTF-8') . '"' . ($Selected === $MyRow['categoryid'] ? ' selected="selected"' : '') . '>' . htmlspecialchars($MyRow['categorydescription'], ENT_QUOTES, 'UTF-8') . '</option>';
+	}
+	return $HTML;
+}
+
+function ForecastMethodOptions($Selected, $AllowBestFit = true) {
+	$HTML = '';
+	if ($AllowBestFit) {
+		$HTML .= '<option value="0"' . ($Selected == 0 ? ' selected="selected"' : '') . '>' . __('Best fit - let the system recommend') . '</option>';
+	}
+	foreach (ForecastMethods() as $MethodID => $Method) {
+		$HTML .= '<option value="' . $MethodID . '"' . ($Selected == $MethodID ? ' selected="selected"' : '') . '>' . $MethodID . ' - ' . htmlspecialchars($Method['name'], ENT_QUOTES, 'UTF-8') . ' (' . sprintf(__('min %s months'), $Method['min']) . ')</option>';
+	}
+	return $HTML;
+}
+
+/* Input fields for the method parameters. Values are the defaults/current values; blank = use company default */
+function ForecastParameterFields($Values, $Blank = false) {
+	$Labels = array('GrowthPercent' => __('Percent over last year (method 1)'),
+					'MAPeriods' => __('Moving average periods (method 4)'),
+					'LinearBackPeriods' => __('Periods between the two points (method 5)'),
+					'FlexibleWeights' => __('Weights per prior period, most recent first (method 8)'),
+					'WMAWeights' => __('Weights, most recent first (method 9)'),
+					'Alpha' => __('Smoothing constant alpha, 0.1 - 0.9 (methods 10 - 12)'),
+					'Beta' => __('Smoothing constant beta (methods 11, 12)'),
+					'Gamma' => __('Smoothing constant gamma (method 12)'),
+					'SeasonLength' => __('Season length in months (method 12)'),
+					'HoldoutMonths' => __('Months held out for best fit'));
+	$HTML = '';
+	foreach ($Labels as $Name => $Label) {
+		$HTML .= '<field>
+				<label for="' . $Name . '">' . $Label . ':</label>
+				<input type="text" name="' . $Name . '" id="' . $Name . '" size="30" value="' . ($Blank ? '' : htmlspecialchars($Values[$Name], ENT_QUOTES, 'UTF-8')) . '"' . ($Blank ? ' placeholder="' . htmlspecialchars($Values[$Name], ENT_QUOTES, 'UTF-8') . '"' : '') . ' />
+			</field>';
+	}
+	return $HTML;
+}

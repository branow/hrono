+		<field><label>' . __('Active summary forecasts') . ':</label><fieldtext>' . $Summaries[0] . '</fieldtext></field>
+		<field><label>' . __('Sales history') . ':</label><fieldtext>';
+if ($Range === null) {
+	echo __('Not extracted yet');
+} else {
+	$Counts = ForecastHistoryCounts();
+	echo MonthAndYearFromSQLDate($Range['from']) . ' - ' . MonthAndYearFromSQLDate($Range['to']) . ' (' . sprintf(__('%s items, %s months with sales'), $Counts['items'], $Counts['months']) . ')';
+}
+echo '</fieldtext></field>
+		<field><label>' . __('MRP demands from forecasts') . ':</label><fieldtext>' . $MRP[0] . ' (' . sprintf(__('%s items'), $MRP[1]) . ')</fieldtext></field>
+	</fieldset>';
+
+$Links = array(array(__('Extract Sales History'), 'ForecastHistory.php', __('Build the monthly sales history the forecasts are calculated from')),
+				array(__('Generate Forecasts'), 'ForecastGenerate.php', __('Forecast one item or a whole stock category')),
+				array(__('Review and Revise Forecasts'), 'ForecastReview.php', __('Review period by period and enter revised quantities')),
+				array(__('Summary Forecasts'), 'ForecastSummary.php', __('Forecast by category, customer type, sales area or salesperson')),
+				array(__('Forecast Inquiry'), 'ForecastInquiry.php', __('View forecasts by item, category, location and period')),
+				array(__('Forecast Accuracy'), 'ForecastAccuracy.php', __('Compare past forecasts with actual sales')),
+				array(__('Forecast Method Comparison'), 'ForecastMethodCompare.php', __('Compare methods for one item')),
+				array(__('Convert Forecasts to MRP Demands'), 'ForecastToMRP.php', __('Put the active forecasts into the MRP master schedule')),
+				array(__('Forecasting Parameters'), 'ForecastParameters.php', __('Company wide defaults')),
+				array(__('Master Schedule'), 'MRPDemands.php', __('MRP demands')),
+				array(__('MRP Calculation'), 'MRP.php', __('Run MRP')),
+				array(__('MRP'), 'MRPReport.php', __('MRP report')));
+
+echo '<table class="selection">
+		<tr><th>' . __('Function') . '</th><th>' . __('Description') . '</th></tr>';
+foreach ($Links as $Link) {
+	/* only links the user may use */
+	if (isset($_SESSION['PageSecurityArray'][$Link[1]]) and in_array($_SESSION['PageSecurityArray'][$Link[1]], $_SESSION['AllowedPageSecurityTokens'])) {
+		echo '<tr class="striped_row"><td><a href="' . $RootPath . '/' . $Link[1] . '">' . $Link[0] . '</a></td><td>' . $Link[2] . '</td></tr>';
+	}
+}
+echo '</table>';
+
+include('includes/footer.php');
diff --git a/ForecastGenerate.php b/ForecastGenerate.php
new file mode 100644
index 0000000..5e34fd8
--- /dev/null
+++ b/ForecastGenerate.php
@@ -0,0 +1,220 @@
+<?php
+
+/* Generate statistical forecasts for one item or for every active item of a stock category. Work is done in
+   batches of items per request, with progress and a result list, so a large category cannot time out. */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Generate Forecasts');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastGenerate';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+define('FORECAST_CHUNK', 25);
+
+$Range = ForecastHistoryRange();
+$Defaults = ForecastGetParameters();
+$BatchID = 0;
+
+if (isset($_POST['Generate'])) {
+	$InputError = false;
+	$Scope = ForecastRequest('Scope') == 'category' ? 'category' : 'item';
+	$MethodID = (int) ForecastRequest('MethodID');
+	$Horizon = ForecastRequest('Horizon') === '' ? (int) $Defaults['DefaultHorizon'] : ForecastRequest('Horizon');
+	$LocCode = ForecastRequest('LocCode');
+	$StockID = '';
+	$CategoryID = '';
+
+	if ($Range === null) {
+		prnMsg(__('There is no sales history to forecast from - extract it first'), 'error');
+		$InputError = true;
+	}
+	if ($MethodID < 0 or $MethodID > 12) {
+		prnMsg(__('The forecasting method is not valid'), 'error');
+		$InputError = true;
+	}
+	if (!is_numeric($Horizon) or $Horizon != (int) $Horizon or $Horizon < 1 or $Horizon > 36) {
+		prnMsg(__('The horizon must be a whole number of months between 1 and 36'), 'error');
+		$InputError = true;
+	}
+	if ($LocCode !== '') {
+		$Result = DB_query("SELECT loccode FROM locations WHERE loccode = '" . DB_escape_string($LocCode) . "'");
+		$MyRow = DB_fetch_row($Result);
+		if (!$MyRow) {
+			prnMsg(__('The location is not valid'), 'error');
+			$InputError = true;
+		}
+	}
+	if ($Scope == 'item') {
+		$Item = ForecastFindItem(ForecastRequest('StockID'));
+		if (!$Item) {
+			prnMsg(__('The item code entered does not exist'), 'error');
+			$InputError = true;
+		} else {
+			$StockID = $Item['stockid'];
+		}
+	} else {
+		$Result = DB_query("SELECT categoryid FROM stockcategory WHERE categoryid = '" . DB_escape_string(ForecastRequest('CategoryID')) . "'");
+		$MyRow = DB_fetch_row($Result);
+		if (!$MyRow) {
+			prnMsg(__('Select a stock category'), 'error');
+			$InputError = true;
+		} else {
+			$CategoryID = $MyRow[0];
+		}
+	}
+	list($P, $Errors) = ForecastResolveParameters($_POST);
+	foreach ($Errors as $Error) {
+		prnMsg($Error, 'error');
+		$InputError = true;
+	}
+	if (!$InputError) {
+		set_time_limit(0);
+		list($BatchID, $BestFit) = ForecastCreateBatch($Scope, $StockID, $CategoryID, $LocCode, $MethodID, (int) $Horizon, $P, $_SESSION['UserID']);
+	}
+} elseif (isset($_POST['Continue'])) {
+	$BatchID = (int) ForecastRequest('BatchID');
+} elseif (isset($_GET['BatchID'])) {
+	$BatchID = (int) $_GET['BatchID'];
+}
+
+if ($BatchID > 0) {
+	set_time_limit(0);
+	$Batch = ForecastProcessBatch($BatchID, FORECAST_CHUNK);
+	if ($Batch === null) {
+		prnMsg(__('That batch does not exist'), 'error');
+	} else {
+		$Done = $Batch['success'] + $Batch['failed'];
+		$PostedParameters = json_decode($Batch['parameters'], true);
+		echo '<fieldset>
+				<legend>' . sprintf(__('Batch %s'), $BatchID) . '</legend>';
+		echo '<field><label>' . __('Scope') . ':</label><fieldtext>' .
+			($Batch['scope'] == 'item' ? __('Item') . ' ' . ForecastHtml($Batch['stockid']) : __('Stock category') . ' ' . ForecastHtml($Batch['categoryid'])) .
+			' - ' . ($Batch['loccode'] === '' ? __('All locations combined') : ForecastHtml($Batch['loccode'])) . '</fieldtext></field>';
+		echo '<field><label>' . __('Method') . ':</label><fieldtext>';
+		if ((int) $Batch['methodid'] > 0) {
+			echo ForecastHtml(ForecastMethodName((int) $Batch['methodid']));
+		} elseif ($Batch['scope'] == 'item') {
+			echo __('Best fit for the item');
+		} elseif ((int) $Batch['chosenmethod'] > 0) {
+			echo __('Best fit for the category') . ': ' . ForecastHtml(ForecastMethodName((int) $Batch['chosenmethod']));
+		} else {
+			echo __('Best fit for the category') . ': ' . __('no method could be recommended');
+		}
+		echo '</fieldtext></field>';
+		echo '<field><label>' . __('Progress') . ':</label><fieldtext><progress max="' . max(1, (int) $Batch['total']) . '" value="' . $Done . '"></progress> ' . $Done . ' / ' . $Batch['total'] . '</fieldtext></field>';
+		echo '</fieldset>';
+
+		if ($Batch['status'] == 'running') {
+			echo '<form method="post" id="ContinueForm" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+					<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+					<input type="hidden" name="BatchID" value="' . $BatchID . '" />
+					<div class="centre"><input type="submit" name="Continue" value="' . __('Continue') . '" /></div>
+				</form>
+				<script>setTimeout(function () { document.getElementById("ContinueForm").submit(); }, 400);</script>';
+		} else {
+			prnMsg(sprintf(__('%s successful, %s failed'), $Batch['success'], $Batch['failed']), $Batch['failed'] > 0 ? 'warn' : 'success');
+		}
+
+		if (isset($PostedParameters['_bestfit'])) {
+			echo '<table class="selection">
+					<caption>' . __('Best fit - accuracy of each method on the held out months across the category') . '</caption>
+					<tr><th>' . __('Method') . '</th><th>' . __('Items evaluated') . '</th><th>' . __('Error as share of actual sales') . '</th><th></th></tr>';
+			foreach ($PostedParameters['_bestfit'] as $MethodID => $Total) {
+				if ($Total['items'] == 0) {
+					continue;
+				}
+				echo '<tr class="striped_row">
+						<td>' . $MethodID . ' - ' . ForecastHtml(ForecastMethodName($MethodID)) . '</td>
+						<td class="number">' . $Total['items'] . '</td>
+						<td class="number">' . ($Total['score'] >= PHP_INT_MAX ? '-' : locale_number_format($Total['score'] * 100, 1) . '%') . '</td>
+						<td>' . ($MethodID == $Batch['chosenmethod'] ? '<b>' . __('Recommended') . '</b>' : '') . '</td>
+					</tr>';
+			}
+			echo '</table><br />';
+		}
+
+		$Result = DB_query("SELECT forecastbatchresults.stockid, stockmaster.description, forecastbatchresults.status,
+									forecastbatchresults.methodid, forecastbatchresults.forecastid, forecastbatchresults.message
+							FROM forecastbatchresults
+							LEFT JOIN stockmaster ON stockmaster.stockid = forecastbatchresults.stockid
+							WHERE forecastbatchresults.batchid = " . $BatchID . "
+								AND forecastbatchresults.status <> 'pending'
+							ORDER BY forecastbatchresults.status, forecastbatchresults.stockid
+							LIMIT 1000");
+		if (DB_num_rows($Result) > 0) {
+			echo '<table class="selection">
+					<caption>' . __('Results') . '</caption>
+					<tr><th>' . __('Item') . '</th><th>' . __('Description') . '</th><th>' . __('Result') . '</th><th>' . __('Method') . '</th><th>' . __('Reason') . '</th></tr>';
+			while ($MyRow = DB_fetch_array($Result)) {
+				echo '<tr class="striped_row">
+						<td>' . ForecastHtml($MyRow['stockid']) . '</td>
+						<td>' . ForecastHtml($MyRow['description']) . '</td>
+						<td>' . ($MyRow['status'] == 'success' ? '<a href="' . $RootPath . '/ForecastReview.php?ForecastID=' . $MyRow['forecastid'] . '">' . __('Successful') . '</a>' : __('Failed')) . '</td>
+						<td>' . ($MyRow['methodid'] > 0 ? ForecastHtml(ForecastMethodName($MyRow['methodid'])) : '') . '</td>
+						<td>' . ForecastHtml($MyRow['message']) . '</td>
+					</tr>';
+			}
+			echo '</table>';
+			if ($Batch['total'] > 1000) {
+				echo '<div class="centre">' . __('Only the first 1000 results are listed') . '</div>';
+			}
+		}
+	}
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+if ($Range === null) {
+	prnMsg(__('There is no sales history yet.') . ' <a href="' . $RootPath . '/ForecastHistory.php">' . __('Extract Sales History') . '</a>', 'warn');
+} else {
+	echo '<div class="page_help_text">' . sprintf(__('Forecasts are calculated from the sales history held for %s to %s. The forecast periods follow the end of the history.'), MonthAndYearFromSQLDate($Range['from']), MonthAndYearFromSQLDate($Range['to'])) . '</div>';
+}
+echo '<fieldset>
+		<legend>' . __('Forecast scope') . '</legend>
+		<field>
+			<label for="Scope">' . __('Forecast') . ':</label>
+			<select name="Scope" id="Scope">
+				<option value="item"' . (ForecastRequest('Scope') != 'category' ? ' selected="selected"' : '') . '>' . __('A single item') . '</option>
+				<option value="category"' . (ForecastRequest('Scope') == 'category' ? ' selected="selected"' : '') . '>' . __('Every active item of a stock category') . '</option>
+			</select>
+		</field>
+		<field>
+			<label for="StockID">' . __('Item code') . ':</label>
+			<input type="text" name="StockID" id="StockID" size="21" maxlength="64" value="' . ForecastHtml(ForecastRequest('StockID')) . '" />
+			<fieldhelp>' . __('Used when forecasting a single item') . '</fieldhelp>
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category') . ':</label>
+			<select name="CategoryID" id="CategoryID">' . ForecastCategoryOptions(ForecastRequest('CategoryID')) . '</select>
+			<fieldhelp>' . __('Used when forecasting a category') . '</fieldhelp>
+		</field>
+		<field>
+			<label for="LocCode">' . __('Location') . ':</label>
+			<select name="LocCode" id="LocCode">' . ForecastLocationOptions(ForecastRequest('LocCode')) . '</select>
+		</field>
+	</fieldset>
+	<fieldset>
+		<legend>' . __('Method') . '</legend>
+		<field>
+			<label for="MethodID">' . __('Method') . ':</label>
+			<select name="MethodID" id="MethodID">' . ForecastMethodOptions(isset($_POST['MethodID']) ? (int) ForecastRequest('MethodID') : 0) . '</select>
+		</field>
+		<field>
+			<label for="Horizon">' . __('Horizon in monthly periods') . ':</label>
+			<input type="text" name="Horizon" id="Horizon" size="4" maxlength="2" class="number" value="' . ForecastHtml(ForecastRequest('Horizon') === '' ? $Defaults['DefaultHorizon'] : ForecastRequest('Horizon')) . '" />
+		</field>
+		<field><fieldtext>' . __('Leave a parameter blank to use the company default shown in it') . '</fieldtext></field>' .
+		ForecastParameterFields($Defaults, true) . '
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="Generate" value="' . __('Generate Forecasts') . '" />
+	</div>
+	</form>';
+
+echo '<div class="centre"><a href="' . $RootPath . '/ForecastDashboard.php">' . __('Forecasting Dashboard') . '</a></div>';
+
+include('includes/footer.php');
diff --git a/ForecastHistory.php b/ForecastHistory.php
new file mode 100644
index 0000000..e40b302
--- /dev/null
+++ b/ForecastHistory.php
@@ -0,0 +1,88 @@
+<?php
+
+/* Extract the monthly sales history (invoiced less credited quantities per item and location) that the
+   forecasts are calculated from. Re-running a range replaces it. */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Extract Sales History');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastHistory';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Parameters = ForecastGetParameters();
+$LastComplete = ForecastLastCompleteMonth();
+
+if (isset($_POST['Extract'])) {
+	$InputError = false;
+	$FromDate = ForecastRequest('FromDate');
+	$ToDate = ForecastRequest('ToDate');
+	if (!ForecastIsDate($FromDate) or !ForecastIsDate($ToDate)) {
+		prnMsg(__('The dates must be entered as valid dates'), 'error');
+		$InputError = true;
+	} else {
+		/* whole months only, and never the month in progress: a part month would look like a drop in demand */
+		if (ForecastMonthIndex($ToDate) > ForecastMonthIndex($LastComplete)) {
+			prnMsg(__('The month in progress is not complete, so the history has been ended with the last complete month') . ': ' . MonthAndYearFromSQLDate($LastComplete), 'info');
+			$ToDate = $LastComplete;
+		}
+		if (ForecastMonthIndex($FromDate) > ForecastMonthIndex($ToDate)) {
+			prnMsg(__('The date from must be before the date to'), 'error');
+			$InputError = true;
+		}
+	}
+	if (!$InputError) {
+		$Months = ForecastMonthIndex($ToDate) - ForecastMonthIndex($FromDate) + 1;
+		if ($Months < 12) {
+			prnMsg(sprintf(__('Only %s months have been selected - most forecasting methods need at least 12 months of history'), $Months), 'warn');
+		}
+		set_time_limit(0);
+		$Rows = ForecastExtractHistory($FromDate, $ToDate, $_SESSION['UserID']);
+		prnMsg(sprintf(__('The sales history from %s to %s has been extracted - %s item and location month records were written'), MonthAndYearFromSQLDate(ForecastMonthStart($FromDate)), MonthAndYearFromSQLDate(ForecastMonthStart($ToDate)), $Rows), 'success');
+	}
+}
+
+$Range = ForecastHistoryRange();
+echo '<fieldset>
+		<legend>' . __('Sales history held') . '</legend>';
+if ($Range === null) {
+	echo '<field><label>' . __('Status') . ':</label><fieldtext>' . __('No sales history has been extracted yet') . '</fieldtext></field>';
+} else {
+	$Counts = ForecastHistoryCounts();
+	echo '<field><label>' . __('Date range') . ':</label><fieldtext>' . MonthAndYearFromSQLDate($Range['from']) . ' - ' . MonthAndYearFromSQLDate($Range['to']) . '</fieldtext></field>
+		<field><label>' . __('Months') . ':</label><fieldtext>' . (ForecastMonthIndex($Range['to']) - ForecastMonthIndex($Range['from']) + 1) . '</fieldtext></field>
+		<field><label>' . __('Items with sales') . ':</label><fieldtext>' . $Counts['items'] . '</fieldtext></field>
+		<field><label>' . __('Months with sales') . ':</label><fieldtext>' . $Counts['months'] . '</fieldtext></field>
+		<field><label>' . __('History records') . ':</label><fieldtext>' . $Counts['rows'] . '</fieldtext></field>
+		<field><label>' . __('Last extracted') . ':</label><fieldtext>' . ForecastHtml($Range['on']) . ' ' . __('by') . ' ' . ForecastHtml($Range['user']) . '</fieldtext></field>';
+}
+echo '</fieldset>';
+
+$DefaultFrom = ForecastAddMonths($LastComplete, 1 - (int) $Parameters['DefaultHistoryMonths']);
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Extract sales for a date range') . '</legend>
+		<field>
+			<label for="FromDate">' . __('From') . ':</label>
+			<input type="date" name="FromDate" id="FromDate" required="required" value="' . (ForecastIsDate(ForecastRequest('FromDate')) ? ForecastRequest('FromDate') : $DefaultFrom) . '" />
+		</field>
+		<field>
+			<label for="ToDate">' . __('To') . ':</label>
+			<input type="date" name="ToDate" id="ToDate" required="required" value="' . (ForecastIsDate(ForecastRequest('ToDate')) ? ForecastRequest('ToDate') : ForecastLastDayOfMonth($LastComplete)) . '" />
+		</field>
+	</fieldset>
+	<div class="page_help_text">' .
+		__('Sales are the invoiced quantities less credit notes, the same movements the sales reports and inventory planning use, in whole calendar months. Extracting a range replaces what is held for it. A range that does not touch the range already held replaces it, so the history never has gaps. 24 months are recommended.') . '
+	</div>
+	<div class="centre">
+		<input type="submit" name="Extract" value="' . __('Extract Sales History') . '" />
+	</div>
+	</form>';
+
+echo '<div class="centre"><a href="' . $RootPath . '/ForecastDashboard.php">' . __('Forecasting Dashboard') . '</a></div>';
+
+include('includes/footer.php');
diff --git a/ForecastInquiry.php b/ForecastInquiry.php
new file mode 100644
index 0000000..06196b9
--- /dev/null
+++ b/ForecastInquiry.php
@@ -0,0 +1,108 @@
+<?php
+
+/* Inquiry on forecasts by item, category, location and period */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Inquiry');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastInquiry';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/magnifier.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$StockText = ForecastRequest('StockText');
+$CategoryID = ForecastRequest('CategoryID');
+$LocCode = isset($_POST['LocCode']) ? ForecastRequest('LocCode') : '*';
+$FromDate = ForecastIsDate(ForecastRequest('FromDate')) ? ForecastRequest('FromDate') : date('Y-m-01');
+$ToDate = ForecastIsDate(ForecastRequest('ToDate')) ? ForecastRequest('ToDate') : ForecastLastDayOfMonth(ForecastAddMonths(date('Y-m-01'), 11));
+$IncludeSuperseded = isset($_POST['IncludeSuperseded']);
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Select forecasts') . '</legend>
+		<field>
+			<label for="StockText">' . __('Item code or description contains') . ':</label>
+			<input type="text" name="StockText" id="StockText" size="20" value="' . ForecastHtml($StockText) . '" />
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category') . ':</label>
+			<select name="CategoryID" id="CategoryID">' . ForecastCategoryOptions($CategoryID) . '</select>
+		</field>
+		<field>
+			<label for="LocCode">' . __('Location') . ':</label>
+			<select name="LocCode" id="LocCode"><option value="*"' . ($LocCode === '*' ? ' selected="selected"' : '') . '>' . __('Any location') . '</option>' . ForecastLocationOptions($LocCode) . '</select>
+		</field>
+		<field>
+			<label for="FromDate">' . __('Periods from') . ':</label>
+			<input type="date" name="FromDate" id="FromDate" value="' . $FromDate . '" />
+		</field>
+		<field>
+			<label for="ToDate">' . __('Periods to') . ':</label>
+			<input type="date" name="ToDate" id="ToDate" value="' . $ToDate . '" />
+		</field>
+		<field>
+			<label for="IncludeSuperseded">' . __('Include superseded forecasts') . ':</label>
+			<input type="checkbox" name="IncludeSuperseded" id="IncludeSuperseded" value="1"' . ($IncludeSuperseded ? ' checked="checked"' : '') . ' />
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Search" value="' . __('Search') . '" /></div>
+	</form>';
+
+if (isset($_POST['Search'])) {
+	$SQL = "SELECT forecasts.forecastid, forecasts.stockid, stockmaster.description, forecasts.loccode, locations.locationname,
+					forecasts.methodid, forecasts.active, forecasts.generatedon,
+					forecastdetails.periodstart, forecastdetails.calcqty, forecastdetails.revisedqty
+			FROM forecasts
+			INNER JOIN forecastdetails ON forecastdetails.forecastid = forecasts.forecastid
+			INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+			LEFT JOIN locations ON locations.loccode = forecasts.loccode
+			WHERE forecastdetails.periodstart >= '" . ForecastMonthStart($FromDate) . "'
+				AND forecastdetails.periodstart <= '" . $ToDate . "'";
+	if (!$IncludeSuperseded) {
+		$SQL .= " AND forecasts.active = 1";
+	}
+	if ($StockText !== '') {
+		$SQL .= " AND (forecasts.stockid LIKE '%" . DB_escape_string($StockText) . "%' OR stockmaster.description LIKE '%" . DB_escape_string($StockText) . "%')";
+	}
+	if ($CategoryID !== '') {
+		$SQL .= " AND stockmaster.categoryid = '" . DB_escape_string($CategoryID) . "'";
+	}
+	if ($LocCode !== '*') {
+		$SQL .= " AND forecasts.loccode = '" . DB_escape_string($LocCode) . "'";
+	}
+	$SQL .= " ORDER BY forecasts.stockid, forecasts.loccode, forecastdetails.periodstart, forecasts.forecastid LIMIT 2000";
+	$Result = DB_query($SQL);
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('No forecasts match the selection'), 'info');
+	} else {
+		echo '<table class="selection">
+				<tr><th>' . __('Item') . '</th><th>' . __('Description') . '</th><th>' . __('Location') . '</th><th>' . __('Period') . '</th><th>' . __('Calculated') . '</th><th>' . __('Revised') . '</th><th>' . __('Forecast used') . '</th><th>' . __('Method') . '</th><th>' . __('Status') . '</th></tr>';
+		$Rows = 0;
+		while ($MyRow = DB_fetch_array($Result)) {
+			$Rows++;
+			$Used = $MyRow['revisedqty'] !== null ? $MyRow['revisedqty'] : $MyRow['calcqty'];
+			echo '<tr class="striped_row">
+					<td><a href="' . $RootPath . '/ForecastReview.php?ForecastID=' . $MyRow['forecastid'] . '">' . ForecastHtml($MyRow['stockid']) . '</a></td>
+					<td>' . ForecastHtml($MyRow['description']) . '</td>
+					<td>' . ($MyRow['loccode'] === '' ? __('All locations combined') : ForecastHtml($MyRow['locationname'])) . '</td>
+					<td>' . MonthAndYearFromSQLDate($MyRow['periodstart']) . '</td>
+					<td class="number">' . locale_number_format($MyRow['calcqty'], 2) . '</td>
+					<td class="number">' . ($MyRow['revisedqty'] !== null ? locale_number_format($MyRow['revisedqty'], 2) : '') . '</td>
+					<td class="number">' . locale_number_format($Used, 2) . '</td>
+					<td>' . ForecastHtml(ForecastMethodName($MyRow['methodid'])) . '</td>
+					<td>' . ($MyRow['active'] == 1 ? __('Active') : __('Superseded')) . '</td>
+				</tr>';
+		}
+		echo '</table>';
+		if ($Rows == 2000) {
+			echo '<div class="centre">' . __('Only the first 2000 rows are shown - narrow the selection') . '</div>';
+		}
+	}
+}
+
+echo '<div class="centre"><a href="' . $RootPath . '/ForecastDashboard.php">' . __('Forecasting Dashboard') . '</a></div>';
+
+include('includes/footer.php');
diff --git a/ForecastMethodCompare.php b/ForecastMethodCompare.php
new file mode 100644
index 0000000..e46f42f
--- /dev/null
+++ b/ForecastMethodCompare.php
@@ -0,0 +1,112 @@
+<?php
+
+/* Method comparison: the most recent months of one item's history are held out, forecast with every method that
+   has enough history left, and shown side by side with the actual sales and the accuracy of each method. */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Method Comparison');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastMethodCompare';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Defaults = ForecastGetParameters();
+$Range = ForecastHistoryRange();
+$LocCode = ForecastRequest('LocCode');
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Select an item') . '</legend>
+		<field>
+			<label for="StockID">' . __('Item code') . ':</label>
+			<input type="text" name="StockID" id="StockID" size="21" maxlength="64" required="required" value="' . ForecastHtml(ForecastRequest('StockID')) . '" />
+		</field>
+		<field>
+			<label for="LocCode">' . __('Location') . ':</label>
+			<select name="LocCode" id="LocCode">' . ForecastLocationOptions($LocCode) . '</select>
+		</field>
+		<field><fieldtext>' . __('Leave a parameter blank to use the company default shown in it') . '</fieldtext></field>' .
+		ForecastParameterFields($Defaults, true) . '
+	</fieldset>
+	<div class="centre"><input type="submit" name="Compare" value="' . __('Compare Methods') . '" /></div>
+	</form>';
+
+if (isset($_POST['Compare'])) {
+	$InputError = false;
+	$Item = ForecastFindItem(ForecastRequest('StockID'));
+	if (!$Item) {
+		prnMsg(__('The item code entered does not exist'), 'error');
+		$InputError = true;
+	}
+	if ($Range === null) {
+		prnMsg(__('There is no sales history to forecast from - extract it first'), 'error');
+		$InputError = true;
+	}
+	if ($LocCode !== '') {
+		$Result = DB_query("SELECT loccode FROM locations WHERE loccode = '" . DB_escape_string($LocCode) . "'");
+		if (!DB_fetch_row($Result)) {
+			prnMsg(__('The location is not valid'), 'error');
+			$InputError = true;
+		}
+	}
+	list($P, $Errors) = ForecastResolveParameters($_POST);
+	foreach ($Errors as $Error) {
+		prnMsg($Error, 'error');
+		$InputError = true;
+	}
+	$Holdout = (int) $P['HoldoutMonths'];
+	if (!$InputError) {
+		$History = ForecastLoadHistory('stockid', array('stockid' => $Item['stockid'], 'loccode' => $LocCode));
+		$Series = ForecastBuildSeries(isset($History[$Item['stockid']]) ? $History[$Item['stockid']] : array());
+		$N = count($Series['values']);
+		if ($N <= $Holdout) {
+			prnMsg(sprintf(__('%s has only %s months of sales history - not enough to hold %s months out'), ForecastHtml($Item['stockid']), $N, $Holdout), 'warn');
+		} else {
+			$Evaluation = ForecastEvaluateMethods($Series['values'], (int) $Holdout, $P);
+			$Best = 0;
+			foreach ($Evaluation as $MethodID => $Result) {
+				if ($Result['ok'] and ($Best == 0 or $Result['stats']['abs'] < $Evaluation[$Best]['stats']['abs'] - 1e-9)) {
+					$Best = $MethodID;
+				}
+			}
+			$FirstHeld = ForecastAddMonths($Range['to'], 1 - (int) $Holdout);
+			echo '<table class="selection">
+					<caption>' . ForecastHtml($Item['stockid']) . ' - ' . ForecastHtml($Item['description']) . ' - ' . sprintf(__('%s months of history, last %s months held out'), $N, $Holdout) . '</caption>
+					<tr><th>' . __('Method') . '</th>';
+			for ($i = 0; $i < $Holdout; $i++) {
+				echo '<th>' . MonthAndYearFromSQLDate(ForecastAddMonths($FirstHeld, $i)) . '</th>';
+			}
+			echo '<th>' . __('MAD') . '</th><th>' . __('POA') . '</th><th>' . __('MSE') . '</th><th>' . __('RMSE') . '</th><th></th></tr>';
+			echo '<tr><th>' . __('Actual sales') . '</th>';
+			foreach (array_slice($Series['values'], $N - (int) $Holdout) as $Actual) {
+				echo '<th class="number">' . locale_number_format($Actual, 2) . '</th>';
+			}
+			echo '<th colspan="5"></th></tr>';
+			foreach ($Evaluation as $MethodID => $Result) {
+				echo '<tr class="striped_row"' . ($MethodID == $Best ? ' style="background-color:#d9f2d9"' : '') . '><td>' . $MethodID . ' - ' . ForecastHtml(ForecastMethodName($MethodID)) . '</td>';
+				if ($Result['ok']) {
+					foreach ($Result['forecast'] as $Value) {
+						echo '<td class="number">' . locale_number_format($Value, 2) . '</td>';
+					}
+					echo '<td class="number">' . ForecastNumber($Result['stats']['mad']) . '</td>
+						<td class="number">' . ForecastNumber($Result['stats']['poa'], 1) . '%</td>
+						<td class="number">' . ForecastNumber($Result['stats']['mse']) . '</td>
+						<td class="number">' . ForecastNumber($Result['stats']['rmse']) . '</td>
+						<td>' . ($MethodID == $Best ? '<b>' . __('Best fit') . '</b>' : '') . '</td>';
+				} else {
+					echo '<td colspan="' . ((int) $Holdout + 5) . '">' . ForecastHtml($Result['error']) . '</td>';
+				}
+				echo '</tr>';
+			}
+			echo '</table>';
+		}
+	}
+}
+
+echo '<div class="centre"><a href="' . $RootPath . '/ForecastAccuracy.php">' . __('Forecast Accuracy') . '</a> | <a href="' . $RootPath . '/ForecastDashboard.php">' . __('Forecasting Dashboard') . '</a></div>';
+
+include('includes/footer.php');
diff --git a/ForecastParameters.php b/ForecastParameters.php
new file mode 100644
index 0000000..0163c12
--- /dev/null
+++ b/ForecastParameters.php
@@ -0,0 +1,76 @@
+<?php
+
+/* Company wide forecasting parameters: the defaults used when a user does not override them on a page */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecasting Parameters');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastParameters';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/maintenance.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+if (isset($_POST['Save'])) {
+	$Input = array();
+	$Missing = false;
+	foreach (array_keys(ForecastParameterDefaults()) as $Name) {
+		$Value = isset($_POST[$Name]) ? trim($_POST[$Name]) : '';
+		if ($Value === '') {
+			$Missing = true;
+		}
+		$Input[$Name] = $Value;
+	}
+	if ($Missing) {
+		prnMsg(__('Every parameter needs a value'), 'error');
+	} else {
+		list($Clean, $Errors) = ForecastValidateParameters($Input);
+		foreach ($Errors as $Error) {
+			prnMsg($Error, 'error');
+		}
+		if (count($Errors) == 0) {
+			DB_Txn_Begin();
+			foreach ($Clean as $Name => $Value) {
+				ForecastSetState($Name, $Value);
+			}
+			DB_Txn_Commit();
+			prnMsg(__('The forecasting parameters have been saved'), 'success');
+		}
+	}
+}
+
+$Values = ForecastGetParameters();
+if (isset($_POST['Save']) and isset($Errors) and count($Errors) > 0) {
+	foreach ($Input as $Name => $Value) {
+		$Values[$Name] = stripslashes($Value);
+	}
+}
+
+$General = array('DefaultHorizon' => __('Default horizon in monthly periods'),
+				'DefaultHistoryMonths' => __('Default months of sales history to extract'),
+				'LowAccuracyPOA' => __('Flag items with a percent of accuracy below'),
+				'VarianceHighlightPct' => __('Highlight a variance against last year above (%)'));
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Method parameters') . '</legend>' .
+		ForecastParameterFields($Values) . '
+	</fieldset>
+	<fieldset>
+		<legend>' . __('Defaults and thresholds') . '</legend>';
+foreach ($General as $Name => $Label) {
+	echo '<field>
+			<label for="' . $Name . '">' . $Label . ':</label>
+			<input type="text" name="' . $Name . '" id="' . $Name . '" size="10" class="number" value="' . ForecastHtml($Values[$Name]) . '" />
+		</field>';
+}
+echo '</fieldset>
+	<div class="page_help_text">' . __('Alpha is limited to 0.1 - 0.9. Weights are lists of numbers separated by commas, most recent period first; the weighted moving average scales them to add up to one. These values are used wherever a forecasting page is left blank.') . '</div>
+	<div class="centre"><input type="submit" name="Save" value="' . __('Save Parameters') . '" /></div>
+	</form>';
+
+echo '<div class="centre"><a href="' . $RootPath . '/ForecastDashboard.php">' . __('Forecasting Dashboard') . '</a></div>';
+
+include('includes/footer.php');
diff --git a/ForecastReview.php b/ForecastReview.php
new file mode 100644
index 0000000..382f9d0
--- /dev/null
+++ b/ForecastReview.php
@@ -0,0 +1,199 @@
+<?php
+
+/* Review forecasts period by period and revise them. A revised quantity always takes priority over the
+   calculated one (reports, accuracy and MRP all use COALESCE(revisedqty, calcqty)); clearing it restores the
+   calculated quantity. */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Review and Revise Forecasts');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastReview';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Parameters = ForecastGetParameters();
+$ForecastID = (int) ForecastRequest('ForecastID');
+
+if ($ForecastID > 0 and (isset($_POST['Save']) or isset($_POST['ClearAll']))) {
+	$Result = DB_query("SELECT periodstart FROM forecastdetails WHERE forecastid = " . $ForecastID);
+	$Updates = array();
+	$InputError = false;
+	while ($MyRow = DB_fetch_row($Result)) {
+		$Posted = (isset($_POST['Revised'][$MyRow[0]]) and !isset($_POST['ClearAll'])) ? trim($_POST['Revised'][$MyRow[0]]) : '';
+		if ($Posted === '') {
+			$Updates[$MyRow[0]] = 'NULL';
+		} else {
+			$Value = filter_number_format($Posted);
+			if (!is_numeric($Value) or $Value < 0) {
+				prnMsg(__('Revised quantities must be zero or more') . ': ' . MonthAndYearFromSQLDate($MyRow[0]), 'error');
+				$InputError = true;
+			} else {
+				$Updates[$MyRow[0]] = "'" . (float) $Value . "'";
+			}
+		}
+	}
+	if (!$InputError) {
+		DB_Txn_Begin();
+		foreach ($Updates as $Period => $Value) {
+			DB_query("UPDATE forecastdetails SET revisedqty = " . $Value . " WHERE forecastid = " . $ForecastID . " AND periodstart = '" . $Period . "'");
+		}
+		DB_Txn_Commit();
+		prnMsg(isset($_POST['ClearAll']) ? __('All revised quantities have been cleared - the calculated quantities apply') : __('The revised quantities have been saved'), 'success');
+	}
+}
+
+if ($ForecastID > 0) {
+	$SQL = "SELECT forecasts.*, stockmaster.description, stockmaster.decimalplaces, locations.locationname
+			FROM forecasts
+			INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+			LEFT JOIN locations ON locations.loccode = forecasts.loccode
+			WHERE forecasts.forecastid = " . $ForecastID;
+	$Result = DB_query($SQL);
+	$Forecast = DB_fetch_array($Result);
+	if (!$Forecast) {
+		prnMsg(__('That forecast does not exist'), 'error');
+	} else {
+		$Details = array();
+		$Result = DB_query("SELECT periodstart, calcqty, revisedqty FROM forecastdetails WHERE forecastid = " . $ForecastID . " ORDER BY periodstart");
+		while ($MyRow = DB_fetch_array($Result)) {
+			$Details[] = $MyRow;
+		}
+		$LastYear = array();
+		if (count($Details) > 0) {
+			$LastYear = ForecastActualsByMonth($Forecast['stockid'], $Forecast['loccode'], ForecastAddMonths($Details[0]['periodstart'], -12), ForecastAddMonths($Details[count($Details) - 1]['periodstart'], -12));
+		}
+		echo '<fieldset>
+				<legend>' . ForecastHtml($Forecast['stockid']) . ' - ' . ForecastHtml($Forecast['description']) . '</legend>
+				<field><label>' . __('Location') . ':</label><fieldtext>' . ($Forecast['loccode'] === '' ? __('All locations combined') : ForecastHtml($Forecast['locationname'])) . '</fieldtext></field>

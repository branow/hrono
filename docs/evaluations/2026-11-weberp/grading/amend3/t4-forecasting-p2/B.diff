diff --git a/ForecastAccuracy.php b/ForecastAccuracy.php
new file mode 100644
index 0000000..6129aaa
--- /dev/null
+++ b/ForecastAccuracy.php
@@ -0,0 +1,100 @@
+<?php
+
+/* Forecast accuracy: past forecasts compared with the actual sales that followed.
+   MAD  = mean absolute deviation
+   POA  = percent of accuracy = 100 x (1 - total absolute error / total actual sales), not below zero
+   MSE  = mean squared error, RMSE = its square root */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Accuracy');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastAccuracy';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Parameters = ForecastGetParameters();
+$LastComplete = ForecastLastCompleteMonth();
+$FromDate = ForecastIsDate(ForecastRequest('FromDate')) ? ForecastRequest('FromDate') : ForecastAddMonths($LastComplete, -5);
+$ToDate = ForecastIsDate(ForecastRequest('ToDate')) ? ForecastRequest('ToDate') : ForecastLastDayOfMonth($LastComplete);
+$CategoryID = ForecastRequest('CategoryID');
+$LocCode = isset($_POST['LocCode']) ? ForecastRequest('LocCode') : '*';
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<fieldset>
+		<legend>' . __('Select the forecast periods to measure') . '</legend>
+		<field>
+			<label for="FromDate">' . __('From') . ':</label>
+			<input type="date" name="FromDate" id="FromDate" required="required" value="' . $FromDate . '" />
+		</field>
+		<field>
+			<label for="ToDate">' . __('To') . ':</label>
+			<input type="date" name="ToDate" id="ToDate" required="required" value="' . $ToDate . '" />
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category') . ':</label>
+			<select name="CategoryID" id="CategoryID">' . ForecastCategoryOptions($CategoryID) . '</select>
+		</field>
+		<field>
+			<label for="LocCode">' . __('Location') . ':</label>
+			<select name="LocCode" id="LocCode"><option value="*"' . ($LocCode === '*' ? ' selected="selected"' : '') . '>' . __('Any location') . '</option>' . ForecastLocationOptions($LocCode) . '</select>
+		</field>
+	</fieldset>
+	<div class="centre"><input type="submit" name="Search" value="' . __('Measure Accuracy') . '" /></div>
+	</form>';
+
+function ForecastStatsCells($Stats, $Low) {
+	return '<td class="number">' . $Stats['n'] . '</td>
+			<td class="number">' . ForecastNumber($Stats['mad']) . '</td>
+			<td class="number">' . ForecastNumber($Stats['poa'], 1) . '%</td>
+			<td class="number">' . ForecastNumber($Stats['mse']) . '</td>
+			<td class="number">' . ForecastNumber($Stats['rmse']) . '</td>
+			<td>' . ($Low ? '<b style="color:#b00020">' . __('Low accuracy') . '</b>' : '') . '</td>';
+}
+
+if (isset($_POST['Search'])) {
+	if (!ForecastIsDate($FromDate) or !ForecastIsDate($ToDate) or ForecastMonthIndex($FromDate) > ForecastMonthIndex($ToDate)) {
+		prnMsg(__('Enter a valid range of dates'), 'error');
+	} else {
+		if (ForecastMonthIndex($ToDate) > ForecastMonthIndex($LastComplete)) {
+			prnMsg(__('Only months that are over can be measured, so the range has been ended with the last complete month') . ': ' . MonthAndYearFromSQLDate($LastComplete), 'info');
+		}
+		$Data = ForecastAccuracyData($FromDate, $ToDate, $CategoryID, $LocCode);
+		if (count($Data['items']) == 0) {
+			prnMsg(__('There are no forecasts for completed months in that range'), 'info');
+		} else {
+			$Threshold = (float) $Parameters['LowAccuracyPOA'];
+			echo '<div class="page_help_text">' . sprintf(__('Items with a percent of accuracy below %s%% are flagged. The threshold is set in the forecasting parameters.'), locale_number_format($Threshold, 0)) . '</div>';
+
+			echo '<table class="selection"><caption>' . __('By method') . '</caption>
+					<tr><th>' . __('Method') . '</th><th>' . __('Periods') . '</th><th>' . __('MAD') . '</th><th>' . __('POA') . '</th><th>' . __('MSE') . '</th><th>' . __('RMSE') . '</th><th></th></tr>';
+			foreach ($Data['methods'] as $Row) {
+				echo '<tr class="striped_row"><td>' . $Row['methodid'] . ' - ' . ForecastHtml(ForecastMethodName($Row['methodid'])) . '</td>' . ForecastStatsCells($Row['stats'], false) . '</tr>';
+			}
+			echo '</table><br />';
+
+			echo '<table class="selection"><caption>' . __('By stock category') . '</caption>
+					<tr><th>' . __('Category') . '</th><th>' . __('Periods') . '</th><th>' . __('MAD') . '</th><th>' . __('POA') . '</th><th>' . __('MSE') . '</th><th>' . __('RMSE') . '</th><th></th></tr>';
+			foreach ($Data['categories'] as $Row) {
+				$Result = DB_query("SELECT categorydescription FROM stockcategory WHERE categoryid = '" . DB_escape_string($Row['categoryid']) . "'");
+				$Name = DB_fetch_row($Result);
+				echo '<tr class="striped_row"><td>' . ForecastHtml($Row['categoryid']) . ' - ' . ForecastHtml($Name ? $Name[0] : '') . '</td>' . ForecastStatsCells($Row['stats'], $Row['stats']['poa'] < $Threshold) . '</tr>';
+			}
+			echo '</table><br />';
+
+			echo '<table class="selection"><caption>' . __('By item') . '</caption>
+					<tr><th>' . __('Item') . '</th><th>' . __('Location') . '</th><th>' . __('Periods') . '</th><th>' . __('MAD') . '</th><th>' . __('POA') . '</th><th>' . __('MSE') . '</th><th>' . __('RMSE') . '</th><th></th></tr>';
+			foreach ($Data['items'] as $Row) {
+				echo '<tr class="striped_row"><td>' . ForecastHtml($Row['stockid']) . '</td><td>' . ($Row['loccode'] === '' ? __('All locations combined') : ForecastHtml($Row['loccode'])) . '</td>' . ForecastStatsCells($Row['stats'], $Row['stats']['poa'] < $Threshold) . '</tr>';
+			}
+			echo '</table>';
+		}
+	}
+}
+
+echo '<div class="centre"><a href="' . $RootPath . '/ForecastMethodCompare.php">' . __('Forecast Method Comparison') . '</a> | <a href="' . $RootPath . '/ForecastDashboard.php">' . __('Forecasting Dashboard') . '</a></div>';
+
+include('includes/footer.php');
diff --git a/ForecastDashboard.php b/ForecastDashboard.php

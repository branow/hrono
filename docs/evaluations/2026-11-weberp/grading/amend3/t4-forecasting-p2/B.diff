+<?php
+
+/* Dashboard of the demand forecasting module */
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecasting Dashboard');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastDashboard';
+include('includes/header.php');
+
+echo '<p class="page_title_text"><img src="' . $RootPath . '/css/' . $Theme . '/images/inventory.png" title="' . $Title . '" alt="" /> ' . $Title . '</p>';
+
+$Result = DB_query("SELECT COUNT(*), COUNT(DISTINCT stockid) FROM forecasts WHERE active = 1");
+$Active = DB_fetch_row($Result);
+$Result = DB_query("SELECT COUNT(*) FROM forecastsummaries WHERE active = 1");
+$Summaries = DB_fetch_row($Result);
+$Result = DB_query("SELECT COUNT(*), COUNT(DISTINCT forecastmrpdemands.stockid) FROM forecastmrpdemands INNER JOIN mrpdemands ON mrpdemands.demandid = forecastmrpdemands.demandid");
+$MRP = DB_fetch_row($Result);
+$Range = ForecastHistoryRange();
+
+echo '<fieldset>
+		<legend>' . __('Forecasting status') . '</legend>

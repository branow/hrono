+					</table>';
+				if (count($Items) == 50) {
+					echo '<div class="centre">' . __('The 50 items with the most sales are listed') . '</div>';
+				}
+			}
+		}
+		echo '<div class="centre"><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">' . __('Summary Forecasts') . '</a></div>';
+	}
+}
+
+/* ---------------------------------------------------------------- list and build form */
+if ($SummaryID == 0 or !isset($Summary) or !$Summary) {
+	$Result = DB_query("SELECT summaryid, dimension, dimkey, methodid, horizon, generatedon,
+								(SELECT COUNT(*) FROM forecastsummarydetails WHERE forecastsummarydetails.summaryid = forecastsummaries.summaryid AND revisedqty IS NOT NULL) AS revisions
+						FROM forecastsummaries
+						WHERE active = 1
+						ORDER BY dimension, dimkey");
+	if (DB_num_rows($Result) > 0) {
+		echo '<table class="selection">
+				<caption>' . __('Current summary forecasts') . '</caption>
+				<tr><th>' . __('Summarised by') . '</th><th>' . __('Key') . '</th><th>' . __('Method') . '</th><th>' . __('Periods') . '</th><th>' . __('Revised periods') . '</th><th>' . __('Generated') . '</th><th></th></tr>';
+		while ($MyRow = DB_fetch_array($Result)) {
+			echo '<tr class="striped_row">
+					<td>' . $Dimensions[$MyRow['dimension']] . '</td>
+					<td>' . ForecastHtml(SummaryKeyName($MyRow['dimension'], $MyRow['dimkey'])) . '</td>
+					<td>' . ForecastHtml(ForecastMethodName($MyRow['methodid'])) . '</td>
+					<td class="number">' . $MyRow['horizon'] . '</td>
+					<td class="number">' . $MyRow['revisions'] . '</td>
+					<td>' . ForecastHtml($MyRow['generatedon']) . '</td>
+					<td><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '?SummaryID=' . $MyRow['summaryid'] . '">' . __('Review') . '</a></td>
+				</tr>';
+		}
+		echo '</table><br />';
+	}
+
+	if ($Range === null) {
+		prnMsg(__('There is no sales history yet.') . ' <a href="' . $RootPath . '/ForecastHistory.php">' . __('Extract Sales History') . '</a>', 'warn');
+	}
+	$SelectedDimension = ForecastRequest('Dimension');
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<fieldset>
+			<legend>' . __('Build summary forecasts') . '</legend>
+			<field>
+				<label for="Dimension">' . __('Summarise by') . ':</label>
+				<select name="Dimension" id="Dimension">';
+	foreach ($Dimensions as $Code => $Name) {
+		echo '<option value="' . $Code . '"' . ($SelectedDimension == $Code ? ' selected="selected"' : '') . '>' . $Name . '</option>';
+	}
+	echo '</select>
+			</field>';
+	foreach ($Dimensions as $Code => $Name) {
+		echo '<field>
+				<label for="Key_' . $Code . '">' . $Name . ':</label>
+				<select name="Key_' . $Code . '" id="Key_' . $Code . '">' . SummaryKeyOptions($Code, ForecastRequest('Key_' . $Code)) . '</select>
+				<fieldhelp>' . sprintf(__('Used when summarising by %s - All builds one summary for each value that has sales'), mb_strtolower($Name)) . '</fieldhelp>
+			</field>';
+	}
+	echo '<field>
+			<label for="MethodID">' . __('Method') . ':</label>
+			<select name="MethodID" id="MethodID">' . ForecastMethodOptions(isset($_POST['MethodID']) ? (int) ForecastRequest('MethodID') : 0) . '</select>
+		</field>
+		<field>
+			<label for="Horizon">' . __('Horizon in monthly periods') . ':</label>
+			<input type="text" name="Horizon" id="Horizon" size="4" maxlength="2" class="number" value="' . ForecastHtml(ForecastRequest('Horizon') === '' ? $Parameters['DefaultHorizon'] : ForecastRequest('Horizon')) . '" />
+		</field>
+		<field><fieldtext>' . __('Leave a parameter blank to use the company default shown in it') . '</fieldtext></field>' .
+		ForecastParameterFields($Parameters, true) . '
+		</fieldset>
+		<div class="centre"><input type="submit" name="Generate" value="' . __('Build Summary Forecasts') . '" /></div>
+		</form>';
+}
+
+echo '<div class="centre"><a href="' . $RootPath . '/ForecastDashboard.php">' . __('Forecasting Dashboard') . '</a></div>';
+
+include('includes/footer.php');

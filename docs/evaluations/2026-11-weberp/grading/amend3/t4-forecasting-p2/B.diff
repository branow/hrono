+/* Look an item up and return its raw id and description, or false */
+function ForecastFindItem($StockIDFromRequest) {
+	$Result = DB_query("SELECT stockid, description, categoryid, decimalplaces FROM stockmaster WHERE stockid = '" . DB_escape_string($StockIDFromRequest) . "'");
+	return DB_fetch_array($Result);
+}
+
+/* A request value as the raw string the database holds. $_POST has been SQL escaped by session.php (the
+   html encoding stays, as it does for every other page), so the escaping is taken off again. */
+function ForecastRequest($Name) {
+	if (isset($_POST[$Name]) and is_string($_POST[$Name])) {
+		return trim(stripslashes($_POST[$Name]));
+	}
+	if (isset($_GET[$Name]) and is_string($_GET[$Name])) {
+		return trim($_GET[$Name]);
+	}
+	return '';
+}
+
+/* Accuracy of past forecasts in the months From..To (only months that are over), optionally for one category
+   and one location ('*' = any, blank = forecasts for all locations combined).
+   Item and category figures use the latest forecast made for each item, location and month, so a month is not
+   counted twice when a forecast was regenerated; the per method figures use every forecast.
+   Returns array('items' => list, 'categories' => list, 'methods' => list), each entry with 'stats'. */
+function ForecastAccuracyData($FromMonth, $ToMonth, $CategoryID, $LocCode) {
+	$FromMonth = ForecastMonthStart($FromMonth);
+	$ToMonth = min(ForecastMonthStart($ToMonth), ForecastLastCompleteMonth());
+	$SQL = "SELECT forecasts.forecastid,
+					forecasts.stockid,
+					forecasts.loccode,
+					forecasts.methodid,
+					forecastdetails.periodstart,
+					COALESCE(forecastdetails.revisedqty, forecastdetails.calcqty) AS qty,
+					stockmaster.categoryid
+			FROM forecasts
+			INNER JOIN forecastdetails ON forecastdetails.forecastid = forecasts.forecastid
+			INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+			WHERE forecastdetails.periodstart >= '" . $FromMonth . "'
+				AND forecastdetails.periodstart <= '" . $ToMonth . "'";
+	if ($CategoryID !== '') {
+		$SQL .= " AND stockmaster.categoryid = '" . DB_escape_string($CategoryID) . "'";
+	}
+	if ($LocCode !== '*') {
+		$SQL .= " AND forecasts.loccode = '" . DB_escape_string($LocCode) . "'";
+	}
+	$Result = DB_query($SQL);
+	$Rows = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Rows[] = $MyRow;
+	}
+	$Out = array('items' => array(), 'categories' => array(), 'methods' => array());
+	if (count($Rows) == 0) {
+		return $Out;
+	}
+
+	$SQL = "SELECT stockmoves.stockid,
+					stockmoves.loccode,
+					DATE_FORMAT(stockmoves.trandate, '%Y-%m-01') AS periodstart,
+					SUM(-stockmoves.qty) AS qty
+			FROM stockmoves
+			WHERE " . ForecastSalesWhere() . "
+				AND stockmoves.trandate >= '" . $FromMonth . "'
+				AND stockmoves.trandate <= '" . ForecastLastDayOfMonth($ToMonth) . "'
+				AND stockmoves.stockid IN (SELECT DISTINCT stockid FROM forecasts)
+			GROUP BY stockmoves.stockid, stockmoves.loccode, periodstart";
+	$Result = DB_query($SQL);
+	$ByLocation = array();
+	$AllLocations = array();
+	while ($MyRow = DB_fetch_array($Result)) {
+		$ByLocation[$MyRow['stockid']][$MyRow['loccode']][$MyRow['periodstart']] = (float) $MyRow['qty'];
+		if (!isset($AllLocations[$MyRow['stockid']][$MyRow['periodstart']])) {
+			$AllLocations[$MyRow['stockid']][$MyRow['periodstart']] = 0;
+		}
+		$AllLocations[$MyRow['stockid']][$MyRow['periodstart']] += (float) $MyRow['qty'];
+	}
+
+	$Latest = array();
+	$MethodPairs = array();
+	foreach ($Rows as $Row) {
+		if ($Row['loccode'] === '') {
+			$Actual = isset($AllLocations[$Row['stockid']][$Row['periodstart']]) ? $AllLocations[$Row['stockid']][$Row['periodstart']] : 0;
+		} else {
+			$Actual = isset($ByLocation[$Row['stockid']][$Row['loccode']][$Row['periodstart']]) ? $ByLocation[$Row['stockid']][$Row['loccode']][$Row['periodstart']] : 0;
+		}
+		$Row['actual'] = $Actual;
+		$MethodPairs[$Row['methodid']][] = array($Actual, (float) $Row['qty']);
+		$Key = $Row['stockid'] . "\n" . $Row['loccode'] . "\n" . $Row['periodstart'];
+		if (!isset($Latest[$Key]) or $Row['forecastid'] > $Latest[$Key]['forecastid']) {
+			$Latest[$Key] = $Row;
+		}
+	}
+	$ItemPairs = array();
+	$CategoryPairs = array();
+	foreach ($Latest as $Row) {
+		$ItemPairs[$Row['stockid'] . "\n" . $Row['loccode']][] = array($Row['actual'], (float) $Row['qty']);
+		$CategoryPairs[$Row['categoryid']][] = array($Row['actual'], (float) $Row['qty']);
+	}
+	ksort($ItemPairs);
+	ksort($CategoryPairs);
+	ksort($MethodPairs);
+	foreach ($ItemPairs as $Key => $Pairs) {
+		list($StockID, $Loc) = explode("\n", $Key);
+		$Out['items'][] = array('stockid' => $StockID, 'loccode' => $Loc, 'stats' => ForecastStats($Pairs));
+	}
+	foreach ($CategoryPairs as $Key => $Pairs) {
+		$Out['categories'][] = array('categoryid' => $Key, 'stats' => ForecastStats($Pairs));
+	}
+	foreach ($MethodPairs as $Key => $Pairs) {
+		$Out['methods'][] = array('methodid' => $Key, 'stats' => ForecastStats($Pairs));
+	}
+	return $Out;
+}
+
+function ForecastHtml($Text) {
+	return htmlspecialchars((string) $Text, ENT_QUOTES, 'UTF-8');
+}
+
+function ForecastNumber($Value, $Decimals = 2) {
+	return $Value === null ? '-' : locale_number_format($Value, $Decimals);
+}

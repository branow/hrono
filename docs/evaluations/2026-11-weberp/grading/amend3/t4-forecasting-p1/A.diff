+++ b/ForecastSummary.php
@@ -0,0 +1,161 @@
+<?php
+
+// Summary forecasts by stock category, customer type, sales area or salesperson, built from the extracted sales history
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Summary Forecasts');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastSummary';
+include('includes/header.php');
+
+ForecastPageTitle($Title);
+
+$Defaults = ForecastGetParameters();
+$DimensionTypes = ForecastDimensionTypes();
+
+if (isset($_POST['Generate'])) {
+	$InputError = 0;
+	$Parameters = ForecastReadParameters($_POST);
+	$Method = isset($_POST['Method']) ? (int) $_POST['Method'] : 0;
+	$Horizon = isset($_POST['Horizon']) ? (int) $_POST['Horizon'] : 0;
+	$Choice = isset($_POST['Summarise']) ? explode('|', ForecastInput($_POST['Summarise']), 2) : array('', '');
+
+	foreach (ForecastValidateParameters($Parameters) as $Error) {
+		prnMsg($Error, 'error');
+		$InputError = 1;
+	}
+	if ($Horizon < 1 or $Horizon > 36) {
+		prnMsg(__('The horizon must be between 1 and 36 months'), 'error');
+		$InputError = 1;
+	}
+	if ($Method != 0 and !array_key_exists($Method, ForecastMethods())) {
+		prnMsg(__('Unknown forecasting method'), 'error');
+		$InputError = 1;
+	}
+	if (count($Choice) != 2 or !array_key_exists($Choice[0], $DimensionTypes)) {
+		prnMsg(__('Select what to summarise'), 'error');
+		$InputError = 1;
+	}
+	if (ForecastHistoryBounds()['to'] === null) {
+		ForecastNoHistoryNotice();
+		$InputError = 1;
+	}
+	if ($InputError == 0) {
+		$Keys = ForecastDimensionKeys($Choice[0]);
+		if ($Choice[1] != '*') {
+			$Keys = array_key_exists($Choice[1], $Keys) ? array($Choice[1] => $Keys[$Choice[1]]) : array();
+		}
+		if (count($Keys) == 0) {
+			prnMsg(__('There is no sales history for the selection'), 'warn');
+		} else {
+			set_time_limit(300);
+			$Succeeded = 0;
+			$Failed = 0;
+			$Rows = '';
+			foreach ($Keys as $Key => $Name) {
+				$Outcome = ForecastGenerateSummary($Choice[0], (string) $Key, $Method, $Horizon, $Parameters, $_SESSION['UserID']);
+				if ($Outcome['ok']) {
+					$Succeeded++;
+					$Rows .= '<tr class="striped_row">
+							<td>' . htmlspecialchars($Name, ENT_QUOTES, 'UTF-8') . '</td>
+							<td><a href="' . $RootPath . '/ForecastSummaryReview.php?SummaryID=' . $Outcome['summaryid'] . '">' . __('Successful') . '</a></td>
+							<td>' . htmlspecialchars(ForecastMethodName($Outcome['method']), ENT_QUOTES, 'UTF-8') . '</td>
+							<td></td>
+						</tr>';
+				} else {
+					$Failed++;
+					$Rows .= '<tr class="striped_row">
+							<td>' . htmlspecialchars($Name, ENT_QUOTES, 'UTF-8') . '</td>
+							<td>' . __('Failed') . '</td>
+							<td></td>
+							<td>' . htmlspecialchars($Outcome['message'], ENT_QUOTES, 'UTF-8') . '</td>
+						</tr>';
+				}
+			}
+			prnMsg(sprintf(__('%d successful, %d failed'), $Succeeded, $Failed), $Failed > 0 ? 'warn' : 'success');
+			echo '<table class="selection">
+					<tr><th>' . $DimensionTypes[$Choice[0]] . '</th><th>' . __('Result') . '</th><th>' . __('Method') . '</th><th>' . __('Reason') . '</th></tr>' . $Rows . '
+				</table><br />';
+		}
+	}
+	$FormValues = $Parameters;
+	$FormChoice = isset($_POST['Summarise']) ? ForecastInput($_POST['Summarise']) : '';
+	$FormMethod = $Method;
+	$FormHorizon = $Horizon;
+} else {
+	$FormValues = $Defaults;
+	$FormChoice = '';
+	$FormMethod = 0;
+	$FormHorizon = $Defaults['defaulthorizon'];
+}
+
+$Options = '';
+foreach ($DimensionTypes as $Type => $TypeName) {
+	$Options .= '<optgroup label="' . htmlspecialchars($TypeName, ENT_QUOTES, 'UTF-8') . '">
+		<option value="' . $Type . '|*"' . ($FormChoice == $Type . '|*' ? ' selected="selected"' : '') . '>' . sprintf(__('Every %s'), mb_strtolower($TypeName)) . '</option>';
+	foreach (ForecastDimensionKeys($Type) as $Key => $Name) {
+		$Value = $Type . '|' . $Key;
+		$Options .= '<option value="' . htmlspecialchars($Value, ENT_QUOTES, 'UTF-8') . '"' . ($FormChoice === $Value ? ' selected="selected"' : '') . '>' . htmlspecialchars(($Key === '' ? '' : $Key . ' - ') . $Name, ENT_QUOTES, 'UTF-8') . '</option>';
+	}
+	$Options .= '</optgroup>';
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset>
+		<legend>' . __('Generate summary forecasts') . '</legend>
+		<field>
+			<label for="Summarise">' . __('Summarise') . ':</label>
+			<select name="Summarise" id="Summarise">' . $Options . '</select>
+		</field>
+		<field>
+			<label for="Method">' . __('Method') . ':</label>
+			<select name="Method" id="Method">' . ForecastMethodOptions($FormMethod, __('Best fit (let the system recommend)')) . '</select>
+		</field>
+		<field>
+			<label for="Horizon">' . __('Months to forecast') . ':</label>
+			<input type="number" name="Horizon" id="Horizon" min="1" max="36" step="1" value="' . (int) $FormHorizon . '" />
+		</field>
+		' . ForecastParameterFields($FormValues) . '
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="Generate" value="' . __('Generate Summary Forecasts') . '" />
+	</div>
+	</form>';
+echo '<div class="page_help_text">' . __('Summary forecasts add up the sales of every item, in the units each item is held in, so they are most meaningful where the items share a unit. They use the same extracted sales history as the item forecasts and are not sent to MRP.') . '</div>';
+
+$Result = DB_query("SELECT summaryid, dimtype, dimkey, method, horizon, createdate, createdby

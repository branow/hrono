diff --git a/ForecastAccuracy.php b/ForecastAccuracy.php
new file mode 100644
index 0000000..41e1ad6
--- /dev/null
+++ b/ForecastAccuracy.php
@@ -0,0 +1,192 @@
+<?php
+
+// Compare past forecasts with the sales that followed: MAD, POA, MSE and RMSE by item, category and method
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Accuracy');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastAccuracy';
+include('includes/header.php');
+
+ForecastPageTitle($Title);
+
+$Defaults = ForecastGetParameters();
+$Bounds = ForecastHistoryBounds();
+
+if ($Bounds['to'] === null) {
+	ForecastNoHistoryNotice();
+	include('includes/footer.php');
+	exit();
+}
+
+$FromMonth = isset($_POST['FromMonth']) ? ForecastInput($_POST['FromMonth']) : substr($Bounds['from'], 0, 7);
+$ToMonth = isset($_POST['ToMonth']) ? ForecastInput($_POST['ToMonth']) : substr($Bounds['to'], 0, 7);
+$CategoryID = isset($_POST['CategoryID']) ? ForecastInput($_POST['CategoryID']) : '';
+$Location = isset($_POST['Location']) ? ForecastInput($_POST['Location']) : '';
+$IncludeSuperseded = isset($_POST['IncludeSuperseded']);
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset>
+		<legend>' . __('Select the forecast periods to measure') . '</legend>
+		<field>
+			<label for="FromMonth">' . __('From month') . ':</label>
+			<input type="month" name="FromMonth" id="FromMonth" required="required" value="' . htmlspecialchars($FromMonth, ENT_QUOTES, 'UTF-8') . '" />
+		</field>
+		<field>
+			<label for="ToMonth">' . __('To month') . ':</label>
+			<input type="month" name="ToMonth" id="ToMonth" required="required" value="' . htmlspecialchars($ToMonth, ENT_QUOTES, 'UTF-8') . '" />
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category') . ':</label>
+			<select name="CategoryID" id="CategoryID">' . ForecastCategoryOptions($CategoryID, __('Any category')) . '</select>
+		</field>
+		<field>
+			<label for="Location">' . __('Location') . ':</label>
+			<select name="Location" id="Location">
+				<option value="">' . __('Any location') . '</option>
+				<option value="-"' . ($Location == '-' ? ' selected="selected"' : '') . '>' . __('All locations combined') . '</option>' .
+				str_replace('<option value=""></option>', '', ForecastLocationOptions($Location, '')) . '
+			</select>
+		</field>
+		<field>
+			<label for="IncludeSuperseded">' . __('Include superseded forecasts') . ':</label>
+			<input type="checkbox" name="IncludeSuperseded" id="IncludeSuperseded"' . ($IncludeSuperseded ? ' checked="checked"' : '') . ' />
+		</field>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="Show" value="' . __('Show Accuracy') . '" />
+	</div>
+	</form>';
+echo '<div class="page_help_text">' . __('Only forecast months that now have actual sales in the history held are measured, so extract the latest sales history first. The forecast used is the revised quantity where there is one. MAD is the mean absolute error, MSE the mean squared error and RMSE its square root. POA, the percent of accuracy, is 100 less the total absolute error as a percentage of total actual sales, never below 0.') . '</div>';
+
+if (isset($_POST['Show'])) {
+	$ValidMonths = (preg_match('/^\d{4}-(0[1-9]|1[0-2])$/', $FromMonth) && preg_match('/^\d{4}-(0[1-9]|1[0-2])$/', $ToMonth));
+	if (!$ValidMonths or $FromMonth > $ToMonth) {
+		prnMsg(__('Enter the first and last month, the first not after the last'), 'error');
+	} else {
+		$Where = array(
+			"forecastdetails.periodstart >= '" . $FromMonth . "-01'",
+			"forecastdetails.periodstart <= '" . $ToMonth . "-01'",
+			"forecastdetails.periodstart >= '" . $Bounds['from'] . "'",
+			"forecastdetails.periodstart <= '" . $Bounds['to'] . "'",
+		);
+		if ($CategoryID != '') {
+			$Where[] = "stockmaster.categoryid = '" . DB_escape_string($CategoryID) . "'";
+		}
+		if ($Location == '-') {
+			$Where[] = "forecasts.loccode = ''";
+		} elseif ($Location != '') {
+			$Where[] = "forecasts.loccode = '" . DB_escape_string($Location) . "'";
+		}
+		if (!$IncludeSuperseded) {
+			$Where[] = "forecasts.isactive = 1";
+		}
+		$Result = DB_query("SELECT forecasts.stockid,
+									forecasts.loccode,
+									forecasts.method,
+									stockmaster.description,
+									stockmaster.categoryid,
+									" . ForecastEffectiveSQL() . " AS forecastqty,
+									COALESCE((SELECT SUM(forecasthistory.quantity)
+												FROM forecasthistory
+												WHERE forecasthistory.stockid = forecasts.stockid
+													AND (forecasts.loccode = '' OR forecasthistory.loccode = forecasts.loccode)
+													AND forecasthistory.periodstart = forecastdetails.periodstart), 0) AS actualqty
+							FROM forecasts
+							INNER JOIN forecastdetails ON forecastdetails.forecastid = forecasts.forecastid
+							INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+							WHERE " . implode(' AND ', $Where));
+
+		$ByItem = array();
+		$ByCategory = array();
+		$ByMethod = array();
+		$Total = ForecastNewAccumulator();
+		$Descriptions = array();
+		while ($MyRow = DB_fetch_array($Result)) {
+			$ItemKey = $MyRow['stockid'] . "\t" . $MyRow['loccode'];
+			$Descriptions[$ItemKey] = array($MyRow['stockid'], $MyRow['description'], $MyRow['loccode']);
+			if (!isset($ByItem[$ItemKey])) {
+				$ByItem[$ItemKey] = ForecastNewAccumulator();
+			}
+			if (!isset($ByCategory[$MyRow['categoryid']])) {
+				$ByCategory[$MyRow['categoryid']] = ForecastNewAccumulator();
+			}
+			if (!isset($ByMethod[$MyRow['method']])) {
+				$ByMethod[$MyRow['method']] = ForecastNewAccumulator();
+			}
+			ForecastAccumulate($ByItem[$ItemKey], (float) $MyRow['actualqty'], (float) $MyRow['forecastqty']);
+			ForecastAccumulate($ByCategory[$MyRow['categoryid']], (float) $MyRow['actualqty'], (float) $MyRow['forecastqty']);
+			ForecastAccumulate($ByMethod[$MyRow['method']], (float) $MyRow['actualqty'], (float) $MyRow['forecastqty']);
+			ForecastAccumulate($Total, (float) $MyRow['actualqty'], (float) $MyRow['forecastqty']);
+		}
+
+		if ($Total['n'] == 0) {
+			prnMsg(__('No forecast months in this range have actual sales to compare with'), 'info');
+		} else {
+			$Measures = ForecastMeasures($Total);
+			$Threshold = $Defaults['lowaccuracy'];
+			$Header = '<th>' . __('Months measured') . '</th><th>' . __('MAD') . '</th><th>' . __('POA %') . '</th><th>' . __('MSE') . '</th><th>' . __('RMSE') . '</th>';
+			$Row = function ($Accumulator) use ($Threshold) {
+				$M = ForecastMeasures($Accumulator);
+				return array('<td class="number">' . $M['n'] . '</td>
+					<td class="number">' . ForecastFormatQuantity($M['mad']) . '</td>
+					<td class="number">' . locale_number_format($M['poa'], 1) . '</td>
+					<td class="number">' . ForecastFormatQuantity($M['mse']) . '</td>
+					<td class="number">' . ForecastFormatQuantity($M['rmse']) . '</td>', $M['poa'] < $Threshold);
+			};
+
+			echo '<table class="selection">
+					<tr><th>' . __('Overall') . '</th>' . $Header . '</tr>';
+			list($Cells) = $Row($Total);
+			echo '<tr><td></td>' . $Cells . '</tr></table><br />';
+
+			ksort($ByMethod);
+			echo '<table class="selection">
+					<tr><th>' . __('Method') . '</th>' . $Header . '</tr>';
+			foreach ($ByMethod as $Method => $Accumulator) {
+				list($Cells) = $Row($Accumulator);
+				echo '<tr class="striped_row"><td>' . $Method . ' - ' . htmlspecialchars(ForecastMethodName($Method), ENT_QUOTES, 'UTF-8') . '</td>' . $Cells . '</tr>';
+			}
+			echo '</table><br />';
+
+			ksort($ByCategory);
+			echo '<table class="selection">
+					<tr><th>' . __('Stock category') . '</th>' . $Header . '</tr>';
+			foreach ($ByCategory as $Category => $Accumulator) {
+				list($Cells, $Low) = $Row($Accumulator);
+				echo '<tr class="striped_row"' . ($Low ? ' style="background-color:#ffd6d6"' : '') . '><td>' . htmlspecialchars($Category, ENT_QUOTES, 'UTF-8') . '</td>' . $Cells . '</tr>';
+			}
+			echo '</table><br />';
+
+			uasort($ByItem, function ($A, $B) {
+				return ForecastMeasures($A)['poa'] <=> ForecastMeasures($B)['poa'];
+			});
+			$LowCount = 0;
+			foreach ($ByItem as $Accumulator) {
+				if (ForecastMeasures($Accumulator)['poa'] < $Threshold) {
+					$LowCount++;
+				}
+			}
+			echo '<table class="selection">
+					<tr><th colspan="3">' . __('Items') . '</th>' . $Header . '</tr>';
+			$Shown = 0;
+			foreach ($ByItem as $ItemKey => $Accumulator) {
+				if (++$Shown > 500) {
+					break;
+				}
+				list($Cells, $Low) = $Row($Accumulator);
+				echo '<tr class="striped_row"' . ($Low ? ' style="background-color:#ffd6d6"' : '') . '>
+						<td>' . htmlspecialchars($Descriptions[$ItemKey][0], ENT_QUOTES, 'UTF-8') . '</td>
+						<td>' . htmlspecialchars($Descriptions[$ItemKey][1], ENT_QUOTES, 'UTF-8') . '</td>
+						<td>' . ($Descriptions[$ItemKey][2] == '' ? __('All') : htmlspecialchars($Descriptions[$ItemKey][2], ENT_QUOTES, 'UTF-8')) . '</td>' . $Cells . '</tr>';
+			}
+			echo '</table>';
+			prnMsg(sprintf(__('%d of %d items have a POA below %s%% (highlighted), lowest first.'), $LowCount, count($ByItem), locale_number_format($Threshold, 0)), $LowCount > 0 ? 'warn' : 'info');
+		}
+	}
+}
+
+include('includes/footer.php');

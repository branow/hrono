+	include('includes/footer.php');
+	exit();
+}
+
+$DimensionTypes = ForecastDimensionTypes();
+$Keys = ForecastDimensionKeys($Summary['dimtype']);
+$KeyName = ($Summary['dimkey'] === '' ? '' : $Summary['dimkey'] . ' - ') . ($Keys[$Summary['dimkey']] ?? '');
+$Editable = ($Summary['isactive'] == 1);
+
+if ((isset($_POST['Save']) or isset($_POST['ClearAll'])) and $Editable) {
+	$Periods = array();
+	$Result = DB_query("SELECT periodstart FROM forecastsummarydetails WHERE summaryid = " . $SummaryID . " ORDER BY periodstart");
+	while ($MyRow = DB_fetch_row($Result)) {
+		$Periods[] = $MyRow[0];
+	}
+	if (isset($_POST['ClearAll'])) {
+		DB_query("UPDATE forecastsummarydetails SET revisedqty = NULL, revisedby = '' WHERE summaryid = " . $SummaryID);
+		prnMsg(__('All revisions have been cleared, the calculated quantities apply again'), 'success');
+	} else {
+		list($Revisions, $Errors) = ForecastReadRevisions($_POST['Revised'] ?? array(), $Periods);
+		if (count($Errors) > 0) {
+			foreach ($Errors as $Error) {
+				prnMsg($Error, 'error');
+			}
+		} else {
+			DB_Txn_Begin();
+			foreach ($Revisions as $Period => $Quantity) {
+				if ($Quantity === null) {
+					DB_query("UPDATE forecastsummarydetails SET revisedqty = NULL, revisedby = ''
+								WHERE summaryid = " . $SummaryID . " AND periodstart = '" . $Period . "'", '', '', true);
+				} else {
+					DB_query("UPDATE forecastsummarydetails SET revisedqty = " . $Quantity . ", revisedby = '" . DB_escape_string($_SESSION['UserID']) . "'
+								WHERE summaryid = " . $SummaryID . " AND periodstart = '" . $Period . "'", '', '', true);

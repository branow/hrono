+<?php
+
+// Search forecasts, review them period by period and revise the quantities
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Review and Revise Forecasts');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastReview';
+include('includes/header.php');
+
+ForecastPageTitle($Title);
+
+$ForecastID = 0;
+if (isset($_POST['ForecastID'])) {
+	$ForecastID = (int) $_POST['ForecastID'];
+} elseif (isset($_GET['ForecastID'])) {
+	$ForecastID = (int) $_GET['ForecastID'];
+}
+
+$ForecastRow = null;
+if ($ForecastID > 0) {
+	$Result = DB_query("SELECT forecasts.*, stockmaster.description, stockmaster.categoryid
+						FROM forecasts
+						INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+						WHERE forecasts.forecastid = " . $ForecastID);
+	$ForecastRow = DB_fetch_array($Result);
+	if (!$ForecastRow) {
+		prnMsg(__('The forecast could not be found'), 'error');
+		$ForecastID = 0;
+	}
+}
+
+if ($ForecastRow and (isset($_POST['Save']) or isset($_POST['ClearAll']))) {
+	if ($ForecastRow['isactive'] != 1) {
+		prnMsg(__('Only the active forecast of an item can be revised, this one has been superseded'), 'error');
+	} else {
+		$Periods = array();
+		$Result = DB_query("SELECT periodstart FROM forecastdetails WHERE forecastid = " . $ForecastID . " ORDER BY periodstart");
+		while ($MyRow = DB_fetch_row($Result)) {
+			$Periods[] = $MyRow[0];
+		}
+		if (isset($_POST['ClearAll'])) {
+			DB_query("UPDATE forecastdetails SET revisedqty = NULL, revisedby = '' WHERE forecastid = " . $ForecastID);
+			prnMsg(__('All revisions have been cleared, the calculated quantities apply again'), 'success');
+		} else {
+			list($Revisions, $Errors) = ForecastReadRevisions($_POST['Revised'] ?? array(), $Periods);
+			if (count($Errors) > 0) {
+				foreach ($Errors as $Error) {
+					prnMsg($Error, 'error');
+				}
+			} else {
+				DB_Txn_Begin();
+				foreach ($Revisions as $Period => $Quantity) {
+					if ($Quantity === null) {
+						DB_query("UPDATE forecastdetails SET revisedqty = NULL, revisedby = ''
+									WHERE forecastid = " . $ForecastID . " AND periodstart = '" . $Period . "'", '', '', true);
+					} else {
+						DB_query("UPDATE forecastdetails SET revisedqty = " . $Quantity . ", revisedby = '" . DB_escape_string($_SESSION['UserID']) . "'
+									WHERE forecastid = " . $ForecastID . " AND periodstart = '" . $Period . "'", '', '', true);
+					}
+				}
+				DB_Txn_Commit();
+				prnMsg(__('The revised quantities have been saved. A blank revised quantity means the calculated quantity applies.'), 'success');
+			}
+		}
+	}
+}
+
+if ($ForecastRow) {
+	$Defaults = ForecastGetParameters();
+	$Bounds = ForecastHistoryBounds();
+	$LocationName = __('All locations combined');
+	if ($ForecastRow['loccode'] != '') {
+		$Result = DB_query("SELECT locationname FROM locations WHERE loccode = '" . DB_escape_string($ForecastRow['loccode']) . "'");
+		$LocationRow = DB_fetch_row($Result);
+		$LocationName = $LocationRow ? $LocationRow[0] : $ForecastRow['loccode'];
+	}
+	echo '<table class="selection">
+			<tr><td>' . __('Item') . '</td><td>' . htmlspecialchars($ForecastRow['stockid'] . ' - ' . $ForecastRow['description'], ENT_QUOTES, 'UTF-8') . '</td></tr>
+			<tr><td>' . __('Location') . '</td><td>' . htmlspecialchars($LocationName, ENT_QUOTES, 'UTF-8') . '</td></tr>
+			<tr><td>' . __('Method') . '</td><td>' . htmlspecialchars(ForecastMethodName($ForecastRow['method']), ENT_QUOTES, 'UTF-8') . ' ' . htmlspecialchars(ForecastDescribeParameters($ForecastRow['method'], $ForecastRow['params']), ENT_QUOTES, 'UTF-8') . '</td></tr>
+			<tr><td>' . __('Created') . '</td><td>' . $ForecastRow['createdate'] . ' ' . htmlspecialchars($ForecastRow['createdby'], ENT_QUOTES, 'UTF-8') . '</td></tr>
+			<tr><td>' . __('Status') . '</td><td>' . ($ForecastRow['isactive'] == 1 ? __('Active') : __('Superseded')) . '</td></tr>' .
+			($ForecastRow['notes'] != '' ? '<tr><td>' . __('Notes') . '</td><td>' . htmlspecialchars($ForecastRow['notes'], ENT_QUOTES, 'UTF-8') . '</td></tr>' : '') . '
+		</table><br />';
+
+	$Details = array();
+	$Result = DB_query("SELECT periodstart, calcqty, revisedqty FROM forecastdetails WHERE forecastid = " . $ForecastID . " ORDER BY periodstart");
+	while ($MyRow = DB_fetch_array($Result)) {
+		$Details[$MyRow['periodstart']] = $MyRow;
+	}
+	$LastYear = ForecastLastYear(array('item', $ForecastRow['stockid'], $ForecastRow['loccode']), array_keys($Details), $Bounds);
+	$Editable = ($ForecastRow['isactive'] == 1);
+
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+	echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="ForecastID" value="' . $ForecastID . '" />';
+	echo '<table class="selection">
+			<tr>
+				<th>' . __('Period') . '</th>
+				<th>' . __('Calculated') . '</th>
+				<th>' . __('Revised') . '</th>
+				<th>' . __('Forecast used') . '</th>
+				<th>' . __('Last year actual') . '</th>
+				<th>' . __('Variance') . '</th>
+				<th>' . __('Variance %') . '</th>
+			</tr>';
+	foreach ($Details as $Period => $Detail) {
+		$Effective = ($Detail['revisedqty'] !== null) ? (float) $Detail['revisedqty'] : (float) $Detail['calcqty'];
+		$Last = $LastYear[$Period];
+		$Large = ForecastLargeVariance($Effective, $Last, $Defaults['variancepct']);
+		echo '<tr class="striped_row"' . ($Large ? ' style="background-color:#ffd6d6"' : '') . '>
+				<td>' . ForecastMonthLabel($Period) . '</td>
+				<td class="number">' . ForecastFormatQuantity($Detail['calcqty']) . '</td>
+				<td class="number">';
+		if ($Editable) {
+			echo '<input type="text" class="number" name="Revised[' . $Period . ']" size="10" value="' . ($Detail['revisedqty'] !== null ? ForecastFormatQuantity($Detail['revisedqty']) : '') . '" />';
+		} else {
+			echo ($Detail['revisedqty'] !== null ? ForecastFormatQuantity($Detail['revisedqty']) : '');
+		}
+		echo '</td>
+				<td class="number">' . ForecastFormatQuantity($Effective) . '</td>';
+		if ($Last === null) {
+			echo '<td class="number">-</td><td class="number">-</td><td class="number">-</td>';
+		} else {
+			echo '<td class="number">' . ForecastFormatQuantity($Last) . '</td>
+				<td class="number">' . ForecastFormatQuantity($Effective - $Last) . '</td>
+				<td class="number">' . ($Last != 0 ? locale_number_format(($Effective - $Last) / $Last * 100, 1) . '%' : '-') . '</td>';
+		}
+		echo '</tr>';
+	}
+	echo '</table>';
+	if ($Editable) {
+		echo '<div class="centre">
+				<input type="submit" name="Save" value="' . __('Save Revised Quantities') . '" />
+				<input type="submit" name="ClearAll" value="' . __('Clear All Revisions') . '" />
+			</div>';
+	}
+	echo '</form>';
+	echo '<div class="page_help_text">' . sprintf(__('A revised quantity takes priority over the calculated one in every report, in the accuracy measures and in MRP. Clear it (leave it blank) to use the calculated quantity again. Rows differing from last year by %s%% or more are highlighted.'), locale_number_format($Defaults['variancepct'], 0)) . '</div>';
+	echo '<div class="centre"><a href="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">' . __('Search for other forecasts') . '</a></div>';
+} else {
+	// search
+	$Code = isset($_POST['Code']) ? ForecastInput($_POST['Code']) : (isset($_GET['Code']) ? ForecastInput($_GET['Code']) : '');
+	$CategoryID = isset($_POST['CategoryID']) ? ForecastInput($_POST['CategoryID']) : '';
+	$Location = isset($_POST['Location']) ? ForecastInput($_POST['Location']) : '';
+	$IncludeSuperseded = isset($_POST['IncludeSuperseded']);
+
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+	echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+	echo '<fieldset>
+			<legend>' . __('Search for forecasts') . '</legend>
+			<field>
+				<label for="Code">' . __('Item code or description contains') . ':</label>
+				<input type="text" name="Code" id="Code" size="21" maxlength="64" value="' . htmlspecialchars($Code, ENT_QUOTES, 'UTF-8') . '" />
+			</field>
+			<field>
+				<label for="CategoryID">' . __('Stock category') . ':</label>
+				<select name="CategoryID" id="CategoryID">' . ForecastCategoryOptions($CategoryID, __('Any category')) . '</select>
+			</field>
+			<field>
+				<label for="Location">' . __('Location') . ':</label>
+				<select name="Location" id="Location">
+					<option value="">' . __('Any location') . '</option>
+					<option value="-"' . ($Location == '-' ? ' selected="selected"' : '') . '>' . __('All locations combined') . '</option>' .
+					str_replace('<option value=""></option>', '', ForecastLocationOptions($Location, '')) . '
+				</select>
+			</field>
+			<field>
+				<label for="IncludeSuperseded">' . __('Include superseded forecasts') . ':</label>
+				<input type="checkbox" name="IncludeSuperseded" id="IncludeSuperseded"' . ($IncludeSuperseded ? ' checked="checked"' : '') . ' />
+			</field>
+		</fieldset>
+		<div class="centre">
+			<input type="submit" name="Search" value="' . __('Search') . '" />
+		</div>
+		</form>';
+
+	if (isset($_POST['Search']) or $Code != '') {
+		$Where = array();
+		if ($Code != '') {
+			$Like = DB_escape_string(str_replace(array('%', '_'), array('\\%', '\\_'), $Code));
+			$Where[] = "(forecasts.stockid LIKE '%" . $Like . "%' OR stockmaster.description LIKE '%" . $Like . "%')";
+		}
+		if ($CategoryID != '') {
+			$Where[] = "stockmaster.categoryid = '" . DB_escape_string($CategoryID) . "'";
+		}
+		if ($Location == '-') {
+			$Where[] = "forecasts.loccode = ''";
+		} elseif ($Location != '') {
+			$Where[] = "forecasts.loccode = '" . DB_escape_string($Location) . "'";
+		}
+		if (!$IncludeSuperseded) {
+			$Where[] = "forecasts.isactive = 1";
+		}
+		$Result = DB_query("SELECT forecasts.forecastid, forecasts.stockid, stockmaster.description, stockmaster.categoryid,
+									forecasts.loccode, forecasts.method, forecasts.createdate, forecasts.isactive, forecasts.horizon
+							FROM forecasts
+							INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid" .
+							(count($Where) > 0 ? " WHERE " . implode(' AND ', $Where) : '') . "
+							ORDER BY forecasts.stockid, forecasts.loccode, forecasts.forecastid DESC
+							LIMIT 201");
+		if (DB_num_rows($Result) == 0) {
+			prnMsg(__('No forecasts were found'), 'info');
+		} else {
+			echo '<br /><table class="selection">
+					<tr>
+						<th>' . __('Item') . '</th>
+						<th>' . __('Description') . '</th>
+						<th>' . __('Category') . '</th>
+						<th>' . __('Location') . '</th>
+						<th>' . __('Method') . '</th>
+						<th>' . __('Months') . '</th>
+						<th>' . __('Created') . '</th>
+						<th>' . __('Status') . '</th>
+					</tr>';
+			$Count = 0;
+			while ($MyRow = DB_fetch_array($Result)) {
+				if (++$Count > 200) {
+					break;
+				}
+				echo '<tr class="striped_row">
+						<td><a href="' . $RootPath . '/ForecastReview.php?ForecastID=' . $MyRow['forecastid'] . '">' . htmlspecialchars($MyRow['stockid'], ENT_QUOTES, 'UTF-8') . '</a></td>
+						<td>' . htmlspecialchars($MyRow['description'], ENT_QUOTES, 'UTF-8') . '</td>
+						<td>' . htmlspecialchars($MyRow['categoryid'], ENT_QUOTES, 'UTF-8') . '</td>
+						<td>' . ($MyRow['loccode'] == '' ? __('All') : htmlspecialchars($MyRow['loccode'], ENT_QUOTES, 'UTF-8')) . '</td>
+						<td>' . htmlspecialchars(ForecastMethodName($MyRow['method']), ENT_QUOTES, 'UTF-8') . '</td>
+						<td class="number">' . $MyRow['horizon'] . '</td>
+						<td>' . $MyRow['createdate'] . '</td>
+						<td>' . ($MyRow['isactive'] == 1 ? __('Active') : __('Superseded')) . '</td>
+					</tr>';
+			}
+			echo '</table>';
+			if ($Count > 200) {
+				prnMsg(__('Only the first 200 forecasts are shown, narrow the search'), 'info');
+			}
+		}
+	}
+}
+
+include('includes/footer.php');
diff --git a/ForecastSummary.php b/ForecastSummary.php
new file mode 100644
index 0000000..4a1222f

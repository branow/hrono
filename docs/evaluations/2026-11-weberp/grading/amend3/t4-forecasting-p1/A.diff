+}
+
+$Defaults = ForecastGetParameters();
+$Bounds = ForecastHistoryBounds();
+
+echo '<table class="selection">
+		<tr><td>' . __('Summary by') . '</td><td>' . $DimensionTypes[$Summary['dimtype']] . '</td></tr>
+		<tr><td>' . __('For') . '</td><td>' . htmlspecialchars($KeyName, ENT_QUOTES, 'UTF-8') . '</td></tr>
+		<tr><td>' . __('Method') . '</td><td>' . htmlspecialchars(ForecastMethodName($Summary['method']), ENT_QUOTES, 'UTF-8') . ' ' . htmlspecialchars(ForecastDescribeParameters($Summary['method'], $Summary['params']), ENT_QUOTES, 'UTF-8') . '</td></tr>
+		<tr><td>' . __('Created') . '</td><td>' . $Summary['createdate'] . ' ' . htmlspecialchars($Summary['createdby'], ENT_QUOTES, 'UTF-8') . '</td></tr>
+		<tr><td>' . __('Status') . '</td><td>' . ($Editable ? __('Active') : __('Superseded')) . '</td></tr>' .
+		($Summary['notes'] != '' ? '<tr><td>' . __('Notes') . '</td><td>' . htmlspecialchars($Summary['notes'], ENT_QUOTES, 'UTF-8') . '</td></tr>' : '') . '
+	</table><br />';
+
+$Details = array();
+$Result = DB_query("SELECT periodstart, calcqty, revisedqty FROM forecastsummarydetails WHERE summaryid = " . $SummaryID . " ORDER BY periodstart");
+while ($MyRow = DB_fetch_array($Result)) {

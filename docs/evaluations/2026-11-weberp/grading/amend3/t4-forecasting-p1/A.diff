+<?php
+
+// Convert the active forecasts into MRP demands (master schedule) under the forecast demand type
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Convert Forecasts to MRP Demands');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastToMRP';
+include('includes/header.php');
+
+ForecastPageTitle($Title);
+
+$Defaults = ForecastGetParameters();
+$FromDate = isset($_POST['FromDate']) ? ForecastInput($_POST['FromDate']) : date('Y-m-d');
+$ToDate = isset($_POST['ToDate']) ? ForecastInput($_POST['ToDate']) : date('Y-m-t', strtotime(ForecastAddMonths(date('Y-m-01'), $Defaults['defaulthorizon'] - 1)));
+$Mode = (isset($_POST['Mode']) and $_POST['Mode'] == 'incremental') ? 'incremental' : 'replace';
+$CategoryID = isset($_POST['CategoryID']) ? ForecastInput($_POST['CategoryID']) : '';
+$StockID = isset($_POST['StockID']) ? mb_strtoupper(trim(ForecastInput($_POST['StockID']))) : '';
+
+$Result = DB_query("SELECT mrpdemandtype FROM mrpdemandtypes WHERE mrpdemandtype = '" . FORECAST_DEMAND_TYPE . "'");
+$TypeExists = (DB_num_rows($Result) > 0);
+if (!$TypeExists) {
+	prnMsg(__('The forecast demand type FC does not exist. Add it in MRP Demand Types before converting forecasts.'), 'error');
+}
+
+if (isset($_POST['Convert']) and $TypeExists) {
+	$InputError = 0;
+	$ValidDates = true;
+	foreach (array($FromDate, $ToDate) as $Date) {
+		if (!preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $Date, $Parts) or !checkdate((int) $Parts[2], (int) $Parts[3], (int) $Parts[1])) {
+			$ValidDates = false;
+		}
+	}
+	if (!$ValidDates) {
+		prnMsg(__('The horizon dates must be entered as dates'), 'error');
+		$InputError = 1;
+	} elseif ($FromDate > $ToDate) {
+		prnMsg(__('The horizon cannot end before it starts'), 'error');
+		$InputError = 1;
+	}
+	if ($StockID != '') {
+		$Result = DB_query("SELECT stockid FROM stockmaster WHERE stockid = '" . DB_escape_string($StockID) . "'");
+		if (DB_num_rows($Result) == 0) {
+			prnMsg(__('The item code entered is not an inventory item'), 'error');
+			$InputError = 1;
+		}
+	}
+	if ($InputError == 0) {
+		$Where = "forecasts.isactive = 1 AND stockmaster.discontinued = 0";
+		if ($StockID != '') {
+			$Where .= " AND forecasts.stockid = '" . DB_escape_string($StockID) . "'";
+		}
+		if ($CategoryID != '') {
+			$Where .= " AND stockmaster.categoryid = '" . DB_escape_string($CategoryID) . "'";
+		}
+		$Items = array();
+		$Result = DB_query("SELECT DISTINCT forecasts.stockid
+							FROM forecasts
+							INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid
+							WHERE " . $Where . "
+							ORDER BY forecasts.stockid");
+		while ($MyRow = DB_fetch_row($Result)) {
+			$Items[] = $MyRow[0];
+		}
+		if (count($Items) == 0) {
+			prnMsg(__('There are no active forecasts for the selection'), 'warn');
+		} else {
+			set_time_limit(300);
+			$Counts = ForecastConvertToMRP($Items, $FromDate, $ToDate, $Mode, $_SESSION['UserID']);
+			prnMsg(sprintf(__('%d items converted: %d forecast demands removed, %d written, %d periods left as they were because they were already in the master schedule.'), $Counts['items'], $Counts['deleted'], $Counts['inserted'], $Counts['skipped']), 'success');
+		}
+	}
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset>
+		<legend>' . __('Convert active forecasts') . '</legend>
+		<field>
+			<label for="FromDate">' . __('Horizon from') . ':</label>
+			<input type="date" name="FromDate" id="FromDate" required="required" value="' . htmlspecialchars($FromDate, ENT_QUOTES, 'UTF-8') . '" />
+		</field>
+		<field>
+			<label for="ToDate">' . __('Horizon to') . ':</label>
+			<input type="date" name="ToDate" id="ToDate" required="required" value="' . htmlspecialchars($ToDate, ENT_QUOTES, 'UTF-8') . '" />
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category') . ':</label>
+			<select name="CategoryID" id="CategoryID">' . ForecastCategoryOptions($CategoryID, __('All categories')) . '</select>
+		</field>
+		<field>
+			<label for="StockID">' . __('Item code') . ' (' . __('leave blank for all items') . '):</label>
+			<input type="text" name="StockID" id="StockID" size="21" maxlength="64" value="' . htmlspecialchars($StockID, ENT_QUOTES, 'UTF-8') . '" />
+		</field>
+		<field>
+			<label for="Mode">' . __('Mode') . ':</label>
+			<select name="Mode" id="Mode">
+				<option value="replace"' . ($Mode == 'replace' ? ' selected="selected"' : '') . '>' . __('Replace the forecast demands of these items for the horizon') . '</option>
+				<option value="incremental"' . ($Mode == 'incremental' ? ' selected="selected"' : '') . '>' . __('Incremental: only add periods not already converted') . '</option>
+			</select>
+		</field>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="Convert" value="' . __('Convert to MRP Demands') . '" />
+	</div>
+	</form>';
+
+echo '<div class="page_help_text">' . __('Every month of the horizon that has an active forecast is written to the MRP master schedule as a demand of type FC, using the revised quantity where there is one. Demands entered by hand or from any other source are never changed or removed. Converting again with the same settings gives the same demands. Run MRP Calculation with the master schedule demands option to plan purchases and work orders from them.') . '</div>';
+
+$Result = DB_query("SELECT COUNT(*), MIN(forecastmrpdemands.periodstart), MAX(forecastmrpdemands.periodstart), COUNT(DISTINCT forecastmrpdemands.stockid)
+					FROM forecastmrpdemands
+					INNER JOIN mrpdemands ON mrpdemands.demandid = forecastmrpdemands.demandid");
+$MyRow = DB_fetch_row($Result);
+if ($MyRow[0] > 0) {
+	echo '<table class="selection">
+			<tr><th colspan="2">' . __('Forecast demands now in the master schedule') . '</th></tr>
+			<tr><td>' . __('Demands') . '</td><td class="number">' . $MyRow[0] . '</td></tr>
+			<tr><td>' . __('Items') . '</td><td class="number">' . $MyRow[3] . '</td></tr>
+			<tr><td>' . __('First month') . '</td><td>' . ForecastMonthLabel($MyRow[1]) . '</td></tr>
+			<tr><td>' . __('Last month') . '</td><td>' . ForecastMonthLabel($MyRow[2]) . '</td></tr>
+		</table>';
+}
+
+include('includes/footer.php');

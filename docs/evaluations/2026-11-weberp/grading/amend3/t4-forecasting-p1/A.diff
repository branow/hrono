+<?php
+
+// Forecasting dashboard
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecasting Dashboard');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastDashboard';
+include('includes/header.php');
+
+ForecastPageTitle($Title);
+
+$Result = DB_query("SELECT COUNT(*) FROM forecasts WHERE isactive = 1");
+$MyRow = DB_fetch_row($Result);
+$ActiveForecasts = (int) $MyRow[0];
+
+$Result = DB_query("SELECT COUNT(*) FROM forecastsummaries WHERE isactive = 1");
+$MyRow = DB_fetch_row($Result);
+$ActiveSummaries = (int) $MyRow[0];
+
+$Result = DB_query("SELECT COUNT(*)
+					FROM forecastmrpdemands
+					INNER JOIN mrpdemands ON mrpdemands.demandid = forecastmrpdemands.demandid");
+$MyRow = DB_fetch_row($Result);
+$MRPDemands = (int) $MyRow[0];
+
+$Bounds = ForecastHistoryBounds();
+
+echo '<table class="selection">
+		<tr><th colspan="2">' . __('Forecasting at a glance') . '</th></tr>
+		<tr><td>' . __('Active forecasts') . '</td><td class="number">' . $ActiveForecasts . '</td></tr>
+		<tr><td>' . __('Active summary forecasts') . '</td><td class="number">' . $ActiveSummaries . '</td></tr>
+		<tr><td>' . __('Forecast demands in the MRP master schedule') . '</td><td class="number">' . $MRPDemands . '</td></tr>';
+if ($Bounds['to'] === null) {
+	echo '<tr><td>' . __('Sales history') . '</td><td>' . __('None extracted yet') . '</td></tr>';
+} else {
+	echo '<tr><td>' . __('Sales history range') . '</td><td>' . ForecastMonthLabel($Bounds['from']) . ' - ' . ForecastMonthLabel($Bounds['to']) . '</td></tr>
+		<tr><td>' . __('Months with sales') . '</td><td class="number">' . $Bounds['months'] . '</td></tr>
+		<tr><td>' . __('Items with sales') . '</td><td class="number">' . $Bounds['items'] . '</td></tr>';
+}
+echo '</table>';
+
+if ($Bounds['to'] === null) {
+	ForecastNoHistoryNotice();
+}
+
+$Links = array(
+	array('/ForecastHistory.php', __('Extract Sales History'), 11),
+	array('/ForecastGenerate.php', __('Generate Forecasts'), 11),
+	array('/ForecastReview.php', __('Review and Revise Forecasts'), 11),
+	array('/ForecastSummary.php', __('Summary Forecasts'), 11),
+	array('/ForecastToMRP.php', __('Convert Forecasts to MRP Demands'), 11),
+	array('/ForecastInquiry.php', __('Forecast Inquiry'), 2),
+	array('/ForecastAccuracy.php', __('Forecast Accuracy'), 2),
+	array('/ForecastMethodComparison.php', __('Forecast Method Comparison'), 2),
+	array('/ForecastParameters.php', __('Forecasting Parameters'), 15),
+	array('/MRPDemands.php', __('Master Schedule'), 9),
+	array('/MRP.php', __('MRP Calculation'), 9),
+	array('/MRPReport.php', __('MRP'), 2),
+);
+echo '<br /><table class="selection">
+		<tr><th>' . __('Forecasting functions') . '</th></tr>';
+foreach ($Links as $Link) {
+	if (in_array($Link[2], $_SESSION['AllowedPageSecurityTokens'])) {
+		echo '<tr class="striped_row"><td><a href="' . $RootPath . $Link[0] . '">' . $Link[1] . '</a></td></tr>';
+	}
+}
+echo '</table>';
+
+include('includes/footer.php');
diff --git a/ForecastGenerate.php b/ForecastGenerate.php
new file mode 100644
index 0000000..52efc50
--- /dev/null
+++ b/ForecastGenerate.php
@@ -0,0 +1,204 @@
+<?php
+
+// Generate forecasts for one item, or for every active item of a stock category
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Generate Forecasts');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastGenerate';
+include('includes/header.php');
+
+ForecastPageTitle($Title);
+
+$BatchSize = 20;
+$Defaults = ForecastGetParameters();
+$BatchID = 0;
+
+if (isset($_POST['Generate'])) {
+	$InputError = 0;
+	$Parameters = ForecastReadParameters($_POST);
+	$ScopeType = (isset($_POST['ScopeType']) and $_POST['ScopeType'] == 'category') ? 'category' : 'item';
+	$StockID = isset($_POST['StockID']) ? mb_strtoupper(trim(ForecastInput($_POST['StockID']))) : '';
+	$CategoryID = isset($_POST['CategoryID']) ? ForecastInput($_POST['CategoryID']) : '';
+	$LocCode = isset($_POST['Location']) ? ForecastInput($_POST['Location']) : '';
+	$Method = isset($_POST['Method']) ? (int) $_POST['Method'] : 0;
+	$Horizon = isset($_POST['Horizon']) ? (int) $_POST['Horizon'] : 0;
+
+	foreach (ForecastValidateParameters($Parameters) as $Error) {
+		prnMsg($Error, 'error');
+		$InputError = 1;
+	}
+	if ($Horizon < 1 or $Horizon > 36) {
+		prnMsg(__('The horizon must be between 1 and 36 months'), 'error');
+		$InputError = 1;
+	}
+	if ($Method != 0 and !array_key_exists($Method, ForecastMethods())) {
+		prnMsg(__('Unknown forecasting method'), 'error');
+		$InputError = 1;
+	}
+	if ($LocCode != '') {
+		$Result = DB_query("SELECT locations.loccode FROM locations
+							INNER JOIN locationusers ON locationusers.loccode = locations.loccode
+								AND locationusers.userid = '" . DB_escape_string($_SESSION['UserID']) . "' AND locationusers.canview = 1
+							WHERE locations.loccode = '" . DB_escape_string($LocCode) . "'");
+		if (DB_num_rows($Result) == 0) {
+			prnMsg(__('The location is not valid or you may not use it'), 'error');
+			$InputError = 1;
+		}
+	}
+	if ($ScopeType == 'item') {
+		$Result = DB_query("SELECT stockid FROM stockmaster WHERE stockid = '" . DB_escape_string($StockID) . "'");
+		if (DB_num_rows($Result) == 0) {
+			prnMsg(__('The item code entered is not an inventory item'), 'error');
+			$InputError = 1;
+		}
+	} else {
+		$Result = DB_query("SELECT categoryid FROM stockcategory WHERE categoryid = '" . DB_escape_string($CategoryID) . "'");
+		if (DB_num_rows($Result) == 0) {
+			prnMsg(__('Select a stock category'), 'error');
+			$InputError = 1;
+		}
+	}
+	if (ForecastHistoryBounds()['to'] === null) {
+		ForecastNoHistoryNotice();
+		$InputError = 1;
+	}
+
+	if ($InputError == 0) {
+		set_time_limit(300);
+		$BatchID = ForecastCreateBatch($ScopeType, $StockID, $CategoryID, $LocCode, $Method, $Horizon, $Parameters, $_SESSION['UserID']);
+		ForecastProcessBatch($BatchID, $BatchSize);
+	}
+} elseif (isset($_GET['BatchID'])) {
+	$BatchID = (int) $_GET['BatchID'];
+	set_time_limit(300);
+	ForecastProcessBatch($BatchID, $BatchSize);
+}
+
+if ($BatchID > 0) {
+	$Result = DB_query("SELECT * FROM forecastbatches WHERE batchid = " . (int) $BatchID);
+	$Batch = DB_fetch_array($Result);
+	if ($Batch) {
+		$Done = $Batch['successcount'] + $Batch['failcount'];
+		$Next = $RootPath . '/ForecastGenerate.php?BatchID=' . $BatchID;
+		echo '<table class="selection">
+				<tr><th colspan="2">' . __('Forecast batch') . ' ' . $BatchID . '</th></tr>
+				<tr><td>' . __('Scope') . '</td><td>' . ($Batch['scopetype'] == 'item' ? __('Item') . ' ' . htmlspecialchars($Batch['stockid'], ENT_QUOTES, 'UTF-8') : __('Stock category') . ' ' . htmlspecialchars($Batch['categoryid'], ENT_QUOTES, 'UTF-8')) . '</td></tr>
+				<tr><td>' . __('Location') . '</td><td>' . ($Batch['loccode'] == '' ? __('All locations combined') : htmlspecialchars($Batch['loccode'], ENT_QUOTES, 'UTF-8')) . '</td></tr>
+				<tr><td>' . __('Method') . '</td><td>' . ($Batch['method'] == 0 ? __('Best fit') . ($Batch['chosenmethod'] > 0 ? ': ' . htmlspecialchars(ForecastMethodName($Batch['chosenmethod']), ENT_QUOTES, 'UTF-8') : '') : htmlspecialchars(ForecastMethodName($Batch['method']), ENT_QUOTES, 'UTF-8')) . '</td></tr>
+				<tr><td>' . __('Horizon') . '</td><td>' . $Batch['horizon'] . ' ' . __('months') . '</td></tr>
+				<tr><td>' . __('Progress') . '</td><td><progress max="' . max(1, $Batch['totalitems']) . '" value="' . $Done . '"></progress> ' . $Done . ' / ' . $Batch['totalitems'] . '</td></tr>
+			</table>';
+		if ($Batch['notes'] != '') {
+			prnMsg(htmlspecialchars($Batch['notes'], ENT_QUOTES, 'UTF-8'), 'info');
+		}
+		if ($Batch['status'] == 'running') {
+			echo '<div class="centre"><a href="' . $Next . '">' . __('Continue') . '</a></div>
+				<script>setTimeout(function () { window.location.href = ' . json_encode(htmlspecialchars_decode($Next)) . '; }, 500);</script>';
+		} else {
+			prnMsg(sprintf(__('%d successful, %d failed'), $Batch['successcount'], $Batch['failcount']), $Batch['failcount'] > 0 ? 'warn' : 'success');
+		}
+
+		$Result = DB_query("SELECT forecastbatchresults.stockid,
+									forecastbatchresults.status,
+									forecastbatchresults.message,
+									forecastbatchresults.forecastid,
+									forecasts.method
+							FROM forecastbatchresults
+							LEFT JOIN forecasts ON forecasts.forecastid = forecastbatchresults.forecastid
+							WHERE forecastbatchresults.batchid = " . (int) $BatchID . "
+								AND forecastbatchresults.status <> 'pending'
+							ORDER BY forecastbatchresults.status DESC, forecastbatchresults.stockid
+							LIMIT 1000");
+		if (DB_num_rows($Result) > 0) {
+			echo '<br /><table class="selection">
+					<tr>
+						<th>' . __('Item') . '</th>
+						<th>' . __('Result') . '</th>
+						<th>' . __('Method') . '</th>
+						<th>' . __('Reason') . '</th>
+					</tr>';
+			while ($MyRow = DB_fetch_array($Result)) {
+				echo '<tr class="striped_row">
+						<td>' . htmlspecialchars($MyRow['stockid'], ENT_QUOTES, 'UTF-8') . '</td>';
+				if ($MyRow['status'] == 'ok') {
+					echo '<td><a href="' . $RootPath . '/ForecastReview.php?ForecastID=' . $MyRow['forecastid'] . '">' . __('Successful') . '</a></td>
+						<td>' . htmlspecialchars(ForecastMethodName($MyRow['method']), ENT_QUOTES, 'UTF-8') . '</td>
+						<td></td>';
+				} else {
+					echo '<td>' . __('Failed') . '</td>
+						<td></td>
+						<td>' . htmlspecialchars($MyRow['message'], ENT_QUOTES, 'UTF-8') . '</td>';
+				}
+				echo '</tr>';
+			}
+			echo '</table><br />';
+		}
+	}
+}
+
+if (isset($_POST['Generate'])) {
+	$FormValues = $Parameters;
+	$FormScope = $ScopeType;
+	$FormStock = $StockID;
+	$FormCategory = $CategoryID;
+	$FormLocation = $LocCode;
+	$FormMethod = $Method;
+	$FormHorizon = $Horizon;
+} else {
+	$FormValues = $Defaults;
+	$FormScope = 'item';
+	$FormStock = isset($_GET['StockID']) ? mb_strtoupper(ForecastInput($_GET['StockID'])) : '';
+	$FormCategory = '';
+	$FormLocation = isset($_GET['Location']) ? ForecastInput($_GET['Location']) : '';
+	$FormMethod = isset($_GET['Method']) ? (int) $_GET['Method'] : 0;
+	$FormHorizon = $Defaults['defaulthorizon'];
+}
+
+if (!isset($_GET['BatchID']) or isset($_POST['Generate'])) {
+	echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+	echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+	echo '<fieldset>
+			<legend>' . __('Scope') . '</legend>
+			<field>
+				<label for="ScopeType">' . __('Forecast') . ':</label>
+				<select name="ScopeType" id="ScopeType">
+					<option value="item"' . ($FormScope == 'item' ? ' selected="selected"' : '') . '>' . __('A single item') . '</option>
+					<option value="category"' . ($FormScope == 'category' ? ' selected="selected"' : '') . '>' . __('Every active item of a stock category') . '</option>
+				</select>
+			</field>
+			<field>
+				<label for="StockID">' . __('Item code') . ' (' . __('single item') . '):</label>
+				<input type="text" name="StockID" id="StockID" size="21" maxlength="64" value="' . htmlspecialchars($FormStock, ENT_QUOTES, 'UTF-8') . '" />
+			</field>
+			<field>
+				<label for="CategoryID">' . __('Stock category') . ':</label>
+				<select name="CategoryID" id="CategoryID">' . ForecastCategoryOptions($FormCategory, __('Select a category')) . '</select>
+			</field>
+			<field>
+				<label for="Location">' . __('Location') . ':</label>
+				<select name="Location" id="Location">' . ForecastLocationOptions($FormLocation, __('All locations combined')) . '</select>
+			</field>
+		</fieldset>
+		<fieldset>
+			<legend>' . __('Method') . '</legend>
+			<field>
+				<label for="Method">' . __('Method') . ':</label>
+				<select name="Method" id="Method">' . ForecastMethodOptions($FormMethod, __('Best fit (let the system recommend)')) . '</select>
+			</field>
+			<field>
+				<label for="Horizon">' . __('Months to forecast') . ':</label>
+				<input type="number" name="Horizon" id="Horizon" min="1" max="36" step="1" value="' . (int) $FormHorizon . '" />
+			</field>
+			' . ForecastParameterFields($FormValues) . '
+		</fieldset>
+		<div class="centre">
+			<input type="submit" name="Generate" value="' . __('Generate Forecasts') . '" />
+		</div>
+		</form>';
+	echo '<div class="page_help_text">' . __('Parameters start from the company defaults, change them here to use other values for this run. An item without enough history for the method is reported and not forecast. Generating again replaces the active forecast of an item and location; the old one is kept for the accuracy reports.') . '</div>';
+}
+
+include('includes/footer.php');
diff --git a/ForecastHistory.php b/ForecastHistory.php
new file mode 100644
index 0000000..40229ef
--- /dev/null
+++ b/ForecastHistory.php
@@ -0,0 +1,115 @@
+<?php
+
+// Extract the sales history the forecasts are calculated from
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecasting Sales History');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastHistory';
+include('includes/header.php');
+
+ForecastPageTitle($Title);
+
+$LastCompleteMonth = ForecastAddMonths(date('Y-m-01'), -1);
+
+if (isset($_POST['Extract'])) {
+	$InputError = 0;
+	$FromMonth = isset($_POST['FromMonth']) ? ForecastInput($_POST['FromMonth']) : '';
+	$ToMonth = isset($_POST['ToMonth']) ? ForecastInput($_POST['ToMonth']) : '';
+	if (!preg_match('/^\d{4}-(0[1-9]|1[0-2])$/', $FromMonth) or !preg_match('/^\d{4}-(0[1-9]|1[0-2])$/', $ToMonth)) {
+		prnMsg(__('Both the first and the last month must be entered as a month and year'), 'error');
+		$InputError = 1;
+	} else {
+		$FromMonth .= '-01';
+		$ToMonth .= '-01';
+		if ($FromMonth > $ToMonth) {
+			prnMsg(__('The first month cannot be after the last month'), 'error');
+			$InputError = 1;
+		}
+		if ($ToMonth > $LastCompleteMonth) {
+			prnMsg(__('The history can only run to the last complete month') . ': ' . ForecastMonthLabel($LastCompleteMonth), 'error');
+			$InputError = 1;
+		}
+	}
+	if ($InputError == 0) {
+		$Summary = ForecastExtractHistory($FromMonth, $ToMonth, $_SESSION['UserID']);
+		prnMsg(sprintf(__('Sales history from %s to %s has been extracted: %d items, %d item/location/month records. Any history already held for these months was replaced.'), ForecastMonthLabel($FromMonth), ForecastMonthLabel($ToMonth), $Summary['items'], $Summary['rows']), 'success');
+	}
+}
+
+if (isset($_POST['FromMonth']) and isset($_POST['Extract'])) {
+	$DefaultFrom = substr(ForecastInput($_POST['FromMonth']), 0, 7);
+	$DefaultTo = substr(ForecastInput($_POST['ToMonth']), 0, 7);
+} else {
+	$DefaultTo = substr($LastCompleteMonth, 0, 7);
+	$DefaultFrom = substr(ForecastAddMonths($LastCompleteMonth, -23), 0, 7);
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset>
+		<legend>' . __('Extract Sales History') . '</legend>
+		<field>
+			<label for="FromMonth">' . __('From month') . ':</label>
+			<input type="month" name="FromMonth" id="FromMonth" required="required" value="' . htmlspecialchars($DefaultFrom, ENT_QUOTES, 'UTF-8') . '" />
+		</field>
+		<field>
+			<label for="ToMonth">' . __('To month') . ':</label>
+			<input type="month" name="ToMonth" id="ToMonth" required="required" value="' . htmlspecialchars($DefaultTo, ENT_QUOTES, 'UTF-8') . '" />
+			<fieldhelp>' . __('24 months of history is recommended. Running months again replaces them, it does not add to them.') . '</fieldhelp>
+		</field>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="Extract" value="' . __('Extract Sales History') . '" />
+	</div>
+	</form>';
+
+echo '<div class="page_help_text">' . __('The history is the quantity invoiced less the quantity credited, by item, stock location and month: the same stock movements that Inventory Item Usage reports. Open sales orders are not included.') . '</div>';
+
+$Bounds = ForecastHistoryBounds();
+if ($Bounds['to'] === null) {
+	ForecastNoHistoryNotice();
+} else {
+	echo '<table class="selection">
+			<tr><th colspan="2">' . __('History held') . '</th></tr>
+			<tr><td>' . __('First month') . '</td><td>' . ForecastMonthLabel($Bounds['from']) . '</td></tr>
+			<tr><td>' . __('Last month') . '</td><td>' . ForecastMonthLabel($Bounds['to']) . '</td></tr>
+			<tr><td>' . __('Months covered') . '</td><td class="number">' . ForecastMonthsBetween($Bounds['from'], $Bounds['to']) . '</td></tr>
+			<tr><td>' . __('Months with sales') . '</td><td class="number">' . $Bounds['months'] . '</td></tr>
+			<tr><td>' . __('Items with sales') . '</td><td class="number">' . $Bounds['items'] . '</td></tr>
+			<tr><td>' . __('Item/location/month records') . '</td><td class="number">' . $Bounds['rows'] . '</td></tr>
+		</table>';
+	if ($Bounds['gaps']) {
+		prnMsg(__('The months extracted so far leave a gap. Months that were never extracted count as months without sales, extract the missing months.'), 'warn');
+	}
+
+	$Result = DB_query("SELECT runid, fromperiod, toperiod, runby, rundate, itemcount, rowcount
+						FROM forecasthistoryruns
+						ORDER BY runid DESC
+						LIMIT 10");
+	echo '<br /><table class="selection">
+			<tr><th colspan="6">' . __('Latest extractions') . '</th></tr>
+			<tr>
+				<th>' . __('From month') . '</th>
+				<th>' . __('To month') . '</th>
+				<th>' . __('Run by') . '</th>
+				<th>' . __('Run on') . '</th>
+				<th>' . __('Items') . '</th>
+				<th>' . __('Records') . '</th>
+			</tr>';
+	while ($MyRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . ForecastMonthLabel($MyRow['fromperiod']) . '</td>
+				<td>' . ForecastMonthLabel($MyRow['toperiod']) . '</td>
+				<td>' . htmlspecialchars($MyRow['runby'], ENT_QUOTES, 'UTF-8') . '</td>
+				<td>' . $MyRow['rundate'] . '</td>
+				<td class="number">' . $MyRow['itemcount'] . '</td>
+				<td class="number">' . $MyRow['rowcount'] . '</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+
+include('includes/footer.php');
diff --git a/ForecastInquiry.php b/ForecastInquiry.php
new file mode 100644
index 0000000..1e35f5a
--- /dev/null
+++ b/ForecastInquiry.php
@@ -0,0 +1,140 @@
+<?php
+
+// Inquiry on forecasts by item, category, location and period
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Inquiry');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastInquiry';
+include('includes/header.php');
+
+ForecastPageTitle($Title);
+
+$Code = isset($_POST['Code']) ? ForecastInput($_POST['Code']) : '';
+$CategoryID = isset($_POST['CategoryID']) ? ForecastInput($_POST['CategoryID']) : '';
+$Location = isset($_POST['Location']) ? ForecastInput($_POST['Location']) : '';
+$FromMonth = isset($_POST['FromMonth']) ? ForecastInput($_POST['FromMonth']) : '';
+$ToMonth = isset($_POST['ToMonth']) ? ForecastInput($_POST['ToMonth']) : '';
+$IncludeSuperseded = isset($_POST['IncludeSuperseded']);
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset>
+		<legend>' . __('Select forecasts') . '</legend>
+		<field>
+			<label for="Code">' . __('Item code or description contains') . ':</label>
+			<input type="text" name="Code" id="Code" size="21" maxlength="64" value="' . htmlspecialchars($Code, ENT_QUOTES, 'UTF-8') . '" />
+		</field>
+		<field>
+			<label for="CategoryID">' . __('Stock category') . ':</label>
+			<select name="CategoryID" id="CategoryID">' . ForecastCategoryOptions($CategoryID, __('Any category')) . '</select>
+		</field>
+		<field>
+			<label for="Location">' . __('Location') . ':</label>
+			<select name="Location" id="Location">
+				<option value="">' . __('Any location') . '</option>
+				<option value="-"' . ($Location == '-' ? ' selected="selected"' : '') . '>' . __('All locations combined') . '</option>' .
+				str_replace('<option value=""></option>', '', ForecastLocationOptions($Location, '')) . '
+			</select>
+		</field>
+		<field>
+			<label for="FromMonth">' . __('From month') . ':</label>
+			<input type="month" name="FromMonth" id="FromMonth" value="' . htmlspecialchars($FromMonth, ENT_QUOTES, 'UTF-8') . '" />
+		</field>
+		<field>
+			<label for="ToMonth">' . __('To month') . ':</label>
+			<input type="month" name="ToMonth" id="ToMonth" value="' . htmlspecialchars($ToMonth, ENT_QUOTES, 'UTF-8') . '" />
+		</field>
+		<field>
+			<label for="IncludeSuperseded">' . __('Include superseded forecasts') . ':</label>
+			<input type="checkbox" name="IncludeSuperseded" id="IncludeSuperseded"' . ($IncludeSuperseded ? ' checked="checked"' : '') . ' />
+		</field>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="Show" value="' . __('Show Forecasts') . '" />
+	</div>
+	</form>';
+
+if (isset($_POST['Show'])) {
+	$Where = array();
+	if ($Code != '') {
+		$Like = DB_escape_string(str_replace(array('%', '_'), array('\\%', '\\_'), $Code));
+		$Where[] = "(forecasts.stockid LIKE '%" . $Like . "%' OR stockmaster.description LIKE '%" . $Like . "%')";
+	}
+	if ($CategoryID != '') {
+		$Where[] = "stockmaster.categoryid = '" . DB_escape_string($CategoryID) . "'";
+	}
+	if ($Location == '-') {
+		$Where[] = "forecasts.loccode = ''";
+	} elseif ($Location != '') {
+		$Where[] = "forecasts.loccode = '" . DB_escape_string($Location) . "'";
+	}
+	if (preg_match('/^\d{4}-(0[1-9]|1[0-2])$/', $FromMonth)) {
+		$Where[] = "forecastdetails.periodstart >= '" . $FromMonth . "-01'";
+	}
+	if (preg_match('/^\d{4}-(0[1-9]|1[0-2])$/', $ToMonth)) {
+		$Where[] = "forecastdetails.periodstart <= '" . $ToMonth . "-01'";
+	}
+	if (!$IncludeSuperseded) {
+		$Where[] = "forecasts.isactive = 1";
+	}
+	$Result = DB_query("SELECT forecasts.forecastid, forecasts.stockid, stockmaster.description, stockmaster.categoryid,
+								forecasts.loccode, forecasts.method, forecasts.isactive,
+								forecastdetails.periodstart, forecastdetails.calcqty, forecastdetails.revisedqty,
+								" . ForecastEffectiveSQL() . " AS effective
+						FROM forecasts
+						INNER JOIN forecastdetails ON forecastdetails.forecastid = forecasts.forecastid
+						INNER JOIN stockmaster ON stockmaster.stockid = forecasts.stockid" .
+						(count($Where) > 0 ? " WHERE " . implode(' AND ', $Where) : '') . "
+						ORDER BY forecasts.stockid, forecasts.loccode, forecasts.forecastid DESC, forecastdetails.periodstart
+						LIMIT 1001");
+	if (DB_num_rows($Result) == 0) {
+		prnMsg(__('No forecasts were found'), 'info');
+	} else {
+		echo '<br /><table class="selection">
+				<tr>
+					<th>' . __('Item') . '</th>
+					<th>' . __('Description') . '</th>
+					<th>' . __('Category') . '</th>
+					<th>' . __('Location') . '</th>
+					<th>' . __('Method') . '</th>
+					<th>' . __('Period') . '</th>
+					<th>' . __('Calculated') . '</th>
+					<th>' . __('Revised') . '</th>
+					<th>' . __('Forecast used') . '</th>
+				</tr>';
+		$Count = 0;
+		$Total = 0;
+		while ($MyRow = DB_fetch_array($Result)) {
+			if (++$Count > 1000) {
+				break;
+			}
+			if ($MyRow['isactive'] == 1) {
+				$Total += $MyRow['effective'];
+			}
+			echo '<tr class="striped_row">
+					<td><a href="' . $RootPath . '/ForecastReview.php?ForecastID=' . $MyRow['forecastid'] . '">' . htmlspecialchars($MyRow['stockid'], ENT_QUOTES, 'UTF-8') . '</a></td>
+					<td>' . htmlspecialchars($MyRow['description'], ENT_QUOTES, 'UTF-8') . '</td>
+					<td>' . htmlspecialchars($MyRow['categoryid'], ENT_QUOTES, 'UTF-8') . '</td>
+					<td>' . ($MyRow['loccode'] == '' ? __('All') : htmlspecialchars($MyRow['loccode'], ENT_QUOTES, 'UTF-8')) . '</td>
+					<td>' . htmlspecialchars(ForecastMethodName($MyRow['method']), ENT_QUOTES, 'UTF-8') . ($MyRow['isactive'] == 1 ? '' : ' (' . __('superseded') . ')') . '</td>
+					<td>' . ForecastMonthLabel($MyRow['periodstart']) . '</td>
+					<td class="number">' . ForecastFormatQuantity($MyRow['calcqty']) . '</td>
+					<td class="number">' . ($MyRow['revisedqty'] !== null ? ForecastFormatQuantity($MyRow['revisedqty']) : '') . '</td>
+					<td class="number">' . ForecastFormatQuantity($MyRow['effective']) . '</td>
+				</tr>';
+		}
+		echo '<tr>
+				<td colspan="8"><b>' . __('Total of the active forecasts shown') . '</b></td>
+				<td class="number"><b>' . ForecastFormatQuantity($Total) . '</b></td>
+			</tr>
+			</table>';
+		if ($Count > 1000) {
+			prnMsg(__('Only the first 1000 rows are shown, narrow the selection'), 'info');
+		}
+	}
+}
+
+include('includes/footer.php');
diff --git a/ForecastMethodComparison.php b/ForecastMethodComparison.php
new file mode 100644
index 0000000..ca57f42
--- /dev/null
+++ b/ForecastMethodComparison.php
@@ -0,0 +1,197 @@
+<?php
+
+// One item's history forecast with several methods, side by side with their accuracy
+
+require(__DIR__ . '/includes/session.php');
+include('includes/ForecastFunctions.php');
+
+$Title = __('Forecast Method Comparison');
+$ViewTopic = 'Manufacturing';
+$BookMark = 'ForecastMethodComparison';
+include('includes/header.php');
+
+ForecastPageTitle($Title);
+
+$Defaults = ForecastGetParameters();
+$Bounds = ForecastHistoryBounds();
+$Methods = ForecastMethods();
+
+if (isset($_POST['Compare'])) {
+	$Parameters = ForecastReadParameters($_POST);
+	$StockID = isset($_POST['StockID']) ? mb_strtoupper(trim(ForecastInput($_POST['StockID']))) : '';
+	$LocCode = isset($_POST['Location']) ? ForecastInput($_POST['Location']) : '';
+	$Horizon = isset($_POST['Horizon']) ? (int) $_POST['Horizon'] : 0;
+	$Chosen = array();
+	foreach ($Methods as $Number => $Name) {
+		if (isset($_POST['Use' . $Number])) {
+			$Chosen[] = $Number;
+		}
+	}
+} else {
+	$Parameters = $Defaults;
+	$StockID = isset($_GET['StockID']) ? mb_strtoupper(ForecastInput($_GET['StockID'])) : '';
+	$LocCode = '';
+	$Horizon = $Defaults['defaulthorizon'];
+	$Chosen = array_keys($Methods);
+}
+
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">';
+echo '<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />';
+echo '<fieldset>
+		<legend>' . __('Item') . '</legend>
+		<field>
+			<label for="StockID">' . __('Item code') . ':</label>
+			<input type="text" name="StockID" id="StockID" size="21" maxlength="64" required="required" value="' . htmlspecialchars($StockID, ENT_QUOTES, 'UTF-8') . '" />
+		</field>
+		<field>
+			<label for="Location">' . __('Location') . ':</label>
+			<select name="Location" id="Location">' . ForecastLocationOptions($LocCode, __('All locations combined')) . '</select>
+		</field>
+		<field>
+			<label for="Horizon">' . __('Months to forecast') . ':</label>
+			<input type="number" name="Horizon" id="Horizon" min="1" max="36" step="1" value="' . (int) $Horizon . '" />
+		</field>
+		' . ForecastParameterFields($Parameters) . '
+	</fieldset>
+	<fieldset>
+		<legend>' . __('Methods to compare') . '</legend>';
+foreach ($Methods as $Number => $Name) {
+	echo '<field>
+			<label for="Use' . $Number . '">' . $Number . ' - ' . htmlspecialchars($Name, ENT_QUOTES, 'UTF-8') . ':</label>
+			<input type="checkbox" name="Use' . $Number . '" id="Use' . $Number . '"' . (in_array($Number, $Chosen) ? ' checked="checked"' : '') . ' />
+		</field>';
+}
+echo '</fieldset>
+	<div class="centre">
+		<input type="submit" name="Compare" value="' . __('Compare Methods') . '" />
+	</div>
+	</form>';
+
+if (isset($_POST['Compare'])) {
+	$Errors = ForecastValidateParameters($Parameters);
+	if ($Horizon < 1 or $Horizon > 36) {
+		$Errors[] = __('The horizon must be between 1 and 36 months');
+	}
+	if (count($Chosen) == 0) {
+		$Errors[] = __('Select at least one method');
+	}
+	$Result = DB_query("SELECT stockid, description FROM stockmaster WHERE stockid = '" . DB_escape_string($StockID) . "'");
+	$Item = DB_fetch_array($Result);
+	if (!$Item) {
+		$Errors[] = __('The item code entered is not an inventory item');
+	}
+	if ($Bounds['to'] === null) {
+		ForecastNoHistoryNotice();
+	} elseif (count($Errors) > 0) {
+		foreach ($Errors as $Error) {
+			prnMsg($Error, 'error');
+		}
+	} else {
+		$Series = ForecastItemSeries($StockID, $LocCode, $Bounds['to']);
+		$Values = $Series['values'];
+		$n = count($Values);
+		$Holdout = $Parameters['holdoutmonths'];
+		if ($n == 0) {
+			prnMsg(__('No sales history for this item'), 'warn');
+		} else {
+			echo '<br /><div class="page_help_text">' . sprintf(__('%s has %d months of history, from %s to %s. Each method is trained on all but the last %d months, forecasts those months and is scored against what was sold. The forecast columns use the full history.'), htmlspecialchars($Item['stockid'] . ' - ' . $Item['description'], ENT_QUOTES, 'UTF-8'), $n, ForecastMonthLabel($Series['start']), ForecastMonthLabel($Bounds['to']), $Holdout) . '</div>';
+
+			$Tests = array();
+			$Futures = array();
+			foreach ($Chosen as $Method) {
+				$Backtest = ForecastBacktest($Method, $Values, $Holdout, $Parameters);
+				$Reason = '';
+				if ($Backtest === null) {
+					$Training = array_slice($Values, 0, max(0, $n - $Holdout));
+					$Attempt = ForecastCompute($Method, $Training, $Holdout, $Parameters);
+					$Reason = $Attempt['ok'] ? __('Not enough history left to test') : $Attempt['error'];
+				}
+				$Tests[$Method] = array('backtest' => $Backtest, 'reason' => $Reason);
+				$Futures[$Method] = ForecastCompute($Method, $Values, $Horizon, $Parameters);
+			}
+			$Fit = ForecastBestFitItem($Values, $Parameters, $Holdout, $Chosen);
+
+			echo '<table class="selection">
+					<tr>
+						<th>' . __('Method') . '</th>
+						<th>' . __('MAD') . '</th>
+						<th>' . __('POA %') . '</th>
+						<th>' . __('MSE') . '</th>
+						<th>' . __('RMSE') . '</th>
+						<th>' . __('Notes') . '</th>
+						<th></th>
+					</tr>';
+			foreach ($Chosen as $Method) {
+				$Test = $Tests[$Method];
+				$IsBest = ($Fit['best'] == $Method);
+				echo '<tr class="striped_row"' . ($IsBest ? ' style="font-weight:bold"' : '') . '>
+						<td>' . $Method . ' - ' . htmlspecialchars($Methods[$Method], ENT_QUOTES, 'UTF-8') . '</td>';
+				if ($Test['backtest'] !== null) {
+					$M = $Test['backtest']['measures'];
+					echo '<td class="number">' . ForecastFormatQuantity($M['mad']) . '</td>
+						<td class="number">' . locale_number_format($M['poa'], 1) . '</td>
+						<td class="number">' . ForecastFormatQuantity($M['mse']) . '</td>
+						<td class="number">' . ForecastFormatQuantity($M['rmse']) . '</td>
+						<td>' . ($IsBest ? __('Best fit') : '') . '</td>';
+				} else {
+					echo '<td colspan="4"></td><td>' . htmlspecialchars($Test['reason'], ENT_QUOTES, 'UTF-8') . '</td>';
+				}
+				echo '<td>' . ($Futures[$Method]['ok'] ? '<a href="' . $RootPath . '/ForecastGenerate.php?StockID=' . urlencode($StockID) . '&amp;Location=' . urlencode($LocCode) . '&amp;Method=' . $Method . '">' . __('Generate with this method') . '</a>' : '') . '</td>
+					</tr>';
+			}
+			echo '</table><br />';
+
+			// the hold-out months: actual against each method
+			$Testable = array_filter($Tests, function ($Test) {
+				return $Test['backtest'] !== null;
+			});
+			if (count($Testable) > 0) {
+				echo '<table class="selection">
+						<tr><th colspan="' . (2 + count($Testable)) . '">' . __('Hold-out months: actual sales against each method') . '</th></tr>
+						<tr><th>' . __('Month') . '</th><th>' . __('Actual') . '</th>';
+				foreach ($Testable as $Method => $Test) {
+					echo '<th>' . $Method . '</th>';
+				}
+				echo '</tr>';
+				for ($i = 0; $i < $Holdout; $i++) {
+					$Period = ForecastAddMonths($Bounds['to'], -($Holdout - 1 - $i));
+					echo '<tr class="striped_row"><td>' . ForecastMonthLabel($Period) . '</td><td class="number">' . ForecastFormatQuantity($Values[$n - $Holdout + $i]) . '</td>';
+					foreach ($Testable as $Test) {
+						echo '<td class="number">' . ForecastFormatQuantity($Test['backtest']['forecast'][$i]) . '</td>';
+					}
+					echo '</tr>';
+				}
+				echo '</table><br />';
+			}
+
+			// the forecast months, from the full history
+			$Usable = array_filter($Futures, function ($Future) {
+				return $Future['ok'];
+			});
+			if (count($Usable) > 0) {
+				echo '<table class="selection">
+						<tr><th colspan="' . (1 + count($Usable)) . '">' . __('Forecast months: each method on the full history') . '</th></tr>
+						<tr><th>' . __('Month') . '</th>';
+				foreach ($Usable as $Method => $Future) {
+					echo '<th>' . $Method . '</th>';
+				}
+				echo '</tr>';
+				for ($i = 0; $i < $Horizon; $i++) {
+					echo '<tr class="striped_row"><td>' . ForecastMonthLabel(ForecastAddMonths($Bounds['to'], $i + 1)) . '</td>';
+					foreach ($Usable as $Future) {
+						echo '<td class="number">' . ForecastFormatQuantity($Future['values'][$i]) . '</td>';
+					}
+					echo '</tr>';
+				}
+				echo '</table>';
+			}
+			foreach ($Futures as $Method => $Future) {
+				if (!$Future['ok']) {
+					prnMsg($Method . ' - ' . htmlspecialchars($Methods[$Method], ENT_QUOTES, 'UTF-8') . ': ' . htmlspecialchars($Future['error'], ENT_QUOTES, 'UTF-8'), 'info');
+				}
+			}
+		}
+	}
+}
+
+include('includes/footer.php');

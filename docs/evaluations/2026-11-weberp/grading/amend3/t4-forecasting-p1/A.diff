+} elseif (isset($_GET['SummaryID'])) {
+	$SummaryID = (int) $_GET['SummaryID'];
+}
+
+$Summary = null;
+if ($SummaryID > 0) {
+	$Result = DB_query("SELECT * FROM forecastsummaries WHERE summaryid = " . $SummaryID);
+	$Summary = DB_fetch_array($Result);
+}
+if (!$Summary) {
+	prnMsg(__('The summary forecast could not be found'), 'error');

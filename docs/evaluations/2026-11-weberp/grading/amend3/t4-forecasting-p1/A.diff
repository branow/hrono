+++ b/sql/updates/44.php
@@ -0,0 +1,222 @@
+<?php
+
+// DEMAND FORECASTING MODULE
+//   - new tables for sales history, forecasts, summary forecasts, batches and the link to MRP demands
+//   - new main menu module "Forecasting", sequence 7 (next to Manufacturing), with its menu items and page security
+//   - modules are switched on per user by position in www_users.modulesallowed, so the new position is inserted
+//     for every existing user as "0": nobody gains or loses a module, the administrator grants Forecasting
+//   - MRP demand type FC for forecast generated demands
+//   - default forecasting parameters
+// Keep in step with install/sql/forecasting.sql, which does the same for new installations.
+
+CreateTable('forecastparameters', 'CREATE TABLE `forecastparameters` (
+  `paramname` varchar(30) NOT NULL DEFAULT "",
+  `paramvalue` varchar(100) NOT NULL DEFAULT "",
+  PRIMARY KEY (`paramname`)
+)');
+
+CreateTable('forecasthistoryruns', 'CREATE TABLE `forecasthistoryruns` (
+  `runid` int NOT NULL AUTO_INCREMENT,
+  `fromperiod` date NOT NULL DEFAULT "1000-01-01",
+  `toperiod` date NOT NULL DEFAULT "1000-01-01",
+  `runby` varchar(20) NOT NULL DEFAULT "",
+  `rundate` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  `itemcount` int NOT NULL DEFAULT "0",
+  `rowcount` int NOT NULL DEFAULT "0",
+  PRIMARY KEY (`runid`)
+)');
+
+CreateTable('forecasthistory', 'CREATE TABLE `forecasthistory` (
+  `stockid` varchar(64) NOT NULL DEFAULT "",
+  `loccode` varchar(5) NOT NULL DEFAULT "",
+  `periodstart` date NOT NULL DEFAULT "1000-01-01",
+  `quantity` double NOT NULL DEFAULT "0",
+  PRIMARY KEY (`stockid`,`loccode`,`periodstart`),
+  KEY `periodstart` (`periodstart`),
+  KEY `loccode` (`loccode`)
+)');
+
+CreateTable('forecasthistorydim', 'CREATE TABLE `forecasthistorydim` (
+  `dimtype` varchar(10) NOT NULL DEFAULT "",
+  `dimkey` varchar(20) NOT NULL DEFAULT "",
+  `periodstart` date NOT NULL DEFAULT "1000-01-01",
+  `quantity` double NOT NULL DEFAULT "0",
+  PRIMARY KEY (`dimtype`,`dimkey`,`periodstart`),
+  KEY `periodstart` (`periodstart`)
+)');
+
+CreateTable('forecastbatches', 'CREATE TABLE `forecastbatches` (
+  `batchid` int NOT NULL AUTO_INCREMENT,
+  `scopetype` varchar(10) NOT NULL DEFAULT "item",
+  `stockid` varchar(64) NOT NULL DEFAULT "",
+  `categoryid` varchar(6) NOT NULL DEFAULT "",
+  `loccode` varchar(5) NOT NULL DEFAULT "",
+  `method` tinyint NOT NULL DEFAULT "0",
+  `chosenmethod` tinyint NOT NULL DEFAULT "0",
+  `horizon` smallint NOT NULL DEFAULT "12",
+  `params` text NOT NULL,
+  `createdby` varchar(20) NOT NULL DEFAULT "",
+  `createdate` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  `status` varchar(10) NOT NULL DEFAULT "running",
+  `totalitems` int NOT NULL DEFAULT "0",
+  `successcount` int NOT NULL DEFAULT "0",
+  `failcount` int NOT NULL DEFAULT "0",
+  `notes` varchar(255) NOT NULL DEFAULT "",
+  PRIMARY KEY (`batchid`)
+)');
+
+CreateTable('forecastbatchresults', 'CREATE TABLE `forecastbatchresults` (
+  `batchid` int NOT NULL DEFAULT "0",
+  `stockid` varchar(64) NOT NULL DEFAULT "",
+  `status` varchar(10) NOT NULL DEFAULT "pending",
+  `message` varchar(255) NOT NULL DEFAULT "",
+  `forecastid` int NOT NULL DEFAULT "0",
+  PRIMARY KEY (`batchid`,`stockid`),
+  KEY `status` (`batchid`,`status`)
+)');
+
+CreateTable('forecasts', 'CREATE TABLE `forecasts` (
+  `forecastid` int NOT NULL AUTO_INCREMENT,
+  `stockid` varchar(64) NOT NULL DEFAULT "",
+  `loccode` varchar(5) NOT NULL DEFAULT "" COMMENT "Empty string means all locations combined",
+  `method` tinyint NOT NULL DEFAULT "1",
+  `params` text NOT NULL,
+  `horizon` smallint NOT NULL DEFAULT "12",
+  `historyend` date NOT NULL DEFAULT "1000-01-01",
+  `firstperiod` date NOT NULL DEFAULT "1000-01-01",
+  `createdby` varchar(20) NOT NULL DEFAULT "",
+  `createdate` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  `isactive` tinyint DEFAULT NULL COMMENT "1 for the active forecast, NULL for superseded ones",
+  `batchid` int NOT NULL DEFAULT "0",
+  `notes` varchar(255) NOT NULL DEFAULT "",
+  PRIMARY KEY (`forecastid`),
+  UNIQUE KEY `activeforecast` (`stockid`,`loccode`,`isactive`),
+  KEY `stockid` (`stockid`),
+  KEY `loccode` (`loccode`)
+)');
+
+CreateTable('forecastdetails', 'CREATE TABLE `forecastdetails` (
+  `forecastid` int NOT NULL DEFAULT "0",
+  `periodstart` date NOT NULL DEFAULT "1000-01-01",
+  `calcqty` double NOT NULL DEFAULT "0",
+  `revisedqty` double DEFAULT NULL COMMENT "NULL means not revised, 0 is a valid revision",
+  `revisedby` varchar(20) NOT NULL DEFAULT "",
+  PRIMARY KEY (`forecastid`,`periodstart`),
+  KEY `periodstart` (`periodstart`),
+  CONSTRAINT `forecastdetails_ibfk_1` FOREIGN KEY (`forecastid`) REFERENCES `forecasts` (`forecastid`) ON DELETE CASCADE
+)');
+
+CreateTable('forecastsummaries', 'CREATE TABLE `forecastsummaries` (
+  `summaryid` int NOT NULL AUTO_INCREMENT,
+  `dimtype` varchar(10) NOT NULL DEFAULT "category",
+  `dimkey` varchar(20) NOT NULL DEFAULT "",
+  `method` tinyint NOT NULL DEFAULT "1",
+  `params` text NOT NULL,
+  `horizon` smallint NOT NULL DEFAULT "12",
+  `historyend` date NOT NULL DEFAULT "1000-01-01",
+  `firstperiod` date NOT NULL DEFAULT "1000-01-01",
+  `createdby` varchar(20) NOT NULL DEFAULT "",
+  `createdate` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  `isactive` tinyint DEFAULT NULL COMMENT "1 for the active summary forecast, NULL for superseded ones",
+  `notes` varchar(255) NOT NULL DEFAULT "",
+  PRIMARY KEY (`summaryid`),
+  UNIQUE KEY `activesummary` (`dimtype`,`dimkey`,`isactive`)
+)');
+
+CreateTable('forecastsummarydetails', 'CREATE TABLE `forecastsummarydetails` (
+  `summaryid` int NOT NULL DEFAULT "0",
+  `periodstart` date NOT NULL DEFAULT "1000-01-01",
+  `calcqty` double NOT NULL DEFAULT "0",
+  `revisedqty` double DEFAULT NULL COMMENT "NULL means not revised, 0 is a valid revision",
+  `revisedby` varchar(20) NOT NULL DEFAULT "",
+  PRIMARY KEY (`summaryid`,`periodstart`),
+  CONSTRAINT `forecastsummarydetails_ibfk_1` FOREIGN KEY (`summaryid`) REFERENCES `forecastsummaries` (`summaryid`) ON DELETE CASCADE
+)');
+
+CreateTable('forecastmrpdemands', 'CREATE TABLE `forecastmrpdemands` (
+  `demandid` int NOT NULL DEFAULT "0",
+  `stockid` varchar(64) NOT NULL DEFAULT "",
+  `periodstart` date NOT NULL DEFAULT "1000-01-01",
+  `forecastid` int NOT NULL DEFAULT "0",
+  `convertedby` varchar(20) NOT NULL DEFAULT "",
+  `convertdate` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  PRIMARY KEY (`demandid`),
+  KEY `stockperiod` (`stockid`,`periodstart`),
+  CONSTRAINT `forecastmrpdemands_ibfk_1` FOREIGN KEY (`demandid`) REFERENCES `mrpdemands` (`demandid`) ON DELETE CASCADE
+)');
+
+// The module. Users are switched on per module by position in www_users.modulesallowed (the order of
+// modules.sequence), and the new module takes position 7 (index 6) so every position after it moves up one.
+// Existing users get "0" in the new position, once only: if the module is already there this has been done.
+$ForecastModuleResult = DB_query("SELECT modulelink FROM modules WHERE modulelink='forecast'");
+$ForecastModuleExists = (DB_num_rows($ForecastModuleResult) > 0);
+
+NewModule('forecast', 'fcst', __('Forecasting'), 7);
+
+if (!$ForecastModuleExists) {
+	$UsersResult = DB_query("SELECT userid, modulesallowed FROM www_users");
+	while ($UserRow = DB_fetch_array($UsersResult)) {
+		// Eleven modules existed before this update. Keep those eleven flags, whatever else the field held
+		$Flags = explode(',', $UserRow['modulesallowed']);
+		$Flags = array_slice(array_pad($Flags, 11, '0'), 0, 11);
+		array_splice($Flags, 6, 0, array('0'));
+		$NewValue = implode(',', $Flags) . ',';
+		executeSQL("UPDATE www_users SET modulesallowed='" . DB_escape_string($NewValue) . "' WHERE userid='" . DB_escape_string($UserRow['userid']) . "'", false);
+	}
+}
+
+NewScript('ForecastDashboard.php', 2);
+NewScript('ForecastInquiry.php', 2);
+NewScript('ForecastAccuracy.php', 2);
+NewScript('ForecastMethodComparison.php', 2);
+NewScript('ForecastHistory.php', 11);
+NewScript('ForecastGenerate.php', 11);
+NewScript('ForecastReview.php', 11);
+NewScript('ForecastSummary.php', 11);
+NewScript('ForecastSummaryReview.php', 11);
+NewScript('ForecastToMRP.php', 11);
+NewScript('ForecastParameters.php', 15);
+
+NewMenuItem('forecast', 'Transactions', __('Extract Sales History'), '/ForecastHistory.php', 1);
+NewMenuItem('forecast', 'Transactions', __('Generate Forecasts'), '/ForecastGenerate.php', 2);
+NewMenuItem('forecast', 'Transactions', __('Review and Revise Forecasts'), '/ForecastReview.php', 3);
+NewMenuItem('forecast', 'Transactions', __('Summary Forecasts'), '/ForecastSummary.php', 4);

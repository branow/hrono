+	$Last = $LastYear[$Period];
+	$Large = ForecastLargeVariance($Effective, $Last, $Defaults['variancepct']);
+	echo '<tr class="striped_row"' . ($Large ? ' style="background-color:#ffd6d6"' : '') . '>
+			<td>' . ForecastMonthLabel($Period) . '</td>
+			<td class="number">' . ForecastFormatQuantity($Detail['calcqty']) . '</td>
+			<td class="number">';
+	if ($Editable) {
+		echo '<input type="text" class="number" name="Revised[' . $Period . ']" size="10" value="' . ($Detail['revisedqty'] !== null ? ForecastFormatQuantity($Detail['revisedqty']) : '') . '" />';

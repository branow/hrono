diff --git a/sql/updates/41.php b/sql/updates/41.php
new file mode 100644
index 0000000..bd8fa82
--- /dev/null
+++ b/sql/updates/41.php
@@ -0,0 +1,15 @@
+<?php
+
+// Separate GL account for unrealized currency exchange differences (revaluation of
+// foreign currency bank accounts). Existing installations start with the account
+// they were already using for these postings, the sales exchange variances account.
+
+AddColumn('unrealizedexchangediffact', 'companies', 'varchar(20)', 'NOT NULL', '0', 'purchasesexchangediffact');
+
+if ($_SESSION['Updates']['Errors'] == 0) {
+	executeSQL("UPDATE companies SET unrealizedexchangediffact = exchangediffact WHERE unrealizedexchangediffact = '0' OR unrealizedexchangediffact = ''");
+}
+
+if ($_SESSION['Updates']['Errors'] == 0) {
+	UpdateDBNo(basename(__FILE__, '.php'), __('Add GL account for unrealized currency exchange differences'));
+}

+<?php
+
+/* Add, view, edit and delete the free-text notes held against a stock item */
+
+require(__DIR__ . '/includes/session.php');
+
+$Title = __('Stock Item Notes');
+$ViewTopic = 'Inventory';
+$BookMark = 'StockNotes';
+include('includes/header.php');
+
+if (isset($_GET['StockID'])) {
+	$StockID = trim(mb_strtoupper($_GET['StockID']));
+} elseif (isset($_POST['StockID'])) {
+	$StockID = trim(mb_strtoupper($_POST['StockID']));
+} else {
+	$StockID = '';
+}
+
+echo '<a href="' . $RootPath . '/SelectProduct.php" class="toplink">' . __('Back to Items') . '</a>';
+
+echo '<p class="page_title_text"><img alt="" src="' . $RootPath . '/css/' . $Theme .
+	'/images/inventory.png" title="' . $Title . '" /> ' . $Title . '</p>';
+
+if ($StockID == '') {
+	prnMsg(__('An item must first be selected before this page is called') . '. ' . __('The product selection page should call this page with a valid product code'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+
+$Result = DB_query("SELECT description FROM stockmaster WHERE stockid='" . $StockID . "'");
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('The part code entered does not exist in the database') . ': ' . $StockID . '. ' . __('Only valid parts can have notes entered against them'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$MyRow = DB_fetch_row($Result);
+
+echo '<p class="page_title_text">' . $StockID . ' - ' . $MyRow[0] . '</p>';
+
+$SelectedNote = 0;
+if (isset($_GET['Edit'])) {
+	$SelectedNote = (int) $_GET['Edit'];
+} elseif (isset($_POST['NoteID'])) {
+	$SelectedNote = (int) $_POST['NoteID'];
+}
+
+if (isset($_POST['submit'])) {
+	// $_POST values are already escaped by session.php
+	$Note = trim($_POST['Note']);
+	if (mb_strlen($Note) == 0) {
+		prnMsg(__('A note cannot be empty'), 'error');
+	} elseif ($SelectedNote > 0) {
+		$SQL = "UPDATE stockitemnotes
+				SET note='" . $Note . "'
+				WHERE noteid=" . $SelectedNote . "
+				AND stockid='" . $StockID . "'";
+		DB_query($SQL, __('The note could not be updated because'));
+		prnMsg(__('The note has been updated'), 'success');
+		$SelectedNote = 0;
+	} else {
+		$SQL = "INSERT INTO stockitemnotes (stockid, note, userid, datecreated)
+				VALUES ('" . $StockID . "',
+					'" . $Note . "',
+					'" . $_SESSION['UserID'] . "',
+					'" . date('Y-m-d H:i:s') . "')";
+		DB_query($SQL, __('The note could not be added because'));
+		prnMsg(__('The note has been added'), 'success');
+	}
+} elseif (isset($_POST['delete']) and $SelectedNote > 0) {
+	DB_query("DELETE FROM stockitemnotes WHERE noteid=" . $SelectedNote . " AND stockid='" . $StockID . "'",
+		__('The note could not be deleted because'));
+	prnMsg(__('The note has been deleted'), 'success');
+	$SelectedNote = 0;
+}
+
+// Existing notes
+$Result = DB_query("SELECT noteid, note, userid, datecreated
+					FROM stockitemnotes
+					WHERE stockid='" . $StockID . "'
+					ORDER BY datecreated, noteid");
+
+$EditText = '';
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('There are no notes for this item'), 'info');
+} else {
+	echo '<table class="selection">
+			<tr>
+				<th>' . __('Date') . '</th>
+				<th>' . __('User') . '</th>
+				<th>' . __('Note') . '</th>
+				<th colspan="2"></th>
+			</tr>';
+	while ($NoteRow = DB_fetch_array($Result)) {
+		if ($NoteRow['noteid'] == $SelectedNote) {
+			$EditText = $NoteRow['note'];
+		}
+		echo '<tr class="striped_row">
+				<td>' . ConvertSQLDateTime($NoteRow['datecreated']) . '</td>
+				<td>' . $NoteRow['userid'] . '</td>
+				<td>' . nl2br($NoteRow['note'], false) . '</td>
+				<td><a href="' . $RootPath . '/StockNotes.php?StockID=' . urlencode($StockID) . '&amp;Edit=' . $NoteRow['noteid'] . '">' . __('Edit') . '</a></td>
+				<td>
+					<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+						<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+						<input type="hidden" name="StockID" value="' . $StockID . '" />
+						<input type="hidden" name="NoteID" value="' . $NoteRow['noteid'] . '" />
+						<input type="submit" name="delete" value="' . __('Delete') . '" onclick="return confirm(\'' . __('Are you sure you wish to delete this note?') . '\');" />
+					</form>
+				</td>
+			</tr>';
+	}
+	echo '</table>';
+}
+if ($SelectedNote > 0 and $EditText == '') {
+	$SelectedNote = 0; // note no longer exists, or belongs to another item
+}
+
+// Add / edit form
+echo '<form method="post" action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '">
+	<div>
+	<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+	<input type="hidden" name="StockID" value="' . $StockID . '" />';
+if ($SelectedNote > 0) {
+	echo '<input type="hidden" name="NoteID" value="' . $SelectedNote . '" />';
+}
+echo '</div>
+	<fieldset>
+		<legend>' . ($SelectedNote > 0 ? __('Edit Note') : __('New Note')) . '</legend>
+		<field>
+			<label for="Note">' . __('Note') . ':</label>
+			<textarea name="Note" id="Note" cols="60" rows="5" required="required">' . $EditText . '</textarea>
+		</field>
+	</fieldset>
+	<div class="centre">
+		<input type="submit" name="submit" value="' . ($SelectedNote > 0 ? __('Update Note') : __('Add Note')) . '" />';
+if ($SelectedNote > 0) {
+	echo ' <a href="' . $RootPath . '/StockNotes.php?StockID=' . urlencode($StockID) . '">' . __('Cancel') . '</a>';
+}
+echo '</div>
+	</form>';
+
+echo '<div class="centre"><a href="' . $RootPath . '/SelectProduct.php?StockID=' . urlencode($StockID) . '">' . __('Back to Item') . '</a></div>';
+
+include('includes/footer.php');

diff --git a/sql/updates/44.php b/sql/updates/44.php
new file mode 100644
index 0000000..ab80a29
--- /dev/null
+++ b/sql/updates/44.php
@@ -0,0 +1,17 @@
+<?php
+
+// Notes about stock items: zero to many free-text notes per item
+CreateTable('stockitemnotes', "CREATE TABLE `stockitemnotes` (
+	`noteid` int NOT NULL AUTO_INCREMENT,
+	`stockid` varchar(64) NOT NULL,
+	`note` text NOT NULL,
+	`userid` varchar(20) NOT NULL DEFAULT '',
+	`datecreated` datetime NOT NULL,
+	PRIMARY KEY (`noteid`),
+	KEY `stockid` (`stockid`),
+	CONSTRAINT `stockitemnotes_ibfk_1` FOREIGN KEY (`stockid`) REFERENCES `stockmaster` (`stockid`)
+)");
+
+NewScript('StockNotes.php', 11);
+
+UpdateDBNo(basename(__FILE__, '.php'), __('Add notes to stock items'));

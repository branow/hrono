+	prnMsg(__('The item') . ' ' . $StockID . ' ' . __('does not exist') . '. ' . __('Notes can only be kept for an existing item'), 'error');
+	include('includes/footer.php');
+	exit();
+}
+$MyRow = DB_fetch_row($Result);
+echo '<h3>' . $StockID . ' - ' . $MyRow[0] . '</h3>';
+
+$NoteID = 0;
+if (isset($_GET['Edit'])) {
+	$NoteID = (int) $_GET['Edit'];
+} elseif (isset($_POST['NoteID'])) {
+	$NoteID = (int) $_POST['NoteID'];
+}
+
+if (isset($_POST['Submit'])) {
+	$Note = trim($_POST['Note']);

+		DB_query($SQL, __('The note could not be added because'));
+		prnMsg(__('The note has been added'), 'success');
+	}
+} elseif (isset($_POST['Delete']) and $NoteID > 0) {
+	$SQL = "DELETE FROM stockitemnotes WHERE noteid=" . $NoteID . " AND stockid='" . $StockID . "'";
+	DB_query($SQL, __('The note could not be deleted because'));
+	prnMsg(__('The note has been deleted'), 'success');
+	$NoteID = 0;
+}
+
+// load the note being edited, if any
+$EditText = '';
+if ($NoteID > 0) {
+	$Result = DB_query("SELECT note FROM stockitemnotes WHERE noteid=" . $NoteID . " AND stockid='" . $StockID . "'");
+	if (DB_num_rows($Result) == 1) {
+		$EditRow = DB_fetch_row($Result);
+		$EditText = $EditRow[0];
+	} else {
+		$NoteID = 0;
+	}
+}
+
+// list existing notes
+$Result = DB_query("SELECT noteid, note, createdby, created
+					FROM stockitemnotes
+					WHERE stockid='" . $StockID . "'
+					ORDER BY created, noteid");
+if (DB_num_rows($Result) == 0) {
+	prnMsg(__('There are no notes for this item'), 'info');
+} else {
+	echo '<table class="selection">
+			<thead>
+				<tr>
+					<th>' . __('Note') . '</th>
+					<th>' . __('Created By') . '</th>
+					<th>' . __('Date') . '</th>
+					<th colspan="2"></th>
+				</tr>
+			</thead>
+			<tbody>';
+	while ($NoteRow = DB_fetch_array($Result)) {
+		echo '<tr class="striped_row">
+				<td>' . nl2br($NoteRow['note']) . '</td>
+				<td>' . $NoteRow['createdby'] . '</td>
+				<td>' . ConvertSQLDateTime($NoteRow['created']) . '</td>
+				<td><a href="' . $RootPath . '/StockNotes.php?StockID=' . urlencode($StockID) . '&amp;Edit=' . $NoteRow['noteid'] . '">' . __('Edit') . '</a></td>
+				<td>
+					<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post" onsubmit="return confirm(\'' . __('Are you sure you wish to delete this note?') . '\');">
+						<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+						<input type="hidden" name="StockID" value="' . $StockID . '" />
+						<input type="hidden" name="NoteID" value="' . $NoteRow['noteid'] . '" />
+						<input type="submit" name="Delete" value="' . __('Delete') . '" />
+					</form>
+				</td>
+			</tr>';
+	}
+	echo '</tbody></table>';
+}
+
+// add / edit form
+echo '<br />
+	<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post">
+		<input type="hidden" name="FormID" value="' . $_SESSION['FormID'] . '" />
+		<input type="hidden" name="StockID" value="' . $StockID . '" />
+		<input type="hidden" name="NoteID" value="' . $NoteID . '" />
+		<fieldset>
+			<legend>' . ($NoteID > 0 ? __('Edit Note') : __('Add Note')) . '</legend>
+			<textarea name="Note" rows="6" cols="70" required="required">' . $EditText . '</textarea>
+		</fieldset>
+		<div class="centre">
+			<input type="submit" name="Submit" value="' . ($NoteID > 0 ? __('Update Note') : __('Add Note')) . '" />';
+if ($NoteID > 0) {
+	echo ' <a href="' . $RootPath . '/StockNotes.php?StockID=' . urlencode($StockID) . '">' . __('Cancel') . '</a>';
+}
+echo '</div>
+	</form>';
+
+include('includes/footer.php');

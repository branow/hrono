diff --git a/sql/updates/44.php b/sql/updates/44.php
new file mode 100644
index 0000000..da27119
--- /dev/null
+++ b/sql/updates/44.php
@@ -0,0 +1,17 @@
+<?php
+
+CreateTable('stockitemnotes',
+"CREATE TABLE `stockitemnotes` (
+  `noteid` int(11) NOT NULL AUTO_INCREMENT,
+  `stockid` varchar(64) NOT NULL DEFAULT '',
+  `note` text NOT NULL,
+  `createdby` varchar(20) NOT NULL DEFAULT '',
+  `created` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  PRIMARY KEY (`noteid`),
+  KEY `stockid` (`stockid`),
+  CONSTRAINT `stockitemnotes_ibfk_1` FOREIGN KEY (`stockid`) REFERENCES `stockmaster` (`stockid`)
+)");
+
+NewScript('StockNotes.php', 2);
+
+UpdateDBNo(basename(__FILE__, '.php'), __('Create stockitemnotes table for notes on stock items'));

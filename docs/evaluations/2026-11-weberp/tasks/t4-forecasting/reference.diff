+			<th>' . __('Category') . '</th>
+			<th>' . __('Customer Type') . '</th>
+			<th>' . __('Area') . '</th>
+			<th>' . __('Sales Person') . '</th>
+			<th>' . __('Status') . '</th>
+			<th colspan="3">' . __('Actions') . '</th>
+		  </tr>';

/629/entity-filer-queue-service-lear-queue-services-entity-filer-", "source": "node-629"}, {"uri": "git:///Users/orest/hrono-eval/mirror/lear/jobs/sftp-nuans-report/openshift/templates/cronjob.yaml@a30995be5c09afdc54018ba8eb3aad796509a7d9", "kind": "source", "header": "git:///Users/orest/hrono-eval/mirror/lear/jobs/sftp-nuans-report/openshift/templates/cronjob.yaml@a30995be5c09afdc54018ba8eb3aad796509a7d9 sp:/.document/.block_node/.block_mapping/objects/.block_node/.block_sequence/.block_sequence_item/.block_node/.block_mapping/spec/.block_node/.block_mapping/schedule sp:/.document/.block_node/.block_mapping/objects/.block_node/.block_sequence/.block_sequence_item/.block_node/.block_mapping/spec/.block_node/.block_mapping/concurrencyPolicy sp:/.document/.block_node/.block_mapping/objects/.block_node/.block_sequence/.block_sequence_item/.block_node/.block_mapping/spec/.block_node/.block_mapping/successfulJobsHistoryLimit sp:/.document/.block_node/.block_mapping/objects/.block_node/.block_sequence/.block_sequence_item/.block_node/.block_mapping/spec/.block_node/.block_mapping/failedJobsHistoryLimit", "body": "schedule: \"${SCHEDULE}\"\n    concurrencyPolicy: \"Forbid\"\n    successfulJobsHistoryLimit: \"${{SUCCESS_JOBS_HISTORY_LIMIT}}\"\n    failedJobsHistoryLimit: \"${{FAILED_JOBS_HISTORY_LIMIT}}\"\n    jobTemplate:\n      ", "score": 0.03268211420093115, "start": 306, "end": 512, "topic": 290, "path": "jobs/sftp-nuans-report/openshift/templates/cronjob.yaml", "source": "lear"}, {"uri": "node://hrono/nodes/564/payment-jobs-test-suite-tests-jobs-and-tests-services@ef844d1eb0d55f102b4faece88adb9d49ce451c82b39b030f59dccea02cc6bb5", "kind": "summary", "header": "node://hrono/nodes/564/payment-jobs-test-suite-tests-jobs-and-tests-services@ef844d1eb0d55f102b4faece88adb9d49ce451c82b39b030f59dccea02cc6bb5 sp:/payment-jobs%3A%20test%20suite%20%28tests%2Fjobs%20and%20tests%2Fservices%29/Hazards", "body": "## Hazards\n- `AuthEvent` swallows publish failures after logging them to Sentry, so a lock or unlock can be silently lost.\n- CFS calls have no retry, and failures other than the ones above surface as exceptions in the task.\n- `validate_bank_account` builds `bank_name` from the `bank_number` field in the response (flagged in the source as an apparent bug).\n- `test_partial_refund_disbursement` is skipped, so partial-refund EJV disbursement has no active test.\n\n", "score": 0.030409789279212646, "start": 19663, "end": 20126, "topic": 564, "path": "nodes/564/payment-jobs-test-suite-tests-jobs-and-tests-services", "source": "node-564"}]}